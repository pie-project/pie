"""$name — Python inferlet: greedy text completion.

The forward pass is traced from the `epilogue` function below into an ETA
program the first time it is submitted; `take_scalar()` brings each sampled
token back to the host, which sends it down again as the next embed.
See tests/inferlets/text-completion-py in the pie repo for the same program
with chunked prefill, and naive-baseline-py for a device-carried, run-ahead
decode loop.
"""

from inferlet import chat, model, session
from inferlet.eta import (
    Channel,
    ForwardKind,
    ForwardPass,
    KvGeometry,
    Pipeline,
    RsWorkingSet,
    WorkingSet,
    dtype,
    indptr,
    intrinsics,
    kv_page_size,
    reduce_argmax,
    reshape,
)


async def main(input: dict) -> dict:
    prompt = input.get("prompt", "What is the capital of France?")
    system = input.get("system", "You are a helpful, respectful and honest assistant.")
    max_tokens = int(input.get("max_tokens", 64))

    kind = model.pass_kind()
    ws = WorkingSet()
    rs_ws = [RsWorkingSet()] if kind != ForwardKind.ATTENTION else []
    page_size = kv_page_size()
    stop = set(chat.stop_tokens())

    tokens = chat.system(system) + chat.user(prompt) + chat.cue()
    n = len(tokens)
    max_pages = max(-(-(n + max_tokens + 1) // page_size), 1)
    ws.reserve(max_pages)
    pipe = Pipeline()

    # Prefill: the whole prompt in one fire; its epilogue samples the first token.
    tok_out_p = Channel([1], dtype.i32)
    prefill = ForwardPass(kind)
    prefill.embed(Channel.from_(tokens, dtype.i32), Channel.from_([0, n], dtype.u32))
    prefill.bind_state(
        ws,
        KvGeometry(
            kv_len=Channel.from_([n], dtype.u32),
            pages=Channel.from_(range(max_pages), dtype.u32),
            page_indptr=Channel.from_([0, -(-n // page_size)], dtype.u32),
            w_slot=Channel.from_([p // page_size for p in range(n)], dtype.u32),
            w_off=Channel.from_([p % page_size for p in range(n)], dtype.u32),
            positions=Channel.from_(range(n), dtype.u32),
        ),
        rs_ws,
    )

    @prefill.epilogue
    def _prefill():
        tok_out_p.put(reshape(reduce_argmax(intrinsics.logits()), [1]))

    prefill.submit(pipe)
    generated = [await tok_out_p.take_scalar()]

    # Decode: one token per fire; the geometry advances on the device.
    tok_in = Channel.from_([generated[0]], dtype.i32)
    kv_len = Channel.from_([n + 1], dtype.u32)
    positions = Channel.from_([n], dtype.u32)
    page_indptr = Channel.from_([0, -(-(n + 1) // page_size)], dtype.u32)
    w_slot = Channel.from_([n // page_size], dtype.u32)
    w_off = Channel.from_([n % page_size], dtype.u32)
    tok_out = Channel([1], dtype.i32)
    decode = ForwardPass(kind)
    decode.embed(tok_in, Channel.from_([0, 1], dtype.u32))
    decode.bind_state(
        ws,
        KvGeometry(
            kv_len=kv_len,
            pages=Channel.from_(range(max_pages), dtype.u32),
            page_indptr=page_indptr,
            w_slot=w_slot,
            w_off=w_off,
            positions=positions,
        ),
        rs_ws,
    )

    @decode.epilogue
    def _decode():
        length = kv_len.take()
        next_length = length + 1
        kv_len.put(next_length)
        positions.put(length)
        w_slot.put(length // page_size)
        w_off.put(length % page_size)
        page_indptr.put(indptr(1, next_length.div_ceil(page_size)))
        tok_out.put(reshape(reduce_argmax(intrinsics.logits()), [1]))

    while len(generated) < max_tokens and generated[-1] not in stop:
        decode.submit(pipe)
        token = await tok_out.take_scalar()
        generated.append(token)
        tok_in.put([token])
        session.send(model.decode([token]))  # stream to the client
    pipe.close()

    kept = [t for t in generated if t not in stop]
    return {"text": model.decode(kept), "tokens": kept}
