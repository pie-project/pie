//! $name — Rust inferlet: greedy text completion.
//!
//! The forward pass is TRACED from the `epilogue` closure below into an ETA
//! program the first time it is submitted; `take_host` brings each sampled
//! token back to the host, which sends it down again as the next embed.
//! Everything else the decode fire reads (position, write slot/offset, page
//! CSR) is derived from the KV length on the device by the epilogue itself.
//! See tests/inferlets/text-completion in the pie repo for the same program
//! with chunked prefill, and naive-baseline for a device-carried, run-ahead
//! decode loop.

use inferlet::eta::hybrid::prelude::*;
use inferlet::{chat, session};
use serde::{Deserialize, Serialize};

#[derive(Deserialize)]
struct Input {
    #[serde(default = "default_prompt")]
    prompt: String,
    #[serde(default = "default_system")]
    system: String,
    #[serde(default = "default_max_tokens")]
    max_tokens: usize,
}

fn default_prompt() -> String {
    "What is the capital of France?".into()
}
fn default_system() -> String {
    "You are a helpful, respectful and honest assistant.".into()
}
fn default_max_tokens() -> usize {
    64
}

#[derive(Serialize)]
struct Output {
    text: String,
    tokens: Vec<u32>,
}

/// The greedy pick over a logits row, as a one-lane `[1]` i32 cell.
fn greedy(logits: Tensor) -> Tensor {
    reshape(reduce_argmax(&logits), [1])
}

#[inferlet::main]
async fn main(input: Input) -> Result<Output> {
    let kind = model::pass_kind();
    let ws = WorkingSet::new();
    // On a hybrid model the recurrent state rides beside the KV cache; on a
    // pure-attention model the binding is empty and IS the attention pass.
    let rs_ws: Vec<RsWorkingSet> = match kind {
        model::ForwardKind::Attention => Vec::new(),
        model::ForwardKind::Hybrid => vec![RsWorkingSet::new()],
        model::ForwardKind::Recurrent => return Err("this program needs a KV cache".into()),
        model::ForwardKind::Diffusion => return Err("this program decodes a token at a time".into()),
    };
    let page_size = kv_page_size();
    let stop: Vec<u32> = chat::stop_tokens();

    let mut tokens = chat::system(&input.system);
    tokens.extend(chat::user(&input.prompt));
    tokens.extend(chat::cue());
    let n = tokens.len() as u32;
    let max_pages = (n + input.max_tokens as u32 + 1).div_ceil(page_size).max(1);
    ws.reserve(max_pages).context("reserve KV")?;
    let pipe = Pipeline::new();

    // Prefill: the whole prompt in one fire; its epilogue samples the first token.
    let tokens_i32: Vec<i32> = tokens.iter().map(|&t| t as i32).collect();
    let toks_p = Channel::from(&tokens_i32[..]);
    let embed_indptr_p = Channel::from([0u32, n]);
    let kv_len_p = Channel::from([n]);
    let pages_p = Channel::from_iter(0..max_pages);
    let page_indptr_p = Channel::from([0u32, n.div_ceil(page_size)]);
    let w_slot_p = Channel::from_iter((0..n).map(|p| p / page_size));
    let w_off_p = Channel::from_iter((0..n).map(|p| p % page_size));
    let positions_p = Channel::from_iter(0..n);
    let tok_out_p = Channel::new([1], dtype::i32);
    let prefill = ForwardPass::new();
    prefill.embed(&toks_p, &embed_indptr_p)?;
    prefill.attention(
        Some(KvBinding {
            working_set: &ws,
            geometry: KvGeometry {
                readable_pages: ..,
                writable_pages: ..,
                kv_len: &kv_len_p,
                pages: &pages_p,
                page_indptr: &page_indptr_p,
                w_slot: &w_slot_p,
                w_off: &w_off_p,
                positions: &positions_p,
                mask: None,
            },
        }),
        &rs_ws,
        RsGeometry { fold_len: None, buffer: 0..0 },
    )?;
    {
        let tok_out_p = tok_out_p.clone();
        prefill.epilogue(move || tok_out_p.put(&greedy(intrinsics::logits())));
    }
    prefill.submit(&pipe).context("prefill submit")?;
    let mut generated: Vec<u32> = vec![tok_out_p.take_host::<i32>().await.context("prefill drain")? as u32];

    // Decode: one token per fire; the geometry advances on the device.
    let tok_in = Channel::from([generated[0] as i32]);
    let embed_indptr = Channel::from([0u32, 1]);
    let kv_len = Channel::from([n + 1]);
    let positions = Channel::from([n]);
    let pages = Channel::from_iter(0..max_pages);
    let page_indptr = Channel::from([0u32, (n + 1).div_ceil(page_size)]);
    let w_slot = Channel::from([n / page_size]);
    let w_off = Channel::from([n % page_size]);
    let tok_out = Channel::new([1], dtype::i32);
    let decode = ForwardPass::new();
    decode.embed(&tok_in, &embed_indptr)?;
    decode.attention(
        Some(KvBinding {
            working_set: &ws,
            geometry: KvGeometry {
                readable_pages: ..,
                writable_pages: ..,
                kv_len: &kv_len,
                pages: &pages,
                page_indptr: &page_indptr,
                w_slot: &w_slot,
                w_off: &w_off,
                positions: &positions,
                mask: None,
            },
        }),
        &rs_ws,
        RsGeometry { fold_len: None, buffer: 0..0 },
    )?;
    {
        let (kv_len, positions, page_indptr, w_slot, w_off, tok_out) =
            (kv_len.clone(), positions.clone(), page_indptr.clone(), w_slot.clone(), w_off.clone(), tok_out.clone());
        decode.epilogue(move || {
            let length = kv_len.take();
            let next_length = &length + 1u32;
            kv_len.put(&next_length);
            positions.put(&length);
            w_slot.put(&length / page_size);
            w_off.put(&length % page_size);
            page_indptr.put(indptr(1, &next_length.div_ceil(page_size)));
            tok_out.put(&greedy(intrinsics::logits()));
        });
    }

    while generated.len() < input.max_tokens && !stop.contains(generated.last().unwrap()) {
        decode.submit(&pipe).context("decode submit")?;
        let token = tok_out.take_host::<i32>().await.context("decode drain")? as u32;
        generated.push(token);
        tok_in.put([token as i32]);
        session::send(&model::decode(&[token])?); // stream to the client
    }
    pipe.close();

    let kept: Vec<u32> = generated.iter().copied().filter(|t| !stop.contains(t)).collect();
    Ok(Output { text: model::decode(&kept)?, tokens: kept })
}
