interface reasoning {
    use types.{error};

    variant event {
        /// Reasoning block started
        start,
        /// Reasoning text chunk
        delta(string),
        /// Reasoning complete (full reasoning text)
        complete(string),
    }

    /// Detects reasoning blocks in generated tokens.
    resource decoder {
        constructor();
        feed: func(tokens: list<u32>) -> result<event, error>;
        reset: func();
    }
}
