#version 450

#include "common/bf16.glsl"

// Vulkan port of Metal's split_qkv: same copy, with the width struct still a
// buffer because the row names `params: Buf`. The grid's rounded x tail must
// not fall through into the next row.

layout(local_size_x = 256) in;

PIE_BUFFER_RO(0, Packed, packed);
PIE_BUFFER_RW(1, Q, q);
PIE_BUFFER_RW(2, K, k);
PIE_BUFFER_RW(3, V, v);

struct SplitQkvParams { uint q_width; uint kv_width; };
layout(std430, binding = 4) readonly buffer Params { SplitQkvParams p; };

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    uint q_width = p.q_width;
    uint kv_width = p.kv_width;
    uint packed_width = q_width + 2u * kv_width;
    if (c >= packed_width) return;

    PIE_ACT value = packed[row * packed_width + c];
    if (c < q_width) {
        q[row * q_width + c] = value;
    } else if (c < q_width + kv_width) {
        k[row * kv_width + (c - q_width)] = value;
    } else {
        v[row * kv_width + (c - q_width - kv_width)] = value;
    }
}

// pie:instantiate split_qkv_bf16
