// Device argmax plus EOS compare.
//
// The Metal kernel's contract is preserved: bf16 widens exactly to fp32, the
// scan keeps the lowest index on ties, and one workgroup owns one request row.
// Vulkan uses shared memory for the pair reduction so it does not assume a
// 32-lane subgroup.

#version 450

#include "common/bf16.glsl"

layout(local_size_x = 1024) in;

PIE_BUFFER_RO(0, Logits, logits);
layout(std430, binding = 1) buffer NextToken { uint next_token[]; };
struct ArgmaxParams { uint vocab; uint n_eos; uint eos_ids[8]; };
layout(std430, binding = 2) readonly buffer Params { ArgmaxParams p; };
layout(std430, binding = 3) buffer EosFlag { uint eos_flag[]; };

shared float sh_v[1024];
shared uint sh_i[1024];

void main() {
    uint row = gl_WorkGroupID.y;
    uint lid = gl_LocalInvocationID.x;
    float best_v = -1.0 / 0.0;
    uint best_i = 0u;
    for (uint i = lid; i < p.vocab; i += gl_WorkGroupSize.x) {
        float v = PIE_LOAD(logits[row * p.vocab + i]);
        if (v > best_v) { best_v = v; best_i = i; }
    }
    sh_v[lid] = best_v;
    sh_i[lid] = best_i;
    barrier();

    for (uint stride = gl_WorkGroupSize.x >> 1; stride > 0u; stride >>= 1) {
        if (lid < stride) {
            float ov = sh_v[lid + stride];
            uint oi = sh_i[lid + stride];
            if (ov > sh_v[lid] || (ov == sh_v[lid] && oi < sh_i[lid])) {
                sh_v[lid] = ov;
                sh_i[lid] = oi;
            }
        }
        barrier();
    }
    if (lid == 0u) {
        uint tok = sh_i[0];
        next_token[row] = tok;
        uint flag = 0u;
        for (uint e = 0u; e < p.n_eos; e++) {
            if (tok == p.eos_ids[e]) { flag = 1u; break; }
        }
        eos_flag[row] = flag;
    }
}

