// Weightless RMSNorm: `out = x / rms(x)`.
//
// This follows `norm/rms.comp`'s Vulkan reduction rather than Metal's fixed
// simdgroup width. The arithmetic and strided N_READS loop are the Metal port's:
// fp32 accumulate, one bf16 round on store, and one workgroup per row.

#version 450

#include "common/bf16.glsl"
#include "common/reduce.glsl"
#include "norm/rms_params.glsl"

#ifndef N_READS
#define N_READS 4
#endif

layout(local_size_x = 256) in;

PIE_BUFFER_RO(0, X, x);
PIE_BUFFER_RW(1, Out, out_);
layout(std430, binding = 2) readonly buffer Params { VNormParams p; };

void main() {
    uint axis_size = p.axis_size;
    uint base = gl_WorkGroupID.x * axis_size;
    uint lid = gl_LocalInvocationID.x;
    uint span = gl_WorkGroupSize.x * uint(N_READS);

    float acc = 0.0;
    for (uint start = lid * uint(N_READS); start < axis_size; start += span) {
        [[unroll]] for (uint i = 0u; i < uint(N_READS); i++) {
            if (start + i < axis_size) {
                float xi = PIE_LOAD(x[base + start + i]);
                acc += xi * xi;
            }
        }
    }
    float inv = pie_inv_rms(acc, axis_size, p.eps);

    for (uint start = lid * uint(N_READS); start < axis_size; start += span) {
        [[unroll]] for (uint i = 0u; i < uint(N_READS); i++) {
            uint at = start + i;
            if (at < axis_size) {
                out_[base + at] = PIE_STORE(PIE_LOAD(x[base + at]) * inv);
            }
        }
    }
}

// pie:instantiate vnorm_single_row_bfloat16 N_READS=4
