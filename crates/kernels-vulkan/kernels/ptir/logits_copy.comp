// PTIR logits row staging.
//
// Ported from Metal's batched copy: one dispatch can stage every row the fire
// needs, with `gl_GlobalInvocationID.y` choosing the per-row params record.

#version 450

#include "common/bf16.glsl"

layout(local_size_x = 256) in;

struct PtirLogitsCopyParams { uint source_row; uint destination_row; uint vocab; uint reserved; };

PIE_BUFFER_RO(0, Source, source);
PIE_BUFFER_RW(1, Destination, destination);
layout(std430, binding = 2) readonly buffer Params { PtirLogitsCopyParams params[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    PtirLogitsCopyParams p = params[row];
    if (x >= p.vocab) return;
    destination[p.destination_row * p.vocab + x] = source[p.source_row * p.vocab + x];
}

