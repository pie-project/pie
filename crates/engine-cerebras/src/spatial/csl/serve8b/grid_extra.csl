// ---------------------------------------------------------------- serve8b
// (appended to qwen2d_paged8b's pe.csl by serve8b/sync.py) The layer-to-layer
// handoff of x (B lanes of Hc a row, lane-major). A grid's x leaves as it came
// in: row py holds chunk py on every column.
//
// Placement and chaining are the host's (serve_lib8b.WaferModel.route_table):
// before `init` it writes each grid PE's `rtab`, which init applies and the
// passes follow. So the grid shape, the slot of each layer, and how grids
// chain are host parameters (one program image for every grid); the device
// code is only "take x on color c_in, (relay it on c_relay), run the layer,
// send x on c_out". The host's tables implement:
// - within a strip: the edge column's row py sends its chunk across (R0/R1
//   by layer parity), multicast along row py of the next grid;
// - between strips (taller than wide, PX <= PY <= 2 PX): the PE (py mod PX,
//   py) sends chunk py down column py mod PX on CV (rows < PX) or CV2 (rows
//   past PX; the two column legs overlap); the next grid's (py mod PX, py)
//   takes it and multicasts it along row py;
// - HEADMODE 2: layer 0 takes row py's chunk from the east on E[py % 4] (the
//   embedding strip, paths.csl); the last layer's east column sends row py's
//   chunk east on S[py % 2] (to the head).
// The handoffs use queue 2 (free in qwen2d_paged8b).
//
// rtab (u16, written with a 16-bit memcpy): [c_in, c_relay, c_out, n, (color, rx, tx1, tx2) x n (n <= 4)], colors by
// number (NONE: none), directions as the kernel's D_* (0 ramp, 1 N, 2 S, 3 E,
// 4 W). Routes are read-modify-written (only the route bits change).
const rt = @import_module("rt.csl");
const RTN: u16 = 4 + 4 * 4;
const RNONE: u16 = 0xff;
var rtab = @zeros([RTN]u16);
var rtab_ptr: [*]u16 = &rtab;

fn s2d_place() void {
  px = layout_mod.get_x_coord() % PX;
  py = layout_mod.get_y_coord() % PY;
}

fn s2d_routes() void {
  const cc0 = color_config.get_color_config_addr(@get_color(0));
  var k: u16 = 0;
  while (k < rtab[3]) : (k += 1) {
    const e = 4 + 4 * k;
    const addr = cc0 + rtab[e];
    var r = @get_config(addr, tgt.color_addr_range);
    r = r & @get_int(tgt.fabric_io.CLEAR_MASK);
    r = r | rxw(rtab[e + 1]) | txw(rtab[e + 2]) | txw(rtab[e + 3]);
    @set_config(addr, r, tgt.color_addr_range);
  }
  if (rtab[0] != RNONE) { rt.iq_color(2, rtab[0]); }
}


// Queue 2's output color is set for each send (a relay PE may also be its
// row's sender, on another color); its input color once, at init (nothing but
// this PE's own handoff is routed to its ramp on that color).
fn q2_send(c: u16) void {
  rt.oq_color(2, c);
  @fmovs(fout(q_gb_out, S2D_XN), x_all);
}

fn recv_x() void {
  if (rtab[0] != RNONE) { @fmovs(x_all, fin(q_gb_in, S2D_XN)); }
  if (rtab[1] != RNONE) { q2_send(rtab[1]); }   // the relay: on along the row
}

fn send_x() void {
  if (rtab[2] != RNONE) { q2_send(rtab[2]); }
}

// `steps` passes, each through this grid once: x in from the layer before
// (layer 0: the host's or the embedding strip's), the layer, x out. start_pos
// is unused (positions come from `tab`). S2D_TIME 1 (PROF 0): prof[0] sums the
// passes' layer cycles after the first (the kernel's pass counter; ~0.3 KB of
// code, so off by default).
fn compute(steps: u32, start_pos: u32) void {
  if (S2D_TIME == 1) { timestamp.enable_tsc(); }
  var i: u32 = 0;
  while (i < steps) : (i += 1) {
    s2d_pass_start(i, start_pos);   // the kernel's per-pass prologue (sync.py)
    recv_x();
    if (S2D_TIME == 1) {
      timing = i > 0;
      pass_start();
      timestamp.get_timestamp(&t_mark);
    }
    layer();
    if (S2D_TIME == 1) { pass_end(); }
    send_x();
  }
  sys_mod.unblock_cmd_stream();
}

// KV page staging (Fork 4's kv-staging-interface.md; KVST slots, 0: none):
// page_stage(page, slot) copies pool page `page`'s block (row page % PY,
// block page / PY) of kc / vc, every layer of the unit, into slot `slot` of
// kstage / vstage; page_unstage copies it back. Local copies only (no
// fabric): every unit runs them in one launch, between launches. A slot is
// [S2D_KL layers][Dc · PS] in kc's (and vc's) own block order; slots back to
// back, no pad.
const S2D_STAGE_TASK: u16 = 10;    // a local task id free in the kernel and memcpy
const S2D_KL: u16 = 1;                  // layers a grid
const S2D_KN: u16 = Dc * PS;                 // a page's cells a layer
const S2D_KCN: u16 = NB * Dc * PS;           // a layer's cells a PE
const S2D_SN: u16 = if (KVST > 0) KVST * S2D_KL * S2D_KN else 1;
// serve8b: the slots alias the kernel's pass scratch (no memory of their own;
// the grids have < 768 B to spare): kstage is s, vstage is act, exported as
// f32 words (KV16: two bf16 cells a word, the even cell in the low half; the
// host moves them with 32-bit memcpy). Only a compute fire touches s and act
// (init and copy_kv do not), so a staged page lives from page_stage to the
// host's read, and from the host's write to page_unstage, as long as no fire
// runs in between: the host makes each staged copy atomic with respect to
// fires (WaferModel.page_out / page_in).
const S2D_SW: u16 = if (KV16 == 1) (S2D_SN + 1) / 2 else S2D_SN;   // an array's f32 words
comptime {
  if (KVST > 0) { @comptime_assert(S2D_SW <= SN and S2D_SW <= ACTN); }
}
var kstage_ptr: [*]f32 = &s;
var vstage_ptr: [*]f32 = &act;
// The copies: 16-bit moves (bit for bit) on DSDs rebased at run time.
var s2d_u16 = @zeros([1]u16);
const s2d_d16 = @get_dsd(mem1d_dsd, .{ .base_address = &s2d_u16, .extent = S2D_KN });
comptime {
  if (KVST > 0) { @comptime_assert(KV16 == 1); }
}
// One copy of the code for both launches: they record their arguments and
// activate a local task (an exported function's body is inlined into
// memcpy's dispatcher, once a launch).
var s2d_pg: u32 = 0;
var s2d_sl: u32 = 0;
var s2d_back: bool = false;
const s2d_task_id: local_task_id = @get_local_task_id(S2D_STAGE_TASK);
task s2d_task() void { s2d_stage(s2d_pg, s2d_sl, s2d_back); }
comptime {
  if (KVST > 0) { @bind_local_task(s2d_task, s2d_task_id); }
}
fn s2d_stage(page: u32, slot: u32, back: bool) void {
  // row page % PY, block page / PY, the slot's offset: by additions (no
  // integer multiply or divide in the PE's code)
  var r = @as(u16, page);
  var src: u16 = 1;
  while (r >= PY) : (r -= PY) { src += S2D_KN; }
  if (KVST > 0 and py == r) {
    var dst: u16 = 0;
    if (KVST > 1) {
      var k: u16 = 0;
      while (k < @as(u16, slot)) : (k += 1) { dst += S2D_KL * S2D_KN; }
    }
    const kst: [*]u16 = @ptrcast([*]u16, &s);
    const vst: [*]u16 = @ptrcast([*]u16, &act);
    const kcp = @ptrcast([*]u16, &kc);
    const vcp = @ptrcast([*]u16, &vc);
    var l: u16 = 0;
    while (l < S2D_KL) : (l += 1) {
      var ka = @ptrcast([*]u16, &kst[dst]);
      var kb = @ptrcast([*]u16, &kcp[src]);
      var va = @ptrcast([*]u16, &vst[dst]);
      var vb = @ptrcast([*]u16, &vcp[src]);
      if (back) {
        const t = ka; ka = kb; kb = t;
        const u = va; va = vb; vb = u;
      }
      @mov16(@set_dsd_base_addr(s2d_d16, ka), @set_dsd_base_addr(s2d_d16, kb));
      @mov16(@set_dsd_base_addr(s2d_d16, va), @set_dsd_base_addr(s2d_d16, vb));
      src += S2D_KCN;
      dst += S2D_KN;
    }
  }
  sys_mod.unblock_cmd_stream();
}
fn page_stage(page: u32, slot: u32) void {
  s2d_pg = page;
  s2d_sl = slot;
  s2d_back = false;
  @activate(s2d_task_id);
}
fn page_unstage(page: u32, slot: u32) void {
  s2d_pg = page;
  s2d_sl = slot;
  s2d_back = true;
  @activate(s2d_task_id);
}

comptime {
  @export_symbol(rtab_ptr, "rtab");
  if (KVST > 0) {
    @export_symbol(kstage_ptr, "kstage");
    @export_symbol(vstage_ptr, "vstage");
    @export_symbol(page_stage);
    @export_symbol(page_unstage);
  }
}
