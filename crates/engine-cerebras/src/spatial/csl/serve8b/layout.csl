// serve8b: Qwen3-8B's decoder layers as NL grids of PX x PY PEs (Fork 8's
// qwen2d_paged8b; grid_pe.csl is generated by sync.py), GW slots across and GH
// strips down, serpentine: even strips run west from the east end, odd strips
// east; strips 0..GS-1 hold GW grids, strips GS.. hold GW - 1 (their westmost
// slot is free). Layer 0 is the top-right grid. HEADMODE 2 puts the LM head
// (head2d_v10: one block of C = PY / 2 chunk columns of 2 Hc dims, + VMC) east
// of the grids, and the embedding strip (EC = PY / 4 columns of 4 Hc dims)
// east of the head. Each PE finds its place, roles and routes from its own
// coordinates at `init`.
param PX: u16;
param PY: u16;
param Hc: u16;
param HR: u16;
param Dc: u16;
param Gs: u16;
param Qh: u16;
param Ic: u16;
param PS: u16;         // page size (positions)
param NB: u16;         // KV blocks a PE (pool pages = NB * PY)
param E: u16;          // a lane's pages a row, at most
param B: u16;          // lanes a pass
param MC: u16;         // lanes an MLP chunk (B % MC == 0)
param W16: u16;
param NP: u16;
param KV16: u16;
param KVCP: u16;       // 1: copy_kv on the wafer, 0: the host copies pages
param PROF: u16;
param TIME: u16;       // 1: the grids time each pass (prof[0], with PROF 0); ~0.3 KB a grid PE
param GW: u16;
param GH: u16;
param GS: u16;         // full strips (the rest hold GW - 1 grids)
param HEADMODE: u16;   // 0: the host feeds layer 0 and reads the last; 2: the head and the embedding strip
// head2d (HEADMODE 2; see head2d_v10/layout.csl): one block, HH region rows of
// Vr vocab rows each, feeder row F = HH / 2.
param HH: u16;
param Vr: u16;
param Gx: u16;
param Gy: u16;
param vocab: u32;
param PASSES: u16;
param MODE: u16;       // 0 exact (PASSES), 2 approx (one bf16 pass); no certificate modes
param OVL: u16;
param VMC: u16;
param CAP: u16;        // forced/output tokens a lane a launch (in_tokens/out_tokens)
param iters: u16;      // unused (the step count is a launch argument)

const C_R1_0: color = @get_color(8);
const C_R1_1: color = @get_color(7);
const C_R2_0: color = @get_color(6);
const C_R2_1: color = @get_color(5);
const C_BC: color = @get_color(9);
const C_GB: color = @get_color(10);
const HLB: u16 = if (B < 4) B else 4;   // lanes whose logits rows the head keeps

const NL: u16 = GS * GW + (GH - GS) * (GW - 1);
const WS = if (W16 == 1) u16 else f32;
const KS = if (KV16 == 1) u16 else f32;
const C: u16 = PY / 2;                       // head chunk columns
const HW: u16 = if (HEADMODE == 2) C + VMC else 0;
const EW: u16 = if (HEADMODE == 2) PY / 4 else 0;
const XH: u16 = GW * PX;
const XE: u16 = XH + HW;
const GHGT: u16 = GH * PY;
const F: u16 = if (HEADMODE == 2) HH / 2 else 0;
const HR2X: u16 = if (HEADMODE == 2) (C / Gx / 2) * Gx + Gx / 2 else 0;   // head2d's root column
const HVMC: u16 = if (HEADMODE == 2) VMC else 0;
const RH: u16 = if (HEADMODE == 2 and HH + 1 > GHGT) HH + 1 else GHGT;
const memcpy = @import_module("<memcpy/get_params>", .{ .width = XE + EW, .height = RH });

layout {
  @comptime_assert(GW >= 2 and GS >= 1 and GS <= GH);
  @comptime_assert(GS % 2 == 0 or GS == GH);
  // A grid that both takes the relay from above and sends it below would need
  // both column legs (a one-grid strip between two strip changes).
  @comptime_assert(GW >= 3 or GH - GS <= 1);
  @comptime_assert(PY % 4 == 0 and PY >= PX and PY <= 2 * PX);
  @comptime_assert(B % MC == 0);
  // The staircases' non-crossing (paths.csl): the feeder row below layer 0's
  // strip (E) and above the last strip (S).
  @comptime_assert(HEADMODE == 0 or (F >= PY and F < (GH - 1) * PY));
  @comptime_assert(HEADMODE == 0 or (MODE == 0 or MODE == 2));
  @set_rectangle(XE + EW, RH);
  for (@range(u16, XE + EW)) |x| {
    const mp = memcpy.get_params(x);
    for (@range(u16, RH)) |y| {
      const free_slot = y / PY >= GS and x / PX == 0;
      if (x >= XH and x < XE and y <= HH and HEADMODE == 2) {
        @set_tile_code(x, y, "head_pe.csl", .{
          .memcpy_params = mp,
          .W = HW, .H = HH, .F = F, .C = C, .Hc = 2 * Hc, .Vr = Vr, .Gx = Gx, .Gy = Gy, .Gb = 1,
          .vocab = vocab, .PASSES = PASSES, .UNTIED = 0, .CERT = 0, .MODE = MODE, .OVL = OVL,
          .VMC = VMC, .WF32 = 0, .SCHAIN = 0,
          .GPX = PX, .GPY = PY, .GHc = Hc, .GW = GW, .GH = GH, .GS = GS, .NL = NL, .CAP = CAP, .SB = B,
          .HLB = HLB, .KVCP = KVCP, .WS = WS, .KS = KS,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_x = C_BC, .c_ib = C_GB,
        });
      } else if (x >= XE and y <= HH and HEADMODE == 2) {
        @set_tile_code(x, y, "embed_pe.csl", .{
          .memcpy_params = mp, .PX = PX, .PY = PY, .Hc = Hc, .GW = GW, .GH = GH, .GS = GS, .NL = NL,
          .F = F, .VMC = VMC, .VMAT = HR2X + 1, .Ve = Vr, .vocab = vocab, .B = B, .KVCP = KVCP,
          .WS = WS, .KS = KS,
        });
      } else if (x >= XH or y >= GHGT or free_slot) {
        @set_tile_code(x, y, "filler.csl", .{
          .memcpy_params = mp, .PX = PX, .PY = PY, .GW = GW, .GH = GH, .GS = GS, .NL = NL, .F = F,
          .VMC = HVMC, .VMAT = HR2X + 1, .HEADMODE = HEADMODE, .KVCP = KVCP, .WS = WS, .KS = KS,
        });
      } else {
        @set_tile_code(x, y, "grid_pe.csl", .{
          .memcpy_params = mp,
          .PX = PX, .PY = PY, .Hc = Hc, .HR = HR, .Dc = Dc, .Gs = Gs, .Qh = Qh, .Ic = Ic,
          .PS = PS, .NB = NB, .E = E, .B = B, .MC = MC, .W16 = W16, .NP = NP, .KV16 = KV16,
          .KVCP = KVCP, .PROF = PROF, .S2D_TIME = TIME,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_bc = C_BC, .c_gb = C_GB,
        });
      }
    }
  }
  @export_name("x", [*]f32, true);
  @export_name("tab", [*]u32, true);
  @export_name("gamma1", [*]f32, true);
  @export_name("gamma2", [*]f32, true);
  @export_name("wqa", [*]WS, true);
  @export_name("wqv", [*]WS, true);
  @export_name("wv", [*]WS, true);
  @export_name("qkn_w", [*]f32, true);
  @export_name("rot_c", [*]f32, true);
  @export_name("rot_s", [*]f32, true);
  @export_name("kc", [*]KS, true);
  @export_name("vc", [*]KS, true);
  @export_name("wo", [*]WS, true);
  @export_name("wgu", [*]WS, true);
  @export_name("wd", [*]WS, true);
  @export_name("prof", [*]u32, true);
  @export_name("dims", [*]u16, true);
  @export_name("rtab", [*]u16, true);
  @export_name("wt", [*]u32, true);
  @export_name("et", [*]u32, true);
  @export_name("l2", [*]f32, true);
  @export_name("force", [*]u32, true);
  @export_name("lmax", [*]f32, true);
  @export_name("gmode", [*]u32, true);
  @export_name("vm_tok", [*]f32, true);
  @export_name("vin", [*]f32, true);
  @export_name("xin", [*]f32, true);
  @export_name("gam", [*]f32, true);
  @export_name("y", [*]f32, true);
  @export_name("emb", [*]f32, true);
  @export_name("tok", [*]f32, true);
  @export_name("in_tokens", [*]u32, true);
  @export_name("out_tokens", [*]u32, true);
  @export_name("yscale", [*]f32, true);
  @export_name("hlogits", [*]f32, true);
  @export_name("etab", [*]u32, true);
  @export_name("init", fn()void);
  @export_name("compute", fn(u32, u32)void);
  if (KVCP == 1) {
    @export_name("copy_kv", fn(u32, u32, u32)void);
  }
}
