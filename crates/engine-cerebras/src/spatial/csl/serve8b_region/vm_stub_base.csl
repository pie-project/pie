// serve8b_region's stand-in for the VM block (VM5.md): 5 columns east of the
// embedding strip, rows 0..HH. With gmode 1, each lane step:
// - every PE of a region row (not F) takes its root's logits row and 1/rms
//   and the lane step's ctl word (Vr + 2 words) on c_vl (color 2) into `vin`;
//   VM PE k's slice is rows [32k, 32k + 32) (Vr = 160 = 5 x 32);
// - the block's first PE on the feeder row F sends `vm_tok` west to the
//   final root on c_vt (color 3).
// Fork 3's VM image replaces this program; the interface stays.
param memcpy_params;
param PX: u16;         // the end grids' width and height (paths.csl)
param PY: u16;
param XH0: u16;
param XL: u16;
param YL: u16;
param F: u16;
param VMC: u16;
param VMAT: u16;
param Vr: u16;
param B: u16;
param XV: u16;
param RCX: u16;
param KVCP: u16;
param HROUTE: u16;
param WS: type;
param KS: type;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const rt = @import_module("rt.csl");
const paths = @import_module("paths.csl", .{ .GWD = PX, .GHT = PY, .XL = XL, .YL = YL, .XH = XH0, .F = F,
                                             .C = PY / 2, .VMC = VMC, .VMAT = VMAT, .XE = XH0 + PY / 2 + VMC,
                                             .EC = PY / 4, .XV = XV, .RCX = RCX });
const q_in = @get_input_queue(2);
const q_out = @get_output_queue(2);

var gmode = @zeros([1]u32);
var gmode_ptr: [*]u32 = &gmode;
var vm_tok = @zeros([1]f32);
var vm_tok_ptr: [*]f32 = &vm_tok;
var vin = @zeros([Vr + 2]f32);
var vin_ptr: [*]f32 = &vin;
const vin_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Vr + 2} -> vin[i] });
const tok_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> vm_tok[i] });
var row_f: bool = false;
var sender: bool = false;

fn init() void {
  const gx = layout_mod.get_x_coord();
  const gy = layout_mod.get_y_coord();
  const k = gx - XV;
  row_f = gy == F;
  sender = row_f and k == 0;
  if (!row_f) {
    if (k < 4) { rt.route(paths.C_VL, rt.RX_W, rt.TX_R | rt.TX_E); } else { rt.route(paths.C_VL, rt.RX_W, rt.TX_R); }
  } else if (sender) {
    rt.route(paths.C_VT, rt.RX_R, rt.TX_W);
  }
  sys_mod.unblock_cmd_stream();
}

fn compute(steps: u32, start_pos: u32) void {
  var i: u32 = 0;
  while (i <= steps) : (i += 1) {
    var b: u16 = 0;
    while (b < B) : (b += 1) {
      if (gmode[0] == 1) {
        if (!row_f) {
          @fmovs(vin_dsd, @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q_in }), Vr + 2));
        } else if (sender) {
          @fmovs(@set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q_out }), 1), tok_dsd);
        }
      }
    }
  }
  sys_mod.unblock_cmd_stream();
}

fn copy_kv(src: u32, dst: u32, phase: u32) void { sys_mod.unblock_cmd_stream(); }

comptime {
  @initialize_queue(q_in, .{ .color = paths.C_VL });
  @initialize_queue(q_out, .{ .color = paths.C_VT });
  @export_symbol(gmode_ptr, "gmode");
  @export_symbol(vm_tok_ptr, "vm_tok");
  @export_symbol(vin_ptr, "vin");
  @export_symbol(init);
  @export_symbol(compute);
  if (KVCP == 1) { @export_symbol(copy_kv); }
}
