// ---------------------------------------------------------------- serve_g4
// (after serve2d's head extra) The PLE rows cross head2d's block west on each
// strip's top row (colors 17 + lane, from the PLE region east of the block
// to the grids); head2d's winner multicast runs on east into that region
// (its last column passes it on: route_ib, patched).
const g4_rt = @import_module("rt.csl");
const G4_PL0: color = @get_color(17);
const G4_PL1: color = @get_color(18);
const G4_PL2: color = @get_color(19);
const G4_PL3: color = @get_color(20);
fn g4_head_init() void {
  if (py % GPY != 0 or py >= GH * GPY) { return; }
  g4_rt.route(G4_PL0, g4_rt.RX_E, g4_rt.TX_W);
  if (SB > 1) { g4_rt.route(G4_PL1, g4_rt.RX_E, g4_rt.TX_W); }
  if (SB > 2) { g4_rt.route(G4_PL2, g4_rt.RX_E, g4_rt.TX_W); }
  if (SB > 3) { g4_rt.route(G4_PL3, g4_rt.RX_E, g4_rt.TX_W); }
}
