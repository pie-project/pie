// serve_g4's filler: serve2d's (it routes the staircases that cross it and
// takes part in launches) plus the PLE rows across a missing grid's top row
// (an odd last strip runs east: its missing grids sit between the head and
// the strip's layers).
param memcpy_params;
param PX: u16;
param PY: u16;
param GW: u16;
param GH: u16;
param NL: u16;
param F: u16;
param C: u16;
param VMC: u16;
param VMAT: u16;
param SB: u16;
param WS: type;
param KS: type;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const rt = @import_module("rt.csl");
const paths = @import_module("paths.csl", .{ .GWD = PX, .GHT = PY, .GW = GW, .GH = GH, .NL = NL,
                                             .XH = GW * PX, .F = F, .C = C, .VMC = VMC, .VMAT = VMAT });
const C_PL0: color = @get_color(17);
const C_PL1: color = @get_color(18);
const C_PL2: color = @get_color(19);
const C_PL3: color = @get_color(20);

fn init() void {
  const x = layout_mod.get_x_coord();
  const y = layout_mod.get_y_coord();
  paths.routes(x, y);
  if (x < GW * PX and y < GH * PY and y % PY == 0) {
    rt.route(C_PL0, rt.RX_E, rt.TX_W);
    if (SB > 1) { rt.route(C_PL1, rt.RX_E, rt.TX_W); }
    if (SB > 2) { rt.route(C_PL2, rt.RX_E, rt.TX_W); }
    if (SB > 3) { rt.route(C_PL3, rt.RX_E, rt.TX_W); }
  }
  sys_mod.unblock_cmd_stream();
}

fn compute(steps: u32, start_pos: u32) void {
  sys_mod.unblock_cmd_stream();
}

comptime {
  @export_symbol(init);
  @export_symbol(compute);
}
