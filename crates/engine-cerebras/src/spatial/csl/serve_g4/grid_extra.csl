// ---------------------------------------------------------------- serve_g4
// (appended to gemma4_layer's pe.csl by codegen::serve_g4) serve2d's grid
// handoffs (serve2d/grid_extra.csl) carrying what Gemma's layers add beside x:
// - the payload a PE row is [x | x0 | kvr], B lanes each: x and the embedding
//   x0 (B x Hc, lane-major), and kvr (B x KVW): row j carries column j's k
//   and v of the shared tail's two sources (the sliding source's at 0, the
//   global source's at 2 DcS). Layer 0 takes x alone from the head (the raw
//   embedding row): x0 = x, x = x * sqrt(hidden), kvr = 0. The last layer
//   sends x alone to the head.
// - a source layer (SHARE 1) moves its k and v from the diagonal onto the
//   rows after the layer (an X all-reduce of kvo, nonzero on the diagonal
//   only); a tail layer (OWN 0) back onto its columns after its QKV
//   all-reduce (a Y all-reduce of kvr's slot, nonzero on the diagonal only).
// - the per-layer embedding row (PC > 0): at a step's start, before x, row 0
//   of every grid takes each lane's row of its strip's tables from the head
//   region (color 17 + lane, east to west along the strip's top row: the
//   grids are idle there, the head decides only after the last layer), u32
//   words of two bf16 each, NWW a lane; a PE keeps its layer's column's
//   PC / 2 words, widens them and scales them by sqrt(PLE) / sqrt(2).
// Queue 2 is serve2d's: the handoffs and the PLE row borrow it.
const rt = @import_module("rt.csl");
const paths = @import_module("paths.csl", .{ .GWD = PX, .GHT = PY, .GW = GW, .GH = GH, .NL = NL,
                                             .XH = GW * PX, .F = F, .C = PY, .VMC = S2D_VMC,
                                             .VMAT = S2D_VMAT });
comptime { @comptime_assert(PX >= PY); }
const C_R0: color = @get_color(11);
const C_R1: color = @get_color(12);
const C_CV: color = @get_color(13);
const C_PL0: color = @get_color(17);
const C_PL1: color = @get_color(18);
const C_PL2: color = @get_color(19);
const C_PL3: color = @get_color(20);
comptime { @comptime_assert(B <= 4); }

var L: u16 = 0;
var in_kind: u16 = 0;    // 0 none (the host), 1 from the west, 2 from the east, 3 diagonal (CV), 4 diagonal (E)
var out_kind: u16 = 0;   // 0 none (the host), 1 east, 2 west, 3 south (CV), 4 the head (S)
var oq_swapped: bool = false;

fn r_color(l: u16) u16 { return if (l % 2 == 0) rt.cn(C_R0) else rt.cn(C_R1); }
fn r_route(l: u16, rx: u16, tx: u16) void {
  if (l % 2 == 0) { rt.route(C_R0, rx, tx); } else { rt.route(C_R1, rx, tx); }
}
fn pl_color(b: u16) u16 { return 17 + b; }
fn pl_route(b: u16, rx: u16, tx: u16) void {
  if (b == 0) { rt.route(C_PL0, rx, tx); }
  else if (b == 1) { rt.route(C_PL1, rx, tx); }
  else if (b == 2) { rt.route(C_PL2, rx, tx); }
  else { rt.route(C_PL3, rx, tx); }
}

fn s2d_place() void {
  const gx = layout_mod.get_x_coord();
  const gy = layout_mod.get_y_coord();
  const sx = gx / PX;
  const sy = gy / PY;
  px = gx % PX;
  py = gy % PY;
  const k = if (sy % 2 == 0) GW - 1 - sx else sx;
  L = sy * GW + k;
  in_kind = if (L == 0) (if (HEADMODE == 0 or S2D_DBG >= 1) 0 else 4) else if (k != 0) (if (sy % 2 == 0) 2 else 1) else 3;
  out_kind = if (L == NL - 1) (if (HEADMODE == 0) 0 else 4) else if (k != GW - 1) (if (sy % 2 == 0) 2 else 1) else 3;
  // The PLE row: words [k PD / 2 + px PC / 2, + PC / 2) of a lane's NWW; the
  // strip's west end takes it last (an even strip's grid west of this one
  // may be missing: NL < GW GH).
  g4_lo = (L % GW) * (PX * PC / 2) + px * (PC / 2);
  g4_west_end = px == 0 and (sx == 0 or (sy % 2 == 0 and L + 1 >= NL));
}

fn s2d_routes() void {
  const w = px > 0;
  const e = px < PX - 1;
  const tw: u16 = if (w) rt.TX_W else 0;
  const te: u16 = if (e) rt.TX_E else 0;
  if (in_kind == 1) {
    r_route(L, rt.RX_W, rt.TX_R | te);
  } else if (in_kind == 2) {
    r_route(L, rt.RX_E, rt.TX_R | tw);
  } else if (in_kind == 3 or in_kind == 4) {
    if (px == py) { r_route(L, rt.RX_R, tw | te); }
    else if (px < py) { r_route(L, rt.RX_E, rt.TX_R | tw); }
    else { r_route(L, rt.RX_W, rt.TX_R | te); }
    if (in_kind == 3) {
      if (py < px) { rt.route(C_CV, rt.RX_N, rt.TX_S); }
      else if (py == px) { rt.route(C_CV, rt.RX_N, rt.TX_R); }
    }
  }
  if (out_kind == 1 and px == PX - 1) { r_route(L + 1, rt.RX_R, rt.TX_E); }
  if (out_kind == 2 and px == 0) { r_route(L + 1, rt.RX_R, rt.TX_W); }
  if (out_kind == 3) {
    if (py == px) { rt.route(C_CV, rt.RX_R, rt.TX_S); }
    else if (py > px) { rt.route(C_CV, rt.RX_N, rt.TX_S); }
  }
  // The PLE rows along the strip's top row, east to west.
  if (PC > 0 and py == 0) {
    var b: u16 = 0;
    while (b < B) : (b += 1) {
      pl_route(b, rt.RX_E, rt.TX_R | (if (g4_west_end) 0 else rt.TX_W));
    }
  }
  // The staircases where they cross this grid (S2D_PATHS: 1 E, strips 0
  // and 1; S: 2 the last layer's, chunk j from its diagonal east along row
  // j; 4 a grid east of it in its strip, row j passing chunk j on east).
  if ((S2D_PATHS & 1) != 0) { paths.routes_e(layout_mod.get_x_coord(), layout_mod.get_y_coord()); }
  if ((S2D_PATHS & 2) != 0) {
    if (px == py) { rt.route(paths.C_S, rt.RX_R, rt.TX_E); }
    else if (px > py) { rt.route(paths.C_S, rt.RX_W, rt.TX_E); }
  }
  if ((S2D_PATHS & 4) != 0) { rt.route(paths.C_S, rt.RX_W, rt.TX_E); }
}

// ---------------------------------------------------------------- payload
const KVWn: u16 = if (KVW > 0) KVW else 1;
var kvr = @zeros([B * KVWn]f32);
const s2d_x_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{S2D_XN} -> x[i] });
const g4_x0_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{S2D_XN} -> x0[i] });
const g4_kvr_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * KVWn} -> kvr[i] });
const G4_ES: f32 = @bitcast(f32, ESB);    // sqrt(hidden)
const G4_PS: f32 = @bitcast(f32, PSB);    // sqrt(PLE) / sqrt(2)

fn g4_oq2(c: u16) void {
  while ((tile_config.output_queue_status.get_raw() & 0x0400) == 0) {}   // queue 2 empty
  rt.oq_color(2, c);
}

fn g4_in_all() void {
  @fmovs(s2d_x_dsd, fin(q_gb_in, S2D_XN));
  @fmovs(g4_x0_dsd, fin(q_gb_in, S2D_XN));
  @fmovs(g4_kvr_dsd, fin(q_gb_in, B * KVWn));
}
fn g4_out_all() void {
  @fmovs(fout(q_gb_out, S2D_XN), s2d_x_dsd);
  @fmovs(fout(q_gb_out, S2D_XN), g4_x0_dsd);
  @fmovs(fout(q_gb_out, B * KVWn), g4_kvr_dsd);
}

fn recv_x(first: bool) void {
  if (in_kind == 0) { return; }
  if (in_kind == 4 and HEADMODE == 1 and first) { return; }
  if (in_kind == 4) {
    // Layer 0: the head's embedding rows.
    if (px == py) {
      rt.iq_color(2, rt.cn(paths.C_E));
      @fmovs(s2d_x_dsd, fin(q_gb_in, S2D_XN));
      g4_oq2(r_color(L));
      oq_swapped = true;
      @fmovs(fout(q_gb_out, S2D_XN), s2d_x_dsd);
    } else {
      rt.iq_color(2, r_color(L));
      @fmovs(s2d_x_dsd, fin(q_gb_in, S2D_XN));
    }
    rt.iq_color(2, rt.cn(S2D_Q2C));
    @fmovs(g4_x0_dsd, s2d_x_dsd);
    @fmuls(s2d_x_dsd, s2d_x_dsd, G4_ES);
    @fmovs(g4_kvr_dsd, 0.0);
    return;
  }
  if (in_kind == 3 and px == py) {
    rt.iq_color(2, rt.cn(C_CV));
    g4_in_all();
    g4_oq2(r_color(L));
    oq_swapped = true;
    g4_out_all();
  } else {
    rt.iq_color(2, r_color(L));
    g4_in_all();
  }
  rt.iq_color(2, rt.cn(S2D_Q2C));
}

fn send_x() void {
  var send = false;
  if (out_kind == 1 and px == PX - 1) { g4_oq2(r_color(L + 1)); send = true; }
  if (out_kind == 2 and px == 0) { g4_oq2(r_color(L + 1)); send = true; }
  if (out_kind == 3 and px == py) { g4_oq2(rt.cn(C_CV)); send = true; }
  if (out_kind == 4 and px == py) {
    g4_oq2(rt.cn(paths.C_S));
    oq_swapped = true;
    @fmovs(fout(q_gb_out, S2D_XN), s2d_x_dsd);
    return;
  }
  if (send) {
    oq_swapped = true;
    g4_out_all();
  }
}

fn restore_oq() void {
  if (oq_swapped) {
    g4_oq2(rt.cn(S2D_Q2C));
    oq_swapped = false;
  }
}

// ---------------------------------------------------------------- the PLE row
var g4_lo: u16 = 0;
var g4_west_end: bool = false;
const PCW: u16 = if (PC >= 2) PC / 2 else 1;
var g4_pw = @zeros([B * PCW]u32);
var g4_pdum = @zeros([1]u32);
const g4_pw_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PCW} -> g4_pw[i] });
const g4_pdum_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> g4_pdum[0] });

fn g4_ple_in() void {
  if (PC == 0 or py != 0 or HEADMODE != 2) { return; }
  var b: u16 = 0;
  while (b < B) : (b += 1) {
    rt.iq_color(2, pl_color(b));
    if (g4_lo > 0) { @mov32(@set_dsd_length(g4_pdum_dsd, g4_lo), fin(q_gb_in, g4_lo)); }
    @mov32(@increment_dsd_offset(g4_pw_dsd, @as(i16, b * PCW), u32), fin(q_gb_in, PCW));
    const rest = NWW - g4_lo - PCW;
    if (rest > 0) { @mov32(@set_dsd_length(g4_pdum_dsd, rest), fin(q_gb_in, rest)); }
  }
  rt.iq_color(2, rt.cn(S2D_Q2C));
  // bf16 pairs (element 2i in the low half) to f32, scaled.
  var i: u16 = 0;
  while (i < B * PCW) : (i += 1) {
    const w = g4_pw[i];
    prow[2 * i] = @bitcast(f32, w << 16) * G4_PS;
    prow[2 * i + 1] = @bitcast(f32, w & 0xffff0000) * G4_PS;
  }
}

// ---------------------------------------------------------------- the shared tail's kv
const KVn: u16 = B * 2 * Dc;
const g4_kvi_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{KVn} -> kvi[i] });
const g4_kvo_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{KVn} -> kvo[i] });

// A tail layer (in the Y axis, after the QKV all-reduce): kvi = its column's
// k and v, from the diagonal's row.
fn g4_kv_in() void {
  if (OWN == 1) { return; }
  if (px == py) {
    var b: u16 = 0;
    while (b < B) : (b += 1) {
      var d: u16 = 0;
      while (d < 2 * Dc) : (d += 1) { kvi[b * 2 * Dc + d] = kvr[b * KVWn + KO + d]; }
    }
  } else {
    @fmovs(g4_kvi_dsd, 0.0);
  }
  allreduce(false, g4_kvi_dsd, KVn);
}

// A source layer (after the layer, whose last collective is hv_norm's Y
// all-reduce: X from here on): its k and v onto the rows (row j: column j's).
fn g4_kv_out() void {
  if (SHARE == 0) { return; }
  axis_xx();
  if (px != py) { @fmovs(g4_kvo_dsd, 0.0); }
  allreduce(false, g4_kvo_dsd, KVn);
  var b: u16 = 0;
  while (b < B) : (b += 1) {
    var d: u16 = 0;
    while (d < 2 * Dc) : (d += 1) { kvr[b * KVWn + KO + d] = kvo[b * 2 * Dc + d]; }
  }
}

// ---------------------------------------------------------------- the steps
var stamps = @zeros([4]u32);       // [3]: the steps done
var stamps_ptr: [*]u32 = &stamps;

// `steps` tokens from position `start_pos`, each through this grid once: the
// PLE row (row 0), x in from the layer before (layer 0: the head's), the
// layer, x out.
fn compute(steps: u32, start_pos: u32) void {
  timestamp.enable_tsc();
  var i: u32 = 0;
  while (i < steps) : (i += 1) {
    s2d_pass_start(i, start_pos);
    g4_ple_in();
    recv_x(i == 0);
    restore_oq();
    timing = i > 0;
    timestamp.get_timestamp(&t_mark);
    layer();
    send_x();
    stamps[3] = i + 1;
  }
  sys_mod.unblock_cmd_stream();
}

comptime {
  @export_symbol(stamps_ptr, "stamps");
}
