// serve_g4's PLE region: the head's columns east of head2d's block hold the
// per-layer embedding tables. Band sy (fabric rows [sy GPY, sy GPY + GPY)) holds
// strip sy's GW layers' tables: vocab row t's GW x PD bf16 values (layer by
// layer in the strip's order, two to a u32 word, element 2i in the low half:
// NWW words) live whole in one PE of the band, PE i = t / RPP (column i % NPC,
// band row i / NPC), slot t % RPP. Every head PE gets the token head2d
// decides (its winner multicast reaches these columns from the west); a
// step's owning PE sends its slot west on color 17 + lane: up its column to
// the band's top row (the strip's row 0), west along it through head2d's
// columns into the grids. The routes off the column (the top row's) are set
// a token, a whole model pass after the last token's words went by.
param memcpy_params;
param GPX: u16;
param GPY: u16;
param GW: u16;
param GH: u16;
param NL: u16;
param XP: u16;        // the region's first column
param NPC: u16;       // its columns
param RPP: u16;       // vocab rows a PE
param NWW: u16;       // u32 words a vocab row
param SB: u16;        // lanes
param HH: u16;        // head2d's rows (the winner reaches rows 0..HH)
param c_ib: color;
param WS: type;
param KS: type;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const rt = @import_module("rt.csl");

const C_PL0: color = @get_color(17);
const C_PL1: color = @get_color(18);
const C_PL2: color = @get_color(19);
const C_PL3: color = @get_color(20);
comptime { @comptime_assert(SB <= 4); }

const q_ib_in = @get_input_queue(7);
const q_p0 = @get_output_queue(2);
const q_p1 = @get_output_queue(3);
const q_p2 = @get_output_queue(4);
const q_p3 = @get_output_queue(5);

fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}
fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}

var ptab = @zeros([RPP * NWW]u32);
var ptab_ptr: [*]u32 = &ptab;
const row_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NWW} -> ptab[i] });
var ib = @zeros([1]f32);
const ib_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> ib[i] });

var my_c: u16 = 0;          // column in the region
var my_r: u16 = 0;          // row in the band
var band: bool = false;   // in a band of a strip with layers
var gets_ib: bool = false;

fn pl_route(b: u16, rx: u16, tx: u16) void {
  if (b == 0) { rt.route(C_PL0, rx, tx); }
  else if (b == 1) { rt.route(C_PL1, rx, tx); }
  else if (b == 2) { rt.route(C_PL2, rx, tx); }
  else { rt.route(C_PL3, rx, tx); }
}

// The noop the sends activate (their microthreads come free).
const t_sent: local_task_id = @get_local_task_id(9);
task sent() void {}

fn send(b: u16, slot: u16) void {
  const src = @increment_dsd_offset(row_dsd, @as(i16, slot * NWW), u32);
  if (b == 0) { @mov32(fout(q_p0, NWW), src, .{ .async = true, .activate = t_sent }); }
  else if (b == 1) { @mov32(fout(q_p1, NWW), src, .{ .async = true, .activate = t_sent }); }
  else if (b == 2) { @mov32(fout(q_p2, NWW), src, .{ .async = true, .activate = t_sent }); }
  else { @mov32(fout(q_p3, NWW), src, .{ .async = true, .activate = t_sent }); }
}

// Token t of lane b: the routes on its path, and its words if this PE owns them.
fn token(b: u16, t: u32) void {
  const i = t / @as(u32, RPP);
  const slot = @as(u16, t - i * @as(u32, RPP));
  const src_c = @as(u16, i % @as(u32, NPC));
  const src_r = @as(u16, i / @as(u32, NPC));
  const tx: u16 = if (my_r == 0) rt.TX_W else rt.TX_N;
  if (my_c == src_c) {
    if (my_r == src_r) {
      pl_route(b, rt.RX_R, tx);
      send(b, slot);
    } else if (my_r < src_r) {
      pl_route(b, rt.RX_S, tx);
    }
  } else if (my_c < src_c and my_r == 0) {
    pl_route(b, rt.RX_E, rt.TX_W);
  }
}

fn init() void {
  const x = layout_mod.get_x_coord();
  const y = layout_mod.get_y_coord();
  my_c = x - XP;
  my_r = y % GPY;
  band = y < GH * GPY and (y / GPY) * GW < NL;
  gets_ib = y <= HH;
  if (gets_ib) {
    if (my_c == NPC - 1) { rt.route(c_ib, rt.RX_W, rt.TX_R); }
    else { rt.route(c_ib, rt.RX_W, rt.TX_R | rt.TX_E); }
  }
  sys_mod.unblock_cmd_stream();
}

// head2d's iterations: steps + 1, SB lanes each, one winner each; the last
// iteration's tokens go nowhere.
fn compute(steps: u32, start_pos: u32) void {
  if (gets_ib) {
    var i: u32 = 0;
    while (i <= steps) : (i += 1) {
      var b: u16 = 0;
      while (b < SB) : (b += 1) {
        @fmovs(ib_dsd, fin(q_ib_in, 1));
        if (band and i < steps) { token(b, @as(u32, ib[0])); }
      }
    }
  }
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(sent, t_sent);
  @initialize_queue(q_ib_in, .{ .color = c_ib });
  @initialize_queue(q_p0, .{ .color = C_PL0 });
  @initialize_queue(q_p1, .{ .color = C_PL1 });
  @initialize_queue(q_p2, .{ .color = C_PL2 });
  @initialize_queue(q_p3, .{ .color = C_PL3 });
  @export_symbol(ptab_ptr, "ptab");
  @export_symbol(init);
  @export_symbol(compute);
}
