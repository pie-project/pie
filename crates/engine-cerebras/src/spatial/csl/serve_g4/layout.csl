// serve_g4: Gemma 4 dense. NL decoder layers as square grids of P x P PEs,
// GW across and GH down, serpentine as serve2d's (layer 0 top right; NL <=
// GW GH, the last strip's missing grids are fillers), each grid gemma4_layer
// with its layer's reading (bit L of KINDS: global, DcG dims a column, else
// sliding, DcS), its MLP width (IcS, the shared tail's IcT) and its kv's role:
// layers below NOWN own their kv, the last of each reading below NOWN shares
// it (SHARE), the tail (L >= NOWN) reads its reading's source's. serve2d's
// handoffs carry x, x0 and the tail's kv (grid_extra.csl); the f32 head2d
// over the tied embedding east of the grids (one block of P chunk columns
// and VMC), and east of it NPC columns of the per-layer embedding tables
// (ple_pe.csl), a band of P rows for each strip.
param P: u16;
param Hc: u16;
param Gs: u16;
param Qh: u16;
param DcS: u16;
param DcG: u16;
param IcS: u16;
param IcT: u16;
param PC: u16;         // PLE dims a column (P PC: the PLE width)
param KINDS: u64;      // bit L: layer L reads globally
param NL: u16;
param NOWN: u16;       // the shared tail's first layer (NL: none)
param PS: u16;
param NB: u16;
param E: u16;
param B: u16;
param MC: u16;
param GW: u16;
param GH: u16;
param ESB: u32;        // f32 bits: sqrt(hidden)
param PSB: u32;        // f32 bits: sqrt(PLE) / sqrt(2)
param NP: u16;
param F: u16;
param HH: u16;
param Vr: u16;
param Gx: u16;
param Gy: u16;
param Gb: u16;
param vocab: u32;
param PASSES: u16;
param UNTIED: u16;
param CERT: u16;
param MODE: u16;
param OVL: u16;
param VMC: u16;
param WF32: u16;
param CAP: u16;
param NPC: u16;        // PLE region columns
param RPP: u16;        // vocab rows a PLE PE
param G1: u16 = 0;     // the grids' all-reduce groups (0: Gs; at one kv head, 16 shortens the chains)
param WIN: u32 = 0;    // the sliding layers' window (slots a query sees, its own included; 0: all)
param DBG: u16 = 0;
param KVST: u16 = 0;
param VM: u16 = 0;     // the eta VM (not yet: head2d's stand-in columns)
param iters: u16 = 1;

const C_R1_0: color = @get_color(8);
const C_R1_1: color = @get_color(7);
const C_R2_0: color = @get_color(6);
const C_R2_1: color = @get_color(5);
const C_BC: color = @get_color(9);
const C_GB: color = @get_color(10);
const C_CP: color = @get_color(16);
const HLB: u16 = if (B < 4) B else 4;
const WS = u16;
const KS = f32;
const HW: u16 = P + VMC;                         // head2d's block
const XP: u16 = GW * P + HW;                     // the PLE region's first column
const GHGT: u16 = GH * P;
const HR2X: u16 = (P / Gx / 2) * Gx + Gx / 2;
const RH: u16 = if (HH + 1 > GHGT) HH + 1 else GHGT;
const KVW: u16 = if (NOWN < NL) 2 * (DcS + DcG) else 0;
const NWW: u16 = GW * P * PC / 2;
const memcpy = @import_module("<memcpy/get_params>", .{ .width = XP + NPC, .height = RH });

// Layer l's kv source among the layers below NOWN: the last of its reading.
fn src_of(l: u16) u16 {
  if (l < NOWN) { return l; }
  const g = (KINDS >> l) & 1;
  var s: u16 = NOWN;
  var j: u16 = 0;
  while (j < NOWN) : (j += 1) {
    if (((KINDS >> j) & 1) == g) { s = j; }
  }
  return s;
}
// Bit l: layer l shares its kv (once, not a tile).
fn share_bits() u64 {
  var m: u64 = 0;
  var t: u16 = NOWN;
  while (t < NL) : (t += 1) {
    const s = src_of(t);
    if (s < NOWN) { m = m | (@as(u64, 1) << s); }
  }
  return m;
}
const SHB: u64 = share_bits();
// The last layer's strip and grid column (its S staircase runs east from it).
const LSY: u16 = (NL - 1) / GW;
const LSX: u16 = if (LSY % 2 == 0) GW - 1 - (NL - 1) % GW else (NL - 1) % GW;

layout {
  @comptime_assert(GW >= 2 and NL <= GW * GH and NL > (GH - 1) * GW);
  @comptime_assert(F > 2 * P - 1 and F < (GH - 1) * P and F == HH / 2);
  // The PLE rows cross head2d's block on the strips' top rows, and the PLE
  // region's PEs get the winner (rows 0..HH).
  @comptime_assert(HH + 1 >= GHGT);
  @comptime_assert(PC == 0 or (PC % 2 == 0 and @as(u32, NPC) * @as(u32, P) * @as(u32, RPP) >= vocab));
  @comptime_assert(CERT == 0 and MODE == 0 and VM == 0);
  @comptime_assert(B <= 4 and B % MC == 0);
  @set_rectangle(XP + NPC, RH);
  for (@range(u16, XP + NPC)) |x| {
    const mp = memcpy.get_params(x);
    for (@range(u16, RH)) |y| {
      if (x >= XP) {
        @set_tile_code(x, y, "ple_pe.csl", .{
          .memcpy_params = mp, .GPX = P, .GPY = P, .GW = GW, .GH = GH, .NL = NL,
          .XP = XP, .NPC = NPC, .RPP = RPP, .NWW = (if (PC > 0) NWW else 1), .SB = B, .HH = HH,
          .c_ib = C_GB, .WS = WS, .KS = KS,
        });
      } else if (x >= GW * P and y <= HH) {
        @set_tile_code(x, y, "head_pe.csl", .{
          .memcpy_params = mp,
          .W = HW, .H = HH, .F = HH / 2, .C = P, .Hc = Hc, .Vr = Vr, .Gx = Gx, .Gy = Gy, .Gb = Gb,
          .vocab = vocab, .PASSES = PASSES, .UNTIED = UNTIED, .CERT = CERT, .MODE = MODE, .OVL = OVL,
          .VMC = VMC, .WF32 = WF32,
          .GPX = P, .GPY = P, .GW = GW, .GH = GH, .CAP = CAP, .SB = B, .HLB = HLB, .WS = WS, .KS = KS,
          .S2D_DBG = DBG, .G4_NL = NL, .G4_EAST = (if (PC > 0) 1 else 0),
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_x = C_BC, .c_ib = C_GB,
        });
      } else if (x >= GW * P or y >= GHGT) {
        @set_tile_code(x, y, "filler.csl", .{
          .memcpy_params = mp, .PX = P, .PY = P, .GW = GW, .GH = GH, .NL = NL, .F = F,
          .C = P, .VMC = VMC, .VMAT = HR2X + 1, .SB = B, .WS = WS, .KS = KS,
        });
      } else {
        const sx = x / P;
        const sy = y / P;
        const lk = if (sy % 2 == 0) GW - 1 - sx else sx;
        const ll = sy * GW + lk;
        if (ll >= NL) {
          @set_tile_code(x, y, "filler.csl", .{
            .memcpy_params = mp, .PX = P, .PY = P, .GW = GW, .GH = GH, .NL = NL, .F = F,
            .C = P, .VMC = VMC, .VMAT = HR2X + 1, .SB = B, .WS = WS, .KS = KS,
          });
        } else {
          const glob = ((KINDS >> ll) & 1) == 1;
          @set_tile_code(x, y, "grid_pe.csl", .{
            .memcpy_params = mp,
            .P = P, .Hc = Hc, .Dc = (if (glob) DcG else DcS), .Gs = Gs,
            .Ic = (if (ll < NOWN) IcS else IcT), .PS = PS, .NB = NB, .E = E, .B = B, .MC = MC, .Qh = Qh,
            .OWN = (if (ll < NOWN) 1 else 0), .SHARE = (if (((SHB >> ll) & 1) == 1) 1 else 0), .PC = PC,
            .W16 = 1, .NP = NP, .G1 = G1, .WIN = (if (glob) 0 else WIN),
            .GW = GW, .GH = GH, .NL = NL, .F = F, .HEADMODE = 2,
            .S2D_VMC = VMC, .S2D_VMAT = HR2X + 1, .S2D_DBG = DBG, .KVST = KVST,
            .S2D_PATHS = (if (sy <= 1) 1 else 0) | (if (ll == NL - 1) 2 else 0)
              | (if (sy == LSY and ll != NL - 1 and sx > LSX) 4 else 0),
            .KVW = KVW, .KO = (if (glob) 2 * DcS else 0), .NWW = (if (PC > 0) NWW else 1),
            .ESB = ESB, .PSB = PSB,
            .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
            .c_bc = C_BC, .c_gb = C_GB, .c_cp = C_CP,
          });
        }
      }
    }
  }
  @export_name("x", [*]f32, true);
  @export_name("tab", [*]u32, true);
  @export_name("gamma1", [*]f32, true);
  @export_name("gamma2", [*]f32, true);
  @export_name("gamma3", [*]f32, true);
  @export_name("gamma4", [*]f32, true);
  @export_name("gamma5", [*]f32, true);
  @export_name("scal", [*]f32, true);
  @export_name("kvi", [*]f32, true);
  @export_name("kvo", [*]f32, true);
  @export_name("x0", [*]f32, true);
  @export_name("prow", [*]f32, true);
  @export_name("wqa", [*]WS, true);
  @export_name("wqv", [*]WS, true);
  @export_name("wv", [*]WS, true);
  @export_name("wpm", [*]WS, true);
  @export_name("wpg", [*]WS, true);
  @export_name("wpp", [*]WS, true);
  @export_name("pnw", [*]f32, true);
  @export_name("qkn_w", [*]f32, true);
  @export_name("rot_c", [*]f32, true);
  @export_name("rot_s", [*]f32, true);
  @export_name("kc", [*]KS, true);
  @export_name("vc", [*]KS, true);
  @export_name("wo", [*]WS, true);
  @export_name("wgu", [*]WS, true);
  @export_name("wd", [*]WS, true);
  @export_name("prof", [*]u32, true);
  @export_name("dims", [*]u16, true);
  @export_name("fallbacks", [*]u32, true);
  @export_name("stamps", [*]u32, true);
  @export_name("kstage", [*]f32, true);
  @export_name("vstage", [*]f32, true);
  @export_name("wt", [*]u32, true);
  @export_name("et", [*]u32, true);
  @export_name("l2", [*]f32, true);
  @export_name("force", [*]u32, true);
  @export_name("lmax", [*]f32, true);
  @export_name("gmode", [*]u32, true);
  @export_name("vm_tok", [*]f32, true);
  @export_name("vin", [*]f32, true);
  @export_name("xin", [*]f32, true);
  @export_name("gam", [*]f32, true);
  @export_name("y", [*]f32, true);
  @export_name("emb", [*]f32, true);
  @export_name("tok", [*]f32, true);
  @export_name("in_tokens", [*]u32, true);
  @export_name("out_tokens", [*]u32, true);
  @export_name("yscale", [*]f32, true);
  @export_name("hlogits", [*]f32, true);
  @export_name("ptab", [*]u32, true);
  @export_name("init", fn()void);
  @export_name("compute", fn(u32, u32)void);
  @export_name("copy_page", fn(u32, u32)void);
  @export_name("copy_move", fn(u32, u32)void);
  @export_name("page_stage", fn(u32, u32)void);
  @export_name("page_unstage", fn(u32, u32)void);
}
