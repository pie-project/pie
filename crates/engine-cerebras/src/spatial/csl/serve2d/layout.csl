// serve2d: a model's decoder layers as NL = GW x GH grids of PX x PY PEs
// (Fork 6's qwen2d layer; grid_pe.csl is generated by sync.py), serpentine:
// strip sy runs west from the east end when even, east when odd, so layer 0
// is the top-right grid. Each PE finds its grid, place and routes from its own
// coordinates at `init`, so every grid shares one program. With HEADMODE 1 a
// PY-wide strip east of the grids is the stub head (head_stub.csl).
// qwen2d's parameters pass through unchanged.
param PX: u16;
param PY: u16;
param Hc: u16;
param HR: u16;
param Dc: u16;
param Gs: u16;
param Qh: u16;
param Ic: u16;
param Tc: u16;
param W16: u16;
param NP: u16;
param KV16: u16;
param PROF: u16;
// GRID 1: Fork 8's qwen2d_paged (B lanes over a paged KV pool; square grids
// PX = PY, f32), else qwen2d (one lane).
param GRID: u16;
param B: u16;          // lanes a pass (GRID 1; else 1)
param PS: u16;         // page size, positions (GRID 1)
param NB: u16;         // KV blocks a PE (GRID 1)
param E: u16;          // a lane's pages a row, at most (GRID 1)
param MC: u16;         // lanes an MLP chunk (GRID 1; B % MC == 0)
param GW: u16;
param GH: u16;
param HEADMODE: u16;   // 0: the host feeds layer 0 and reads the last; 1: the stub head; 2: head2d
param F: u16;          // the head's feeder row (HEADMODE > 0; HEADMODE 2: HH / 2)
// head2d (HEADMODE 2; its parameters, see head2d/layout.csl): one block of
// C = PY chunk columns (+ VMC), HH region rows of Vr vocab rows each.
param HH: u16;
param Vr: u16;
param Gx: u16;
param Gy: u16;
param Gb: u16;
param vocab: u32;
param PASSES: u16;
param UNTIED: u16;
param CERT: u16;
param MODE: u16;
param OVL: u16;
param VMC: u16;
param WF32: u16;
param CAP: u16;        // forced/output tokens a launch (in_tokens/out_tokens)
param DBG: u16;        // bisecting: 1 layer 0 keeps the host's x; 2 also no embedding chunk sent
param iters: u16;      // unused (the step count is a launch argument)
// The eta VM on the head's VM column (HEADMODE 2, VMC 1; vm_pe.csl from Fork 3's
// guest4h3): its image (max_ops, nreg, pool_words, feat), the out ring (ring_d
// steps a launch of ring_w words), the per-instruction profile (vm_prof 0 saves
// PE memory, where the VM source has the switch). VM 0: the column is head2d's
// stand-in.
param VM: u16 = 0;
param max_ops: u16 = 1;
param nreg: u16 = 1;
param pool_words: u16 = 1;
param feat: u32 = 0;
param ring_w: u16 = 1;
param ring_d: u16 = 32;
param vm_prof: u16 = 1;

const C_R1_0: color = @get_color(8);
const C_R1_1: color = @get_color(7);
const C_R2_0: color = @get_color(6);
const C_R2_1: color = @get_color(5);
const C_BC: color = @get_color(9);
const C_GB: color = @get_color(10);
const C_CP: color = @get_color(16);   // qwen2d_paged's page copies (in the grids only)
const SBL: u16 = if (GRID == 1) B else 1;
const HLB: u16 = if (SBL < 4) SBL else 4;   // lanes whose logits rows the head keeps

const WS = if (W16 == 1) u16 else f32;
const KS = if (KV16 == 1) u16 else f32;
// The head's strip east of the grids, one column a chunk (+ the VM column).
const HW: u16 = if (HEADMODE == 0) 0 else if (HEADMODE == 1) PY else PY + VMC;
const GHGT: u16 = GH * PY;                       // the grids' height
// head2d's root column in a block (C = PY columns), and its VM column after it.
const HR2X: u16 = if (HEADMODE == 2) (PY / Gx / 2) * Gx + Gx / 2 else 0;
const HVMC: u16 = if (HEADMODE == 2) VMC else 0;
const RH: u16 = if (HEADMODE == 2 and HH + 1 > GHGT) HH + 1 else GHGT;
const memcpy = @import_module("<memcpy/get_params>", .{ .width = GW * PX + HW, .height = RH });

layout {
  @comptime_assert(GW >= 2);
  // The staircases' non-crossing (paths.csl).
  @comptime_assert(HEADMODE == 0 or (F > 2 * PY - 1 and F < (GH - 1) * PY));
  @comptime_assert(HEADMODE != 2 or F == HH / 2);
  @comptime_assert(GRID == 0 or PX == PY);
  // VMC VM columns (Fork 3's multi-column VM: VMC = Vr / 32 slices of 32 rows).
  @comptime_assert(VM == 0 or (HEADMODE == 2 and VMC >= 1 and Vr == 32 * VMC));
  @set_rectangle(GW * PX + HW, RH);
  for (@range(u16, GW * PX + HW)) |x| {
    const mp = memcpy.get_params(x);
    for (@range(u16, RH)) |y| {
      if (x >= GW * PX and HEADMODE == 1) {
        @set_tile_code(x, y, "head_stub.csl", .{
          .memcpy_params = mp, .PX = PX, .PY = PY, .Hc = Hc, .GW = GW, .GH = GH, .F = F,
          .WS = WS, .KS = KS,
        });
      } else if (VM == 1 and x > GW * PX + HR2X and x <= GW * PX + HR2X + VMC and y <= HH) {
        @set_tile_code(x, y, "vm_pe.csl", .{
          .memcpy_params = mp,
          .W = HW, .H = HH, .F = HH / 2, .C = PY, .Vr = Vr, .NVC = VMC, .VJ = x - (GW * PX + HR2X + 1),
          .Gx = Gx, .Gb = Gb, .vocab = vocab,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_x = C_BC, .c_ib = C_GB,
          .max_ops = max_ops, .nreg = nreg, .pool_words = pool_words, .feat = feat, .ring = ring_d,
          .ring_w = ring_w, .vm_prof = vm_prof,
          .GPX = PX, .GPY = PY, .GW = GW, .GH = GH, .WS = WS, .KS = KS,
        });
      } else if (x >= GW * PX and y <= HH) {
        @set_tile_code(x, y, "head_pe.csl", .{
          .memcpy_params = mp,
          .W = HW, .H = HH, .F = HH / 2, .C = PY, .Hc = Hc, .Vr = Vr, .Gx = Gx, .Gy = Gy, .Gb = Gb,
          .vocab = vocab, .PASSES = PASSES, .UNTIED = UNTIED, .CERT = CERT, .MODE = MODE, .OVL = OVL,
          .VMC = VMC, .WF32 = WF32,
          .GPX = PX, .GPY = PY, .GW = GW, .GH = GH, .CAP = CAP, .SB = SBL, .HLB = HLB, .WS = WS, .KS = KS, .S2D_DBG = DBG,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_x = C_BC, .c_ib = C_GB,
        });
      } else if (x >= GW * PX or y >= GHGT) {
        @set_tile_code(x, y, "filler.csl", .{
          .memcpy_params = mp, .PX = PX, .PY = PY, .GW = GW, .GH = GH, .F = F,
          .C = PY, .VMC = HVMC, .VMAT = HR2X + 1, .WS = WS, .KS = KS,
        });
      } else if (GRID == 1) {
        @set_tile_code(x, y, "grid_paged_pe.csl", .{
          .memcpy_params = mp,
          .P = PX, .Hc = Hc, .Dc = Dc, .Gs = Gs, .Ic = Ic, .PS = PS, .NB = NB, .E = E, .B = B, .MC = MC,
          .GW = GW, .GH = GH, .NL = GW * GH, .F = F, .HEADMODE = HEADMODE,
          .S2D_VMC = HVMC, .S2D_VMAT = HR2X + 1, .S2D_DBG = DBG,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_bc = C_BC, .c_gb = C_GB, .c_cp = C_CP,
        });
      } else {
        @set_tile_code(x, y, "grid_pe.csl", .{
          .memcpy_params = mp,
          .PX = PX, .PY = PY, .Hc = Hc, .HR = HR, .Dc = Dc, .Gs = Gs, .Qh = Qh, .Ic = Ic, .Tc = Tc,
          .W16 = W16, .NP = NP, .KV16 = KV16, .PROF = PROF,
          .GW = GW, .GH = GH, .NL = GW * GH, .F = F, .HEADMODE = HEADMODE,
          .S2D_VMC = HVMC, .S2D_VMAT = HR2X + 1, .S2D_DBG = DBG,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_bc = C_BC, .c_gb = C_GB,
        });
      }
    }
  }
  @export_name("x", [*]f32, true);
  @export_name("gamma1", [*]f32, true);
  @export_name("gamma2", [*]f32, true);
  @export_name("wqkv", [*]WS, true);
  @export_name("qkn_w", [*]f32, true);
  @export_name("inv_freq", [*]f32, true);
  @export_name("kc", [*]KS, true);
  @export_name("vc", [*]KS, true);
  @export_name("wo", [*]WS, true);
  @export_name("wgu", [*]WS, true);
  @export_name("wd", [*]WS, true);
  @export_name("prof", [*]u32, true);
  @export_name("fallbacks", [*]u32, true);
  @export_name("stamps", [*]u32, true);
  @export_name("wt", [*]u32, true);
  @export_name("et", [*]u32, true);
  @export_name("l2", [*]f32, true);
  @export_name("force", [*]u32, true);
  @export_name("lmax", [*]f32, true);
  @export_name("gmode", [*]u32, true);
  @export_name("vm_tok", [*]f32, true);
  @export_name("vin", [*]f32, true);
  @export_name("xin", [*]f32, true);
  @export_name("gam", [*]f32, true);
  @export_name("y", [*]f32, true);
  @export_name("emb", [*]f32, true);
  @export_name("tok", [*]f32, true);
  @export_name("in_tokens", [*]u32, true);
  @export_name("out_tokens", [*]u32, true);
  @export_name("yscale", [*]f32, true);
  @export_name("hlogits", [*]f32, true);
  @export_name("gwide", [*]f32, true);
  @export_name("gpool", [*]u32, true);
  @export_name("gops", [*]u32, true);
  @export_name("gout", [*]u32, true);
  @export_name("gprof", [*]u32, true);
  @export_name("gostep", [*]u32, true);
  @export_name("gring", [*]u32, true);
  @export_name("gcycles", [*]u32, true);
  @export_name("gvalid", [*]u32, true);
  @export_name("gtok_home", [*]u32, true);
  @export_name("tab", [*]u32, true);
  @export_name("wqa", [*]f32, true);
  @export_name("wqv", [*]f32, true);
  @export_name("wv", [*]f32, true);
  @export_name("rot_c", [*]f32, true);
  @export_name("rot_s", [*]f32, true);
  @export_name("dims", [*]u16, true);
  @export_name("init", fn()void);
  @export_name("compute", fn(u32, u32)void);
  @export_name("copy_page", fn(u32, u32)void);
  @export_name("copy_move", fn(u32, u32)void);
}
