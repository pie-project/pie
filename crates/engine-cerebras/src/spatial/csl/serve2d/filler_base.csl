// serve2d's filler: the rectangle's PEs outside the grids and the head. They
// only route the staircases that cross them (paths.csl) and take part in
// launches.
param memcpy_params;
param PX: u16;
param PY: u16;
param GW: u16;
param GH: u16;
param F: u16;
param C: u16;          // the head's chunk columns a block, and its VM columns
param VMC: u16;
param VMAT: u16;       // the VM column's place in a head block (head2d: R2X + 1)
param WS: type;        // the grids' weight and KV element types (their exports)
param KS: type;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const paths = @import_module("paths.csl", .{ .GWD = PX, .GHT = PY, .GW = GW, .GH = GH, .NL = GW * GH,
                                             .XH = GW * PX, .F = F, .C = C, .VMC = VMC, .VMAT = VMAT });

fn init() void {
  paths.routes(layout_mod.get_x_coord(), layout_mod.get_y_coord());
  sys_mod.unblock_cmd_stream();
}

fn compute(steps: u32, start_pos: u32) void {
  sys_mod.unblock_cmd_stream();
}

comptime {
  @export_symbol(init);
  @export_symbol(compute);
}
