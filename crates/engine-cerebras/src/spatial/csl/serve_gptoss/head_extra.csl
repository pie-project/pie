// ---------------------------------------------------------------- serve_gptoss
// (appended to head2d_v10's pe.csl by codegen::serve_gptoss) The head of
// gpt-oss: one block of C = GPY / 3 chunk columns (+ the VM column), Hc =
// 3 GHc hidden dims a column: the last MoE unit's rows 3k .. 3k + 2 land in
// head column k.
// - Its feeder row takes the last layer's x by the S staircase: rows 3k,
//   3k + 1, 3k + 2 chained into one message on C_S into queue 3 (a
//   cross-block queue, unused with one block): [3][SB][GHc] (row, lane);
//   lane b's feeder input is [row 3k | row 3k + 1 | row 3k + 2] of lane b.
// - The final root decides each step's token: a forced (prompt) token wins,
//   else the argmax; it records the argmax in `out_tokens`. The winner index
//   it multicasts on c_ib runs on east past the head's last column into the
//   embedding strip (embed_pe.csl), which sends the token's embedding to
//   layer 0 (untied: model.embed_tokens there, lm_head.weight here).
// - `compute(steps, start_pos)`: steps + 1 iterations of SB lanes, as
//   serve8b_region's head.
const s2d_rt = @import_module("rt.csl");
const s2d_paths = @import_module("paths.csl", .{ .XH = XH0, .F = F, .C = C, .VMC = VMC, .VMAT = R2X + 1,
                                                 .EC = EC, .YS = YL });
comptime {
  @comptime_assert(NB == 1);           // one block: the feeder's queue 3, a feeder column a chunk triple
  @comptime_assert(3 * C == GPY);      // MoE rows 3k .. 3k + 2 in head column k
  @comptime_assert(Hc == 3 * GHc);
  @comptime_assert(MODE == 0 or MODE == 2);
}

const SAMPLE: u32 = 0xffffffff;
var in_tokens = @zeros([SB * CAP]u32);       // the final root's: forced tokens [lane][i] (SAMPLE: the argmax)
var in_tokens_ptr: [*]u32 = &in_tokens;
var out_tokens = @zeros([SB * CAP]u32);      // the final root's: iteration i's argmax at [lane][i - 1]
var out_tokens_ptr: [*]u32 = &out_tokens;
var s2d_lane: u16 = 0;
var s2d_yscale = @zeros([SB]f32);
var s2d_yscale_ptr: [*]f32 = &s2d_yscale;
var s2d_hl = @zeros([HLB * Vr]f32);
var s2d_hl_ptr: [*]f32 = &s2d_hl;
const s2d_hl_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Vr} -> s2d_hl[i] });
var s2d_iter: u32 = 0;
var s2d_steps: u32 = 0;
// The feeder's lanes from S: [3][SB][GHc].
var s2d_xa = @zeros([3 * SB * GHc]f32);
const s2d_xa_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{3 * SB * GHc} -> s2d_xa[i] });
const s2d_xa1_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{GHc} -> s2d_xa[i] });
const s2d_xin_1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{GHc} -> xin[i] });

fn s2d_head_init() void {
  s2d_paths.routes(px + XH0, py);
  if (vm) { return; }
  if (py == F) { s2d_rt.iq_color(3, s2d_rt.cn(s2d_paths.C_S)); }
}

fn s2d_after_x() void {}

// The feeder's x: zeros at the bootstrap iteration, else the last layer's
// chunk triple from S (every lane at the first lane's step).
fn s2d_feeder_in() void {
  if (s2d_iter == 0) {
    @fmovs(xin_dsd, 0.0);
    return;
  }
  if (s2d_lane == 0) { @fmovs(s2d_xa_dsd, fin(q_r1_0_in, 3 * SB * GHc)); }
  var r: u16 = 0;
  while (r < 3) : (r += 1) {
    @fmovs(@increment_dsd_offset(s2d_xin_1, @as(i16, r * GHc), f32),
           @increment_dsd_offset(s2d_xa1_dsd, @as(i16, (r * SB + s2d_lane) * GHc), f32));
  }
}

// The external VM's ctl word a lane step (VM5.md): bit lane * CAP + iteration
// of `vmctl` (host-written on the root column each fire); 1.0 asks the VM to
// skip the turn and answer token 0.
var s2d_vmctl = @zeros([(SB * CAP + 31) / 32]u32);
var s2d_vmctl_ptr: [*]u32 = &s2d_vmctl;
fn s2d_ctl() f32 {
  const k = @as(u32, s2d_lane) * @as(u32, CAP) + s2d_iter;
  if (s2d_iter >= CAP) { return 0.0; }
  return if (((s2d_vmctl[k / 32] >> @as(u16, k % 32)) & 1) == 1) 1.0 else 0.0;
}

// The final root: this iteration's token from the argmax `v`.
fn s2d_decide(v: f32) f32 {
  const i = s2d_iter;
  const row = @as(u32, s2d_lane) * @as(u32, CAP);
  if (v >= 0.0 and i >= 1 and i <= CAP) { out_tokens[row + i - 1] = @as(u32, v); }
  if (i < CAP and in_tokens[row + i] != SAMPLE) { return @as(f32, in_tokens[row + i]); }
  return v;
}

// After the winner: the root column keeps this lane's 1/rms and logits row.
fn s2d_emb_out() void {
  if (root_col) {
    s2d_yscale[s2d_lane] = yscale;
    if (s2d_lane < HLB) {
      @fmovs(@increment_dsd_offset(s2d_hl_dsd, @as(i16, s2d_lane * Vr), f32), y_dsd);
    }
  }
}

// `steps` model steps (the grids' count): steps + 1 head iterations, see
// above. start_pos is the grids' (the head keeps none).
fn compute(steps: u32, start_pos: u32) void {
  timestamp.enable_tsc();
  s2d_steps = steps;
  var i: u32 = 0;
  while (i <= steps) : (i += 1) {
    s2d_iter = i;
    var b: u16 = 0;
    while (b < SB) : (b += 1) {
      s2d_lane = b;
      timing = i > 1;
      timestamp.get_timestamp(&t_mark);
      if (vm) { step_vm(); } else if (py == F) { step_feeder(); } else { step_region(); }
    }
  }
  sys_mod.unblock_cmd_stream();
}

fn copy_kv(src: u32, dst: u32, phase: u32) void { sys_mod.unblock_cmd_stream(); }

comptime {
  @export_symbol(in_tokens_ptr, "in_tokens");
  @export_symbol(out_tokens_ptr, "out_tokens");
  @export_symbol(s2d_yscale_ptr, "yscale");
  @export_symbol(s2d_hl_ptr, "hlogits");
  @export_symbol(s2d_vmctl_ptr, "vmctl");
  if (KVCP == 1) { @export_symbol(copy_kv); }
}
