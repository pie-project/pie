// serve_gptoss: the two staircases between the end units, the head and the
// strip, as routes for whichever PE (head, strip or filler) they cross; the
// units' own ends come from the host's route table.
// S (last MoE unit -> head): the unit's east column chains rows 3k, 3k + 1
//   into row 3k + 2 (host tables), which sends the triple east on C_S along
//   its row to the head column of chunk triple k, then north up that column
//   to the feeder row F. Column k grows with k, so a row's leg only crosses
//   columns of lower triples, whose legs end above it.
// E (strip -> layer 0's attention unit): strip column xe(j) holds dims of
//   attention row j; its collector (row F) sends them north on C_E up to row
//   j, then west along row j into the unit's east column (XH - 1), which
//   multicasts them along the row. xe(j) falls with j, so a row's westward
//   leg only crosses columns of later rows, whose legs end below it.
param XH: u16;         // the head's first column
param F: u16;          // the feeder row
param C: u16;          // the head's chunk columns (MY / 3)
param VMC: u16;        // the VM column (0/1) at chunk column VMAT
param VMAT: u16;
param EC: u16;         // the strip's columns (AY), from XE = XH + C + VMC
param YS: u16;         // the last MoE unit's first row

const rt = @import_module("rt.csl");
const C_S: color = @get_color(20);
const C_E: color = @get_color(13);
const XE: u16 = XH + C + VMC;

fn hcol(k: u16) u16 { return XH + k + (if (VMC == 1 and k >= VMAT) 1 else 0); }
fn chunk_at(gx: u16) u16 {
  if (gx < XH or gx >= XE) { return C; }
  const off = gx - XH;
  if (VMC == 1 and off == VMAT) { return C; }
  return if (VMC == 1 and off > VMAT) off - 1 else off;
}
fn xe(j: u16) u16 { return XE + EC - 1 - j; }
fn row_at(gx: u16) u16 {
  if (gx < XE or gx >= XE + EC) { return EC; }
  return EC - 1 - (gx - XE);
}

fn routes(gx: u16, gy: u16) void {
  // S: triple k's row leg, then its column.
  if (gy >= YS and gy < YS + 3 * C and (gy - YS) % 3 == 2) {
    const k = (gy - YS) / 3;
    if (gx >= XH and gx < hcol(k)) { rt.route(C_S, rt.RX_W, rt.TX_E); }
    else if (gx == hcol(k)) { rt.route(C_S, rt.RX_W, rt.TX_N); }
  }
  const kc = chunk_at(gx);
  if (kc < C) {
    if (gy > F and gy < YS + 3 * kc + 2) { rt.route(C_S, rt.RX_S, rt.TX_N); }
    else if (gy == F) { rt.route(C_S, rt.RX_S, rt.TX_R); }
  }
  // E: row j's column, then its row leg west.
  const j = row_at(gx);
  if (j < EC) {
    if (gy == F) { rt.route(C_E, rt.RX_R, rt.TX_N); }
    else if (gy > j and gy < F) { rt.route(C_E, rt.RX_S, rt.TX_N); }
    else if (gy == j) { rt.route(C_E, rt.RX_S, rt.TX_W); }
  }
  if (gy < EC and gx >= XH and gx < xe(gy)) { rt.route(C_E, rt.RX_E, rt.TX_W); }
}
