// serve_gptoss's filler: the rectangle's PEs outside the units, the head and
// the strip (the free slots, and rows past the head). They only route the
// staircases that cross them (paths.csl) and take part in launches.
param memcpy_params;
param MY: u16;
param XH0: u16;        // the head's first column
param YS: u16;         // the last MoE unit's first row
param F: u16;
param VMC: u16;
param VMAT: u16;
param C: u16;
param EC: u16;
param HROUTE: u16;     // the layout's HROUTE (the dummies' exports)
param WS: type;        // the units' weight and KV element types (their exports)
param KS: type;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const paths = @import_module("paths.csl", .{ .XH = XH0, .F = F, .C = C, .VMC = VMC, .VMAT = VMAT,
                                             .EC = EC, .YS = YS });

fn init() void {
  paths.routes(layout_mod.get_x_coord(), layout_mod.get_y_coord());
  sys_mod.unblock_cmd_stream();
}

fn compute(steps: u32, start_pos: u32) void {
  sys_mod.unblock_cmd_stream();
}

comptime {
  @export_symbol(init);
  @export_symbol(compute);
}
