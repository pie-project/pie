// serve_gptoss: gpt-oss's layers as two kinds of units in slots, plus the
// head and the embedding strip (as serve8b_region's). A slot (c, d) of the
// GW x GH slots is PX columns x (AY + MY) rows at (c PX, d (AY + MY)):
// - the attention unit (gptoss_attn; attn_pe.csl): AY rows of AHc dims at the
//   slot's top, every kv head and its pool here;
// - the MoE unit below it (moe_mxfp4; moe_pe.csl): MY rows of MHc dims.
// Layer order (the host's gptoss_host.units()): slot row 0 from c = GW - 1
// west to 0, then the rows below it serpentine by columns (column 0 down,
// column 1 up, ...); the first NL slots hold layers, the rest are fillers.
// Layer 0 (slot (GW - 1, 0)) and the last (in column GW - 1, its MoE rows
// below the feeder row) sit next to the head at x GW PX: C = MY / 3 chunk
// columns of 3 MHc dims (+ VMC), then the strip east of it: EC = AY columns,
// one attention row's AHc dims each.
// Each unit PE's place, routes and handoff come from the host's route table
// (`rtab`, written before `init`), so one image serves every unit of a kind
// (two attention images: sliding layers carry WIN).
param PX: u16;
param AY: u16;         // attention rows, AHc dims a row
param AHc: u16;
param MY: u16;         // MoE rows, MHc dims a row
param MHc: u16;
param HR: u16;
param Dc: u16;
param Gs: u16;
param Qh: u16;
param Ic: u16;         // the MoE's intermediate dims a column
param NE: u16;
param TK: u16;
param AGY: u16;        // the units' Y phase-1 groups (divide AY, MY)
param MGY: u16;
param GW: u16;
param GH: u16;
param NL: u16;
param SLW: u32;        // bit l: layer l slides (window WIN)
param WIN: u32;
param RTR: u16;
param RTI: u16;        // pieces a unit PE receives (a re-chunk to the attention rows)
param PS: u16;
param NB: u16;
param E: u16;
param B: u16;
param MC: u16;
param NP: u16;
param PROF: u16;
param TIME: u16;
param HROUTE: u16;
param KVST: u16 = 0;
param HH: u16;
param Vr: u16;
param Gx: u16;
param Gy: u16;
param vocab: u32;
param PASSES: u16;
param MODE: u16;
param OVL: u16;
param VMC: u16;
param CAP: u16;
param HLBN: u16 = 0;
param iters: u16;
param NOLAYER: u16 = 0;   // 1 (checking the handoffs alone): the units skip their layers
param kernel_rows: u16 = 0;   // the bench driver's (unused)
param kernel_cols: u16 = 0;

const C_R1_0: color = @get_color(8);
const C_R1_1: color = @get_color(7);
const C_R2_0: color = @get_color(6);
const C_R2_1: color = @get_color(5);
const C_BC: color = @get_color(9);
const C_GB: color = @get_color(10);
const HLB: u16 = if (HLBN > 0) HLBN else if (B < 4) B else 4;
const SY: u16 = AY + MY;                     // a slot's rows
const XH: u16 = GW * PX;                     // the head's first column
const C: u16 = MY / 3;
const HW: u16 = C + VMC;
const XE: u16 = XH + HW;                     // the strip's
const EC: u16 = AY;
const F: u16 = HH / 2;
const HR2X: u16 = (C / Gx / 2) * Gx + Gx / 2;
const RCX: u16 = XH + HR2X;
const LH: u16 = GH * SY;
const RH: u16 = if (HH + 1 > LH) HH + 1 else LH;
// The last layer's slot row: column GW - 1 runs down if GW is odd.
const DL: u16 = NL - GW - (GW - 1) * (GH - 1);   // (GW odd: column GW - 1 runs down)
const YS: u16 = DL * SY + AY;                // the last MoE unit's first row
const memcpy = @import_module("<memcpy/get_params>", .{ .width = XE + EC, .height = RH });

// Slot (c, d)'s layer (NL: none).
fn slot_layer(c: u16, d: u16) u16 {
  var l: u16 = 0;
  if (d == 0) { l = GW - 1 - c; }
  else if (c % 2 == 0) { l = GW + c * (GH - 1) + d - 1; }
  else { l = GW + c * (GH - 1) + GH - 1 - d; }
  return if (l < NL) l else NL;
}

layout {
  @comptime_assert(GW % 2 == 1);              // the snake ends going down column GW - 1
  @comptime_assert(NL > GW and NL <= GW * GH);
  @comptime_assert(NL - GW > (GW - 1) * (GH - 1));   // the last layer in column GW - 1
  @comptime_assert(MY % 3 == 0 and AY * AHc >= HR and MY * MHc >= HR);
  @comptime_assert(AY % AGY == 0 and MY % MGY == 0);
  @comptime_assert(F >= AY and F < YS);       // the staircases' feeder row
  @comptime_assert(B % MC == 0);
  @comptime_assert(HR2X + 1 < C + VMC);
  @set_rectangle(XE + EC, RH);
  for (@range(u16, XE + EC)) |x| {
    const mp = memcpy.get_params(x);
    for (@range(u16, RH)) |y| {
      const c = x / PX;
      const d = y / SY;
      const l = if (x < XH and d < GH) slot_layer(c, d) else NL;
      const attn = l < NL and y % SY < AY;
      const moe = l < NL and y % SY >= AY;
      if (x >= XH and x < XE and y <= HH) {
        @set_tile_code(x, y, "head_pe.csl", .{
          .memcpy_params = mp, .KVST = KVST,
          .W = HW, .H = HH, .F = F, .C = C, .Hc = 3 * MHc, .Vr = Vr, .Gx = Gx, .Gy = Gy, .Gb = 1,
          .vocab = vocab, .PASSES = PASSES, .UNTIED = 0, .CERT = 0, .MODE = MODE, .OVL = OVL,
          .VMC = VMC, .WF32 = 0, .SCHAIN = 0,
          .GPX = PX, .GPY = MY, .GHc = MHc, .XH0 = XH, .XL = XH - PX, .YL = YS, .CAP = CAP, .SB = B,
          .HLB = HLB, .KVCP = 0, .HROUTE = HROUTE, .S2D_VMX = 0, .WS = u16, .KS = u16,
          .EC = EC,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_x = C_BC, .c_ib = C_GB,
        });
      } else if (x >= XE and y <= HH) {
        @set_tile_code(x, y, "embed_pe.csl", .{
          .memcpy_params = mp, .KVST = KVST, .MY = MY, .Hc = AHc, .XH0 = XH, .YS = YS,
          .F = F, .VMC = VMC, .VMAT = HR2X + 1, .C = C, .EC = EC, .Ve = Vr, .vocab = vocab, .B = B,
          .HROUTE = HROUTE, .WS = u16, .KS = u16,
        });
      } else if (attn) {
        @set_tile_code(x, y, "attn_pe.csl", .{
          .memcpy_params = mp, .KVST = KVST,
          .PX = PX, .PY = AY, .Hc = AHc, .HR = HR, .Dc = Dc, .Gs = Gs, .Qh = Qh, .Ic = 1,
          .PS = PS, .NB = NB, .E = E, .B = B, .MC = MC, .W16 = 1, .NP = NP, .KV16 = 1,
          .KVCP = 0, .PROF = PROF, .GY = AGY, .HROUTE = HROUTE,
          .WIN = if (((SLW >> l) & 1) == 1) WIN else 0,
          .S2D_TIME = TIME, .S2D_RTR = RTR, .S2D_RTI = RTI, .S2D_NOLAYER = NOLAYER,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_bc = C_BC, .c_gb = C_GB,
        });
      } else if (moe) {
        @set_tile_code(x, y, "moe_pe.csl", .{
          .memcpy_params = mp, .KVST = KVST,
          .PX = PX, .PY = MY, .Hc = MHc, .HR = HR, .Dc = 2, .Gs = Gs, .Qh = 1, .Ic = Ic,
          .PS = 2, .NB = 1, .E = 1, .B = B, .MC = MC, .W16 = 1, .NP = NP, .KV16 = 1,
          .KVCP = 0, .PROF = PROF, .GY = MGY, .HROUTE = HROUTE, .NE = NE, .TK = TK,
          .S2D_TIME = TIME, .S2D_RTR = RTR, .S2D_RTI = RTI, .S2D_NOLAYER = NOLAYER,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_bc = C_BC, .c_gb = C_GB,
        });
      } else {
        @set_tile_code(x, y, "filler.csl", .{
          .memcpy_params = mp, .KVST = KVST, .MY = MY, .XH0 = XH, .YS = YS, .F = F, .VMC = VMC,
          .VMAT = HR2X + 1, .C = C, .EC = EC, .HROUTE = HROUTE, .WS = u16, .KS = u16,
        });
      }
    }
  }
  @export_name("x", [*]f32, true);
  @export_name("tab", [*]u32, true);
  @export_name("gamma1", [*]f32, true);
  @export_name("gamma2", [*]f32, true);
  @export_name("wqa", [*]u16, true);
  @export_name("wqv", [*]u16, true);
  @export_name("wv", [*]u16, true);
  @export_name("qkn_w", [*]f32, true);
  @export_name("rot_c", [*]f32, true);
  @export_name("rot_s", [*]f32, true);
  @export_name("kc", [*]u16, true);
  @export_name("vc", [*]u16, true);
  @export_name("wo", [*]u16, true);
  @export_name("wgu", [*]u16, true);
  @export_name("wd", [*]u16, true);
  @export_name("prof", [*]u32, true);
  @export_name("dims", [*]u16, true);
  @export_name("rtab", [*]u16, true);
  @export_name("bqa", [*]f32, true);
  @export_name("bqv", [*]f32, true);
  @export_name("bv", [*]f32, true);
  @export_name("bo", [*]f32, true);
  @export_name("snk", [*]f32, true);
  @export_name("mx", [*]u32, true);
  @export_name("rw", [*]u16, true);
  @export_name("rb", [*]f32, true);
  @export_name("gub", [*]f32, true);
  @export_name("dnb", [*]f32, true);
  @export_name("mcfg", [*]u32, true);
  @export_name("wt", [*]u32, true);
  @export_name("et", [*]u32, true);
  @export_name("l2", [*]f32, true);
  @export_name("force", [*]u32, true);
  @export_name("lmax", [*]f32, true);
  @export_name("gmode", [*]u32, true);
  @export_name("vm_tok", [*]f32, true);
  @export_name("vin", [*]f32, true);
  @export_name("xin", [*]f32, true);
  @export_name("gam", [*]f32, true);
  @export_name("y", [*]f32, true);
  @export_name("emb", [*]f32, true);
  @export_name("tok", [*]f32, true);
  @export_name("in_tokens", [*]u32, true);
  @export_name("out_tokens", [*]u32, true);
  @export_name("yscale", [*]f32, true);
  @export_name("vmctl", [*]u32, true);
  @export_name("hlogits", [*]f32, true);
  @export_name("etab", [*]u32, true);
  if (HROUTE == 1) {
    @export_name("rcfg", [*]u32, true);
    @export_name("rbits", [*]u32, true);
  }
  // (every data name before the first function name)
  @export_name("init", fn()void);
  @export_name("compute", fn(u32, u32)void);
}
