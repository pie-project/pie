// split/ctl_cy_gptoss_moe.csl: the role-split column control PE (CY_c) of a gpt-oss MoE column. Design:
// spatial/split/README.md (gpt-oss).
//
// Role. One a MoE column, on the unit's middle row. A layer:
//   router reduction [partial | ssq] -> logit c mod NEX = partial x rsqrt(ssq / HR + eps) + bias, f32 end to
//   end; a NEX-column segment all-reduce on the control row gathers the NEX logits (each segment holds every
//   router output once, summed over the same rows in the same order: every CY gets the same logits); the
//   top TK (one pass; ties to the lower expert, as a stable sort), softmax over the TK selected logits ->
//   multicast [e_0..3 | w_0..3]
//   gate|up reduction (TK x [gate Ic | up Ic]) -> x 2^Pg[e] rsqrt, + biases, gate <= limit, up in
//   [-limit, limit], act = (up + 1) gate sigmoid(alpha gate), x w_k 2^Pd[e] -> multicast act' (TK Ic)
//
// Interface. Exports rb (f32 [layer] the router bias of this column's output), gb (f32 [layer][NEX][2 Ic]
// gate | up biases), ps (f32 [layer][NEX][2]: 2^Pg, 2^Pd), tdbg, rcfg, init, compute(steps, start_pos).
// rcfg: as ctl_cy_q35.csl ([7] the segment role, its colours [8] iq6 / [9] iq7, oq4).
//
// Params. Shape: K, Ic, NEX, TK, HR, ROUT (this column's router output is rcfg's word: it is a runtime
// role), SWL (limit 7), SWA (alpha 1.702).
param memcpy_params;
param DIAG: u16 = 0;
param K: u16;
param Ic: u16;
param NEX: u16 = 32;
param TK: u16 = 4;
param HR: u16;
param TSTAMP: u16 = 0;
param FIFOW: u16 = 32;
param SWL: f32 = 7.0;
param SWA: f32 = 1.702;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const timestamp = @import_module("<time>");
var tdbg = @zeros([1 + 3 * K]u32);
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { if (TSTAMP == 0) { return; } timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }
fn mx(a: u16, b: u16) u16 { return if (a > b) a else b; }

const G2: u16 = 2 * Ic;
const TN: u16 = TK * G2;
const EPS: f32 = 1.0e-5;
const HID: f32 = @as(f32, HR);
var t = @zeros([TN]f32);
var u = @zeros([mx(TK * Ic, 2 * TK)]f32);
var g = @zeros([NEX]f32);
const t_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> t[i] });
const u_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{mx(TK * Ic, 2 * TK)} -> u[i] });
const g_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NEX} -> g[i] });
fn tv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(t_d, @as(i16, o), f32), n); }
fn uv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(u_d, @as(i16, o), f32), n); }
var rb = @zeros([K]f32);
var rb_ptr: [*]f32 = &rb;
var gb = @zeros([K * NEX * G2]f32);
var gb_ptr: [*]f32 = &gb;
const gb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{G2} -> gb[i] });
var ps = @zeros([K * NEX * 2]f32);
var ps_ptr: [*]f32 = &ps;
var sel = @zeros([TK]u16);
var wsel = @zeros([TK]f32);
var vb: [TK * Ic]f32 align(16) = @zeros([TK * Ic]f32);
var vk = @zeros([TK * Ic]u16);
const vb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TK * Ic} -> vb[i] });
const vk_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TK * Ic} -> vk[i] });
var sg: [TK * Ic]f32 align(16) = @zeros([TK * Ic]f32);
const sg_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TK * Ic} -> sg[i] });

const q_n = @get_input_queue(2);
const q_s = @get_input_queue(3);
const q_lb = @get_input_queue(4);
const q_si = @get_input_queue(5);
const q_sm = @get_input_queue(6);
const q_s2 = @get_input_queue(7);
const q_lo = @get_output_queue(2);
const q_mc = @get_output_queue(3);
const q_so = @get_output_queue(4);
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
var fifo_buf = @zeros([FIFOW]f32);
const fifo = @allocate_fifo(fifo_buf);
fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}
const NR: u16 = 12;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 12]u32);
var rcfg_ptr: [*]u32 = &rcfg;
var role_s: u16 = 0;
var rout: u16 = 0;
fn iqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.input_queue_config.get_input_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.input_queue_config.in_queue_addr_range);
  @set_config(addr, (v & 0xffe0) | @as(u16, c), tile_config.input_queue_config.in_queue_addr_range);
}
fn oqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.output_queue_config.get_output_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.output_queue_config.out_queue_addr_range);
  @set_config(addr, (v & 0xfe0f) | (@as(u16, c) << 4), tile_config.output_queue_config.out_queue_addr_range);
}
var qcur = [6]u16 { 13, 14, 17, 18, 19, 20 };
fn iq_any(q: u16, c: u16) void {
  if (q == 0) { iqc(2, c); }
  else if (q == 1) { iqc(3, c); }
  else if (q == 2) { iqc(4, c); }
  else if (q == 3) { iqc(5, c); }
  else if (q == 4) { iqc(6, c); }
  else if (q == 5) { iqc(7, c); }
}
fn bind_iqs(fq: *[6]u16, tmp: u16) void {
  var done = @zeros([6]u16);
  var left: u16 = 6;
  var guard: u16 = 0;
  while (left > 0 and guard < 32) : (guard += 1) {
    var prog = false;
    var i: u16 = 0;
    while (i < 6) : (i += 1) {
      if (done[i] != 0) { continue; }
      var clash = false;
      var j: u16 = 0;
      while (j < 6) : (j += 1) { if (j != i and done[j] == 0 and qcur[j] == fq.*[i]) { clash = true; } }
      if (!clash) { iq_any(i, fq.*[i]); qcur[i] = fq.*[i]; done[i] = 1; left -= 1; prog = true; }
    }
    if (!prog) {
      i = 0;
      while (i < 6 and done[i] != 0) : (i += 1) {}
      iq_any(i, tmp); qcur[i] = tmp;
    }
  }
}
fn init() void {
  const cc0 = color_config.get_color_config_addr(@get_color(0));
  var k: u16 = 0;
  while (k < @as(u16, rcfg[0])) : (k += 1) {
    const addr = cc0 + @as(u16, rcfg[1 + 2 * k]);
    const r = @get_config(addr, tgt.color_addr_range) & 0xff00;
    @set_config(addr, r | @as(u16, rcfg[2 + 2 * k]), tgt.color_addr_range);
  }
  var fq = [6]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]), @as(u16, rcfg[RQ + 3]), @as(u16, rcfg[RQ + 8]), @as(u16, rcfg[RQ + 9]) };
  bind_iqs(&fq, @as(u16, rcfg[RQ + 10]));
  oqc(2, rcfg[RQ + 4]); oqc(3, rcfg[RQ + 5]); oqc(4, rcfg[RQ + 6]);
  role_s = @as(u16, rcfg[RQ + 7]);
  rout = @as(u16, rcfg[RQ + 11]);
  vpl = @set_dsd_stride(@set_dsd_base_addr(vk_d, @ptrcast([*]u16, &vb)), 2);
  timestamp.enable_tsc();
  sys_mod.unblock_cmd_stream();
}
fn reduce(n: u16) void {
  @fmovs(fifo, fin(q_s, n), .{ .async = true, .ut_id = ut_a });
  @fadds(fout(q_lo, n), fin(q_n, n), fifo, .{ .async = true, .ut_id = ut_b });
  @fmovs(tv(0, n), fin(q_lb, n));
}
// the control row's segment all-reduce of g (n words): roles 0 chain start, 1 add-forward, 4 root of two
// halves, 6 root of one half, 5 alone; the root multicasts on q_so, the others take it on q_sm
fn seg_ar(n: u16) void {
  const d = @set_dsd_length(g_d, n);
  if (role_s == 5) { return; }
  if (role_s == 4 or role_s == 6) {
    @fadds(d, d, fin(q_si, n));
    if (role_s == 4) { @fadds(d, d, fin(q_s2, n)); }
    @fmovs(fout(q_so, n), d);
    return;
  }
  if (role_s == 0) { @fmovs(fout(q_so, n), d); } else { @fadds(fout(q_so, n), fin(q_si, n), d); }
  @fmovs(d, fin(q_sm, n));
}

fn rsqrt(v: f32) f32 {
  var y = @bitcast(f32, @as(u32, 0x5f3759df) - (@bitcast(u32, v) >> 1));
  y = y * (1.5 - 0.5 * v * y * y);
  y = y * (1.5 - 0.5 * v * y * y);
  y = y * (1.5 - 0.5 * v * y * y);
  return y;
}
fn exp1(x0: f32) f32 {
  var x: f32 = if (x0 < -87.0) -87.0 else if (x0 > 88.0) 88.0 else x0;
  var k: f32 = x * 1.4426950408889634 + 12582912.0;
  k = k - 12582912.0;
  const r = x - k * 0.6931471805599453;
  var p: f32 = 0.0013888889;
  p = p * r + 0.008333334;
  p = p * r + 0.041666668;
  p = p * r + 0.16666667;
  p = p * r + 0.5;
  p = p * r + 1.0;
  p = p * r + 1.0;
  const ki = @as(i16, k) + 127;
  const s = @bitcast(f32, @as(u32, @as(u16, ki)) << 23);
  return p * s;
}
fn recip(v: f32) f32 { const a = if (v < 0.0) -v else v; const r = rsqrt(a); return if (v < 0.0) -(r * r) else r * r; }

const ex_a = [3]f32 { 12582912.0, -12582912.0, 12582912.0 };
const ex_c = [4]f32 { 0.16790908575057983, 0.5000435709953308, 0.9999634027481079, 0.9999992847442627 };
var vpl = vk_d;
// buf = exp(buf) (n words; exp_fast's form; p in vb, k's bits in vk)
fn vexp(buf: mem1d_dsd, n: u16) void {
  const p = @set_dsd_length(vb_d, n);
  const kk = @set_dsd_length(vk_d, n);
  const pl = @set_dsd_length(vpl, n);
  const ph = @increment_dsd_offset(pl, 1, u16);
  @fmaxs(buf, buf, -87.0);
  @fnegs(buf, buf);
  @fmaxs(buf, buf, -88.0);
  @fnegs(buf, buf);
  @fmuls(p, buf, 1.4426950408889634);
  var c: u16 = 0;
  while (c < 3) : (c += 1) {
    @fadds(p, p, ex_a[c]);
    if (c == 1) { @fmacs(buf, buf, p, -0.6931471805599453); }
  }
  @sll16(kk, pl, 7);
  @fmuls(p, buf, 0.041458580642938614);
  c = 0;
  while (c < 4) : (c += 1) {
    if (c > 0) { @fmuls(p, p, buf); }
    @fadds(p, p, ex_c[c]);
  }
  @add16(ph, ph, kk);
  @fmovs(buf, p);
}

fn router(l: u16) void {
  reduce(2);
  stamp(1 + 3 * l);
  const rr = rsqrt(t[1] / HID + EPS);
  @fmovs(g_d, 0.0);
  g[rout] = t[0] * rr + rb[l];
  seg_ar(NEX);
  // top TK in one pass (strictly greater moves up: ties keep the lower expert first)
  var k: u16 = 0;
  while (k < TK) : (k += 1) { sel[k] = 0xffff; }
  var e: u16 = 0;
  while (e < NEX) : (e += 1) {
    const v = g[e];
    var pos: u16 = TK;
    while (pos > 0 and (sel[pos - 1] == 0xffff or v > g[sel[pos - 1]])) : (pos -= 1) {}
    if (pos < TK) {
      var j: u16 = TK - 1;
      while (j > pos) : (j -= 1) { sel[j] = sel[j - 1]; }
      sel[pos] = e;
    }
  }
  const m0 = g[sel[0]];
  var sum: f32 = 0.0;
  k = 0;
  while (k < TK) : (k += 1) { wsel[k] = exp1(g[sel[k]] - m0); sum += wsel[k]; }
  const is = recip(sum);
  k = 0;
  while (k < TK) : (k += 1) {
    wsel[k] = wsel[k] * is;
    u[k] = @as(f32, sel[k]);
    u[TK + k] = wsel[k];
  }
  @fmovs(fout(q_mc, 2 * TK), uv(0, 2 * TK));
  stamp(2 + 3 * l);
  // gate|up: t = [k][gate Ic | up Ic]
  reduce(TN);
  k = 0;
  while (k < TK) : (k += 1) {
    const e2 = sel[k];
    const pb = (l * NEX + e2) * 2;
    @fmuls(tv(k * G2, G2), tv(k * G2, G2), ps[pb] * rr);
    @fadds(tv(k * G2, G2), tv(k * G2, G2), @set_dsd_base_addr(gb_d, @ptrcast([*]f32, &gb[(l * NEX + e2) * G2])));
    @fmovs(@set_dsd_length(@increment_dsd_offset(sg_d, @as(i16, k * Ic), f32), Ic), tv(k * G2, Ic));
    @fmovs(uv(k * Ic, Ic), tv(k * G2 + Ic, Ic));
  }
  const NG = TK * Ic;
  const G = @set_dsd_length(sg_d, NG);
  const U = uv(0, NG);
  // gate <= SWL: -max(-g, -SWL); up in [-SWL, SWL]
  @fnegs(G, G); @fmaxs(G, G, -SWL); @fnegs(G, G);
  @fmaxs(U, U, -SWL); @fnegs(U, U); @fmaxs(U, U, -SWL); @fnegs(U, U);
  // sigmoid(SWA g) = 1 / (1 + exp(-SWA g)): the exp in t's first words, the reciprocal per word
  const E = tv(0, NG);
  @fmuls(E, G, -SWA);
  vexp(E, NG);
  var i: u16 = 0;
  while (i < NG) : (i += 1) { t[i] = recip(1.0 + t[i]); }
  @fmuls(G, G, E);              // glu = g sigmoid(SWA g)
  @fadds(U, U, 1.0);
  @fmuls(U, U, G);              // act = (up + 1) glu
  k = 0;
  while (k < TK) : (k += 1) {
    const pb = (l * NEX + sel[k]) * 2;
    @fmuls(uv(k * Ic, Ic), uv(k * Ic, Ic), wsel[k] * ps[pb + 1]);
  }
  @fmovs(fout(q_mc, NG), U);
  stamp(3 + 3 * l);
}

var n_steps: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var s: u32 = 0;
  while (s < n_steps) : (s += 1) {
    stamp(0);
    var l: u16 = 0;
    while ((DIAG & 1) == 0 and (DIAG & 4) == 0 and l < (if ((DIAG & 2) != 0) 1 else K)) : (l += 1) { router(l); }
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_n, .{ .color = @get_color(13) });
  @initialize_queue(q_s, .{ .color = @get_color(14) });
  @initialize_queue(q_lb, .{ .color = @get_color(17) });
  @initialize_queue(q_si, .{ .color = @get_color(18) });
  @initialize_queue(q_sm, .{ .color = @get_color(19) });
  @initialize_queue(q_s2, .{ .color = @get_color(20) });
  @initialize_queue(q_lo, .{ .color = C_PARK });
  @initialize_queue(q_mc, .{ .color = C_PARK });
  @initialize_queue(q_so, .{ .color = C_PARK });
  @export_symbol(rb_ptr, "rb");
  @export_symbol(gb_ptr, "gb");
  @export_symbol(ps_ptr, "ps");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(init);
  @export_symbol(compute);
}
//@@ dummies
