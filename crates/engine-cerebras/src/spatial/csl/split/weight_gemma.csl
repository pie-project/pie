// split/weight_gemma.csl: the role-split weight PE for Gemma 4 (spatial/split/README.md 7; weight_q35.csl
// without GDN). Every layer is attention (KM bit l: global, else sliding), then the MLP, then the per-layer
// embedding (PLE) round. Per layer, its tiles: [qkv Hc x NQ][o QO x Hc][gate|up Hc x 2Ic][down Ic x Hc]
// [PLE gate Hc x 1][PLE projection 1 x Hc] (f16 bits; NQ = Qh Dc q (+ Dc k + Dc v unless SH), QO = Qh Dc, Dc by kind).
// Deferred norms: a hidden-input phase's row multicast is [a (Hc) | b (Hc) | 4 partial sums]: the PE runs the matvec
// on a and on b and sends [W a | W b | sums] down the column; CY combines them. The deferred scalar comes back in
// CY's multicast; column 0's PE adds it as the last word of its row partial (the other PEs add 0), so CX gets it.
// Caches: SH 0 (an owner unit): one a layer; SH 1 (a shared-KV unit): cache 0 sliding, cache 1 global, both fed by
// the source unit's CY row on the KVS colour (17 words a pass: k, v, |k|^2, |v|^2 partials of the source's sliding
// then global layer, and a sequence word): taken by an async receive posted at the end of every pass (and at init),
// so the source's sends never wait on a unit that has not started. A sliding cache is a ring of NES entries a row
// (position p on row p % PYW, entry (p / PYW) % NES); a global one has NEG entries (context NEG PYW). PYW may be
// fewer than the unit's rows (E4B: 128 of 160, so the 512 window is an exact ring of 4 x 128): a row at or past
// PYW never takes an entry, its empty caches score zeros (v and its count column 0) into every pass's reductions.
// v is stored normalised: |v|^2 rides the scores segment with |k|^2; the entry is finalised (1 / |k|, v / |v|) by
// the first layer that uses it in the pass.
param memcpy_params;
param DIAG: u16 = 0;   // 1: no layers (handoffs, head, I/O, the KVS line and its log)
param K: u16;
param Hc: u16;
param Ic: u16;
param MV: u16 = 1;
param KM: u16;         // bit l: layer l is global
param SH: u16 = 0;     // 1: shared-KV unit (q-only projections, the two shared caches)
param Qh: u16;
param DcS: u16;
param DcG: u16;
param NES: u16 = 4;
param NEG: u16;
param PYW: u16 = 128;
param HDS: u16 = 256;
param HDG: u16 = 512;
param ATTL: u16 = 2;
param WSPEC: u16 = 0;  // 1: the attention mixer specialized a layer kind (larger code; E2B); 2: and the sliding ring whole
param WIN: u16 = 0;    // > 0: the sliding window (the ring of NES PYW entries is longer: older entries are masked)
param PLOG: u16 = 0;   // 1: the full model logs each step's KVS words too (kvlog, as DIAG 1)
param TSTAMP: u16 = 0;
param FIFOW: u16 = 32;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const timestamp = @import_module("<time>");
const NTD: u16 = 1 + 9 * K;
var tdbg = @zeros([if (TSTAMP == 1) NTD else 1]u32);
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { if (TSTAMP == 0) { return; } timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }
fn mx(a: u16, b: u16) u16 { return if (a > b) a else b; }

// ---------------------------------------------------------------- per-layer shapes
fn isg(l: u16) bool { return ((KM >> l) & 1) == 1; }
fn dcl(l: u16) u16 { return if (isg(l)) DcG else DcS; }
fn nql(l: u16) u16 { return Qh * dcl(l) + (if (SH == 1) 0 else 2 * dcl(l)); }
fn lw(l: u16) u32 {
  const H = @as(u32, Hc);
  return H * nql(l) + @as(u32, Qh * dcl(l)) * H + H * 2 * Ic + @as(u32, Ic) * H + 2 * H;
}
fn wtot() u32 { var n: u32 = 0; var l: u16 = 0; while (l < K) : (l += 1) { n += lw(l); } return n; }
const WN: u32 = wtot();
// (a unit's tiles index in u16: offsets as u16 products, no 64-bit multiply helper)
comptime { @comptime_assert(WN < 65536); }
var w = @zeros([WN + 1]u16);
var w_ptr: [*]u16 = &w;

// caches
const NC: u16 = if (SH == 1) 2 else K;
fn cg(c: u16) bool { return if (SH == 1) c == 1 else isg(c); }
fn cne(c: u16) u16 { return if (cg(c)) NEG else NES; }
fn cdc(c: u16) u16 { return if (cg(c)) DcG else DcS; }
fn ckw(c: u16) u16 { return cdc(c) * cne(c); }
fn cvw(c: u16) u16 { return cne(c) * (cdc(c) + 1); }
fn sum_kw() u16 { var n: u16 = 0; var c: u16 = 0; while (c < NC) : (c += 1) { n += ckw(c); } return n; }
fn sum_vw() u16 { var n: u16 = 0; var c: u16 = 0; while (c < NC) : (c += 1) { n += cvw(c); } return n; }
fn sum_ne() u16 { var n: u16 = 0; var c: u16 = 0; while (c < NC) : (c += 1) { n += cne(c); } return n; }
// a cache's offsets: tables built at comptime (the runtime loops over the caches cost ~40 cycles a call, several a layer)
fn mkoff(comptime k: u16) [NC + 1]u16 {
  var r = @zeros([NC + 1]u16);
  var c: u16 = 0;
  while (c < NC) : (c += 1) {
    r[c + 1] = r[c] + (if (k == 0) ckw(c) else if (k == 1) cvw(c) else if (k == 2) cne(c) else if (cg(c)) 0 else cne(c));
  }
  return r;
}
const KOFF = mkoff(0);
const VOFF = mkoff(1);
const EOFF = mkoff(2);
const SOFF = mkoff(3);
fn koff(c: u16) u16 { return KOFF[c]; }
fn voff(c: u16) u16 { return VOFF[c]; }
fn eoff(c: u16) u16 { return EOFF[c]; }
fn cache_of(l: u16) u16 { return if (SH == 1) (if (isg(l)) 1 else 0) else l; }
var kc = @zeros([sum_kw() + 1]u16);
var vc = @zeros([sum_vw() + 1]u16);
var kinv = @zeros([sum_ne()]f32);
var mref = @zeros([K * Qh]f32);
var pv = @zeros([NC * DcG]f32);      // the pending entry's raw v a cache
var pks = @zeros([NC]f32);           // its |k|^2, |v|^2 partials (this column's)
var pvs = @zeros([NC]f32);
var pend = @zeros([NC]u16);
fn soff(c: u16) u16 { return SOFF[c]; }
var spos = @zeros([if (WIN > 0) soff(NC) else 1]f32);   // (WIN > 0) a sliding entry's position + 1 (sliding caches only)

// ---------------------------------------------------------------- buffers
const NEM: u16 = mx(NES, NEG);
const NS: u16 = Qh * NEM + Qh + 2;
const QOM: u16 = Qh * DcG;
const NQM: u16 = Qh * DcG + (if (SH == 1) 0 else 2 * DcG);
const XN: u16 = mx(mx(mx(Hc, QOM), Ic), Qh * NEM);
const YN: u16 = mx(mx(mx(2 * NQM + 4, 4 * Ic + 4), mx(Hc + 1, NS)), Qh * (DcG + 1));
var xh = @zeros([XN]@fp16());
var y: [YN]f32 align(16) = @zeros([YN]f32);
// the f16 accumulator (the largest f16 matvec: 2 Ic, NQ, Hc) and exp_v's 2^k bits (Qh NE u16)
const Y16N: u16 = mx(mx(2 * Ic, NQM), mx(Hc, Qh * NEM));
var y16 = @zeros([Y16N]@fp16());
const xh_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XN} -> xh[i] });
const y_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{YN} -> y[i] });
const y_d0 = y_d;
const y16_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Y16N} -> y16[i] });
var a_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{YN} -> w[i] });

// ---------------------------------------------------------------- fabric (weight_q35's queues)
const q_xa = @get_input_queue(2);
const q_xb = @get_input_queue(3);
const q_ya = @get_input_queue(4);
const q_yb = @get_input_queue(5);
const q_xm = @get_input_queue(6);
const q_ym = @get_input_queue(7);
const q_xo = @get_output_queue(5);
const q_yo = @get_output_queue(3);
const q_ao = @get_output_queue(4);
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
const ut_xa = @get_ut_id(2);
const ut_xb = @get_ut_id(3);
const ut_k = @get_ut_id(7);          // the KVS receive (iq7's microthread)
var fifo_buf = @zeros([FIFOW]f32);
const fifo = @allocate_fifo(fifo_buf);
var fifo_xbuf = @zeros([FIFOW]f32);
const fifo_x = @allocate_fifo(fifo_xbuf);
fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}

// rcfg (host, split_geo_gemma.rcfg_weight_g): weight_q35's words; [RQ+11] flags (bit 0 column 0, bit 1 KVS
// consumer, bit 2 the flush unit), [RQ+12] the KVS colour
const NR: u16 = 18;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 25]u32);
var rcfg_ptr: [*]u32 = &rcfg;
var role_x: u16 = 0;
var role_y: u16 = 0;
var role_s: u16 = 0;
var myrow: u16 = 0;
var wfl: u16 = 0;

fn iqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.input_queue_config.get_input_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.input_queue_config.in_queue_addr_range);
  @set_config(addr, (v & 0xffe0) | @as(u16, c), tile_config.input_queue_config.in_queue_addr_range);
}
fn oqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.output_queue_config.get_output_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.output_queue_config.out_queue_addr_range);
  @set_config(addr, (v & 0xfe0f) | (@as(u16, c) << 4), tile_config.output_queue_config.out_queue_addr_range);
}
var qcur = [6]u16 { 13, 14, 17, 18, 19, 20 };
fn iq_any(q: u16, c: u16) void {
  if (q == 0) { iqc(2, c); }
  else if (q == 1) { iqc(3, c); }
  else if (q == 2) { iqc(4, c); }
  else if (q == 3) { iqc(5, c); }
  else if (q == 4) { iqc(6, c); }
  else if (q == 5) { iqc(7, c); }
}
var done = @zeros([6]u16);
var fq = @zeros([6]u16);
fn bind_iqs(fin: *[6]u16, tmp: u16) void {
  var z: u16 = 0;
  while (z < 6) : (z += 1) { done[z] = 0; }
  var left: u16 = 6;
  var guard: u16 = 0;
  while (left > 0 and guard < 32) : (guard += 1) {
    var prog = false;
    var i: u16 = 0;
    while (i < 6) : (i += 1) {
      if (done[i] != 0) { continue; }
      var clash = false;
      var j: u16 = 0;
      while (j < 6) : (j += 1) { if (j != i and done[j] == 0 and qcur[j] == fin.*[i]) { clash = true; } }
      if (!clash) { iq_any(i, fin.*[i]); qcur[i] = fin.*[i]; done[i] = 1; left -= 1; prog = true; }
    }
    if (!prog) {
      i = 0;
      while (i < 6 and done[i] != 0) : (i += 1) {}
      iq_any(i, tmp); qcur[i] = tmp;
    }
  }
}

fn init() void {
  const cc0 = color_config.get_color_config_addr(@get_color(0));
  var k: u16 = 0;
  while (k < @as(u16, rcfg[0])) : (k += 1) {
    const addr = cc0 + @as(u16, rcfg[1 + 2 * k]);
    const r = @get_config(addr, tgt.color_addr_range) & 0xff00;
    @set_config(addr, r | @as(u16, rcfg[2 + 2 * k]), tgt.color_addr_range);
  }
  var q: u16 = 0;
  while (q < 6) : (q += 1) { fq[q] = @as(u16, rcfg[RQ + q]); }
  bind_iqs(&fq, @as(u16, rcfg[RQ + 24]));
  oqc(5, rcfg[RQ + 6]);
  oqc(3, rcfg[RQ + 7]);
  role_x = @as(u16, rcfg[RQ + 8]);
  role_y = @as(u16, rcfg[RQ + 9]);
  role_s = @as(u16, rcfg[RQ + 10]);
  wfl = @as(u16, rcfg[RQ + 11]);
  myrow = @as(u16, rcfg[RQ + 17]);
  timestamp.enable_tsc();
  if (WSPEC == 2) { fr_init(); }
  if (SH == 1 and (wfl & 2) != 0 and (DIAG & 64) == 0) { kv_post(); }
  sys_mod.unblock_cmd_stream();
}

fn send_x(n: u16) void {
  const d = @set_dsd_length(y_d, n);
  const A = .{ .async = true, .ut_id = ut_xb };
  if (role_x == 0) { @fmovs(fout(q_xo, n), d, A); }
  else if (role_x == 2) {
    @fadds(fifo_x, fin(q_xa, n), d, .{ .async = true, .ut_id = ut_xa });
    @fadds(fout(q_xo, n), fin(q_xb, n), fifo_x, A);
  } else { @fadds(fout(q_xo, n), fin(q_xa, n), d, A); }   // roles 1, 3
}
fn send_y(n: u16) void {
  const d = @set_dsd_length(y_d, n);
  const A = .{ .async = true, .ut_id = ut_b };
  if (role_y == 0) { @fmovs(fout(q_yo, n), d, A); }
  else if (role_y == 2) {
    @fadds(fifo, fin(q_ya, n), d, .{ .async = true, .ut_id = ut_a });
    @fadds(fout(q_yo, n), fin(q_yb, n), fifo, A);
  } else { @fadds(fout(q_yo, n), fin(q_ya, n), d, A); }   // roles 1, 3
}

// ---------------------------------------------------------------- matvec
const mv_dest = @get_dsr(dsr_dest, 1);
const mv_src0 = @get_dsr(dsr_src0, 1);
const mv_src1 = @get_dsr(dsr_src1, 1);
fn mvs_step(xv: @fp16()) void { @fmachs(mv_dest, mv_src0, mv_src1, xv); }
fn mvh_step(xv: @fp16()) void { @fmach(mv_dest, mv_src0, mv_src1, xv); }
// y[yo..yo+N) = A x, A at w[off] (R rows of N), x in xh[0..R)
fn mv(off: u16, R: u16, N: u16, yo: u16) void {
  const a = @set_dsd_length(@set_dsd_base_addr(a_d, @ptrcast([*]u16, &w[off])), N);
  const xv = @set_dsd_length(xh_d, R);
  const yv = @set_dsd_length(@increment_dsd_offset(y_d0, @as(i16, yo), f32), N);
  if (MV == 1) {
    const yh = @set_dsd_length(y16_d, N);
    @fmovh(yh, @as(@fp16(), 0.0));
    @load_to_dsr(mv_dest, yh, .{ .save_address = false });
    @load_to_dsr(mv_src0, yh, .{ .save_address = false });
    @load_to_dsr(mv_src1, a, .{ .save_address = true });
    @map(mvh_step, xv);
    @fh2s(yv, yh);
  } else {
    @fmovs(yv, 0.0);
    @load_to_dsr(mv_dest, yv, .{ .save_address = false });
    @load_to_dsr(mv_src0, yv, .{ .save_address = false });
    @load_to_dsr(mv_src1, a, .{ .save_address = true });
    @map(mvs_step, xv);
  }
}
// KV matvecs: f16 operands, f32 accumulation (weight_q35.kvmv)
fn kvmv(p: [*]u16, R: u16, N: u16, xo: u16, yo: u16) void {
  const a = @set_dsd_length(@set_dsd_base_addr(a_d, p), N);
  const xv = @set_dsd_length(@increment_dsd_offset(xh_d, @as(i16, xo), @fp16()), R);
  const yv = @set_dsd_length(@increment_dsd_offset(y_d0, @as(i16, yo), f32), N);
  @fmovs(yv, 0.0);
  @load_to_dsr(mv_dest, yv, .{ .save_address = false });
  @load_to_dsr(mv_src0, yv, .{ .save_address = false });
  @load_to_dsr(mv_src1, a, .{ .save_address = true });
  @map(mvs_step, xv);
}
// A deferred phase: [a | b | 4 sums] in, [W a | W b | sums] out (2 N + 4 words)
fn mv2(off: u16, N: u16) void {
  @fs2h(@set_dsd_length(xh_d, Hc), fin(q_xm, Hc));
  mv(off, Hc, N, 0);
  @fs2h(@set_dsd_length(xh_d, Hc), fin(q_xm, Hc));
  mv(off, Hc, N, N);
  @fmovs(@set_dsd_length(@increment_dsd_offset(y_d, @as(i16, 2 * N), f32), 4), fin(q_xm, 4));
  send_y(2 * N + 4);
}
// the row partial with the deferred scalar as its last word (column 0's PE only)
fn send_row(sv: f32) void {
  y[Hc] = if ((wfl & 1) != 0) sv else 0.0;
  send_x(Hc + 1);
}

// ---------------------------------------------------------------- segments (weight_q35.qmode / seg_ar)
fn qmode(m: u16) void {
  while ((tile_config.output_queue_status.get_raw() & 0x1000) == 0) {}   // oq4 empty
  if (m == 0) {
    iqc(6, rcfg[RQ + 4]); iqc(7, rcfg[RQ + 5]);
  } else {
    iqc(7, rcfg[RQ + 13]); oqc(4, rcfg[RQ + 15]);
    iqc(6, if (role_s == 4) rcfg[RQ + 14] else rcfg[RQ + 16]);
  }
}
var sx = @zeros([NS]f32);
const sx_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NS} -> sx[i] });
fn seg_ar(n: u16) void {
  const d = @set_dsd_length(sx_d, n);
  qmode(2);
  if (role_s == 4) {
    @fadds(d, d, fin(q_ym, n));
    @fadds(d, d, fin(q_xm, n));
    @fmovs(fout(q_ao, n), d);
  } else if (role_s == 6) {
    @fadds(d, d, fin(q_ym, n));
    @fmovs(fout(q_ao, n), d);
  } else {
    const A = .{ .async = true, .ut_id = ut_b };
    if (role_s == 0) { @fmovs(fout(q_ao, n), d, A); }
    else { @fadds(fout(q_ao, n), fin(q_ym, n), d, A); }
    @fmovs(d, fin(q_xm, n));
  }
  qmode(0);
}
const ex_a = [3]f32 { 12582912.0, -12582912.0, 12582912.0 };
const ex_c = [4]f32 { 0.16790908575057983, 0.5000435709953308, 0.9999634027481079, 0.9999992847442627 };
// the scores' clamp from above: ln(65504) less 7e-5, so exp(XHI) rounds to the f16 max (65504) and a larger score's
// probability is the f16 max as min(exp(s), 65504) gave (the probabilities only reach the PE as f16)
const XHI: f32 = 11.0898;
// y[0..n) = exp(buf[0..n)) (buf clamped to [-87, XHI], then the exp's reduced argument)
fn exp_v(buf: mem1d_dsd, n: u16) void {
  const p = @set_dsd_length(y_d, n);
  const kk = @set_dsd_length(@set_dsd_base_addr(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{YN} -> w[i] }), @ptrcast([*]u16, &y16)), n);
  const pl = @set_dsd_length(@set_dsd_stride(@set_dsd_base_addr(kk, @ptrcast([*]u16, &y)), 2), n);
  const ph = @increment_dsd_offset(pl, 1, u16);
  @fmaxs(buf, buf, -87.0);
  @fnegs(buf, buf);
  @fmaxs(buf, buf, -XHI);
  @fnegs(buf, buf);
  @fmuls(p, buf, 1.4426950408889634);
  var c: u16 = 0;
  while (c < 3) : (c += 1) {
    @fadds(p, p, ex_a[c]);
    if (c == 1) { @fmacs(buf, buf, p, -0.6931471805599453); }
  }
  @sll16(kk, pl, 7);
  @fmuls(p, buf, 0.041458580642938614);
  c = 0;
  while (c < 4) : (c += 1) {
    if (c > 0) { @fmuls(p, p, buf); }
    @fadds(p, p, ex_c[c]);
  }
  @add16(ph, ph, kk);
}
// (WSPEC 2) exp_v on the whole sliding ring's scores (Qh NES): fixed-length views, the u16 ones built once at init
const NFR: u16 = Qh * NES;
const fS = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NFR} -> sx[i] });
const fP = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NFR} -> y[i] });
const fH = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NFR} -> xh[i] });
var fK = y16_d;
var fPL = y16_d;
var fPH = y16_d;
fn fr_init() void {
  fK = @set_dsd_length(@set_dsd_base_addr(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{YN} -> w[i] }), @ptrcast([*]u16, &y16)), NFR);
  fPL = @set_dsd_length(@set_dsd_stride(@set_dsd_base_addr(fK, @ptrcast([*]u16, &y)), 2), NFR);
  fPH = @increment_dsd_offset(fPL, 1, u16);
}
// exp_v(fS) and the f16 copy into xh (the same ops as the runtime path)
fn exp_fr() void {
  @fmaxs(fS, fS, -87.0);
  @fnegs(fS, fS);
  @fmaxs(fS, fS, -XHI);
  @fnegs(fS, fS);
  @fmuls(fP, fS, 1.4426950408889634);
  @fadds(fP, fP, ex_a[0]);
  @fadds(fP, fP, ex_a[1]);
  @fmacs(fS, fS, fP, -0.6931471805599453);
  @fadds(fP, fP, ex_a[2]);
  @sll16(fK, fPL, 7);
  @fmuls(fP, fS, 0.041458580642938614);
  @fadds(fP, fP, ex_c[0]);
  @fmuls(fP, fP, fS);
  @fadds(fP, fP, ex_c[1]);
  @fmuls(fP, fP, fS);
  @fadds(fP, fP, ex_c[2]);
  @fmuls(fP, fP, fS);
  @fadds(fP, fP, ex_c[3]);
  @add16(fPH, fPH, fK);
  @fs2h(fH, fP);
}
const IHDS: f32 = 1.0 / @as(f32, HDS);
const IHDG: f32 = 1.0 / @as(f32, HDG);
fn rsq(v: f32) f32 {
  var r = @bitcast(f32, @as(u32, 0x5f3759df) - (@bitcast(u32, v) >> 1));
  r = r * (1.5 - 0.5 * v * r * r);
  r = r * (1.5 - 0.5 * v * r * r);
  r = r * (1.5 - 0.5 * v * r * r);
  return r;
}

// ---------------------------------------------------------------- caches
// the step's position: its row (pos % PYW), entry (pos / PYW) and pos + 1 as f32, worked out once a step and from the
// last position when it is the next one (a u32 divide by a PYW that is not a power of two, E4B's 160, is a ~270-cycle
// helper call, and u32 -> f32 ~60: a layer used to pay for several)
var q_pos: u32 = 0xffffffff;
var q_row: u16 = 0;
var q_ent: u16 = 0;
var q_pf: f32 = 0.0;
fn posq(pos: u32) void {
  if (pos == q_pos) { return; }
  if (q_pos != 0xffffffff and pos == q_pos + 1) {
    q_row += 1;
    if (q_row == PYW) { q_row = 0; q_ent += 1; }
  } else {
    q_row = @as(u16, pos % @as(u32, PYW));
    q_ent = @as(u16, pos / @as(u32, PYW));
  }
  q_pos = pos;
  q_pf = @as(f32, pos + 1);
}
fn cslot(c: u16, pos: u32) u16 {
  posq(pos);
  return if (cg(c)) q_ent else q_ent % NES;
}
fn cache_reset(c: u16) void {
  var i: u16 = 0;
  while (i < ckw(c)) : (i += 1) { kc[1 + koff(c) + i] = 0; }
  i = 0;
  while (i < cvw(c)) : (i += 1) { vc[1 + voff(c) + i] = 0; }
  i = 0;
  while (i < cne(c)) : (i += 1) { kinv[eoff(c) + i] = 0.0; if (WIN > 0 and !cg(c)) { spos[soff(c) + i] = 0.0; } }
  pend[c] = 0;
}
// the new entry of cache c (this row's): k into the keys (f16), v and the two partials pending
fn cache_put(c: u16, pos: u32, k: [*]f32, v: [*]f32, ks: f32, vs: f32) void {
  const e = cslot(c, pos);
  const ne = cne(c);
  const dc = cdc(c);
  var d: u16 = 0;
  while (d < dc) : (d += 1) {
    kc[1 + koff(c) + d * ne + e] = @bitcast(u16, @as(@fp16(), k[d]));
    pv[c * DcG + d] = v[d];
  }
  pks[c] = ks;
  pvs[c] = vs;
  pend[c] = 1;
  if (WIN > 0 and !cg(c)) { spos[soff(c) + e] = q_pf; }
}
fn cache_fin(c: u16, pos: u32, kss: f32, vss: f32, ihd: f32) void {
  const e = cslot(c, pos);
  const dc = cdc(c);
  kinv[eoff(c) + e] = rsq(kss * ihd + 1.0e-6);
  const vi = rsq(vss * ihd + 1.0e-6);
  var d: u16 = 0;
  while (d < dc) : (d += 1) { vc[1 + voff(c) + e * (dc + 1) + d] = @bitcast(u16, @as(@fp16(), pv[c * DcG + d] * vi)); }
  vc[1 + voff(c) + e * (dc + 1) + dc] = 0x3c00;
  pend[c] = 0;
}

// KVS (shared units): the async receive and the pass start's entries
var kvb = @zeros([17]f32);
const kvb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{17} -> kvb[i] });
var kvlog = @zeros([if (DIAG != 0 or PLOG == 1) 2 * 64 else 1]f32);   // (DIAG 1) a step's KVS words' sum and sequence word
var kvlog_ptr: [*]f32 = &kvlog;
fn kv_post() void {
  kvb[16] = -1.0;
  iqc(7, rcfg[RQ + 12]);
  @fmovs(kvb_d, fin(q_ym, 17), .{ .async = true, .ut_id = ut_k });
}
var chk = @zeros([1]f32);
fn kv_take(pos: u32, s: u32) void {
  posq(pos);
  const want = q_pf;
  const cd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> chk[i] });
  const sd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> kvb[@as(i16, 16) + i] });
  @fmovs(cd, sd);
  while (chk[0] != want) { @fmovs(cd, sd); }   // (a DSD read each turn: the async receive writes kvb)
  iqc(7, rcfg[RQ + 5]);
  if (DIAG != 0 or PLOG == 1) {
    var t: f32 = 0.0;
    var i: u16 = 0;
    while (i < 16) : (i += 1) { t += kvb[i]; }
    if (s < 64) { kvlog[2 * @as(u16, s)] = t; kvlog[2 * @as(u16, s) + 1] = kvb[16]; }
    if (DIAG != 0) { return; }
  }
  if (pos == 0) { cache_reset(0); cache_reset(1); }
  if (q_row == myrow) {
    cache_put(0, pos, @ptrcast([*]f32, &kvb[0]), @ptrcast([*]f32, &kvb[DcS]), kvb[2 * DcS], kvb[2 * DcS + 1]);
    const g0 = 2 * DcS + 2;
    cache_put(1, pos, @ptrcast([*]f32, &kvb[g0]), @ptrcast([*]f32, &kvb[g0 + DcG]), kvb[g0 + 2 * DcG], kvb[g0 + 2 * DcG + 1]);
  }
}

// ---------------------------------------------------------------- attention
// CY's multicast: q (weights, RoPE) QD | k Dc | v Dc | position | q's partial |q_h|^2 (Qh) | |k|^2 | |v|^2 | the
// deferred scalar (AB = QD + 2 Dc + Qh + 4); a shared layer's k / v / |k|^2 / |v|^2 are zeros
var ab = @zeros([QOM + 2 * DcG + Qh + 4]f32);
const ab_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QOM + 2 * DcG + Qh + 4} -> ab[i] });
var s_att: f32 = 0.0;
// WSPEC 1: one copy a layer kind (g 0 sliding, 1 global: the head width and the entry count constants); 0: one
// runtime copy (g 2; the smaller program)
fn att_mix(l: u16, pos_out: *u32) void {
  if (WSPEC != 0) { if (isg(l)) { attm(l, pos_out, 1); } else { attm(l, pos_out, 0); } } else { attm(l, pos_out, 2); }
}
fn attm(l: u16, pos_out: *u32, comptime g: u16) void {
  const dc: u16 = if (g == 2) dcl(l) else if (g == 1) DcG else DcS;
  const QD: u16 = Qh * dc;
  const AB: u16 = QD + 2 * dc + Qh + 4;
  const c = cache_of(l);
  const ne: u16 = if (g == 2) cne(c) else if (g == 1) NEG else NES;
  const ihd: f32 = if (isg(l)) IHDG else IHDS;   // (reciprocals: no runtime f32 divide)
  @fmovs(@set_dsd_length(ab_d, AB), fin(q_ym, AB));
  const pos = @as(u32, ab[QD + 2 * dc]);
  pos_out.* = pos;
  s_att = ab[QD + 2 * dc + Qh + 3];
  posq(pos);
  const mine = q_row == myrow;
  if (pos == 0) {
    if (SH == 0) { cache_reset(c); }
    var hh: u16 = 0;
    while (hh < Qh) : (hh += 1) { mref[l * Qh + hh] = 0.0; }
  }
  if (SH == 0 and mine) {
    cache_put(c, pos, @ptrcast([*]f32, &ab[QD]), @ptrcast([*]f32, &ab[QD + dc]), ab[QD + 2 * dc + 1 + Qh], ab[QD + 2 * dc + 2 + Qh]);
  }
  @fs2h(@set_dsd_length(xh_d, QD), @set_dsd_length(ab_d, QD));
  const eseen = @as(u32, q_ent) + 1;
  // WSPEC 2, a sliding layer: the whole ring every step (NEl a constant), the entries not yet written masked below
  const FR: bool = (WSPEC == 2 and g == 0 and WIN == 0);
  const nseen: u16 = if (eseen < @as(u32, ne)) @as(u16, eseen) else ne;
  const NEl: u16 = if (FR) ne else nseen;
  const nsl: u16 = Qh * NEl + Qh + 2;
  const kb = koff(c);
  const vb = voff(c);
  const e0 = eoff(c);
  var apass: u16 = 0;
  while (apass < 8) : (apass += 1) {
    var h: u16 = 0;
    while (h < Qh) : (h += 1) {
      kvmv(@ptrcast([*]u16, &kc[1 + kb]), dc, ne, h * dc, h * ne);
      if (!FR) {
        @fmovs(@set_dsd_length(@increment_dsd_offset(sx_d, @as(i16, h * NEl), f32), NEl),
               @set_dsd_length(@increment_dsd_offset(y_d, @as(i16, h * ne), f32), NEl));
      }
      sx[Qh * NEl + h] = ab[QD + 2 * dc + 1 + h];
    }
    if (FR) { @fmovs(fS, fP); }   // (the whole ring: y's layout is sx's)
    const pm = mine and pend[c] != 0;
    sx[Qh * NEl + Qh] = if (pm) pks[c] else 0.0;
    sx[Qh * NEl + Qh + 1] = if (pm) pvs[c] else 0.0;
    if (role_s != 5) { seg_ar(nsl); }
    if (pm) { cache_fin(c, pos, sx[Qh * NEl + Qh], sx[Qh * NEl + Qh + 1], ihd); }
    const ki = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NEM} -> kinv[i] });
    h = 0;
    while (h < Qh) : (h += 1) {
      const sh = @set_dsd_length(@increment_dsd_offset(sx_d, @as(i16, h * NEl), f32), NEl);
      @fmuls(sh, sh, @set_dsd_length(@increment_dsd_offset(ki, @as(i16, e0), f32), NEl));
      @fmuls(sh, sh, rsq(sx[Qh * NEl + h] * ihd + 1.0e-6));
      @fsubs(sh, sh, mref[l * Qh + h]);
      if (FR and nseen < ne) {   // (FR) entries not yet written score -1e30: exp -> 0, f16 0: they add exact zeros
        @fmovs(@set_dsd_length(@increment_dsd_offset(sx_d, @as(i16, h * NEl + nseen), f32), ne - nseen), -1.0e30);
      }
    }
    if (WIN > 0 and !cg(c)) {   // entries out of the window (or never written) score -1e30 in every head: exp -> 0
      const so = soff(c);
      var e: u16 = 0;
      while (e < NEl) : (e += 1) {
        const sp = spos[so + e];
        if (sp == 0.0 or q_pf - sp >= @as(f32, WIN)) { h = 0; while (h < Qh) : (h += 1) { sx[h * NEl + e] = -1.0e30; } }
      }
    }
    if (FR) { exp_fr(); } else {
      exp_v(@set_dsd_length(sx_d, Qh * NEl), Qh * NEl);
      @fs2h(@set_dsd_length(xh_d, Qh * NEl), @set_dsd_length(y_d, Qh * NEl));
    }
    h = 0;
    while (h < Qh) : (h += 1) { kvmv(@ptrcast([*]u16, &vc[1 + vb]), NEl, dc + 1, h * NEl, h * (dc + 1)); }
    send_y(Qh * (dc + 1));
    @fs2h(@set_dsd_length(xh_d, QD), fin(q_ym, QD));
    @fmovs(@set_dsd_length(sx_d, 1 + Qh), fin(q_ym, 1 + Qh));
    if (sx[0] == 0.0) {
      lpa = l + 1;                 // (ATTL 2) the logs come in a Qh-word multicast after o: read after the o_proj send
      apass = 8;
    } else {
      h = 0;
      while (h < Qh) : (h += 1) { mref[l * Qh + h] += sx[1 + h]; }
      @fs2h(@set_dsd_length(xh_d, QD), @set_dsd_length(ab_d, QD));
    }
  }
}
var lpa: u16 = 0;
fn lse_late() void {
  if (lpa == 0) { return; }
  const l = lpa - 1;
  @fmovs(@set_dsd_length(sx_d, Qh), fin(q_ym, Qh));
  var h: u16 = 0;
  while (h < Qh) : (h += 1) { mref[l * Qh + h] += sx[h]; }
  lpa = 0;
}

// ---------------------------------------------------------------- a pass
var sv2 = @zeros([2]f32);
const sv2_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2} -> sv2[i] });
fn layer(l: u16, b: u16) u16 {
  const dc = dcl(l);
  const NQ = nql(l);
  const QO = Qh * dc;
  // (offsets as u16 products: no u32 multiply, whose helper __muldi3 costs 332 B)
  // attention
  mv2(b, NQ);
  stamp(1 + 9 * l);
  var pos: u32 = 0;
  att_mix(l, &pos);
  stamp(2 + 9 * l);
  const bo = b + Hc * NQ;
  mv(bo, QO, Hc, 0);
  send_row(s_att);
  lse_late();
  stamp(3 + 9 * l);
  // MLP: gate | up (deferred), act (Ic) | the post-attention scalar, down
  const bg = bo + QO * Hc;
  mv2(bg, 2 * Ic);
  stamp(4 + 9 * l);
  @fs2h(@set_dsd_length(xh_d, Ic), fin(q_ym, Ic));
  @fmovs(@set_dsd_length(sv2_d, 1), fin(q_ym, 1));
  stamp(5 + 9 * l);
  const bd = bg + Hc * 2 * Ic;
  mv(bd, Ic, Hc, 0);
  send_row(sv2[0]);
  stamp(6 + 9 * l);
  // PLE: the gate (deferred), z | the post-FFN scalar, the projection
  const bp = bd + Ic * Hc;
  mv2(bp, 1);
  @fmovs(sv2_d, fin(q_ym, 2));
  xh[0] = @as(@fp16(), sv2[0]);
  stamp(7 + 9 * l);
  mv(bp + Hc, 1, Hc, 0);
  send_row(sv2[1]);
  stamp(8 + 9 * l);
  return bp + 2 * Hc;
}
// the last unit's flush: the last layer's post-PLE scalar back to CX
fn flush() void {
  @fmovs(@set_dsd_length(y_d, 4), fin(q_xm, 4));
  send_y(4);
  @fmovs(@set_dsd_length(sv2_d, 1), fin(q_ym, 1));
  y[0] = if ((wfl & 1) != 0) sv2[0] else 0.0;
  send_x(1);
}

fn relay(o: u16) void {
  const n = @as(u16, rcfg[RQ + o]);
  if (n == 0) { return; }
  while ((tile_config.output_queue_status.get_raw() & 0x1000) == 0) {}
  iqc(6, rcfg[RQ + o + 1]);
  oqc(4, rcfg[RQ + o + 2]);
  @fmovs(fout(q_ao, n), fin(q_xm, n));
  // iq6 only: iq7 may hold the KVS receive posted for the next pass (qmode(0) rebinding it here hung the KVS line)
  iqc(6, rcfg[RQ + 4]);
}

var n_steps: u32 = 0;
var pos0: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var i: u32 = 0;
  while (i < n_steps) : (i += 1) {
    const pos = pos0 + i;
    var l: u16 = 0;
    var b: u16 = 0;
    relay(18);
    if (SH == 1 and (wfl & 2) != 0 and (DIAG & 64) == 0) { kv_take(pos, i); }
    stamp(0);
    while ((DIAG & 1) == 0 and l < (if ((DIAG & 2) != 0) 1 else K)) : (l += 1) { b = layer(l, b); }
    if ((DIAG & 1) == 0 and (wfl & 4) != 0) { flush(); }
    if (SH == 1 and (wfl & 2) != 0 and (DIAG & 64) == 0) { kv_post(); }
    relay(21);
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  pos0 = start_pos;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_xa, .{ .color = @get_color(13) });
  @initialize_queue(q_xb, .{ .color = @get_color(14) });
  @initialize_queue(q_ya, .{ .color = @get_color(17) });
  @initialize_queue(q_yb, .{ .color = @get_color(18) });
  @initialize_queue(q_xm, .{ .color = @get_color(19) });
  @initialize_queue(q_ym, .{ .color = @get_color(20) });
  @initialize_queue(q_xo, .{ .color = C_PARK });
  @initialize_queue(q_yo, .{ .color = C_PARK });
  @initialize_queue(q_ao, .{ .color = C_PARK });
  @export_symbol(w_ptr, "w");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(kvlog_ptr, "kvlog");
  @export_symbol(init);
  @export_symbol(compute);
}
//@@ dummies
