// split/ctl_cy_gptoss_att.csl: the role-split column control PE (CY_c) of a gpt-oss attention column.
// Design: spatial/split/README.md (gpt-oss).
//
// Role. One an attention column, on the unit's middle row: the root of the column's reductions and the
// column-local attention element-wise work. A layer:
//   q|k|v reduction (NQA words + ssq) -> rms scale, + biases; RoPE (YaRN: the host's tables carry the
//   attention scaling in level 0) on q's Qh heads and k, q x 1/sqrt(HD) -> multicast [q | k | v | position]
//   values reduction (Qh (Dc + 1): o | l a head) -> l_h += exp(sink_h - mref_h) (the sinks: CY keeps its own
//   copy of the log-sum-exp reference the weight PEs used), o / l, the redo flag (some l outside the f16
//   probabilities' window) -> multicast [o | redo] (+ the steps ln l_h at once on a redo, else in a second
//   multicast read by the weight PEs after their o_proj send) and mref += ln l_h.
// Rotated pairs: the host places dims (d, d + 32) of each head side by side, NROT pairs a column.
//
// Interface. Exports qb (f32 [layer][NQA] biases), snk (f32 [layer][Qh]), rot (f32 RoPE tables [NLV][8]
// [cos | sin][NROT]), tdbg, rcfg, init, compute(steps, start_pos).
// rcfg (split_geo_gptoss.py rcfg_cy): as ctl_cy_q35.csl (the segment words unused).
//
// Params. Shape: K, NQA, Qh, Dc, NROT, HR (hidden), NLV (RoPE table levels: positions < 8^NLV), QSC (1 / sqrt(head dim)).
param memcpy_params;
param DIAG: u16 = 0;
param K: u16;
param NQA: u16;
param Qh: u16;
param Dc: u16;
param NROT: u16;
param HR: u16;
param NLV: u16 = 5;
param QSC: f32 = 0.125;   // 1 / sqrt(head dim)
param TSTAMP: u16 = 0;
param FIFOW: u16 = 32;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const timestamp = @import_module("<time>");
var tdbg = @zeros([1 + 4 * K]u32);   // stamps [0, 1 + 3 l ..), then (always on) each layer's redo passes, summed over the launch
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { if (TSTAMP == 0) { return; } timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }
fn mx(a: u16, b: u16) u16 { return if (a > b) a else b; }

const QD: u16 = Qh * Dc;
const NV: u16 = Qh * (Dc + 1);
const TN: u16 = mx(NQA + 1, NV);
const UN: u16 = mx(QD + 2 * Dc + 1, QD + 1 + Qh);
const EPS: f32 = 1.0e-5;
const HID: f32 = @as(f32, HR);
var t = @zeros([TN]f32);
var u = @zeros([UN]f32);
const t_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> t[i] });
const u_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{UN} -> u[i] });
fn tv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(t_d, @as(i16, o), f32), n); }
fn uv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(u_d, @as(i16, o), f32), n); }
var qb = @zeros([K * NQA]f32);
var qb_ptr: [*]f32 = &qb;
const qb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NQA} -> qb[i] });
var snk = @zeros([K * Qh]f32);
var snk_ptr: [*]f32 = &snk;
var mref = @zeros([K * Qh]f32);
var rot = @zeros([NLV * 8 * 2 * NROT]f32);
var rot_ptr: [*]f32 = &rot;
var rc = @zeros([NROT]f32);
var rs = @zeros([NROT]f32);
const NRB: u16 = (Qh + 1) * NROT;          // rotated pairs a pass (q's heads, then k)
var rcv = @zeros([NRB]f32);
var rsv = @zeros([NRB]f32);
var ra = @zeros([NRB]f32);
var rb2 = @zeros([NRB]f32);
var rc3 = @zeros([NRB]f32);
const rcv_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> rcv[i] });
const rsv_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> rsv[i] });
const ra_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> ra[i] });
const rb2_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> rb2[i] });
const rc3_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> rc3[i] });
var ilh = @zeros([Qh]f32);
var lh = @zeros([Qh]f32);

const q_n = @get_input_queue(2);
const q_s = @get_input_queue(3);
const q_lb = @get_input_queue(4);
const q_si = @get_input_queue(5);
const q_sm = @get_input_queue(6);
const q_s2 = @get_input_queue(7);
const q_lo = @get_output_queue(2);
const q_mc = @get_output_queue(3);
const q_so = @get_output_queue(4);
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
var fifo_buf = @zeros([FIFOW]f32);
const fifo = @allocate_fifo(fifo_buf);
fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}
const NR: u16 = 12;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 12]u32);
var rcfg_ptr: [*]u32 = &rcfg;
fn iqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.input_queue_config.get_input_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.input_queue_config.in_queue_addr_range);
  @set_config(addr, (v & 0xffe0) | @as(u16, c), tile_config.input_queue_config.in_queue_addr_range);
}
fn oqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.output_queue_config.get_output_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.output_queue_config.out_queue_addr_range);
  @set_config(addr, (v & 0xfe0f) | (@as(u16, c) << 4), tile_config.output_queue_config.out_queue_addr_range);
}
var qcur = [6]u16 { 13, 14, 17, 18, 19, 20 };
fn iq_any(q: u16, c: u16) void {
  if (q == 0) { iqc(2, c); }
  else if (q == 1) { iqc(3, c); }
  else if (q == 2) { iqc(4, c); }
  else if (q == 3) { iqc(5, c); }
  else if (q == 4) { iqc(6, c); }
  else if (q == 5) { iqc(7, c); }
}
fn bind_iqs(fq: *[6]u16, tmp: u16) void {
  var done = @zeros([6]u16);
  var left: u16 = 6;
  var guard: u16 = 0;
  while (left > 0 and guard < 32) : (guard += 1) {
    var prog = false;
    var i: u16 = 0;
    while (i < 6) : (i += 1) {
      if (done[i] != 0) { continue; }
      var clash = false;
      var j: u16 = 0;
      while (j < 6) : (j += 1) { if (j != i and done[j] == 0 and qcur[j] == fq.*[i]) { clash = true; } }
      if (!clash) { iq_any(i, fq.*[i]); qcur[i] = fq.*[i]; done[i] = 1; left -= 1; prog = true; }
    }
    if (!prog) {
      i = 0;
      while (i < 6 and done[i] != 0) : (i += 1) {}
      iq_any(i, tmp); qcur[i] = tmp;
    }
  }
}
fn init() void {
  const cc0 = color_config.get_color_config_addr(@get_color(0));
  var k: u16 = 0;
  while (k < @as(u16, rcfg[0])) : (k += 1) {
    const addr = cc0 + @as(u16, rcfg[1 + 2 * k]);
    const r = @get_config(addr, tgt.color_addr_range) & 0xff00;
    @set_config(addr, r | @as(u16, rcfg[2 + 2 * k]), tgt.color_addr_range);
  }
  var fq = [6]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]), @as(u16, rcfg[RQ + 3]), @as(u16, rcfg[RQ + 8]), @as(u16, rcfg[RQ + 9]) };
  bind_iqs(&fq, @as(u16, rcfg[RQ + 10]));
  oqc(2, rcfg[RQ + 4]); oqc(3, rcfg[RQ + 5]); oqc(4, rcfg[RQ + 6]);
  timestamp.enable_tsc();
  sys_mod.unblock_cmd_stream();
}
// the column reduction's n words into t (both halves, merged back over the loop-back)
fn reduce(n: u16) void {
  @fmovs(fifo, fin(q_s, n), .{ .async = true, .ut_id = ut_a });
  @fadds(fout(q_lo, n), fin(q_n, n), fifo, .{ .async = true, .ut_id = ut_b });
  @fmovs(tv(0, n), fin(q_lb, n));
}
fn mcast(n: u16) void { @fmovs(fout(q_mc, n), uv(0, n)); }

fn rsqrt(v: f32) f32 {
  var y = @bitcast(f32, @as(u32, 0x5f3759df) - (@bitcast(u32, v) >> 1));
  y = y * (1.5 - 0.5 * v * y * y);
  y = y * (1.5 - 0.5 * v * y * y);
  y = y * (1.5 - 0.5 * v * y * y);
  return y;
}
fn exp1(x0: f32) f32 {
  var x: f32 = if (x0 < -87.0) -87.0 else if (x0 > 88.0) 88.0 else x0;
  var k: f32 = x * 1.4426950408889634 + 12582912.0;
  k = k - 12582912.0;
  const r = x - k * 0.6931471805599453;
  var p: f32 = 0.0013888889;
  p = p * r + 0.008333334;
  p = p * r + 0.041666668;
  p = p * r + 0.16666667;
  p = p * r + 0.5;
  p = p * r + 1.0;
  p = p * r + 1.0;
  const ki = @as(i16, k) + 127;
  const s = @bitcast(f32, @as(u32, @as(u16, ki)) << 23);
  return p * s;
}
fn recip(v: f32) f32 { const a = if (v < 0.0) -v else v; const r = rsqrt(a); return if (v < 0.0) -(r * r) else r * r; }
fn ln1(x: f32) f32 {
  const b = @bitcast(u32, x);
  const e = @as(f32, @as(i16, @as(u16, (b >> 23) & 0xff)) - 127);
  const m = @bitcast(f32, (b & 0x007fffff) | 0x3f800000);
  const z = (m - 1.0) * recip(m + 1.0);
  const z2 = z * z;
  const p = z * (2.0 + z2 * (0.6666667 + z2 * (0.4 + z2 * 0.2857143)));
  return e * 0.6931471805599453 + p;
}

var rope_at: u32 = 0xffffffff;
fn rope_tables_at(p: u32) void {
  if (rope_at == p) { return; }
  rope_at = p;
  var j: u16 = 0;
  while (j < NROT) : (j += 1) {
    var c: f32 = 1.0;
    var s: f32 = 0.0;
    var lv: u16 = 0;
    while (lv < NLV) : (lv += 1) {
      const d = @as(u16, (p >> @as(u16, 3 * (NLV - 1 - lv))) & 7);
      const o = ((lv * 8 + d) * 2) * NROT + j;
      const c2 = rot[o];
      const s2 = rot[o + NROT];
      const cn = c * c2 - s * s2;
      s = s * c2 + c * s2;
      c = cn;
    }
    rc[j] = c;
    rs[j] = s;
  }
  var b: u16 = 0;
  while (b <= Qh) : (b += 1) {
    @fmovs(@set_dsd_length(@increment_dsd_offset(rcv_d, @as(i16, b * NROT), f32), NROT), @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NROT} -> rc[i] }));
    @fmovs(@set_dsd_length(@increment_dsd_offset(rsv_d, @as(i16, b * NROT), f32), NROT), @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NROT} -> rs[i] }));
  }
}
// every rotated pair (a, b) = (t[2 i], t[2 i + 1]) of q's heads and k (t[0 .. QD + Dc), adjacent blocks):
// a' = a c - b s, b' = b c + a s (the scalar rope()'s operations, word for word)
fn rope_v() void {
  const A = @set_dsd_stride(@set_dsd_length(t_d, NRB), 2);
  const B = @increment_dsd_offset(A, 1, f32);
  @fmuls(ra_d, A, rcv_d);
  @fmuls(rb2_d, B, rsv_d);
  @fsubs(ra_d, ra_d, rb2_d);          // a c - b s
  @fmuls(rb2_d, B, rcv_d);
  @fmuls(rc3_d, A, rsv_d);
  @fadds(rb2_d, rb2_d, rc3_d);        // b c + a s
  @fmovs(A, ra_d);
  @fmovs(B, rb2_d);
}

fn att(l: u16, pos: u32) void {
  reduce(NQA + 1);
  stamp(1 + 3 * l);
  const rr = rsqrt(t[NQA] / HID + EPS);
  @fmuls(tv(0, NQA), tv(0, NQA), rr);
  @fadds(tv(0, NQA), tv(0, NQA), @set_dsd_base_addr(qb_d, @ptrcast([*]f32, &qb[l * NQA])));
  rope_tables_at(pos);
  rope_v();
  var h: u16 = 0;
  @fmuls(uv(0, QD), tv(0, QD), QSC);
  @fmovs(uv(QD, 2 * Dc), tv(QD, 2 * Dc));
  u[QD + 2 * Dc] = @as(f32, pos);
  mcast(QD + 2 * Dc + 1);
  stamp(2 + 3 * l);
  if (l == K - 1) { rope_tables_at(pos + 1); }   // (ROPEP) the next pass's tables, off the path
  if (pos == 0) {
    h = 0;
    while (h < Qh) : (h += 1) { mref[l * Qh + h] = 0.0; }
  }
  var pass: u16 = 0;
  while (pass < 8) : (pass += 1) {
    reduce(NV);
    var bad: f32 = 0.0;
    h = 0;
    while (h < Qh) : (h += 1) {
      const lv = t[h * (Dc + 1) + Dc];
      lh[h] = lv;
      if (lv < 0.00390625 or lv >= 32768.0) { bad = 1.0; }   // the f16 probabilities' window
      const sk = snk[l * Qh + h] - mref[l * Qh + h];
      ilh[h] = recip(lv + exp1(sk));
      @fmuls(uv(h * Dc, Dc), tv(h * (Dc + 1), Dc), ilh[h]);
    }
    u[QD] = bad;
    mcast(QD + 1);
    h = 0;
    while (h < Qh) : (h += 1) {
      const st = ln1(if (lh[h] > 1.0e-30) lh[h] else 1.0e-30);
      u[h] = st;
      mref[l * Qh + h] += st;
    }
    mcast(Qh);
    if (bad == 0.0) { pass = 8; } else { tdbg[1 + 3 * K + l] += 1; }
  }
  stamp(3 + 3 * l);
}

var n_steps: u32 = 0;
var pos0: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var s: u32 = 0;
  while (s < n_steps) : (s += 1) {
    stamp(0);
    var l: u16 = 0;
    while ((DIAG & 1) == 0 and l < (if ((DIAG & 2) != 0) 1 else K)) : (l += 1) { att(l, pos0 + s); }
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void {
  var l: u16 = 0;
  while (l < K) : (l += 1) { tdbg[1 + 3 * K + l] = 0; }
  n_steps = steps;
  pos0 = start_pos;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_n, .{ .color = @get_color(13) });
  @initialize_queue(q_s, .{ .color = @get_color(14) });
  @initialize_queue(q_lb, .{ .color = @get_color(17) });
  @initialize_queue(q_si, .{ .color = @get_color(18) });
  @initialize_queue(q_sm, .{ .color = @get_color(19) });
  @initialize_queue(q_s2, .{ .color = @get_color(20) });
  @initialize_queue(q_lo, .{ .color = C_PARK });
  @initialize_queue(q_mc, .{ .color = C_PARK });
  @initialize_queue(q_so, .{ .color = C_PARK });
  @export_symbol(qb_ptr, "qb");
  @export_symbol(snk_ptr, "snk");
  @export_symbol(rot_ptr, "rot");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(init);
  @export_symbol(compute);
}
//@@ dummies
