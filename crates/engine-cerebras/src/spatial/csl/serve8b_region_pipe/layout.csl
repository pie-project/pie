// serve8b_region: Qwen3-8B's 36 layers on two kinds of layer units, plus the
// head and the embedding strip (as serve8b). Units:
// - grids: PX x PY, one layer (qwen2d_paged8b; grid_pe.csl), Hc dims a row;
// - regions: RPX x RPY, RNL layers (qwen2d_region; region_pe.csl), RHc dims a
//   row; x stays in place between a region's layers.
// Placement (option A of DESIGN.md "K layers a region"; the host's
// serve_lib8b.WaferModel.units() gives the layer order and route tables):
// - a top band of grids at rows 0..PY-1, x 0..XC-1 (XC = RC RPX), and layer 0's
//   grid at (XC, 0), next to the head;
// - RC x RR regions below the band (rows PY .. PY + RR RPY - 1, x 0..XC-1);
// - a column of NCOL grids at x XC below layer 0; the last one is the last
//   layer (its rows below the head's feeder row);
// - the head at x XC + PX (C = PY / 2 chunk columns of 2 Hc dims, + VMC) and
//   the strip east of it (EC = PY / 4 columns of 4 Hc dims), as serve8b.
// Each PE's place, routes and handoff come from the host's route table
// (`rtab`, written before `init`), so one image serves every unit of a kind.
param PX: u16;
param PY: u16;
param Hc: u16;
param Dc: u16;
param Gs: u16;
param Ic: u16;
param RPX: u16;
param RPY: u16;
param RHc: u16;
param RDc: u16;
param RGs: u16;
param RIc: u16;
param RNL: u16;
param RGY: u16;        // the regions' Y phase-1 group (0: RGs; must divide RPY: 16 at 256 x 240)
param RC: u16;         // region columns
param RR: u16;         // region rows
param NCOL: u16;       // grids in the column below layer 0
param RTR: u16;        // routes a unit PE's table holds (the host checks)
param HR: u16;
param Qh: u16;
param PS: u16;
param NB: u16;
param E: u16;
param B: u16;
param MC: u16;
param W16: u16;
param NP: u16;
param KV16: u16;
param KVCP: u16;       // 0 only: page ids map to rows differently in the two unit kinds
param PROF: u16;
param TIME: u16;
param HROUTE: u16;     // 1: the host writes the collectives' route bits (`rcfg`, Fork 8)
param ROT8: u16;       // 1: RoPE tables of 4 x 8
param NOLAYER: u16 = 0;    // 1 (checking the handoffs alone): the units skip their layers
param PIPE: u16 = 0;       // serve8b_region_pipe: 1 runs micro-batches round the ring (compute's start_pos = nmb)
param MMAX: u16 = 1;       // micro-batches a launch at most (units' mtab, the head's token rows)
param VMX: u16 = 0;        // 1: a 5-column VM block east of the strip (VM5.md; then VMC 0)
param VMREAL: u16 = 0;     // VMX: 1 Fork 3's eta VM (vm_pe.csl), 0 the stand-in (vm_stub.csl)
// Fork 3's VM image (VMX 1, VMREAL 1; see their guest4hz README).
param max_ops: u16 = 0;
param nreg: u16 = 0;
param pool_words: u16 = 0;
param feat: u32 = 0;
param opmask_lo: u32 = 0;
param opmask_hi: u32 = 0;
param ring: u16 = 0;
param ring_w: u16 = 0;
param vm_rows: u16 = 0;
param vm_sin: u16 = 0;
param vm_lprog: u16 = 0;
param vm_pwalk: u16 = 0;
param bank_words: u16 = 0;
param vm_prof: u16 = 0;
param vm_lanes: u16 = 0;
param KVST: u16 = 0;       // KV page staging slots a unit PE (Fork 4's interface; 0: none)
param VML2W: u16 = 0;     // Fork 3's vm_l2w: 1 puts the last hub's level-2 list in wide (B4: frees ~600 B)
param VMSUMPIPE: u16 = 1;  // Fork 3's vm_sumpipe (1 pipelined canonical sum; 2 concatenating, B1 only: +1.3 KB on the last VM column)
param VMDBG: u16 = 0;      // Fork 3's vm_dbg (diagnostics; 0 normal)
param HEADMODE: u16;   // 0: the host feeds layer 0 and reads the last; 2: head and strip
param HH: u16;
param Vr: u16;
param Gx: u16;
param Gy: u16;
param vocab: u32;
param PASSES: u16;
param MODE: u16;
param OVL: u16;
param VMC: u16;
param CAP: u16;
param HLBN: u16 = 0;       // lanes whose logits rows the head keeps (0: min(B, 4)); 1 frees ~2 KB a head PE at B 4, Vr 160
param iters: u16;

const C_R1_0: color = @get_color(8);
const C_R1_1: color = @get_color(7);
const C_R2_0: color = @get_color(6);
const C_R2_1: color = @get_color(5);
const C_BC: color = @get_color(9);
const C_GB: color = @get_color(10);
// Lanes whose logits rows the head keeps (hlogits): HLBN, or min(B, 4) when 0.
const HLB: u16 = if (HLBN > 0) HLBN else if (B < 4) B else 4;

const WS = if (W16 == 1) u16 else f32;
const KS = if (KV16 == 1) u16 else f32;
const XC: u16 = RC * RPX;                    // the grid column (layer 0, the last)
const C: u16 = PY / 2;
const HW: u16 = if (HEADMODE == 2) C + VMC else 0;
const EW: u16 = if (HEADMODE == 2) PY / 4 else 0;
const VW: u16 = if (HEADMODE == 2 and VMX == 1) 5 else 0;   // the VM block
const XH: u16 = XC + PX;
const XE: u16 = XH + HW;
const XV: u16 = if (VW > 0) XE + EW else 0;
const RB: u16 = PY + RR * RPY;               // below the regions
const CB: u16 = PY * (1 + NCOL);             // below the grid column
const LH: u16 = if (RB > CB) RB else CB;
const F: u16 = if (HEADMODE == 2) HH / 2 else 0;
const HR2X: u16 = if (HEADMODE == 2) (C / Gx / 2) * Gx + Gx / 2 else 0;
const HVMC: u16 = if (HEADMODE == 2) VMC else 0;
const RH: u16 = if (HEADMODE == 2 and HH + 1 > LH) HH + 1 else LH;
const XL: u16 = XC;                          // the last layer's grid
const YL: u16 = PY * NCOL;
const RCX: u16 = XH + HR2X;                   // the final root's column
const memcpy = @import_module("<memcpy/get_params>", .{ .width = XE + EW + VW, .height = RH });

layout {
  @comptime_assert(KVCP == 0);
  @comptime_assert(XC % PX == 0);
  @comptime_assert(PY % 4 == 0 and PY >= PX and PY <= 2 * PX and RPY <= 2 * RPX);
  @comptime_assert(B % MC == 0);
  // The staircases' non-crossing (paths.csl): the feeder row below layer 0's
  // rows (E) and above the last layer (S).
  @comptime_assert(HEADMODE == 0 or (F >= PY and F < YL));
  @comptime_assert(HEADMODE == 0 or (MODE == 0 or MODE == 2));
  // The winner multicast leaves the head by its last column: the final root
  // (column HR2X) must not be that column (its route has no east branch).
  @comptime_assert(HEADMODE == 0 or HR2X + 1 < C + VMC);
  @comptime_assert(VMX == 0 or VMC == 0);
  // Whole 32-row vocab blocks a VM PE (the VM's canonical 32-lane sums).
  @comptime_assert(VMX == 0 or Vr == 5 * 32);
  @set_rectangle(XE + EW + VW, RH);
  for (@range(u16, XE + EW + VW)) |x| {
    const mp = memcpy.get_params(x);
    for (@range(u16, RH)) |y| {
      const band = x < XC and y < PY;
      const region = x < XC and y >= PY and y < RB;
      const column = x >= XC and x < XH and y < CB;
      if (x >= XH and x < XE and y <= HH and HEADMODE == 2) {
        @set_tile_code(x, y, "head_pe.csl", .{
          .S2D_FINAL = if (x == RCX and y == F) 1 else 0, .S2D_PIPE = PIPE, .S2D_MMAX = MMAX, .memcpy_params = mp, .KVST = KVST,
          .W = HW, .H = HH, .F = F, .C = C, .Hc = 2 * Hc, .Vr = Vr, .Gx = Gx, .Gy = Gy, .Gb = 1,
          .vocab = vocab, .PASSES = PASSES, .UNTIED = 0, .CERT = 0, .MODE = MODE, .OVL = OVL,
          .VMC = VMC, .WF32 = 0, .SCHAIN = 0,
          .GPX = PX, .GPY = PY, .GHc = Hc, .XH0 = XH, .XL = XL, .YL = YL, .CAP = CAP, .SB = B,
          .HLB = HLB, .KVCP = KVCP, .HROUTE = HROUTE, .S2D_VMX = VMX, .WS = WS, .KS = KS,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_x = C_BC, .c_ib = C_GB,
        });
      } else if (VW > 0 and x >= XV and y <= HH and VMREAL == 1) {
        @set_tile_code(x, y, "vm_pe.csl", .{
          .memcpy_params = mp, .KVST = KVST, .W = C + 5, .H = HH, .F = F, .C = C, .Vr = Vr, .NVC = 5, .VJ = x - XV,
          .Gx = Gx, .Gb = 1, .vocab = vocab,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1, .c_x = C_BC, .c_ib = C_GB,
          .max_ops = max_ops, .nreg = nreg, .pool_words = pool_words, .feat = feat, .ring = ring,
          .ring_w = ring_w, .vm_prof = vm_prof, .vm_lanes = vm_lanes, .vm_rows = vm_rows,
          .vm_lprog = vm_lprog, .bank_words = bank_words, .vm_pwalk = vm_pwalk, .opmask_lo = opmask_lo,
          .opmask_hi = opmask_hi, .vm_sin = vm_sin, .vm_outside = 1, .vm_x0 = XV, .vm_dbg = VMDBG, .vm_sumpipe = VMSUMPIPE, .vm_l2w = VML2W,
          .vm_c_a = 18, .vm_c_b = 19, .vm_c_e = 0, .vm_c_g = 20, .vm_c_k = 17, .vm_c_vl = 2, .vm_c_vt = 3,
          .vm_c_park0 = 13, .vm_c_park1 = 10,
          .S2D_SB = B, .KVCP = KVCP, .HROUTE = HROUTE, .WS = WS, .KS = KS,
        });
      } else if (VW > 0 and x >= XV and y <= HH) {
        @set_tile_code(x, y, "vm_stub.csl", .{
          .memcpy_params = mp, .KVST = KVST, .PX = PX, .PY = PY, .XH0 = XH, .XL = XL, .YL = YL, .F = F, .VMC = VMC,
          .VMAT = HR2X + 1, .Vr = Vr, .B = B, .XV = XV, .RCX = RCX, .KVCP = KVCP, .HROUTE = HROUTE,
          .WS = WS, .KS = KS,
        });
      } else if (x >= XE and x < XE + EW and y <= HH and HEADMODE == 2) {
        @set_tile_code(x, y, "embed_pe.csl", .{
          .S2D_PIPE = PIPE, .memcpy_params = mp, .KVST = KVST, .PX = PX, .PY = PY, .Hc = Hc, .XH0 = XH, .XL = XL, .YL = YL,
          .F = F, .VMC = VMC, .VMAT = HR2X + 1, .Ve = Vr, .vocab = vocab, .B = B, .KVCP = KVCP, .HROUTE = HROUTE,
          .XV = XV, .RCX = RCX,
          .WS = WS, .KS = KS,
        });
      } else if (band or column) {
        @set_tile_code(x, y, "grid_pe.csl", .{
          .S2D_PIPE = PIPE, .S2D_MMAX = MMAX, .memcpy_params = mp, .KVST = KVST,
          .PX = PX, .PY = PY, .Hc = Hc, .HR = HR, .Dc = Dc, .Gs = Gs, .Qh = Qh, .Ic = Ic,
          .PS = PS, .NB = NB, .E = E, .B = B, .MC = MC, .W16 = W16, .NP = NP, .KV16 = KV16,
          .KVCP = KVCP, .PROF = PROF, .HROUTE = HROUTE, .ROT8 = ROT8, .S2D_TIME = TIME, .S2D_RTR = RTR, .S2D_NOLAYER = NOLAYER,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_bc = C_BC, .c_gb = C_GB,
        });
      } else if (region) {
        @set_tile_code(x, y, "region_pe.csl", .{
          .S2D_PIPE = PIPE, .S2D_MMAX = MMAX, .memcpy_params = mp, .KVST = KVST,
          .PX = RPX, .PY = RPY, .Hc = RHc, .HR = HR, .Dc = RDc, .Gs = RGs, .Qh = Qh, .Ic = RIc,
          .PS = PS, .NB = NB, .E = E, .B = B, .MC = MC, .W16 = W16, .NP = NP, .KV16 = KV16,
          .KVCP = KVCP, .PROF = PROF, .NL = RNL, .GY = RGY, .HROUTE = HROUTE, .ROT8 = ROT8, .S2D_TIME = TIME, .S2D_RTR = RTR, .S2D_NOLAYER = NOLAYER,
          .c_r1_0 = C_R1_0, .c_r1_1 = C_R1_1, .c_r2_0 = C_R2_0, .c_r2_1 = C_R2_1,
          .c_bc = C_BC, .c_gb = C_GB,
        });
      } else {
        @set_tile_code(x, y, "filler.csl", .{
          .memcpy_params = mp, .KVST = KVST, .PX = PX, .PY = PY, .XH0 = XH, .XL = XL, .YL = YL, .F = F,
          .VMC = HVMC, .VMAT = HR2X + 1, .HEADMODE = HEADMODE, .KVCP = KVCP, .HROUTE = HROUTE, .XV = XV, .RCX = RCX,
          .WS = WS, .KS = KS,
        });
      }
    }
  }
  @export_name("x", [*]f32, true);
  @export_name("tab", [*]u32, true);
  @export_name("gamma1", [*]f32, true);
  @export_name("gamma2", [*]f32, true);
  @export_name("wqa", [*]WS, true);
  @export_name("wqv", [*]WS, true);
  @export_name("wv", [*]WS, true);
  @export_name("qkn_w", [*]f32, true);
  @export_name("rot_c", [*]f32, true);
  @export_name("rot_s", [*]f32, true);
  @export_name("kc", [*]KS, true);
  @export_name("vc", [*]KS, true);
  @export_name("wo", [*]WS, true);
  @export_name("wgu", [*]WS, true);
  @export_name("wd", [*]WS, true);
  @export_name("prof", [*]u32, true);
  @export_name("dims", [*]u16, true);
  @export_name("rtab", [*]u16, true);
  @export_name("mtab", [*]u32, true);   // serve8b_region_pipe: the units' micro-batch tables
  // (every data name before the first function name: memcpy keeps its symbol
  // table as data only then; a data name after init/compute costs ~0.8 KB of
  // code a PE)
  if (KVST > 0) {
    @export_name("kstage", [*]KS, true);
    @export_name("vstage", [*]KS, true);
  }
  if (HROUTE == 1) {
    @export_name("rcfg", [*]u32, true);
    @export_name("rbits", [*]u32, true);
  }
  @export_name("wt", [*]u32, true);
  @export_name("et", [*]u32, true);
  @export_name("l2", [*]f32, true);
  @export_name("force", [*]u32, true);
  @export_name("lmax", [*]f32, true);
  @export_name("gmode", [*]u32, true);
  @export_name("vm_tok", [*]f32, true);
  @export_name("vin", [*]f32, true);
  @export_name("xin", [*]f32, true);
  @export_name("gam", [*]f32, true);
  @export_name("y", [*]f32, true);
  @export_name("emb", [*]f32, true);
  @export_name("tok", [*]f32, true);
  @export_name("in_tokens", [*]u32, true);
  @export_name("out_tokens", [*]u32, true);
  @export_name("yscale", [*]f32, true);
  @export_name("hlogits", [*]f32, true);
  @export_name("vmctl", [*]u32, true);
  @export_name("perr", [*]u32, true);   // serve8b_region_pipe: the head's micro-batch check
  @export_name("etab", [*]u32, true);
  @export_name("gwide", [*]f32, true);
  @export_name("gpool", [*]u32, true);
  @export_name("gops", [*]u32, true);
  @export_name("gout", [*]u32, true);
  @export_name("gprof", [*]u32, true);
  @export_name("gostep", [*]u32, true);
  @export_name("gring", [*]u32, true);
  @export_name("vm_ctl", [*]u32, true);
  @export_name("gbank", [*]u32, true);
  @export_name("gcycles", [*]u32, true);
  @export_name("gvalid", [*]u32, true);
  @export_name("gtok_home", [*]u32, true);
  @export_name("gsin", [*]u32, true);
  @export_name("glane", [*]u32, true);
  @export_name("gbdesc", [*]u32, true);
  @export_name("gsdesc", [*]u32, true);
  @export_name("gdbg", [*]u32, true);
  @export_name("init", fn()void);
  @export_name("compute", fn(u32, u32)void);
  if (KVST > 0) {
    @export_name("page_stage", fn(u32, u32)void);
    @export_name("page_unstage", fn(u32, u32)void);
  }
}
