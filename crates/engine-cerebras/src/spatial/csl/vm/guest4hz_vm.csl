// The eta guest VM on head2d_v9's VM columns (generated by gen_vm.py from
// guest4/pe.csl; CONTRACT.md 6). Block b's VM column (fabric column
// b·CB + R2X + 1) holds lane positions b·H + ry (region row ry), Vr
// vocabulary rows each, behind the root column; its feeder-row PE (row F)
// holds none and is the column's fold hub. Folds are blocking: each half
// column chains into the hub (colors A/B, the lower half flipped), the hubs
// chain east along the feeder row through the head's PEs (colors E/G), and
// the last hub sends the result back (color K: west along the feeder row,
// up and down every VM column). Each head step (`compute`'s loop, gmode 1):
// receive the root's y[Vr] and 1/rms (color 2), run the table's main
// section, block BM's hub sends the token to the final root (color 3), then
// the next step's `pre` section runs while the layers work.
param memcpy_params;
param W: u16;
param H: u16;
param F: u16;
param C: u16;
param Vr: u16;      // the head's vocab rows a root PE
param NVC: u16;     // VM columns a block: each takes Vr / NVC of a row's vocab rows
param VJ: u16;      // this VM column (0 .. NVC - 1)
param CBW: u16 = 0;   // two VM sets: block width (C + both sets' columns)
param VSET: u16 = 0;  // two VM sets: this PE's set (0: A, 1: B)
param VSET2: u16 = 0; // 1: two VM sets in the block (A: VJ over NVC columns, then B's)
param VLAST: u16 = 0; // two VM sets: 1 at the block's last VM column (the logits row stops)
param Gx: u16;
param Gb: u16;
param vocab: u32;
param c_r1_0: color;
param c_r1_1: color;
param c_r2_0: color;
param c_r2_1: color;
param c_x: color;
param c_ib: color;
param max_ops: u16;
param nreg: u16;
param pool_words: u16;
param feat: u32;
param ring: u16;
param ring_w: u16;
param vm_prof: u16;
param vm_lanes: u16;
param vm_rows: u16;    // logits rows a turn (a multi-row program: W0..W(rows-1))   // lanes time-multiplexed on this VM (per-lane state banks)
param vm_lprog: u16;   // 1: per-lane programs (an op arena, glane: a lane's table base, token home, bank window)
param bank_words: u16;  // vm_lprog: the bank arena's words
param vm_pwalk: u16;   // 1: top-p by an entry walk of folds (no list engine)
param opmask_lo: u32;  // opcodes 0..31 the image runs (bit o)
param opmask_hi: u32;  // opcodes 32..63
param vm_sin: u16;     // per-step host input words a turn (0: no step-input path)
const Vt: u16 = Vr / NVC;
const TWO: bool = VSET2 != 0;
const CB: u16 = if (TWO) CBW else C + NVC;
const NB: u16 = W / CB;
const R1X: u16 = Gx / 2;
const NGX: u16 = C / Gx;
const R2X: u16 = (NGX / 2) * Gx + R1X;
const R1B: u16 = Gb / 2;
const NGB: u16 = NB / Gb;
const BM: u16 = (NGB / 2) * Gb + R1B;
const nblk: u16 = NB * H * NVC * (Vt / 32);
const F_RNG: u32 = 1;
const F_RED: u32 = 2;
const F_GS: u32 = 4;
const F_LIST: u32 = 8;
const F_RANK: u32 = 16;
const F_QARITH: u32 = 32;
const F_QMEM: u32 = 64;
const F_QRED: u32 = 128;
const F_WMATH: u32 = 256;
const F_PMASS: u32 = 512;
const NREG: u16 = nreg;
const POOL: u16 = pool_words;
const LB: u16 = 16;   // list fold length (the row-lane engine's)
// A list round's length (pairs): LB on row lanes; on the head's streaming
// merge up to LBX (gen_vm sets LBX), k for top-k.
const LBX: u16 = 128;   // the head's streaming merge: lists up to 128 pairs (red: 2 x 128)
var lb: u16 = LB;
// The fold buffer: the canonical sum's blocks, a gather's words, a list.
// The canonical sum concatenates the lane's block sums CH at a time.
const CH: u16 = vm_ch;   // a multiple of 32 (the level-2 groups); 512+ does not fit the 0095 images
const RB: u16 = if (CH > 256) CH else 256;   // (a test CH below 256 keeps the 256-word buffer)
const L2N: u16 = nblk / 32 + 1;

// ---- opcodes (etagen's src/isa.rs) ----
const HALT: i32 = 0;
const WBIN: i32 = 1;
const WCMP: i32 = 2;
const WUN: i32 = 3;
const WSEL: i32 = 4;
const WFILL: i32 = 5;
const WIOTA: i32 = 6;
const WRNG: i32 = 7;
const WMOV: i32 = 8;
const RRED: i32 = 10;
const WGATHER: i32 = 11;
const WSCATTER: i32 = 12;
const TOPK: i32 = 13;
const PIVRANK: i32 = 14;
const PIVMASS: i32 = 15;
const QBIN: i32 = 20;
const QCMP: i32 = 21;
const QUN: i32 = 22;
const QSEL: i32 = 23;
const QIOTA: i32 = 24;
const QCONST: i32 = 25;
const QMOV: i32 = 26;
const QGATHER: i32 = 27;
const QSCATTER: i32 = 28;
const QCUM: i32 = 29;
const QRED: i32 = 30;
const QRNG: i32 = 31;
const OUT: i32 = 40;
const OPK_WBIN: bool = ((if (WBIN < 32) opmask_lo >> WBIN else opmask_hi >> (WBIN - 32)) & 1) != 0;
const OPK_WCMP: bool = ((if (WCMP < 32) opmask_lo >> WCMP else opmask_hi >> (WCMP - 32)) & 1) != 0;
const OPK_WUN: bool = ((if (WUN < 32) opmask_lo >> WUN else opmask_hi >> (WUN - 32)) & 1) != 0;
const OPK_WSEL: bool = ((if (WSEL < 32) opmask_lo >> WSEL else opmask_hi >> (WSEL - 32)) & 1) != 0;
const OPK_WFILL: bool = ((if (WFILL < 32) opmask_lo >> WFILL else opmask_hi >> (WFILL - 32)) & 1) != 0;
const OPK_WIOTA: bool = ((if (WIOTA < 32) opmask_lo >> WIOTA else opmask_hi >> (WIOTA - 32)) & 1) != 0;
const OPK_WRNG: bool = ((if (WRNG < 32) opmask_lo >> WRNG else opmask_hi >> (WRNG - 32)) & 1) != 0;
const OPK_WMOV: bool = ((if (WMOV < 32) opmask_lo >> WMOV else opmask_hi >> (WMOV - 32)) & 1) != 0;
const OPK_RRED: bool = ((if (RRED < 32) opmask_lo >> RRED else opmask_hi >> (RRED - 32)) & 1) != 0;
const OPK_WGATHER: bool = ((if (WGATHER < 32) opmask_lo >> WGATHER else opmask_hi >> (WGATHER - 32)) & 1) != 0;
const OPK_WSCATTER: bool = ((if (WSCATTER < 32) opmask_lo >> WSCATTER else opmask_hi >> (WSCATTER - 32)) & 1) != 0;
const OPK_TOPK: bool = ((if (TOPK < 32) opmask_lo >> TOPK else opmask_hi >> (TOPK - 32)) & 1) != 0;
const OPK_PIVRANK: bool = ((if (PIVRANK < 32) opmask_lo >> PIVRANK else opmask_hi >> (PIVRANK - 32)) & 1) != 0;
const OPK_PIVMASS: bool = ((if (PIVMASS < 32) opmask_lo >> PIVMASS else opmask_hi >> (PIVMASS - 32)) & 1) != 0;
const OPK_QBIN: bool = ((if (QBIN < 32) opmask_lo >> QBIN else opmask_hi >> (QBIN - 32)) & 1) != 0;
const OPK_QCMP: bool = ((if (QCMP < 32) opmask_lo >> QCMP else opmask_hi >> (QCMP - 32)) & 1) != 0;
const OPK_QUN: bool = ((if (QUN < 32) opmask_lo >> QUN else opmask_hi >> (QUN - 32)) & 1) != 0;
const OPK_QSEL: bool = ((if (QSEL < 32) opmask_lo >> QSEL else opmask_hi >> (QSEL - 32)) & 1) != 0;
const OPK_QIOTA: bool = ((if (QIOTA < 32) opmask_lo >> QIOTA else opmask_hi >> (QIOTA - 32)) & 1) != 0;
const OPK_QCONST: bool = ((if (QCONST < 32) opmask_lo >> QCONST else opmask_hi >> (QCONST - 32)) & 1) != 0;
const OPK_QMOV: bool = ((if (QMOV < 32) opmask_lo >> QMOV else opmask_hi >> (QMOV - 32)) & 1) != 0;
const OPK_QGATHER: bool = ((if (QGATHER < 32) opmask_lo >> QGATHER else opmask_hi >> (QGATHER - 32)) & 1) != 0;
const OPK_QSCATTER: bool = ((if (QSCATTER < 32) opmask_lo >> QSCATTER else opmask_hi >> (QSCATTER - 32)) & 1) != 0;
const OPK_QCUM: bool = ((if (QCUM < 32) opmask_lo >> QCUM else opmask_hi >> (QCUM - 32)) & 1) != 0;
const OPK_QRED: bool = ((if (QRED < 32) opmask_lo >> QRED else opmask_hi >> (QRED - 32)) & 1) != 0;
const OPK_QRNG: bool = ((if (QRNG < 32) opmask_lo >> QRNG else opmask_hi >> (QRNG - 32)) & 1) != 0;
const OPK_OUT: bool = ((if (OUT < 32) opmask_lo >> OUT else opmask_hi >> (OUT - 32)) & 1) != 0;
const PWALK: bool = vm_pwalk != 0;
const OPK_LISTS: bool = (OPK_TOPK and !PWALK) or OPK_PIVRANK or (OPK_PIVMASS and !PWALK);

const NEG_INF: f32 = @bitcast(f32, @as(u32, 0xff800000));
const POS_INF: f32 = @bitcast(f32, @as(u32, 0x7f800000));
const QNAN: f32 = @bitcast(f32, @as(u32, 0x7fc00000));
const T_F32: u32 = 0;
const T_I32: u32 = 1;
const T_U32: u32 = 2;
const T_BOOL: u32 = 3;

// Queues: 2 the head contract's (logits in / token out), 3 out (the chain or
// the result), 4 in (from the far end of a half column), 5 in (the lower
// half, at the hub), 6 in (the west hub), 7 in (the result).
const q2_in = @get_input_queue(2);
const q2_out = @get_output_queue(2);
const q3_out = @get_output_queue(3);
const q4_in = @get_input_queue(4);
const q5_in = @get_input_queue(5);
const q6_in = @get_input_queue(6);
const q7_in = @get_input_queue(7);
// The VM's colors (layout params; defaults: head2d / serve2d's).
param vm_sumpipe: u16 = 3;  // 3 (default; 0168: sum 54.5k -> 32.4k): by row chunks (one block, Vt 32; else as 1); 1: chunks folded back to back; 0: chunk by chunk; 2: concatenation
param vm_topk: u16 = 1;    // vm_pwalk TOPK: 1 radix select (windows of vm_rxw entries; default, 0164: 15x); 0 rounds of KB
param vm_rxw: u16 = 0;     // radix windows (0: RB / 2; smaller only for simulator tests)
param vm_lazyrng: u16 = 0; // 1: WRNG registers drawn where read (exact)
param vm_l2w: u16 = 1;     // 1 (default): the last hub's level-2 list in wide where it fits (a hub holds no row; the list lives within one sum op): -L2N words
param vm_ch: u16 = 256;     // blocks a chunk (a multiple of 32; smaller only for simulator tests)
param vm_dbg: u16 = 0;      // diagnostics: 1 rows and tokens only (no sections); 2 + a max fold a row; 3 + the
                            // compute-start pre sections only (no main); 0 normal. gdbg: [rows read, tokens sent, folds, phase]
param vm_outside: u16 = 0;  // 1: the VM block outside the head (no head colors routed; one block)
param vm_x0: u16 = 0;       // vm_outside: the block's first fabric column (layout x)
const OUTSIDE: bool = vm_outside != 0;
comptime { @comptime_assert(!(OUTSIDE and VSET2 != 0)); }   // two VM sets: inside the head only
param vm_c_a: u16 = 0;      // column chain, rows of one parity
param vm_c_b: u16 = 1;      // column chain, the other parity
param vm_c_e: u16 = 18;     // hub row chain, even hubs
param vm_c_g: u16 = 19;     // hub row chain, odd hubs
param vm_c_k: u16 = 4;      // the fold result, back from the last hub
param vm_c_vl: u16 = 2;     // the logits row in
param vm_c_vt: u16 = 3;     // the token out
param vm_c_park0: u16 = 17; // parked input queues: colors never routed at VM PEs
param vm_c_park1: u16 = 16;
param vm_conc: u16 = 0;    // two sets at once: B's rows on vm_c_vl2, B's tokens by route to the root
param vm_c_vl2: u16 = 13;   // vm_conc: set B's rows
param vm_split: u16 = 0;   // two interleaved chains a half column (half the fold hops)
param vm_c_a2: u16 = 20;   // vm_split: chain 1's colours
param vm_c_b2: u16 = 11;
param vm_c_bt: u16 = 12;    // two VM sets: set B's token west to set A's sender
const C_A: u16 = vm_c_a;
const C_B: u16 = vm_c_b;
const C_E: u16 = vm_c_e;
const C_G: u16 = vm_c_g;
const C_K: u16 = vm_c_k;
const C_VL: u16 = vm_c_vl;
const C_VT: u16 = vm_c_vt;
const C_PARK0: u16 = vm_c_park0;
const C_PARK1: u16 = vm_c_park1;
const C_BT: u16 = vm_c_bt;
const SPLIT: bool = vm_split != 0;
const C_A2: u16 = vm_c_a2;
const C_B2: u16 = vm_c_b2;
const q3_in = @get_input_queue(3);
// chain c's colour at hop parity p (north; the south's p is offset by one)
fn sp_col(c: u16, p: u16) u16 { return if (c == 0) (if (p == 0) C_A else C_B) else (if (p == 0) C_A2 else C_B2); }
// a split-chain PE dd rows from the hub's neighbour (last: the half's farthest);
// tw toward the hub, aw away; off: the south's colour offset
fn sp_routes(comptime tw: direction, comptime aw: direction, dd: u16, last: u16, off: u16) void {
  const ch = dd % 2;
  const hp = dd / 2;
  const sc = sp_col(ch, (hp + off) % 2);
  color_config.reset_routes(col_of(sc), .{ .rx = RAMP, .tx = tw });
  oq_color(3, sc);
  col_end = dd + 2 > last;
  if (!col_end) {
    const rc = sp_col(ch, (hp + 1 + off) % 2);
    color_config.reset_routes(col_of(rc), .{ .rx = aw, .tx = RAMP });
    iq_color(4, rc);
  }
  if (dd + 1 <= last) {
    // the other chain's hop from dd + 1 crosses this row
    const pc = sp_col(1 - ch, ((dd + 1) / 2 + off) % 2);
    color_config.reset_routes(col_of(pc), .{ .rx = aw, .tx = tw });
  }
  if (dd == last) {
    color_config.reset_routes(col_of(C_K), .{ .rx = tw, .tx = RAMP });
  } else {
    color_config.reset_routes(col_of(C_K), .{ .rx = tw, .tx = [2]direction{ RAMP, aw } });
  }
}
const CONC: bool = vm_conc != 0 and VSET2 != 0;
const C_VLS: u16 = if (CONC and VSET == 1) vm_c_vl2 else vm_c_vl;   // this set's rows
const C_VL2: u16 = vm_c_vl2;  // two VM sets: set B's token, west to set A's sender
// memcpy (SDK 2.10) owns colors 21-23 (21 RXCOMMAND, 22 H2D, 23 D2H) and binds
// input queue 1 to 22: a VM color there clashes at load ("two master input
// queues for the same color").
comptime {
  @comptime_assert(vm_c_a < 21 and vm_c_b < 21 and vm_c_e < 21 and vm_c_g < 21 and vm_c_k < 21);
  @comptime_assert(vm_c_vl < 21 and vm_c_vt < 21 and vm_c_park0 < 21 and vm_c_park1 < 21 and vm_c_bt < 21 and vm_c_vl2 < 21 and vm_c_a2 < 21 and vm_c_b2 < 21);
}
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const timestamp = @import_module("<time>");
const math = @import_module("<math>");

var wide = @zeros([NREG * Vt]f32);
var wide_ptr: [*]f32 = &wide;
const wide0 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Vt} -> wide[i] });
var pool = @zeros([POOL]u32);
var pool_ptr: [*]u32 = &pool;
var ops = @zeros([max_ops * 4]u32);   // [op | fl << 8, d | a << 16, b, c] an instruction (the host packs)
var ops_ptr: [*]u32 = &ops;
// A ring of `ring` steps' outputs (16 words a step): one launch of K <= ring
// token-loop steps leaves every step's host-taken words; `ostep` counts the
// main sections run (the host resets it).
const RING: u16 = ring;
const RW: u16 = ring_w;
var out = @zeros([RING * RW]u32);
var out_ptr: [*]u32 = &out;
var ostep = @zeros([1]u32);
var ostep_ptr: [*]u32 = &ostep;
// The lane's real vocabulary (the rest of the last PEs is padding).
var valid = @zeros([1]u32);
var valid_ptr: [*]u32 = &valid;
// [pre cycles lo, hi, main cycles lo, hi]
var cycles = @zeros([4]u32);
var cycles_ptr: [*]u32 = &cycles;

var tmp = @zeros([Vt]f32);
const tmp0 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Vt} -> tmp[i] });
var red = @zeros([RB]f32);
var myblk = @zeros([Vt / 32]f32);
const L2W: bool = vm_l2w != 0 and NREG * Vt >= L2N;   // (only where the hub's wide holds it)
var l2_own = @zeros([if (L2W) 1 else L2N]f32);
var l2: [*]f32 = if (L2W) &wide else &l2_own;
var chunk: u16 = 0;
var order = @zeros([Vt]u16);

var t_start = @zeros([timestamp.tsc_size_words]u16);
var t_end = @zeros([timestamp.tsc_size_words]u16);

var pc: u16 = 0;
var section: u16 = 0;     // 0 the logits-free prefix (pre), 1 main
var ready: bool = false;

var vx: u16 = 0;
var vy: u16 = 0;
var vblk: u16 = 0;
var hidx: u16 = 0;   // this column's hub index on the feeder row (block x NVC + VJ)
var hub: bool = false;     // the column's feeder-row PE
var vry: u16 = 0;          // region row
fn px() u16 { return vx; }
// The PE's place in the lane: its column (a row lane), or column x height +
// row (a column-major lane, as head2d's block-root columns: lane_h rows).
fn lane_pos() u32 { return (@as(u32, vblk) * @as(u32, H) + @as(u32, vry)) * @as(u32, NVC) + @as(u32, VJ); }
fn lane_base() u32 { return lane_pos() * @as(u32, Vt); }
// This PE's real entries.
fn nloc() u16 {
  if (hub) { return 0; }
  const lo = lane_base();
  if (valid[0] <= lo) { return 0; }
  const n = valid[0] - lo;
  return if (n > @as(u32, Vt)) Vt else @as(u16, n);
}
fn tsc(t: *[timestamp.tsc_size_words]u16) u64 {
  return @as(u64, t.*[0]) | (@as(u64, t.*[1]) << 16) | (@as(u64, t.*[2]) << 32);
}
fn reg(r: u32) mem1d_dsd {
  return @increment_dsd_offset(wide0, @as(i16, r) * @as(i16, Vt), f32);
}
fn wv(r: u32, i: u16) f32 { return wide[@as(u16, r) * Vt + i]; }
fn pf(o: u32) f32 { return @bitcast(f32, pool[@as(u16, o)]); }
fn setf(o: u32, v: f32) void { pool[@as(u16, o)] = @bitcast(u32, v); }

// ---- scalar math: within 1 ulp of glibc ----

// musl's logf.
noinline fn logf(v: f32) f32 {
  if (!(v > 0.0)) { return if (v == 0.0) NEG_INF else QNAN; }
  var ix: u32 = @bitcast(u32, v);
  var k: i32 = 0;
  if (ix < 0x00800000) { k = -25; ix = @bitcast(u32, v * 33554432.0); }
  ix = ix + (0x3f800000 - 0x3f3504f3);
  k = k + @as(i32, ix >> 23) - 0x7f;
  ix = (ix & 0x007fffff) + 0x3f3504f3;
  const f = @bitcast(f32, ix) - 1.0;
  const s = f / (2.0 + f);
  const z = s * s;
  const w = z * z;
  const t1 = w * (0.40000972152 + w * 0.24279078841);
  const t2 = z * (0.66666662693 + w * 0.28498786688);
  const r = t2 + t1;
  const hfsq = 0.5 * f * f;
  const dk = @as(f32, k);
  return s * (hfsq + r) + dk * 9.0580006145e-06 - hfsq + f + dk * 6.9313812256e-01;
}

// FreeBSD's expf.
noinline fn scale2(y: f32, k: i32) f32 {
  // y * 2^k, k in [-150, 128].
  var kk: i32 = k;
  var v: f32 = y;
  while (kk > 100) { v = v * 1.2676506e30; kk -= 100; }
  while (kk < -100) { v = v * 7.888609e-31; kk += 100; }
  if (kk >= -126) { return v * @bitcast(f32, @as(u32, kk + 127) << 23); }
  return v * 1.1754944e-38 * @bitcast(f32, @as(u32, kk + 126 + 127) << 23);
}
fn expf(v: f32) f32 {
  var x: f32 = v;
  const hx: u32 = @bitcast(u32, x) & 0x7fffffff;
  const neg = x < 0.0;
  if (hx >= 0x42b17218) {
    if (hx > 0x7f800000) { return x; }
    if (x > 88.72168) { return POS_INF; }
    if (x < -103.97208) { return 0.0; }
  }
  var k: i32 = 0;
  var hi: f32 = 0.0;
  var lo: f32 = 0.0;
  if (hx > 0x3eb17218) {
    if (hx < 0x3F851592) {
      hi = if (neg) x + 6.9314575195e-01 else x - 6.9314575195e-01;
      lo = if (neg) -1.4286067653e-06 else 1.4286067653e-06;
      k = if (neg) -1 else 1;
    } else {
      k = @as(i32, 1.4426950216 * x + (if (neg) -0.5 else 0.5));
      const t = @as(f32, k);
      hi = x - t * 6.9314575195e-01;
      lo = t * 1.4286067653e-06;
    }
    x = hi - lo;
  } else if (hx < 0x39000000) {
    return 1.0 + x;
  }
  const t = x * x;
  const c = x - t * (1.6666625440e-1 + t * -2.7667332906e-3);
  if (k == 0) { return 1.0 - ((x * c) / (c - 2.0) - x); }
  const y = 1.0 - ((lo - (x * c) / (2.0 - c)) - hi);
  return scale2(y, k);
}

// ---- eta-ir rng.rs, bit for bit ----
fn splitmix64(v: u64) u64 {
  var z: u64 = v;
  z ^= z >> 27;
  z = z * 0x3C79AC492BA7B653;
  z ^= z >> 33;
  z = z * 0x1C69B3F74AC4AE35;
  z ^= z >> 27;
  return z;
}
const LANE_STRIDE: u64 = 0x9E3779B97F4A7C15;
fn draw(z: u64, gumbel: bool) f32 {
  const bits = @as(u32, splitmix64(z) >> 40);
  const raw = (@as(f32, bits) + 0.5) * (1.0 / 16777216.0);
  const u = if (raw < 0.99999994) raw else 0.99999994;
  return if (gumbel) -logf(-logf(u)) else u;
}
fn seed_of(st: u32, one: bool) u64 {
  const key = pool[@as(u16, st)];
  const ctr = if (one) @as(u32, 0) else pool[@as(u16, st) + 1];
  return splitmix64((@as(u64, key) << 32) | @as(u64, ctr));
}

// ---- typed scalar semantics (eta-exec bin_arith / cmp_op / casts) ----
fn as_i64(w: u32, t: u32) i64 {
  if (t == T_F32) { return @as(i64, @bitcast(f32, w)); }
  if (t == T_I32) { return @as(i64, @bitcast(i32, w)); }
  return @as(i64, w);
}
fn as_f32(w: u32, t: u32) f32 {
  if (t == T_F32) { return @bitcast(f32, w); }
  if (t == T_I32) { return @as(f32, @bitcast(i32, w)); }
  return @as(f32, w);
}
fn binf(op: u32, x: f32, y: f32) f32 {
  if (op == 0) { return x + y; }
  if (op == 1) { return x - y; }
  if (op == 2) { return x * y; }
  if (op == 3) { return x / y; }
  if (op == 4) { return if (x > y or y != y) x else y; }   // f32::max
  if (op == 5) { return if (x < y or y != y) x else y; }   // f32::min
  // rem: x - trunc(x / y) * y (fmod for the magnitudes samplers use)
  const q = x / y;
  const tq = @as(f32, @as(i32, q));
  return x - tq * y;
}
fn bini(op: u32, x: u32, y: u32, t: u32) u32 {
  if (op == 0) { return x + y; }
  if (op == 1) { return x - y; }
  if (op == 2) { return x * y; }
  if (t == T_I32) {
    const a = @bitcast(i32, x);
    const b = @bitcast(i32, y);
    if (op == 3 or op == 6) {
      if (b == 0) { return 0; }
      const ua: u32 = if (a < 0) 0 - x else x;
      const ub: u32 = if (b < 0) 0 - y else y;
      const q: u32 = if (op == 3) ua / ub else ua % ub;
      // the quotient's sign is the operands', the remainder's the dividend's
      const negq = if (op == 3) (a < 0) != (b < 0) else a < 0;
      return if (negq) 0 - q else q;
    }
    if (op == 4) { return if (a > b) x else y; }
    if (op == 5) { return if (a < b) x else y; }
    return x;
  }
  if (op == 3) { return if (y == 0) 0 else x / y; }
  if (op == 4) { return if (x > y) x else y; }
  if (op == 5) { return if (x < y) x else y; }
  return if (y == 0) 0 else x % y;
}
fn cmpf(op: u32, x: f32, y: f32) bool {
  if (op == 0) { return x > y; }
  if (op == 1) { return x >= y; }
  if (op == 2) { return x < y; }
  if (op == 3) { return x <= y; }
  if (op == 4) { return x == y; }
  return x != y;
}
fn cmpi(op: u32, x: i64, y: i64) bool {
  if (op == 0) { return x > y; }
  if (op == 1) { return x >= y; }
  if (op == 2) { return x < y; }
  if (op == 3) { return x <= y; }
  if (op == 4) { return x == y; }
  return x != y;
}
fn unf(op: u32, x: f32) f32 {
  if (op == 0) { return -x; }
  if (op == 1) { return if (x < 0.0) -x else x; }
  if (op == 2) { return expf(x); }
  if (op == 3) { return logf(x); }
  if (op == 4) { return math.sqrt_f32(x); }
  if (op == 5) { return if (x == 0.0) 1.0 else 0.0; }
  if (op == 6) { return @as(f32, @as(i32, x)); }
  if (op == 7) { return if (x != 0.0) 1.0 else 0.0; }
  if (op == 8) { return 1.0 / x; }
  if (op == 9) { return if (x > 0.0) 1.0 else if (x < 0.0) -1.0 else 0.0; }
  return 1.0 / math.sqrt_f32(x);
}
// Casts: from t to (c - 16).
fn cast(w: u32, t: u32, to: u32) u32 {
  if (to == T_F32) {
    if (t == T_BOOL) { return @bitcast(u32, if (w != 0) @as(f32, 1.0) else @as(f32, 0.0)); }
    return @bitcast(u32, as_f32(w, t));
  }
  if (to == T_BOOL) {
    if (t == T_F32) { return if (@bitcast(f32, w) != 0.0) 1 else 0; }
    return if (w != 0) 1 else 0;
  }
  if (t == T_F32) {
    const f = @bitcast(f32, w);
    if (f != f) { return 0; }
    if (to == T_I32) {
      if (f >= 2147483647.0) { return 0x7fffffff; }
      if (f <= -2147483648.0) { return 0x80000000; }
      return @bitcast(u32, @as(i32, f));
    }
    if (f <= 0.0) { return 0; }
    if (f >= 4294967295.0) { return 0xffffffff; }
    return @as(u32, f);
  }
  return w;   // integer <-> integer: the same 32 bits
}

// ---- canonical reductions (eta-exec canonical_reduce) ----
// buf[0..n) folded in blocks of 32 (offsets 16, 8, 4, 2, 1), then levels.
noinline fn canon_sum(n: u16) f32 {
  // eta's canonical_reduce over red[0..n): each level sums blocks of 32
  // (lane l += lane l + off, off 16, 8, 4, 2, 1; missing lanes 0) as vector
  // adds in place, the block sums packed to the front for the next level.
  if (n == 0) { return 0.0; }
  var len: u16 = n;
  while (len > 1) {
    { var z: u16 = len; while (z % 32 != 0) : (z += 1) { red[z] = 0.0; } }
    var g: u16 = 0;
    while (g * 32 < len) : (g += 1) {
      var off: u16 = 16;
      while (off > 0) {
        const lo = @set_dsd_length(@increment_dsd_offset(red_dsd(RB), @as(i16, g * 32), f32), off);
        const hi = @increment_dsd_offset(lo, @as(i16, off), f32);
        @fadds(lo, lo, hi);
        off = off / 2;
      }
    }
    { var k: u16 = 1; while (k < g) : (k += 1) { red[k] = red[32 * k]; } }
    len = g;
  }
  return red[0];
}
noinline fn canon_isum(o: u16, n: u16) u32 {
  var s: u32 = 0;
  { var i: u16 = 0; while (i < n) : (i += 1) { s = s + pool[o + i]; } }
  return s;   // wrapping sums are order-free
}

// ---- the lane fold engine (blocking, on the VM columns) ----
const K_MAX: u16 = 0;
const K_SUM: u16 = 1;
const K_LIST: u16 = 2;
var fkind: u16 = 0;
var pend: i32 = 0;
var pend_d: u32 = 0;
var pend_a: u32 = 0;
var pend_b: u32 = 0;
var pend_c: u32 = 0;
var pend_fl: u32 = 0;
var phase: u16 = 0;

fn red_dsd(n: u16) mem1d_dsd {
  return @set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{RB} -> red[i] }), n);
}
fn fab_out(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fab_in(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}
// ---- list folds: a streaming merge ----
// A list (lb (value, index) pairs, value descending, index ascending,
// padding -inf at index 3e38) travels as interleaved pairs. A PE without
// entries forwards it fabric to fabric; one with entries merges its own in
// pair by pair as the stream passes (reading only as far as it must), so the
// whole chain pipelines; a hub merges its two half columns and the west hub
// the same way. Every PE then receives the lane's list (on K) into red as
// [values | indices].
// Pairs move PB at a time (one DSD op each way instead of one a pair).
const PB: u16 = 4;
var ib = @zeros([3 * 2 * PB]f32);   // each input stream's buffered pairs
const ib_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{3 * 2 * PB} -> ib[i] });
var hn = @zeros([3]u16);    // pairs read from each stream
var hp = @zeros([3]u16);    // the next buffered pair
var hc = @zeros([3]u16);    // buffered pairs
var ob = @zeros([2 * PB]f32);
const ob_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * PB} -> ob[i] });
var on: u16 = 0;            // pairs waiting in ob
fn rd(comptime q: input_queue, s: u16, c: u16) void {
  @fmovs(@set_dsd_length(@increment_dsd_offset(ib_dsd, @as(i16, 2 * PB * s), f32), 2 * c), fab_in(q, 2 * c));
}
// Stream s's head pair is buffered (false: the stream is done).
fn have(s: u16) bool {
  if (hp[s] < hc[s]) { return true; }
  if (hn[s] >= lb) { return false; }
  const c = if (lb - hn[s] < PB) lb - hn[s] else PB;
  if (s == 0) { rd(q4_in, 0, c); } else if (s == 1) { rd(q5_in, 1, c); } else { rd(q6_in, 2, c); }
  hn[s] += c;
  hc[s] = c;
  hp[s] = 0;
  return true;
}
fn flush() void {
  if (on > 0) { @fmovs(fab_out(q3_out, 2 * on), @set_dsd_length(ob_dsd, 2 * on)); on = 0; }
}
fn emit(v: f32, i: f32) void {
  ob[2 * on] = v;
  ob[2 * on + 1] = i;
  on += 1;
  if (on == PB) { flush(); }
}
// Read and drop the rest of stream s.
fn drain(s: u16) void {
  hp[s] = hc[s];
  while (have(s)) { hp[s] = hc[s]; }
}
// Merge `ns` input streams (q4, q5, q6) and this PE's own m entries (red,
// [values | indices]) into lb pairs: out on q3, or (the last hub) into red,
// sent on K only once every input is drained: K reaches PEs still sending,
// whose result queue would back the multicast up into the merge (a cycle).
noinline fn smerge(ns: u16, m: u16, last: bool) void {
  { var s: u16 = 0; while (s < 3) : (s += 1) { hn[s] = 0; hp[s] = 0; hc[s] = 0; } }
  on = 0;
  var j: u16 = 0;
  { var k: u16 = 0; while (k < lb) : (k += 1) {
    var bv: f32 = NEG_INF;
    var bi: f32 = 3.0e38;
    var best: u16 = 3;   // 3: own (or padding)
    if (j < m) { bv = red[j]; bi = red[lb + j]; }
    { var s: u16 = 0; while (s < ns) : (s += 1) {
      if (have(s)) {
        const at = 2 * PB * s + 2 * hp[s];
        const v = ib[at];
        const i = ib[at + 1];
        if (v > bv or (v == bv and i < bi)) { bv = v; bi = i; best = s; }
      }
    } }
    if (best == 3) { if (j < m) { j += 1; } } else { hp[best] += 1; }
    if (last) { red[k] = bv; red[lb + k] = bi; } else { emit(bv, bi); }
    if (!last and ns == 1 and j == m) {
      // Own entries placed: the buffered pairs, then the rest of the stream
      // in bulk, then the m pairs it has no room for are dropped.
      var outs: u16 = k + 1;
      while (hp[0] < hc[0] and outs < lb) {
        const at = 2 * hp[0];
        emit(ib[at], ib[at + 1]);
        hp[0] += 1;
        outs += 1;
      }
      flush();
      const r = lb - outs;
      if (r > 0) { @fmovs(fab_out(q3_out, 2 * r), fab_in(q4_in, 2 * r)); hn[0] += r; }
      drain(0);
      return;
    }
  } }
  flush();
  { var s: u16 = 0; while (s < ns) : (s += 1) { drain(s); } }
  // The last hub: the lane's list on K, [values | indices].
  if (last) { @fmovs(fab_out(q3_out, 2 * lb), red_dsd(2 * lb)); }
}
// smerge for a column PE (one input stream, q4, and its own m entries), in
// straight-line code: the common case, and the pipeline's pace.
noinline fn smerge1(m: u16) void {
  on = 0;
  var hn0: u16 = 0;
  var hp0: u16 = 0;
  var hc0: u16 = 0;
  var hv: f32 = NEG_INF;
  var hi: f32 = 3.0e38;
  var held = false;
  var j: u16 = 0;
  var k: u16 = 0;
  while (k < lb) {
    if (!held) {
      if (hp0 == hc0 and hn0 < lb) {
        const c = if (lb - hn0 < PB) lb - hn0 else PB;
        @fmovs(@set_dsd_length(ib_dsd, 2 * c), fab_in(q4_in, 2 * c));
        hn0 += c;
        hc0 = c;
        hp0 = 0;
      }
      if (hp0 < hc0) { hv = ib[2 * hp0]; hi = ib[2 * hp0 + 1]; hp0 += 1; held = true; }
    }
    const ov = red[j];
    const oi = red[lb + j];
    if (!held or ov > hv or (ov == hv and oi < hi)) {
      emit(ov, oi);
      j += 1;
    } else {
      emit(hv, hi);
      held = false;
    }
    k += 1;
    if (j == m) {
      // Own entries placed: the held and buffered pairs, the rest in bulk,
      // then the m pairs there is no room for are dropped.
      if (held and k < lb) { emit(hv, hi); k += 1; held = false; }
      while (hp0 < hc0 and k < lb) { emit(ib[2 * hp0], ib[2 * hp0 + 1]); hp0 += 1; k += 1; }
      flush();
      const r = lb - k;
      if (r > 0) { @fmovs(fab_out(q3_out, 2 * r), fab_in(q4_in, 2 * r)); hn0 += r; }
      while (hn0 < lb) {
        const c = if (lb - hn0 < PB) lb - hn0 else PB;
        @fmovs(@set_dsd_length(ib_dsd, 2 * c), fab_in(q4_in, 2 * c));
        hn0 += c;
      }
      return;
    }
  }
  flush();
  while (hn0 < lb) {
    const c = if (lb - hn0 < PB) lb - hn0 else PB;
    @fmovs(@set_dsd_length(ib_dsd, 2 * c), fab_in(q4_in, 2 * c));
    hn0 += c;
  }
}
// The lane's list, arriving on K ([values | indices]), into red.
noinline fn list_result() void {
  @fmovs(red_dsd(2 * lb), fab_in(q7_in, 2 * lb));
}
fn own_count() u16 {
  var m: u16 = 0;
  while (m < lb and red[lb + m] < 3.0e38) : (m += 1) {}
  return m;
}
noinline fn list_fold() void {
  const m = own_count();
  if (!hub) {
    if (col_end) {
      on = 0;
      { var k: u16 = 0; while (k < lb) : (k += 1) { emit(red[k], red[lb + k]); } }
      flush();
    } else if (m == 0) {
      @fmovs(fab_out(q3_out, 2 * lb), fab_in(q4_in, 2 * lb));
    } else {
      smerge1(m);
    }
    list_result();
    return;
  }
  smerge(if (hub_first) 2 else 3, 0, hub_last);
  if (!hub_last) { list_result(); }
}

// red (+)= what arrives on q (n words), by the fold's kind.
fn take(comptime q: input_queue, m: u16) void {
  if (fkind == K_MAX) {
    @fmaxs(red_dsd(m), red_dsd(m), fab_in(q, m));
  } else {
    @fadds(red_dsd(m), red_dsd(m), fab_in(q, m));
  }
}

var col_end: bool = false;   // the far end of a half column (sends first)
var hub_first: bool = false; // block 0's hub (starts the row chain)
var hub_last: bool = false;  // the last block's hub (sends the result)

// A lane fold of red[0..n) (max or sum) or of the sorted list in red[0..2lb);
// returns with the result in red on every VM PE (the hubs included).
noinline fn lane_fold(kind: u16, n: u16) void {
  fkind = kind;
  if (OPK_LISTS and kind == K_LIST) {
    list_fold();
    return;
  }
  const m = n;
  if (!hub) {
    if (col_end) {
      if (!col_end) { take(q4_in, m); }
      @fmovs(fab_out(q3_out, m), red_dsd(m));
    } else if (fkind == K_MAX) {
      // Streamed down the half column: combine and forward word by word.
      @fmaxs(fab_out(q3_out, m), red_dsd(m), fab_in(q4_in, m));
    } else {
      @fadds(fab_out(q3_out, m), red_dsd(m), fab_in(q4_in, m));
    }
    @fmovs(red_dsd(m), fab_in(q7_in, m));
    return;
  }
  take(q4_in, m);
  take(q5_in, m);
  if (SPLIT) { take(q3_in, m); take(q2_in, m); }
  if (hub_first or hub_last) {
    if (!hub_first) { take(q6_in, m); }
    @fmovs(fab_out(q3_out, m), red_dsd(m));
  } else if (fkind == K_MAX) {
    // Streamed along the row: each hub combines and forwards word by word.
    @fmaxs(fab_out(q3_out, m), red_dsd(m), fab_in(q6_in, m));
  } else {
    @fadds(fab_out(q3_out, m), red_dsd(m), fab_in(q6_in, m));
  }
  if (!hub_last) { @fmovs(red_dsd(m), fab_in(q7_in, m)); }
}

// One chunk of the canonical sum's blocks: this PE's in their slots.
// vm_sumpipe 2 (one block, Vt 32): the canonical sum as a concatenation.
// Each region row's NVC block sums go east to the last VM column (the row
// gather); that column's two half chains carry, hop by hop, [edge | open |
// fulls]: edge, the 32 slots of the group the halves split (if F·NVC is not
// a multiple of 32); open, the group being filled; fulls, every completed
// group's level-2 sum (32-lane tree, missing lanes 0). A PE whose blocks
// complete a group trees it into its fulls slot; the rest stream through.
// The last hub joins the halves, sums the level-2 list (canon_sum) and sends
// the one result (K). Same trees, so the same bits as the chunked sum.
const SUMCAT: bool = vm_sumpipe == 2 and NB == 1 and Vt == 32;
comptime { if (SUMCAT) { @comptime_assert(@as(u32, H) * @as(u32, NVC) < 65536); } }
fn cat_col(j: u16) u16 { return if (j % 2 == 0) C_E else C_G; }
// (the chain's two 32-word groups live in red, idle during the sum)
var cat_row = @zeros([NVC]f32);
const cat_buf_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{32} -> red[i] });
const cat_own_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{32} -> red[i + 32] });
noinline fn cat_tree() f32 {
  var off: u16 = 16;
  while (off > 0) {
    const lo = @set_dsd_length(cat_buf_dsd, off);
    const hi = @increment_dsd_offset(lo, @as(i16, off), f32);
    @fadds(lo, lo, hi);
    off = off / 2;
  }
  return red[0];
}
// (out of line: each fabric DSD site costs code, the chain's few helpers do)
const cat_row_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NVC} -> cat_row[i] });
const l2_dsd = if (L2W) @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{L2N} -> wide[i] })
                else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{L2N} -> l2_own[i] });
noinline fn c_fwd(n: u16) void { if (n > 0) { @fmovs(fab_out(q3_out, n), fab_in(q4_in, n)); } }
noinline fn c_out(src: mem1d_dsd, n: u16) void { if (n > 0) { @fmovs(fab_out(q3_out, n), @set_dsd_length(src, n)); } }
noinline fn c_in(dst: mem1d_dsd, n: u16) void { if (n > 0) { @fmovs(@set_dsd_length(dst, n), fab_in(q4_in, n)); } }
noinline fn c_add(src: mem1d_dsd) void { @fadds(fab_out(q3_out, 32), src, fab_in(q4_in, 32)); }
// n words of the chain: forwarded, or (the chain's first PE) zeros
fn c_pass(n: u16) void {
  if (!col_end) { c_fwd(n); return; }
  if (n > 0) { @fmovs(fab_out(q3_out, n), 0.0); }
}
noinline fn sum_cat() void {
  const N = NVC;
  const SN: u16 = @as(u16, F) * @as(u16, N);
  const TOT: u16 = @as(u16, H) * @as(u16, N);
  const qb: u16 = SN / 32;
  const strad = SN % 32 != 0;
  const ql0: u16 = if (strad) qb + 1 else qb;
  const qend: u16 = (TOT + 31) / 32;
  if (!hub) {
    // the row gather
    if (VJ > 0) { @fmovs(@set_dsd_length(cat_row_dsd, VJ), fab_in(q6_in, VJ)); }
    cat_row[VJ] = myblk[0];
    if (VJ + 1 < NVC) {
      @fmovs(fab_out(q2_out, VJ + 1), @set_dsd_length(cat_row_dsd, VJ + 1));
    } else {
      // the last column's half chain
      const up = vy < F;
      const ry: u16 = if (up) @as(u16, vy) else @as(u16, vy) - 1;
      const g0: u16 = ry * @as(u16, N);
      const s: u16 = if (up) 0 else SN;
      const e: u16 = if (up) SN else TOT;
      const q0: u16 = if (up) 0 else ql0;
      const nf: u16 = @as(u16, if (up) qb else qend - ql0);
      // edge: this row's blocks of the split group
      @fmovs(cat_own_dsd, 0.0);
      var has_edge = false;
      { var k: u16 = 0; while (k < N) : (k += 1) {
        const g = g0 + @as(u16, k);
        if (strad and g / 32 == qb) { red[32 + @as(u16, g % 32)] = cat_row[k]; has_edge = true; }
      } }
      if (col_end) { c_out(cat_own_dsd, 32); } else if (has_edge) { c_add(cat_own_dsd); } else { c_fwd(32); }
      // the open group and the completed ones, the blocks in chain order
      var done_q = @zeros([2]u16);
      var done_v = @zeros([2]f32);
      var nd: u16 = 0;
      var mode: u16 = 0;   // 0: no open-group block yet; 1: streams the open group; 2: took it in
      @fmovs(cat_buf_dsd, 0.0);
      { var t: u16 = 0; while (t < N) : (t += 1) {
        const k = if (up) t else N - 1 - t;
        const g = g0 + @as(u16, k);
        const q = g / 32;
        if (strad and q == qb) { continue; }
        const last_g: u16 = if (up) (if (32 * q + 31 < e - 1) 32 * q + 31 else e - 1) else (if (32 * q > s) 32 * q else s);
        if (mode == 0) {
          // does this row complete the incoming open group? then it takes it in
          var completes = false;
          { var u: u16 = t; while (u < N) : (u += 1) {
            if (g0 + @as(u16, if (up) u else N - 1 - u) == last_g) { completes = true; }
          } }
          mode = if (completes) 2 else 1;
          if (completes and !col_end) { c_in(cat_buf_dsd, 32); }
        }
        red[@as(u16, g % 32)] = cat_row[k];
        if (mode == 2 and g == last_g) {
          done_q[nd] = @as(u16, q - q0);
          done_v[nd] = cat_tree();
          nd += 1;
          @fmovs(cat_buf_dsd, 0.0);
        }
      } }
      if (mode == 1) {
        if (col_end) { c_out(cat_buf_dsd, 32); } else { c_add(cat_buf_dsd); }
      } else if (mode == 0) {
        c_pass(32);
      } else {
        c_out(cat_buf_dsd, 32);
      }
      // fulls: passed on, this row's completed sums in their slots (in order)
      if (nd == 2 and done_q[0] > done_q[1]) {
        const tq = done_q[0]; done_q[0] = done_q[1]; done_q[1] = tq;
        const tv = done_v[0]; done_v[0] = done_v[1]; done_v[1] = tv;
      }
      var at: u16 = 0;
      { var d: u16 = 0; while (d < nd) : (d += 1) {
        c_pass(done_q[d] - at);
        if (!col_end) { c_in(cat_buf_dsd, 1); }
        red[0] = done_v[d];
        c_out(cat_buf_dsd, 1);
        at = done_q[d] + 1;
      } }
      c_pass(nf - at);
    }
  } else if (hub_last) {
    // the halves: north (q4), then south (q5)
    const nfu: u16 = @as(u16, qb);
    const nfl: u16 = @as(u16, qend - ql0);
    c_in(cat_buf_dsd, 32);
    c_in(cat_own_dsd, 32);   // the open group: empty at a chain's end
    c_in(l2_dsd, nfu);
    @fadds(cat_buf_dsd, cat_buf_dsd, fab_in(q5_in, 32));
    @fmovs(cat_own_dsd, fab_in(q5_in, 32));
    if (nfl > 0) { @fmovs(@set_dsd_length(@increment_dsd_offset(l2_dsd, @as(i16, @as(u16, ql0)), f32), nfl), fab_in(q5_in, nfl)); }
    if (strad) { l2[@as(u16, qb)] = cat_tree(); }
    const n2 = @as(u16, qend);
    { var k: u16 = 0; while (k < L2N) : (k += 1) { if (k < n2) { red[k] = l2[k]; } } }
    red[0] = canon_sum(n2);
    @fmovs(fab_out(q3_out, 1), red_dsd(1));
    return;
  }
  @fmovs(red_dsd(1), fab_in(q7_in, 1));
}
const SUMPIPE: bool = vm_sumpipe != 0;
comptime { if (SPLIT) { @comptime_assert(vm_sumpipe <= 1 and !OPK_LISTS); } }
const SUMROWS: bool = vm_sumpipe == 3 and NB == 1 and Vt == 32 and 32 * NVC <= RB;
const SR_COL = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{32} -> red[i * @as(i16, NVC)] });
fn sr_pass(n: u16) void { if (n > 0) { @fmovs(fab_out(q3_out, n), fab_in(q4_in, n)); } }
fn sr_zero(n: u16) void { if (n > 0) { @fmovs(fab_out(q3_out, n), 0.0); } }
// column c's rows [r, r + n) of the chunk, from queue q, into red (block order)
fn sr_col(comptime q: input_queue, c: u16, r: u16, n: u16) void {
  if (n > 0) { @fmovs(@set_dsd_length(@increment_dsd_offset(SR_COL, @as(i16, r * NVC + c), f32), n), fab_in(q, n)); }
}
const SR_T16 = @get_dsd(mem4d_dsd, .{ .tensor_access = |g, i|{NVC, 16} -> red[g * 32 + i] });
const SR_T8 = @get_dsd(mem4d_dsd, .{ .tensor_access = |g, i|{NVC, 8} -> red[g * 32 + i] });
const SR_T4 = @get_dsd(mem4d_dsd, .{ .tensor_access = |g, i|{NVC, 4} -> red[g * 32 + i] });
const SR_T2 = @get_dsd(mem4d_dsd, .{ .tensor_access = |g, i|{NVC, 2} -> red[g * 32 + i] });
const SR_T1 = @get_dsd(mem4d_dsd, .{ .tensor_access = |g, i|{NVC, 1} -> red[g * 32 + i] });
noinline fn sum_rows() void {
  const nch = (H + 31) / 32;
  if (!hub) { red[0] = myblk[0]; }
  { var k: u16 = 0; while (k < nch) : (k += 1) {
    const r0 = k * 32;
    const r1 = if (H - r0 < 32) H else r0 + 32;
    const nn: u16 = if (r0 < F) (if (r1 < F) r1 else F) - r0 else 0;   // the chunk's north rows
    const ns: u16 = (r1 - r0) - nn;
    if (!hub) {
      const north = vy < F;
      const len = if (north) nn else ns;
      if (len == 0) { continue; }
      const s0 = if (north) r0 else r0 + nn;   // the half's first chunk row
      // in the chain: between the chunk's far row and the hub
      if (north and vry < s0) { continue; }
      if (!north and vry > s0 + len - 1) { continue; }
      const mine = vry >= s0 and vry < s0 + len;
      const far = if (north) vry == s0 else vry == s0 + len - 1;
      if (!mine) {
        sr_pass(len);
      } else {
        const idx = vry - s0;
        if (far) {
          sr_zero(idx);
          @fmovs(fab_out(q3_out, 1), red_dsd(1));
          sr_zero(len - idx - 1);
        } else {
          sr_pass(idx);
          @fadds(fab_out(q3_out, 1), red_dsd(1), fab_in(q4_in, 1));
          sr_pass(len - idx - 1);
        }
      }
    } else if (!hub_last) {
      if (!hub_first) { @fmovs(fab_out(q3_out, VJ * (r1 - r0)), fab_in(q6_in, VJ * (r1 - r0))); }
      if (nn > 0) { @fmovs(fab_out(q3_out, nn), fab_in(q4_in, nn)); }
      if (ns > 0) { @fmovs(fab_out(q3_out, ns), fab_in(q5_in, ns)); }
    } else {
      const L = r1 - r0;
      if (L < 32) { @fmovs(red_dsd(32 * NVC), 0.0); }   // a short last chunk: its missing lanes 0
      { var c: u16 = 0; while (c + 1 < NVC) : (c += 1) { sr_col(q6_in, c, 0, L); } }
      sr_col(q4_in, NVC - 1, 0, nn);
      sr_col(q5_in, NVC - 1, nn, ns);
      // the chunk's NVC groups' trees at once (offsets 16 .. 1), their sums to l2
      @fadds(SR_T16, SR_T16, @increment_dsd_offset(SR_T16, 16, f32));
      @fadds(SR_T8, SR_T8, @increment_dsd_offset(SR_T8, 8, f32));
      @fadds(SR_T4, SR_T4, @increment_dsd_offset(SR_T4, 4, f32));
      @fadds(SR_T2, SR_T2, @increment_dsd_offset(SR_T2, 2, f32));
      @fadds(SR_T1, SR_T1, @increment_dsd_offset(SR_T1, 1, f32));
      const ng = (L * NVC + 31) / 32;
      { var g: u16 = 0; while (g < ng) : (g += 1) { l2[k * NVC + g] = red[g * 32]; } }
    }
  } }
  if (hub and hub_last) {
    const n2 = (nblk + 31) / 32;
    { var k: u16 = 0; while (k < L2N) : (k += 1) { if (k < n2) { red[k] = l2[k]; } } }
    red[0] = canon_sum(n2);
    @fmovs(fab_out(q3_out, 1), red_dsd(1));
  } else {
    @fmovs(red_dsd(1), fab_in(q7_in, 1));
  }
}
noinline fn sum_pipe() void {
  fkind = K_SUM;
  const nch = (nblk + CH - 1) / CH;
  { var k: u16 = 0; while (k < nch) : (k += 1) {
    const lo = k * CH;
    const n = if (nblk - lo < CH) nblk - lo else CH;
    @fmovs(red_dsd(n), 0.0);
    if (!hub) {
      const b0 = @as(u16, lane_base() / 32);
      { var blk: u16 = 0; while (blk < Vt / 32) : (blk += 1) {
        const g = b0 + blk;
        if (g >= lo and g < lo + n) { red[g - lo] = myblk[blk]; }
      } }
      if (col_end) {
        @fmovs(fab_out(q3_out, n), red_dsd(n));
      } else {
        @fadds(fab_out(q3_out, n), red_dsd(n), fab_in(q4_in, n));
      }
    } else {
      take(q4_in, n);
      take(q5_in, n);
      if (SPLIT) { take(q3_in, n); take(q2_in, n); }
      if (hub_last) {
        if (!hub_first) { take(q6_in, n); }
        // level 2 of this chunk's blocks (groups of 32, missing lanes 0)
        { var z: u16 = n; while (z % 32 != 0) : (z += 1) { red[z] = 0.0; } }
        var g: u16 = 0;
        while (g * 32 < n) : (g += 1) {
          var off: u16 = 16;
          while (off > 0) {
            const glo = @set_dsd_length(@increment_dsd_offset(red_dsd(RB), @as(i16, g * 32), f32), off);
            const ghi = @increment_dsd_offset(glo, @as(i16, off), f32);
            @fadds(glo, glo, ghi);
            off = off / 2;
          }
          l2[lo / 32 + g] = red[g * 32];
        }
      } else if (hub_first) {
        @fmovs(fab_out(q3_out, n), red_dsd(n));
      } else {
        @fadds(fab_out(q3_out, n), red_dsd(n), fab_in(q6_in, n));
      }
    }
  } }
  if (hub and hub_last) {
    const n2 = (nblk + 31) / 32;
    { var k: u16 = 0; while (k < L2N) : (k += 1) { if (k < n2) { red[k] = l2[k]; } } }
    red[0] = canon_sum(n2);
    @fmovs(fab_out(q3_out, 1), red_dsd(1));
  } else {
    @fmovs(red_dsd(1), fab_in(q7_in, 1));
  }
}
noinline fn sum_chunk() void {
  const lo = chunk * CH;
  const n = if (nblk - lo < CH) nblk - lo else CH;
  @fmovs(red_dsd(n), 0.0);
  if (!hub) {
    const b0 = @as(u16, lane_base() / 32);
    { var blk: u16 = 0; while (blk < Vt / 32) : (blk += 1) {
      const g = b0 + blk;
      if (g >= lo and g < lo + n) { red[g - lo] = myblk[blk]; }
    } }
  }
  lane_fold(K_SUM, n);
}

// ---- local order (value descending, index ascending) for lists ----
var lpos: u16 = 0;
var lcount: u16 = 0;
// red[0..2LB): this PE's next LB entries after the cursor (sorted).
var cur_v: f32 = 0.0;
var cur_i: f32 = 0.0;
var cur_set: bool = false;
noinline fn local_list(r: u32) void {
  if (cur_set) {
    // Entries at or before the cursor are taken.
    while (lpos < lcount) {
      const e = order[lpos];
      const v = wv(r, e);
      const gi = @as(f32, lane_base() + @as(u32, e));
      if (v > cur_v or (v == cur_v and gi <= cur_i)) { lpos += 1; } else { break; }
    }
  }
  { var k: u16 = 0; while (k < lb) : (k += 1) {
    if (lpos + k < lcount) {
      const e = order[lpos + k];
      red[k] = wv(r, e);
      red[lb + k] = @as(f32, lane_base() + @as(u32, e));
    } else {
      red[k] = NEG_INF;
      red[lb + k] = 3.0e38;
    }
  } }
}


// The rank pivot's radix select: this PE's order keys (0: NaN, never
// counted), and a round's histogram of the key byte below the prefix.
var rx_round: u16 = 0;
var rx_prefix: u32 = 0;
var rkey = @zeros([Vt]u32);
noinline fn rank_keys(r: u32) void {
  const o = @as(u16, r) * Vt;
  const n = nloc();
  { var i: u16 = 0; while (i < Vt) : (i += 1) {
    const v = wide[o + i];
    rkey[i] = if (i < n and v == v) okey(v) else 0;
  } }
}
// Top-p's: the mass histogram of the key byte below the prefix, and the
// local order of the entries at or above the floor (keys; insertion sort,
// value descending, index ascending).
var mx_phase: u16 = 0;
var tk_phase: u16 = 0;
var mx_target: f32 = 0.0;
var mass_cand: bool = false;
noinline fn mass_hist(r: u32) void { hist(r, true); }
noinline fn rank_hist() void { hist(0, false); }
// A 256-bin histogram (counts, or masses of W[r]) of the key byte below the
// prefix, summed over the lane.
noinline fn hist(r: u32, mass: bool) void {
  @fmovs(red_dsd(256), 0.0);
  const o = @as(u16, r) * Vt;
  const sh: u32 = 24 - 8 * @as(u32, rx_round);
  { var i: u16 = 0; while (i < Vt) : (i += 1) {
    const k = rkey[i];
    if (k != 0 and (rx_round == 0 or (k >> (sh + 8)) == rx_prefix)) {
      const bin = @as(u16, (k >> sh) & 255);
      red[bin] = red[bin] + (if (mass) wide[o + i] else 1.0);
    }
  } }
  lane_fold(K_SUM, 256);
}
// The bin holding the rank_k-th largest key (counts from the top): the
// prefix grows by it and rank_k becomes the rank inside it.
noinline fn count_pick() bool {
  const bin = pick(@as(f32, rank_k));
  if (bin < 0) { return false; }
  rank_k -= @as(u32, pick_cum);
  rx_prefix = (rx_prefix << 8) | @as(u32, bin);
  rx_round += 1;
  return true;
}
// The histogram bin, from the top, where the running sum of red[0..256)
// reaches `target` (-1: never); pick_cum is the sum above it. Sixteen group
// sums first (vector adds over strided views), then one group's bins.
var grp = @zeros([16]f32);
const grp_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{16} -> grp[i] });
var pick_cum: f32 = 0.0;
noinline fn pick(target: f32) i16 {
  @fmovs(grp_dsd, 0.0);
  { var t: u16 = 0; while (t < 16) : (t += 1) {
    const col = @increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{16} -> red[16 * i] }), @as(i16, t), f32);
    @fadds(grp_dsd, grp_dsd, col);
  } }
  var cum: f32 = 0.0;
  { var g: u16 = 16; while (g > 0) : (g -= 1) {
    if (cum + grp[g - 1] >= target) {
      // within the group, from its top bin
      { var b: u16 = 16; while (b > 0) : (b -= 1) {
        const c = red[16 * (g - 1) + b - 1];
        if (cum + c >= target or b == 1) {
          pick_cum = cum;
          return @as(i16, 16 * (g - 1) + b - 1);
        }
        cum += c;
      } }
    }
    cum += grp[g - 1];
  } }
  return -1;
}
noinline fn sort_cand(floor: u32) void {
  var n: u16 = 0;
  { var i: u16 = 0; while (i < Vt) : (i += 1) {
    const kx = rkey[i];
    if (kx != 0 and kx >= floor) {
      var j: u16 = n;
      while (j > 0) {
        const y = order[j - 1];
        if (rkey[y] >= kx) { break; }
        order[j] = y;
        j -= 1;
      }
      order[j] = i;
      n += 1;
    }
  } }
  lcount = n;
  lpos = 0;
}
// A list round whose candidates are known (no threshold fold).
fn known_fold(r: u32) void {
  local_list(r);
  lane_fold(K_LIST, 0);
}

// Order keys of f32 (monotone u32), for the rank pivot's bisection.
fn okey(v: f32) u32 {
  const b = @bitcast(u32, v);
  return if ((b & 0x80000000) != 0) ~b else b | 0x80000000;
}
var bis_t: u32 = 0;
var rank_k: u32 = 0;

// List consumers' state.
var excl: f32 = 0.0;
var got: u32 = 0;
var keep_v: f32 = 0.0;
var keep_i: f32 = 0.0;
var keep_any: bool = false;

fn run_section(s: u16) void {
  timestamp.get_timestamp(&t_start);
  section = s;
  pc = obase;
  if (s == 1) {
    // Skip the prefix to its HALT.
    while (@bitcast(i32, ops[pc * 4] & 0xff) != HALT) : (pc += 1) {}
    pc += 1;
  }
  exec();
}

noinline fn finish() void {
  if (section == 1) { ostep[0] += 1; }
  timestamp.get_timestamp(&t_end);
  const dt: u64 = tsc(&t_end) - tsc(&t_start);
  cycles[2 * section] = @as(u32, dt & 0xffffffff);
  cycles[2 * section + 1] = @as(u32, dt >> 32);
}

// exp over a register, vectorized (within 1 ulp of glibc, as the scalar
// expf): k = round(x / ln 2) by the 1.5·2^23 trick, r = x - k·ln2 (two
// parts), e^r by a degree-7 polynomial (vector ops); 2^k from the trick's
// low bits in one scalar pass, which also takes inputs past the normal
// range (and NaN) through expf. d != a.
var e_t2 = @zeros([Vt]f32);
const e_t2d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Vt} -> e_t2[i] });
noinline fn vexp(d: u32, a: u32) void {
  const D = reg(d);
  // xc = clamp(x, -87.33, 88.72) in tmp
  @fmaxs(tmp0, reg(a), -87.33);
  @fnegs(tmp0, tmp0);
  @fmaxs(tmp0, tmp0, -88.72);
  @fnegs(tmp0, tmp0);
  @fmuls(e_t2d, tmp0, 1.4426950216);
  @fadds(e_t2d, e_t2d, 12582912.0);
  @fsubs(D, e_t2d, 12582912.0);
  @fmuls(D, D, -6.9314575195e-01);
  @fadds(tmp0, tmp0, D);
  @fsubs(D, e_t2d, 12582912.0);
  @fmuls(D, D, -1.4286067653e-06);
  @fadds(tmp0, tmp0, D);
  @fmovs(D, 1.0 / 5040.0);
  const coeffs = [7]f32 { 1.0 / 720.0, 1.0 / 120.0, 1.0 / 24.0, 1.0 / 6.0, 0.5, 1.0, 1.0 };
  { var k: u16 = 0; while (k < 7) : (k += 1) {
    @fmuls(D, D, tmp0);
    @fadds(D, D, coeffs[k]);
  } }
  // 2^k from the trick's low bits, one scalar pass (with the fix-up: past
  // the normal range, and NaN, as expf).
  const od = @as(u16, d) * Vt;
  { var i: u16 = 0; while (i < Vt) : (i += 1) {
    const x = wv(a, i);
    if (x >= -87.33 and x <= 88.72) {
      const k = @bitcast(i32, @bitcast(u32, e_t2[i]) - 0x4B400000);
      wide[od + i] = wide[od + i] * @bitcast(f32, @as(u32, k + 127) << 23);
    } else {
      wide[od + i] = expf(x);
    }
  } }
}

// A register over a scalar, vectorized: q = x·(1/s), then one fused
// correction q += (x - q·s)·(1/s) (Markstein: with 1/s correctly rounded
// and q within an ulp, the IEEE quotient), checked bit-exact against
// scalar division on the simulator. Quotients past the normal range, and
// a scalar or reciprocal past it, take scalar divisions.
fn normal(v: f32) bool {
  const m = if (v < 0.0) -v else v;
  return m >= 1.1754944e-38 and m <= 3.4028235e38;
}
noinline fn vdiv(d: u32, a: u32, s: f32) void {
  const od = @as(u16, d) * Vt;
  const r = 1.0 / s;
  if (!normal(s) or !normal(r)) {
    { var i: u16 = 0; while (i < Vt) : (i += 1) { wide[od + i] = wide[@as(u16, a) * Vt + i] / s; } }
    return;
  }
  const D = reg(d);
  @fmovs(e_t2d, reg(a));
  @fmovs(tmp0, e_t2d);
  @fmuls(D, e_t2d, r);
  @fmacs(tmp0, tmp0, D, -s);
  @fmacs(D, D, tmp0, r);
  { var i: u16 = 0; while (i < Vt) : (i += 1) {
    // exponent 0 (zero, subnormal) or 255 (inf, NaN): redo as a scalar
    const e = (@bitcast(u32, wide[od + i]) >> 23) & 0xff;
    if (e == 0 or e == 255) {
      wide[od + i] = if (e_t2[i] == 0.0) e_t2[i] * r else e_t2[i] / s;   // the zero's sign
    }
  } }
}

// f32::max / f32::min (eta: x if x > y (x < y) or y is NaN, else y) as
// vector ops: the PE's fmax returns the non-NaN operand and, on a tie, its
// first one, so max(x, y) = fmax(y, x) bit for bit (signed zeros included,
// checked on the simulator); min(x, y) = -fmax(-y, -x). A scalar y goes
// second (fmax's scalar operand), so its tie case (y = +-0) and NaN take the
// scalar loop.
fn vminmax_ok(s: f32) bool {
  return s == s and s != 0.0;
}
noinline fn vminmax(d: u32, a: u32, b: u32, bb: bool, is_min: bool) void {
  const D = reg(d);
  if (bb) {
    const s = pf(b);
    if (is_min) {
      @fnegs(tmp0, reg(a));
      @fmaxs(D, tmp0, -s);
      @fnegs(D, D);
    } else {
      @fmaxs(D, reg(a), s);
    }
  } else if (is_min) {
    @fnegs(tmp0, reg(a));
    @fnegs(e_t2d, reg(b));
    @fmaxs(D, e_t2d, tmp0);
    @fnegs(D, D);
  } else {
    @fmaxs(D, reg(b), reg(a));
  }
}

fn wide_or_scalar(r: u32, is_scalar: bool, i: u16) f32 {
  return if (is_scalar) pf(r) else wv(r, i);
}

// Per-instruction cycles (profiling): the time from an instruction's start
// to the next one's (its folds included), summed over runs; the host reads
// and clears `prof`. vm_prof 0 leaves it out (one word; PE memory).
const PROF: bool = vm_prof != 0;
var prof = @zeros([if (PROF) max_ops else 1]u32);
var prof_ptr: [*]u32 = &prof;
var prof_t = @zeros([timestamp.tsc_size_words]u16);
var prof_now = @zeros([timestamp.tsc_size_words]u16);
var prof_pc: u16 = 0xffff;
fn prof_mark() void {
  if (!PROF) { return; }
  timestamp.get_timestamp(&prof_now);
  if (prof_pc != 0xffff) {
    prof[prof_pc] += @as(u32, (tsc(&prof_now) - tsc(&prof_t)) & 0xffffffff);
  }
  prof_t = prof_now;
  prof_pc = pc;
}

// eta's pivot_threshold by mass (top-p): entries in descending order (ties by
// index, NaN last), each kept while the f32 sum of those before it is < p.
// Walked KB entries a round. Each PE sorts its own entries once (eta's
// order). A max fold of every PE's next KB values, slot by slot, gives a floor
// t <= the round's KB-th entry, so only PEs whose next entry is >= t can be in
// the round: they merge their next KB into a k-list fold (blocking,
// store-and-forward); the rest pass the list on fabric to fabric. Every PE
// gets the next KB entries in eta's order and runs the sum as eta does. With
// no negative entry the walk stops at p.
const KB: u16 = 16;
var kord = @zeros([Vt]u16);
fn kbefore(v: f32, i: f32, w: f32, j: f32) bool { return v > w or (v == w and i < j); }
// Merge the KB-list at red[o] into red[0..2KB): the first KB of both.
noinline fn kmerge(o: u16) void {
  if (red[o + KB] >= 3.0e38) { return; }   // nothing came in
  if (red[KB] >= 3.0e38) { @fmovs(red_dsd(2 * KB), @set_dsd_length(@increment_dsd_offset(red_dsd(2 * KB), @as(i16, o), f32), 2 * KB)); return; }
  var x: u16 = 0;
  var y: u16 = 0;
  { var k: u16 = 0; while (k < KB) : (k += 1) {
    if (kbefore(red[x], red[KB + x], red[o + y], red[o + KB + y])) {
      red[96 + k] = red[x]; red[96 + KB + k] = red[KB + x]; x += 1;
    } else {
      red[96 + k] = red[o + y]; red[96 + KB + k] = red[o + KB + y]; y += 1;
    }
  } }
  @fmovs(red_dsd(2 * KB), @set_dsd_length(@increment_dsd_offset(red_dsd(2 * KB), 96, f32), 2 * KB));
}
// The k-list fold of red[0..2KB) (`mine`: this PE has an entry in the round);
// returns with the round's list in red everywhere.
noinline fn kfold(mine: bool) void {
  const n2 = 2 * KB;
  const inb = @set_dsd_length(@increment_dsd_offset(red_dsd(n2), 64, f32), n2);
  if (!hub and !mine) {
    if (col_end) {
      { var k: u16 = 0; while (k < KB) : (k += 1) { red[k] = NEG_INF; red[KB + k] = 3.0e38; } }
      @fmovs(fab_out(q3_out, n2), red_dsd(n2));
    } else {
      @fmovs(fab_out(q3_out, n2), fab_in(q4_in, n2));
    }
  } else {
    if (hub or !col_end) { @fmovs(inb, fab_in(q4_in, n2)); kmerge(64); }
    if (hub) {
      @fmovs(inb, fab_in(q5_in, n2));
      kmerge(64);
      if (!hub_first) { @fmovs(inb, fab_in(q6_in, n2)); kmerge(64); }
    }
    @fmovs(fab_out(q3_out, n2), red_dsd(n2));
  }
  if (!hub or !hub_last) { @fmovs(red_dsd(n2), fab_in(q7_in, n2)); }
}
// This PE's entries of register a in eta's order (NaN left out) into kord;
// their count. kneg: whether any is negative.
var kneg: f32 = 0.0;
noinline fn ksort(oa: u16, m: u16) u16 {
  kneg = 0.0;
  var n: u16 = 0;
  { var i: u16 = 0; while (i < m) : (i += 1) {
    const x = wide[oa + i];
    if (x < 0.0) { kneg = 1.0; }
    if (x == x) {
      var j: u16 = n;
      while (j > 0 and x > wide[oa + kord[j - 1]]) : (j -= 1) { kord[j] = kord[j - 1]; }
      kord[j] = i;
      n += 1;
    }
  } }
  return n;
}
// One round: the next KB entries in eta's order into red (values | indices,
// padding index 3e38) on every PE. `first` also folds kneg into red[KB + 1]
// ... returned as kmono.
var kmono = true;
noinline fn kround(oa: u16, lo: u32, pos: u16, n: u16, first: bool) void {
  { var k: u16 = 0; while (k < KB) : (k += 1) { red[k] = if (pos + k < n) wide[oa + kord[pos + k]] else NEG_INF; } }
  red[KB] = kneg;
  lane_fold(K_MAX, if (first) KB + 1 else KB);
  if (first) { kmono = red[KB] == 0.0; }
  const t = red[KB - 1];
  { var k: u16 = 0; while (k < KB) : (k += 1) {
    if (pos + k < n) {
      red[k] = wide[oa + kord[pos + k]];
      red[KB + k] = @as(f32, lo + @as(u32, kord[pos + k]));
    } else {
      red[k] = NEG_INF;
      red[KB + k] = 3.0e38;
    }
  } }
  kfold(pos < n and red[0] >= t);
}
// eta's top_k: the k first entries in eta's order (NaN left out, as before),
// values (f32) at pool[dv..], indices at pool[di..].
noinline fn topk_rounds(dv: u32, a: u32, di: u32, k: u32) void {
  const m = nloc();
  const lo = lane_base();
  const oa = @as(u16, a) * Vt;
  const n = ksort(oa, m);
  var pos: u16 = 0;
  var got: u32 = 0;
  var first = true;
  while (got < k) {
    kround(oa, lo, pos, n, first);
    first = false;
    { var j: u16 = 0; while (j < KB and got < k) : (j += 1) {
      if (red[KB + j] >= 3.0e38) { break; }
      setf(dv + got, red[j]);
      pool[@as(u16, di + got)] = @as(u32, red[KB + j]);
      const at = @as(u32, red[KB + j]);
      if (at >= lo and at < lo + @as(u32, m)) { pos += 1; }
      got += 1;
    } }
    if (red[2 * KB - 1] >= 3.0e38) { break; }
  }
}
// vm_topk 1: eta's top_k by radix select. The k-th entry of eta's order
// (value descending, -0 == +0, ties by index ascending, NaN left out) is found
// digit by digit (4 bits, most significant first) on an order key of the
// value, then (ties at the k-th value only) on the inverted index: each digit
// a 16-bin count fold. Each entry's class (kord: 0 out, 1 in the bucket being
// resolved, 2 taken) narrows pass by pass. The selection (exactly
// min(k, entries)) is then concatenated hop by hop to the last hub ([count |
// value, index pairs]), sorted there in eta's order and sent back (K): every
// PE writes it out.
const RADIX: bool = vm_topk != 0;
fn rx_key(x: f32) u32 {
  const b: u32 = if (x == 0.0) 0 else @bitcast(u32, x);
  return if ((b & 0x80000000) != 0) ~b else (b | 0x80000000);
}
// digit sh (a multiple of 4) of the value key (ph 0) or of the inverted index
noinline fn rx_dig(ph: u16, x: f32, g: u32, sh: u16) u16 {
  const key: u32 = if (ph == 0) rx_key(x) else 0xfffff - g;
  const half: u16 = if (sh >= 16) @as(u16, key >> 16) else @as(u16, key & 0xffff);
  const s4: u16 = if (sh >= 16) sh - 16 else sh;
  return (half >> s4) & 15;
}
var rx_oa: u16 = 0;
var rx_lo: u32 = 0;
var rx_m: u16 = 0;
// One pass over this PE's entries in the bucket (kord 1): dg 16 counts their
// digit sh into red[0..16); else narrows them to digit dg (above 2, below 0).
noinline fn rx_scan(ph: u16, sh: u16, dg: u16) void {
  if (dg == 16) { @fmovs(red_dsd(16), 0.0); }
  { var i: u16 = 0; while (i < rx_m) : (i += 1) {
    if (kord[i] == 1) {
      const d = rx_dig(ph, wide[rx_oa + i], rx_lo + @as(u32, i), sh);
      if (dg == 16) { red[d] += 1.0; } else { kord[i] = if (d > dg) 2 else if (d == dg) 1 else 0; }
    }
  } }
}
noinline fn rx_fold16() void { lane_fold(K_SUM, 16); }
var rx_cnt = @zeros([1]u32);
const rx_cnt_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> rx_cnt[i] });
fn rx_at(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(red_dsd(RB), @as(i16, o), f32), n); }
// [count | value, index pairs] from queue q into red at o (raw words); the count
fn rx_take(comptime q: input_queue, o: u16) u16 {
  @mov32(rx_cnt_dsd, fab_in(q, 1));
  const n = @as(u16, rx_cnt[0]);
  if (n > 0) { @mov32(rx_at(o, 2 * n), fab_in(q, 2 * n)); }
  return n;
}
noinline fn rx_send(n: u16) void {
  rx_cnt[0] = n;
  @mov32(fab_out(q3_out, 1), rx_cnt_dsd);
  if (n > 0) { @mov32(fab_out(q3_out, 2 * n), red_dsd(2 * n)); }
}
fn rx_ix(j: u16) u32 { return @bitcast(u32, red[2 * j + 1]); }
// Shell sort of the n pairs in red (eta's order; the keys are distinct).
noinline fn rx_sort(n: u16) void {
  var gap: u16 = 40;
  while (true) {
    var i: u16 = gap;
    while (i < n) : (i += 1) {
      const v = red[2 * i];
      const x = rx_ix(i);
      var j: u16 = i;
      while (j >= gap and (red[2 * (j - gap)] < v or (red[2 * (j - gap)] == v and rx_ix(j - gap) > x))) : (j -= gap) {
        red[2 * j] = red[2 * (j - gap)];
        red[2 * j + 1] = red[2 * (j - gap) + 1];
      }
      red[2 * j] = v;
      red[2 * j + 1] = @bitcast(f32, x);
    }
    if (gap == 1) { break; }
    gap = (gap - 1) / 3;
  }
}
// One window: the next w entries of eta's order among those not yet out
// (kord 4), selected, gathered and sorted (rx_gather); their count.
noinline fn rx_window(w: f32) u16 {
  { var i: u16 = 0; while (i < rx_m) : (i += 1) {
    const x = wide[rx_oa + i];
    kord[i] = if (kord[i] == 4) 4 else if (x == x) 1 else 0;
  } }
  var ph: u16 = 0;
  var need: f32 = w;
  var first = true;
  var sh: u16 = 28;
  while (true) {
    rx_scan(ph, sh, 16);
    rx_fold16();
    if (first) {
      first = false;
      var tot: f32 = 0.0;
      { var b: u16 = 0; while (b < 16) : (b += 1) { tot += red[b]; } }
      if (w >= tot) { break; }   // every entry left is taken
    }
    var dg: u16 = 15;
    while (red[dg] < need) : (dg -= 1) { need -= red[dg]; }
    const c = red[dg];
    rx_scan(ph, sh, dg);
    if (c == need or (ph == 1 and sh == 0)) { break; }   // the whole bucket is taken
    if (sh == 0) {
      // ties at the w-th value: the same on the inverted index (distinct)
      ph = 1; sh = 16;
    } else {
      sh -= 4;
    }
  }
  return rx_gather();
}
// eta's top_k: windows of at most RB / 2 entries (one, for k <= 128).
noinline fn topk_radix(dv: u32, a: u32, di: u32, k: u32) void {
  rx_oa = @as(u16, a) * Vt; rx_lo = lane_base(); rx_m = nloc();
  { var i: u16 = 0; while (i < rx_m) : (i += 1) { kord[i] = 0; } }
  var got: u32 = 0;
  while (got < k) {
    const W: u32 = if (vm_rxw != 0 and vm_rxw < RB / 2) vm_rxw else RB / 2;
    const w: u32 = if (k - got < W) k - got else W;
    const n = rx_window(@as(f32, w));
    { var j: u16 = 0; while (j < n) : (j += 1) {
      setf(dv + got, red[2 * j]);
      pool[@as(u16, di + got)] = rx_ix(j);
      got += 1;
    } }
    if (@as(u32, n) < w) { break; }
  }
}
// This PE's selection as pairs, concatenated to the last hub, sorted there,
// sent back: the pair count (every PE).
noinline fn rx_gather() u16 {
  var mine: u16 = 0;
  { var i: u16 = 0; while (i < rx_m) : (i += 1) {
    if (kord[i] == 1 or kord[i] == 2) {
      kord[i] = 4;
      red[2 * mine] = wide[rx_oa + i];
      red[2 * mine + 1] = @bitcast(f32, rx_lo + @as(u32, i));
      mine += 1;
    }
  } }
  var n: u16 = 0;
  if (!hub) {
    var nin: u16 = 0;
    if (!col_end) { @mov32(rx_cnt_dsd, fab_in(q4_in, 1)); nin = @as(u16, rx_cnt[0]); }
    rx_cnt[0] = nin + mine;
    @mov32(fab_out(q3_out, 1), rx_cnt_dsd);
    if (nin > 0) { @mov32(fab_out(q3_out, 2 * nin), fab_in(q4_in, 2 * nin)); }
    if (mine > 0) { @mov32(fab_out(q3_out, 2 * mine), red_dsd(2 * mine)); }
  } else {
    n = rx_take(q4_in, 0);
    n += rx_take(q5_in, 2 * n);
    if (SPLIT) { n += rx_take(q3_in, 2 * n); n += rx_take(q2_in, 2 * n); }
    if (!hub_first) { n += rx_take(q6_in, 2 * n); }
    if (hub_last) { rx_sort(n); }
    rx_send(n);
  }
  if (!hub or !hub_last) { n = rx_take(q7_in, 0); }
  return n;
}
noinline fn pivmass_walk(d: u32, a: u32, p: f32) void {
  const m = nloc();
  const lo = lane_base();
  const od = @as(u16, d) * Vt;
  const oa = @as(u16, a) * Vt;
  @fmovs(reg(d), 0.0);
  if (!(p > 0.0)) { return; }
  const n = ksort(oa, m);
  var first = true;
  var excl: f32 = 0.0;
  var pos: u16 = 0;
  while (true) {
    kround(oa, lo, pos, n, first);
    first = false;
    if (red[KB] >= 3.0e38) { break; }
    { var k: u16 = 0; while (k < KB) : (k += 1) {
      if (red[KB + k] >= 3.0e38) { break; }
      const v = red[k];
      const at = @as(u32, red[KB + k]);
      if (at >= lo and at < lo + @as(u32, m)) {
        wide[od + @as(u16, at - lo)] = if (excl < p) 1.0 else 0.0;
        pos += 1;
      }
      excl = excl + v;
      if (kmono and !(excl < p)) { return; }
    } }
    if (red[2 * KB - 1] >= 3.0e38) { break; }
  }
  // NaN entries come last: the first (lowest index) is kept if the sum is
  // still below p; the sum is NaN after it.
  if (!(excl < p)) { return; }
  var ni: f32 = -3.0e38;
  { var i: u16 = 0; while (i < m) : (i += 1) {
    if (wide[oa + i] != wide[oa + i]) { const f = -@as(f32, lo + @as(u32, i)); if (f > ni) { ni = f; } }
  } }
  red[0] = ni;
  lane_fold(K_MAX, 1);
  if (red[0] > -3.0e38) {
    const at = @as(u32, -red[0]);
    if (at >= lo and at < lo + @as(u32, m)) { wide[od + @as(u16, at - lo)] = 1.0; }
  }
}

fn exec() void {
  while (true) {
    prof_mark();
    const base = pc * 4;
    const w0 = ops[base];
    const op = @bitcast(i32, w0 & 0xff);
    const fl = w0 >> 8;
    const d = ops[base + 1] & 0xffff;
    const a = ops[base + 1] >> 16;
    const b = ops[base + 2];
    const c = ops[base + 3];
    const t = fl & 3;
    const ab = (fl & 4) != 0;
    const bb = (fl & 8) != 0;
    const cb = (fl & 16) != 0;
    const n = @as(u16, fl >> 8);
    pc += 1;
    if (LAZY and lz_reg[cur_lane] != 0 and op != HALT and op != WRNG) {
      const L = lz_reg[cur_lane] - 1;
      if (op == WBIN and !ab and !bb and c <= 1 and (a == @as(u32, L)) != (b == @as(u32, L))) {
        lz_binop(d, a, b, c, L);
        continue;
      }
      // the op's wide-register fields (the rest are pool words or immediates)
      const wop = op < 20 or op == QGATHER or op == QSCATTER;
      const hd = wop and lz_hits(L, d, n);
      const ha = wop and !ab and op != WFILL and lz_hits(L, a, n);
      const hb = (op == WBIN or op == WCMP or op == WSEL) and !bb and lz_hits(L, b, n);
      const hc = op == WSEL and lz_hits(L, c, n);
      if (hd or ha or hb or hc) { lz_fill(); }
    }
    if (op == HALT) {
      prof_pc = 0xffff;
      finish();
      return;
    } else if ((OPK_WBIN and op == WBIN)) {
      if (!ab and !bb and c <= 2) {
        if (c == 0) { @fadds(reg(d), reg(a), reg(b)); }
        else if (c == 1) { @fsubs(reg(d), reg(a), reg(b)); }
        else { @fmuls(reg(d), reg(a), reg(b)); }
      } else if (!ab and bb and c == 3) {
        vdiv(d, a, pf(b));
      } else if (!ab and (c == 4 or c == 5) and (!bb or vminmax_ok(pf(b)))) {
        vminmax(d, a, b, bb, c == 5);
      } else if (!ab and bb and c <= 2) {
        const s = pf(b);
        if (c == 0) { @fadds(reg(d), reg(a), s); }
        else if (c == 1) { @fsubs(reg(d), reg(a), s); }
        else { @fmuls(reg(d), reg(a), s); }
      } else {
        { var i: u16 = 0; while (i < Vt) : (i += 1) {
          wide[@as(u16, d) * Vt + i] = binf(c, wide_or_scalar(a, ab, i), wide_or_scalar(b, bb, i));
        } }
      }
    } else if ((feat & F_WMATH) != 0 and ((OPK_WCMP and op == WCMP))) {
      { var i: u16 = 0; while (i < Vt) : (i += 1) {
        const hit = cmpf(c, wide_or_scalar(a, ab, i), wide_or_scalar(b, bb, i));
        wide[@as(u16, d) * Vt + i] = if (hit) 1.0 else 0.0;
      } }
    } else if ((feat & F_WMATH) != 0 and ((OPK_WUN and op == WUN))) {
      if (c == 0) {
        @fnegs(reg(d), reg(a));
      } else if (c == 2 and d != a) {
        vexp(d, a);
      } else {
        { var i: u16 = 0; while (i < Vt) : (i += 1) { wide[@as(u16, d) * Vt + i] = unf(c, wv(a, i)); } }
      }
    } else if ((OPK_WSEL and op == WSEL) and !ab) {
      // the sampler tails' select (a register, or else a register or a scalar)
      const od = @as(u16, d) * Vt;
      const oa = @as(u16, a) * Vt;
      const oc = @as(u16, c) * Vt;
      const ob = @as(u16, b) * Vt;
      const ys = pf(b);
      { var i: u16 = 0; while (i < Vt) : (i += 1) {
        wide[od + i] = if (wide[oc + i] != 0.0) wide[oa + i] else (if (bb) ys else wide[ob + i]);
      } }
    } else if ((OPK_WSEL and op == WSEL)) {
      { var i: u16 = 0; while (i < Vt) : (i += 1) {
        const x = wide_or_scalar(a, ab, i);
        const y = wide_or_scalar(b, bb, i);
        wide[@as(u16, d) * Vt + i] = if (wv(c, i) != 0.0) x else y;
      } }
    } else if ((OPK_WFILL and op == WFILL)) {
      @fmovs(reg(d), pf(a));
    } else if ((OPK_WIOTA and op == WIOTA)) {
      { var i: u16 = 0; while (i < Vt) : (i += 1) { wide[@as(u16, d) * Vt + i] = @as(f32, lane_base() + @as(u32, i)); } }
    } else if ((feat & F_RNG) != 0 and LAZY and OPK_WRNG and op == WRNG) {
      var z: u64 = seed_of(a, cb);
      const j1: u64 = @as(u64, lane_base()) + @as(u64, b) + 1;
      lz_z[cur_lane] = z + LANE_STRIDE * j1;
      lz_reg[cur_lane] = @as(u16, d) + 1;
      lz_g[cur_lane] = if (c != 0) 1 else 0;
    } else if ((feat & F_RNG) != 0 and ((OPK_WRNG and op == WRNG))) {
      var z: u64 = seed_of(a, cb);
      // b: the index of the row's first entry (a multi-row draw: row r at r·vocab).
      var j1: u64 = @as(u64, lane_base()) + @as(u64, b) + 1;
      z = z + LANE_STRIDE * j1;
      { var i: u16 = 0; while (i < Vt) : (i += 1) {
        wide[@as(u16, d) * Vt + i] = draw(z, c != 0);
        z = z + LANE_STRIDE;
      } }
    } else if ((OPK_WMOV and op == WMOV)) {
      @fmovs(reg(d), reg(a));
    } else if ((feat & F_RED) != 0 and ((OPK_RRED and op == RRED))) {
      pend = op; pend_d = d; pend_c = c; pend_a = a;
      const m = nloc();
      if (c == 0) {
        // This PE's canonical blocks (level 1), then the lane's,
        // concatenated by sum folds CH blocks at a time.
        // Each block's 32-lane tree (offsets 16, 8, 4, 2, 1: lane l += lane
        // l + off), as vector adds over a copy with the padding zeroed.
        @fmovs(tmp0, reg(a));
        { var i: u16 = m; while (i < Vt) : (i += 1) { tmp[i] = 0.0; } }
        { var blk: u16 = 0; while (blk < Vt / 32) : (blk += 1) {
          var off: u16 = 16;
          while (off > 0) {
            const lo = @set_dsd_length(@increment_dsd_offset(tmp0, @as(i16, blk * 32), f32), off);
            const hi = @increment_dsd_offset(lo, @as(i16, off), f32);
            @fadds(lo, lo, hi);
            off = off / 2;
          }
          myblk[blk] = tmp[blk * 32];
        } }
        chunk = 0;
        if (SUMROWS) { sum_rows(); } else if (SUMCAT) { sum_cat(); } else if (SUMPIPE) { sum_pipe(); } else { sum_chunk(); }
      } else if (c == 1 or c == 2) {
        // max; min as -max(-x). Padding: the identity.
        var acc: f32 = NEG_INF;
        { var i: u16 = 0; while (i < Vt) : (i += 1) {
          if (i < m) {
            const v = if (c == 1) wv(a, i) else -wv(a, i);
            if (v > acc) { acc = v; }
          }
        } }
        red[0] = acc;
        lane_fold(K_MAX, 1);
      } else {
        // argmax: the max, then the lowest index holding it (NaN skipped).
        var acc: f32 = NEG_INF;
        var at: u16 = 0xffff;
        { var i: u16 = 0; while (i < Vt) : (i += 1) {
          if (i < m) {
            const v = wv(a, i);
            if (v == v and (at == 0xffff or v > acc)) { acc = v; at = i; }
          }
        } }
        keep_v = acc;
        keep_i = if (at == 0xffff) 3.0e38 else @as(f32, lane_base() + @as(u32, at));
        red[0] = if (at == 0xffff) -3.4e38 else acc;
        phase = 1;
        lane_fold(K_MAX, 1);
      }
      while (!resume_body()) {}
      continue;
    } else if ((feat & F_GS) != 0 and ((OPK_WGATHER and op == WGATHER))) {
      // Each index's owner contributes its value, the rest -inf: a max fold.
      pend = op; pend_d = d; pend_b = b; pend_fl = fl;
      if (t != T_F32) {
        // integer indices in u32 (a negative i32 wraps past every lane): no i64
        const lo32 = lane_base();
        const m32 = @as(u32, nloc());
        const oa = @as(u16, a) * Vt;
        { var k: u16 = 0; while (k < n) : (k += 1) {
          const off = pool[@as(u16, b) + k] - lo32;
          red[k] = if (off < m32) wide[oa + @as(u16, off)] else NEG_INF;
        } }
      } else {
      { var k: u16 = 0; while (k < 128) : (k += 1) {
        if (k < n) {
          const ix = as_i64(pool[@as(u16, b) + k], t);
          const lo = @as(i64, lane_base());
          red[k] = if (ix >= lo and ix < lo + @as(i64, nloc())) wv(a, @as(u16, ix - lo)) else NEG_INF;
        }
      } }
      }
      lane_fold(K_MAX, n);
      while (!resume_body()) {}
      continue;
    } else if ((feat & F_GS) != 0 and ((OPK_WSCATTER and op == WSCATTER))) {
      // In place on the owners (no fold): W[d][idx[k]] (+)= val[k].
      if (t != T_F32) {
        const lo32 = lane_base();
        const m32 = @as(u32, nloc());
        const od = @as(u16, d) * Vt;
        { var k: u16 = 0; while (k < n) : (k += 1) {
          const off = pool[@as(u16, a) + k] - lo32;
          if (off < m32) {
            const v = pf(if (ab) b else b + k);
            const at = od + @as(u16, off);
            wide[at] = if (bb) wide[at] + v else v;
          }
        } }
      } else
      { var k: u16 = 0; while (k < 128) : (k += 1) {
        if (k < n) {
          const ix = as_i64(pool[@as(u16, a) + k], t);
          const lo = @as(i64, lane_base());
          if (ix >= lo and ix < lo + @as(i64, nloc())) {
            const v = pf(if (ab) b else b + k);
            const at = @as(u16, d) * Vt + @as(u16, ix - lo);
            wide[at] = if (bb) wide[at] + v else v;
          }
        }
      } }
    } else if ((feat & F_PMASS) != 0 and PWALK and OPK_PIVMASS and op == PIVMASS) {
      pivmass_walk(d, a, pf(b));
    } else if ((feat & F_PMASS) != 0 and !PWALK and (OPK_PIVMASS and op == PIVMASS)) {
      // Top-p: a radix estimate of the threshold by probability mass (two
      // rounds of a 256-bin mass histogram), then eta's exact sequential
      // pass over the entries at or above it, in list rounds (most PEs hold
      // none); past them, if the mass is not reached, the plain rounds.
      pend = op; pend_d = d; pend_a = a; pend_b = b; pend_c = c;
      cur_set = false;
      excl = 0.0;
      keep_any = false;
      const p = pf(b);
      if (!(p > 0.0)) {
        @fmovs(reg(d), 0.0);   // keep nothing (eta: p <= 0 or NaN)
        continue;
      }
      rank_keys(a);
      lb = if (LBX < 16) LBX else 16;   // top-p keeps few on peaked rows: short rounds
      mx_phase = 0;
      rx_round = 0;
      rx_prefix = 0;
      mx_target = p * 1.001;
          mass_hist(a);
      while (!resume_body()) {}
      continue;
    } else if ((feat & F_LIST) != 0 and PWALK and OPK_TOPK and op == TOPK) {
      if (c > 0 and RADIX) { topk_radix(d, a, b, c); } else if (c > 0 and !RADIX) { topk_rounds(d, a, b, c); }
    } else if ((feat & F_LIST) != 0 and !PWALK and (OPK_TOPK and op == TOPK)) {
      // The k largest in eta's order: two rounds of a 256-bin count
      // histogram give a key floor with at least k entries above it, then
      // list rounds over those (most PEs hold none).
      pend = op; pend_d = d; pend_a = a; pend_b = b; pend_c = c;
      if (c == 0) { continue; }
      cur_set = false;
      got = 0;
      rank_keys(a);
      rank_k = c;
      // the row lanes' engine moves LB-pair lists; the head's stream takes k
      lb = if (LBX == LB) LB else (if (c < @as(u32, LBX)) @as(u16, c) else LBX);
      if (lb < 1) { lb = 1; }
      rx_round = 0;
      rx_prefix = 0;
      tk_phase = 0;
          rank_hist();
      while (!resume_body()) {}
      continue;
    } else if ((feat & F_RANK) != 0 and ((OPK_PIVRANK and op == PIVRANK))) {
      pend = op; pend_d = d; pend_a = a;
      // k in u32 (no i64 -> f32 conversion: the rank path hung on hardware
      // in 0084/0092 and is the one place that had one).
      const kw = pool[@as(u16, b)];
      var kk: u32 = kw;
      if (t == T_I32 and @bitcast(i32, kw) < 0) { kk = 0; }
      if (t == T_F32) { const kf = @bitcast(f32, kw); kk = if (kf > 0.0) @as(u32, kf) else 0; }
      if (kk == 0) { @fmovs(reg(d), 0.0); continue; }
      // The k-th largest order key by radix select: four rounds of a
      // 256-bin count histogram of the next key byte (a sum fold each),
      // no sort or merge. (A 32-step bisection of count folds hung on
      // hardware: 0084.)
      rank_k = kk;
      rx_round = 0;
      rx_prefix = 0;
      rank_keys(a);
      rank_hist();
      while (!resume_body()) {}
      continue;
    } else if ((feat & F_QARITH) != 0 and ((OPK_QBIN and op == QBIN))) {
      var k: u16 = 0;
        while (k < n) : (k += 1) {
        const x = pool[@as(u16, if (ab) a else a + k)];
        const y = pool[@as(u16, if (bb) b else b + k)];
        pool[@as(u16, d) + k] = if (t == T_F32) @bitcast(u32, binf(c, @bitcast(f32, x), @bitcast(f32, y))) else bini(c, x, y, t);
      }
    } else if ((feat & F_QARITH) != 0 and ((OPK_QCMP and op == QCMP))) {
      var k: u16 = 0;
        while (k < n) : (k += 1) {
        const x = pool[@as(u16, if (ab) a else a + k)];
        const y = pool[@as(u16, if (bb) b else b + k)];
        const hit = if (t == T_F32) cmpf(c, @bitcast(f32, x), @bitcast(f32, y)) else cmpi(c, as_i64(x, t), as_i64(y, t));
        pool[@as(u16, d) + k] = if (hit) 1 else 0;
      }
    } else if ((feat & F_QARITH) != 0 and ((OPK_QUN and op == QUN))) {
      var k: u16 = 0;
        while (k < n) : (k += 1) {
        const x = pool[@as(u16, if (ab) a else a + k)];
        var r: u32 = 0;
        if (c >= 16) {
          r = cast(x, t, c - 16);
        } else if (t == T_F32) {
          r = @bitcast(u32, unf(c, @bitcast(f32, x)));
        } else if (c == 0) {
          r = 0 - x;
        } else if (c == 1) {
          r = if (t == T_I32 and @bitcast(i32, x) < 0 and x != 0x80000000) 0 - x else x;
        } else if (c == 5) {
          r = if (x == 0) 1 else 0;
        } else {
          r = x;
        }
        pool[@as(u16, d) + k] = r;
      }
    } else if ((feat & F_QARITH) != 0 and ((OPK_QSEL and op == QSEL))) {
      var k: u16 = 0;
        while (k < n) : (k += 1) {
        const cond = pool[@as(u16, if (cb) c else c + k)] != 0;
        pool[@as(u16, d) + k] = if (cond) pool[@as(u16, if (ab) a else a + k)] else pool[@as(u16, if (bb) b else b + k)];
      }
    } else if ((feat & F_QMEM) != 0 and ((OPK_QIOTA and op == QIOTA))) {
      { var k: u16 = 0; while (k < n) : (k += 1) { pool[@as(u16, d) + k] = @as(u32, k); } }
    } else if ((feat & F_QMEM) != 0 and ((OPK_QCONST and op == QCONST))) {
      { var k: u16 = 0; while (k < n) : (k += 1) { pool[@as(u16, d) + k] = c; } }
    } else if ((feat & F_QMEM) != 0 and ((OPK_QMOV and op == QMOV))) {
      // Through tmp: the source and destination may overlap.
      { var k: u16 = 0; while (k < n) : (k += 1) { red[k] = @bitcast(f32, pool[@as(u16, if (ab) a else a + k)]); } }
      { var k: u16 = 0; while (k < n) : (k += 1) { pool[@as(u16, d) + k] = @bitcast(u32, red[k]); } }
    } else if ((feat & F_QMEM) != 0 and ((OPK_QGATHER and op == QGATHER))) {
      var k: u16 = 0;
        while (k < n) : (k += 1) {
        const ix = as_i64(pool[@as(u16, b) + k], t);
        red[k] = @bitcast(f32, if (ix >= 0 and ix < @as(i64, c)) pool[@as(u16, a) + @as(u16, ix)] else 0);
      }
      { var k: u16 = 0; while (k < n) : (k += 1) { pool[@as(u16, d) + k] = @bitcast(u32, red[k]); } }
    } else if ((feat & F_QMEM) != 0 and ((OPK_QSCATTER and op == QSCATTER))) {
      // d in place; a the indices (i32/u32 by fl), b the values (f32 adds
      // when the target is f32: fl bit 4).
      var k: u16 = 0;
        while (k < n) : (k += 1) {
        const ix = as_i64(pool[@as(u16, a) + k], t);
        if (ix >= 0 and ix < @as(i64, c)) {
          const v = pool[@as(u16, if (ab) b else b + k)];
          const at = @as(u16, d) + @as(u16, ix);
          if (bb) {
            pool[at] = if (cb) @bitcast(u32, @bitcast(f32, pool[at]) + @bitcast(f32, v)) else pool[at] + v;
          } else {
            pool[at] = v;
          }
        }
      }
    } else if ((feat & F_QMEM) != 0 and ((OPK_QCUM and op == QCUM))) {
      var acc: f32 = if (c == 0) 0.0 else 1.0;
      var k: u16 = 0;
        while (k < n) : (k += 1) {
        const x = pf(a + k);
        acc = if (c == 0) acc + x else acc * x;
        setf(d + k, acc);
      }
    } else if ((feat & F_QRED) != 0 and ((OPK_QRED and op == QRED))) {
      var r: u32 = 0;
      if (c == 0) {
        if (t == T_F32) {
          { var k: u16 = 0; while (k < n) : (k += 1) { red[k] = pf(a + k); } }
          r = @bitcast(u32, canon_sum(n));
        } else {
          r = canon_isum(@as(u16, a), n);
        }
      } else if (c == 3) {
        var at: u32 = 0;
        var have = false;
        var k: u16 = 0;
          while (k < n) : (k += 1) {
          const x = pool[@as(u16, a) + k];
          var better = false;
          if (t == T_F32) {
            const v = @bitcast(f32, x);
            better = v == v and (!have or v > @bitcast(f32, pool[@as(u16, a) + @as(u16, at)]));
          } else {
            better = !have or as_i64(x, t) > as_i64(pool[@as(u16, a) + @as(u16, at)], t);
          }
          if (better) { at = @as(u32, k); have = true; }
        }
        r = at;
      } else {
        // max / min: eta's identities (-inf / inf; i64 extremes).
        r = pool[@as(u16, a)];
        var k: u16 = 0;
          while (k < n) : (k += 1) {
          if (k == 0) { continue; }
          const x = pool[@as(u16, a) + k];
          if (t == T_F32) {
            const v = @bitcast(f32, x);
            const w = @bitcast(f32, r);
            if (c == 1 and (v > w or w != w)) { r = x; }
            if (c == 2 and (v < w or w != w)) { r = x; }
          } else {
            const v = as_i64(x, t);
            const w = as_i64(r, t);
            if ((c == 1 and v > w) or (c == 2 and v < w)) { r = x; }
          }
        }
      }
      pool[@as(u16, d)] = r;
    } else if ((feat & F_RNG) != 0 and ((OPK_QRNG and op == QRNG))) {
      const s = seed_of(a, cb);
      var k: u16 = 0;
        while (k < n) : (k += 1) {
        var j1: u64 = @as(u64, k) + @as(u64, b) + 1;
        setf(d + k, draw(s + LANE_STRIDE * j1, c != 0));
      }
    } else if ((OPK_OUT and op == OUT)) {
      const row = @as(u16, ostep[0] % @as(u32, RING)) * RW;
      { var k: u16 = 0; while (k < RW) : (k += 1) { if (k < n) { out[row + @as(u16, d) + k] = pool[@as(u16, a) + k]; } } }
    }
  }
}

// A fold's result is in red on every PE of the lane: finish its op.
fn resume_body() bool {
  if ((feat & F_RED) != 0 and (OPK_RRED and pend == RRED)) {
    if (pend_c == 0 and SUMPIPE) {
      setf(pend_d, red[0]);
    } else if (!SUMPIPE and pend_c == 0) {
      // Level 2 of this chunk's blocks (groups of 32), then the next chunk.
      const lo = chunk * CH;
      const n = if (nblk - lo < CH) nblk - lo else CH;
      // The groups' 32-lane trees in place (vector adds; the last group's
      // missing lanes are the identity 0).
      { var z: u16 = n; while (z % 32 != 0) : (z += 1) { red[z] = 0.0; } }
      var g: u16 = 0;
      while (g * 32 < n) : (g += 1) {
        var off: u16 = 16;
        while (off > 0) {
          const glo = @set_dsd_length(@increment_dsd_offset(red_dsd(RB), @as(i16, g * 32), f32), off);
          const ghi = @increment_dsd_offset(glo, @as(i16, off), f32);
          @fadds(glo, glo, ghi);
          off = off / 2;
        }
        l2[lo / 32 + g] = red[g * 32];
      }
      if (lo + n < nblk) {
        chunk += 1;
        sum_chunk();
        return false;
      }
      const n2 = (nblk + 31) / 32;
      { var k: u16 = 0; while (k < L2N) : (k += 1) { if (k < n2) { red[k] = l2[k]; } } }
      setf(pend_d, canon_sum(n2));
    } else if (pend_c == 1) {
      setf(pend_d, red[0]);
    } else if (pend_c == 2) {
      setf(pend_d, -red[0]);
    } else if (phase == 1) {
      // The max is known: the lowest index holding it, as max(-index).
      phase = 2;
      red[0] = if (keep_v == red[0] and keep_i < 3.0e38) -keep_i else -3.4e38;
      lane_fold(K_MAX, 1);
      return false;
    } else {
      // No candidate at all (every entry NaN): index 0, as eta.
      pool[@as(u16, pend_d)] = if (red[0] <= -3.0e38) 0 else @as(u32, -red[0]);
    }
  } else if ((feat & F_GS) != 0 and (OPK_WGATHER and pend == WGATHER)) {
    const n = @as(u16, pend_fl >> 8);
    if ((pend_fl & 3) != T_F32) {
      const v32 = valid[0];
      { var k: u16 = 0; while (k < n) : (k += 1) {
        // a negative i32 index wraps to >= valid
        setf(pend_d + k, if (pool[@as(u16, pend_b) + k] < v32) red[k] else 0.0);
      } }
    } else {
    { var k: u16 = 0; while (k < 128) : (k += 1) {
      if (k < n) {
        const ix = as_i64(pool[@as(u16, pend_b) + k], pend_fl & 3);
        setf(pend_d + k, if (ix >= 0 and ix < @as(i64, valid[0])) red[k] else 0.0);
      }
    } }
    }
  } else if ((feat & F_LIST) != 0 and !PWALK and (OPK_TOPK and pend == TOPK) and tk_phase == 0) {
    var floor: u32 = 1;   // fewer than k: every non-NaN entry
    if (count_pick()) {
      if (rx_round < 2) {
        rank_hist();
        return false;
      }
      floor = rx_prefix << 16;
    }
    tk_phase = 1;
    sort_cand(floor);
    known_fold(pend_a);
    return false;
  } else if ((feat & F_LIST) != 0 and !PWALK and (OPK_TOPK and pend == TOPK)) {
    // The next LB in order: take what the k still wants.
    var k: u16 = 0;
    while (k < lb and got < pend_c) : (k += 1) {
      setf(pend_d + got, red[k]);
      pool[@as(u16, pend_b + got)] = @as(u32, red[lb + k]);
      got += 1;
    }
    if (got < pend_c and red[lb + lb - 1] < 3.0e38) {
      cur_v = red[lb - 1]; cur_i = red[lb + lb - 1]; cur_set = true;
      known_fold(pend_a);
      return false;
    }
    // Fewer entries than k: eta takes k of the sorted row, so k <= vocab.
  } else if ((feat & F_PMASS) != 0 and !PWALK and (OPK_PIVMASS and pend == PIVMASS) and mx_phase == 0) {
    const bin = pick(mx_target);
    const found = bin >= 0;
    var dsel: u32 = 0;
    if (found) { dsel = @as(u32, bin); mx_target -= pick_cum; }
    var floor: u32 = 1;   // every non-NaN entry
    if (found) {
      rx_prefix = (rx_prefix << 8) | dsel;
      rx_round += 1;
      if (rx_round < 2) {
        mass_hist(pend_a);
        return false;
      }
      floor = rx_prefix << 16;
    } else if (rx_round == 1) {
      floor = rx_prefix << 24;   // the first round's bin (the estimate's sums differ)
    }
    mx_phase = 1;
    mass_cand = true;
    sort_cand(floor);
    known_fold(pend_a);
    return false;
  } else if ((feat & F_PMASS) != 0 and !PWALK and (OPK_PIVMASS and pend == PIVMASS)) {
    const p = pf(pend_b);
    var done = false;
    var k: u16 = 0;
    while (k < lb) : (k += 1) {
      if (red[lb + k] >= 3.0e38) { done = true; break; }
      if (!(excl < p)) { done = true; break; }
      keep_v = red[k]; keep_i = red[lb + k]; keep_any = true;
      excl = excl + red[k];
    }
    if (done and mass_cand and excl < p and red[lb + k] >= 3.0e38) {
      // The candidates ran out short of the mass: on over all entries.
      mass_cand = false;
      cur_v = keep_v; cur_i = keep_i; cur_set = keep_any;
      sort_cand(1);
      known_fold(pend_a);
      return false;
    }
    if (!done) {
      cur_v = red[lb - 1]; cur_i = red[lb + lb - 1]; cur_set = true;
      known_fold(pend_a);
      return false;
    }
    // Keep the prefix through the last kept entry.
    const m = nloc();
    { var i: u16 = 0; while (i < Vt) : (i += 1) {
      const v = wv(pend_a, i);
      const gi = @as(f32, lane_base() + @as(u32, i));
      const kept = i < m and keep_any and (v > keep_v or (v == keep_v and gi <= keep_i));
      wide[@as(u16, pend_d) * Vt + i] = if (kept) 1.0 else 0.0;
    } }
  } else if ((feat & F_RANK) != 0 and (OPK_PIVRANK and pend == PIVRANK)) {
    // The bin of the k-th largest key, from the top.
    if (!count_pick()) {
      bis_t = 0;   // fewer than k: keep all
    } else {
      if (rx_round < 4) {
        rank_hist();
        return false;
      }
      bis_t = rx_prefix;
    }
    // bis_t: the k-th largest key (0 when fewer than k entries: keep all).
    const m = nloc();
    { var i: u16 = 0; while (i < Vt) : (i += 1) {
      const v = wv(pend_a, i);
      const kept = i < m and v == v and okey(v) >= bis_t;
      wide[@as(u16, pend_d) * Vt + i] = if (kept) 1.0 else 0.0;
    } }
  }
  return true;
}

// ---- the head contract (head2d_v9) ----
var gmode = @zeros([1]u32);
var gmode_ptr: [*]u32 = &gmode;
// The program's token: the pool word of the EmbedTokens channel's home.
var tok_home = @zeros([1]u32);
var tok_home_ptr: [*]u32 = &tok_home;
var vin = @zeros([Vt + 2]f32);   // the slice, 1/rms, ctl
var vin_ptr: [*]f32 = &vin;
const vin_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Vt} -> vin[i] });
var tokv = @zeros([1]f32);
const tokv_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> tokv[i] });
var dummy = @zeros([32]f32);   // the head's symbols: the host reads up to 32 words of them here (emb, xin, gam: Hc; prof: 16)
var dummy_ptr: [*]f32 = &dummy;
var dummy_u = @zeros([32]u32);
var dummy_u_ptr: [*]u32 = &dummy_u;

fn iq_color(comptime qid: u16, c: u16) void {
  const addr = tile_config.input_queue_config.get_input_queue_config_addr(qid);
  var v: u16 = @get_config(addr, tile_config.input_queue_config.in_queue_addr_range);
  v = (v & 0xffe0) | c;
  @set_config(addr, v, tile_config.input_queue_config.in_queue_addr_range);
}
fn oq_color(comptime qid: u16, c: u16) void {
  // a send completes when its wavelets are in the queue, not out of it:
  // recolor only once the queue has drained (empty mask in the high byte)
  while ((tile_config.output_queue_status.get_raw() & (@as(u16, 0x0100) << qid)) == 0) {}
  const addr = tile_config.output_queue_config.get_output_queue_config_addr(qid);
  var v: u16 = @get_config(addr, tile_config.output_queue_config.out_queue_addr_range);
  v = (v & 0xfe0f) | (c << 4);
  @set_config(addr, v, tile_config.output_queue_config.out_queue_addr_range);
}
fn col_of(c: u16) color { return @get_color(c); }

// head2d_v9's feeder-row routes for a PE between two block roots (its
// route_feeder, the VM column's case).
const RC: u16 = BM * CB + R2X;
fn set_route(k: u16, comptime rx: direction, comptime tx: direction) void {
  if (k == 0) { color_config.reset_routes(c_r2_0, .{ .rx = rx, .tx = tx }); }
  else if (k == 1) { color_config.reset_routes(c_r2_1, .{ .rx = rx, .tx = tx }); }
  else if (k == 2) { color_config.reset_routes(c_r1_0, .{ .rx = rx, .tx = tx }); }
  else { color_config.reset_routes(c_r1_1, .{ .rx = rx, .tx = tx }); }
}
fn hub_feeder_routes() void {
  if (vx > R2X and vx < (NB - 1) * CB + R2X) {
    const bl = (vx - R2X) / CB;
    if (bl / Gb == (bl + 1) / Gb) {
      const r = bl % Gb;
      if (r + 1 <= R1B) {
        if (r % 2 == 0) { set_route(3, WEST, EAST); } else { set_route(2, WEST, EAST); }
      } else {
        if ((r + 1) % 2 == 0) { set_route(2, EAST, WEST); } else { set_route(3, EAST, WEST); }
      }
    }
    if (vx < RC) { set_route(0, WEST, EAST); set_route(1, WEST, EAST); }
    else { set_route(0, EAST, WEST); set_route(1, EAST, WEST); }
  }
}

// The out ring's depth (steps a launch), for the host and the engine.
var gring = @zeros([if (CONC) 4 else 3]u32);
const G_CSTEPS: u16 = if (CONC) 3 else 0;
var gdbg = @zeros([4]u32);   // vm_dbg: rows read, tokens sent, folds, phase
var gdbg_ptr: [*]u32 = &gdbg;   // depth, words a step, lanes
var gring_ptr: [*]u32 = &gring;

fn init() void {
  gring[0] = ring;
  gring[1] = ring_w;
  gring[2] = vm_lanes;
  // vm_outside: the VM block sits outside the head (its first column at
  // fabric x vm_x0, one block): positions as if at R2X + 1 + VJ.
  vx = if (OUTSIDE) layout_mod.get_x_coord() - vm_x0 + R2X + 1 else layout_mod.get_x_coord();
  vy = layout_mod.get_y_coord();
  vblk = vx / CB;
  hub = vy == F;
  vry = if (vy > F) vy - 1 else vy;
  hub_first = vblk == 0 and VJ == 0;
  hub_last = vblk == NB - 1 and VJ == NVC - 1;
  hidx = vblk * NVC + VJ;
  // The head's routes through this column (as head2d_v9's init does for
  // its VM PEs): on region rows its row chains west into the root (our west
  // neighbor) and the root's logits in from the west; on the feeder row the
  // blocks' pair chains through; the winner tree straight through.
  // (vm_outside: none of the head's colors cross the block.)
  if (!hub) {
    if (!OUTSIDE) {
      color_config.reset_routes(c_r1_0, .{ .rx = EAST, .tx = WEST });
      color_config.reset_routes(c_r1_1, .{ .rx = EAST, .tx = WEST });
      color_config.reset_routes(c_r2_0, .{ .rx = EAST, .tx = WEST });
      color_config.reset_routes(c_r2_1, .{ .rx = EAST, .tx = WEST });
    }
    // The root's row (Vr + 1 words) passes every VM column of the block
    // (two sets: both sets' columns; VLAST marks the last).
    if (CONC) {
      // concurrent sets: each set's rows stop at its own last column; B's
      // pass A's columns
      if (VSET == 0) { color_config.reset_routes(col_of(C_VL2), .{ .rx = WEST, .tx = EAST }); }
      if (VJ + 1 < NVC) {
        color_config.reset_routes(col_of(C_VLS), .{ .rx = WEST, .tx = [2]direction{ RAMP, EAST } });
      } else {
        color_config.reset_routes(col_of(C_VLS), .{ .rx = WEST, .tx = RAMP });
      }
    } else if (if (TWO) VLAST == 0 else VJ + 1 < NVC) {
      color_config.reset_routes(col_of(C_VL), .{ .rx = WEST, .tx = [2]direction{ RAMP, EAST } });
    } else {
      color_config.reset_routes(col_of(C_VL), .{ .rx = WEST, .tx = RAMP });
    }
    iq_color(2, C_VLS);
  } else {
    if (!OUTSIDE) { hub_feeder_routes(); }
    // Two sets (one block): set B's tokens go west on C_BT through set A's
    // hubs to A's token sender, which relays each on C_VT (a color takes
    // one input direction on wse3).
    if (TWO and VSET == 0 and vblk == BM and VJ != 0) {
      color_config.reset_routes(col_of(C_BT), .{ .rx = EAST, .tx = WEST });
    }
    if (TWO and VSET == 0 and vblk == BM and VJ == 0) {
      // (vm_conc: on to the final root, which takes B's tokens itself)
      color_config.reset_routes(col_of(C_BT), .{ .rx = EAST, .tx = if (CONC) WEST else RAMP });
    }
    if (TWO and VSET == 1 and vblk == BM and VJ == 0) {
      color_config.reset_routes(col_of(C_BT), .{ .rx = RAMP, .tx = WEST });
      oq_color(2, C_BT);
    } else if (vblk == BM and VJ == 0) {
      color_config.reset_routes(col_of(C_VT), .{ .rx = RAMP, .tx = WEST });
      oq_color(2, C_VT);
    }
  }
  if (!OUTSIDE) {
    if (vx < RC) { color_config.reset_routes(c_ib, .{ .rx = EAST, .tx = WEST }); }
    else { color_config.reset_routes(c_ib, .{ .rx = WEST, .tx = EAST }); }
  }
  // Our folds. Upper half (row r < F): chain south on A/B by row parity;
  // lower half (r > F): chain north on the flipped parity; the hub takes
  // both (their colors differ), then the hubs chain east on E/G by block
  // parity through the head's feeder-row PEs (their routes are the head's
  // init); the result K goes back west and up/down the columns.
  if (SPLIT and vy < F) {
    sp_routes(SOUTH, NORTH, F - 1 - vy, F - 1, 0);
  } else if (SPLIT and vy > F) {
    sp_routes(NORTH, SOUTH, vy - F - 1, H - F - 1, 1);
  } else if (vy < F) {
    const sc = if (vy % 2 == 0) C_A else C_B;
    const rc = if (vy % 2 == 0) C_B else C_A;
    color_config.reset_routes(col_of(sc), .{ .rx = RAMP, .tx = SOUTH });
    oq_color(3, sc);
    col_end = vy == 0;
    if (!col_end) { color_config.reset_routes(col_of(rc), .{ .rx = NORTH, .tx = RAMP }); iq_color(4, rc); }
    if (vy == 0) {
      color_config.reset_routes(col_of(C_K), .{ .rx = SOUTH, .tx = RAMP });
    } else {
      color_config.reset_routes(col_of(C_K), .{ .rx = SOUTH, .tx = [2]direction{ RAMP, NORTH } });
    }
  } else if (vy > F) {
    const sc = if (vy % 2 == 0) C_B else C_A;
    const rc = if (vy % 2 == 0) C_A else C_B;
    color_config.reset_routes(col_of(sc), .{ .rx = RAMP, .tx = NORTH });
    oq_color(3, sc);
    col_end = vy == H;
    if (!col_end) { color_config.reset_routes(col_of(rc), .{ .rx = SOUTH, .tx = RAMP }); iq_color(4, rc); }
    if (vy == H) {
      color_config.reset_routes(col_of(C_K), .{ .rx = NORTH, .tx = RAMP });
    } else {
      color_config.reset_routes(col_of(C_K), .{ .rx = NORTH, .tx = [2]direction{ RAMP, SOUTH } });
    }
  } else {
    // The hub: from the north (row F-1's color), from the south (row F+1's).
    const nc = if (SPLIT) C_A else if ((F - 1) % 2 == 0) C_A else C_B;
    const sc2 = if (SPLIT) C_B else if ((F + 1) % 2 == 0) C_B else C_A;
    if (SPLIT) {
      color_config.reset_routes(col_of(C_A2), .{ .rx = NORTH, .tx = RAMP });
      iq_color(3, C_A2);
      color_config.reset_routes(col_of(C_B2), .{ .rx = SOUTH, .tx = RAMP });
      iq_color(2, C_B2);
    }
    color_config.reset_routes(col_of(nc), .{ .rx = NORTH, .tx = RAMP });
    iq_color(4, nc);
    color_config.reset_routes(col_of(sc2), .{ .rx = SOUTH, .tx = RAMP });
    iq_color(5, sc2);
    const ec = if (hidx % 2 == 0) C_E else C_G;
    const wc = if (hidx % 2 == 0) C_G else C_E;
    if (!hub_first) { color_config.reset_routes(col_of(wc), .{ .rx = WEST, .tx = RAMP }); iq_color(6, wc); }
    if (hub_last) {
      color_config.reset_routes(col_of(C_K), .{ .rx = RAMP, .tx = [3]direction{ WEST, NORTH, SOUTH } });
      oq_color(3, C_K);
    } else {
      color_config.reset_routes(col_of(ec), .{ .rx = RAMP, .tx = EAST });
      oq_color(3, ec);
      if (hub_first) {
        color_config.reset_routes(col_of(C_K), .{ .rx = EAST, .tx = [3]direction{ RAMP, NORTH, SOUTH } });
      } else {
        color_config.reset_routes(col_of(C_K), .{ .rx = EAST, .tx = [4]direction{ RAMP, WEST, NORTH, SOUTH } });
      }
    }
  }
  iq_color(7, C_K);
  // Two input queues on one color would split its wavelets: park the queues
  // this PE does not read on colors nothing routes here.
  if (!hub) { iq_color(5, C_PARK0); iq_color(6, C_PARK1); }
  // vm_sumpipe 2: the row gather of the canonical sum (region rows): VM column
  // j sends its row's blocks so far east on c(j) (out queue 2: the token's
  // queue, idle here) and takes column j - 1's on c(j - 1) (in queue 6).
  if (SUMCAT and !hub) {
    if (VJ + 1 < NVC) {
      color_config.reset_routes(col_of(cat_col(VJ)), .{ .rx = RAMP, .tx = EAST });
      oq_color(2, cat_col(VJ));
    }
    if (VJ > 0) {
      color_config.reset_routes(col_of(cat_col(VJ - 1)), .{ .rx = WEST, .tx = RAMP });
      iq_color(6, cat_col(VJ - 1));
    }
  }
  if (hub and hub_first) { iq_color(6, C_PARK1); }
  if (TWO and !CONC and VSET == 0 and hub and vblk == BM and VJ == 0) { iq_color(6, C_BT); }
  timestamp.enable_tsc();
  sys_mod.unblock_cmd_stream();
}

// The VM's part of `steps` head steps: with gmode 1, per step the root's
// row in (y·1/rms into W0), the main section, the token to the final root
// (block BM's hub), the next step's pre section.
// Per-lane state banks (vm_lanes > 1): a lane's whole pool and its wide
// registers past W0 (the logits row comes in fresh), swapped in before the
// lane's turn and out after its next pre section, so lanes interleave step
// by step: a launch of `steps` runs lane i % vm_lanes at its turn i.
const NL: u16 = vm_lanes;
const BW: u16 = POOL + (NREG - 1) * Vt;
// Per-lane programs (vm_lprog 1): every lane runs its own table out of one op
// arena (gops, max_ops instructions; lanes on the same program share it).
// glane, 4 words a lane: [table base (instructions) | rows a turn << 16, token home (pool word),
// bank offset (words), wide register mask]; gbdesc its pool ranges: the
// lane's own window of the bank arena (bank_words), swapped at its turns.
const LP: bool = vm_lprog != 0;
const BANKN: u16 = if (LP) bank_words else if (NL > 1) NL * BW else 1;
var bank = @zeros([BANKN]u32);
var bank_ptr: [*]u32 = &bank;
var glane = @zeros([if (LP) NL * 4 else 1]u32);
var glane_ptr: [*]u32 = &glane;
var obase: u16 = 0;
var otok: u16 = 0;
const pool_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{POOL} -> pool[i] });
const WREST: u16 = if (NREG > 1) (NREG - 1) * Vt else 1;
const wide_rest = @increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{WREST} -> wide[i] }), @as(i16, Vt), f32);
fn bank_at(at: u16, n: u16) mem1d_dsd {
  return @set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{BANKN} -> bank[i] }), @as(i16, at), u32), n);
}
fn bank_dsd(l: u16, off: u16, n: u16) mem1d_dsd { return bank_at(l * BW + off, n); }
// A lane's window (vm_lprog): only what it carries between turns (what is
// live at the start of its main section, etagen's bank_regs / bank_pool):
// gbdesc's up to 8 pool ranges [offset | words << 16] (0: the end), then the
// wide registers in glane word 3's mask (bit r: W r), packed from glane
// word 2 in that order.
var gbdesc = @zeros([if (LP) NL * 8 else 1]u32);
var gbdesc_ptr: [*]u32 = &gbdesc;
const wide_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NREG * Vt} -> wide[i] });
noinline fn bank_move(l: u16, into: bool) void {
  var at = @as(u16, glane[l * 4 + 2]);
  { var k: u16 = 0; while (k < 8) : (k += 1) {
    const e = gbdesc[l * 8 + k];
    const n = @as(u16, e >> 16);
    if (n == 0) { break; }
    const p = @set_dsd_length(@increment_dsd_offset(pool_all, @as(i16, @as(u16, e & 0xffff)), u32), n);
    if (into) { @mov32(p, bank_at(at, n)); } else { @mov32(bank_at(at, n), p); }
    at += n;
  } }
  const m = glane[l * 4 + 3];
  { var r: u16 = 1; while (r < NREG) : (r += 1) {
    if (((m >> r) & 1) != 0) {
      const w = @set_dsd_length(@increment_dsd_offset(wide_all, @as(i16, r * Vt), f32), Vt);
      if (into) { @mov32(w, bank_at(at, Vt)); } else { @mov32(bank_at(at, Vt), w); }
      at += Vt;
    }
  } }
}
fn swap_in(l: u16) void {
  cur_lane = l;
  if (LP) {
    obase = @as(u16, glane[l * 4] & 0xffff);
    otok = @as(u16, glane[l * 4 + 1]);
    if (NL < 2) { return; }
    bank_move(l, true);
    return;
  }
  if (NL < 2) { return; }
  @mov32(pool_all, bank_dsd(l, 0, POOL));
  if (NREG > 1) { @mov32(wide_rest, bank_dsd(l, POOL, (NREG - 1) * Vt)); }
}
fn swap_out(l: u16) void {
  if (NL < 2) { return; }
  if (LP) {
    bank_move(l, false);
    return;
  }
  @mov32(bank_dsd(l, 0, POOL), pool_all);
  if (NREG > 1) { @mov32(bank_dsd(l, POOL, (NREG - 1) * Vt), wide_rest); }
}

// Per-step host input (CONTRACT.md 6, step input). gsin: SIN words for each
// of the launch's turns (slot t % ring). gsdesc: per lane, 4 entries
// [kind, dst, src | n << 16]: kind 1 puts n mask rows (block words src..,
// bit i of a word = this PE's vocab row i) into W(dst)..W(dst+n-1) as
// 1.0 / 0.0; kind 2 copies n block words into pool[dst..]; kind 0 is none.
// Slot t is put before the pre section that leads into the lane's turn t.
const SIN: u16 = vm_sin;
var gsin = @zeros([if (SIN > 0) ring * SIN else 1]u32);
var gsin_ptr: [*]u32 = &gsin;
var gsdesc = @zeros([if (SIN > 0) NL * 12 else 1]u32);
var gsdesc_ptr: [*]u32 = &gsdesc;
const LAZY: bool = vm_lazyrng != 0;
var cur_lane: u16 = 0;
var lz_reg = @zeros([NL]u16);   // the lazy register + 1 (0: none)
var lz_z = @zeros([NL]u64);     // its entry 0's stream point
var lz_g = @zeros([NL]u16);     // Gumbel
fn lz_hits(L: u16, r: u32, n: u16) bool {
  const lo = @as(u32, L);
  return r <= lo and lo < r + @as(u32, if (n > 1) n else 1);
}
noinline fn lz_fill() void {
  const L = lz_reg[cur_lane] - 1;
  var z = lz_z[cur_lane];
  const g = lz_g[cur_lane] != 0;
  { var i: u16 = 0; while (i < Vt) : (i += 1) {
    wide[L * Vt + i] = draw(z, g);
    z = z + LANE_STRIDE;
  } }
  lz_reg[cur_lane] = 0;
}
noinline fn lz_binop(d: u32, a: u32, b: u32, c: u32, L: u16) void {
  const first = @as(u16, a) == L;
  const o = @as(u16, if (first) b else a) * Vt;
  var z = lz_z[cur_lane];
  const g = lz_g[cur_lane] != 0;
  { var i: u16 = 0; while (i < Vt) : (i += 1) {
    const x = wide[o + i];
    const r = if (x - x == 0.0) draw(z, g) else 1.0;
    wide[@as(u16, d) * Vt + i] = if (first) binf(c, r, x) else binf(c, x, r);
    z = z + LANE_STRIDE;
  } }
  if (@as(u16, d) == L) { lz_reg[cur_lane] = 0; }
}
noinline fn step_in(l: u16, t: u32) void {
  const base = @as(u16, t % @as(u32, ring)) * SIN;
  var e: u16 = 0;
  while (e < 4) : (e += 1) {
    const d = l * 12 + e * 3;
    const kind = gsdesc[d];
    const dst = @as(u16, gsdesc[d + 1]);
    const src = base + @as(u16, gsdesc[d + 2] & 0xffff);
    const n = @as(u16, gsdesc[d + 2] >> 16);
    var k: u16 = 0;
    while (k < n) : (k += 1) {
      if (kind == 1) {
        if (LAZY and lz_reg[l] == dst + k + 1) { lz_reg[l] = 0; }   // overwritten whole
        var w = gsin[src + k];
        const o = (dst + k) * Vt;
        var i: u16 = 0;
        while (i < Vt) : (i += 1) {
          wide[o + i] = if ((w & 1) != 0) @as(f32, 1.0) else @as(f32, 0.0);
          w = w >> 1;
        }
      } else if (kind == 2) {
        pool[dst + k] = gsin[src + k];
      }
    }
  }
}

// A row of the head's into vin (this column's slice, 1/rms, ctl); the hub
// takes none.
fn take_row() void {
  if (hub) { return; }
  { var jj: u16 = 0; while (jj < NVC) : (jj += 1) {
    if (jj == VJ) { @fmovs(vin_dsd, fab_in(q2_in, Vt)); } else { @fmovs(tmp0, fab_in(q2_in, Vt)); }
  } }
  @fmovs(@set_dsd_length(@increment_dsd_offset(vin_dsd, @as(i16, Vt), f32), 2), fab_in(q2_in, 2));
}
// A head step's token (block BM's column-0 hub sends it to the final root).
fn answer(v: f32) void {
  if (hub and vblk == BM and VJ == 0) {
    tokv[0] = v;
    @fmovs(fab_out(q2_out, 1), tokv_dsd);
  }
}

fn compute(steps_arg: u32) void {
  const steps: u32 = if (CONC and gring[G_CSTEPS] != 0) gring[G_CSTEPS] else steps_arg;
  if (gmode[0] == 1) {
    { var l: u16 = 0; while (l < NL and (vm_dbg == 0 or vm_dbg == 3)) : (l += 1) {
      if (LP and (glane[l * 4] >> 16) == 0) { continue; }   // an empty lane: no pre
      gdbg[3] = 10 + @as(u32, l);
      swap_in(l);
      if (SIN > 0) { step_in(l, @as(u32, l)); }
      run_section(0);
      swap_out(l);
    } }
    var i: u32 = 0;
    var turn: u32 = 0;
    var lane: u16 = 0;
    // A turn takes NR head rows (one a head step): rows 0..NR-2 are answered
    // with token 0 at once (the head waits for a token each step), the
    // last row's token is the program's. vm_lprog: NR is the lane's own
    // (glane word 0's high half; 0 means 1), at most vm_rows.
    if (vm_dbg == 1 or vm_dbg == 2) {
      while (i < steps) : (i += 1) {
        gdbg[3] = 1;
        take_row();
        gdbg[0] += 1;
        if (vm_dbg == 2) {
          gdbg[3] = 2;
          red[0] = 1.0;
          lane_fold(K_MAX, 1);
          gdbg[2] += 1;
        }
        gdbg[3] = 3;
        answer(0.0);
        if (hub and vblk == BM and VJ == 0) { gdbg[1] += 1; }
      }
      i = steps;
    }
    if (vm_dbg == 3) {
      // the start pre ran above: now rows and tokens only
      while (i < steps) : (i += 1) {
        take_row();
        gdbg[0] += 1;
        answer(0.0);
        if (hub and vblk == BM and VJ == 0) { gdbg[1] += 1; }
      }
      i = steps;
    }
    while (i < steps) {
      var NR: u16 = vm_rows;
      var empty = false;
      if (LP) {
        NR = @as(u16, glane[lane * 4] >> 16);
        // rows 0: an empty lane (a zeroed glane): its turn is a skip, one row
        if (NR == 0) { NR = 1; empty = true; }
      }
      if (!TWO) { i += @as(u32, NR); }
      // Row 0: Vr logits, 1/rms, ctl (0: sample; else skip the turn: no
      // bank swap, no sections, no ring row, token 0). The hub has no row:
      // the PE above it hands it ctl on its fold color. Two VM sets (TWO):
      // ctl 0 / 1 is set A's turn (sample / skip), 2 / 3 set B's; a row that
      // is the other set's is read and left (no token, no lane step).
      take_row();
      if (!hub) {
        if (vy + 1 == F) { @fmovs(fab_out(q3_out, 1), @set_dsd_length(@increment_dsd_offset(vin_dsd, @as(i16, Vt + 1), f32), 1)); }
      } else {
        @fmovs(@set_dsd_length(@increment_dsd_offset(vin_dsd, @as(i16, Vt + 1), f32), 1), fab_in(q4_in, 1));
      }
      const cv = vin[Vt + 1];
      if (TWO) {
        const mine = if (VSET == 0) (cv == 0.0 or cv == 1.0) else (cv == 2.0 or cv == 3.0);
        if (!mine) {
          // set A's token sender relays set B's token for this row
          if (!CONC and VSET == 0 and hub and vblk == BM and VJ == 0) {
            @fmovs(tokv_dsd, fab_in(q6_in, 1));
            @fmovs(fab_out(q2_out, 1), tokv_dsd);
          }
          i += 1;
          continue;
        }
        i += @as(u32, NR);
      }
      const skip = (if (TWO) (cv == 1.0 or cv == 3.0) else cv != 0.0) or empty;
      if (!skip) {
        swap_in(lane);
        if (!hub) { @fmuls(wide0, vin_dsd, vin[Vt]); }
      }
      { var r: u16 = 1; while (r < NR) : (r += 1) {
        answer(0.0);
        take_row();
        if (!skip and !hub) {
          @fmuls(@increment_dsd_offset(wide0, @as(i16, r * Vt), f32), vin_dsd, vin[Vt]);
        }
      } }
      if (skip) {
        answer(0.0);
      } else {
      run_section(1);
      answer(@as(f32, @bitcast(i32, pool[if (LP) otok else @as(u16, tok_home[0])])));
      if (SIN > 0) { step_in(lane, turn + @as(u32, NL)); }
      run_section(0);
      swap_out(lane);
      }
      if (SIN > 0) { turn += 1; }
      lane += 1;
      if (lane == NL) { lane = 0; }
    }
  }
  sys_mod.unblock_cmd_stream();
}

comptime {
  @initialize_queue(q2_in, .{ .color = @get_color(C_VLS) });
  @initialize_queue(q2_out, .{ .color = @get_color(C_VT) });
  @initialize_queue(q3_out, .{ .color = @get_color(C_A) });
  @initialize_queue(q4_in, .{ .color = @get_color(C_B) });
  @initialize_queue(q5_in, .{ .color = @get_color(C_A) });
  @initialize_queue(q6_in, .{ .color = @get_color(C_E) });
  @initialize_queue(q7_in, .{ .color = @get_color(C_K) });
  if (SPLIT) { @initialize_queue(q3_in, .{ .color = @get_color(C_A2) }); }

  @export_symbol(wide_ptr, "gwide");
  @export_symbol(pool_ptr, "gpool");
  @export_symbol(ops_ptr, "gops");
  @export_symbol(out_ptr, "gout");
  @export_symbol(prof_ptr, "gprof");
  @export_symbol(ostep_ptr, "gostep");
  @export_symbol(gring_ptr, "gring");
  @export_symbol(dummy_u_ptr, "vm_ctl");
  @export_symbol(bank_ptr, "gbank");
  @export_symbol(cycles_ptr, "gcycles");
  @export_symbol(valid_ptr, "gvalid");
  @export_symbol(tok_home_ptr, "gtok_home");
  @export_symbol(gsin_ptr, "gsin");
  @export_symbol(glane_ptr, "glane");
  @export_symbol(gdbg_ptr, "gdbg");
  @export_symbol(gbdesc_ptr, "gbdesc");
  @export_symbol(gsdesc_ptr, "gsdesc");
  @export_symbol(gmode_ptr, "gmode");
  // The head's symbols, so every PE has every exported name.
  @export_symbol(dummy_u_ptr, "wt");
  @export_symbol(dummy_u_ptr, "et");
  @export_symbol(dummy_ptr, "l2");
  @export_symbol(dummy_u_ptr, "force");
  @export_symbol(dummy_ptr, "lmax");
  @export_symbol(dummy_ptr, "vm_tok");
  @export_symbol(vin_ptr, "vin");
  @export_symbol(dummy_ptr, "xin");
  @export_symbol(dummy_ptr, "gam");
  @export_symbol(dummy_ptr, "y");
  @export_symbol(dummy_ptr, "emb");
  @export_symbol(dummy_ptr, "tok");
  @export_symbol(dummy_u_ptr, "prof");
  @export_symbol(init);
  @export_symbol(compute);
}
