// gemma4_unit: a Gemma 4 dense layer unit (NL layers, x in place; serve8b_region's
// grids at NL 1 and regions at NL 2) with u4g64 weights, over qwen2d_region (below).
// Against qwen2d_region: q and k RMS-normed per head with their weights and v
// without one (the softmax scale 1: q's norm weights without 1/sqrt(d)); the
// attention's and the MLP's outputs RMS-normed (post-attention and post-
// feedforward weights) before their residual adds; a GELU-tanh GLU; the
// layer's scalar on x at its end. Two kinds of layer (bit l of KND): sliding
// (Qh query heads a kv head of Gs columns, head_dim Gs Dc, the window WIN) and
// global (QhG a kv copy of GsG columns: the host replicates the one kv head
// across the columns, PX / GsG copies, a copy's QhG query heads after it). Every
// layer lays its lane out at the unit's most heads (QM + 1 a RoPE half, the k
// after its own query heads; a sliding layer's fused QKV is spread to that layout
// in a unit with a global layer), so the buffers and the scores are sized by it.
// A column's q and k dims are a head's RoPE pairs (as qwen2d's); its v dims are
// Dc consecutive dims of the head (the o rows' groups). The per-layer values are
// lqh, lgs, lhd, the route words' kind (rcfg: X, Y, group broadcast for the
// sliding kind, then X and group broadcast for the global kind) and the RoPE
// table (rot_c/rot_s [kind][RB][DH]: one a kind present; binary levels). gamma2 holds a layer's pre-
// feedforward, post-attention and post-feedforward norm weights and its scalar.
// The u4g64 matvec (u4mv.csl's wmv4, spliced by codegen at //@@ u4fns): matrices
// m 0 fused QKV, 1 O, 2 gate, 3 up, 4 down, at table index 5 kind + m.
// B 1 only (the fused QKV), HROUTE 1, GY > 0, KVCP 0; KV16 (KV16 0, an f32 pool: check builds).
//
// qwen2d_region: NL consecutive layers on one region (the layout of
// docs/cerebras-8b-latency.md): every PE holds its slice of each layer's
// weights and KV pool ([layer][...] in every array), x stays in place from one
// layer to the next, and the tables (lanes, pages, bitmaps) are shared. A pass
// runs the NL layers in turn, rebasing the weight/KV DSDs (set_layer). NL > 1
// needs the bf16 paths (W16, KV16). Otherwise qwen2d_paged8b:
// qwen2d_paged8b: qwen2d_paged generalized to Qwen3-8B: a PX x PY grid, Qh query
// heads a kv head (GQA), bf16-stored weights (W16) and KV (KV16) through
// qwen2d's 16-bit matvec (x split into NP bf16 parts, @fmachs; NP = 3 is exact
// for f32 x), MLP chunks (MC), per-lane write slots and visibility bitmaps,
// copy_kv down a column. B lanes a pass, each its own RoPE position, write
// slot and page table (PIE's KvDelta.pages and attn_mask).
//
// Pool: physical page g (PS positions) lives whole on row g % PY, as KV block
// g / PY of that row (NB blocks a PE); each column holds its kv head's dims of
// it (keys [blk][d][PS], values [blk][PS][d]). Rows hold x's chunks (Hc dims,
// hidden zero padded to PY·Hc; RMSNorm over HR); columns hold the kv dims and
// Ic intermediate dims. Collectives after WaferLLM (MeshInfra/WaferLLM,
// Apache-2.0: Decode/src/comm_lib); 16-bit matvec after qwen2d (Fork 6).
param memcpy_params;
param PX: u16;         // columns
param PY: u16;         // rows
param Hc: u16;         // hidden dims a PE (ceil(hidden / PY))
param HR: u16;         // the model's hidden size (RMSNorm)
param Dc: u16;         // kv dims a column
param Gs: u16;         // columns a kv head (head_dim / Dc): the phase-1 group
param Qh: u16;         // query heads a kv head
param Ic: u16;         // intermediate dims a column (inter / PX)
param PS: u16;         // page size (positions)
param NB: u16;         // KV blocks a PE (pool pages = NB · PY)
param E: u16;          // page entries a lane a row
param B: u16;          // lanes a pass
param MC: u16;         // lanes an MLP chunk (B % MC == 0)
param W16: u16;        // 1: weights bf16 (u16 storage), else f32
param NP: u16;         // bf16 parts of x in the 16-bit matvecs (3: exact)
param KV16: u16;       // 1: KV in bf16
param KVCP: u16 = 1;   // 1: the copy_kv kernel, 0: the host copies pages by memcpy
param PROF: u16;
param GY: u16 = 0;     // rows a Y-axis phase-1 group (0: Gs); must divide PY
param HROUTE: u16 = 0; // 1: the host computes each PE's route bits (`rcfg`); no route-building code
param ROT8: u16 = 0;   // 1: RoPE tables of 4 levels x 8 (p = 512a + 64b + 8c + d) instead of 3 x 16
param NL: u16 = 1;     // layers on this region       // 1: per-phase cycles (prof), 0: the whole pass only (prof[0])
param QhG: u16 = 0;    // a global layer's query heads a kv copy (0: none)
param GsG: u16 = 0;    // a global layer's columns a kv copy (its head_dim / Dc)
param KND: u16 = 0;    // bit l: layer l of the unit reads globally
param WIN: u32 = 0;    // a sliding layer's window: write slot w sees slots (w - WIN, w] (0: all)
param W4BUF: u16 = 1024;   // the u4 decode buffer (u16 words; spatial::u4g12)
param c_r1_0: color;
param c_r1_1: color;
param c_r2_0: color;
param c_r2_1: color;
param c_bc: color;
param GBC: u16 = 0;          // 1: the group broadcast on its own color (serve8b_region_pipe)
param c_gbc: color = @get_color(16);
param c_gb: color;     // unused: the group broadcast and page copies ride on c_bc

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const timestamp = @import_module("<time>");
const math = @import_module("<math>");
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;

const HID: f32 = @as(f32, HR);       // the model's hidden size (x is zero padded to PY·Hc)
// The current layer's kind (set_layer): query heads a kv head (copy), its
// columns, head_dim, route words, u4 table index, RoPE table.
var lqh: u16 = Qh;
var lgs: u16 = Gs;
var lhd: f32 = @as(f32, Gs * Dc);
var lglob: bool = false;
var lrx: u16 = 0;
var lgb: u16 = 10;
var w4kk: u16 = 0;
var lrot: u16 = 0;
const EPS: f32 = 1.0e-6;
const R1: u16 = Gs / 2;              // phase-1 root within a group
// Per axis (set by set_axis): its length, groups of Gs, the phase-2 root.
var alen: u16 = PY;
// The current axis's phase-1 group (Gs along X; GY along Y, which must divide
// PY: 330 or 240 rows do not split into Gs = 32) and its root.
const GYv: u16 = if (GY == 0) Gs else GY;
var GA: u16 = GYv;
var RA: u16 = GYv / 2;
// (GY 0: the constants, folded as before.)
fn ga() u16 { return if (GY == 0) Gs else GA; }
fn ra() u16 { return if (GY == 0) R1 else RA; }
var NG: u16 = PY / Gs;
var R2: u16 = (PY / Gs / 2) * Gs + R1;
const DH: u16 = Dc / 2;

// ---------------------------------------------------------------- collectives
// Two-phase grouped all-reduce (WaferLLM comm_pe.csl, in f32): phase 1 chains
// each group of Gs PEs from both ends into its root, phase 2 chains the group
// roots into R2, then R2 broadcasts. Along X, "seg" stops after phase 1 and
// each group root broadcasts within its group (a kv head's columns).
const q_r1_0_in = @get_input_queue(3);
const q_r1_0_out = @get_output_queue(3);
const q_r1_1_in = @get_input_queue(4);
const q_r1_1_out = @get_output_queue(4);
const q_r2_0_in = @get_input_queue(5);
const q_r2_0_out = @get_output_queue(5);
const q_r2_1_in = @get_input_queue(6);
const q_r2_1_out = @get_output_queue(6);
const q_bc_in = @get_input_queue(7);
const q_bc_out = @get_output_queue(7);
// Queue 2 is free (the group broadcast and page copies ride on c_bc): a
// pipeline ring's handoff takes it (qwen2d_pring).

fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}

var px: u16 = 0;
var py: u16 = 0;

// Routes are written as raw color-config words from runtime directions (one
// copy of the code; <tile_config>'s reset_routes needs comptime directions and
// cost ~1.1 KB a specialization). Directions: 0 ramp, 1 north, 2 south, 3 east,
// 4 west.
const tgt = tile_config.target;
const D_RAMP: u16 = 0;
const D_N: u16 = 1;
const D_S: u16 = 2;
const D_E: u16 = 3;
const D_W: u16 = 4;
// The config bits of each direction, indexed by D_*.
const rx_bits = [5]tgt.reg_type { @get_int(tgt.fabric_io.RX_RAMP), @get_int(tgt.fabric_io.RX_NORTH),
  @get_int(tgt.fabric_io.RX_SOUTH), @get_int(tgt.fabric_io.RX_EAST), @get_int(tgt.fabric_io.RX_WEST) };
const tx_bits = [5]tgt.reg_type { @get_int(tgt.fabric_io.TX_RAMP), @get_int(tgt.fabric_io.TX_NORTH),
  @get_int(tgt.fabric_io.TX_SOUTH), @get_int(tgt.fabric_io.TX_EAST), @get_int(tgt.fabric_io.TX_WEST) };
var rxt = rx_bits;
var txt = tx_bits;
fn rxw(d: u16) tgt.reg_type { return rxt[d]; }
fn txw(d: u16) tgt.reg_type { return txt[d]; }
// c: rx from one direction, tx to t1 (and t2 when t2 != t1).
fn set_route(c: color, rx: u16, t1: u16, t2: u16) void {
  const addr = color_config.get_color_config_addr(c);
  var r = @get_config(addr, tgt.color_addr_range);
  r = r & @get_int(tgt.fabric_io.CLEAR_MASK);
  r = r | rxw(rx) | txw(t1) | txw(t2);
  @set_config(addr, r, tgt.color_addr_range);
}

// Phase 1 within a group of Gs along the axis: chains from both ends into R1
// (even and odd positions alternate the two colors so a PE never forwards on
// the color it receives on).
fn route_phase1(H: u16, T: u16, r: u16) void {
  const ev = r % 2 == 0;
  const ca = if (ev) c_r1_0 else c_r1_1;
  const cb = if (ev) c_r1_1 else c_r1_0;
  if (r == ra()) {
    set_route(ca, H, D_RAMP, D_RAMP);
    set_route(cb, T, D_RAMP, D_RAMP);
  } else if (r < ra()) {
    set_route(ca, H, D_RAMP, D_RAMP);
    set_route(cb, D_RAMP, T, T);
  } else {
    set_route(cb, T, D_RAMP, D_RAMP);
    set_route(ca, D_RAMP, H, H);
  }
}

fn route_phase2(H: u16, T: u16, id: u16) void {
  const qt = id / ga();
  const r = id % ga();
  const ev = qt % 2 == 0;
  const ca = if (ev) c_r2_0 else c_r2_1;
  const cb = if (ev) c_r2_1 else c_r2_0;
  if (id == R2) {
    set_route(ca, H, D_RAMP, D_RAMP);
    set_route(cb, T, D_RAMP, D_RAMP);
  } else if (id < R2) {
    if (r == ra()) {
      set_route(ca, H, D_RAMP, D_RAMP);
      set_route(cb, D_RAMP, T, T);
    } else {
      set_route(c_r2_0, H, T, T);
      set_route(c_r2_1, H, T, T);
    }
  } else {
    if (r == ra()) {
      set_route(cb, T, D_RAMP, D_RAMP);
      set_route(ca, D_RAMP, H, H);
    } else {
      set_route(c_r2_0, T, H, H);
      set_route(c_r2_1, T, H, H);
    }
  }
}

fn route_bcast(H: u16, T: u16, id: u16, last: u16) void {
  if (id == R2) {
    set_route(c_bc, D_RAMP, H, T);
  } else if (id < R2) {
    if (id == 0) { set_route(c_bc, T, D_RAMP, D_RAMP); }
    else { set_route(c_bc, T, H, D_RAMP); }
  } else {
    if (id == last) { set_route(c_bc, H, D_RAMP, D_RAMP); }
    else { set_route(c_bc, H, D_RAMP, T); }
  }
}

// The group broadcast (segment all-reduce along X) on c_bc.
fn route_gbcast() void {
  const r = px % Gs;
  if (r == R1) {
    set_route(c_bc, D_RAMP, D_W, if (R1 == Gs - 1) D_W else D_E);
  } else if (r < R1) {
    if (r == 0) { set_route(c_bc, D_E, D_RAMP, D_RAMP); }
    else { set_route(c_bc, D_E, D_W, D_RAMP); }
  } else {
    if (r == Gs - 1) { set_route(c_bc, D_W, D_RAMP, D_RAMP); }
    else { set_route(c_bc, D_W, D_RAMP, D_E); }
  }
}

var axis_x: bool = false;
var axis_id: u16 = 0;
// HROUTE: each PE's route bits for the 5 colors (c_r1_0, c_r1_1, c_r2_0,
// c_r2_1, c_bc) on the X axis, then the Y axis, then c_bc's group broadcast,
// written by the host from `rbits` (the encoding: rx bits by direction, then
// tx bits) before init. A switch read-modify-writes only the route bits.
const NCOL: u16 = 5;
const caddr = [NCOL]u16 { @as(u16, color_config.get_color_config_addr(c_r1_0)),
  @as(u16, color_config.get_color_config_addr(c_r1_1)), @as(u16, color_config.get_color_config_addr(c_r2_0)),
  @as(u16, color_config.get_color_config_addr(c_r2_1)), @as(u16, color_config.get_color_config_addr(c_bc)) };
var rcfg = @zeros([if (HROUTE == 1) 3 * NCOL + 2 else 1]u32);
var rcfg_ptr: [*]u32 = &rcfg;
const rbits0 = [10]u32 { @as(u32, rx_bits[0]), @as(u32, rx_bits[1]), @as(u32, rx_bits[2]), @as(u32, rx_bits[3]),
  @as(u32, rx_bits[4]), @as(u32, tx_bits[0]), @as(u32, tx_bits[1]), @as(u32, tx_bits[2]), @as(u32, tx_bits[3]),
  @as(u32, tx_bits[4]) };
var rbits = if (HROUTE == 1) rbits0 else @zeros([1]u32);
var rbits_ptr: [*]u32 = &rbits;
fn put_route(addr: u16, bits: u32) void {
  const r = @get_config(addr, tgt.color_addr_range) & @get_int(tgt.fabric_io.CLEAR_MASK);
  @set_config(addr, r | @as(tgt.reg_type, bits), tgt.color_addr_range);
}
// A send completes when its wavelets enter output queue 7, not when they
// leave it: a c_bc route rewritten right after a root's send would route its
// last wavelets anew (simulator: "landing C9 from link R, but inputMask is W",
// a group root's scores). Every c_bc route rewrite waits for the queue.
fn bc_drain() void {
  while ((tile_config.output_queue_status.get_raw() & 0x8000) == 0) {}   // queue 7 empty
}
fn set_axis(x: bool) void {
  bc_drain();
  if (GY != 0) {
    GA = if (x) lgs else GYv;
    RA = ga() / 2;
  }
  if (HROUTE == 1) {
    alen = if (x) PX else PY;
    NG = alen / ga();
    R2 = (NG / 2) * ga() + ra();
    axis_x = x;
    axis_id = if (x) px else py;
    var i: u16 = 0;
    while (i < NCOL) : (i += 1) { put_route(caddr[i], rcfg[(if (x) lrx else NCOL) + i]); }
    return;
  }
  const h = if (x) D_W else D_N;
  const t = if (x) D_E else D_S;
  const id = if (x) px else py;
  alen = if (x) PX else PY;
  NG = alen / ga();
  R2 = (NG / 2) * ga() + ra();
  route_phase1(h, t, id % ga());
  route_phase2(h, t, id);
  route_bcast(h, t, id, alen - 1);
  axis_x = x;
  axis_id = id;
}
fn axis_y() void { set_axis(false); }
fn axis_xx() void { set_axis(true); }

// dst = a op b, op: sum or max.
fn op_in(is_max: bool, buf: mem1d_dsd, comptime q: input_queue, n: u16) void {
  if (is_max) { @fmaxs(buf, buf, fin(q, n)); } else { @fadds(buf, buf, fin(q, n)); }
}
fn op_fwd(is_max: bool, comptime qo: output_queue, comptime qi: input_queue,
          buf: mem1d_dsd, n: u16) void {
  if (is_max) { @fmaxs(fout(qo, n), fin(qi, n), buf); } else { @fadds(fout(qo, n), fin(qi, n), buf); }
}

fn phase1(is_max: bool, buf: mem1d_dsd, n: u16) void {
  if (GY == 0) {
    const r = axis_id % Gs;
    if (r == R1) {
      if (R1 < Gs - 1) { op_in(is_max, buf, q_r1_0_in, n); }
      op_in(is_max, buf, q_r1_1_in, n);
    } else if (r > R1) {
      if (r % 2 == 0) {
        if (r == Gs - 1) { @fmovs(fout(q_r1_0_out, n), buf); }
        else { op_fwd(is_max, q_r1_0_out, q_r1_1_in, buf, n); }
      } else {
        if (r == Gs - 1) { @fmovs(fout(q_r1_1_out, n), buf); }
        else { op_fwd(is_max, q_r1_1_out, q_r1_0_in, buf, n); }
      }
    } else {
      if (r % 2 == 0) {
        if (r == 0) { @fmovs(fout(q_r1_1_out, n), buf); }
        else { op_fwd(is_max, q_r1_1_out, q_r1_0_in, buf, n); }
      } else {
        op_fwd(is_max, q_r1_0_out, q_r1_1_in, buf, n);
      }
    }
    return;
  }
  const r = axis_id % ga();
  if (r == ra()) {
    if (ra() < ga() - 1) { op_in(is_max, buf, q_r1_0_in, n); }
    op_in(is_max, buf, q_r1_1_in, n);
  } else if (r > ra()) {
    if (r % 2 == 0) {
      if (r == ga() - 1) { @fmovs(fout(q_r1_0_out, n), buf); }
      else { op_fwd(is_max, q_r1_0_out, q_r1_1_in, buf, n); }
    } else {
      if (r == ga() - 1) { @fmovs(fout(q_r1_1_out, n), buf); }
      else { op_fwd(is_max, q_r1_1_out, q_r1_0_in, buf, n); }
    }
  } else {
    if (r % 2 == 0) {
      if (r == 0) { @fmovs(fout(q_r1_1_out, n), buf); }
      else { op_fwd(is_max, q_r1_1_out, q_r1_0_in, buf, n); }
    } else {
      op_fwd(is_max, q_r1_0_out, q_r1_1_in, buf, n);
    }
  }
}

fn phase2(is_max: bool, buf: mem1d_dsd, n: u16) void {
  if (GY == 0) {
    const id = axis_id;
    const r = id % Gs;
    const qt = id / Gs;
    if (id == R2) {
      if (R2 < alen - Gs) { op_in(is_max, buf, q_r2_0_in, n); }
      op_in(is_max, buf, q_r2_1_in, n);
    } else if (id > R2) {
      if (r == R1) {
        if (id > alen - Gs - 1) {
          if (qt % 2 == 0) { @fmovs(fout(q_r2_0_out, n), buf); }
          else { @fmovs(fout(q_r2_1_out, n), buf); }
        } else {
          if (qt % 2 == 0) { op_fwd(is_max, q_r2_0_out, q_r2_1_in, buf, n); }
          else { op_fwd(is_max, q_r2_1_out, q_r2_0_in, buf, n); }
        }
      }
    } else {
      if (r == R1) {
        if (id < Gs) { @fmovs(fout(q_r2_1_out, n), buf); }
        else {
          if (qt % 2 == 0) { op_fwd(is_max, q_r2_1_out, q_r2_0_in, buf, n); }
          else { op_fwd(is_max, q_r2_0_out, q_r2_1_in, buf, n); }
        }
      }
    }
    return;
  }
  const id = axis_id;
  const r = id % ga();
  const qt = id / ga();
  if (id == R2) {
    if (R2 < alen - ga()) { op_in(is_max, buf, q_r2_0_in, n); }
    op_in(is_max, buf, q_r2_1_in, n);
  } else if (id > R2) {
    if (r == ra()) {
      if (id > alen - ga() - 1) {
        if (qt % 2 == 0) { @fmovs(fout(q_r2_0_out, n), buf); }
        else { @fmovs(fout(q_r2_1_out, n), buf); }
      } else {
        if (qt % 2 == 0) { op_fwd(is_max, q_r2_0_out, q_r2_1_in, buf, n); }
        else { op_fwd(is_max, q_r2_1_out, q_r2_0_in, buf, n); }
      }
    }
  } else {
    if (r == ra()) {
      if (id < ga()) { @fmovs(fout(q_r2_1_out, n), buf); }
      else {
        if (qt % 2 == 0) { op_fwd(is_max, q_r2_1_out, q_r2_0_in, buf, n); }
        else { op_fwd(is_max, q_r2_0_out, q_r2_1_in, buf, n); }
      }
    }
  }
}

// Sum (or max) of buf over the current axis, left in buf on every PE.
fn allreduce(is_max: bool, buf: mem1d_dsd, n: u16) void {
  phase1(is_max, buf, n);
  if (NG > 1) { phase2(is_max, buf, n); }
  if (axis_id == R2) { @fmovs(fout(q_bc_out, n), buf); }
  else { @fmovs(buf, fin(q_bc_in, n)); }
}

// Sum of buf over this PE's group of Gs columns (axis X).
// GBC 1 (serve8b_region_pipe): the group broadcast runs on c_gbc, whose
// routes (the group's) are set once a launch (gbc_routes), instead of c_bc's
// routes switching between the group's and the X axis's broadcast: both run
// along X, so with micro-batches back to back a wavelet of one could be taken
// under the other's routes (a CS-3 pipe launch hung so). Queue 7 moves to
// c_gbc around it: the root's output queue drained before each recolor, a
// member's input queue recolored only between complete reads; a wavelet of
// the other color meanwhile waits in the router.
fn gbc_iq7(c: u16) void {
  const addr = tile_config.input_queue_config.get_input_queue_config_addr(7);
  var v: u16 = @get_config(addr, tile_config.input_queue_config.in_queue_addr_range);
  v = (v & 0xffe0) | c;
  @set_config(addr, v, tile_config.input_queue_config.in_queue_addr_range);
}
fn gbc_oq7(c: u16) void {
  while ((tile_config.output_queue_status.get_raw() & 0x8000) == 0) {}   // queue 7 empty
  const addr = tile_config.output_queue_config.get_output_queue_config_addr(7);
  var v: u16 = @get_config(addr, tile_config.output_queue_config.out_queue_addr_range);
  v = (v & 0xfe0f) | (c << 4);
  @set_config(addr, v, tile_config.output_queue_config.out_queue_addr_range);
}
fn gbc_routes() void {
  if (HROUTE == 1) {
    put_route(color_config.get_color_config_addr(c_gbc), rcfg[2 * NCOL]);
    return;
  }
  const r = px % Gs;
  if (r == R1) {
    set_route(c_gbc, D_RAMP, D_W, if (R1 == Gs - 1) D_W else D_E);
  } else if (r < R1) {
    if (r == 0) { set_route(c_gbc, D_E, D_RAMP, D_RAMP); }
    else { set_route(c_gbc, D_E, D_W, D_RAMP); }
  } else {
    if (r == Gs - 1) { set_route(c_gbc, D_W, D_RAMP, D_RAMP); }
    else { set_route(c_gbc, D_W, D_RAMP, D_E); }
  }
}
fn allreduce_seg(buf: mem1d_dsd, n: u16) void {
  phase1(false, buf, n);
  if (GBC == 1) {
    if (px % Gs == R1) {
      gbc_oq7(@get_int(c_gbc));
      @fmovs(fout(q_bc_out, n), buf);
      gbc_oq7(@get_int(c_bc));
    } else {
      gbc_iq7(@get_int(c_gbc));
      @fmovs(buf, fin(q_bc_in, n));
      gbc_iq7(@get_int(c_bc));
    }
    return;
  }
  bc_drain();
  put_route(caddr[4], rcfg[lgb]);   // c_bc: the group's broadcast for now
  if (px % lgs == lgs / 2) { @fmovs(fout(q_bc_out, n), buf); bc_drain(); }
  else { @fmovs(buf, fin(q_bc_in, n)); }
  put_route(caddr[4], rcfg[lrx + 4]);   // back to the X axis's broadcast
}


// Trip counts read at runtime (an exported array the compiler cannot fold):
// per-lane loops stay loops.
var dims = @zeros([6]u16);           // B, E, TC, NQB, MC, NH
var dims_ptr: [*]u16 = &dims;

// ---------------------------------------------------------------- types, sizes
const WT = if (W16 == 1) @fp16() else f32;   // weight arithmetic type (bf16 with --fp16-format=bf16)
const WS = if (W16 == 1) u16 else f32;       // weight storage
var wdummy = @zeros([1]WT);
const KT = if (KV16 == 1) @fp16() else f32;
const KS = if (KV16 == 1) u16 else f32;
var kdummy = @zeros([1]KT);
const DHc: u16 = Dc / 2;
const QM: u16 = if (HAS_G and QhG > Qh) QhG else Qh;   // the unit's most query heads a layer (the lane layout's)
const NH: u16 = QM + 1;              // rotated heads a lane: QM queries' slots, the key's
const NQB: u16 = QM * B;             // (lane, query head) pairs
const TC: u16 = E * PS;              // a lane's score slots a row: entry e, offset o
const NS: u16 = TC * NQB;            // scores a PE: [t][b][h], t = e·PS + o
const iNQB: i16 = @as(i16, NQB);
const iB: i16 = @as(i16, B);
const NONE: u32 = 0xffffffff;
const GU1: u16 = 2 * Ic + 1;
const QH: u16 = NH * B * DHc;        // one half (RoPE pairs) of every lane's q heads and k
const QKN: u16 = 2 * QH;
const QKV_N: u16 = QKN + B * Dc + B;
const QO: u16 = QM * Dc;             // a lane's attention output (o) dims
const NR: u16 = QH;

fn at(d: mem1d_dsd, off: u16) mem1d_dsd {
  return @increment_dsd_offset(d, @as(i16, off), f32);
}
fn mx2(a: u16, b: u16) u16 { return if (a > b) a else b; }

// ---------------------------------------------------------------- tables
// RoPE positions [B] | write slots [B] | blocks [B][E] | logical pages [B][E] |
// visibility bitmaps [B][E] (bit o: the lane sees slot page·PS + o).
const NTAB: u16 = 2 * B + 3 * B * E;
var tab = @zeros([NTAB]u32);
var tab_ptr: [*]u32 = &tab;
fn wslot(b: u16) u32 { return tab[B + b]; }
fn eblk(b: u16, e: u16) u32 { return tab[2 * B + b * E + e]; }
fn epg(b: u16, e: u16) u32 { return tab[2 * B + B * E + b * E + e]; }
fn ebits(b: u16, e: u16) u32 {
  if (tab[2 * B + b * E + e] == NONE) { return 0; }
  return tab[2 * B + 2 * B * E + b * E + e];
}
fn advance(b: u16) void {
  tab[b] += 1;
  tab[B + b] += 1;
  const ws = tab[B + b];
  const pg = ws / @as(u32, PS);
  var e: u16 = 0;
  while (e < dims[1]) : (e += 1) {
    if (eblk(b, e) != NONE and epg(b, e) == pg) {
      tab[2 * B + 2 * B * E + b * E + e] |= @as(u32, 1) << @as(u16, ws % @as(u32, PS));
    }
  }
}

// ---------------------------------------------------------------- state
var x = @zeros([B * Hc]f32);
var x_ptr: [*]f32 = &x;
const x_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> x[i] });
const x_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> x[i] });
var gamma1 = @zeros([NL * Hc]f32);
var gamma1_ptr: [*]f32 = &gamma1;
const g1_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gamma1[i] });
// A layer's [pre-feedforward | post-attention | post-feedforward] norm weights and its scalar.
const G2W: u16 = 3 * Hc + 1;
var gamma2 = @zeros([NL * G2W]f32);
var gamma2_ptr: [*]f32 = &gamma2;
const g2_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gamma2[i] });

// Buffers by phase (a lane's words live in as few as possible):
//   sv: a lane's x·gamma; RoPE's r1.
//   et: the scores' and values' matvec scratch; the softmax's reductions;
//      RoPE's r2; copy_kv staging.
//   act: the MLP's act chunk; RoPE's r3.
//   qkv: q, k, v, x's sums of squares; then o (q is dead after the scores).
//   s: x's and q/k's squares; scores; then hv (the O and down partials) with
//      the QKV/O/gate-up matvec scratch past it.
const SVN: u16 = mx2(Hc, DHc);
var sv = @zeros([SVN]f32);
const xn_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> sv[i] });
// copy_kv: cells a fabric transfer (staged in et); it must divide a block's Dc·PS
// cells (32 at full size; a whole block on small test shapes).
const CPW: u16 = if ((Dc * PS) % 32 == 0) 32 else Dc * PS;
const ETN: u16 = mx2(mx2(DHc, NQB), mx2(2 * PS, CPW));
var et = @zeros([ETN]f32);
const ACTN: u16 = mx2(MC * Ic, DHc);
var act: [ACTN]f32 align(16) = @zeros([ACTN]f32);

// ---------------------------------------------------------------- u4g64 weights
// u4mv.csl's tiles (format at its top; its wmv4 spliced at //@@ u4fns) for the
// two kinds' matrices, table index i = 5 kind + m (m: 0 fused QKV [q|k first
// halves | second halves | v], 1 O, 2 gate, 3 up, 4 down; kind 0 sliding at
// Qh, Gs; kind 1 global at QhG, GsG). A symbol holds the headers of its
// distinct tiles among the unit's kinds (the sliding one's first), then each
// layer's words in layer order. Gate and up share wgu and one header (their
// tiles are the same): a layer's gate words, then its up words. The host
// (spatial::u4g12) writes exactly this.
const KGv = [2]u16 { KND & 1, (KND >> 1) & 1 };      // NL <= 2
const HAS_G: bool = (KND & 1) == 1 or (NL > 1 and (KND & 2) == 2);
const HAS_S: bool = (KND & 1) == 0 or (NL > 1 and (KND & 2) == 0);
const NK: u16 = if (HAS_S and HAS_G) 2 else 1;      // RoPE tables (one a kind present)
const W4L: u16 = NL;
const W4DH: u16 = Dc / 2;
const W4BUFW: u16 = W4BUF;
fn w4runs(n: u16) u16 {
  if (64 % n == 0) { return 1; }
  if (n % 64 == 0) { return n / 64; }
  return (n + 62) / 64 + 1;
}
const W4GH: u16 = w4runs(Hc);
const W4GD: u16 = w4runs(Ic);
// The O rows: a column's v (and o) dims are Dc consecutive dims of the head
// (v needs no RoPE pairs), so a query head's rows are one run of Dc.
fn w4go(q: u16, g: u16) u16 {
  return q * w4runs(Dc);
}
const QG1: u16 = if (QhG > 0) QhG else Qh;
const GG1: u16 = if (GsG > 0) GsG else Gs;
const W4F: bool = true;
const W4Rv = [10]u16 { Hc, Qh * Dc, Hc, Hc, Ic, Hc, QG1 * Dc, Hc, Hc, Ic };
const W4Nv = [10]u16 { 2 * (Qh + 1) * W4DH + Dc, Hc, Ic, Ic, Hc, 2 * (QG1 + 1) * W4DH + Dc, Hc, Ic, Ic, Hc };
const W4Gv = [10]u16 { W4GH, w4go(Qh, Gs), W4GH, W4GH, W4GD, W4GH, w4go(QG1, GG1), W4GH, W4GH, W4GD };
// Whether matrix m gets fresh x parts (up reuses gate's).
const W4XNv = [10]u16 { 1, 1, 1, 0, 1, 1, 1, 1, 0, 1 };
fn w4p(i: u16) u16 { return (W4Rv[i] + 3) / 4; }
fn w4k(i: u16) u16 {
  const k = W4BUFW / (W4Nv[i] + 1);
  if (k < 1) { return 1; }
  if (k > w4p(i)) { return w4p(i); }
  return k;
}
fn w4segs(i: u16) u16 { return 4 * ((w4p(i) + w4k(i) - 1) / w4k(i)) + W4Gv[i] - 1; }
fn w4hdr(i: u16) u16 { return 2 + 4 * w4segs(i); }
fn w4lw(i: u16) u16 { return w4p(i) * (W4Nv[i] + 1) + 2 * W4Gv[i] * W4Nv[i]; }
fn w4same(m: u16) bool { return W4Rv[m] == W4Rv[5 + m] and W4Nv[m] == W4Nv[5 + m] and W4Gv[m] == W4Gv[5 + m]; }
// A symbol's matrix (gate and up: wgu's, 2).
fn w4sym(m: u16) u16 { return if (m == 3) 2 else m; }
// Symbol m's headers, and kind index i's header offset in its symbol.
fn w4hdrs(m: u16) u16 {
  if (HAS_S and HAS_G and !w4same(m)) { return w4hdr(m) + w4hdr(5 + m); }
  if (HAS_G and !HAS_S) { return w4hdr(5 + m); }
  return w4hdr(m);
}
fn w4ho(i: u16) u16 {
  const m = if (i >= 5) i - 5 else i;
  if (i >= 5 and HAS_S and !w4same(m)) { return w4hdr(m); }
  return 0;
}
// Layer l's words of symbol m, and its matrix m's words' offset in the symbol.
fn w4kind(l: u16) u16 { return if (l < NL and KGv[l] == 1) 5 else 0; }
fn w4lws(l: u16, m: u16) u16 {
  if (m == 2) { return 2 * w4lw(w4kind(l) + 2); }
  return w4lw(w4kind(l) + m);
}
fn w4lo(l: u16, m: u16) u16 {
  const sm = w4sym(m);
  var o = w4hdrs(sm);
  if (l >= 1) { o += w4lws(0, sm); }
  if (m == 3) { o += w4lw(w4kind(l) + 2); }
  return o;
}
fn w4words(m: u16) u16 {
  var n = w4hdrs(m) + w4lws(0, m);
  if (NL > 1) { n += w4lws(1, m); }
  return n;
}
const W4Pv = [10]u16 { w4p(0), w4p(1), w4p(2), w4p(3), w4p(4), w4p(5), w4p(6), w4p(7), w4p(8), w4p(9) };
const W4Hv = [10]u16 { w4hdr(0), w4hdr(1), w4hdr(2), w4hdr(3), w4hdr(4), w4hdr(5), w4hdr(6), w4hdr(7), w4hdr(8), w4hdr(9) };
const W4LWv = [10]u16 { w4lw(0), w4lw(1), w4lw(2), w4lw(3), w4lw(4), w4lw(5), w4lw(6), w4lw(7), w4lw(8), w4lw(9) };
const W4HOv = [10]u16 { w4ho(0), w4ho(1), w4ho(2), w4ho(3), w4ho(4), w4ho(5), w4ho(6), w4ho(7), w4ho(8), w4ho(9) };
// Layer l's offset of table index i's words (W4LOv[10 l + i]; the kind's
// part of i does not matter there).
const W4LOv = [20]u16 { w4lo(0, 0), w4lo(0, 1), w4lo(0, 2), w4lo(0, 3), w4lo(0, 4),
  w4lo(0, 0), w4lo(0, 1), w4lo(0, 2), w4lo(0, 3), w4lo(0, 4),
  w4lo(1, 0), w4lo(1, 1), w4lo(1, 2), w4lo(1, 3), w4lo(1, 4),
  w4lo(1, 0), w4lo(1, 1), w4lo(1, 2), w4lo(1, 3), w4lo(1, 4) };
fn w4mx(a: u16, b: u16) u16 { return if (a > b) a else b; }
fn w4bw(i: u16) u16 { return w4k(i) * (W4Nv[i] + 1); }
fn w4m10(t: [10]u16) u16 {
  var m: u16 = 0;
  var i: u16 = 0;
  while (i < 10) : (i += 1) { m = w4mx(m, t[i]); }
  return m;
}
const W4HM: u16 = w4m10(W4Hv);
const W4NM: u16 = w4m10(W4Nv);
const W4PL: u16 = w4mx(w4mx(w4mx(w4bw(0), w4bw(1)), w4mx(w4bw(2), w4bw(4))),
  w4mx(w4mx(w4bw(5), w4bw(6)), w4mx(w4bw(7), w4bw(9))));
const W4AC: u16 = W4NM + 1;
const W4B0: u16 = w4words(0);
const W4B1: u16 = w4words(1);
const W4B2: u16 = w4words(2);
const W4B4: u16 = w4words(4);
// The weight symbols (u16 words after a pad); wqv and wv are one word (fused).
var wqa: [W4B0 + 1]WS align(16) = @zeros([W4B0 + 1]WS);
var wqa_ptr: [*]WS = &wqa;
var wqv: [2]WS align(16) = @zeros([2]WS);
var wqv_ptr: [*]WS = &wqv;
var wv: [2]WS align(16) = @zeros([2]WS);
var wv_ptr: [*]WS = &wv;
var wo: [W4B1 + 1]WS align(16) = @zeros([W4B1 + 1]WS);
var wo_ptr: [*]WS = &wo;
var wgu: [W4B2 + 1]WS align(16) = @zeros([W4B2 + 1]WS);
var wgu_ptr: [*]WS = &wgu;
var wd: [W4B4 + 1]WS align(16) = @zeros([W4B4 + 1]WS);
var wd_ptr: [*]WS = &wd;
fn w4blob(m: u16) [*]u16 {
  if (m == 0 or m == 5) { return @ptrcast([*]u16, &wqa[1]); }
  if (m == 1 or m == 6) { return @ptrcast([*]u16, &wo[1]); }
  if (m == 4 or m == 9) { return @ptrcast([*]u16, &wd[1]); }
  return @ptrcast([*]u16, &wgu[1]);
}
// Small DSDs over et and act, and the layer scalar's copy (a DSD op reads the
// host-written gamma2; a scalar read of it could fold to its zero start).
const et_flat = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{ETN} -> et[i] });
const g12_act = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{ACTN} -> act[i] });
var g12sc = @zeros([1]f32);
const g12sc_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> g12sc[i] });

// QKV payload: q heads and k, first halves [b][NH][DH], second halves, v [b][Dc],
// x's sums of squares [b].
var qkv: [QKV_N]f32 align(16) = @zeros([QKV_N]f32);
const qh_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH * DHc} -> qkv[i] });
const half_a = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QH} -> qkv[i] });
const half_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QH} -> qkv[@as(i16, QH) + i] });
const v_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> qkv[@as(i16, QKN) + i] });
const qkv_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QKV_N} -> qkv[i] });
const qkv_ssq = @get_dsd(mem1d_dsd, .{ .tensor_access = |b|{B} -> qkv[@as(i16, QKN + B * Dc) + b] });
const qd_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DHc} -> qkv[i] });
// q/k norm weights [half][NH][DH] (a layer's query heads, then its k at slot lqh; zero past it).
var qkn_w = @zeros([NL * 2 * NH * DHc]f32);
var qkn_w_ptr: [*]f32 = &qkn_w;
const qkn_a = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH * DHc} -> qkn_w[i] });
const qkn_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH * DHc} -> qkn_w[@as(i16, NH * DHc) + i] });
// q/k sums of squares [b·NH], their RMS scales after the segment all-reduce.
// (in s's first NH·B words, from the halving on).
fn scl_t() mem4d_dsd { return @get_dsd(mem4d_dsd, .{ .tensor_access = |k, j|{NH * B, DHc} -> s[k] }); }
fn sq_t() mem4d_dsd { return @get_dsd(mem4d_dsd, .{ .tensor_access = |k, j|{NH * B, DHc} -> s[j * @as(i16, NH * B) + k] }); }
fn sqx_t() mem4d_dsd { return @get_dsd(mem4d_dsd, .{ .tensor_access = |b, i|{B, Hc} -> s[i * iB + b] }); }

// The pool.
const KCN: u16 = NB * Dc * PS;       // a layer's keys (and values) a PE
var kc: [NL * KCN + 1]KS align(16) = @zeros([NL * KCN + 1]KS);
var kc_ptr: [*]KS = &kc;
var kc_dsd = if (KV16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &kdummy, .extent = PS })
             else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PS} -> kc[i + 1] });
var vc: [NL * KCN + 1]KS align(16) = @zeros([NL * KCN + 1]KS);
var vc_ptr: [*]KS = &vc;
var vc_dsd = if (KV16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &kdummy, .extent = Dc })
             else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> vc[i + 1] });
fn kv_store(v: f32) KS {
  if (KV16 == 1) {
    const u = @bitcast(u32, v);
    return @as(u16, (u + 0x7fff + ((u >> 16) & 1)) >> 16);
  } else {
    return v;
  }
}

// Scores [t][b][h] (t = e·PS + o), a lane-head's page run strided by NQB.
// (s also holds the squares, hv, and 2·max(Hc, QO) words of matvec scratch past hv.)
const SN: u16 = mx2(mx2(NS, 3 * QH), B * Hc + 2 * mx2(Hc, QO));
var s: [SN]f32 align(16) = @zeros([SN]f32);
const sqx_b = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B} -> s[i] });
const ssq3_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH * B + B} -> s[i] });   // q/k heads', then v's
const s_scores = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NS} -> s[i] });
const srun_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |t|{PS} -> s[t * iNQB] });
const srow_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |j|{NQB} -> s[j] });
var bcv = @zeros([NQB]f32);
const bcv_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |j|{NQB} -> bcv[j] });
const red_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NQB} -> et[i] });   // et is free in the softmax

// o [b][Qh][Dc] (in qkv, from the values on); hv [b][Hc] (in s, from the O
// matvec on).
const o_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * QO} -> qkv[i] });
const od_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> qkv[i] });
const ob_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QO} -> qkv[i] });
const hv_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> s[i] });
const hv_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> s[i] });

// The MLP, MC lanes at a time, element-major (DSD strides must fit an i8:
// a lane is strided by MC): gate/up [2·Ic][MC], then x's sums of squares [MC].
const iMC: i16 = @as(i16, MC);
var gu: [MC * GU1]f32 align(16) = @zeros([MC * GU1]f32);
const gu_lane = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * Ic} -> gu[i * iMC] });   // + lane k
const gu_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC * GU1} -> gu[i] });
const g_col = @get_dsd(mem1d_dsd, .{ .tensor_access = |b|{MC} -> gu[b] });                // + e·MC
const u_col = @get_dsd(mem1d_dsd, .{ .tensor_access = |b|{MC} -> gu[@as(i16, Ic * MC) + b] });
var xss = @zeros([B]f32);
const xss_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B} -> xss[i] });
// act [Ic][MC]: a lane strided by MC (the down matvec's x).
const act_lane = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> act[i * iMC] });     // + lane k
const act_mc = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC * Ic} -> act[i] });
const act_col = @get_dsd(mem1d_dsd, .{ .tensor_access = |b|{MC} -> act[b] });              // + e·MC
var ta = @zeros([MC]f32);
var tt = @zeros([MC]f32);
var te = @zeros([MC]f32);
var tr = @zeros([MC]f32);
var td = @zeros([MC]f32);
const ta_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> ta[i] });
const tt_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> tt[i] });
const te_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> te[i] });
const tr_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> tr[i] });
const td_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> td[i] });

// x split into bf16 parts for the 16-bit matvecs, and their f32 scratch.
const XMAX: u16 = mx2(mx2(Hc, QO), mx2(mx2(Ic, PS), DHc));
var xpart = @zeros([NP * XMAX]@fp16());
const xpart_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XMAX} -> xpart[i] });
// Their f32 scratch (2n words) borrows whichever buffer the call leaves free:
// s (QKV, O and gate/up matvecs), et (scores, values), gu (down).
const sc_s = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> s[@as(i16, B * Hc) + i] });
const sc_et = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> et[i] });
const sc_gu = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> gu[i] });

// ---------------------------------------------------------------- compute
const mv_dest = @get_dsr(dsr_dest, 1);
const mv_src0 = @get_dsr(dsr_src0, 1);
const mv_src1 = @get_dsr(dsr_src1, 1);
fn mv_step(xv: f32) void {
  @fmacs(mv_dest, mv_src0, mv_src1, xv);
}
fn mv16_step(xv: @fp16()) void {
  @fmachs(mv_dest, mv_src0, mv_src1, xv);
}
// y += A x (A's rows one per x element): f32 A by @map of @fmacs; 16-bit A by
// NP passes of @fmachs over x's bf16 parts (x = p0 + p1 + p2 exactly at NP = 3).
fn mvany(comptime a16: bool, y: mem1d_dsd, a: mem1d_dsd, xv: mem1d_dsd, n: u16, scr: mem1d_dsd) void {
  if (!a16) {
    @load_to_dsr(mv_dest, y, .{ .save_address = false });
    @load_to_dsr(mv_src0, y, .{ .save_address = false });
    @load_to_dsr(mv_src1, a, .{ .save_address = true });
    @map(mv_step, xv);
  } else {
    const res = @set_dsd_length(scr, n);
    const tmp = @set_dsd_length(at(scr, n), n);
    @fmovs(res, xv);
    var k: u16 = 0;
    while (k < NP) : (k += 1) {
      const part = @set_dsd_length(@increment_dsd_offset(xpart_dsd, @as(i16, k * XMAX), @fp16()), n);
      @fs2h(part, res);
      if (k + 1 < NP) {
        @fh2s(tmp, part);
        @fsubs(res, res, tmp);
      }
      @load_to_dsr(mv_dest, y, .{ .save_address = false });
      @load_to_dsr(mv_src0, y, .{ .save_address = false });
      @load_to_dsr(mv_src1, a, .{ .save_address = true });
      @map(mv16_step, part);
    }
  }
}
fn wmv(y: mem1d_dsd, a: mem1d_dsd, xv: mem1d_dsd, n: u16, scr: mem1d_dsd) void { mvany(W16 == 1, y, a, xv, n, scr); }
fn kmv(y: mem1d_dsd, a: mem1d_dsd, xv: mem1d_dsd, n: u16, scr: mem1d_dsd) void { mvany(KV16 == 1, y, a, xv, n, scr); }
fn kat(d: mem1d_dsd, off: u16) mem1d_dsd {
  return if (KV16 == 1) @increment_dsd_offset(d, @as(i16, off), @fp16()) else @increment_dsd_offset(d, @as(i16, off), f32);
}
fn wat(d: mem1d_dsd, off: u16) mem1d_dsd {
  return if (W16 == 1) @increment_dsd_offset(d, @as(i16, off), @fp16()) else @increment_dsd_offset(d, @as(i16, off), f32);
}

//@@ u4fns
fn rsqrt(v: f32) f32 {
  var y = @bitcast(f32, @as(u32, 0x5f3759df) - (@bitcast(u32, v) >> 1));
  const h = 0.5 * v;
  y = y * (1.5 - h * y * y);
  y = y * (1.5 - h * y * y);
  y = y * (1.5 - h * y * y);
  return y;
}
fn recip(v: f32) f32 {
  const r = rsqrt(v);
  return r * r;
}
fn rms_scale(sum: f32, n: f32) f32 {
  return rsqrt(sum * (1.0 / n) + EPS);
}
// buf [n][m] reduced over n in place into buf[0..m): sums (or maxes). n need
// not be a power of two (Hc is 13–29 at 8B): an odd count first folds its last
// row into row 0.
fn halve(buf: mem1d_dsd, n: u16, m: u16, is_max: bool) void {
  var k = n;
  while (k > 1) {
    if (k % 2 == 1) {
      const r0 = @set_dsd_length(buf, m);
      const rl = @set_dsd_length(at(buf, (k - 1) * m), m);
      if (is_max) { @fmaxs(r0, r0, rl); } else { @fadds(r0, r0, rl); }
      k -= 1;
    }
    const half = k / 2;
    const lo = @set_dsd_length(buf, half * m);
    const hi = @set_dsd_length(at(buf, half * m), half * m);
    if (is_max) { @fmaxs(lo, lo, hi); } else { @fadds(lo, lo, hi); }
    k = half;
  }
}
fn x_ssq(dst: mem1d_dsd) void {
  @fmuls(sqx_t(), x_all, x_all);
  halve(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> s[i] }), Hc, B, false);
  @fmovs(dst, sqx_b);
}

// RoPE: cos/sin(p · f_j) for this column's DH frequencies as the product of
// the rotations by 2^k f_j of p's set bits (tables [kind][RB][DH], positions
// < 2^RB), laid out [b][NH][DH]. The lane's cos/sin stay while its position and
// the layer's kind repeat (a region's layers of one kind).
const RB: u16 = 12;
var rot_c = @zeros([NK * RB * DHc]f32);
var rot_c_ptr: [*]f32 = &rot_c;
var rot_s = @zeros([NK * RB * DHc]f32);
var rot_s_ptr: [*]f32 = &rot_s;
var rc = @zeros([DHc]f32);           // the current lane's cos/sin
var rs = @zeros([DHc]f32);
var rp_pos: u32 = 0xffffffff;        // the position and table they are for
var rp_rot: u16 = 0xffff;
const rc_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DHc} -> rc[i] });
const rs_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DHc} -> rs[i] });
const r1_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DHc} -> sv[i] });
const r2_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DHc} -> et[i] });
const r3_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DHc} -> act[i] });
// A lane at a time (B 1): its cos/sin, then each of its heads a' = a·c - v·s,
// v' = v·c + a·s.
fn rope_all() void {
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    const p_ = tab[b];
    if (p_ != rp_pos or lrot != rp_rot) {
      rp_pos = p_;
      rp_rot = lrot;
      @fmovs(rc_d, 1.0);
      @fmovs(rs_d, 0.0);
      var q = p_;
      var ix = lrot;
      while (q != 0) : (ix += DHc) {
        if ((q & 1) == 1) {
          var j: u16 = 0;
          while (j < DHc) : (j += 1) {
            const tc = rot_c[ix + j];
            const ts = rot_s[ix + j];
            const c = rc[j];
            const sn = rs[j];
            rc[j] = c * tc - sn * ts;
            rs[j] = sn * tc + c * ts;
          }
        }
        q = q >> 1;
      }
    }
    var h: u16 = 0;
    while (h < dims[5]) : (h += 1) {
      const k = b * NH + h;
      const a = at(qd_dsd, k * DHc);
      const v = at(qd_dsd, QH + k * DHc);
      @fmuls(r1_d, a, rc_d);
      @fmuls(r2_d, v, rs_d);
      @fsubs(r1_d, r1_d, r2_d);
      @fmuls(r2_d, v, rc_d);
      @fmuls(r3_d, a, rs_d);
      @fadds(v, r2_d, r3_d);
      @fmovs(a, r1_d);
    }
  }
}

var exp_coeffs = [7]f32 { 1.0 / 720.0, 1.0 / 120.0, 1.0 / 24.0, 1.0 / 6.0, 0.5, 1.0, 1.0 };
fn exp_poly(buf: mem1d_dsd, tmp: mem1d_dsd) void {
  @fmaxs(tmp, buf, -88.0);
  @fmuls(tmp, tmp, 0.00390625);
  @fmovs(buf, 1.0 / 5040.0);
  var c: u16 = 0;
  while (c < 7) : (c += 1) {
    @fmuls(buf, buf, tmp);
    @fadds(buf, buf, exp_coeffs[c]);
  }
  c = 0;
  while (c < 8) : (c += 1) { @fmuls(buf, buf, buf); }
}
// gelu_tanh(g) u = g sigma(2 z) u, z = sqrt(2/pi) (g + 0.044715 g^3): as SiLU's
// g sigma(g) = (g + |g| tanh(|g| / 2)) / 2 with tanh(|z|) = (1 - e) / (1 + e),
// e = exp(-2 |z|) (2 |z| = |g| (2c + 2c 0.044715 g^2)).
fn gelu_col(e: u16) void {
  const g = at(g_col, e * MC);
  const u = at(u_col, e * MC);
  @fabss(ta_d, g);
  @fmuls(tt_d, ta_d, ta_d);
  @fmuls(tt_d, tt_d, 0.07135481627159676);
  @fadds(tt_d, tt_d, 1.5957691216057308);
  @fmuls(tr_d, tt_d, ta_d);
  @fnegs(te_d, tr_d);
  exp_poly(te_d, tt_d);           // e = exp(-2|z|)
  @fadds(td_d, te_d, 1.0);
  @fmuls(tr_d, td_d, -0.47058823529411764);
  @fadds(tr_d, tr_d, 1.411764705882353);
  var it: u16 = 0;
  while (it < 3) : (it += 1) {
    @fmuls(tt_d, td_d, tr_d);
    @fnegs(tt_d, tt_d);
    @fadds(tt_d, tt_d, 2.0);
    @fmuls(tr_d, tr_d, tt_d);
  }
  @fnegs(tt_d, te_d);
  @fadds(tt_d, tt_d, 1.0);
  @fmuls(tt_d, tt_d, tr_d);
  @fmuls(tt_d, tt_d, ta_d);
  @fadds(tt_d, tt_d, g);
  @fmuls(tt_d, tt_d, 0.5);
  @fmuls(at(act_col, e * MC), tt_d, u);
}

// x += RMSNorm(hv) w (j 1: the post-attention norm, 2: the post-feedforward
// norm; the sum of squares over the rows, Y), after the columns' all-reduce.
// act is free around both (its first word carries the sum).
fn g12_post(j: u16) void {
  axis_y();
  const sq = @set_dsd_length(g12_act, Hc);
  @fmuls(sq, hv_dsd, hv_dsd);
  halve(sq, Hc, 1, false);
  allreduce(false, @set_dsd_length(g12_act, 1), 1);
  const sc = rms_scale(act[0], HID);
  @fmuls(hv_dsd, hv_dsd, at(g2_dsd, lw * G2W + j * Hc));
  @fmacs(x_dsd, x_dsd, hv_dsd, sc);
}

// The fused QKV tile writes [first halves | second halves | v] of lqh + 1
// heads; a layer with fewer than QM query heads spreads them to the lane
// layout (each half QM + 1 heads, v at QKN), et staging the second halves.
fn g12_spread() void {
  if (!(HAS_S and HAS_G) or lqh == QM) { return; }
  const n = (lqh + 1) * DHc;
  @fmovs(v_dsd, @set_dsd_length(at(qkv_all, 2 * n), Dc));
  const t = @set_dsd_length(et_flat, n);
  @fmovs(t, @set_dsd_length(at(qkv_all, n), n));
  @fmovs(@set_dsd_length(at(qkv_all, n), 2 * QH - n), 0.0);
  @fmovs(@set_dsd_length(at(qkv_all, QH), n), t);
}

// A sliding layer's window over entry e of lane b: the page's leading slots
// at or below its write slot - WIN (PS: the whole page).
fn wmask(b: u16, e: u16) u16 {
  if (WIN == 0 or !HAS_S or lglob) { return 0; }
  const ws = wslot(b);
  if (ws + 1 <= WIN) { return 0; }
  const first = ws + 1 - WIN;
  const p0 = epg(b, e) * @as(u32, PS);
  if (first <= p0) { return 0; }
  const m = first - p0;
  return if (m >= @as(u32, PS)) PS else @as(u16, m);
}

// ---------------------------------------------------------------- profile
const NPROF: u16 = 16;
var prof = @zeros([NPROF]u32);
var prof_ptr: [*]u32 = &prof;
var t_mark = @zeros([timestamp.tsc_size_words]u16);
var t_now = @zeros([timestamp.tsc_size_words]u16);
var timing: bool = false;
fn tsc(t: *[timestamp.tsc_size_words]u16) u64 {
  return @as(u64, t.*[0]) | (@as(u64, t.*[1]) << 16) | (@as(u64, t.*[2]) << 32);
}
fn mark(slot: u16) void {
  if (PROF == 1) {
    timestamp.get_timestamp(&t_now);
    if (timing) { prof[slot] += @as(u32, (tsc(&t_now) - tsc(&t_mark)) & 0xffffffff); }
    t_mark = t_now;
  }
}
// The whole pass (PROF = 0: a 32-bit difference of the TSC's low words;
// prof[1] holds the pass's start).
fn pass_start() void {
  if (PROF == 0) {
    timestamp.get_timestamp(&t_now);
    prof[1] = @as(u32, t_now[0]) | (@as(u32, t_now[1]) << 16);
  }
}
fn pass_end() void {
  if (PROF == 0 and timing) {
    timestamp.get_timestamp(&t_now);
    const e = @as(u32, t_now[0]) | (@as(u32, t_now[1]) << 16);
    const st = prof[1];
    prof[0] += if (e >= st) e - st else (0xffffffff - st) + e + 1;
  }
}

// s[t][·] -= bcv (sub) or *= bcv, a slot row at a time.
fn bcast(is_mul: bool) void {
  var t: u16 = 0;
  while (t < dims[2]) : (t += 1) {
    const r = at(srow_dsd, t * NQB);
    if (is_mul) { @fmuls(r, r, bcv_dsd); } else { @fsubs(r, r, bcv_dsd); }
  }
}

// red = max (or sum) over the slot rows of s.
fn fold(is_max: bool) void {
  @fmovs(red_dsd, srow_dsd);
  var t: u16 = 1;
  while (t < dims[2]) : (t += 1) {
    const r = at(srow_dsd, t * NQB);
    if (is_max) { @fmaxs(red_dsd, red_dsd, r); } else { @fadds(red_dsd, red_dsd, r); }
  }
}

// ---------------------------------------------------------------- the layer
fn layer() void {
  var b: u16 = 0;
  // 0–1: QKV partials a lane at a time (x·gamma1 against the bf16 tiles) and
  // x's sums of squares; one all-reduce over the rows; RMSNorm.
  axis_y();
  @fmovs(qkv_all, 0.0);
  b = 0;
  while (b < dims[0]) : (b += 1) {
    const xb = xn_dsd;
    @fmuls(xb, at(x_dsd, b * Hc), at(g1_dsd, lw * Hc));
    wmv4(qkv_all, w4kk, xb, sc_s);
    g12_spread();
  }
  x_ssq(qkv_ssq);
  mark(0);
  allreduce(false, qkv_all, QKV_N);
  b = 0;
  while (b < dims[0]) : (b += 1) {
    const sc = rms_scale(qkv[QKN + B * Dc + b], HID);
    const qa = at(qh_dsd, b * NH * DHc);
    const qv = at(qh_dsd, QH + b * NH * DHc);
    const vb = at(v_dsd, b * Dc);
    @fmuls(qa, qa, sc);
    @fmuls(qv, qv, sc);
    @fmuls(vb, vb, sc);
  }
  mark(1);
  // 2: q/k RMSNorm (sums of squares over the kv head's columns), norm weights,
  // RoPE, KV append at each lane's write slot.
  const sqa = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QH} -> s[@as(i16, QH) + i] });
  const sqv = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QH} -> s[@as(i16, 2 * QH) + i] });
  @fmuls(sqa, half_a, half_a);
  @fmuls(sqv, half_v, half_v);
  @fadds(sq_t(), sqa, sqv);
  halve(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QH} -> s[i] }), DHc, NH * B, false);
  // v's sum of squares (B 1) rides along: s[NH].
  const sqd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> s[@as(i16, QH) + i] });
  @fmuls(sqd, v_dsd, v_dsd);
  halve(sqd, Dc, 1, false);
  s[NH] = s[QH];
  axis_xx();
  allreduce_seg(ssq3_dsd, NH * B + B);
  var k: u16 = 0;
  while (k <= NH * dims[0]) : (k += 1) { s[k] = rms_scale(s[k], lhd); }
  @fmuls(half_a, half_a, scl_t());
  @fmuls(half_v, half_v, scl_t());
  @fmuls(v_dsd, v_dsd, s[NH]);
  b = 0;
  while (b < dims[0]) : (b += 1) {
    const qa = at(qh_dsd, b * NH * DHc);
    const qv = at(qh_dsd, QH + b * NH * DHc);
    @fmuls(qa, qa, at(qkn_a, lw * 2 * NH * DHc));
    @fmuls(qv, qv, at(qkn_v, lw * 2 * NH * DHc));
  }
  rope_all();
  b = 0;
  while (b < dims[0]) : (b += 1) {
    const pg = wslot(b) / @as(u32, PS);
    const oo = @as(u16, wslot(b) % @as(u32, PS));
    var e: u16 = 0;
    while (e < dims[1]) : (e += 1) {
      if (eblk(b, e) != NONE and epg(b, e) == pg) {
        const blk = @as(u16, eblk(b, e));
        var d: u16 = 0;
        while (d < Dc) : (d += 1) {
          const kidx = (if (d < DHc) 0 else QH) + (b * NH + lqh) * DHc + d % DHc;
          kc[1 + lw * KCN + blk * Dc * PS + d * PS + oo] = kv_store(qkv[kidx]);
          vc[1 + lw * KCN + blk * PS * Dc + oo * Dc + d] = kv_store(qkv[QKN + b * Dc + d]);
        }
      }
    }
  }
  mark(2);
  // 3: scores, a page and a query head at a time ([t][b][h]); slots the lane
  // does not see -1e30 (a prefix bitmap in two ops, else a slot at a time);
  // 4: summed over the kv head's columns.
  @fmovs(s_scores, -1.0e30);
  b = 0;
  while (b < dims[0]) : (b += 1) {
    var e: u16 = 0;
    while (e < dims[1]) : (e += 1) {
      const bits = ebits(b, e);
      const wm = wmask(b, e);
      if (bits != 0 and wm < PS) {
        const blk = @as(u16, eblk(b, e));
        const kb = kat(kc_dsd, blk * Dc * PS);
        const kb2 = kat(kb, DHc * PS);
        var pre: u16 = PS;
        if ((bits & (bits + 1)) == 0) {
          pre = 0;
          while (pre < PS and ((bits >> pre) & 1) == 1) : (pre += 1) {}
        }
        var h: u16 = 0;
        while (h < dims[5] - 1) : (h += 1) {
          const run = at(srun_dsd, e * PS * NQB + b * QM + h);
          const hq = (b * NH + h) * DHc;
          @fmovs(run, 0.0);
          kmv(run, kb, at(qd_dsd, hq), DHc, sc_et);
          kmv(run, kb2, at(qd_dsd, QH + hq), DHc, sc_et);
          if (pre < PS) {
            @fmovs(@set_dsd_length(at(run, pre * NQB), PS - pre), -1.0e30);
          } else if ((bits & (bits + 1)) != 0) {
            var o: u16 = 0;
            while (o < PS) : (o += 1) {
              if (((bits >> o) & 1) == 0) { s[(e * PS + o) * NQB + b * QM + h] = -1.0e30; }
            }
          }
          if (wm > 0) { @fmovs(@set_dsd_length(run, wm), -1.0e30); }
        }
      }
    }
  }
  mark(3);
  allreduce_seg(s_scores, NS);
  mark(4);
  // 5: softmax over every row's keys: the maxes all-reduced, the exponentials
  // and their sums, the sums all-reduced.
  // Row by row, in place: no copy of the scores (the old halving tree took NS
  // words of et); bcv is exp's scratch between the two broadcasts.
  axis_y();
  fold(true);
  allreduce(true, red_dsd, NQB);
  @fmovs(bcv_dsd, red_dsd);
  bcast(false);
  var t: u16 = 0;
  while (t < dims[2]) : (t += 1) { exp_poly(at(srow_dsd, t * NQB), bcv_dsd); }
  fold(false);
  allreduce(false, red_dsd, NQB);
  var j: u16 = 0;
  while (j < dims[3]) : (j += 1) { bcv[j] = recip(et[j]); }
  bcast(true);
  mark(5);
  // 6: value partials a page and a head at a time; 7: summed over the rows.
  @fmovs(o_all, 0.0);
  b = 0;
  while (b < dims[0]) : (b += 1) {
    var e: u16 = 0;
    while (e < dims[1]) : (e += 1) {
      if (ebits(b, e) != 0 and wmask(b, e) < PS) {
        const blk = @as(u16, eblk(b, e));
        const vb = kat(vc_dsd, blk * PS * Dc);
        var h: u16 = 0;
        while (h < dims[5] - 1) : (h += 1) {
          kmv(at(od_dsd, (b * QM + h) * Dc), vb, at(srun_dsd, e * PS * NQB + b * QM + h), PS, sc_et);
        }
      }
    }
  }
  mark(6);
  allreduce(false, o_all, B * QO);
  mark(7);
  // 8–9: O projection, summed over the columns, residual.
  axis_xx();
  @fmovs(hv_all, 0.0);
  b = 0;
  while (b < dims[0]) : (b += 1) { wmv4(at(hv_dsd, b * Hc), w4kk + 1, at(ob_dsd, b * QO), sc_s); }
  mark(8);
  allreduce(false, hv_all, B * Hc);
  g12_post(1);
  mark(9);
  // 10–14: the second RMSNorm and the MLP, MC lanes at a time; 15: down
  // partials summed over the columns, the post-feedforward norm, the
  // residual, the layer's scalar. (g12_post left the axis at Y.)
  x_ssq(xss_dsd);
  mark(10);
  @fmovs(hv_all, 0.0);
  var c0: u16 = 0;
  while (c0 < dims[0]) : (c0 += dims[4]) {
    k = 0;
    while (k < dims[4]) : (k += 1) {
      const lb = c0 + k;
      @fmuls(xn_dsd, at(x_dsd, lb * Hc), at(g2_dsd, lw * G2W));
      const gb = at(gu_lane, k);
      @fmovs(gb, 0.0);
      wmv4(gb, w4kk + 2, xn_dsd, sc_s);
      wmv4(at(gb, Ic * MC), w4kk + 3, xn_dsd, sc_s);
      gu[2 * Ic * MC + k] = xss[lb];
    }
    allreduce(false, gu_all, MC * GU1);
    k = 0;
    while (k < dims[4]) : (k += 1) {
      const gb = at(gu_lane, k);
      @fmuls(gb, gb, rms_scale(gu[2 * Ic * MC + k], HID));
    }
    @fmovs(act_mc, 0.0);
    var el: u16 = py;
    while (el < Ic) : (el += PY) { gelu_col(el); }
    allreduce(false, act_mc, MC * Ic);
    k = 0;
    while (k < dims[4]) : (k += 1) { wmv4(at(hv_dsd, (c0 + k) * Hc), w4kk + 4, at(act_lane, k), sc_gu); }
  }
  mark(13);
  axis_xx();
  allreduce(false, hv_all, B * Hc);
  g12_post(2);
  @fmovs(g12sc_d, @set_dsd_length(at(g2_dsd, lw * G2W + 3 * Hc), 1));
  @fmuls(x_all, x_all, g12sc[0]);
  mark(15);
}

// The current layer: its weight and KV DSDs rebased onto its slice of each
// array (16-bit: one past the slice start, as for one layer), lw for the
// gammas, norm weights and scalar KV indexing.
var lw: u16 = 0;
fn set_layer(l: u16) void {
  lw = l;
  w4lay = l;
  const g = KGv[l] == 1;
  lglob = g;
  lqh = if (g) QhG else Qh;
  lgs = if (g) GsG else Gs;
  lhd = @as(f32, lgs * Dc);
  dims[5] = lqh + 1;
  w4kk = if (g) 5 else 0;
  lrx = if (g) 2 * NCOL + 1 else 0;
  lgb = if (g) 3 * NCOL + 1 else 2 * NCOL;
  lrot = if (g and NK == 2) RB * DHc else 0;
  if (KV16 == 1) {
    kc_dsd = @set_dsd_base_addr(kc_dsd, @ptrcast([*]@fp16(), &kc[1 + l * KCN]));
    vc_dsd = @set_dsd_base_addr(vc_dsd, @ptrcast([*]@fp16(), &vc[1 + l * KCN]));
  } else {
    // (an f32 pool: G12 check builds)
    kc_dsd = @set_dsd_base_addr(kc_dsd, @ptrcast([*]f32, &kc[1 + l * KCN]));
    vc_dsd = @set_dsd_base_addr(vc_dsd, @ptrcast([*]f32, &vc[1 + l * KCN]));
  }
}
fn rebase16() void { set_layer(0); }

fn init() void {
  dims[0] = B;
  dims[1] = E;
  dims[2] = TC;
  dims[3] = NQB;
  dims[4] = MC;
  px = layout_mod.get_x_coord();
  py = layout_mod.get_y_coord();
  rebase16();
  w4_rebase();
  if (KVCP == 1) { rebase_stage(); }
  if (HROUTE == 0) { route_gbcast(); }
  axis_y();
  sys_mod.unblock_cmd_stream();
}

// `steps` passes over the current tables; after each, every lane advances
// (decode: RoPE position and write slot a step on, the new slot visible).
fn compute(steps: u32) void {
  timestamp.enable_tsc();
  var i: u32 = 0;
  while (i < steps) : (i += 1) {
    if (i > 0) {
      var b: u16 = 0;
      while (b < dims[0]) : (b += 1) { advance(b); }
    }
    timing = i > 0;
    pass_start();
    timestamp.get_timestamp(&t_mark);
    var l: u16 = 0;
    while (l < NL) : (l += 1) {
      set_layer(l);
      layer();
    }
    pass_end();
  }
  sys_mod.unblock_cmd_stream();
}

// copy_kv: pool page src's KV into page dst (whole pages), down each column on
// c_bc: row src % PY sends block src / PY, row dst % PY receives it; rows
// between pass it on. Two launches a page (phase 0 sets routes, or copies
// within a row; the launch boundary is the barrier the path needs; phase 1
// moves). Under KV16 the cells cross as f32 words, CPW at a time: each bf16
// cell in a word's high half (a word that is exactly the cell's value; 16-bit
// fabric moves corrupted the next layer on the simulator), staged in et.
const CPN: u16 = Dc * PS;            // cells of K (or of V) a block
fn kblk(d: mem1d_dsd, blk: u16, off: u16, n: u16) mem1d_dsd {
  return @set_dsd_length(kat(d, blk * CPN + off), n);
}
var u16one = @zeros([1]u16);
var stg_hi = @get_dsd(mem1d_dsd, .{ .base_address = &u16one, .extent = CPW });   // et's high halves (init)
const stg32 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{CPW} -> et[i] });
fn rebase_stage() void {
  if (KV16 == 1) {
    stg_hi = @set_dsd_stride(@set_dsd_base_addr(stg_hi, @ptrcast([*]u16, &et[0])), 2);
    stg_hi = @increment_dsd_offset(stg_hi, 1, u16);
  }
}
fn copy_kv(src: u32, dst: u32, phase: u32) void {
  const rs_ = @as(u16, src & 0xffff);
  const bs = @as(u16, src >> 16);
  const rd = @as(u16, dst & 0xffff);
  const bd = @as(u16, dst >> 16);
  if (rs_ == rd) {
    var l: u16 = 0;
    while (phase == 0 and py == rs_ and l < NL) : (l += 1) {
      set_layer(l);
      if (KV16 == 1) {
        @fmovh(kblk(kc_dsd, bd, 0, CPN), kblk(kc_dsd, bs, 0, CPN));
        @fmovh(kblk(vc_dsd, bd, 0, CPN), kblk(vc_dsd, bs, 0, CPN));
      } else {
        @fmovs(kblk(kc_dsd, bd, 0, CPN), kblk(kc_dsd, bs, 0, CPN));
        @fmovs(kblk(vc_dsd, bd, 0, CPN), kblk(vc_dsd, bs, 0, CPN));
      }
    }
  } else if (phase == 0) {
    const down = rs_ < rd;
    const lo = if (down) rs_ else rd;
    const hi = if (down) rd else rs_;
    if (py >= lo and py <= hi) {
      const from = if (down) D_N else D_S;
      const to = if (down) D_S else D_N;
      if (py == rs_) { set_route(c_bc, D_RAMP, to, to); }
      else if (py == rd) { set_route(c_bc, from, D_RAMP, D_RAMP); }
      else { set_route(c_bc, from, to, to); }
    }
  } else if (py == rs_ or py == rd) {
    const snd = py == rs_;
    const blk = if (snd) bs else bd;
    var l: u16 = 0;
    while (l < NL) : (l += 1) {
    set_layer(l);
    var c: u16 = 0;
    while (c < 2 * CPN) : (c += CPW) {                  // K's cells, then V's (each layer's)
      const cells = if (c < CPN) kblk(kc_dsd, blk, c, CPW) else kblk(vc_dsd, blk, c - CPN, CPW);
      if (KV16 == 1) {
        if (snd) {
          @fmovs(stg32, 0.0);
          @mov16(stg_hi, cells);
          @fmovs(fout(q_bc_out, CPW), stg32);
        } else {
          @fmovs(stg32, fin(q_bc_in, CPW));
          @mov16(cells, stg_hi);
        }
      } else {
        if (snd) { @fmovs(fout(q_bc_out, CPW), cells); } else { @fmovs(cells, fin(q_bc_in, CPW)); }
      }
    }
    }
  }
  sys_mod.unblock_cmd_stream();
}

comptime {
  @comptime_assert(B == 1 and MC == 1 and NL <= 2 and GY > 0 and HROUTE == 1 and GBC == 0);
  @comptime_assert(QhG == 0 or (GsG > 0 and PX % GsG == 0 and GY > 0));
  @comptime_assert(ACTN >= Hc and (!(HAS_S and HAS_G) or (ETN >= (Qh + 1) * DHc and 2 * (Qh + 1) * DHc + Dc <= QKN)));
}

comptime {
  if (NL > 1) { @comptime_assert(W16 == 1); }
  @initialize_queue(q_r1_0_in, .{ .color = c_r1_0 });
  @initialize_queue(q_r1_0_out, .{ .color = c_r1_0 });
  @initialize_queue(q_r1_1_in, .{ .color = c_r1_1 });
  @initialize_queue(q_r1_1_out, .{ .color = c_r1_1 });
  @initialize_queue(q_r2_0_in, .{ .color = c_r2_0 });
  @initialize_queue(q_r2_0_out, .{ .color = c_r2_0 });
  @initialize_queue(q_r2_1_in, .{ .color = c_r2_1 });
  @initialize_queue(q_r2_1_out, .{ .color = c_r2_1 });
  @initialize_queue(q_bc_in, .{ .color = c_bc });
  @initialize_queue(q_bc_out, .{ .color = c_bc });

  @export_symbol(x_ptr, "x");
  @export_symbol(tab_ptr, "tab");
  @export_symbol(gamma1_ptr, "gamma1");
  @export_symbol(gamma2_ptr, "gamma2");
  @export_symbol(wqa_ptr, "wqa");
  @export_symbol(wqv_ptr, "wqv");
  @export_symbol(wv_ptr, "wv");
  @export_symbol(qkn_w_ptr, "qkn_w");
  @export_symbol(rot_c_ptr, "rot_c");
  if (HROUTE == 1) {
    @export_symbol(rcfg_ptr, "rcfg");
    @export_symbol(rbits_ptr, "rbits");
  }
  @export_symbol(rot_s_ptr, "rot_s");
  @export_symbol(kc_ptr, "kc");
  @export_symbol(vc_ptr, "vc");
  @export_symbol(wo_ptr, "wo");
  @export_symbol(wgu_ptr, "wgu");
  @export_symbol(wd_ptr, "wd");
  @export_symbol(prof_ptr, "prof");
  @export_symbol(dims_ptr, "dims");
  @export_symbol(init);
  @export_symbol(compute);
  if (KVCP == 1) {
    @export_symbol(copy_kv);
  }
}
