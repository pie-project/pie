//@@ consts
// ---------------------------------------------------------------- u4g64 weights
// (u4mv.csl, spliced in by codegen for W4 builds.) Each weight symbol (wqa wqv
// wv wo wgu wd) holds its matrix's u4g64 tile in place of the bf16 one, in
// u16 words after the leading pad:
//   [ng, nseg] [w4segs(m) x (woff, len, r0, plane << 8 | g)]   the row segments
//   per layer: codes [P][N + 1], then per group g: scales [N], biases [N] (bf16)
// R rows (one per x element), N outputs. Word (p, j) holds the codes of rows
// p, P + p, 2P + p, 3P + p (P = ceil(R / 4)) at bits 0, 4, 8, 12: plane k is
// one shift and mask. Column N's codes are 1, so a group's accumulator ends
// with the sum of its x. A segment is a run of at most K(m) rows in one plane
// and one group (64 consecutive input dims, MLX's affine form), in row order
// (so groups come in order):
//   y += sum_g s_g * (sum_{r in g} x_r q_r) + b_g * (sum_{r in g} x_r).
// Memory past the codes and scales is a constant: a segment's rows decode into
// one buffer of W4BUFW words (K(m) = W4BUFW / (N + 1) rows), one accumulator
// of N + 1 (a group's epilogue runs when the next group starts), and the x
// parts of planes 1 and 2 (planes 0 and 3 read xpart); the buffer also holds
// the epilogue's widened scales.
// Matrices m: 0 wqa, 1 wqv, 2 wv, 3 wo, 4 wgu, 5 wd.
const W4DH: u16 = Dc / 2;
const W4HD: u16 = Gs * Dc;
// Groups a PE's rows can touch: a run of Hc (Ic) consecutive input dims
// starting at a multiple of Hc (Ic), and the O rows' 2 Qh runs of DH dims
// (one group each when DH divides 64 and a half head starts on a group).
fn w4runs(n: u16) u16 {
  if (64 % n == 0) { return 1; }
  if (n % 64 == 0) { return n / 64; }
  return (n + 62) / 64 + 1;
}
const W4GH: u16 = w4runs(Hc);
const W4GD: u16 = w4runs(Ic);
const W4GO: u16 = if (64 % W4DH == 0 and (W4HD / 2) % 64 == 0) 2 * Qh else 2 * Qh * w4runs(W4DH);
const W4Rv = [6]u16 { Hc, Hc, Hc, Qh * Dc, Hc, Ic };
const W4Nv = [6]u16 { (Qh + 1) * W4DH, (Qh + 1) * W4DH, Dc, Hc, 2 * Ic, Hc };
const W4Gv = [6]u16 { W4GH, W4GH, W4GH, W4GO, W4GH, W4GD };
fn w4p(m: u16) u16 { return (W4Rv[m] + 3) / 4; }
// The decode buffer's budget (u16 words; spatial::u4::BUF_WORDS).
const W4BUFW: u16 = 1024;
// Plane rows a segment decodes at most.
fn w4k(m: u16) u16 {
  const k = W4BUFW / (W4Nv[m] + 1);
  if (k < 1) { return 1; }
  if (k > w4p(m)) { return w4p(m); }
  return k;
}
// Segment slots: K-row chunks of the 4 planes, split again at group starts.
fn w4segs(m: u16) u16 { return 4 * ((w4p(m) + w4k(m) - 1) / w4k(m)) + W4Gv[m] - 1; }
// Header words, a layer's words, a symbol's words (without the pad).
fn w4hdr(m: u16) u16 { return 2 + 4 * w4segs(m); }
fn w4lw(m: u16) u16 { return w4p(m) * (W4Nv[m] + 1) + 2 * W4Gv[m] * W4Nv[m]; }
fn w4blob_words(m: u16) u16 { return w4hdr(m) + W4L * w4lw(m); }
// The same per matrix as tables (wmv4's m is a runtime value: no divisions there).
const W4Pv = [6]u16 { w4p(0), w4p(1), w4p(2), w4p(3), w4p(4), w4p(5) };
const W4Hv = [6]u16 { w4hdr(0), w4hdr(1), w4hdr(2), w4hdr(3), w4hdr(4), w4hdr(5) };
const W4LWv = [6]u16 { w4lw(0), w4lw(1), w4lw(2), w4lw(3), w4lw(4), w4lw(5) };
const W4HM: u16 = w4mx(w4mx(w4mx(w4hdr(0), w4hdr(2)), w4mx(w4hdr(3), w4hdr(4))), w4hdr(5));
fn w4mx(a: u16, b: u16) u16 { return if (a > b) a else b; }
const W4B0: u16 = w4blob_words(0);
const W4B1: u16 = w4blob_words(1);
const W4B2: u16 = w4blob_words(2);
const W4B3: u16 = w4blob_words(3);
const W4B4: u16 = w4blob_words(4);
const W4B5: u16 = w4blob_words(5);
fn w4bw(m: u16) u16 { return w4k(m) * (W4Nv[m] + 1); }
const W4NM: u16 = w4mx(w4mx(W4Nv[0], W4Nv[3]), W4Nv[4]);
// The buffer also holds a group's scales and biases widened to f32 (4 N words).
const W4PL: u16 = w4mx(w4mx(w4mx(w4mx(w4bw(0), w4bw(2)), w4mx(w4bw(3), w4bw(4))), w4bw(5)), 4 * W4NM);
const W4AC: u16 = w4mx(W4NM, w4mx(W4Nv[2], W4Nv[5])) + 1;
//@@ fns
// u4 scratch: the segment's decoded rows (u16 codes, then bf16 in place), one
// group accumulator, x's parts scaled for planes 1 and 2 (planes 0-2 are
// masked, not shifted: plane k decodes to q 16^k, its x parts are x 16^-k,
// exactly; plane 3 is shifted, so planes 0 and 3 read x's parts in xpart).
var w4pl: [W4PL + 1]u16 align(16) = @zeros([W4PL + 1]u16);
var w4acc: [W4AC]f32 align(16) = @zeros([W4AC]f32);
const W4XP: u16 = NP * XMAX;
var w4xp = @zeros([2 * W4XP]@fp16());
// The buffer as f32 (a group's [scales | biases] widened in the epilogue: the
// widen is 0 + h * 1, exact). A zero-stride zero source instead of the
// zeroing crashed the simulator once the scratch sat above byte 0x8000.
var w4fdummy = @zeros([1]f32);
var w4f_d = @get_dsd(mem1d_dsd, .{ .base_address = &w4fdummy, .extent = 2 * W4NM });
var w4lay: u16 = 0;                   // the unit's current layer
var w4pl_u = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{W4PL} -> w4pl[i + 1] });
var w4pl_h = @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = W4PL });
var w4u_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{W4PL} -> w4pl[i + 1] });
var w4h_d = @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = W4PL });
const w4acc_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{W4AC} -> w4acc[i] });
const w4xp_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{W4XP} -> w4xp[i] });
const w4mask = [3]u16 { 0x000f, 0x00f0, 0x0f00 };
const w4inv = [3]f32 { 1.0, 0.0625, 0.00390625 };
fn w4_rebase() void {
  w4pl_h = @set_dsd_base_addr(w4pl_h, @ptrcast([*]@fp16(), &w4pl[1]));
  w4f_d = @set_dsd_base_addr(w4f_d, @ptrcast([*]f32, &w4pl[0]));
}
fn w4blob(m: u16) [*]u16 {
  if (m == 0) { return @ptrcast([*]u16, &wqa[1]); }
  if (m == 1) { return @ptrcast([*]u16, &wqv[1]); }
  if (m == 2) { return @ptrcast([*]u16, &wv[1]); }
  if (m == 3) { return @ptrcast([*]u16, &wo[1]); }
  if (m == 4) { return @ptrcast([*]u16, &wgu[1]); }
  return @ptrcast([*]u16, &wd[1]);
}
// The tile's header, copied by a DSD op before each matvec: only the host
// writes the weight symbols, so scalar reads of them straight from the code
// could fold to their zero initial values (seen on the simulator: a
// one-call-site wmv4 read nseg 0).
var w4hd = @zeros([W4HM]u16);
const w4hd_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{W4HM} -> w4hd[i] });
fn w4at(bp: [*]u16, off: u16, n: u16) mem1d_dsd {
  return @set_dsd_length(@set_dsd_base_addr(w4u_d, @ptrcast([*]u16, &bp[off])), n);
}
fn w4ath(bp: [*]u16, off: u16, n: u16) mem1d_dsd {
  return @set_dsd_length(@set_dsd_base_addr(w4h_d, @ptrcast([*]@fp16(), &bp[off])), n);
}
// Plane pk's x part k from row r0, ln rows.
fn w4part(pk: u16, k: u16, r0: u16, ln: u16) mem1d_dsd {
  if (pk == 1 or pk == 2) {
    return @set_dsd_length(@increment_dsd_offset(w4xp_d, @as(i16, (pk - 1) * W4XP + k * XMAX + r0), @fp16()), ln);
  }
  return @set_dsd_length(@increment_dsd_offset(xpart_dsd, @as(i16, k * XMAX + r0), @fp16()), ln);
}
// y += s_g acc + b_g sum_g(x); so: group g's [scales | biases]. Runs between
// segments, so the decode buffer is free for the widened [s | b].
fn w4epi(y: mem1d_dsd, bp: [*]u16, so: u16, N: u16) void {
  const sbf = @set_dsd_length(w4f_d, 2 * N);
  @fmovs(sbf, 0.0);
  @fmachs(sbf, sbf, w4ath(bp, so, 2 * N), @as(@fp16(), 1.0));
  const accg = @set_dsd_length(w4acc_d, N);
  @fmuls(accg, accg, @set_dsd_length(w4f_d, N));
  @fadds(y, y, accg);
  @fmacs(y, y, @set_dsd_length(@increment_dsd_offset(w4f_d, @as(i16, N), f32), N), w4acc[N]);
}
// y += A x for matrix m's u4 tile (x: its R rows; scr: 2R f32 words). wqv
// and wv (m 1, 2) follow wqa on the same x: they reuse its parts.
fn wmv4(y: mem1d_dsd, m: u16, xv: mem1d_dsd, scr: mem1d_dsd) void {
  const R = W4Rv[m];
  const N = W4Nv[m];
  const N1 = N + 1;
  const bp = w4blob(m);
  @mov16(@set_dsd_length(w4hd_d, W4Hv[m]), w4at(bp, 0, W4Hv[m]));
  const hd = &w4hd;
  const nseg = hd.*[1];
  const lb = W4Hv[m] + w4lay * W4LWv[m];
  if (m != 1 and m != 2) {
    // x's bf16 parts (as mvany), then each scaled for planes 1 and 2.
    const res = @set_dsd_length(scr, R);
    const tmp = @set_dsd_length(at(scr, R), R);
    @fmovs(res, xv);
    var k: u16 = 0;
    while (k < NP) : (k += 1) {
      const part = w4part(0, k, 0, R);
      @fs2h(part, res);
      if (k + 1 < NP) {
        @fh2s(tmp, part);
        @fsubs(res, res, tmp);
      }
      @fmulh(w4part(1, k, 0, R), part, @as(@fp16(), w4inv[1]));
      @fmulh(w4part(2, k, 0, R), part, @as(@fp16(), w4inv[2]));
    }
  }
  const acc = @set_dsd_length(w4acc_d, N1);
  @fmovs(acc, 0.0);
  // Segment s: [woff, ln, r0, pk << 8 | g] at bp[2 + 4 s] (codes at lb + woff).
  var cur: u16 = hd.*[5] & 0xff;
  var so: u16 = lb + W4Pv[m] * N1 + 2 * N * cur;
  var s: u16 = 0;
  while (s < nseg) : (s += 1) {
    const sp = 2 + 4 * s;
    const ln = hd.*[sp + 1];
    const r0 = hd.*[sp + 2];
    const pg = hd.*[sp + 3];
    if ((pg & 0xff) != cur) {
      w4epi(y, bp, so, N);
      @fmovs(acc, 0.0);
      cur += 1;
      so += 2 * N;
    }
    const pk = pg >> 8;
    const n = ln * N1;
    const src = w4at(bp, lb + hd.*[sp], n);
    const plu = @set_dsd_length(w4pl_u, n);
    if (pk == 3) {
      @slr16(plu, src, @as(u16, 12));
    } else {
      @and16(plu, src, w4mask[pk]);
    }
    @xp162fh(@set_dsd_length(w4pl_h, n), plu);
    const row = @set_dsd_length(w4pl_h, N1);
    var k: u16 = 0;
    while (k < NP) : (k += 1) {
      @load_to_dsr(mv_dest, acc, .{ .save_address = false });
      @load_to_dsr(mv_src0, acc, .{ .save_address = false });
      @load_to_dsr(mv_src1, row, .{ .save_address = true });
      @map(mv16_step, w4part(pk, k, r0, ln));
    }
  }
  w4epi(y, bp, so, N);
}
