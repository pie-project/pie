// gemma4_fast: gemma4_layer (below) with the 8B speed levers ported, each a
// bit of G4F (0: gemma4_layer's arithmetic and collectives):
//   1  exp by range reduction (exp_fast) in the softmax and GELU;
//   2  LSE softmax: p = exp(min(s - mref, 75)) against the previous token's
//      log-sum-exp (mref, a layer's own per lane and head), the sums riding
//      in the values' all-reduce, no max all-reduce; a pass whose sum leaves
//      [2^-80, 2^101) moves mref by ln(sum) and runs the attention again
//      (scores on), at most 7 times; every PE sees the same sums, so the
//      decision is the grid's (needs 1);
//   4  q/k/v sums of squares ride in the scores' all-reduce (scores from the
//      unscaled q, k; q's and the current key's scales applied after it);
//   8  PLE: the context projection and the table row ride in the QKV
//      all-reduce, the context norm's sums in the scores' all-reduce (needs
//      4), the gate's partials in the MLP's and its output norm's
//      all-reduces (linear in x);
//   16 the shared tail's kv rides in the QKV all-reduce;
//   32 the PLE's output norm deferred to the next layer: a layer below the
//      last sends x' = x scal, u = scal g5 hv and hv's sums of squares a row
//      beside x; the next one projects x' and u apart (W x = W x' + s W u),
//      s from the sums riding in its QKV all-reduce, x's own sums by
//      expansion (needs 8).
// gemma4_layer: a Gemma 4 dense layer over qwen2d_paged's grid (below).
// Against qwen35_attn: no attention gates; v RMS-normed per head without a
// weight; the attention's and the MLP's outputs RMS-normed (gamma3, gamma4)
// before their residual adds; a GELU-tanh GLU; the per-layer embedding
// (PC > 0): the token's row of the layer's table arrives gathered (prow,
// column c its PC dims; the head region holds the tables), joined with the context
// projection of x0 (the embedding, beside x) and the gate's partials, the
// context half normed over the PLE width, gelu(gate) * mix projected back,
// normed (gamma5) and added; then x scales by the layer's scalar. OWN 0: the
// layer takes its k and v (normed, turned) from kvi (the shared tail);
// SHARE 1: it leaves them in kvo. The placement carries the rest: the
// softmax scale of 1 is q's norm weights without the kernels' 1/sqrt(d), a
// partial RoPE a turn of zero, the PLE scales folded into wpm, the gathered row and pnw.
//
// qwen2d_paged: the batched qwen2d layer (qwen2d_batch v2) over a paged KV pool,
// for continuous batching with PIE's page model. B lanes a pass, each its own
// position and page table; lanes of different sequences, and the rows of a
// prefill chunk (lanes of one sequence at consecutive positions sharing its
// pages), run in one pass.
//
// Pool: physical page g (PS positions) lives whole on row g % P, as KV block
// g / P of that row (NB blocks a PE); each column holds its kv dims of it.
// Keys block-major, then dim-major ([blk][d][PS]); values [blk][PS][d]. A
// page is one contiguous per-PE block, so a lane's attention costs a matvec
// per page it uses, on the page's row.
//
// A pass's tables (one row-broadcast H2D): every lane's position, and for this
// row each lane's entries (block, logical page), at most E a lane. Position p
// of a lane is page p / PS, offset p % PS (PIE's KvDelta.pages). A page's
// valid length is min(PS, pos + 1 - page·PS): causality, prefill chunks and a
// truncate (the runtime's smaller `held`) need nothing else. copy_kv is
// copy_page(src, dst), a block copy down each column.
param memcpy_params;
param P: u16;
param Hc: u16;
param Dc: u16;
param Gs: u16;
param Ic: u16;
param PS: u16;         // page size (positions)
param NB: u16;         // KV blocks a PE (pool pages = NB · P)
param E: u16;          // entries a lane a row (its pages on this row, at most)
param B: u16;          // lanes a pass
param MC: u16;         // lanes an MLP chunk (B % MC == 0): gate/up and act hold MC lanes
param Qh: u16;         // query heads a kv head
param OWN: u16;        // 1: the layer computes its k and v
param SHARE: u16;      // 1: its k and v go to kvo
param PC: u16;         // PLE dims a column (0: no PLE)
param W16: u16 = 1;    // 1: bf16 weights (u16 storage)
param NP: u16 = 3;     // bf16 parts of x in a W16 matvec (3: exact)
param G1: u16 = 0;     // the all-reduces' phase-1 group along an axis (0: Gs; else a divisor of P, Gs == P)
param WIN: u32 = 0;    // a sliding layer's window: a lane at write slot w sees slots (w - WIN, w] (0: all)
param G4F: u16 = 0;    // the speed levers (see the top)
param c_r1_0: color;
param c_r1_1: color;
param c_r2_0: color;
param c_r2_1: color;
param c_bc: color;
param c_gb: color;     // unused: the group broadcast rides on c_bc
param c_cp: color;     // unused: page copies ride on c_bc (queue 2 stays free)

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const timestamp = @import_module("<time>");
const math = @import_module("<math>");
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;

const HID: f32 = @as(f32, P * Hc);
const HD: f32 = @as(f32, Gs * Dc);   // head_dim
const EPS: f32 = 1.0e-6;
// The all-reduces' groups: Gs PEs (a kv head's columns: allreduce_seg's),
// or G1 where one kv head spans the grid (the segment is then the row).
const GA: u16 = if (G1 == 0) Gs else G1;
comptime { @comptime_assert(GA == Gs or (Gs == P and P % GA == 0)); }
const R1: u16 = GA / 2;              // phase-1 root within a group
const NG: u16 = P / GA;              // groups along an axis
const R2: u16 = (NG / 2) * GA + R1;  // phase-2 root
const NH1: u16 = Qh + 1;             // [q heads | k] a lane, each in two halves
const DH: u16 = Dc / 2;
const FEXP: bool = (G4F & 1) != 0;
const FLSE: bool = (G4F & 2) != 0;
const FQKN: bool = (G4F & 4) != 0;
const FPLE: bool = (G4F & 8) != 0 and PC > 0;
const FKV: bool = (G4F & 16) != 0 and OWN == 0;
const FDEF: bool = (G4F & 32) != 0;
comptime {
  @comptime_assert(!FLSE or FEXP);
  @comptime_assert(!FQKN or B == 1);       // only a lane's own key is scaled after the scores
  @comptime_assert(!FPLE or Gs == P);      // the scores' all-reduce spans the row
  @comptime_assert((G4F & 8) == 0 or FQKN);
  @comptime_assert(!FDEF or (FPLE and B == 1));
}

// ---------------------------------------------------------------- collectives
// Two-phase grouped all-reduce (WaferLLM comm_pe.csl, in f32): phase 1 chains
// each group of Gs PEs from both ends into its root, phase 2 chains the group
// roots into R2, then R2 broadcasts. Along X, "seg" stops after phase 1 and
// each group root broadcasts within its group (a kv head's columns).
const q_r1_0_in = @get_input_queue(3);
const q_r1_0_out = @get_output_queue(3);
const q_r1_1_in = @get_input_queue(4);
const q_r1_1_out = @get_output_queue(4);
const q_r2_0_in = @get_input_queue(5);
const q_r2_0_out = @get_output_queue(5);
const q_r2_1_in = @get_input_queue(6);
const q_r2_1_out = @get_output_queue(6);
const q_bc_in = @get_input_queue(7);
const q_bc_out = @get_output_queue(7);
// Queue 2 is free (the group broadcast and page copies ride on c_bc): a
// pipeline ring's handoff takes it (qwen2d_pring).

fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}

var px: u16 = 0;
var py: u16 = 0;

// Routes are written as raw color-config words from runtime directions (one
// copy of the code; <tile_config>'s reset_routes needs comptime directions and
// cost ~1.1 KB a specialization). Directions: 0 ramp, 1 north, 2 south, 3 east,
// 4 west.
const tgt = tile_config.target;
const D_RAMP: u16 = 0;
const D_N: u16 = 1;
const D_S: u16 = 2;
const D_E: u16 = 3;
const D_W: u16 = 4;
// The config bits of each direction, indexed by D_*.
const rx_bits = [5]tgt.reg_type { @get_int(tgt.fabric_io.RX_RAMP), @get_int(tgt.fabric_io.RX_NORTH),
  @get_int(tgt.fabric_io.RX_SOUTH), @get_int(tgt.fabric_io.RX_EAST), @get_int(tgt.fabric_io.RX_WEST) };
const tx_bits = [5]tgt.reg_type { @get_int(tgt.fabric_io.TX_RAMP), @get_int(tgt.fabric_io.TX_NORTH),
  @get_int(tgt.fabric_io.TX_SOUTH), @get_int(tgt.fabric_io.TX_EAST), @get_int(tgt.fabric_io.TX_WEST) };
var rxt = rx_bits;
var txt = tx_bits;
fn rxw(d: u16) tgt.reg_type { return rxt[d]; }
fn txw(d: u16) tgt.reg_type { return txt[d]; }
// c: rx from one direction, tx to t1 (and t2 when t2 != t1).
fn set_route(c: color, rx: u16, t1: u16, t2: u16) void {
  const addr = color_config.get_color_config_addr(c);
  var r = @get_config(addr, tgt.color_addr_range);
  r = r & @get_int(tgt.fabric_io.CLEAR_MASK);
  r = r | rxw(rx) | txw(t1) | txw(t2);
  @set_config(addr, r, tgt.color_addr_range);
}

// Phase 1 within a group of Gs along the axis: chains from both ends into R1
// (even and odd positions alternate the two colors so a PE never forwards on
// the color it receives on).
fn route_phase1(H: u16, T: u16, r: u16) void {
  const ev = r % 2 == 0;
  const ca = if (ev) c_r1_0 else c_r1_1;
  const cb = if (ev) c_r1_1 else c_r1_0;
  if (r == R1) {
    set_route(ca, H, D_RAMP, D_RAMP);
    set_route(cb, T, D_RAMP, D_RAMP);
  } else if (r < R1) {
    set_route(ca, H, D_RAMP, D_RAMP);
    set_route(cb, D_RAMP, T, T);
  } else {
    set_route(cb, T, D_RAMP, D_RAMP);
    set_route(ca, D_RAMP, H, H);
  }
}

fn route_phase2(H: u16, T: u16, id: u16) void {
  const qt = id / GA;
  const r = id % GA;
  const ev = qt % 2 == 0;
  const ca = if (ev) c_r2_0 else c_r2_1;
  const cb = if (ev) c_r2_1 else c_r2_0;
  if (id == R2) {
    set_route(ca, H, D_RAMP, D_RAMP);
    set_route(cb, T, D_RAMP, D_RAMP);
  } else if (id < R2) {
    if (r == R1) {
      set_route(ca, H, D_RAMP, D_RAMP);
      set_route(cb, D_RAMP, T, T);
    } else {
      set_route(c_r2_0, H, T, T);
      set_route(c_r2_1, H, T, T);
    }
  } else {
    if (r == R1) {
      set_route(cb, T, D_RAMP, D_RAMP);
      set_route(ca, D_RAMP, H, H);
    } else {
      set_route(c_r2_0, T, H, H);
      set_route(c_r2_1, T, H, H);
    }
  }
}

fn route_bcast(H: u16, T: u16, id: u16, last: u16) void {
  if (id == R2) {
    set_route(c_bc, D_RAMP, H, T);
  } else if (id < R2) {
    if (id == 0) { set_route(c_bc, T, D_RAMP, D_RAMP); }
    else { set_route(c_bc, T, H, D_RAMP); }
  } else {
    if (id == last) { set_route(c_bc, H, D_RAMP, D_RAMP); }
    else { set_route(c_bc, H, D_RAMP, T); }
  }
}

// The group broadcast (segment all-reduce along X) on c_bc.
fn route_gbcast() void {
  const r = px % Gs;
  if (r == R1) {
    set_route(c_bc, D_RAMP, D_W, if (R1 == Gs - 1) D_W else D_E);
  } else if (r < R1) {
    if (r == 0) { set_route(c_bc, D_E, D_RAMP, D_RAMP); }
    else { set_route(c_bc, D_E, D_W, D_RAMP); }
  } else {
    if (r == Gs - 1) { set_route(c_bc, D_W, D_RAMP, D_RAMP); }
    else { set_route(c_bc, D_W, D_RAMP, D_E); }
  }
}

var axis_x: bool = false;
var axis_id: u16 = 0;
fn set_axis(x: bool) void {
  const h = if (x) D_W else D_N;
  const t = if (x) D_E else D_S;
  const id = if (x) px else py;
  route_phase1(h, t, id % GA);
  route_phase2(h, t, id);
  route_bcast(h, t, id, P - 1);
  axis_x = x;
  axis_id = id;
}
fn axis_y() void { set_axis(false); }
fn axis_xx() void { set_axis(true); }

// dst = a op b, op: sum or max.
fn op_in(is_max: bool, buf: mem1d_dsd, comptime q: input_queue, n: u16) void {
  if (is_max) { @fmaxs(buf, buf, fin(q, n)); } else { @fadds(buf, buf, fin(q, n)); }
}
fn op_fwd(is_max: bool, comptime qo: output_queue, comptime qi: input_queue,
          buf: mem1d_dsd, n: u16) void {
  if (is_max) { @fmaxs(fout(qo, n), fin(qi, n), buf); } else { @fadds(fout(qo, n), fin(qi, n), buf); }
}

fn phase1(is_max: bool, buf: mem1d_dsd, n: u16) void {
  const r = axis_id % GA;
  if (r == R1) {
    if (R1 < GA - 1) { op_in(is_max, buf, q_r1_0_in, n); }
    op_in(is_max, buf, q_r1_1_in, n);
  } else if (r > R1) {
    if (r % 2 == 0) {
      if (r == GA - 1) { @fmovs(fout(q_r1_0_out, n), buf); }
      else { op_fwd(is_max, q_r1_0_out, q_r1_1_in, buf, n); }
    } else {
      if (r == GA - 1) { @fmovs(fout(q_r1_1_out, n), buf); }
      else { op_fwd(is_max, q_r1_1_out, q_r1_0_in, buf, n); }
    }
  } else {
    if (r % 2 == 0) {
      if (r == 0) { @fmovs(fout(q_r1_1_out, n), buf); }
      else { op_fwd(is_max, q_r1_1_out, q_r1_0_in, buf, n); }
    } else {
      op_fwd(is_max, q_r1_0_out, q_r1_1_in, buf, n);
    }
  }
}

fn phase2(is_max: bool, buf: mem1d_dsd, n: u16) void {
  const id = axis_id;
  const r = id % GA;
  const qt = id / GA;
  if (id == R2) {
    if (R2 < P - GA) { op_in(is_max, buf, q_r2_0_in, n); }
    op_in(is_max, buf, q_r2_1_in, n);
  } else if (id > R2) {
    if (r == R1) {
      if (id > P - GA - 1) {
        if (qt % 2 == 0) { @fmovs(fout(q_r2_0_out, n), buf); }
        else { @fmovs(fout(q_r2_1_out, n), buf); }
      } else {
        if (qt % 2 == 0) { op_fwd(is_max, q_r2_0_out, q_r2_1_in, buf, n); }
        else { op_fwd(is_max, q_r2_1_out, q_r2_0_in, buf, n); }
      }
    }
  } else {
    if (r == R1) {
      if (id < GA) { @fmovs(fout(q_r2_1_out, n), buf); }
      else {
        if (qt % 2 == 0) { op_fwd(is_max, q_r2_1_out, q_r2_0_in, buf, n); }
        else { op_fwd(is_max, q_r2_0_out, q_r2_1_in, buf, n); }
      }
    }
  }
}

// Sum (or max) of buf over the current axis, left in buf on every PE.
fn allreduce(is_max: bool, buf: mem1d_dsd, n: u16) void {
  phase1(is_max, buf, n);
  if (NG > 1) { phase2(is_max, buf, n); }
  if (axis_id == R2) { @fmovs(fout(q_bc_out, n), buf); }
  else { @fmovs(buf, fin(q_bc_in, n)); }
}

// Sum of buf over this PE's group of Gs columns (axis X).
fn allreduce_seg(buf: mem1d_dsd, n: u16) void {
  if (GA != Gs) {
    // One kv head spans the row (Gs == P): the row's all-reduce.
    allreduce(false, buf, n);
    return;
  }
  phase1(false, buf, n);
  route_gbcast();                       // c_bc: the group's broadcast for now
  if (px % Gs == R1) { @fmovs(fout(q_bc_out, n), buf); }
  else { @fmovs(buf, fin(q_bc_in, n)); }
  route_bcast(D_W, D_E, px, P - 1);     // back to the X axis's broadcast
}


// Trip counts read at runtime (an exported array the compiler cannot fold),
// so per-lane loops are not unrolled: unrolled, the code grew ~0.9 KB a lane.
var dims = @zeros([5]u16);           // B, E, TC, 2B, MC: set in init
var dims_ptr: [*]u16 = &dims;

// ---------------------------------------------------------------- state
const DHc: u16 = Dc / 2;
const N2B: u16 = Qh * B;           // (lane, head) pairs
const TC: u16 = E * PS;            // a lane's score slots a row: entry e, offset o
const NS: u16 = TC * N2B;          // scores a PE: [t][b][h], t = e·PS + o
const iN2B: i16 = @as(i16, N2B);
const iB: i16 = @as(i16, B);
const iDc: i16 = @as(i16, Dc);
const NONE: u32 = 0xffffffff;
const GU1: u16 = 2 * Ic + 1;

fn at(d: mem1d_dsd, off: u16) mem1d_dsd {
  return @increment_dsd_offset(d, @as(i16, off), f32);
}

// A pass's tables: positions [B], entries' blocks [B][E], their logical pages [B][E].
// A pass's tables: RoPE positions [B], KV write slots [B], and for this row
// each lane's entries: blocks [B][E], logical pages [B][E], visibility
// bitmaps [B][E] (bit o: the lane sees slot page·PS + o). A lane's write slot
// and RoPE position differ for beams (siblings rotate alike, write apart); the
// bitmaps say which cells a lane attends (causal prefixes, a beam's ancestors,
// a sink + window).
const NTAB: u16 = 2 * B + 3 * B * E;
var tab = @zeros([NTAB]u32);
var tab_ptr: [*]u32 = &tab;
fn wslot(b: u16) u32 { return tab[B + b]; }
fn eblk(b: u16, e: u16) u32 { return tab[2 * B + b * E + e]; }
fn epg(b: u16, e: u16) u32 { return tab[2 * B + B * E + b * E + e]; }
fn ebits(b: u16, e: u16) u32 {
  if (tab[2 * B + b * E + e] == NONE) { return 0; }
  return tab[2 * B + 2 * B * E + b * E + e];
}
// The next decode position: RoPE position and write slot a step on, the new
// slot made visible on the row that holds its page (the host gives every page
// a launch's steps reach, with its bits for the slots before).
fn advance(b: u16) void {
  tab[b] += 1;
  tab[B + b] += 1;
  const ws = tab[B + b];
  const pg = ws / @as(u32, PS);
  var e: u16 = 0;
  while (e < dims[1]) : (e += 1) {
    if (eblk(b, e) != NONE and epg(b, e) == pg) {
      tab[2 * B + 2 * B * E + b * E + e] |= @as(u32, 1) << @as(u16, ws % @as(u32, PS));
    }
  }
}

// The sliding window (WIN > 0): the lane's bits below its write slot's
// window cleared on this row's entries, every pass (advance only adds bits).
fn clip_window(b: u16) void {
  const ws = tab[B + b];
  if (ws < WIN) { return; }
  const lo = ws + 1 - WIN;             // the first slot it sees
  var e: u16 = 0;
  while (e < dims[1]) : (e += 1) {
    if (eblk(b, e) != NONE) {
      const p0 = epg(b, e) * @as(u32, PS);
      const at = 2 * B + 2 * B * E + b * E + e;
      if (p0 + @as(u32, PS) <= lo) { tab[at] = 0; }
      else if (p0 < lo) { tab[at] &= ~((@as(u32, 1) << @as(u16, lo - p0)) - 1); }
    }
  }
}

var x = @zeros([B * Hc]f32);
var x_ptr: [*]f32 = &x;
const x_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> x[i] });
const x_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> x[i] });
var gamma1 = @zeros([Hc]f32);
var gamma1_ptr: [*]f32 = &gamma1;
const g1_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gamma1[i] });
var gamma2 = @zeros([Hc]f32);
var gamma2_ptr: [*]f32 = &gamma2;
const g2_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gamma2[i] });
// The sandwich norms' weights (attention out, MLP out, PLE out) and the
// layer's scalar.
var gamma3 = @zeros([Hc]f32);
var gamma3_ptr: [*]f32 = &gamma3;
const g3_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gamma3[i] });
var gamma4 = @zeros([Hc]f32);
var gamma4_ptr: [*]f32 = &gamma4;
const g4_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gamma4[i] });
var gamma5 = @zeros([Hc]f32);
var gamma5_ptr: [*]f32 = &gamma5;
const g5_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gamma5[i] });
var scal = @zeros([1]f32);
var scal_ptr: [*]f32 = &scal;
// The shared tail's k and v [b][k Dc | v Dc].
var kvi = @zeros([B * 2 * Dc]f32);
var kvi_ptr: [*]f32 = &kvi;
var kvo = @zeros([B * 2 * Dc]f32);
var kvo_ptr: [*]f32 = &kvo;
// PLE: the embedding x0 [b][Hc], the lanes' tokens, the context projection
// (wpm, Hc x PC), the gate (wpg, Hc x PC), the projection back (wpp, PC x
// Hc) and the PLE norm's weights [PC].
const PCn: u16 = if (PC > 0) PC else 1;
// Weight storage and the W16 matvec's scratch (x's f32 remainder, its bf16
// parts), after qwen35_attn's.
const WST = if (W16 == 1) u16 else f32;
var wdummy = @zeros([1]@fp16());
fn mx2(a: u16, b: u16) u16 { return if (a > b) a else b; }
const XMAX: u16 = mx2(mx2(Hc, Qh * Dc), mx2(Ic, PCn));
const XM: u16 = if (W16 == 1) XMAX else 1;
var xs32 = @zeros([XM]f32);
var xt32 = @zeros([XM]f32);
var xpart = @zeros([NP * XM]@fp16());
const xs_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XM} -> xs32[i] });
const xt_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XM} -> xt32[i] });
const xpart_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XM} -> xpart[i] });
var x0 = @zeros([B * Hc]f32);
var x0_ptr: [*]f32 = &x0;
const x0_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> x0[i] });
// The token's PLE row for this layer, this column's PC dims [b][PC] (the
// head region holds the tables and gathers it; the handoff brings it).
var prow = @zeros([B * PCn]f32);
var prow_ptr: [*]f32 = &prow;
const prow_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * PCn} -> prow[i] });
var wpm: [Hc * PCn + 1]WST align(16) = @zeros([Hc * PCn + 1]WST);
var wpm_ptr: [*]WST = &wpm;
var wpm_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = PCn })
              else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PCn} -> wpm[i + 1] });
var wpg: [Hc * PCn + 1]WST align(16) = @zeros([Hc * PCn + 1]WST);
var wpg_ptr: [*]WST = &wpg;
var wpg_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = PCn })
              else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PCn} -> wpg[i + 1] });
var wpp: [PCn * Hc + 1]WST align(16) = @zeros([PCn * Hc + 1]WST);
var wpp_ptr: [*]WST = &wpp;
var wpp_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = Hc })
              else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> wpp[i + 1] });
var pnw = @zeros([PCn]f32);
var pnw_ptr: [*]f32 = &pnw;
const pnw_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PCn} -> pnw[i] });
// [relay | table row | gate] [3][b][PC], summed down the columns; the PLE
// norm's sums [B]; GELU's scratch [B][PC].
var pl = @zeros([3 * B * PCn]f32);
const pl_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{3 * B * PCn} -> pl[i] });
const pl_lane = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PCn} -> pl[i] });
var pss = @zeros([B]f32);
const pss_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B} -> pss[i] });
const NBP: u16 = B * PCn;
var p1 = @zeros([NBP]f32);
var p2 = @zeros([NBP]f32);
var p3 = @zeros([NBP]f32);
var p4 = @zeros([NBP]f32);
const p1_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NBP} -> p1[i] });
const p2_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NBP} -> p2[i] });
const p3_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NBP} -> p3[i] });
const p4_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NBP} -> p4[i] });
const pr_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NBP} -> pl[i] });
const pt_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NBP} -> pl[@as(i16, NBP) + i] });
const pg_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NBP} -> pl[2 * @as(i16, NBP) + i] });
var hss = @zeros([B]f32);
const hss_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B} -> hss[i] });
// x * gamma, a lane at a time (in sv: free in phases 0 and 10–11).
const xn_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> sv[i] });

var wqa: [Hc * NH1 * DHc + 1]WST align(16) = @zeros([Hc * NH1 * DHc + 1]WST);
var wqa_ptr: [*]WST = &wqa;
var wqa_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = NH1 * DHc })
              else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH1 * DHc} -> wqa[i + 1] });
var wqv: [Hc * NH1 * DHc + 1]WST align(16) = @zeros([Hc * NH1 * DHc + 1]WST);
var wqv_ptr: [*]WST = &wqv;
var wqv_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = NH1 * DHc })
              else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH1 * DHc} -> wqv[i + 1] });
var wv: [Hc * Dc + 1]WST align(16) = @zeros([Hc * Dc + 1]WST);
var wv_ptr: [*]WST = &wv;
var wv_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = Dc })
              else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> wv[i + 1] });
// QKV payload: first halves of q a, q b, k [b][3][DH], second halves, v [b][Dc],
// x's sums of squares [b].
const QH: u16 = NH1 * B * DHc;
const QKN: u16 = 2 * QH;
const QKV_N: u16 = QKN + B * Dc + B;
// (G4F 8) the PLE context's partials and the table row [2][b][PC], (G4F 16)
// the tail's kv [b][2 Dc], after it in the QKV all-reduce.
const QX_P: u16 = QKV_N;
const QX_K: u16 = QX_P + (if (FPLE) 2 * B * PCn else 0);
// (G4F 32) after them: the projections of u [QKN + B Dc] and the sums
// [b][x'x', x'u, uu, hv's].
const QX_D: u16 = QX_K + (if (FKV) B * 2 * Dc else 0);
const QX_S: u16 = QX_D + (if (FDEF) QKN + B * Dc else 0);
const QKV_X: u16 = QX_S + (if (FDEF) 4 * B else 0);
// (G4F 32) the deferred norm's u and hv's sums of squares (the handoff's).
var g4u = @zeros([if (FDEF) B * Hc else 1]f32);
var g4ss = @zeros([if (FDEF) B else 1]f32);
const g4u_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> g4u[i] });
const g4ss_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B} -> g4ss[i] });
const qx_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QKN + B * Dc} -> qkv[@as(i16, QX_D) + i] });
const qx_a = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QKN + B * Dc} -> qkv[i] });
var qkv: [QKV_X]f32 align(16) = @zeros([QKV_X]f32);
const qkvx_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QKV_X} -> qkv[i] });
const qx_ctx = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PCn} -> qkv[@as(i16, QX_P) + i] });
const qx_trow = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * PCn} -> qkv[@as(i16, QX_P + B * PCn) + i] });
const qx_pl = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * B * PCn} -> qkv[@as(i16, QX_P) + i] });
const qx_kv = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * 2 * Dc} -> qkv[@as(i16, QX_K) + i] });
const qh_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH1 * DHc} -> qkv[i] });
const half_a = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QH} -> qkv[i] });
const half_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QH} -> qkv[@as(i16, QH) + i] });
const v_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> qkv[@as(i16, QKN) + i] });
const qkv_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QKV_N} -> qkv[i] });
const qk_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QKN} -> qkv[i] });
const qkv_ssq = @get_dsd(mem1d_dsd, .{ .tensor_access = |b|{B} -> qkv[@as(i16, QKN + B * Dc) + b] });
const qd_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DHc} -> qkv[i] });
// q/k norm weights [half][q a, q b, k][DH] (1/sqrt(head_dim) in q's), applied a lane at a time.
var qkn_w = @zeros([NH1 * Dc]f32);
var qkn_w_ptr: [*]f32 = &qkn_w;
const qkn_a = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH1 * DHc} -> qkn_w[i] });
const qkn_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH1 * DHc} -> qkn_w[@as(i16, NH1 * DHc) + i] });
// q/k sums of squares [b·3] (all-reduced over the kv head's columns), then
// their RMS scales, applied a head at a time over both halves.
var ssq3 = @zeros([(NH1 + 1) * B]f32);
const ssq3_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH1 * B} -> ssq3[i] });
const ssq4_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{(NH1 + 1) * B} -> ssq3[i] });
fn scl_t() mem4d_dsd { return @get_dsd(mem4d_dsd, .{ .tensor_access = |k, j|{NH1 * B, DHc} -> ssq3[k] }); }
fn sq_t() mem4d_dsd { return @get_dsd(mem4d_dsd, .{ .tensor_access = |k, j|{NH1 * B, DHc} -> act[j * @as(i16, NH1) * iB + k] }); }
fn sqx_t() mem4d_dsd { return @get_dsd(mem4d_dsd, .{ .tensor_access = |b, i|{B, Hc} -> act[i * iB + b] }); }
const sqx_b = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B} -> act[i] });

// The pool.
var kc: [NB * Dc * PS + 1]f32 align(16) = @zeros([NB * Dc * PS + 1]f32);
var kc_ptr: [*]f32 = &kc;
const kc_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PS} -> kc[i + 1] });
var vc: [NB * PS * Dc + 1]f32 align(16) = @zeros([NB * PS * Dc + 1]f32);
var vc_ptr: [*]f32 = &vc;
const vc_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> vc[i + 1] });
const kblk_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc * PS} -> kc[i + 1] });
const vblk_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PS * Dc} -> vc[i + 1] });

// (G4F 4) the q/k/v sums of squares [(NH1 + 1) B], (G4F 8) the PLE
// context's [B], after the scores in their all-reduce.
const NSQ: u16 = if (FQKN) (NH1 + 1) * B + (if (FPLE) B else 0) else 0;
var s: [NS + NSQ]f32 align(16) = @zeros([NS + NSQ]f32);
const sx_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NS + NSQ} -> s[i] });
const ssq_tail = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{(NH1 + 1) * B} -> s[@as(i16, NS) + i] });
const s_scores = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NS} -> s[i] });
const sa_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |t|{PS} -> s[t * iN2B] });     // a page's run, lane 0 head a
const NSR: u16 = if (NS > QH) NS else QH;
const SVN: u16 = if (QH > B * Hc) QH else B * Hc;
var sv = @zeros([SVN]f32);        // RoPE's scratch; x * gamma
const ETN: u16 = if (NSR > B * Hc) NSR else B * Hc;
var et = @zeros([ETN]f32);        // the softmax's trees; RoPE's scratch; hv
const et_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NS} -> et[i] });

var bcv = @zeros([N2B]f32);
const bcv_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |j|{N2B} -> bcv[j] });
const srow_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |j|{N2B} -> s[j] });
// Softmax all-reduces: the maxes, then the sums, [2B].
var red = @zeros([N2B]f32);
const red_2b = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{N2B} -> red[i] });
var fallbacks = @zeros([1]u32);   // kept for the interface (always 0: one path)
var fallbacks_ptr: [*]u32 = &fallbacks;

// (o in act: free in phases 6–8.)
const o_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Qh * Dc} -> act[i] });
const o_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Qh * Dc} -> act[i] });
const oa_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> act[i] });

var wo: [Qh * Dc * Hc + 1]WST align(16) = @zeros([Qh * Dc * Hc + 1]WST);
var wo_ptr: [*]WST = &wo;
var wo_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = Hc })
              else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> wo[i + 1] });
// (hv in et: free in phases 8–9 and 14–15.)
const hv_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> et[i] });
const hv_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> et[i] });

var wgu: [Hc * 2 * Ic + 1]WST align(16) = @zeros([Hc * 2 * Ic + 1]WST);
var wgu_ptr: [*]WST = &wgu;
var wgu_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = 2 * Ic })
              else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * Ic} -> wgu[i + 1] });
// The MLP runs MC lanes at a time: gate/up partials [MC][2·Ic + x's sum of
// squares], act [MC][Ic]; the down partials of every lane gather in hv for
// one all-reduce. (For 8B, gate/up + act are ~0.9 KB a lane.)
// (G4F 8) the PLE gate's partials at x (after the attention) [b][PC] after
// the first chunk's.
const GUX: u16 = if (FPLE) B * PCn else 0;
var gu: [MC * GU1 + GUX]f32 align(16) = @zeros([MC * GU1 + GUX]f32);
const gux_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC * GU1 + GUX} -> gu[i] });
const gux_t = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * PCn} -> gu[@as(i16, MC * GU1) + i] });
const gu_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * Ic} -> gu[i] });
const gu_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC * GU1} -> gu[i] });
var xss = @zeros([B]f32);            // x's sums of squares (the second RMSNorm), every lane
const xss_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B} -> xss[i] });
const ACT0: u16 = if (MC * Ic > QH) MC * Ic else QH;
const ACT1: u16 = if (ACT0 > B * Hc) ACT0 else B * Hc;
const ACT2: u16 = if (FLSE) B * Qh * Dc + Qh * B else B * Qh * Dc;   // (LSE) o, then its sums
const ACTN: u16 = if (ACT1 > ACT2) ACT1 else ACT2;
var act: [ACTN]f32 align(16) = @zeros([ACTN]f32);
const act_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> act[i] });
const act_mc = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC * Ic} -> act[i] });
const act_col = @get_dsd(mem1d_dsd, .{ .tensor_access = |b|{MC} -> act[b * @as(i16, Ic)] });
var ta = @zeros([B]f32);
var tt = @zeros([B]f32);
var te = @zeros([B]f32);
var tr = @zeros([B]f32);
var td = @zeros([B]f32);
const ta_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> ta[i] });
const tt_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> tt[i] });
const te_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> te[i] });
const tr_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> tr[i] });
const td_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> td[i] });

var wd: [Ic * Hc + 1]WST align(16) = @zeros([Ic * Hc + 1]WST);
var wd_ptr: [*]WST = &wd;
var wd_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = Hc })
              else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> wd[i + 1] });

// ---------------------------------------------------------------- compute
const mv_dest = @get_dsr(dsr_dest, 1);
const mv_src0 = @get_dsr(dsr_src0, 1);
const mv_src1 = @get_dsr(dsr_src1, 1);
fn mv_step(xv: f32) void {
  @fmacs(mv_dest, mv_src0, mv_src1, xv);
}
fn matvec(y: mem1d_dsd, a: mem1d_dsd, xv: mem1d_dsd) void {
  @load_to_dsr(mv_dest, y, .{ .save_address = false });
  @load_to_dsr(mv_src0, y, .{ .save_address = false });
  @load_to_dsr(mv_src1, a, .{ .save_address = true });
  @map(mv_step, xv);
}
// 16-bit weights (W16): x split into NP bf16 parts (exact at NP 3), each part
// one @fmachs pass over the bf16 rows (qwen2d_paged8b's matvec).
fn mv16_step(xv: @fp16()) void {
  @fmachs(mv_dest, mv_src0, mv_src1, xv);
}
fn xsplit(xv: mem1d_dsd, n: u16) void {
  const res = @set_dsd_length(xs_d, n);
  const tmp = @set_dsd_length(xt_d, n);
  @fmovs(res, xv);
  var k: u16 = 0;
  while (k < NP) : (k += 1) {
    const part = @set_dsd_length(@increment_dsd_offset(xpart_d, @as(i16, k * XM), @fp16()), n);
    @fs2h(part, res);
    if (k + 1 < NP) {
      @fh2s(tmp, part);
      @fsubs(res, res, tmp);
    }
  }
}
// y += A x over x's parts as `xsplit` left them (n of x's elements).
fn mvparts(y: mem1d_dsd, a: mem1d_dsd, n: u16) void {
  var k: u16 = 0;
  while (k < NP) : (k += 1) {
    const part = @set_dsd_length(@increment_dsd_offset(xpart_d, @as(i16, k * XM), @fp16()), n);
    @load_to_dsr(mv_dest, y, .{ .save_address = false });
    @load_to_dsr(mv_src0, y, .{ .save_address = false });
    @load_to_dsr(mv_src1, a, .{ .save_address = true });
    @map(mv16_step, part);
  }
}
// y += A x for a weight matrix A: f32 rows, or (W16) bf16 rows.
fn wmv(y: mem1d_dsd, a: mem1d_dsd, xv: mem1d_dsd, n: u16) void {
  if (W16 == 0) {
    matvec(y, a, xv);
  } else {
    xsplit(xv, n);
    mvparts(y, a, n);
  }
}
fn rsqrt(v: f32) f32 {
  var y = @bitcast(f32, @as(u32, 0x5f3759df) - (@bitcast(u32, v) >> 1));
  const h = 0.5 * v;
  y = y * (1.5 - h * y * y);
  y = y * (1.5 - h * y * y);
  y = y * (1.5 - h * y * y);
  return y;
}
fn recip(v: f32) f32 {
  const r = rsqrt(v);
  return r * r;
}
fn rms_scale(sum: f32, n: f32) f32 {
  return rsqrt(sum * (1.0 / n) + EPS);
}
fn ln_approx(v: f32) f32 {
  return (@as(f32, @bitcast(u32, v)) * (1.0 / 8388608.0) - 127.0) * 0.6931472;
}
// buf [n][m] (n a power of two) halved over n in place: buf[0..m) = the
// sums (or maxes). One runtime instance.
fn halve(buf: mem1d_dsd, n: u16, m: u16, is_max: bool) void {
  var k = n;
  while (k > 1) {
    if (k % 2 == 1) {
      const r0 = @set_dsd_length(buf, m);
      const rl = @set_dsd_length(at(buf, (k - 1) * m), m);
      if (is_max) { @fmaxs(r0, r0, rl); } else { @fadds(r0, r0, rl); }
      k -= 1;
    }
    const half = k / 2;
    const lo = @set_dsd_length(buf, half * m);
    const hi = @set_dsd_length(at(buf, half * m), half * m);
    if (is_max) { @fmaxs(lo, lo, hi); } else { @fadds(lo, lo, hi); }
    k = half;
  }
}
fn x_ssq(dst: mem1d_dsd) void {
  @fmuls(sqx_t(), x_all, x_all);
  halve(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> act[i] }), Hc, B, false);
  @fmovs(dst, sqx_b);
}

// Each lane's position this pass; RoPE cos/sin [b][3][DH], once a launch, then
// advanced a position a pass.
var cur = @zeros([B]u32);
const NR: u16 = QH;
// RoPE: cos/sin(p · f_j) for this column's DH frequencies, built each pass for
// every lane from three tables of 16 (p = 256a + 16b + c, positions < 4096;
// the host's at load, a column its own) by two angle additions. Lane b's are
// laid out [b][3 heads][DH] (replicated over q a, q b, k) for the vector RoPE.
const ROT_L: u16 = 16;
var rot_c = @zeros([3 * ROT_L * DHc]f32);   // [level][16][DH]
var rot_c_ptr: [*]f32 = &rot_c;
var rot_s = @zeros([3 * ROT_L * DHc]f32);
var rot_s_ptr: [*]f32 = &rot_s;
var rc = @zeros([NR]f32);
var rs = @zeros([NR]f32);
const rc_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NR} -> rc[i] });
const rs_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NR} -> rs[i] });
const r1_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NR} -> sv[i] });
const r2_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NR} -> et[i] });
const r3_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NR} -> act[i] });
fn rope_tables() void {
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    const p_ = cur[b];
    const ia = @as(u16, (p_ / 256) % ROT_L) * DHc;
    const ib = (ROT_L + @as(u16, (p_ / 16) % ROT_L)) * DHc;
    const ic = (2 * ROT_L + @as(u16, p_ % ROT_L)) * DHc;
    var j: u16 = 0;
    while (j < DHc) : (j += 1) {
      const c1 = rot_c[ia + j] * rot_c[ib + j] - rot_s[ia + j] * rot_s[ib + j];
      const s1 = rot_s[ia + j] * rot_c[ib + j] + rot_c[ia + j] * rot_s[ib + j];
      const c = c1 * rot_c[ic + j] - s1 * rot_s[ic + j];
      const sn = s1 * rot_c[ic + j] + c1 * rot_s[ic + j];
      var h: u16 = 0;
      while (h < NH1) : (h += 1) {
        rc[(b * NH1 + h) * DHc + j] = c;
        rs[(b * NH1 + h) * DHc + j] = sn;
      }
    }
  }
}
fn rope_all() void {
  @fmuls(r1_d, half_a, rc_d);
  @fmuls(r2_d, half_v, rs_d);
  @fsubs(r1_d, r1_d, r2_d);
  @fmuls(r2_d, half_v, rc_d);
  @fmuls(r3_d, half_a, rs_d);
  @fadds(r2_d, r2_d, r3_d);
  @fmovs(half_a, r1_d);
  @fmovs(half_v, r2_d);
}
// exp(v/256)'s degree-7 Taylor coefficients after 1/5040 (runtime loops: the
// unrolled form cost ~1.5 KB of code at each use).
var exp_coeffs = [7]f32 { 1.0 / 720.0, 1.0 / 120.0, 1.0 / 24.0, 1.0 / 6.0, 0.5, 1.0, 1.0 };
// buf = exp(buf) for buf <= 0 (or -1e30): exp(v/256) by the polynomial, squared 8 times.
fn exp_poly(buf: mem1d_dsd, tmp: mem1d_dsd) void {
  @fmaxs(tmp, buf, -88.0);
  @fmuls(tmp, tmp, 0.00390625);
  @fmovs(buf, 1.0 / 5040.0);
  var c: u16 = 0;
  while (c < 7) : (c += 1) {
    @fmuls(buf, buf, tmp);
    @fadds(buf, buf, exp_coeffs[c]);
  }
  c = 0;
  while (c < 8) : (c += 1) { @fmuls(buf, buf, buf); }
}
fn exp_inplace(buf: mem1d_dsd, tmp: mem1d_dsd) void { exp_poly(buf, tmp); }
// (G4F 1) exp(buf) in place by range reduction (the 8B kernels' exp_fast):
// x = max(buf, -80) = k ln2 + r, k = round(x log2 e) by the 1.5 2^23 shift
// (its low 16 bits), r in [-ln2/2, ln2/2]; e^r by a degree-6 Taylor
// polynomial (Horner; relative error < 2e-7) in p (n words at pb), times 2^k
// by adding k << 7 to p's high halves; kk (n u16) holds k << 7.
const ex_a = [3]f32 { 12582912.0, -12582912.0, 12582912.0 };
const ex_c = [6]f32 { 1.0 / 120.0, 1.0 / 24.0, 1.0 / 6.0, 0.5, 1.0, 1.0 };
fn exp_fast(buf: mem1d_dsd, p: mem1d_dsd, pb: [*]f32, kk0: mem1d_dsd, n: u16) void {
  const kk = @set_dsd_length(kk0, n);
  const pl = @set_dsd_length(@set_dsd_stride(@set_dsd_base_addr(kk0, @ptrcast([*]u16, pb)), 2), n);
  const ph = @increment_dsd_offset(pl, 1, u16);
  @fmaxs(buf, buf, -80.0);
  @fmuls(p, buf, 1.4426950408889634);
  var c: u16 = 0;
  while (c < 3) : (c += 1) {
    @fadds(p, p, ex_a[c]);               // t; then k as a float; then t again
    if (c == 1) { @fmacs(buf, buf, p, -0.6931471805599453); }   // r = x - k ln2
  }
  @sll16(kk, pl, 7);
  @fmuls(p, buf, 1.0 / 720.0);
  c = 0;
  while (c < 6) : (c += 1) {
    if (c > 0) { @fmuls(p, p, buf); }
    @fadds(p, p, ex_c[c]);
  }
  @add16(ph, ph, kk);
  @fmovs(buf, p);
}
// exp_fast's k words: the softmax's (NS, on gu's memory: free in the
// attention, else its own) and GELU's (MC lanes or the PLE's NBP).
const EKG: u16 = if (MC > B * PC) MC else B * PC;
var ekg = @zeros([EKG]u16);
var ekg_d = @get_dsd(mem1d_dsd, .{ .base_address = &ekg[0], .extent = EKG });
// gelu(g) · u over a column of MC lanes: gelu(g) = (g + |g| tanh|z|) / 2,
// z = sqrt(2/pi) (g + 0.044715 g^3), tanh|z| = (1 - e) / (1 + e) at
// e = exp(-2|z|) (1/(1 + e) by Newton, as silu's).
fn gelu_t(g: mem1d_dsd, u: mem1d_dsd, out: mem1d_dsd, ta: mem1d_dsd, tt: mem1d_dsd, te: mem1d_dsd,
          tr: mem1d_dsd, td: mem1d_dsd, ttb: [*]f32, n: u16) void {
  @fmuls(ta, g, g);
  @fmuls(ta, ta, 0.044715);
  @fadds(ta, ta, 1.0);
  @fmuls(ta, ta, g);
  @fabss(ta, ta);
  @fmuls(te, ta, -1.5957691216057308);
  if (FEXP) { exp_fast(te, tt, ttb, ekg_d, n); } else { exp_poly(te, tt); }   // e = exp(-2|z|)
  @fadds(td, te, 1.0);
  @fmuls(tr, td, -0.47058823529411764);
  @fadds(tr, tr, 1.411764705882353);
  var it: u16 = 0;
  while (it < 3) : (it += 1) {
    @fmuls(tt, td, tr);
    @fnegs(tt, tt);
    @fadds(tt, tt, 2.0);
    @fmuls(tr, tr, tt);
  }
  @fnegs(tt, te);
  @fadds(tt, tt, 1.0);
  @fmuls(tt, tt, tr);             // tanh|z|
  @fabss(ta, g);
  @fmuls(tt, tt, ta);
  @fadds(tt, tt, g);
  @fmuls(tt, tt, 0.5);
  @fmuls(out, tt, u);
}
// Element e of every chunk lane's gate and up, gathered first: their lane
// stride (2·Ic + 1) overflows a DSD's 8-bit stride at Gemma's widths.
var gcol = @zeros([MC]f32);
var ucol = @zeros([MC]f32);
const gcol_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> gcol[i] });
const ucol_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC} -> ucol[i] });
fn gelu_col(e: u16) void {
  var k: u16 = 0;
  while (k < dims[4]) : (k += 1) {
    gcol[k] = gu[k * GU1 + e];
    ucol[k] = gu[k * GU1 + Ic + e];
  }
  gelu_t(gcol_d, ucol_d, at(act_col, e), ta_d, tt_d, te_d, tr_d, td_d, &tt, MC);
}

// hv (B lanes of Hc, every column alike) RMS-normed over the hidden size
// (its sums of squares summed down the rows) and scaled by gam.
fn hv_norm(gam: mem1d_dsd) void {
  @fmuls(sqx_t(), hv_all, hv_all);
  halve(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> act[i] }), Hc, B, false);
  @fmovs(hss_dsd, sqx_b);
  axis_y();
  allreduce(false, hss_dsd, B);
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    const hb = at(hv_dsd, b * Hc);
    @fmuls(hb, hb, rms_scale(hss[b], HID));
    @fmuls(hb, hb, gam);
  }
}

// (G4F 8) hv_norm with the PLE gate's partials at its normed hv riding in
// its all-reduce: [the sums of squares B | wpg (gam hv) NBP]; after it the
// gate (pg) = its partials at x (pg, from the MLP's all-reduce) + the rms
// scale times these (wpg x is linear: x + s gam hv).
var hgb = @zeros([if (FPLE) B + B * PCn else 1]f32);
const hgb_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B + B * PCn} -> hgb[i] });
const hgb_ss = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B} -> hgb[i] });
const hgb_g = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PCn} -> hgb[@as(i16, B) + i] });
fn hv_norm_g(gam: mem1d_dsd) void {
  @fmuls(sqx_t(), hv_all, hv_all);
  halve(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> act[i] }), Hc, B, false);
  @fmovs(hgb_ss, sqx_b);
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    @fmovs(at(hgb_g, b * PCn), 0.0);
    @fmuls(at(xn_dsd, 0), at(hv_dsd, b * Hc), gam);
    wmv(at(hgb_g, b * PCn), wpg_dsd, at(xn_dsd, 0), Hc);
  }
  axis_y();
  allreduce(false, hgb_all, B + B * PCn);
  b = 0;
  while (b < dims[0]) : (b += 1) {
    const hb = at(hv_dsd, b * Hc);
    const sc = rms_scale(hgb[b], HID);
    @fmuls(hb, hb, sc);
    @fmuls(hb, hb, gam);
    const gl = at(pg_d, b * PCn);
    @fmacs(@set_dsd_length(gl, PCn), @set_dsd_length(gl, PCn), at(hgb_g, b * PCn), sc);
  }
}

// (G4F 8) the PLE from the gathered context (pr), table row (pt), gate (pg)
// and the context's sums of squares (pss): norm, mix, gelu(gate) mix
// projected back, summed across the row, normed and added.
fn ple_fast() void {
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    const rl = at(pl_lane, b * PCn);
    @fmuls(rl, rl, rms_scale(qsc[(NH1 + 1) * B + b], @as(f32, P * PC)));
    @fmuls(rl, rl, pnw_dsd);
  }
  @fadds(pr_d, pr_d, pt_d);
  gelu_t(pg_d, pr_d, pt_d, p1_d, p2_d, p3_d, p4_d, @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NBP} -> sv[i] }), &p2, NBP);
  @fmovs(hv_all, 0.0);
  b = 0;
  while (b < dims[0]) : (b += 1) { wmv(at(hv_dsd, b * Hc), wpp_dsd, at(pl_lane, NBP + b * PCn), PC); }
  axis_xx();
  allreduce(false, hv_all, B * Hc);
  if (FDEF and L + 1 < NL) {
    // (G4F 32) the next layer norms it: u = scal g5 hv, hv's sums a row.
    @fmuls(sqx_t(), hv_all, hv_all);
    halve(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> act[i] }), Hc, B, false);
    @fmovs(g4ss_dsd, sqx_b);
    @fmuls(g4u_all, hv_all, g5_dsd);
    @fmuls(g4u_all, g4u_all, scal[0]);
  } else {
    hv_norm(g5_dsd);
    @fadds(x_all, x_all, hv_all);
  }
}

// The per-layer embedding (after the MLP's residual): the context
// projection of x0, the token's table row and the gate's partials summed
// down the columns; the context half RMS-normed over the PLE width (summed
// across the row); gelu(gate) · (relay + row) projected back, summed across
// the row, normed and added.
fn ple() void {
  axis_y();
  @fmovs(pl_all, 0.0);
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    wmv(at(pl_lane, b * PCn), wpm_dsd, at(x0_dsd, b * Hc), Hc);
    wmv(at(pl_lane, 2 * NBP + b * PCn), wpg_dsd, at(x_dsd, b * Hc), Hc);
  }
  // The token's table row (this column's PC dims, gathered by the head into
  // prow) joins the sum on row 0 only.
  if (py == 0) { @fmovs(pt_d, prow_d); }
  allreduce(false, pl_all, 3 * NBP);
  @fmuls(p1_d, pr_d, pr_d);
  b = 0;
  while (b < dims[0]) : (b += 1) {
    var v: f32 = 0.0;
    var c: u16 = 0;
    while (c < PC) : (c += 1) { v += p1[b * PCn + c]; }
    pss[b] = v;
  }
  axis_xx();
  allreduce(false, pss_dsd, B);
  b = 0;
  while (b < dims[0]) : (b += 1) {
    const rl = at(pl_lane, b * PCn);
    @fmuls(rl, rl, rms_scale(pss[b], @as(f32, P * PC)));
    @fmuls(rl, rl, pnw_dsd);
  }
  @fadds(pr_d, pr_d, pt_d);       // mix (the 1/sqrt 2 is in pnw and the row)
  gelu_t(pg_d, pr_d, pt_d, p1_d, p2_d, p3_d, p4_d, @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NBP} -> sv[i] }), &p2, NBP);
  @fmovs(hv_all, 0.0);
  b = 0;
  while (b < dims[0]) : (b += 1) { wmv(at(hv_dsd, b * Hc), wpp_dsd, at(pl_lane, NBP + b * PCn), PC); }
  allreduce(false, hv_all, B * Hc);
  hv_norm(g5_dsd);
  @fadds(x_all, x_all, hv_all);
}

// ---------------------------------------------------------------- profile
const NPROF: u16 = 16;
var prof = @zeros([NPROF]u32);
var prof_ptr: [*]u32 = &prof;
var t_mark = @zeros([timestamp.tsc_size_words]u16);
var t_now = @zeros([timestamp.tsc_size_words]u16);
var timing: bool = false;
fn tsc(t: *[timestamp.tsc_size_words]u16) u64 {
  return @as(u64, t.*[0]) | (@as(u64, t.*[1]) << 16) | (@as(u64, t.*[2]) << 32);
}
fn mark(slot: u16) void {
  timestamp.get_timestamp(&t_now);
  if (timing) { prof[slot] += @as(u32, (tsc(&t_now) - tsc(&t_mark)) & 0xffffffff); }
  t_mark = t_now;
}

fn bcast(comptime is_mul: bool) void {
  var t: u16 = 0;
  while (t < dims[2]) : (t += 1) {
    const r = at(srow_dsd, t * N2B);
    if (is_mul) { @fmuls(r, r, bcv_dsd); } else { @fsubs(r, r, bcv_dsd); }
  }
}
// (G4F 1) the softmax's k words: on gu (free in the attention) when it holds
// NS u16, else their own (init sets the base).
const EKS_GU: bool = MC * (2 * Ic + 1) * 2 >= NS;
var eks_own = @zeros([if (EKS_GU or !FEXP) 1 else NS]u16);
var eks_d = @get_dsd(mem1d_dsd, .{ .base_address = &eks_own[0], .extent = 1 });
// (G4F 2) the reference a lane and head: the previous pass's log-sum-exp.
var mref = @zeros([if (FLSE) N2B else 1]f32);
const mref_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |j|{N2B} -> mref[j] });
const o_l = @get_dsd(mem1d_dsd, .{ .tensor_access = |j|{N2B} -> act[@as(i16, B * Qh * Dc) + j] });
const o_lall = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{ACT2} -> act[i] });
fn exp_sums() void {
  bcast(false);
  if (FEXP) { exp_fast(s_scores, et_dsd, &et, eks_d, NS); }
  else { exp_inplace(s_scores, et_dsd); }       // invalid slots: exp(-1e31) ~ 1e-38
  @fmovs(et_dsd, s_scores);
  halve(et_dsd, TC, N2B, false);
  @fmovs(red_2b, @set_dsd_length(et_dsd, N2B));
}

// (G4F 4) after the scores' all-reduce: the q/k/v rms scales (qsc) and the
// PLE context's sums of squares; q's onto every score; on the first pass the
// current key's onto its own score, and the current key and value in the
// pool (and qkv, then kvo for a source) scaled.
var qsc = @zeros([if (FQKN) NSQ else 1]f32);
fn qkn_post(first: bool) void {
  var k: u16 = 0;
  while (k < (NH1 + 1) * B) : (k += 1) { qsc[k] = rms_scale(s[NS + k], HD); }
  if (FPLE) {
    k = 0;
    while (k < B) : (k += 1) { qsc[(NH1 + 1) * B + k] = s[NS + (NH1 + 1) * B + k]; }
  }
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    var h: u16 = 0;
    while (h < Qh) : (h += 1) { bcv[Qh * b + h] = qsc[b * NH1 + h]; }
  }
  bcast(true);
  if (!first or OWN == 0) { return; }
  b = 0;
  while (b < dims[0]) : (b += 1) {
    const sk = qsc[b * NH1 + Qh];
    const svv = qsc[NH1 * B + b];
    const pg = wslot(b) / @as(u32, PS);
    const oo = @as(u16, wslot(b) % @as(u32, PS));
    var e: u16 = 0;
    while (e < dims[1]) : (e += 1) {
      if (eblk(b, e) != NONE and epg(b, e) == pg) {
        const blk = @as(u16, eblk(b, e));
        const t = (e * PS + oo) * N2B + Qh * b;
        var h: u16 = 0;
        while (h < Qh) : (h += 1) { s[t + h] *= sk; }
        var d: u16 = 0;
        while (d < Dc) : (d += 1) {
          kc[1 + blk * Dc * PS + d * PS + oo] *= sk;
          vc[1 + blk * PS * Dc + oo * Dc + d] *= svv;
        }
      }
    }
    var d: u16 = 0;
    while (d < Dc) : (d += 1) {
      const kidx = (if (d < DHc) 0 else QH) + (NH1 * b + Qh) * DHc + d % DHc;
      qkv[kidx] *= sk;
      qkv[QKN + b * Dc + d] *= svv;
      if (SHARE == 1) {
        kvo[b * 2 * Dc + d] = qkv[kidx];
        kvo[b * 2 * Dc + Dc + d] = qkv[QKN + b * Dc + d];
      }
    }
  }
}

// KV append at the lanes' write slots (keys final under G4F 0; unscaled under 4).
fn kv_append() void {
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    const pg = wslot(b) / @as(u32, PS);
    const oo = @as(u16, wslot(b) % @as(u32, PS));
    var e: u16 = 0;
    while (e < dims[1]) : (e += 1) {
      if (eblk(b, e) != NONE and epg(b, e) == pg) {
        const blk = @as(u16, eblk(b, e));
        var d: u16 = 0;
        while (d < Dc) : (d += 1) {
          const kidx = (if (d < DHc) 0 else QH) + (NH1 * b + Qh) * DHc + d % DHc;
          kc[1 + blk * Dc * PS + d * PS + oo] = qkv[kidx];
          vc[1 + blk * PS * Dc + oo * Dc + d] = qkv[QKN + b * Dc + d];
        }
      }
    }
  }
}

fn scores() void {
  @fmovs(s_scores, -1.0e30);
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    const ha = NH1 * b * DHc;
    var e: u16 = 0;
    while (e < dims[1]) : (e += 1) {
      const bits = ebits(b, e);
      if (bits != 0) {
        const blk = @as(u16, eblk(b, e));
        const s0 = at(sa_dsd, e * PS * N2B + Qh * b);
        const kb = at(kc_dsd, blk * Dc * PS);
        const kv2 = at(kb, DHc * PS);
        var h: u16 = 0;
        while (h < Qh) : (h += 1) {
          const sh = at(s0, h);
          @fmovs(sh, 0.0);
          matvec(sh, kb, at(qd_dsd, ha + h * DHc));
          matvec(sh, kv2, at(qd_dsd, QH + ha + h * DHc));
        }
        if ((bits & (bits + 1)) == 0) {
          var v: u16 = 0;
          while (v < PS and ((bits >> v) & 1) == 1) : (v += 1) {}
          if (v < PS) {
            h = 0;
            while (h < Qh) : (h += 1) {
              @fmovs(@set_dsd_length(at(s0, v * N2B + h), PS - v), -1.0e30);
            }
          }
        } else {
          var o: u16 = 0;
          while (o < PS) : (o += 1) {
            if (((bits >> o) & 1) == 0) {
              const t = (e * PS + o) * N2B + Qh * b;
              h = 0;
              while (h < Qh) : (h += 1) { s[t + h] = -1.0e30; }
            }
          }
        }
      }
    }
  }
}
fn values() void {
  // 6: value partials a page at a time; 7: summed over the rows.
  if (FLSE) { @fmovs(o_lall, 0.0); } else { @fmovs(o_all, 0.0); }
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    var e: u16 = 0;
    while (e < dims[1]) : (e += 1) {
      if (ebits(b, e) != 0) {
        const blk = @as(u16, eblk(b, e));
        const vb = at(vc_dsd, blk * PS * Dc);
        const pa = at(sa_dsd, e * PS * N2B + Qh * b);
        var h: u16 = 0;
        while (h < Qh) : (h += 1) {
          matvec(at(oa_dsd, (b * Qh + h) * Dc), vb, at(pa, h));
        }
      }
    }
  }
}

// ---------------------------------------------------------------- the layer
fn layer() void {
  var b: u16 = 0;
  // 0–1: QKV partials (a lane at a time) and x's sums of squares; one
  // all-reduce over the rows; RMSNorm.
  axis_y();
  @fmovs(qkvx_all, 0.0);
  const defer = FDEF and L > 0;
  if (defer) {
    // (G4F 32) the deferred norm: u's projections at QX_D, the sums at QX_S.
    const ub = @set_dsd_length(et_dsd, Hc);
    @fmuls(ub, g4u_all, g1_dsd);
    xsplit(ub, Hc);
    mvparts(@increment_dsd_offset(qh_dsd, @as(i16, QX_D), f32), wqa_dsd, Hc);
    mvparts(@increment_dsd_offset(qh_dsd, @as(i16, QX_D + QH), f32), wqv_dsd, Hc);
    if (OWN == 1) { mvparts(@increment_dsd_offset(v_dsd, @as(i16, QX_D), f32), wv_dsd, Hc); }
    var sxx: f32 = 0.0;
    var sxu: f32 = 0.0;
    var suu: f32 = 0.0;
    var i: u16 = 0;
    while (i < Hc) : (i += 1) {
      sxx += x[i] * x[i];
      sxu += x[i] * g4u[i];
      suu += g4u[i] * g4u[i];
    }
    qkv[QX_S] = sxx;
    qkv[QX_S + 1] = sxu;
    qkv[QX_S + 2] = suu;
    qkv[QX_S + 3] = g4ss[0];
  }
  b = 0;
  while (b < dims[0]) : (b += 1) {
    const xb = at(xn_dsd, b * Hc);
    @fmuls(xb, at(x_dsd, b * Hc), g1_dsd);
    if (W16 == 1) {
      xsplit(xb, Hc);
      mvparts(at(qh_dsd, b * NH1 * DHc), wqa_dsd, Hc);
      mvparts(at(qh_dsd, QH + b * NH1 * DHc), wqv_dsd, Hc);
      mvparts(at(v_dsd, b * Dc), wv_dsd, Hc);
    } else {
      matvec(at(qh_dsd, b * NH1 * DHc), wqa_dsd, xb);
      matvec(at(qh_dsd, QH + b * NH1 * DHc), wqv_dsd, xb);
      matvec(at(v_dsd, b * Dc), wv_dsd, xb);
    }
  }
  if (FPLE) {
    // (G4F 8) the context projection of x0, and the table row on row 0.
    b = 0;
    while (b < dims[0]) : (b += 1) {
      wmv(at(qx_ctx, b * PCn), wpm_dsd, at(x0_dsd, b * Hc), Hc);
    }
    if (py == 0) { @fmovs(qx_trow, prow_d); }
  }
  if (FKV and px == py) {
    // (G4F 16) the tail's kv: its column's k and v, from the diagonal's row.
    b = 0;
    while (b < dims[0]) : (b += 1) {
      var d: u16 = 0;
      while (d < 2 * Dc) : (d += 1) { qkv[QX_K + b * 2 * Dc + d] = kvr[b * KVWn + KO + d]; }
    }
  }
  x_ssq(qkv_ssq);
  mark(0);
  allreduce(false, qkvx_all, QKV_X);
  if (defer) {
    const sd = rms_scale(qkv[QX_S + 3], HID);
    @fmacs(qx_a, qx_a, qx_d, sd);
    qkv[QKN + B * Dc] = qkv[QX_S] + sd * (2.0 * qkv[QX_S + 1] + sd * qkv[QX_S + 2]);
    @fmacs(x_all, x_all, g4u_all, sd);
  }
  if (FKV) { @fmovs(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * 2 * Dc} -> kvi[i] }), qx_kv); }
  if (FPLE) { @fmovs(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * NBP} -> pl[i] }), qx_pl); }
  b = 0;
  while (b < dims[0]) : (b += 1) {
    const sc = rms_scale(qkv[QKN + B * Dc + b], HID);
    const qa = at(qh_dsd, b * NH1 * DHc);
    const qv = at(qh_dsd, QH + b * NH1 * DHc);
    const vb = at(v_dsd, b * Dc);
    @fmuls(qa, qa, sc);
    @fmuls(qv, qv, sc);
    @fmuls(vb, vb, sc);
  }
  mark(1);
  if (FQKN) {
    // 2 (G4F 4): the q/k/v sums of squares (ssq3) kept for the scores'
    // all-reduce; norm weights and RoPE on the unscaled q and k; the kv
    // appended unscaled (the current key's and value's scales after it).
    @fmuls(r1_d, half_a, half_a);
    @fmuls(r2_d, half_v, half_v);
    @fadds(sq_t(), r1_d, r2_d);
    halve(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QH} -> act[i] }), DHc, NH1 * B, false);
    @fmovs(ssq3_dsd, @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH1 * B} -> act[i] }));
    b = 0;
    while (b < dims[0]) : (b += 1) {
      var vs: f32 = 0.0;
      var d: u16 = 0;
      while (d < Dc) : (d += 1) { vs += qkv[QKN + b * Dc + d] * qkv[QKN + b * Dc + d]; }
      ssq3[NH1 * B + b] = vs;
    }
    b = 0;
    while (b < dims[0]) : (b += 1) {
      const qa = at(qh_dsd, b * NH1 * DHc);
      const qv = at(qh_dsd, QH + b * NH1 * DHc);
      @fmuls(qa, qa, qkn_a);
      @fmuls(qv, qv, qkn_v);
    }
    rope_all();
    if (OWN == 0) {
      b = 0;
      while (b < dims[0]) : (b += 1) {
        var d: u16 = 0;
        while (d < Dc) : (d += 1) {
          const kidx = (if (d < DHc) 0 else QH) + (NH1 * b + Qh) * DHc + d % DHc;
          qkv[kidx] = kvi[b * 2 * Dc + d];
          qkv[QKN + b * Dc + d] = kvi[b * 2 * Dc + Dc + d];
        }
      }
    }
    kv_append();
    if (FPLE) {
      @fmuls(p1_d, pr_d, pr_d);
      b = 0;
      while (b < dims[0]) : (b += 1) {
        var v: f32 = 0.0;
        var c: u16 = 0;
        while (c < PC) : (c += 1) { v += p1[b * PCn + c]; }
        pss[b] = v;
      }
    }
  } else {
    // 2: q/k RMSNorm first (their sums of squares all-reduced over the kv head's
    // columns), then norm weights, RoPE, KV append: appended keys are final, so
    // lanes sharing a page see them in this same pass.
    @fmuls(r1_d, half_a, half_a);
    @fmuls(r2_d, half_v, half_v);
    @fadds(sq_t(), r1_d, r2_d);
    halve(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QH} -> act[i] }), DHc, NH1 * B, false);
    @fmovs(ssq3_dsd, @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NH1 * B} -> act[i] }));
    // v's sums of squares after q's and k's, its norm over the head too.
    b = 0;
    while (b < dims[0]) : (b += 1) {
      var vs: f32 = 0.0;
      var d: u16 = 0;
      while (d < Dc) : (d += 1) { vs += qkv[QKN + b * Dc + d] * qkv[QKN + b * Dc + d]; }
      ssq3[NH1 * B + b] = vs;
    }
    axis_xx();
    allreduce_seg(ssq4_dsd, (NH1 + 1) * B);
    var k: u16 = 0;
    while (k < NH1 * dims[0]) : (k += 1) { ssq3[k] = rms_scale(ssq3[k], HD); }
    b = 0;
    while (b < dims[0]) : (b += 1) {
      @fmuls(at(v_dsd, b * Dc), at(v_dsd, b * Dc), rms_scale(ssq3[NH1 * B + b], HD));
    }
    @fmuls(@get_dsd(mem4d_dsd, .{ .tensor_access = |kk, j|{NH1 * B, DHc} -> qkv[kk * @as(i16, DHc) + j] }),
           @get_dsd(mem4d_dsd, .{ .tensor_access = |kk, j|{NH1 * B, DHc} -> qkv[kk * @as(i16, DHc) + j] }), scl_t());
    @fmuls(@get_dsd(mem4d_dsd, .{ .tensor_access = |kk, j|{NH1 * B, DHc} -> qkv[@as(i16, QH) + kk * @as(i16, DHc) + j] }),
           @get_dsd(mem4d_dsd, .{ .tensor_access = |kk, j|{NH1 * B, DHc} -> qkv[@as(i16, QH) + kk * @as(i16, DHc) + j] }), scl_t());
    b = 0;
    while (b < dims[0]) : (b += 1) {
      const qa = at(qh_dsd, b * NH1 * DHc);
      const qv = at(qh_dsd, QH + b * NH1 * DHc);
      @fmuls(qa, qa, qkn_a);
      @fmuls(qv, qv, qkn_v);
    }
    rope_all();
    // The shared tail's k and v: in from kvi (OWN 0), out to kvo (SHARE 1),
    // [b][k Dc | v Dc] in the column's dims order.
    b = 0;
    while (b < dims[0]) : (b += 1) {
      var d: u16 = 0;
      while (d < Dc) : (d += 1) {
        const kidx = (if (d < DHc) 0 else QH) + (NH1 * b + Qh) * DHc + d % DHc;
        if (OWN == 0) {
          qkv[kidx] = kvi[b * 2 * Dc + d];
          qkv[QKN + b * Dc + d] = kvi[b * 2 * Dc + Dc + d];
        }
        if (SHARE == 1) {
          kvo[b * 2 * Dc + d] = qkv[kidx];
          kvo[b * 2 * Dc + Dc + d] = qkv[QKN + b * Dc + d];
        }
      }
    }
    kv_append();
  }
  mark(2);
  // 3: scores a page at a time ([t][b][h], t = e·PS + o); 4: summed over the
  // kv head's columns.
  // Every slot starts at -1e30; a visible entry's run is zeroed for its
  // matvecs, and its slots the lane does not see set back to -1e30 (summed
  // over the head's columns they stay ~-1e31: nothing in the softmax). A
  // bitmap that is a prefix (the usual causal case) takes two ops; any other
  // pattern a slot at a time.
  // 3-7: the attention from the scores on (G4F 2: again from a moved mref
  // while a pass's sums leave [2^-80, 2^101), at most 7 times).
  var redo: u16 = 0;
  while (true) {
    if (redo > 0 or FQKN) { axis_xx(); }
    scores();
    if (FQKN) {
      @fmovs(ssq_tail, ssq4_dsd);
      if (FPLE) {
        b = 0;
        while (b < dims[0]) : (b += 1) { s[NS + (NH1 + 1) * B + b] = pss[b]; }
      }
    }
    mark(3);
    if (FQKN) {
      allreduce_seg(sx_all, NS + NSQ);
      qkn_post(redo == 0);
    } else {
      allreduce_seg(s_scores, NS);
    }
    mark(4);
    axis_y();
    if (FLSE) {
      // 5: p = exp(min(s - mref, 75)), unnormalized; 6: the value partials
      // and p's sums (o_l); 7: both summed over the rows.
      @fmovs(bcv_dsd, mref_dsd);
      bcast(false);
      @fnegs(s_scores, s_scores);
      @fmaxs(s_scores, s_scores, -75.0);
      @fnegs(s_scores, s_scores);
      exp_fast(s_scores, et_dsd, &et, eks_d, NS);
      mark(5);
      values();
      @fmovs(et_dsd, s_scores);
      halve(et_dsd, TC, N2B, false);
      @fmovs(o_l, @set_dsd_length(et_dsd, N2B));
      mark(6);
      allreduce(false, o_lall, ACT2);
      mark(7);
      var bad = false;
      var j: u16 = 0;
      while (j < dims[3]) : (j += 1) {
        const l = act[B * Qh * Dc + j];
        if (!(l >= 8.271806e-25 and l < 2.5353012e30)) { bad = true; }
      }
      j = 0;
      if (bad and redo < 7) {
        while (j < dims[3]) : (j += 1) { mref[j] += ln_approx(act[B * Qh * Dc + j]); }
        redo += 1;
        continue;
      }
      while (j < dims[3]) : (j += 1) {
        const l = act[B * Qh * Dc + j];
        mref[j] += ln_approx(l);
        @fmuls(at(oa_dsd, j * Dc), at(oa_dsd, j * Dc), recip(l));
      }
    } else {
      // 5: softmax over every row's keys: each (lane, head)'s max all-reduced,
      // the exponentials and their sums, the sums all-reduced (one path).
      @fmovs(et_dsd, s_scores);
      halve(et_dsd, TC, N2B, true);
      @fmovs(red_2b, @set_dsd_length(et_dsd, N2B));
      allreduce(true, red_2b, N2B);
      @fmovs(bcv_dsd, red_2b);
      exp_sums();
      allreduce(false, red_2b, N2B);
      var j: u16 = 0;
      while (j < dims[3]) : (j += 1) { bcv[j] = recip(red[j]); }
      bcast(true);
      mark(5);
      values();
      mark(6);
      allreduce(false, o_all, B * Qh * Dc);
      mark(7);
    }
    break;
  }
  // 8–9: O projection, summed over the columns, residual.
  axis_xx();
  @fmovs(hv_all, 0.0);
  b = 0;
  while (b < dims[0]) : (b += 1) { wmv(at(hv_dsd, b * Hc), wo_dsd, at(o_dsd, b * Qh * Dc), Qh * Dc); }
  mark(8);
  allreduce(false, hv_all, B * Hc);
  hv_norm(g3_dsd);
  @fadds(x_all, x_all, hv_all);
  mark(9);
  // 10–14: the second RMSNorm and the MLP, MC lanes at a time: gate/up
  // partials, summed over the rows (with x's sums of squares), scaled; silu·u
  // (a row its share of the elements), summed over the rows; down partials
  // into hv. 15: hv summed over the columns, the residual.
  axis_y();
  x_ssq(xss_dsd);
  mark(10);
  @fmovs(hv_all, 0.0);
  var c0: u16 = 0;
  while (c0 < dims[0]) : (c0 += dims[4]) {
    var k: u16 = 0;
    while (k < dims[4]) : (k += 1) {
      const lb = c0 + k;
      @fmuls(at(xn_dsd, lb * Hc), at(x_dsd, lb * Hc), g2_dsd);
      const gb = at(gu_dsd, k * GU1);
      @fmovs(gb, 0.0);
      wmv(gb, wgu_dsd, at(xn_dsd, lb * Hc), Hc);
      gu[k * GU1 + 2 * Ic] = xss[lb];
    }
    if (FPLE and c0 == 0) {
      // (G4F 8) the PLE gate's partials at this x ride along.
      @fmovs(gux_t, 0.0);
      var b2: u16 = 0;
      while (b2 < dims[0]) : (b2 += 1) { wmv(at(gux_t, b2 * PCn), wpg_dsd, at(x_dsd, b2 * Hc), Hc); }
      allreduce(false, gux_all, MC * GU1 + GUX);
      @fmovs(pg_d, gux_t);
    } else {
      allreduce(false, gu_all, MC * GU1);
    }
    k = 0;
    while (k < dims[4]) : (k += 1) {
      const gb = at(gu_dsd, k * GU1);
      @fmuls(gb, gb, rms_scale(gu[k * GU1 + 2 * Ic], HID));
    }
    @fmovs(act_mc, 0.0);
    var el: u16 = py;
    while (el < Ic) : (el += P) { gelu_col(el); }
    allreduce(false, act_mc, MC * Ic);
    k = 0;
    while (k < dims[4]) : (k += 1) { wmv(at(hv_dsd, (c0 + k) * Hc), wd_dsd, at(act_dsd, k * Ic), Ic); }
  }
  mark(13);
  axis_xx();
  allreduce(false, hv_all, B * Hc);
  if (FPLE) { hv_norm_g(g4_dsd); } else { hv_norm(g4_dsd); }
  @fadds(x_all, x_all, hv_all);
  if (FPLE) { ple_fast(); } else
  if (PC > 0) { ple(); }
  @fmuls(x_all, x_all, scal[0]);
  mark(15);
}

fn init() void {
  if (W16 == 1) {
    wqa_dsd = @set_dsd_base_addr(wqa_dsd, @ptrcast([*]@fp16(), &wqa[1]));
    wqv_dsd = @set_dsd_base_addr(wqv_dsd, @ptrcast([*]@fp16(), &wqv[1]));
    wv_dsd = @set_dsd_base_addr(wv_dsd, @ptrcast([*]@fp16(), &wv[1]));
    wo_dsd = @set_dsd_base_addr(wo_dsd, @ptrcast([*]@fp16(), &wo[1]));
    wgu_dsd = @set_dsd_base_addr(wgu_dsd, @ptrcast([*]@fp16(), &wgu[1]));
    wd_dsd = @set_dsd_base_addr(wd_dsd, @ptrcast([*]@fp16(), &wd[1]));
    wpm_dsd = @set_dsd_base_addr(wpm_dsd, @ptrcast([*]@fp16(), &wpm[1]));
    wpg_dsd = @set_dsd_base_addr(wpg_dsd, @ptrcast([*]@fp16(), &wpg[1]));
    wpp_dsd = @set_dsd_base_addr(wpp_dsd, @ptrcast([*]@fp16(), &wpp[1]));
  }
  if (FEXP and EKS_GU) { eks_d = @set_dsd_base_addr(eks_d, @ptrcast([*]u16, &gu)); }
  dims[0] = B;
  dims[1] = E;
  dims[2] = TC;
  dims[3] = N2B;
  dims[4] = MC;
  px = layout_mod.get_x_coord();
  py = layout_mod.get_y_coord();
  route_gbcast();
  axis_y();
  sys_mod.unblock_cmd_stream();
}

// `steps` passes over the current tables; after each, every lane advances
// (decode: RoPE position and write slot a step on, the new slot visible).
// (the host gives pages covering every position the launch reaches).
// Profiled from the second pass.
fn compute(steps: u32) void {
  timestamp.enable_tsc();
  var i: u32 = 0;
  while (i < steps) : (i += 1) {
    var b: u16 = 0;
    if (i > 0) {
      while (b < dims[0]) : (b += 1) { advance(b); }
      b = 0;
    }
    while (b < dims[0]) : (b += 1) { cur[b] = tab[b]; }
    if (WIN > 0) {
      b = 0;
      while (b < dims[0]) : (b += 1) { clip_window(b); }
    }
    rope_tables();
    timing = i > 0;
    timestamp.get_timestamp(&t_mark);
    layer();
  }
  sys_mod.unblock_cmd_stream();
}

// copy_kv: pool page src's KV into page dst (whole pages), down each column on
// c_bc (its routes are the layer's again at the next axis switch):
// row src % P sends block src / P, row dst % P receives it into dst / P; the
// rows between pass it on. One page a launch (the launch is the barrier the
// routes need).
fn copy_page(src: u32, dst: u32) void {
  const rs_ = @as(u16, src % @as(u32, P));
  const rd = @as(u16, dst % @as(u32, P));
  const bs = @as(u16, src / @as(u32, P));
  const bd = @as(u16, dst / @as(u32, P));
  const kfrom = at(kblk_dsd, bs * Dc * PS);
  const vfrom = at(vblk_dsd, bs * PS * Dc);
  const kto = at(kblk_dsd, bd * Dc * PS);
  const vto = at(vblk_dsd, bd * PS * Dc);
  if (rs_ == rd) {
    if (py == rs_) {
      @fmovs(kto, kfrom);
      @fmovs(vto, vfrom);
    }
  } else {
    const down = rs_ < rd;
    const lo = if (down) rs_ else rd;
    const hi = if (down) rd else rs_;
    if (py >= lo and py <= hi) {
      const from = if (down) D_N else D_S;     // the data comes from upstream
      const to = if (down) D_S else D_N;
      if (py == rs_) { set_route(c_bc, D_RAMP, to, to); }
      else if (py == rd) { set_route(c_bc, from, D_RAMP, D_RAMP); }
      else { set_route(c_bc, from, to, to); }
    }
  }
  sys_mod.unblock_cmd_stream();
}
// Second half of a copy, after every PE on the path has its route (a launch
// apart): the sender sends, the receiver takes.
fn copy_move(src: u32, dst: u32) void {
  const rs_ = @as(u16, src % @as(u32, P));
  const rd = @as(u16, dst % @as(u32, P));
  if (rs_ != rd) {
    const bs = @as(u16, src / @as(u32, P));
    const bd = @as(u16, dst / @as(u32, P));
    if (py == rs_) {
      @fmovs(fout(q_bc_out, Dc * PS), at(kblk_dsd, bs * Dc * PS));
      @fmovs(fout(q_bc_out, PS * Dc), at(vblk_dsd, bs * PS * Dc));
    } else if (py == rd) {
      @fmovs(at(kblk_dsd, bd * Dc * PS), fin(q_bc_in, Dc * PS));
      @fmovs(at(vblk_dsd, bd * PS * Dc), fin(q_bc_in, PS * Dc));
    }
  }
  sys_mod.unblock_cmd_stream();
}

comptime {
  @initialize_queue(q_r1_0_in, .{ .color = c_r1_0 });
  @initialize_queue(q_r1_0_out, .{ .color = c_r1_0 });
  @initialize_queue(q_r1_1_in, .{ .color = c_r1_1 });
  @initialize_queue(q_r1_1_out, .{ .color = c_r1_1 });
  @initialize_queue(q_r2_0_in, .{ .color = c_r2_0 });
  @initialize_queue(q_r2_0_out, .{ .color = c_r2_0 });
  @initialize_queue(q_r2_1_in, .{ .color = c_r2_1 });
  @initialize_queue(q_r2_1_out, .{ .color = c_r2_1 });
  @initialize_queue(q_bc_in, .{ .color = c_bc });
  @initialize_queue(q_bc_out, .{ .color = c_bc });

  @export_symbol(x_ptr, "x");
  @export_symbol(tab_ptr, "tab");
  @export_symbol(gamma1_ptr, "gamma1");
  @export_symbol(gamma2_ptr, "gamma2");
  @export_symbol(wqa_ptr, "wqa");
  @export_symbol(wqv_ptr, "wqv");
  @export_symbol(wv_ptr, "wv");
  @export_symbol(gamma3_ptr, "gamma3");
  @export_symbol(gamma4_ptr, "gamma4");
  @export_symbol(gamma5_ptr, "gamma5");
  @export_symbol(scal_ptr, "scal");
  @export_symbol(kvi_ptr, "kvi");
  @export_symbol(kvo_ptr, "kvo");
  @export_symbol(x0_ptr, "x0");
  @export_symbol(prow_ptr, "prow");
  @export_symbol(wpm_ptr, "wpm");
  @export_symbol(wpg_ptr, "wpg");
  @export_symbol(wpp_ptr, "wpp");
  @export_symbol(pnw_ptr, "pnw");
