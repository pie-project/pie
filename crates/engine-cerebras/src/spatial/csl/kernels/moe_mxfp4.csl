
// ---------------------------------------------------------------- moe_mxfp4
// A routed mixture of experts in place of a layer's dense MLP, every expert
// resident and sliced like the dense MLP: PE (px, py) holds, for each of the
// NE experts, its gate/up tile (the Hc hidden dims of row py by the Ic
// intermediate dims of column px, gate then up) and its down tile (Ic by Hc),
// MXFP4 codes and E8M0 scales. A token's top TK experts run on every PE of
// the grid, so a lane's MoE costs TK expert slices a PE, all PEs busy.
//
// Appended to a layer kernel (qwen2d_paged8b_hr's buffers and collectives:
// x, gamma2, xn_dsd, x_ssq, xss, rms_scale, exp_poly, hv_all, allreduce,
// axis_y/axis_xx, the mv_* DSRs, at, mx2, px/py, dims).
//
// Per lane: router partials over the row's Hc dims (the router tile is the
// same on every column) ride one all-reduce down the columns with x's sum of
// squares; every PE then picks the same top TK (ties: the lower expert) and
// their softmax. Gate/up partials of the TK experts (x normed, scaled by
// 2^MXK) and the gate/up biases (expert e's on row e % PY) ride a second
// all-reduce; every PE computes its column's clamped SwiGLU, scales it by the
// route weight, and adds its down partials (the down biases: expert e's on
// column e % PX, times its weight) into hv, summed across the columns once
// for all lanes as the dense MLP's down is.
//
// MXFP4 decode: three codes a u16 (bits s|e1 e0 m at 15-3p and 8-3p..6-3p,
// plane p), shifted into place and masked into the high half of an f32 whose
// low half stays zero: the value is fp4 x 2^-126 (the code 0.5 a denormal,
// which the PE's FMAC keeps). The inputs are prescaled by 2^MXK so the
// products stay normal; each run of inputs in one 32-block (at most two a
// tile) sums into yb, then y += yb x 2^(scale - 1 - MXK): the scale bytes
// carry scale + 127 - 1 - MXK + 127 - 127 (the f32 exponent field), two a u16.
param NE: u16;            // experts
param TK: u16;            // experts a token
param MXK: u16 = 100;     // inputs prescaled by 2^MXK
param SWL: f32 = 7.0;     // SwiGLU limit
param SWA: f32 = 1.702;   // SwiGLU alpha

const G2: u16 = 2 * Ic;                    // gate | up outputs a column
const GN3: u16 = (Hc * G2 + 2) / 3;        // u16 words of an expert's gate/up codes
const DN3: u16 = (Ic * Hc + 2) / 3;        // ... of its down codes
const GR2: u16 = (G2 + 1) / 2;             // u16 words of a segment's gate/up scales
const DR2: u16 = (Hc + 1) / 2;             // ... of its down scales
const XW: u16 = GN3 + DN3 + 2 * GR2 + 2 * DR2;   // u16 words an expert
const NER: u16 = (NE + PY - 1) / PY;       // gate/up bias slots a PE (experts py + k PY)
const NEC: u16 = (NE + PX - 1) / PX;       // down bias slots a PE (experts px + k PX)
const NE1: u16 = NE + 1;
const DECN: u16 = 3 * mx2(GN3, DN3);
const RMAX: u16 = mx2(G2, Hc);

var mx = @zeros([(NE * XW + 1) / 2]u32);
var mx_ptr: [*]u32 = &mx;
var rw = @zeros([Hc * NE]f32);             // router tile [i][e]
var rw_ptr: [*]f32 = &rw;
var rb = @zeros([NE]f32);
var rb_ptr: [*]f32 = &rb;
var gub = @zeros([NER * G2]f32);
var gub_ptr: [*]f32 = &gub;
var dnb = @zeros([NEC * Hc]f32);
var dnb_ptr: [*]f32 = &dnb;
var mcfg = @zeros([2]u32);                 // inputs in the first 32-block: gate/up, down
var mcfg_ptr: [*]u32 = &mcfg;

var mdec: [DECN]f32 align(16) = @zeros([DECN]f32);   // low halves stay zero
var mvec: [2 * ((RMAX + 1) / 2)]f32 = @zeros([2 * ((RMAX + 1) / 2)]f32);
var myb = @zeros([RMAX]f32);
var rl = @zeros([B * NE1]f32);
var sel = @zeros([B * TK]u16);
var wts = @zeros([B * TK]f32);
var mgu = @zeros([MC * TK * G2]f32);
var mact = @zeros([TK * Ic]f32);
var sw_a = @zeros([Ic]f32);
var sw_e = @zeros([Ic]f32);
var sw_d = @zeros([Ic]f32);
var sw_r = @zeros([Ic]f32);
var sw_t = @zeros([Ic]f32);
var m16 = @zeros([1]u16);

const rl_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * NE1} -> rl[i] });
const rl_lane = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NE} -> rl[i] });
const rw_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NE} -> rw[i] });
const mgu_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC * TK * G2} -> mgu[i] });
const mgu_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{G2} -> mgu[i] });
const gub_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{G2} -> gub[i] });
const dnb_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> dnb[i] });
const mact_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> mact[i] });
const myb_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{RMAX} -> myb[i] });
const mvec_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{RMAX} -> mvec[i] });
const mdec_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{RMAX} -> mdec[i] });
const sw_a_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> sw_a[i] });
const sw_e_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> sw_e[i] });
const sw_d_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> sw_d[i] });
const sw_r_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> sw_r[i] });
const sw_t_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> sw_t[i] });
// A u16 view (base addresses set at run time).
const u16_v = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> m16[i] });

fn u16_at(p: [*]u16, n: u16) mem1d_dsd {
  return @set_dsd_length(@set_dsd_base_addr(u16_v, p), n);
}
// The high halves of n f32 words from `f`.
fn hi_at(f: *f32, n: u16) mem1d_dsd {
  const d = @set_dsd_stride(@set_dsd_length(@set_dsd_base_addr(u16_v, @ptrcast([*]u16, f)), n), 2);
  return @increment_dsd_offset(d, 1, u16);
}

// y (R) += W x over a tile of L inputs by R outputs: codes at word `co` of
// expert storage, scales at word `so` (segment 0, then segment 1), inputs xv
// (L, prescaled), `split` inputs in the first block.
fn mxmv(y: mem1d_dsd, co: u16, n3: u16, so: u16, L: u16, R: u16, split: u16, xv: mem1d_dsd) void {
  const w16 = @ptrcast([*]u16, &mx[0]);
  const src = u16_at(@ptrcast([*]u16, &w16[co]), n3);
  const p0 = hi_at(&mdec[0], n3);
  const p1 = hi_at(&mdec[n3], n3);
  const p2 = hi_at(&mdec[2 * n3], n3);
  @and16(p0, src, @as(u16, 0x81C0));
  @sll16(p1, src, 3);
  @and16(p1, p1, @as(u16, 0x81C0));
  @sll16(p2, src, 6);
  @and16(p2, p2, @as(u16, 0x81C0));
  const r2 = (R + 1) / 2;
  const yb = @set_dsd_length(myb_v, R);
  const mv = @set_dsd_length(mvec_v, R);
  var seg: u16 = 0;
  while (seg < 2) : (seg += 1) {
    const lo: u16 = if (seg == 0) 0 else split;
    const hi: u16 = if (seg == 0) split else L;
    if (hi > lo) {
      const sw = u16_at(@ptrcast([*]u16, &w16[so + seg * r2]), r2);
      const sa = hi_at(&mvec[0], r2);
      const sb = hi_at(&mvec[r2], r2);
      @sll16(sa, sw, 7);
      @and16(sa, sa, @as(u16, 0x7F80));
      @slr16(sb, sw, 1);
      @and16(sb, sb, @as(u16, 0x7F80));
      @fmovs(yb, 0.0);
      @load_to_dsr(mv_dest, yb, .{ .save_address = false });
      @load_to_dsr(mv_src0, yb, .{ .save_address = false });
      @load_to_dsr(mv_src1, @set_dsd_length(at(mdec_v, lo * R), R), .{ .save_address = true });
      @map(mv_step, @set_dsd_length(at(xv, lo), hi - lo));
      @fmuls(yb, yb, mv);
      @fadds(y, y, yb);
    }
  }
}

// Lane b's routes: logits scaled by its RMS and biased; the top TK (ties: the
// lower expert) and their softmax. Returns x's RMS scale.
fn route(b: u16) f32 {
  const base = b * NE1;
  const sc = rms_scale(rl[base + NE], HID);
  var e: u16 = 0;
  while (e < NE) : (e += 1) { rl[base + e] = rl[base + e] * sc + rb[e]; }
  const ninf = @bitcast(f32, @as(u32, 0xff800000));
  var s: u16 = 0;
  while (s < TK) : (s += 1) {
    var best: u16 = 0;
    var bv = ninf;
    e = 0;
    while (e < NE) : (e += 1) {
      const v = rl[base + e];
      if (v > bv) { bv = v; best = e; }
    }
    sel[b * TK + s] = best;
    wts[b * TK + s] = bv;
    rl[base + best] = ninf;
  }
  const m = wts[b * TK];
  var sum: f32 = 0.0;
  s = 0;
  while (s < TK) : (s += 1) {
    const p = math.exp_f32(wts[b * TK + s] - m);
    wts[b * TK + s] = p;
    sum += p;
  }
  const inv = 1.0 / sum;
  s = 0;
  while (s < TK) : (s += 1) { wts[b * TK + s] = wts[b * TK + s] * inv; }
  return sc;
}

// mact[slot] = (clamp(u) + 1) x g' sigmoid(alpha g'), g' = min(g, limit), as
// 0.5 (g' + |g'| tanh(alpha |g'| / 2)) with tanh(z/2) = (1 - e) / (1 + e), e = exp(-z).
fn swiglu(g: mem1d_dsd, u: mem1d_dsd, out: mem1d_dsd) void {
  @fmovs(sw_t_d, SWL);
  @fmovs(sw_d_d, -SWL);
  // (fmins via -max(-a, -b))
  @fnegs(sw_a_d, g);
  @fnegs(sw_r_d, sw_t_d);
  @fmaxs(sw_a_d, sw_a_d, sw_r_d);
  @fnegs(sw_a_d, sw_a_d);            // g' = min(g, L)
  @fnegs(sw_e_d, u);
  @fmaxs(sw_e_d, sw_e_d, sw_r_d);
  @fnegs(sw_e_d, sw_e_d);            // min(u, L)
  @fmaxs(out, sw_e_d, sw_d_d);       // clamp(u, -L, L)
  @fadds(out, out, 1.0);             // u + 1
  // sw_t = g' (kept), sw_r = |g'|
  @fmovs(sw_t_d, sw_a_d);
  @fabss(sw_r_d, sw_a_d);
  @fmuls(sw_e_d, sw_r_d, -SWA);
  exp_poly(sw_e_d, sw_d_d);          // e = exp(-alpha |g'|)
  @fadds(sw_d_d, sw_e_d, 1.0);       // 1 + e in [1, 2]
  @fmuls(sw_a_d, sw_d_d, -0.47058823529411764);
  @fadds(sw_a_d, sw_a_d, 1.411764705882353);
  var it: u16 = 0;
  while (it < 3) : (it += 1) {
    @fmuls(myb_v_ic(), sw_d_d, sw_a_d);
    @fnegs(myb_v_ic(), myb_v_ic());
    @fadds(myb_v_ic(), myb_v_ic(), 2.0);
    @fmuls(sw_a_d, sw_a_d, myb_v_ic());
  }                                  // sw_a = 1 / (1 + e)
  @fnegs(sw_e_d, sw_e_d);
  @fadds(sw_e_d, sw_e_d, 1.0);       // 1 - e
  @fmuls(sw_e_d, sw_e_d, sw_a_d);
  @fmuls(sw_e_d, sw_e_d, sw_r_d);    // |g'| tanh
  @fadds(sw_e_d, sw_e_d, sw_t_d);
  @fmuls(sw_e_d, sw_e_d, 0.5);       // g' sigmoid(alpha g')
  @fmuls(out, out, sw_e_d);
}
fn myb_v_ic() mem1d_dsd { return @set_dsd_length(myb_v, Ic); }

fn moe_mlp() void {
  const p2k = @bitcast(f32, @as(u32, 127 + MXK) << 23);
  const gsplit = @as(u16, mcfg[0]);
  const dsplit = @as(u16, mcfg[1]);
  axis_y();
  x_ssq(xss_dsd);
  var b: u16 = 0;
  while (b < dims[0]) : (b += 1) {
    @fmuls(xn_dsd, at(x_dsd, b * Hc), g2_dsd);
    const y = at(rl_lane, b * NE1);
    @fmovs(y, 0.0);
    @load_to_dsr(mv_dest, y, .{ .save_address = false });
    @load_to_dsr(mv_src0, y, .{ .save_address = false });
    @load_to_dsr(mv_src1, rw_dsd, .{ .save_address = true });
    @map(mv_step, xn_dsd);
    rl[b * NE1 + NE] = xss[b];
  }
  mark(10);
  allreduce(false, rl_all, B * NE1);
  @fmovs(hv_all, 0.0);
  var c0: u16 = 0;
  while (c0 < dims[0]) : (c0 += dims[4]) {
    var k: u16 = 0;
    while (k < dims[4]) : (k += 1) {
      const lb = c0 + k;
      const sc = route(lb);
      @fmuls(xn_dsd, at(x_dsd, lb * Hc), g2_dsd);
      @fmuls(xn_dsd, xn_dsd, sc * p2k);
      var s: u16 = 0;
      while (s < TK) : (s += 1) {
        const e = sel[lb * TK + s];
        const y = at(mgu_v, (k * TK + s) * G2);
        @fmovs(y, 0.0);
        mxmv(y, e * XW, GN3, e * XW + GN3 + DN3, Hc, G2, gsplit, xn_dsd);
        var k2: u16 = 0;
        while (k2 < NER) : (k2 += 1) {
          if (py + k2 * PY == e) { @fadds(y, y, at(gub_v, k2 * G2)); }
        }
      }
    }
    mark(11);
    allreduce(false, mgu_all, MC * TK * G2);
    mark(12);
    k = 0;
    while (k < dims[4]) : (k += 1) {
      const lb = c0 + k;
      const hb = at(hv_dsd, lb * Hc);
      var s: u16 = 0;
      while (s < TK) : (s += 1) {
        const e = sel[lb * TK + s];
        const w = wts[lb * TK + s];
        const g = at(mgu_v, (k * TK + s) * G2);
        const a = at(mact_v, s * Ic);
        swiglu(@set_dsd_length(g, Ic), @set_dsd_length(at(g, Ic), Ic), a);
        @fmuls(a, a, w * p2k);
        mxmv(hb, e * XW + GN3, DN3, e * XW + GN3 + DN3 + 2 * GR2, Ic, Hc, dsplit, a);
        var k2: u16 = 0;
        while (k2 < NEC) : (k2 += 1) {
          if (px + k2 * PX == e) { @fmacs(hb, hb, at(dnb_v, k2 * Hc), w); }
        }
      }
    }
  }
  mark(13);
  axis_xx();
  allreduce(false, hv_all, B * Hc);
  @fadds(x_all, x_all, hv_all);
  mark(15);
}

comptime {
  @export_symbol(mx_ptr, "mx");
  @export_symbol(rw_ptr, "rw");
  @export_symbol(rb_ptr, "rb");
  @export_symbol(gub_ptr, "gub");
  @export_symbol(dnb_ptr, "dnb");
  @export_symbol(mcfg_ptr, "mcfg");
}
