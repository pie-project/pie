// qwen35w_gdn: qwen35_gdn with bf16 weights (W16).
//
// qwen35_gdn: Qwen3.5's Gated DeltaNet layer (and its SwiGLU MLP) on a P x P
// grid, B lanes a pass, f32. Row py holds hidden chunk py (Hc dims); each k
// head has GK (`Gs`) columns, column c holding DK dims of its head's q and k
// and DV dims of each of its VH v heads' v and z, and every v head's b and a.
//
// The recurrent state lies as the delta rule reads it: PE (py, c) holds row
// k = py of each of its v heads' k_dim x v_dim state over column c's DV v
// dims (so k_dim = P). A step, a lane and v head at a time:
//   S *= exp(g); mem = S^T k; delta = (v - mem) beta; S += k delta^T;
//   o = S^T q = (S_decayed^T q) + delta (k . q)
// so both reads of the state are one all-reduce down the columns (with k . q
// riding along), each PE needing only k[py] and q[py]: the column owning dim
// py of the head gives them (with q's and k's sums of squares for their l2
// norms) in one segment all-reduce over the head's columns.
//
// The conv window (CW - 1 earlier rows of q, k, v) and the state are a lane
// slot's: `reset(b)` zeroes slot b for a new sequence.
param memcpy_params;
param P: u16;
param Hc: u16;
param Gs: u16;         // GK: columns a k head
param DK: u16;         // q/k dims a column
param VH: u16;         // v heads a k head
param DV: u16;         // v dims a column, a v head
param CW: u16;         // conv width
param Ic: u16;
param B: u16;
param MC: u16;
param W16: u16 = 0;     // 1: bf16 weights (u16 storage)
param NP: u16 = 3;      // bf16 parts of x in a W16 matvec (3: exact)
param c_r1_0: color;
param c_r1_1: color;
param c_r2_0: color;
param c_r2_1: color;
param c_bc: color;
param c_gb: color;     // unused (serve designs' layouts pass it)
param c_cp: color;     // unused: queue 2 stays free (a design's handoff takes it)

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const timestamp = @import_module("<time>");
const math = @import_module("<math>");
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;

const HID: f32 = @as(f32, P * Hc);
const VD: f32 = @as(f32, Gs * DV);    // v_dim
const EPS: f32 = 1.0e-6;
const R1: u16 = Gs / 2;
const NG: u16 = P / Gs;
const R2: u16 = (NG / 2) * Gs + R1;

// ---------------------------------------------------------------- collectives
// Two-phase grouped all-reduce (WaferLLM comm_pe.csl, in f32): phase 1 chains
// each group of Gs PEs from both ends into its root, phase 2 chains the group
// roots into R2, then R2 broadcasts. Along X, "seg" stops after phase 1 and
// each group root broadcasts within its group (a kv head's columns).
const q_r1_0_in = @get_input_queue(3);
const q_r1_0_out = @get_output_queue(3);
const q_r1_1_in = @get_input_queue(4);
const q_r1_1_out = @get_output_queue(4);
const q_r2_0_in = @get_input_queue(5);
const q_r2_0_out = @get_output_queue(5);
const q_r2_1_in = @get_input_queue(6);
const q_r2_1_out = @get_output_queue(6);
const q_bc_in = @get_input_queue(7);
const q_bc_out = @get_output_queue(7);
// Queue 2 is free (the group broadcast and page copies ride on c_bc): a
// pipeline ring's handoff takes it (qwen2d_pring).

fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}

var px: u16 = 0;
var py: u16 = 0;

// Routes are written as raw color-config words from runtime directions (one
// copy of the code; <tile_config>'s reset_routes needs comptime directions and
// cost ~1.1 KB a specialization). Directions: 0 ramp, 1 north, 2 south, 3 east,
// 4 west.
const tgt = tile_config.target;
const D_RAMP: u16 = 0;
const D_N: u16 = 1;
const D_S: u16 = 2;
const D_E: u16 = 3;
const D_W: u16 = 4;
// The config bits of each direction, indexed by D_*.
const rx_bits = [5]tgt.reg_type { @get_int(tgt.fabric_io.RX_RAMP), @get_int(tgt.fabric_io.RX_NORTH),
  @get_int(tgt.fabric_io.RX_SOUTH), @get_int(tgt.fabric_io.RX_EAST), @get_int(tgt.fabric_io.RX_WEST) };
const tx_bits = [5]tgt.reg_type { @get_int(tgt.fabric_io.TX_RAMP), @get_int(tgt.fabric_io.TX_NORTH),
  @get_int(tgt.fabric_io.TX_SOUTH), @get_int(tgt.fabric_io.TX_EAST), @get_int(tgt.fabric_io.TX_WEST) };
var rxt = rx_bits;
var txt = tx_bits;
fn rxw(d: u16) tgt.reg_type { return rxt[d]; }
fn txw(d: u16) tgt.reg_type { return txt[d]; }
// c: rx from one direction, tx to t1 (and t2 when t2 != t1).
fn set_route(c: color, rx: u16, t1: u16, t2: u16) void {
  const addr = color_config.get_color_config_addr(c);
  var r = @get_config(addr, tgt.color_addr_range);
  r = r & @get_int(tgt.fabric_io.CLEAR_MASK);
  r = r | rxw(rx) | txw(t1) | txw(t2);
  @set_config(addr, r, tgt.color_addr_range);
}

// Phase 1 within a group of Gs along the axis: chains from both ends into R1
// (even and odd positions alternate the two colors so a PE never forwards on
// the color it receives on).
fn route_phase1(H: u16, T: u16, r: u16) void {
  const ev = r % 2 == 0;
  const ca = if (ev) c_r1_0 else c_r1_1;
  const cb = if (ev) c_r1_1 else c_r1_0;
  if (r == R1) {
    set_route(ca, H, D_RAMP, D_RAMP);
    set_route(cb, T, D_RAMP, D_RAMP);
  } else if (r < R1) {
    set_route(ca, H, D_RAMP, D_RAMP);
    set_route(cb, D_RAMP, T, T);
  } else {
    set_route(cb, T, D_RAMP, D_RAMP);
    set_route(ca, D_RAMP, H, H);
  }
}

fn route_phase2(H: u16, T: u16, id: u16) void {
  const qt = id / Gs;
  const r = id % Gs;
  const ev = qt % 2 == 0;
  const ca = if (ev) c_r2_0 else c_r2_1;
  const cb = if (ev) c_r2_1 else c_r2_0;
  if (id == R2) {
    set_route(ca, H, D_RAMP, D_RAMP);
    set_route(cb, T, D_RAMP, D_RAMP);
  } else if (id < R2) {
    if (r == R1) {
      set_route(ca, H, D_RAMP, D_RAMP);
      set_route(cb, D_RAMP, T, T);
    } else {
      set_route(c_r2_0, H, T, T);
      set_route(c_r2_1, H, T, T);
    }
  } else {
    if (r == R1) {
      set_route(cb, T, D_RAMP, D_RAMP);
      set_route(ca, D_RAMP, H, H);
    } else {
      set_route(c_r2_0, T, H, H);
      set_route(c_r2_1, T, H, H);
    }
  }
}

fn route_bcast(H: u16, T: u16, id: u16, last: u16) void {
  if (id == R2) {
    set_route(c_bc, D_RAMP, H, T);
  } else if (id < R2) {
    if (id == 0) { set_route(c_bc, T, D_RAMP, D_RAMP); }
    else { set_route(c_bc, T, H, D_RAMP); }
  } else {
    if (id == last) { set_route(c_bc, H, D_RAMP, D_RAMP); }
    else { set_route(c_bc, H, D_RAMP, T); }
  }
}

// The group broadcast (segment all-reduce along X) on c_bc.
fn route_gbcast() void {
  const r = px % Gs;
  if (r == R1) {
    set_route(c_bc, D_RAMP, D_W, if (R1 == Gs - 1) D_W else D_E);
  } else if (r < R1) {
    if (r == 0) { set_route(c_bc, D_E, D_RAMP, D_RAMP); }
    else { set_route(c_bc, D_E, D_W, D_RAMP); }
  } else {
    if (r == Gs - 1) { set_route(c_bc, D_W, D_RAMP, D_RAMP); }
    else { set_route(c_bc, D_W, D_RAMP, D_E); }
  }
}

var axis_x: bool = false;
var axis_id: u16 = 0;
fn set_axis(x: bool) void {
  const h = if (x) D_W else D_N;
  const t = if (x) D_E else D_S;
  const id = if (x) px else py;
  route_phase1(h, t, id % Gs);
  route_phase2(h, t, id);
  route_bcast(h, t, id, P - 1);
  axis_x = x;
  axis_id = id;
}
fn axis_y() void { set_axis(false); }
fn axis_xx() void { set_axis(true); }

// dst = a op b, op: sum or max.
fn op_in(is_max: bool, buf: mem1d_dsd, comptime q: input_queue, n: u16) void {
  if (is_max) { @fmaxs(buf, buf, fin(q, n)); } else { @fadds(buf, buf, fin(q, n)); }
}
fn op_fwd(is_max: bool, comptime qo: output_queue, comptime qi: input_queue,
          buf: mem1d_dsd, n: u16) void {
  if (is_max) { @fmaxs(fout(qo, n), fin(qi, n), buf); } else { @fadds(fout(qo, n), fin(qi, n), buf); }
}

fn phase1(is_max: bool, buf: mem1d_dsd, n: u16) void {
  const r = axis_id % Gs;
  if (r == R1) {
    if (R1 < Gs - 1) { op_in(is_max, buf, q_r1_0_in, n); }
    op_in(is_max, buf, q_r1_1_in, n);
  } else if (r > R1) {
    if (r % 2 == 0) {
      if (r == Gs - 1) { @fmovs(fout(q_r1_0_out, n), buf); }
      else { op_fwd(is_max, q_r1_0_out, q_r1_1_in, buf, n); }
    } else {
      if (r == Gs - 1) { @fmovs(fout(q_r1_1_out, n), buf); }
      else { op_fwd(is_max, q_r1_1_out, q_r1_0_in, buf, n); }
    }
  } else {
    if (r % 2 == 0) {
      if (r == 0) { @fmovs(fout(q_r1_1_out, n), buf); }
      else { op_fwd(is_max, q_r1_1_out, q_r1_0_in, buf, n); }
    } else {
      op_fwd(is_max, q_r1_0_out, q_r1_1_in, buf, n);
    }
  }
}

fn phase2(is_max: bool, buf: mem1d_dsd, n: u16) void {
  const id = axis_id;
  const r = id % Gs;
  const qt = id / Gs;
  if (id == R2) {
    if (R2 < P - Gs) { op_in(is_max, buf, q_r2_0_in, n); }
    op_in(is_max, buf, q_r2_1_in, n);
  } else if (id > R2) {
    if (r == R1) {
      if (id > P - Gs - 1) {
        if (qt % 2 == 0) { @fmovs(fout(q_r2_0_out, n), buf); }
        else { @fmovs(fout(q_r2_1_out, n), buf); }
      } else {
        if (qt % 2 == 0) { op_fwd(is_max, q_r2_0_out, q_r2_1_in, buf, n); }
        else { op_fwd(is_max, q_r2_1_out, q_r2_0_in, buf, n); }
      }
    }
  } else {
    if (r == R1) {
      if (id < Gs) { @fmovs(fout(q_r2_1_out, n), buf); }
      else {
        if (qt % 2 == 0) { op_fwd(is_max, q_r2_1_out, q_r2_0_in, buf, n); }
        else { op_fwd(is_max, q_r2_0_out, q_r2_1_in, buf, n); }
      }
    }
  }
}

// Sum (or max) of buf over the current axis, left in buf on every PE.
fn allreduce(is_max: bool, buf: mem1d_dsd, n: u16) void {
  phase1(is_max, buf, n);
  if (NG > 1) { phase2(is_max, buf, n); }
  if (axis_id == R2) { @fmovs(fout(q_bc_out, n), buf); }
  else { @fmovs(buf, fin(q_bc_in, n)); }
}

// Sum of buf over this PE's group of Gs columns (axis X).
fn allreduce_seg(buf: mem1d_dsd, n: u16) void {
  phase1(false, buf, n);
  route_gbcast();                       // c_bc: the group's broadcast for now
  if (px % Gs == R1) { @fmovs(fout(q_bc_out, n), buf); }
  else { @fmovs(buf, fin(q_bc_in, n)); }
  route_bcast(D_W, D_E, px, P - 1);     // back to the X axis's broadcast
}



var dims = @zeros([5]u16);           // B, -, -, -, MC: set in init
var dims_ptr: [*]u16 = &dims;

// ---------------------------------------------------------------- state
const NV: u16 = VH * DV;
const NCH: u16 = 2 * DK + NV;            // conv channels: q, k, v
const NPJ: u16 = NCH + NV + 2 * VH;      // [q | k | v | z | b | a]
const CWm: u16 = CW - 1;
const NR: u16 = 2 * DV + 1;              // a v head's reads: S^T k, S^T q, k . q
const GU1: u16 = 2 * Ic + 1;

fn at(d: mem1d_dsd, off: u16) mem1d_dsd {
  return @increment_dsd_offset(d, @as(i16, off), f32);
}
fn len(d: mem1d_dsd, n: u16) mem1d_dsd { return @set_dsd_length(d, n); }

var x = @zeros([B * Hc]f32);
var x_ptr: [*]f32 = &x;
const x_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> x[i] });
const x_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> x[i] });
var gamma1 = @zeros([Hc]f32);
var gamma1_ptr: [*]f32 = &gamma1;
const g1_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gamma1[i] });
var gamma2 = @zeros([Hc]f32);
var gamma2_ptr: [*]f32 = &gamma2;
const g2_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gamma2[i] });
var xn = @zeros([B * Hc]f32);
const xn_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> xn[i] });


// Weight storage and the W16 matvec's scratch (x's f32 remainder, its
// bf16 parts).
const WST = if (W16 == 1) u16 else f32;
var wdummy = @zeros([1]@fp16());
const XMAX: u16 = mx2(mx2(Hc, NV), Ic);
const XM: u16 = if (W16 == 1) XMAX else 1;
var xs32 = @zeros([XM]f32);
var xt32 = @zeros([XM]f32);
var xpart = @zeros([NP * XM]@fp16());
const xs_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XM} -> xs32[i] });
const xt_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XM} -> xt32[i] });
const xpart_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XM} -> xpart[i] });
fn mx2(a: u16, b: u16) u16 { return if (a > b) a else b; }

// Projection [Hc][NPJ]; its outputs [b][NPJ], then x's sums of squares [b].
var wp: [Hc * NPJ + 1]WST align(16) = @zeros([Hc * NPJ + 1]WST);
var wp_ptr: [*]WST = &wp;
var wp_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = NPJ })
  else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NPJ} -> wp[i + 1] });
const PJN: u16 = B * NPJ + B;
var pj: [PJN]f32 align(16) = @zeros([PJN]f32);
var pj_ptr: [*]f32 = &pj;
const pj_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NPJ} -> pj[i] });
const pj_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PJN} -> pj[i] });

// The conv: taps [CW][NCH] (tap i reads the row CW - 1 - i back), the
// window [b][CW - 1][NCH], oldest first.
var cw = @zeros([CW * NCH]f32);
var cw_ptr: [*]f32 = &cw;
const cw_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cw[i] });
var cst = @zeros([B * CWm * NCH]f32);
var cst_ptr: [*]f32 = &cst;
const cst_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cst[i] });
var cy = @zeros([NCH]f32);
const cy_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cy[i] });

// Per v head: -exp(A_log), dt_bias; the gated norm's weight over this
// column's dims of a head [VH][DV].
var gab = @zeros([2 * VH]f32);
var gab_ptr: [*]f32 = &gab;
var nw = @zeros([NV]f32);
var nw_ptr: [*]f32 = &nw;
const nw_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> nw[i] });

// The state [b][VH][DV]: row py of each v head's.
var st = @zeros([B * NV]f32);
var st_ptr: [*]f32 = &st;
const st_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> st[i] });

// [b][q own, k own, q's sum of squares, k's], over the head's columns.
var qk4 = @zeros([4 * B]f32);
const qk4_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{4 * B} -> qk4[i] });
var kr = @zeros([B]f32);
var qr = @zeros([B]f32);
var beta = @zeros([B * VH]f32);
var decay = @zeros([B * VH]f32);
// The state's reads [b][VH][S^T k | S^T q | k . q], down the columns.
const RN: u16 = B * VH * NR;
var rd = @zeros([RN]f32);
const rd_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> rd[i] });
const rd_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{RN} -> rd[i] });
var dl = @zeros([DV]f32);
const dl_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> dl[i] });
// The output [b][NV] and its sums of squares [b][VH], over the head's columns.
var o = @zeros([B * NV]f32);
var o_ptr: [*]f32 = &o;
const o_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> o[i] });
const ob_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NV} -> o[i] });
var oss = @zeros([B * VH]f32);
const oss_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * VH} -> oss[i] });

var wo: [NV * Hc + 1]WST align(16) = @zeros([NV * Hc + 1]WST);
var wo_ptr: [*]WST = &wo;
var wo_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = Hc })
  else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> wo[i + 1] });
var hv = @zeros([B * Hc]f32);
const hv_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> hv[i] });
const hv_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{B * Hc} -> hv[i] });

var wgu: [Hc * 2 * Ic + 1]WST align(16) = @zeros([Hc * 2 * Ic + 1]WST);
var wgu_ptr: [*]WST = &wgu;
var wgu_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = 2 * Ic })
  else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * Ic} -> wgu[i + 1] });
var gu: [MC * GU1]f32 align(16) = @zeros([MC * GU1]f32);
const gu_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * Ic} -> gu[i] });
const gu_all = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC * GU1} -> gu[i] });
// A lane's gate/up column strided by GU1, which must fit an i8 past one lane
// a chunk (MC 1 strides nothing: 4B's GU1 is 145).
const GUS: i16 = if (MC == 1) 0 else @as(i16, GU1);
const g_col = @get_dsd(mem1d_dsd, .{ .tensor_access = |b|{MC} -> gu[b * GUS] });
const u_col = @get_dsd(mem1d_dsd, .{ .tensor_access = |b|{MC} -> gu[b * GUS + @as(i16, Ic)] });
var xss = @zeros([B]f32);
var act: [MC * Ic]f32 align(16) = @zeros([MC * Ic]f32);
const act_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> act[i] });
const act_mc = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{MC * Ic} -> act[i] });
const act_col = @get_dsd(mem1d_dsd, .{ .tensor_access = |b|{MC} -> act[b * @as(i16, Ic)] });
var wd: [Ic * Hc + 1]WST align(16) = @zeros([Ic * Hc + 1]WST);
var wd_ptr: [*]WST = &wd;
var wd_dsd = if (W16 == 1) @get_dsd(mem1d_dsd, .{ .base_address = &wdummy, .extent = Hc })
  else @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> wd[i + 1] });

// SiLU's scratch: as long as the longest run it takes (MC, NCH, NV).
const NT0: u16 = if (NCH > MC) NCH else MC;
var ta = @zeros([NT0]f32);
var tt = @zeros([NT0]f32);
var te = @zeros([NT0]f32);
var tr = @zeros([NT0]f32);
var td = @zeros([NT0]f32);
const ta_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NT0} -> ta[i] });
const tt_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NT0} -> tt[i] });
const te_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NT0} -> te[i] });
const tr_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NT0} -> tr[i] });
const td_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NT0} -> td[i] });

// ---------------------------------------------------------------- compute
const mv_dest = @get_dsr(dsr_dest, 1);
const mv_src0 = @get_dsr(dsr_src0, 1);
const mv_src1 = @get_dsr(dsr_src1, 1);
fn mv_step(xv: f32) void {
  @fmacs(mv_dest, mv_src0, mv_src1, xv);
}
fn matvec(y: mem1d_dsd, a: mem1d_dsd, xv: mem1d_dsd) void {
  @load_to_dsr(mv_dest, y, .{ .save_address = false });
  @load_to_dsr(mv_src0, y, .{ .save_address = false });
  @load_to_dsr(mv_src1, a, .{ .save_address = true });
  @map(mv_step, xv);
}

// 16-bit weights (W16): x split into NP bf16 parts (exact at NP 3), each part
// one @fmachs pass over the bf16 rows (qwen2d_paged8b's matvec).
fn mv16_step(xv: @fp16()) void {
  @fmachs(mv_dest, mv_src0, mv_src1, xv);
}
fn xsplit(xv: mem1d_dsd, n: u16) void {
  const res = @set_dsd_length(xs_d, n);
  const tmp = @set_dsd_length(xt_d, n);
  @fmovs(res, xv);
  var k: u16 = 0;
  while (k < NP) : (k += 1) {
    const part = @set_dsd_length(@increment_dsd_offset(xpart_d, @as(i16, k * XM), @fp16()), n);
    @fs2h(part, res);
    if (k + 1 < NP) {
      @fh2s(tmp, part);
      @fsubs(res, res, tmp);
    }
  }
}
// y += A x over x's parts as `xsplit` left them (n of x's elements).
fn mvparts(y: mem1d_dsd, a: mem1d_dsd, n: u16) void {
  var k: u16 = 0;
  while (k < NP) : (k += 1) {
    const part = @set_dsd_length(@increment_dsd_offset(xpart_d, @as(i16, k * XM), @fp16()), n);
    @load_to_dsr(mv_dest, y, .{ .save_address = false });
    @load_to_dsr(mv_src0, y, .{ .save_address = false });
    @load_to_dsr(mv_src1, a, .{ .save_address = true });
    @map(mv16_step, part);
  }
}
// y += A x for a weight matrix A: f32 rows, or (W16) bf16 rows.
fn wmv(y: mem1d_dsd, a: mem1d_dsd, xv: mem1d_dsd, n: u16) void {
  if (W16 == 0) {
    matvec(y, a, xv);
  } else {
    xsplit(xv, n);
    mvparts(y, a, n);
  }
}
fn rsqrt(v: f32) f32 {
  var y = @bitcast(f32, @as(u32, 0x5f3759df) - (@bitcast(u32, v) >> 1));
  const h = 0.5 * v;
  y = y * (1.5 - h * y * y);
  y = y * (1.5 - h * y * y);
  y = y * (1.5 - h * y * y);
  return y;
}
fn recip(v: f32) f32 {
  const r = rsqrt(v);
  return r * r;
}
fn rms_scale(sum: f32, n: f32) f32 {
  return rsqrt(sum * (1.0 / n) + EPS);
}
fn ln_approx(v: f32) f32 {
  return (@as(f32, @bitcast(u32, v)) * (1.0 / 8388608.0) - 127.0) * 0.6931472;
}
// exp(v/256)'s degree-7 Taylor coefficients after 1/5040 (runtime loops: the
// unrolled form cost ~1.5 KB of code at each use).
var exp_coeffs = [7]f32 { 1.0 / 720.0, 1.0 / 120.0, 1.0 / 24.0, 1.0 / 6.0, 0.5, 1.0, 1.0 };
// buf = exp(buf) for buf <= 0 (or -1e30): exp(v/256) by the polynomial, squared 8 times.
fn exp_poly(buf: mem1d_dsd, tmp: mem1d_dsd) void {
  @fmaxs(tmp, buf, -88.0);
  @fmuls(tmp, tmp, 0.00390625);
  @fmovs(buf, 1.0 / 5040.0);
  var c: u16 = 0;
  while (c < 7) : (c += 1) {
    @fmuls(buf, buf, tmp);
    @fadds(buf, buf, exp_coeffs[c]);
  }
  c = 0;
  while (c < 8) : (c += 1) { @fmuls(buf, buf, buf); }
}
fn exp_inplace(buf: mem1d_dsd, tmp: mem1d_dsd) void { exp_poly(buf, tmp); }
// ---------------------------------------------------------------- profile
const NPROF: u16 = 16;
var prof = @zeros([NPROF]u32);
var prof_ptr: [*]u32 = &prof;
var t_mark = @zeros([timestamp.tsc_size_words]u16);
var t_now = @zeros([timestamp.tsc_size_words]u16);
var timing: bool = false;
fn tsc(t: *[timestamp.tsc_size_words]u16) u64 {
  return @as(u64, t.*[0]) | (@as(u64, t.*[1]) << 16) | (@as(u64, t.*[2]) << 32);
}
fn mark(slot: u16) void {
  timestamp.get_timestamp(&t_now);
  if (timing) { prof[slot] += @as(u32, (tsc(&t_now) - tsc(&t_mark)) & 0xffffffff); }
  t_mark = t_now;
}

// y = g · u · sigmoid(g) over n elements (y may be g): g sigmoid(g) =
// (g + |g| (1 - e) / (1 + e)) / 2, e = exp(-|g|); 1/(1 + e) by Newton from a
// line over [1, 2].
fn silu_mul(y: mem1d_dsd, g: mem1d_dsd, u: mem1d_dsd, n: u16, with_u: bool) void {
  const a_ = len(ta_d, n);
  const t_ = len(tt_d, n);
  const e_ = len(te_d, n);
  const r_ = len(tr_d, n);
  const d_ = len(td_d, n);
  @fabss(a_, g);
  @fnegs(e_, a_);
  exp_poly(e_, t_);
  @fadds(d_, e_, 1.0);
  @fmuls(r_, d_, -0.47058823529411764);
  @fadds(r_, r_, 1.411764705882353);
  var it: u16 = 0;
  while (it < 3) : (it += 1) {
    @fmuls(t_, d_, r_);
    @fnegs(t_, t_);
    @fadds(t_, t_, 2.0);
    @fmuls(r_, r_, t_);
  }
  @fnegs(t_, e_);
  @fadds(t_, t_, 1.0);
  @fmuls(t_, t_, r_);
  @fmuls(t_, t_, a_);
  @fadds(t_, t_, g);
  @fmuls(t_, t_, 0.5);
  if (with_u) { @fmuls(y, t_, u); } else { @fmovs(y, t_); }
}
fn silu_col(e: u16) void {
  silu_mul(at(act_col, e), at(g_col, e), at(u_col, e), MC, true);
}
fn sum_sq(base: [*]f32, off: u16, n: u16) f32 {
  var s: f32 = 0.0;
  var i: u16 = 0;
  while (i < n) : (i += 1) { s += base[off + i] * base[off + i]; }
  return s;
}
var qscale: f32 = 0.0;               // 1/sqrt(k_dim), k_dim = P

// ---------------------------------------------------------------- the layer
fn layer() void {
  const nb = dims[0];
  var b: u16 = 0;
  const s = px % Gs;                  // this column's slice of its head
  const own = s == py / DK;           // it holds dim py of q and k
  const od = py % DK;
  // 0: the projection, x's sums of squares; summed down the columns; the
  // input RMSNorm (gamma1 = 1 + w in xn).
  axis_y();
  @fmovs(pj_all, 0.0);
  while (b < nb) : (b += 1) {
    const xb = at(xn_dsd, b * Hc);
    @fmuls(xb, at(x_dsd, b * Hc), g1_dsd);
    wmv(at(pj_dsd, b * NPJ), wp_dsd, xb, Hc);
    pj[B * NPJ + b] = sum_sq(x_ptr, b * Hc, Hc);
  }
  mark(0);
  allreduce(false, pj_all, PJN);
  b = 0;
  while (b < nb) : (b += 1) {
    const pb = at(pj_dsd, b * NPJ);
    @fmuls(pb, pb, rms_scale(pj[B * NPJ + b], HID));
  }
  mark(1);
  // 1: the conv over q, k, v (the window shifts in this row), SiLU; q's and
  // k's own dims and sums of squares to the head's columns.
  b = 0;
  while (b < nb) : (b += 1) {
    const pb = at(len(pj_dsd, NCH), b * NPJ);
    const wb = b * CWm * NCH;
    @fmuls(cy_dsd, at(cw_dsd, CWm * NCH), pb);
    var i: u16 = 0;
    while (i < CWm) : (i += 1) {
      @fmuls(len(tt_d, NCH), at(cw_dsd, i * NCH), at(cst_dsd, wb + i * NCH));
      @fadds(cy_dsd, cy_dsd, len(tt_d, NCH));
    }
    i = 0;
    while (i + 1 < CWm) : (i += 1) {
      @fmovs(at(cst_dsd, wb + i * NCH), at(cst_dsd, wb + (i + 1) * NCH));
    }
    @fmovs(at(cst_dsd, wb + (CWm - 1) * NCH), pb);
    silu_mul(pb, cy_dsd, cy_dsd, NCH, false);
    const q0 = b * NPJ;
    qk4[4 * b] = if (own) pj[q0 + od] else 0.0;
    qk4[4 * b + 1] = if (own) pj[q0 + DK + od] else 0.0;
    qk4[4 * b + 2] = sum_sq(pj_ptr, q0, DK);
    qk4[4 * b + 3] = sum_sq(pj_ptr, q0 + DK, DK);
  }
  axis_xx();
  allreduce_seg(qk4_dsd, 4 * B);
  // 2: q[py] and k[py] l2-normed (q by 1/sqrt(k_dim) too); the gates.
  b = 0;
  while (b < nb) : (b += 1) {
    qr[b] = qk4[4 * b] * rsqrt(qk4[4 * b + 2] + EPS) * qscale;
    kr[b] = qk4[4 * b + 1] * rsqrt(qk4[4 * b + 3] + EPS);
    var j: u16 = 0;
    while (j < VH) : (j += 1) {
      const bv = pj[b * NPJ + NCH + NV + j];
      const av = pj[b * NPJ + NCH + NV + VH + j] + gab[VH + j];
      beta[b * VH + j] = 1.0 / (1.0 + math.exp_f32(-bv));
      const sp = (if (av > 0.0) av else 0.0) + math.log_f32(1.0 + math.exp_f32(-(if (av > 0.0) av else -av)));
      decay[b * VH + j] = math.exp_f32(gab[j] * sp);
    }
  }
  mark(2);
  // 3: the state decays; its two reads and k . q, summed down the columns.
  axis_y();
  b = 0;
  while (b < nb) : (b += 1) {
    var j: u16 = 0;
    while (j < VH) : (j += 1) {
      const sb = at(st_dsd, (b * VH + j) * DV);
      const r0 = (b * VH + j) * NR;
      @fmuls(sb, sb, decay[b * VH + j]);
      @fmuls(at(rd_dsd, r0), sb, kr[b]);
      @fmuls(at(rd_dsd, r0 + DV), sb, qr[b]);
      rd[r0 + 2 * DV] = kr[b] * qr[b];
    }
  }
  allreduce(false, rd_all, RN);
  mark(3);
  // 4: delta = (v - S^T k) beta; S += k delta; o = S^T q + delta (k . q);
  // the gated RMSNorm's sums of squares over the head's columns.
  b = 0;
  while (b < nb) : (b += 1) {
    var j: u16 = 0;
    while (j < VH) : (j += 1) {
      const sb = at(st_dsd, (b * VH + j) * DV);
      const r0 = (b * VH + j) * NR;
      const vb = at(len(pj_dsd, DV), b * NPJ + 2 * DK + j * DV);
      const ob = at(o_dsd, (b * VH + j) * DV);
      @fsubs(dl_dsd, vb, at(rd_dsd, r0));
      @fmuls(dl_dsd, dl_dsd, beta[b * VH + j]);
      @fmacs(sb, sb, dl_dsd, kr[b]);
      @fmacs(ob, at(rd_dsd, r0 + DV), dl_dsd, rd[r0 + 2 * DV]);
      oss[b * VH + j] = sum_sq(o_ptr, (b * VH + j) * DV, DV);
    }
  }
  axis_xx();
  allreduce_seg(oss_dsd, B * VH);
  // 5: o normed, by its weight and SiLU(z); the out projection, summed along
  // the rows; the residual.
  @fmovs(hv_all, 0.0);
  b = 0;
  while (b < nb) : (b += 1) {
    var j: u16 = 0;
    while (j < VH) : (j += 1) {
      const ob = at(o_dsd, (b * VH + j) * DV);
      const zb = at(len(pj_dsd, DV), b * NPJ + NCH + j * DV);
      @fmuls(ob, ob, rms_scale(oss[b * VH + j], VD));
      @fmuls(ob, ob, at(nw_dsd, j * DV));
      silu_mul(ob, zb, ob, DV, true);
    }
    wmv(at(hv_dsd, b * Hc), wo_dsd, at(ob_dsd, b * NV), NV);
  }
  mark(4);
  allreduce(false, hv_all, B * Hc);
  @fadds(x_all, x_all, hv_all);
  mark(5);
  // 6–9: the second RMSNorm and the MLP, MC lanes at a time (as qwen2d_paged).
  axis_y();
  b = 0;
  while (b < nb) : (b += 1) { xss[b] = sum_sq(x_ptr, b * Hc, Hc); }
  @fmovs(hv_all, 0.0);
  var c0: u16 = 0;
  while (c0 < nb) : (c0 += dims[4]) {
    var k: u16 = 0;
    while (k < dims[4]) : (k += 1) {
      const lb = c0 + k;
      @fmuls(at(xn_dsd, lb * Hc), at(x_dsd, lb * Hc), g2_dsd);
      const gb = at(gu_dsd, k * GU1);
      @fmovs(gb, 0.0);
      wmv(gb, wgu_dsd, at(xn_dsd, lb * Hc), Hc);
      gu[k * GU1 + 2 * Ic] = xss[lb];
    }
    allreduce(false, gu_all, MC * GU1);
    k = 0;
    while (k < dims[4]) : (k += 1) {
      const gb = at(gu_dsd, k * GU1);
      @fmuls(gb, gb, rms_scale(gu[k * GU1 + 2 * Ic], HID));
    }
    @fmovs(act_mc, 0.0);
    var el: u16 = py;
    while (el < Ic) : (el += P) { silu_col(el); }
    allreduce(false, act_mc, MC * Ic);
    k = 0;
    while (k < dims[4]) : (k += 1) { wmv(at(hv_dsd, (c0 + k) * Hc), wd_dsd, at(act_dsd, k * Ic), Ic); }
  }
  mark(6);
  axis_xx();
  allreduce(false, hv_all, B * Hc);
  @fadds(x_all, x_all, hv_all);
  mark(7);
}

fn init() void {
  if (W16 == 1) {
    wp_dsd = @set_dsd_base_addr(wp_dsd, @ptrcast([*]@fp16(), &wp[1]));
    wo_dsd = @set_dsd_base_addr(wo_dsd, @ptrcast([*]@fp16(), &wo[1]));
    wgu_dsd = @set_dsd_base_addr(wgu_dsd, @ptrcast([*]@fp16(), &wgu[1]));
    wd_dsd = @set_dsd_base_addr(wd_dsd, @ptrcast([*]@fp16(), &wd[1]));
  }
  dims[0] = B;
  dims[4] = MC;
  qscale = rsqrt(@as(f32, P));
  px = layout_mod.get_x_coord();
  py = layout_mod.get_y_coord();
  route_gbcast();
  axis_y();
  sys_mod.unblock_cmd_stream();
}

// `steps` passes, each over x as the last left it.
fn compute(steps: u32) void {
  timestamp.enable_tsc();
  var i: u32 = 0;
  while (i < steps) : (i += 1) {
    // No per-pass prologue: the layer reads no positions.
    timing = i > 0;
    timestamp.get_timestamp(&t_mark);
    layer();
  }
  sys_mod.unblock_cmd_stream();
}

// Lane slot b starts a new sequence: its conv window and state are zeroed.
fn reset(b: u32) void {
  const lb = @as(u16, b);
  @fmovs(at(len(cst_dsd, CWm * NCH), lb * CWm * NCH), 0.0);
  @fmovs(at(len(st_dsd, NV), lb * NV), 0.0);
  sys_mod.unblock_cmd_stream();
}

comptime {
  @initialize_queue(q_r1_0_in, .{ .color = c_r1_0 });
  @initialize_queue(q_r1_0_out, .{ .color = c_r1_0 });
  @initialize_queue(q_r1_1_in, .{ .color = c_r1_1 });
  @initialize_queue(q_r1_1_out, .{ .color = c_r1_1 });
  @initialize_queue(q_r2_0_in, .{ .color = c_r2_0 });
  @initialize_queue(q_r2_0_out, .{ .color = c_r2_0 });
  @initialize_queue(q_r2_1_in, .{ .color = c_r2_1 });
  @initialize_queue(q_r2_1_out, .{ .color = c_r2_1 });
  @initialize_queue(q_bc_in, .{ .color = c_bc });
  @initialize_queue(q_bc_out, .{ .color = c_bc });

  @export_symbol(x_ptr, "x");
  @export_symbol(gamma1_ptr, "gamma1");
  @export_symbol(gamma2_ptr, "gamma2");
  @export_symbol(wp_ptr, "wp");
  @export_symbol(cw_ptr, "cw");
  @export_symbol(cst_ptr, "cst");
  @export_symbol(gab_ptr, "gab");
  @export_symbol(nw_ptr, "nw");
  @export_symbol(st_ptr, "st");
  @export_symbol(wo_ptr, "wo");
  @export_symbol(wgu_ptr, "wgu");
  @export_symbol(wd_ptr, "wd");
  @export_symbol(prof_ptr, "prof");
  @export_symbol(dims_ptr, "dims");
  @export_symbol(init);
  @export_symbol(compute);
  @export_symbol(reset);
}
