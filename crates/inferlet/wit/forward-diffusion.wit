// The forward-pass surface for a block-diffusion text (DiffusionGemma): one
// trunk, two attention modes, and the guest chooses per pass which one a fire
// runs:
//
//   `encode`   the causal reading. Its rows attend causally over the prefix
//              and themselves and its KV writes ARE the sequence — a prompt
//              prefill, or the pass that commits a finished canvas.
//   `denoise`  the bidirectional reading. Its rows are one canvas; every row
//              attends every key of `[prefix | canvas]`, the keys after it
//              included. The KV it writes is the canvas's scratch, rewritten
//              on every step and finally overwritten by the encode pass that
//              commits the block; the prefix is read and never written.
//
// The canvas is the guest's: its token ids are channels, and the sampler
// (which positions to accept, how to renoise the rest, when to stop) is an
// ETA epilogue over `[canvas-length, vocab]` logits, not host policy.
//
// Valid only when `model.pass-kind()` is `diffusion`. Legal stages:
// prologue, on_attn_proj, on_attn, epilogue.

interface forward-diffusion {
    use types.{error, data};
    use channel.{channel};
    use working-set.{working-set};
    use pipeline.{pipeline};
    use forward.{media-span, state-geometry};
    use model.{lane-stream};

    /// Which of the model's two readings a pass runs. See the file note.
    enum mode {
        encode,
        denoise,
    }

    resource forward-pass {
        constructor();

        /// `forward.state`. On a `denoise` pass the geometry describes the
        /// canvas, the same on every step, so one pass serves the whole
        /// denoising loop.
        state: func(
            lanes: list<borrow<working-set>>,
            geom:  state-geometry,
        ) -> result<_, error>;

        /// `forward.reading`, unchanged: which declared reading this pass
        /// runs. Optional when the model declares at most one.
        reading: func(name: string) -> result<_, error>;

        /// `forward.input`, unchanged: bind a channel to the model's input
        /// `name`, read (committed cell) at every submit. A denoiser's
        /// self-conditioning taps are two such inputs.
        input: func(name: string, ch: borrow<channel>) -> result<_, error>;

        /// `forward.stream`, unchanged: which lane stream this pass is.
        %stream: func(s: lane-stream) -> result<_, error>;

        /// `forward.group`, unchanged: the attention group this pass's
        /// lanes join within a frame.
        group: func(id: u32) -> result<_, error>;

        /// `forward.peer`, unchanged.
        peer: func(group: u32) -> result<_, error>;

        /// `forward.attention-classes`, unchanged.
        attention-classes: func(classes: list<s32>, table: list<u8>, count: u32) -> result<_, error>;

        /// The reading. REQUIRED: a diffusion pass with no mode is not
        /// submittable, because neither reading is a default the host may
        /// pick for the guest. Set before `program`; a pass keeps one mode
        /// for its life, so a loop holds one encode pass and one denoise
        /// pass rather than flipping either.
        ///
        /// A `denoise` pass on an engine whose attention cannot lift its
        /// causal bound is refused by name at submit, never read causally.
        canvas: func(mode: mode) -> result<_, error>;

        /// Bind embedding token ids and CSR row indptr. Both are channels.
        /// On a `denoise` pass the tokens are the canvas — random ids on the
        /// first step, whatever the guest's sampler wrote after. Required
        /// on a reading that embeds tokens, refused on one that does not
        /// (`forward.embed`'s rule).
        embed: func(
            tokens: borrow<channel>,
            indptr: borrow<channel>,
        ) -> result<_, error>;

        /// Bind an optional readout-index channel separately from embedding.
        /// A denoiser reads every canvas row.
        readout: func(indices: borrow<channel>) -> result<_, error>;

        /// `forward.media`, unchanged: an `encode` pass's concern, since a
        /// prompt is what carries images.
        media: func(spans: list<media-span>) -> result<_, error>;

        /// Attach canonical ETA bytes and channel handles in dense declaration
        /// order. Validation uses the engine-owned ModelProfile and rejects
        /// any stage this interface does not admit.
        program: func(
            container-bytes: data,
            channels: list<borrow<channel>>,
        ) -> result<_, error>;
    }

    /// Submit ONE FRAME on `on`: exactly `model.frame-size()` ordered slots.
    /// `forward.submit`'s contract, unchanged; an encode pass and a denoise
    /// pass may share a frame.
    submit: func(
        on: borrow<pipeline>,
        slots: list<option<borrow<forward-pass>>>,
    ) -> result<_, error>;
}
