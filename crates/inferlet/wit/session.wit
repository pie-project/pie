interface session {

    use types.{blob, error};
    use frames.{frames, pcm, image-format, audio-format};
    use working-set.{working-set};
    use grammar.{matcher};

    // Sends a message to the remote user client
    send: func(message: string);

    // Receives an incoming message from the remote user client
    receive: async func() -> option<string>;

    /// Sends a file to the remote user client, under a suggested file name
    /// if it has one.
    ///
    /// The bytes are already a guest value here -- that is what makes this
    /// `send-file` and not `send-frames`. The name says WHAT THE FILE IS:
    /// `pie run -o DIR` writes an unnamed file as `file-0000.bin`, which is
    /// the right answer for a blob nobody described and the wrong one for a
    /// guest that knows it just produced `image.latent.f32`.
    ///
    /// `name` is a suggestion and not a path, exactly as in `send-frames`:
    /// the host keeps the last component and the client sanitises again.
    send-file: func(data: blob, name: option<string>);

    // Receives an incoming file from the remote user client
    receive-file: async func() -> option<blob>;

    /// The file the client attached to this run under `name`
    /// (`pie run --file name=path`), or none.
    file: func(name: string) -> option<blob>;

    /// What a launch moves in, and a process gives back, by kind.
    enum handle-kind {
        working-set,
        matcher,
        frames,
        pcm,
    }

    /// One handle a launch moved in, or one a process gives back.
    variant handle {
        working-set(working-set),
        matcher(matcher),
        frames(frames),
        pcm(pcm),
    }

    /// The handle of `kind` the launch moved in under `name`, once; none if
    /// it moved no such handle, and one of another kind stays where it is.
    /// A working set is new if nothing has written it yet; a matcher stands
    /// where the client left it, or at the start of the grammar it wrote;
    /// frames and pcm are a process's output, or a client's upload, decoded.
    take: func(name: string, kind: handle-kind) -> option<handle>;

    /// Hands `h` to the client as what the launch named `name` in its
    /// returns. It lands in the client's session when this process ends,
    /// once its last fire has settled; frames and pcm never cross linear
    /// memory. Refused if the launch expects no such return, or has one
    /// already; `h` is dropped either way it fails.
    give: func(name: string, h: handle) -> result<_, error>;

    /// Encodes `f` and streams the bytes to the client under `name`, WITHOUT
    /// the encoded file ever entering WASM linear memory.
    ///
    /// This is `send-file` for a handle rather than a buffer, and the
    /// difference is the whole point: `send-file(f.encode(format))` produces
    /// the same file having first copied every byte of it into the guest's
    /// heap. A 121-frame clip is tens of megabytes; a guest that only wants
    /// the client to have it should never hold it.
    ///
    /// `name` is a suggested file name, carried beside the bytes to the
    /// client (`pie run -o DIR` writes it there under this name). It is a
    /// suggestion, not a path: the client sanitises it.
    send-frames: func(f: borrow<frames>,
                      format: image-format,
                      name: string) -> result<_, error>;

    /// `send-frames` for audio. Same statute: the samples are encoded
    /// host-side and streamed out, never materialized in linear memory.
    send-pcm: func(p: borrow<pcm>,
                   format: audio-format,
                   name: string) -> result<_, error>;

    /// `receive` for a guest that cannot lower an `async func` (see
    /// `channel.take-blocking`): the guest's task blocks until a message
    /// arrives.
    receive-blocking: func() -> option<string>;

    /// `receive-file` for the same guests.
    receive-file-blocking: func() -> option<blob>;

    /// Merges `props`, a JSON object, into this process's PLEX props; a `null`
    /// removes a name. `cluster/` names are the cluster policy's, left as they
    /// are; props over the limits are refused.
    set-props: func(props: string) -> result<_, error>;

    /// Prompt tokens this process's passes found already cached, and so
    /// mapped in rather than computed, so far: what a usage report calls
    /// cached.
    cached-tokens: func() -> u32;
}
