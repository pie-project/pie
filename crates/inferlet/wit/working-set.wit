interface working-set {

    use types.{error};
    use pipeline.{pipeline};

    // A working set is one sequence's model state: slot `i` holds what the
    // model keeps for the `i`-th token. It names no pages; the runtime owns
    // where the state lives.
    //
    //   [0, folded)          frozen: shared, kept after release, moved
    //                        between memory tiers.
    //   [folded, reserved)   the buffer: this working set's alone; writing a
    //                        slot again replaces it.
    //
    // Fold what is final: free for KV, the scan for a recurrent state.
    resource working-set {
        constructor();

        // Let passes write slots below `end`: needed only when a pass's slots
        // are computed on the device.
        reserve: func(end: u32) -> result<_, error>;

        // The frozen length; while a device-counted fold is in flight, the
        // length before it.
        folded: func() -> u32;

        // Slots mapped in from state the runtime already held: a prompt's
        // cached tokens.
        cached-tokens: func() -> u32;

        // A child that shares the frozen part and gets a copy of the buffer,
        // ordered on `on`.
        fork: func(on: borrow<pipeline>) -> result<working-set, error>;

        // Later rows of this working set and its forks no longer read the
        // whole pages inside frozen `[start, end)`; rows keep their positions
        // and nothing is recomputed. Returns the slots dropped.
        forget: func(start: u32, end: u32) -> result<u32, error>;

        // Later rows of this working set and its forks also read the whole
        // frozen pages of `other` inside `[start, end)`, as they stand now;
        // nothing is recomputed or copied, and they stay readable whatever
        // becomes of `other`. Rows here run on past the slots merged.
        // Returns the slots merged.
        merge: func(other: borrow<working-set>, start: u32, end: u32) -> result<u32, error>;

        // Rows from here on run `slots` positions further: past what a merge
        // of only some chunks left out.
        advance: func(slots: u32) -> result<_, error>;
    }

}
