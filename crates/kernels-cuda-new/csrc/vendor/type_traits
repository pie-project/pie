//===-- type_traits - the eight traits a dtype dispatch is written in ----===//
//
// `std::is_same_v`, `std::conditional_t`, and the six names they are built
// out of. This is what `#include <type_traits>` resolves to when the compiler
// is NVRTC and the include path is a header set carried in the binary.
//
// # Why this is not a guard, either
//
// For the same reason `cstdint` in this directory is not: the names are used
// by device code, so guarding the directive away with `#ifndef __CUDACC_RTC__`
// deletes the include and leaves the uses. Measured over FlashInfer 0.6.15's
// attention closure: `std::is_same_v` 40 times, `std::conditional_t` 18,
// `std::is_same` 8, and one `std::void_t` / `std::declval` pair inside
// `utils.cuh`'s `DEFINE_HAS_MEMBER`, which `decode.cuh` expands at namespace
// scope on its first line of code. Every one of them is a compile-time
// question asked by a `__device__` template about its own dtype parameter.
//
// NVRTC answers none of them: `namespace "std" has no member "is_same"` with
// an empty header set, and the same with the real CUDA device headers in it.
//
// # The list is the measurement, not the standard's surface
//
// A real `<type_traits>` is some seventy traits. This is eight, because eight
// is what the closure names, and the file must not grow into the other one:
// a second standard library is a second set of promises to disagree with the
// first. When a FlashInfer bump reaches for a ninth, the compile says so by
// name and the entry is one line -- which is a better failure than a
// half-right `is_convertible` nobody reads.
//
// `std::max` and `std::min` are deliberately absent, and their absence is the
// interesting one: they appear 58 times, and every site is inside a HOST
// dispatch function -- `BatchDecodeWithPagedKVCacheDispatched` and its
// relatives -- which the vendored copies guard away wholesale under
// `__CUDACC_RTC__`, because under the JIT the launch is `cuLaunchKernel` from
// Rust and the host half of FlashInfer is exactly the half we replace.

#ifndef PIE_NVRTC_TYPE_TRAITS_
#define PIE_NVRTC_TYPE_TRAITS_

namespace std {

/// The compile-time constant every trait below is a specialisation of.
template <class T, T v>
struct integral_constant {
  static constexpr T value = v;
  using value_type = T;
  using type = integral_constant;
  __host__ __device__ constexpr operator value_type() const noexcept { return value; }
  __host__ __device__ constexpr value_type operator()() const noexcept { return value; }
};

/// `integral_constant<bool, true>`, spelled as the standard spells it.
using true_type = integral_constant<bool, true>;
/// `integral_constant<bool, false>`.
using false_type = integral_constant<bool, false>;

/// Whether two types are the same type, ignoring nothing.
template <class T, class U>
struct is_same : false_type {};
template <class T>
struct is_same<T, T> : true_type {};
/// The variable form, which is how the closure spells it 40 times out of 48.
template <class T, class U>
inline constexpr bool is_same_v = is_same<T, U>::value;

/// `B ? T : F`, over types.
template <bool B, class T, class F>
struct conditional {
  using type = T;
};
template <class T, class F>
struct conditional<false, T, F> {
  using type = F;
};
/// The alias form, which is the only form the closure uses.
template <bool B, class T, class F>
using conditional_t = typename conditional<B, T, F>::type;

/// SFINAE's discard: any type list, collapsed to `void`.
template <class...>
using void_t = void;

/// A value of `T` in an unevaluated context. Declared and never defined, as
/// the standard requires -- calling it is the diagnostic.
template <class T>
T&& declval() noexcept;

}  // namespace std

#endif  // PIE_NVRTC_TYPE_TRAITS_
