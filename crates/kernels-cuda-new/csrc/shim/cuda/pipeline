//===-- cuda/pipeline - cp.async, wearing libcu++'s name -----------------===//
//
// `cuda::pipeline`, `cuda::pipeline_shared_state`, `cuda::memcpy_async` and
// `cuda::aligned_size_t`, over `cp.async.ca/cg.shared.global`,
// `cp.async.commit_group` and `cp.async.wait_group`. This is what
// `#include <cuda/pipeline>` resolves to when the compiler is NVRTC and the
// include path is a header set carried in the binary rather than a directory
// on a disk.
//
// # Why a shim rather than libcu++
//
// `examples/header_probe.rs` measured NVRTC 13.0 on this box against an empty
// header set: `<cuda/pipeline>` fails with *"could not open source file ...
// (no directories in search list)"*, one of 31 external directives out of our
// FlashInfer closure of which **0 were answered**.
//
// The alternative is to put libcu++ in the header set. CCCL as the toolkit
// ships it here -- `/usr/local/cuda-13.0/targets/x86_64-linux/include/cccl`
// -- is **13,691,725 bytes across 1,691 files**, against which the whole of
// this header set is four figures. That ratio is the argument, and it is the
// same one `cuda/std/limits` makes.
//
// The toolkit's copy is not useless, though: it is the REFERENCE.
// `examples/fp8_pipeline_probe.rs` compiles the same staging kernel twice --
// once with `nvcc` against that real `<cuda/pipeline>`, once with NVRTC
// against this file -- and requires the two to produce identical bytes on the
// same device from the same input. A shim for a synchronisation primitive
// that had only ever been checked against itself would be worth very little.
//
// # The name is the trick, again
//
// No extension, a directory in the path, because the directive has both:
// `permuted_smem.cuh:23` says `#include <cuda/pipeline>` and NVRTC matches
// `includeNames[]` against that literal string. The nesting is part of a
// name; NVRTC walks no directories.
//
// # What the closure reaches: NOTHING, and that is why this file is careful
//
// Counted over the 28-file, 17,981-line attention closure, over the entire
// FlashInfer source tree outside `3rdparty/`, and over `kernels-cuda/csrc/src`:
//
// | name | closure | flashinfer tree | our csrc |
// |---|---|---|---|
// | `#include <cuda/pipeline>` | 1 | 1 | 0 |
// | `cuda::pipeline` | 0 | 0 | 0 |
// | `cuda::memcpy_async` | 0 | 0 | 0 |
// | `cuda::pipeline_shared_state` | 0 | 0 | 0 |
// | `cuda::aligned_size_t` | 0 | 0 | 0 |
// | `producer_acquire` / `producer_commit` | 0 | 0 | 0 |
// | `consumer_wait` / `consumer_release` | 0 | 0 | 0 |
// | `pipeline_producer_commit` | 0 | 0 | 0 |
//
// The include at `permuted_smem.cuh:23` is **vestigial**: nothing behind it
// is called. FlashInfer stages through shared memory constantly and does it
// with its own `cp_async.cuh` wrappers -- `commit_group()`, `wait_group<n>()`,
// `load_128b<>()` -- straight onto the same instructions this file uses. The
// one place upstream reaches for a libcu++ synchronisation object at all,
// `mamba/kernel_selective_state_update_stp.cuh`, uses `cuda::barrier` and TMA,
// and is not in our closure.
//
// So the smallest correct file here is `#pragma once` and nothing else. It is
// not what is here, for one reason: an empty header answers the directive and
// then answers `cuda::pipeline` with *"namespace cuda has no member"* at some
// future call site, which reads like a missing include and sends the reader
// looking for a file that is already found. A facility that exists and works
// is a better answer than a name that resolves to a void -- and having built
// it, `examples/fp8_pipeline_probe.rs` proves the synchronisation rather than
// the compile, because a staging pipeline that copies the right bytes at the
// wrong time passes every single-threaded check ever written.
//
// The vestigial include is still an include, and it is answered: the vendored
// `flashinfer/permuted_smem.cuh` compiles under NVRTC 13.0 against this file,
// and so does the whole 15-root closure that reaches it -- measured, 796
// carried headers, `-default-device`, no include path, no toolkit.
// `fp8_pipeline_probe` reports that compile every run.
//
// # The semantics, stated as a contract
//
// A stage is a buffer. `producer_acquire()` claims the next one,
// `memcpy_async()` fills it, `producer_commit()` closes the batch,
// `consumer_wait()` blocks until the OLDEST open batch has landed, and
// `consumer_release()` gives that stage back. This shim implements the
// **unified role** -- every thread in the block is both producer and consumer
// and runs the same sequence -- because that is the shape every staged
// attention kernel in this tree has, and because the split-role forms need
// `cuda::barrier`, which is not in the set.
//
// The mapping is three instructions and two barriers:
//
//   * `memcpy_async` -> `cp.async.cg.shared.global` at 16 bytes, or
//     `cp.async.ca.shared.global` at 8 or 4, chosen from a runtime alignment
//     test on both pointers and the size.
//   * `producer_commit` -> `cp.async.commit_group`, plus one on a counter.
//   * `consumer_wait` -> `cp.async.wait_group N` where `N` is the number of
//     batches allowed to remain in flight, **then `__syncthreads()`**.
//   * `consumer_release` -> `__syncthreads()`, then one off the counter.
//
// Both barriers are load-bearing and they guard opposite hazards.
// `cp.async.wait_group` is a promise to the CALLING THREAD about ITS OWN
// copies; the barrier in `consumer_wait` is what makes thread 0's staged
// bytes visible to thread 33. The barrier in `consumer_release` is what stops
// a thread that has finished reading a stage from racing ahead and issuing
// the next batch into it while a slower thread is still reading. Drop the
// first and a neighbour read returns stale memory on some launches; drop the
// second and it returns the NEXT tile's data on some launches. Neither shows
// up in a single-threaded test, both show up in `fp8_pipeline_probe`'s
// neighbour-read kernel -- **500 of 500 launches wrong** for each omission
// when it was measured, against 2,000 clean launches of the real thing with
// no mismatch -- and that is why that kernel exists.
//
// `cp.async.wait_group` takes an IMMEDIATE, and the number of batches in
// flight is a run-time count, so `consumer_wait` switches over eight literal
// waits. Past eight the `default` arm waits for **all** of them --
// over-synchronising, never under-synchronising: a performance cliff, not a
// correctness one, and the stage-count `static_assert` in
// `pipeline_shared_state` means block-scope users meet the compile error
// before they can meet the cliff.
//
// # Below sm_80: what the fallback preserves, and what it does not
//
// `cp.async` is sm_80 and up. Below that this file copies synchronously, in
// the calling thread, before returning from `memcpy_async`. State plainly
// what survives that substitution:
//
// **Preserved.** Data. Every byte a consumer reads after `consumer_wait()` is
// the byte the producer asked for -- earlier, in fact, since the copy is
// already done when `memcpy_async` returns. Block ordering: both
// `__syncthreads()` are still there, so cross-thread visibility and the
// no-overwrite-while-reading rule are unchanged. The stage bound: the counter
// still trips `producer_acquire()` at capacity. Any program correct against
// the async contract stays correct against the fallback, because the fallback
// only ever completes SOONER.
//
// **Not preserved.** Asynchrony, and therefore the entire point: nothing
// overlaps, and a kernel tuned for latency hiding will be slower by whatever
// the memory latency was. And the source-immutability rule inverts. Under
// `cp.async` the source region must not be written between `memcpy_async` and
// the wait, because the copy engine reads it during that window; under the
// fallback the read has already happened and modifying the source is
// harmless. **Code written against the fallback's extra freedom miscompiles
// on real hardware** -- silently, on a machine the author does not have. That
// is the direction the danger runs, and the reason this paragraph is here
// rather than in a commit message.
//
// This is also why the fallback is a fallback and not the implementation. The
// pie CUDA backend targets sm_80 and up; a pre-Ampere path in this file is
// insurance against a compile, not a device anybody runs.
//
// # Deliberately absent, each with what would want it
//
//   * **`pipeline_producer_commit(pipe, barrier)`** -- takes a
//     `cuda::barrier`, which is `<cuda/barrier>`, which is not in the set.
//     Adding it would mean shimming a second synchronisation object to make a
//     third one's signature typecheck.
//   * **`make_pipeline(group, state, producer_count)` and the `pipeline_role`
//     overload** -- the split-role pipeline, where some warps only produce and
//     others only consume. It is not `__syncthreads()` underneath; it is a
//     pair of arrive/wait barriers with asymmetric counts, and writing that
//     from the outside is how a deadlock gets shipped.
//   * **The `memcpy_async(group, dst, src, size, pipe)` overload** -- upstream
//     SPLITS the copy across the group's threads. A shim that ignored the
//     group and had every thread copy every byte would compile, would usually
//     produce the right bytes, and would be a data race on every one of them.
//     Absent, so the call site names itself.
//   * **`consumer_wait_prior<N>()`, `consumer_wait_for()`, `quit()`** -- zero
//     uses; `quit()` in particular has a return value about which thread left
//     last that this counter-based implementation cannot answer.
//   * **`thread_scope_device` and `thread_scope_system` pipelines** -- the
//     enumerators exist because the enumeration is shared vocabulary, but a
//     pipeline at those scopes needs a barrier wider than the block and there
//     is no such thing to build it from here. `static_assert` in `pipeline`,
//     naming the scope.
//   * **`cuda::barrier`, `cuda::atomic`, `cuda::annotated_ptr`** -- other
//     headers' surfaces. This file answers one directive.
//
// Absence means a NAME ERROR at the call site, which is the pattern
// `cooperative_groups.h` set with `this_grid()`. A loud absence beats a quiet
// lie, and in a synchronisation primitive the quiet lie is a race that
// reproduces on a customer's machine at a rate of one launch in ten thousand.
//
// # One divergence from upstream that is measurable, and is not a bug
//
// `sizeof(pipeline_shared_state<thread_scope_block, 2>)` is 1 here and
// **measured 40** against the toolkit's CCCL 3.0.1, because this
// implementation's barrier is `__syncthreads()` and needs no storage
// while upstream's is a barrier per stage. A kernel that sizes its dynamic
// shared memory off that `sizeof` therefore asks for LESS with this header
// than with libcu++ -- safe in that direction, and the opposite direction
// cannot arise. Recorded because a number that differs between two builds of
// the same source is worth finding here rather than in a launch failure.
//
// # Includes nothing
//
// `size_t`, `__syncthreads`, `__trap`, `__isShared`, `__isGlobal` and
// `__cvta_generic_to_shared` are all NVRTC builtins -- measured on this box
// against an empty header set, along with the `cp.async` family in inline
// asm. Not `<cstddef>`, not `<cuda/std/type_traits>`, not
// `cooperative_groups.h`: a header in the set that includes another header in
// the set is a diamond the includer did not ask for.
//
//===----------------------------------------------------------------------===//
#pragma once

namespace cuda {

// The scope enumeration belongs to `<cuda/atomic>` upstream and is visible
// from a dozen headers. Guarded so that a future `<cuda/barrier>` or
// `<cuda/atomic>` in this set can define it too without a redefinition error,
// and so that whichever one lands second does not have to know about the
// first.
//
// The values are upstream's, and they are not 0,1,2,3: libcu++ defines them
// as `__ATOMIC_SYSTEM/DEVICE/BLOCK/THREAD`, which are **0, 1, 2 and 10**.
// Measured against the toolkit's CCCL 3.0.1 rather than guessed, and worth
// the trouble because a `thread_scope` is an ordinary enum that can be
// stored, passed and compared -- a shim that renumbered it would agree with
// itself and disagree with every translation unit that saw the real header.
#ifndef __PIE_CUDA_THREAD_SCOPE_DEFINED
#define __PIE_CUDA_THREAD_SCOPE_DEFINED
enum thread_scope {
    thread_scope_system = 0,
    thread_scope_device = 1,
    thread_scope_block = 2,
    thread_scope_thread = 10,
};
#endif

template <thread_scope _Scope, unsigned char _StagesCount>
class pipeline_shared_state;

template <thread_scope _Scope>
class pipeline;

template <class _Group, thread_scope _Scope, unsigned char _StagesCount>
__device__ __forceinline__ pipeline<_Scope> make_pipeline(
    const _Group& __group, pipeline_shared_state<_Scope, _StagesCount>* __state);

__device__ __forceinline__ pipeline<thread_scope_thread> make_pipeline();

/// A size that also carries an alignment claim, upstream's spelling.
///
/// Accepted, and then treated as a plain size: the copy path tests both
/// pointers and the length at run time anyway, and that test is strictly more
/// informative than the claim. Trusting `_Align` to skip the test would buy
/// one branch in a facility with zero call sites and would pay for it with
/// silent shared-memory corruption the first time a caller's claim is wrong.
/// The type exists so upstream's spelling compiles; the alignment it promises
/// is verified rather than believed.
template <size_t _Align>
struct aligned_size_t {
    static constexpr size_t align = _Align;
    size_t value;

    __host__ __device__ explicit aligned_size_t(size_t __size) : value(__size) {}
    __host__ __device__ operator size_t() const { return value; }
};

/// Stage bookkeeping for a block-scope pipeline.
///
/// Carries no barrier, because the barrier is `__syncthreads()` -- see the
/// banner's note on `sizeof`. It exists as a type so that `make_pipeline`'s
/// signature is upstream's and so the stage count is checked once, here,
/// where the number is written.
///
/// Must live in `__shared__` storage the way upstream's must: nothing in this
/// implementation reads it, but a `__local__` one would be a lie about what
/// the object is for, and the day this grows a real barrier it becomes a
/// crash instead of an edit.
template <thread_scope _Scope, unsigned char _StagesCount>
class pipeline_shared_state {
    static_assert(_Scope == thread_scope_block,
                  "pie shim: cuda::pipeline_shared_state is implemented for "
                  "cuda::thread_scope_block only -- a wider scope needs a barrier wider than "
                  "__syncthreads(), which this header set has no way to build.");
    static_assert(_StagesCount >= 1 && _StagesCount <= 8,
                  "pie shim: cuda::pipeline supports 1 to 8 stages. The wait is "
                  "cp.async.wait_group with an IMMEDIATE operand, so the depths are literals in "
                  "a switch; past eight the implementation would silently stop overlapping.");

    template <thread_scope>
    friend class pipeline;
    template <class _Group, thread_scope _Sco, unsigned char _N>
    friend __device__ __forceinline__ pipeline<_Sco> make_pipeline(
        const _Group&, pipeline_shared_state<_Sco, _N>*);

    unsigned char __unused_;
};

/// The copy engine: one staged batch, as `cp.async` if the addresses allow it
/// and as a synchronous loop if they do not.
///
/// Three conditions have to hold before the instruction is legal --
/// destination in shared, source in global, and both plus the length aligned
/// to a width `cp.async` supports (4, 8 or 16 bytes). All three are checked,
/// none is assumed, and failing any of them takes the synchronous path, which
/// is slower and strictly stronger. A shim that assumed them would be
/// converting a caller's mistake into corrupt shared memory.
__device__ __forceinline__ void __pie_pipeline_stage_copy(void* __dst, const void* __src,
                                                          size_t __size) {
#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 800)
    if (__isShared(__dst) && __isGlobal(__src)) {
        unsigned int __d = static_cast<unsigned int>(__cvta_generic_to_shared(__dst));
        const char* __s = static_cast<const char*>(__src);
        const size_t __mix = static_cast<size_t>(__d) | reinterpret_cast<size_t>(__s) | __size;

        if ((__mix & 15u) == 0u) {
            for (size_t __i = 0; __i < __size; __i += 16) {
                asm volatile("cp.async.cg.shared.global [%0], [%1], 16;\n" ::"r"(
                                 __d + static_cast<unsigned int>(__i)),
                             "l"(__s + __i)
                             : "memory");
            }
            return;
        }
        if ((__mix & 7u) == 0u) {
            for (size_t __i = 0; __i < __size; __i += 8) {
                asm volatile("cp.async.ca.shared.global [%0], [%1], 8;\n" ::"r"(
                                 __d + static_cast<unsigned int>(__i)),
                             "l"(__s + __i)
                             : "memory");
            }
            return;
        }
        if ((__mix & 3u) == 0u) {
            for (size_t __i = 0; __i < __size; __i += 4) {
                asm volatile("cp.async.ca.shared.global [%0], [%1], 4;\n" ::"r"(
                                 __d + static_cast<unsigned int>(__i)),
                             "l"(__s + __i)
                             : "memory");
            }
            return;
        }
    }
#endif
    // Synchronous, and already complete on return. See the banner for the one
    // guarantee this does NOT reproduce: the source may be modified before
    // the wait here and may not be on hardware.
    char* __d8 = static_cast<char*>(__dst);
    const char* __s8 = static_cast<const char*>(__src);
    for (size_t __i = 0; __i < __size; ++__i) {
        __d8[__i] = __s8[__i];
    }
}

/// A staged copy pipeline over `cp.async`, in the unified role.
///
/// Copyable by value and per-thread: every thread in the block runs the same
/// sequence and keeps its own counter, which is exactly the invariant that
/// makes one `cp.async.wait_group` immediate right for all of them.
template <thread_scope _Scope>
class pipeline {
    static_assert(_Scope == thread_scope_thread || _Scope == thread_scope_block,
                  "pie shim: cuda::pipeline is implemented for cuda::thread_scope_thread and "
                  "cuda::thread_scope_block. A device- or system-scope pipeline needs a barrier "
                  "this header set cannot build, and a shim that used __syncthreads() for one "
                  "would be claiming a synchronisation it does not perform.");

public:
    /// Claim the next stage.
    ///
    /// At block scope this is a bounds check, not a wait: in the unified role
    /// the thread that would have to release the stage is this thread, so a
    /// full pipeline here is not contention -- it is a missing
    /// `consumer_release()`, and continuing would overwrite a stage another
    /// thread is still reading. Upstream would block forever. `__trap()`
    /// instead, because a hang tells you nothing and a trap names the launch.
    ///
    /// At thread scope there is no shared state and no stage to overwrite, so
    /// there is nothing to bound and this is a no-op, as upstream's is.
    __device__ __forceinline__ void producer_acquire() {
        if (__stages_ != 0 && __outstanding_ >= __stages_) {
            __trap();
        }
    }

    /// Close the batch: `cp.async.commit_group`, and one more in flight.
    ///
    /// Not a barrier. The batch is committed per thread; making it visible to
    /// the rest of the block is `consumer_wait`'s job, and doing it here as
    /// well would cost a second `__syncthreads()` per stage for nothing.
    __device__ __forceinline__ void producer_commit() {
#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 800)
        asm volatile("cp.async.commit_group;\n" ::: "memory");
#endif
        ++__outstanding_;
    }

    /// Block until the oldest committed batch has landed and is visible to
    /// the whole block.
    ///
    /// `wait_group N` leaves the N most recent batches in flight, so waiting
    /// for the oldest of `k` means `N = k - 1`. The switch is because that
    /// operand is an immediate. `default` waits for all of them, which is
    /// correct and slow -- the only way to reach it is a thread-scope
    /// pipeline more than eight batches deep, since block scope is bounded by
    /// a `static_assert`.
    ///
    /// The `__syncthreads()` is the half of this that `cp.async` does not do:
    /// the wait is a promise about the calling thread's own copies, and a
    /// pipeline exists so that OTHER threads can read what this one staged.
    __device__ __forceinline__ void consumer_wait() {
        if (__outstanding_ == 0) {
            // Waiting for a batch nobody committed. Upstream blocks forever;
            // this is always a bug in the staging loop, so say so at once.
            __trap();
        }
#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 800)
        switch (static_cast<unsigned>(__outstanding_) - 1u) {
            case 0: asm volatile("cp.async.wait_group 0;\n" ::: "memory"); break;
            case 1: asm volatile("cp.async.wait_group 1;\n" ::: "memory"); break;
            case 2: asm volatile("cp.async.wait_group 2;\n" ::: "memory"); break;
            case 3: asm volatile("cp.async.wait_group 3;\n" ::: "memory"); break;
            case 4: asm volatile("cp.async.wait_group 4;\n" ::: "memory"); break;
            case 5: asm volatile("cp.async.wait_group 5;\n" ::: "memory"); break;
            case 6: asm volatile("cp.async.wait_group 6;\n" ::: "memory"); break;
            case 7: asm volatile("cp.async.wait_group 7;\n" ::: "memory"); break;
            default: asm volatile("cp.async.wait_group 0;\n" ::: "memory"); break;
        }
#endif
        if (_Scope == thread_scope_block) {
            __syncthreads();
        }
    }

    /// Give the oldest stage back to the producer.
    ///
    /// The barrier comes FIRST and it is the whole content of this call at
    /// block scope: it is what stops a thread that has finished reading the
    /// stage from issuing the next batch into it while a slower thread is
    /// still reading. Without it the pipeline still delivers correct bytes on
    /// a quiet machine and the wrong tile's bytes under load.
    __device__ __forceinline__ void consumer_release() {
        if (_Scope == thread_scope_block) {
            __syncthreads();
        }
        if (__outstanding_ == 0) {
            __trap();
        }
        --__outstanding_;
    }

private:
    __device__ __forceinline__ explicit pipeline(unsigned char __stages)
        : __stages_(__stages), __outstanding_(0) {}

    /// Stage bound, or 0 for the unbounded thread-scope pipeline.
    unsigned char __stages_;
    /// Batches committed and not yet released, by this thread.
    unsigned char __outstanding_;

    template <class _Group, thread_scope _Sco, unsigned char _N>
    friend __device__ __forceinline__ pipeline<_Sco> make_pipeline(
        const _Group&, pipeline_shared_state<_Sco, _N>*);
    friend __device__ __forceinline__ pipeline<thread_scope_thread> make_pipeline();
};

/// A block-scope pipeline over a shared state.
///
/// `__group` is upstream's and is ignored here beyond the requirement it
/// carries: **it must be the whole thread block**, because the barrier this
/// implementation uses is `__syncthreads()`. Hand it a
/// `cooperative_groups::thread_block` and the two agree. Hand it a tiled
/// partition of 32 and the barrier is wider than the group -- which is not a
/// wrong answer, it is a HANG, since the other warps never reach it. The
/// honest fix for a sub-block pipeline is a scope this file does not
/// implement, not a barrier it narrows by guesswork.
template <class _Group, thread_scope _Scope, unsigned char _StagesCount>
__device__ __forceinline__ pipeline<_Scope> make_pipeline(
    const _Group& __group, pipeline_shared_state<_Scope, _StagesCount>* __state) {
    (void)__group;
    (void)__state;
    return pipeline<_Scope>(_StagesCount);
}

/// A single-thread pipeline: no shared state, no barrier, no stage bound.
///
/// The one form where `cp.async`'s per-thread promise is the whole promise,
/// so `consumer_wait()` needs nothing after the wait.
__device__ __forceinline__ pipeline<thread_scope_thread> make_pipeline() {
    return pipeline<thread_scope_thread>(0);
}

/// Stage `__size` bytes from global into shared, asynchronously if the
/// addresses permit.
///
/// Per-thread: this thread copies these bytes. Upstream's group overload,
/// which splits one copy across a group's threads, is deliberately absent --
/// see the banner.
template <thread_scope _Scope, class _Size>
__device__ __forceinline__ void memcpy_async(void* __dst, const void* __src, _Size __size,
                                             pipeline<_Scope>& __pipe) {
    (void)__pipe;
    __pie_pipeline_stage_copy(__dst, __src, static_cast<size_t>(__size));
}

}  // namespace cuda
