// y = silu(g) * u over n elements of a gate and an up plane held apart.
fn k_swiglu_split(g: [*]f32, u: [*]f32, y: [*]f32, n: i32) void {
  var dg = @set_dsd_base_addr(k_base_f32, g);
  dg = @set_dsd_length(dg, @bitcast(u16, @as(i16, n)));
  var du = @set_dsd_base_addr(k_base_f32, u);
  du = @set_dsd_length(du, @bitcast(u16, @as(i16, n)));
  var dy = @set_dsd_base_addr(k_base_f32, y);
  dy = @set_dsd_length(dy, @bitcast(u16, @as(i16, n)));
  @map(k_silu_mul, dg, du, dy);
}
