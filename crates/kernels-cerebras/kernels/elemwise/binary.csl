// z[i] = x[i] op y[i] for i < n: op 0 adds, 1 multiplies, 2 divides, 3 takes
// the floored modulo (x - y * floor(x / y), as Python's `%`).
fn k_binary(x: [*]f32, y: [*]f32, z: [*]f32, n: i32, op: i32) void {
  var i: i32 = 0;
  while (i < n) : (i += 1) {
    var a: f32 = x[i];
    var b: f32 = y[i];
    var r: f32 = 0.0;
    if (op == 0) {
      r = a + b;
    } else if (op == 1) {
      r = a * b;
    } else if (op == 2) {
      r = a / b;
    } else {
      var q: f32 = a / b;
      var t: f32 = @as(f32, @as(i32, q));
      if (q < t) { t = t - 1.0; }
      r = a - b * t;
    }
    z[i] = r;
  }
}
