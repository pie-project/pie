// wafer/ops/cy_ple.csl: a column control PE's per-layer embedding (PLE) side input. The phase:
// [G a | G b | |d|^2 ..], s2, z = GELU(G a + s2 G b) ple (this column's PLE value of the layer),
// multicast [z | s2]. The bus (PB, iq6) carries a token's PLE values for every unit in this unit
// column (5 a unit) + a sequence word; an async receive for step s + 1 is posted at the end of step
// s (not the launch's last); step 0's words come from the host.
// Exports pl (this unit column's PLE words + the sequence word), plog ((DIAG 1 / PLOG 1) a step's
// PLE value and sequence word). rcfg past the core's: [12] PB colour, [13] this unit's place in
// the column, [14] bus words; the core's word: bit 0 on a PLE bus.
//
// Params: pe, fab, math, ON (false: no PLE), K (layers a unit).
// (seats) a launch's first lap's words are the host's (pls, a seat's after another); the bus //+seats
// carries each later pass's, one a pass, into a FIFO of M passes: a CY runs up to M passes //+seats
// ahead of the head without holding the bus. SEATS, LV (the most bus words). //+seats
param pe: imported_module;
param fab: imported_module;
param math: imported_module;
param ON: bool = true;
param K: u16;
param SEATS: u16 = 1; //+seats
param LV: u16 = 63; //+seats

const PN: u16 = if (ON) 64 else 1;
var pl = @zeros([PN]f32);
var plog = @zeros([2 * PN]f32);
var pui: u16 = 0;
var plv: u16 = 0;
var chk = @zeros([1]f32);
const NW: u16 = if (ON) SEATS * (LV + 1) else 1; //+seats
var pls = @zeros([NW]f32);   // the first lap's words, a seat's after another (host-written) //+seats
var fbuf = @zeros([NW]f32); //+seats
const fq = @allocate_fifo(fbuf);   // the later passes' //+seats
const ut_f = @get_ut_id(7);   // its reads //+seats
fn on_bus() bool { return (pe.word & 1) != 0; }
fn init() void {
  pui = @as(u16, pe.rcfg[pe.RQ + 13]);
  plv = @as(u16, pe.rcfg[pe.RQ + 14]);
}
fn wait(pos: u32) void {
  const want = @as(f32, pos + 1);
  const cd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> chk[i] });
  const sd = @increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> pl[i] }), @as(i16, plv), f32);
  @fmovs(cd, sd);
  while (chk[0] != want) { @fmovs(cd, sd); }
}
fn post() void {
  pl[plv] = -1.0;
  @fmovs(@set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PN} -> pl[i] }), plv + 1), fab.fin(pe.q_sm, plv + 1), .{ .async = true, .ut_id = pe.ut_p });
}
// (seats) pass s of n's words into pl: the first lap's from pls, the later ones' from the FIFO //+seats
fn take(s: u32, n: u32) void { //+seats
  const w = plv + 1; //+seats
  const pd = @set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{PN} -> pl[i] }), w); //+seats
  if (s == 0 and n > SEATS) { //+seats
    @fmovs(fq, fab.fin(pe.q_sm, (@as(u16, n) - SEATS) * w), .{ .async = true, .ut_id = pe.ut_p }); //+seats
  } //+seats
  if (s < SEATS) { //+seats
    @fmovs(pd, @increment_dsd_offset(@set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NW} -> pls[i] }), w), @as(i16, @as(u16, s) * w), f32)); //+seats
  } else { //+seats
    // (a FIFO read only waits for its words off the main thread: out through the loop-back, //+seats
    // idle between the reductions) //+seats
    @fmovs(fab.fout(pe.q_lo, w), fq, .{ .async = true, .ut_id = ut_f }); //+seats
    @fmovs(pd, fab.fin(pe.q_lb, w)); //+seats
  } //+seats
} //+seats
fn log(s: u32) void {
  if (on_bus() and s < 64) { plog[2 * @as(u16, s)] = pl[K * pui]; plog[2 * @as(u16, s) + 1] = pl[plv]; }
}
fn layer(l: u16) void {
  pe.reduce(6);
  const s2 = math.rsqrt(pe.t[2] * pe.IHID + pe.EPS);
  const g = pe.t[0] + s2 * pe.t[1];
  pe.u[0] = math.gelu1(g) * pl[K * pui + l];
  pe.u[1] = s2;
  pe.mcast(2);
}
