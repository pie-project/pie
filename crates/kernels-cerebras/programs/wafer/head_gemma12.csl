// wafer/head_gemma12.csl: the wafer program head weight PE for Gemma 4 12B (head_pe.csl with a tied head and head groups;
// README.md, Gemma 4 12B). A head column takes x's dims of a group of consecutive CX rows (NX <= HDc words,
// [RQ+17]; the rest of its HDc dims are padding with zero weights): the group's root CX sends them along its row
// (HX) to the head PE on that row (x role 2), which multicasts the HDc words up and down the column (HM); the other
// PEs take the multicast (x role 0).
// The embedding is the head tile itself (tied: f16 [HDc][VR], the winner's row read with stride VR, widened). The
// wafer token loop: the winner row's PEs send its NX dims north on VA to row 0, which sends them south on VS to the
// group's root row (te), which sends them west on HE into unit 0's CX (the group's root; the chain spreads them).
// Row 0 of a column whose root is row 0 is te itself.
param memcpy_params;
param VR: u16;
param HDc: u16;
param NPX: u16 = 1;    // x's f16 parts
param HACC16: u16 = 0; // 1 (measurement): the logit partials accumulate in f16 (y16), then widen once

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const fab = @import_module("ops/fabric.csl", .{ .NQ = 6 });
const matvec = @import_module("ops/mv.csl");
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;

var hw = @zeros([VR * HDc + 1]u16);
var hw_ptr: [*]u16 = &hw;
var hg = @zeros([HDc]f32);
var hg_ptr: [*]f32 = &hg;
var x = @zeros([HDc]f32);
var xr = @zeros([HDc]f32);
var xp = @zeros([NPX * HDc]@fp16());
var y: [VR]f32 align(16) = @zeros([VR]f32);
const x_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{HDc} -> x[i] });
const xr_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{HDc} -> xr[i] });
const hg_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{HDc} -> hg[i] });
const xp_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{HDc} -> xp[i] });
const y_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{VR} -> y[i] });
var a_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{VR} -> hw[i] });

// (queues: see the header)
const q_ra = @get_input_queue(2);
const q_rb = @get_input_queue(3);
const q_hx = @get_input_queue(4);
const q_hn = @get_input_queue(5);
const q_hm = @get_input_queue(6);
const q_w = @get_input_queue(7);     // the wafer loop's row word
const q_va = @get_output_queue(4);
const q_vs = @get_output_queue(5);
const q_he = @get_output_queue(6);
const q_hs = @get_output_queue(7);
const q_ro = @get_output_queue(2);
const q_xo = @get_output_queue(3);
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
const rr = @import_module("ops/red.csl", .{ .fab = fab, .IN1 = q_ra, .IN2 = q_rb, .OUT = q_ro, .UT1 = ut_a, .UT2 = ut_b, .FIFOW = 32 });
const NR: u16 = 12;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 18]u32);   // head_pe's; [RQ+17] NX
var rcfg_ptr: [*]u32 = &rcfg;
var role_x: u16 = 0;

fn init() void {
  fab.routes(&rcfg);
  var fq = [6]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]), @as(u16, rcfg[RQ + 3]), @as(u16, rcfg[RQ + 4]), @as(u16, rcfg[RQ + 10]) };
  fab.bind_iqs(&fq, @as(u16, rcfg[RQ + 9]));
  fab.oqc(2, rcfg[RQ + 5]); fab.oqc(3, rcfg[RQ + 6]);
  fab.oqc(4, rcfg[RQ + 13]); fab.oqc(5, rcfg[RQ + 14]); fab.oqc(6, rcfg[RQ + 15]); fab.oqc(7, rcfg[RQ + 16]);
  wfl = @as(u16, rcfg[RQ + 11]);
  va_addr = color_config.get_color_config_addr(@get_color(0)) + @as(u16, rcfg[RQ + 13]);
  va_orig = @get_config(va_addr, tgt.color_addr_range) & 0xff;
  timestamp.enable_tsc();
  rr.role = @as(u16, rcfg[RQ + 7]);
  role_x = @as(u16, rcfg[RQ + 8]);
  nx = @as(u16, rcfg[RQ + 17]);
  sys_mod.unblock_cmd_stream();
}

var y16 = @zeros([if (HACC16 == 1) VR else 1]@fp16());
const yh_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{if (HACC16 == 1) VR else 1} -> y16[i] });

var nx: u16 = 0;
fn recv_x() void {
  if (role_x == 0) {
    @fmovs(x_d, fab.fin(q_hm, HDc));
  } else {
    @fmovs(@set_dsd_length(x_d, nx), fab.fin(q_hx, nx));
    @fmovs(fab.fout(q_xo, HDc), x_d);
  }
}
fn send_r() void { rr.send(y_d, VR); }

// ---------------------------------------------------------------- the wafer token loop
var hemb = @zeros([1]u16);
var hemb_ptr: [*]u16 = &hemb;
var eb: [HDc]f32 align(16) = @zeros([HDc]f32);
const eb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{HDc} -> eb[i] });
var wfl: u16 = 0;
var va_addr: u16 = 0;
var va_orig: u16 = 0;
var va_dirty = false;
var ww = @zeros([1]f32);
const ww_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> ww[i] });
// (a send returns when its wavelets enter the output queue, not when they leave: the route goes back
// only once oq4 is empty, and only after the next step's x is in, ~a pass later)
fn va_restore() void {
  if (!va_dirty) { return; }
  while ((tile_config.output_queue_status.get_raw() & 0x1000) == 0) {}   // oq4 empty
  const r = @get_config(va_addr, tgt.color_addr_range) & 0xff00;
  @set_config(va_addr, r | va_orig, tgt.color_addr_range);
  va_dirty = false;
}
fn hloop() void {
  @fmovs(ww_d, fab.fin(q_w, 1));
  const w = ww[0];
  if (w < -1.0e8) { return; }
  const sink = (wfl & 2) != 0;
  const te = (wfl & 4) != 0;
  var wrow: u16 = 0;
  if (w >= 0.0) {
    wrow = @as(u16, rcfg[RQ + 12]);
    const j = @as(u16, w);
    // row j of the tied tile (dim-major: stride VR), f16 widened
    var d: u16 = 0;
    while (d < nx) : (d += 1) { eb[d] = @as(f32, @bitcast(@fp16(), hw[d * VR + j])); }
    const e = @set_dsd_length(eb_d, nx);
    if (sink and te) {
      @fmovs(fab.fout(q_he, nx), e);
    } else if (sink) {
      @fmovs(fab.fout(q_vs, nx), e);
    } else {
      const r = @get_config(va_addr, tgt.color_addr_range) & 0xff00;
      @set_config(va_addr, r | 0x80 | (va_orig & 0x1f), tgt.color_addr_range);
      va_dirty = true;
      @fmovs(fab.fout(q_va, nx), e);
    }
  } else {
    wrow = @as(u16, -w - 1.0);
  }
  if (sink and !te and wrow != 0) { @fmovs(fab.fout(q_vs, nx), fab.fin(q_hn, nx)); }   // (iq5: VA here)
  if (te and !(sink and wrow == 0)) { @fmovs(fab.fout(q_he, nx), fab.fin(q_hm, nx)); }  // (iq6: VS, or VA at row 0)
}

const timestamp = @import_module("<time>");
var tdbg = @zeros([6]u32);   // TSC of the last step: start, x in, matvec done, partial sent, loop phase done
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }
var n_steps: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var s: u32 = 0;
  while (s < n_steps) : (s += 1) {
    stamp(0);
    recv_x();
    stamp(1);
    va_restore();
    @fmuls(xr_d, x_d, hg_d);
    @fmovs(y_d, 0.0);
    if (HACC16 == 1) { @fmovh(yh_d, @as(@fp16(), 0.0)); }
    var k: u16 = 0;
    while (k < NPX) : (k += 1) {
      @fs2h(xp_d, xr_d);
      if (k + 1 < NPX) {
        @fh2s(x_d, xp_d);
        @fsubs(xr_d, xr_d, x_d);
      }
      const a = @set_dsd_base_addr(a_d, @ptrcast([*]@fp16(), &hw[0]));
      if (HACC16 == 1) {   // f16 accumulation (@fmach, the weight PEs' F16 path): the 32-dim partial in f16
        matvec.mac16(yh_d, a, xp_d);
      } else {
        matvec.mac32(y_d, a, xp_d);
      }
    }
    if (HACC16 == 1) { @fh2s(y_d, yh_d); }
    stamp(2);
    send_r();
    stamp(3);
    if ((wfl & 1) != 0) { hloop(); }
    stamp(4);
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_ra, .{ .color = @get_color(13) });
  @initialize_queue(q_rb, .{ .color = @get_color(14) });
  @initialize_queue(q_hx, .{ .color = @get_color(17) });
  @initialize_queue(q_hn, .{ .color = @get_color(18) });
  @initialize_queue(q_hm, .{ .color = @get_color(19) });
  @initialize_queue(q_ro, .{ .color = C_PARK });
  @initialize_queue(q_xo, .{ .color = C_PARK });
  @initialize_queue(q_w, .{ .color = @get_color(20) });
  @initialize_queue(q_va, .{ .color = C_PARK });
  @initialize_queue(q_vs, .{ .color = C_PARK });
  @initialize_queue(q_he, .{ .color = C_PARK });
  @initialize_queue(q_hs, .{ .color = C_PARK });
  @export_symbol(hemb_ptr, "hemb");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(hw_ptr, "hw");
  @export_symbol(hg_ptr, "hg");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(init);
  @export_symbol(compute);
}
