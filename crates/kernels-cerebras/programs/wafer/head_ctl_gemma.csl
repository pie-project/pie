// wafer/head_ctl_gemma.csl (head_ctl.csl + Gemma's TB: a storage row's control PE sends the winning id, or -1 on a
// launch's last step, west on TB after its row word, rcfg [RQ+13] on, [RQ+14] the colour): the wafer program head's control PE (one a head row, the head's middle
// column): the root of its row's logit reduction (both halves at once through a FIFO, back
// over a loop-back colour), then the row's argmax over its VR vocabulary rows: res = [max,
// the winning vocabulary id (f32 of the integer), passes] for the host (first version: the
// host takes the max over rows and feeds the embedding; the on-wafer max-reduce and embedding
// gather are the next step).
// The wafer token loop (rcfg WL 1): the rows' (max, id) are max-reduced down this column (two-level
// chains, root at the middle row; ties to the lower id, as the host's argmax); the root keeps the
// winner in `ring` (one a step) and multicasts it up and down the column; every row then sends its
// head PEs one word on the row multicast: the winner's offset in its row (the winner row), else
// -(1 + the winner's row), or -1e9 on a launch's last step (no embedding goes out).
param memcpy_params;
param VR: u16;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const fab = @import_module("ops/fabric.csl", .{ .NQ = 6 });
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const timestamp = @import_module("<time>");
var tdbg = @zeros([2 + 64 + 4]u32);   // + [66..70): the last step's row reduction in, argmax, max-reduce done, row word out   // TSC: the pass start, after the argmax; the max-reduce root: each step's winner (2 + s)
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }

var t: [VR]f32 align(16) = @zeros([VR]f32);
const t_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{VR} -> t[i] });
var t_ptr: [*]f32 = &t;           // "lgt": the row's VR logits of the last step (the host's full-logits path)
param VARG: u16 = 2;   // 2: block maxima of 8 + a two-level first-match scan; 1: the tree + a full scan   // 1: the row argmax as vector maxes + a first-match scan
const tb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{VR / 8} -> t[8 * i] });
const am = @import_module("ops/argmax.csl", .{ .VR = VR, .VARG = VARG, .t = &t, .t_d = t_d, .tb_d = tb_d });
var res = @zeros([4]f32);
var res_ptr: [*]f32 = &res;
const q_w = @get_input_queue(2);
const q_e = @get_input_queue(3);
const q_lb = @get_input_queue(4);
const q_lo = @get_output_queue(2);
const q_w1 = @get_input_queue(5);    // the max-reduce's level-1 input (a root: its low half)
const q_w2 = @get_input_queue(6);    // its level-2 input (a root: the high half)
const q_wm = @get_input_queue(7);    // the winner multicast
const q_wo = @get_output_queue(3);   // the chain's send (the root: the winner multicast)
const q_ww = @get_output_queue(4);   // the row word
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
param FIFOW: u16 = 32;
const NR: u16 = 12;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 15]u32);   // [RQ..RQ+4) iq2, iq3, iq4, oq2; [RQ+4] this row's first vocabulary id; [RQ+5] spare;
// [RQ+6..9) iq5..iq7, [RQ+9] oq3, [RQ+10] oq4, [RQ+11] the max-reduce role, [RQ+12] WL
var rcfg_ptr: [*]u32 = &rcfg;

fn init() void {
  fab.routes(&rcfg);
  var fq = [6]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]),
                    @as(u16, rcfg[RQ + 6]), @as(u16, rcfg[RQ + 7]), @as(u16, rcfg[RQ + 8]) };
  fab.bind_iqs(&fq, @as(u16, rcfg[RQ + 5])); fab.oqc(2, rcfg[RQ + 3]);
  fab.oqc(3, rcfg[RQ + 9]); fab.oqc(4, rcfg[RQ + 10]);
  wrole = @as(u16, rcfg[RQ + 11]);
  wl_on = rcfg[RQ + 12] != 0;
  tb_on = rcfg[RQ + 13] != 0;
  if (tb_on) { fab.oqc(5, rcfg[RQ + 14]); }
  timestamp.enable_tsc();
  sys_mod.unblock_cmd_stream();
}

// ---------------------------------------------------------------- the wafer token loop
param CAP: u16 = 256;   // the ring (steps a launch); entries 0..63 as before
param WFORCE: u32 = 0;   // (diagnostics) != 0: the root's winner is (s WFORCE + 7) % (VR WFN), not the argmax
param WFN: u32 = 1;
var ring = @zeros([CAP]u32);     // the root: the winner id of each step of the last launch
var ring_ptr: [*]u32 = &ring;
// "force" / "nforce" (host-written, the root): steps s < nforce[0] take force[s] as the next token instead of
// the argmax (the embedding return path included): a prompt and the decode loop in one launch
var force = @zeros([CAP]u32);
var force_ptr: [*]u32 = &force;
var nforce = @zeros([1]u32);
var nforce_ptr: [*]u32 = &nforce;
var wrole: u16 = 0;              // 0 chain start, 1 add-forward, 2 group end, 3 farthest end, 4 root (| 8 low half, | 16 high half)
var wl_on = false;
var tb_on = false;
const q_tb = @get_output_queue(5);
const red = @import_module("ops/red.csl", .{ .fab = fab, .IN1 = q_e, .IN2 = q_w, .OUT = q_lo, .LOOP = q_lb, .UT1 = ut_a, .UT2 = ut_b, .FIFOW = FIFOW });
var tbw = @zeros([1]f32);
var tin = @zeros([1]u32);          // (TB rows) the launch's first token id, host-written: its PLE words come from the storage
var tin_ptr: [*]u32 = &tin;
const tbw_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> tbw[i] });
var wm = @zeros([2]f32);         // (value, id) carried
var wr = @zeros([2]f32);         // a received pair
var wo = @zeros([1]f32);         // the row word
const wm_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2} -> wm[i] });
const wr_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2} -> wr[i] });
const wo_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> wo[i] });
fn wmerge() void {
  if (wr[0] > wm[0] or (wr[0] == wm[0] and wr[1] < wm[1])) { wm[0] = wr[0]; wm[1] = wr[1]; }
}
fn wloop(s: u32, best: f32, id: f32) void {
  wm[0] = best;
  wm[1] = id;
  if ((wrole & 4) != 0) {
    if ((wrole & 8) != 0) { @fmovs(wr_d, fab.fin(q_w1, 2)); wmerge(); }
    if ((wrole & 16) != 0) { @fmovs(wr_d, fab.fin(q_w2, 2)); wmerge(); }
    if (s < CAP) { ring[s] = @as(u32, wm[1]); }   // the argmax (also under a forced step: teacher-forced checks)
    if (WFORCE != 0) { wm[1] = @as(f32, (s * WFORCE + 7) % (@as(u32, VR) * @as(u32, WFN))); }   // (diagnostics) a forced winner sequence
    if (s < nforce[0] and s < CAP) { wm[1] = @as(f32, force[s]); }   // the host's forced tokens (a prompt in the same launch)
    if (s < 64) { stamp(2 + @as(u16, s)); }
    @fmovs(fab.fout(q_wo, 2), wm_d);
  } else {
    if (wrole != 0) { @fmovs(wr_d, fab.fin(q_w1, 2)); wmerge(); }
    if (wrole == 2) { @fmovs(wr_d, fab.fin(q_w2, 2)); wmerge(); }
    @fmovs(fab.fout(q_wo, 2), wm_d);
    @fmovs(wm_d, fab.fin(q_wm, 2));
  }
  stamp(68);
  const win = @as(u32, wm[1]);
  const base = rcfg[RQ + 4];
  if (s + 1 >= n_steps) { wo[0] = -1.0e9; }
  else if (win >= base and win < base + @as(u32, VR)) { wo[0] = @as(f32, win - base); }
  else { wo[0] = -(1.0 + @as(f32, win / @as(u32, VR))); }
  @fmovs(fab.fout(q_ww, 1), wo_d);
  if (tb_on) { tbw[0] = if (s + 1 >= n_steps) -1.0 else @as(f32, win); @fmovs(fab.fout(q_tb, 1), tbw_d); }
  stamp(69);
}

var n_steps: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var s: u32 = 0;
  while (s < n_steps) : (s += 1) {
    if (s == 0 and tb_on) { tbw[0] = @as(f32, tin[0]); @fmovs(fab.fout(q_tb, 1), tbw_d); }
    stamp(0);
    red.root(t_d, VR);
    stamp(66);
    am.find();
    res[0] = am.best;
    res[1] = @as(f32, rcfg[RQ + 4] + @as(u32, am.at));
    res[2] += 1.0;
    stamp(67);
    if (wl_on) { wloop(s, am.best, res[1]); }
    stamp(1);
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_w, .{ .color = @get_color(13) });
  @initialize_queue(q_e, .{ .color = @get_color(14) });
  @initialize_queue(q_lb, .{ .color = @get_color(17) });
  @initialize_queue(q_lo, .{ .color = @get_color(16) });
  @initialize_queue(q_w1, .{ .color = @get_color(18) });
  @initialize_queue(q_w2, .{ .color = @get_color(19) });
  @initialize_queue(q_wm, .{ .color = @get_color(20) });
  @initialize_queue(q_wo, .{ .color = @get_color(16) });
  @initialize_queue(q_ww, .{ .color = @get_color(16) });
  @initialize_queue(q_tb, .{ .color = @get_color(16) });
  @export_symbol(ring_ptr, "ring");
  @export_symbol(tin_ptr, "tin");
  @export_symbol(force_ptr, "force");
  @export_symbol(nforce_ptr, "nforce");
  @export_symbol(t_ptr, "lgt");
  @export_symbol(res_ptr, "res");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(init);
  @export_symbol(compute);
}
