// wafer/ctl_cy_gemma.csl: the wafer program column control PE for Gemma 4 (ctl_cy_qwen.csl's attention without GDN;
// src/spatial/README.md 7). A layer:
// - attention: the reduction [W a | W b | |r|^2, |x|^2, x.p, |p|^2] (deferred norm: s = rsqrt(mean r^2 + eps), the
//   input's rms from |x + s p|^2), t = rr (W a + s W b) = [q (Qh Dc) | k Dc | v Dc]; the raw |q_h|^2, |k|^2, |v|^2
//   partials; q / k norm weights; RoPE (sliding: theta 1e4 over the head; global: proportional, 25%); multicast
//   [q | k | v | position | |q_h|^2 | |k|^2 | |v|^2 | s]; the source unit also sends [k | v | |k|^2 | |v|^2] of its
//   last sliding and its global layer north on KVS (+ a sequence word after the global); then the softmax passes
//   (o / l, the redo flag, the log-sum-exp steps) as ctl_cy_qwen's without the output gate.
// - MLP: [W a | W b | sums] (gate | up), s1, GELU-tanh(gate) up, multicast [act | s1].
// - PLE: [G a | G b | |d|^2 ..], s2, z = GELU(G a + s2 G b) ple (this column's PLE value of the layer), multicast [z | s2].
// - the flush unit's last: [|h|^2 ..] -> multicast [s].
// PLE words: the bus (PB) carries a token's values of every unit in this unit column (5 a unit) + a sequence word;
// an async receive for step s + 1 is posted at the end of step s (not the launch's last); step 0's words come from
// the host. DIAG 1 (no layers): the PLE words and the KVS line run alone (probes; logged in "plog").
param memcpy_params;
param DIAG: u16 = 0;
param K: u16;
param KM: u16;
param SH: u16 = 0;
param Qh: u16;
param DcS: u16;
param DcG: u16;
param Ic: u16;
param HR: u16;          // hidden size
param ATTL: u16 = 2;
param TSTAMP: u16 = 0;
param FIFOW: u16 = 32;
param HDS: u16 = 256;
param HDG: u16 = 512;
param PLOG: u16 = 0;     // 1: the full model logs each step's PLE words too (plog: the hang-localizing probe with real ordering)

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const timestamp = @import_module("<time>");
const NTD: u16 = 1 + 6 * K;
var tdbg = @zeros([NTD]u32);
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { if (TSTAMP == 0) { return; } timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }
fn mx(a: u16, b: u16) u16 { return if (a > b) a else b; }

fn isg(l: u16) bool { return ((KM >> l) & 1) == 1; }
fn dcl(l: u16) u16 { return if (isg(l)) DcG else DcS; }
fn nql(l: u16) u16 { return Qh * dcl(l) + (if (SH == 1) 0 else 2 * dcl(l)); }
fn lasts() u16 { var r: u16 = 0xff; var l: u16 = 0; while (l < K) : (l += 1) { if (!isg(l)) { r = l; } } return r; }
fn lastg() u16 { var r: u16 = 0xff; var l: u16 = 0; while (l < K) : (l += 1) { if (isg(l)) { r = l; } } return r; }
const LS: u16 = lasts();
const LG: u16 = lastg();
const QOM: u16 = Qh * DcG;
const NQM: u16 = QOM + (if (SH == 1) 0 else 2 * DcG);
const ABM: u16 = QOM + 2 * DcG + Qh + 4;
const TN: u16 = mx(mx(2 * NQM + 4, 4 * Ic + 4), mx(ABM, Qh * (DcG + 1) + 1));
const EPS: f32 = 1.0e-6;
const IHID: f32 = 1.0 / @as(f32, HR);   // (a reciprocal: no runtime f32 divide)

var t: [TN]f32 align(16) = @zeros([TN]f32);
var u: [TN]f32 align(16) = @zeros([TN]f32);
const t_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> t[i] });
const u_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> u[i] });
fn tv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(t_d, @as(i16, o), f32), n); }
fn uv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(u_d, @as(i16, o), f32), n); }

// attention per layer: q / k norm weights [QOM + DcG] a layer; RoPE tables [kind][4][8][2][2] (cos | sin, NROT 2:
// a sliding column uses pair 0 only); the host's tables (identity on a global column past the rotated dims)
const QKS: u16 = QOM + DcG;
var qkw = @zeros([K * QKS]f32);
var rot = @zeros([2 * 4 * 8 * 2 * 2]f32);
var rc = @zeros([2 * 2]f32);
var rs = @zeros([2 * 2]f32);
var rope_at = [2]u32 { 0xffffffff, 0xffffffff };
var tab = @zeros([4]u32);
var qkw_ptr: [*]f32 = &qkw;
var rot_ptr: [*]f32 = &rot;
var tab_ptr: [*]u32 = &tab;
var pl = @zeros([64]f32);            // the PLE words of this unit column (5 a unit) + the sequence word
var pl_ptr: [*]f32 = &pl;
var plog = @zeros([2 * 64]f32);      // (DIAG 1) a step's PLE value (this unit's first) and the sequence word
var plog_ptr: [*]f32 = &plog;

const q_n = @get_input_queue(2);
const q_s = @get_input_queue(3);
const q_lb = @get_input_queue(4);
const q_si = @get_input_queue(5);
const q_pl = @get_input_queue(6);    // the PLE bus (async)
const q_s2 = @get_input_queue(7);
const q_lo = @get_output_queue(2);
const q_mc = @get_output_queue(3);
const q_so = @get_output_queue(4);
const q_kv = @get_output_queue(5);   // KVS (the source unit)
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
const ut_p = @get_ut_id(6);
var fifo_buf = @zeros([FIFOW]f32);
const fifo = @allocate_fifo(fifo_buf);
fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}
const NR: u16 = 12;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 16]u32);   // ctl_cy_qwen's; [RQ+11] flags (bit 0 on a PLE bus, 1 the KVS source, 2 flush unit),
var rcfg_ptr: [*]u32 = &rcfg;      // [RQ+12] PB colour, [RQ+13] this unit's place in the column, [RQ+14] bus words, [RQ+15] KVS
var cfl: u16 = 0;
var pui: u16 = 0;
var plv: u16 = 0;
fn iqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.input_queue_config.get_input_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.input_queue_config.in_queue_addr_range);
  @set_config(addr, (v & 0xffe0) | @as(u16, c), tile_config.input_queue_config.in_queue_addr_range);
}
fn oqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.output_queue_config.get_output_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.output_queue_config.out_queue_addr_range);
  @set_config(addr, (v & 0xfe0f) | (@as(u16, c) << 4), tile_config.output_queue_config.out_queue_addr_range);
}
var qcur = [6]u16 { 13, 14, 17, 18, 19, 20 };
fn iq_any(q: u16, c: u16) void {
  if (q == 0) { iqc(2, c); }
  else if (q == 1) { iqc(3, c); }
  else if (q == 2) { iqc(4, c); }
  else if (q == 3) { iqc(5, c); }
  else if (q == 4) { iqc(6, c); }
  else if (q == 5) { iqc(7, c); }
}
fn bind_iqs(fin: *[6]u16, tmp: u16) void {
  var done = @zeros([6]u16);
  var left: u16 = 6;
  var guard: u16 = 0;
  while (left > 0 and guard < 32) : (guard += 1) {
    var prog = false;
    var i: u16 = 0;
    while (i < 6) : (i += 1) {
      if (done[i] != 0) { continue; }
      var clash = false;
      var j: u16 = 0;
      while (j < 6) : (j += 1) { if (j != i and done[j] == 0 and qcur[j] == fin.*[i]) { clash = true; } }
      if (!clash) { iq_any(i, fin.*[i]); qcur[i] = fin.*[i]; done[i] = 1; left -= 1; prog = true; }
    }
    if (!prog) {
      i = 0;
      while (i < 6 and done[i] != 0) : (i += 1) {}
      iq_any(i, tmp); qcur[i] = tmp;
    }
  }
}
fn init() void {
  const cc0 = color_config.get_color_config_addr(@get_color(0));
  var k: u16 = 0;
  while (k < @as(u16, rcfg[0])) : (k += 1) {
    const addr = cc0 + @as(u16, rcfg[1 + 2 * k]);
    const r = @get_config(addr, tgt.color_addr_range) & 0xff00;
    @set_config(addr, r | @as(u16, rcfg[2 + 2 * k]), tgt.color_addr_range);
  }
  cfl = @as(u16, rcfg[RQ + 11]);
  pui = @as(u16, rcfg[RQ + 13]);
  plv = @as(u16, rcfg[RQ + 14]);
  const q6 = if ((cfl & 1) != 0) @as(u16, rcfg[RQ + 12]) else @as(u16, rcfg[RQ + 8]);
  var fq = [6]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]), @as(u16, rcfg[RQ + 3]), q6, @as(u16, rcfg[RQ + 9]) };
  bind_iqs(&fq, @as(u16, rcfg[RQ + 10]));
  oqc(2, rcfg[RQ + 4]); oqc(3, rcfg[RQ + 5]); oqc(4, rcfg[RQ + 6]);
  if ((cfl & 2) != 0) { oqc(5, rcfg[RQ + 15]); }
  timestamp.enable_tsc();
  vinit();
  vinit2();
  vinit3();
  if ((cfl & 1) != 0 and (DIAG & 32) == 0) { pl_post(); }   // step 0's words: the storage's, on the launch-start TB
  sys_mod.unblock_cmd_stream();
}

fn reduce(n: u16) void {
  @fmovs(fifo, fin(q_s, n), .{ .async = true, .ut_id = ut_a });
  @fadds(fout(q_lo, n), fin(q_n, n), fifo, .{ .async = true, .ut_id = ut_b });
  @fmovs(tv(0, n), fin(q_lb, n));
}
fn mcast(n: u16) void { @fmovs(fout(q_mc, n), uv(0, n)); }

// ---------------------------------------------------------------- scalar math (ctl_cy_qwen's)
fn rsqrt(v: f32) f32 {
  var y = @bitcast(f32, @as(u32, 0x5f3759df) - (@bitcast(u32, v) >> 1));
  y = y * (1.5 - 0.5 * v * y * y);
  y = y * (1.5 - 0.5 * v * y * y);
  y = y * (1.5 - 0.5 * v * y * y);
  return y;
}
fn exp1(x0: f32) f32 {
  var x: f32 = if (x0 < -87.0) -87.0 else if (x0 > 88.0) 88.0 else x0;
  var k: f32 = x * 1.4426950408889634 + 12582912.0;
  k = k - 12582912.0;
  const r = x - k * 0.6931471805599453;
  var p: f32 = 0.0013888889;
  p = p * r + 0.008333334;
  p = p * r + 0.041666668;
  p = p * r + 0.16666667;
  p = p * r + 0.5;
  p = p * r + 1.0;
  p = p * r + 1.0;
  const ki = @as(i16, k) + 127;
  const s = @bitcast(f32, @as(u32, @as(u16, ki)) << 23);
  return p * s;
}
fn recip(v: f32) f32 { const a = if (v < 0.0) -v else v; const r = rsqrt(a); return if (v < 0.0) -(r * r) else r * r; }
fn ln1(x: f32) f32 {
  const b = @bitcast(u32, x);
  const e = @as(f32, @as(i16, @as(u16, (b >> 23) & 0xff)) - 127);
  const m = @bitcast(f32, (b & 0x007fffff) | 0x3f800000);
  const z = (m - 1.0) * recip(m + 1.0);
  const z2 = z * z;
  const p = z * (2.0 + z2 * (0.6666667 + z2 * (0.4 + z2 * 0.2857143)));
  return e * 0.6931471805599453 + p;
}
fn gelu1(x: f32) f32 {
  const y = 1.5957691216057308 * x * (1.0 + 0.044715 * x * x);
  return x * recip(1.0 + exp1(-y));
}
// the deferred combine: s, the true rms; t[0..n) = rr (t[0..n) + s t[n..2n)); returns s
fn combine(n: u16) f32 {
  const s = rsqrt(t[2 * n] * IHID + EPS);
  const ss = t[2 * n + 1] + 2.0 * s * t[2 * n + 2] + s * s * t[2 * n + 3];
  const rr = rsqrt(ss * IHID + EPS);
  @fmacs(tv(0, n), tv(0, n), tv(n, n), s);
  @fmuls(tv(0, n), tv(0, n), rr);
  return s;
}

// ---------------------------------------------------------------- vector GELU (f32 DSD ops; vsilu's form on y)
var va: [TN]f32 align(16) = @zeros([TN]f32);
var vb: [TN]f32 align(16) = @zeros([TN]f32);
var vcr: [TN]f32 align(16) = @zeros([TN]f32);
var vk = @zeros([TN]u16);
const va_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> va[i] });
const vb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> vb[i] });
const vc_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> vcr[i] });
const vk_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> vk[i] });
var vpl = vk_d;
fn vinit() void { vpl = @set_dsd_stride(@set_dsd_base_addr(vk_d, @ptrcast([*]u16, &vb)), 2); }
const ex_a = [3]f32 { 12582912.0, -12582912.0, 12582912.0 };
const ex_c = [4]f32 { 0.16790908575057983, 0.5000435709953308, 0.9999634027481079, 0.9999992847442627 };
fn vexp(buf: mem1d_dsd, n: u16) void {
  const p = @set_dsd_length(vb_d, n);
  const kk = @set_dsd_length(vk_d, n);
  const pl_ = @set_dsd_length(vpl, n);
  const ph = @increment_dsd_offset(pl_, 1, u16);
  @fmaxs(buf, buf, -87.0);
  @fnegs(buf, buf);
  @fmaxs(buf, buf, -88.0);
  @fnegs(buf, buf);
  @fmuls(p, buf, 1.4426950408889634);
  var c: u16 = 0;
  while (c < 3) : (c += 1) {
    @fadds(p, p, ex_a[c]);
    if (c == 1) { @fmacs(buf, buf, p, -0.6931471805599453); }
  }
  @sll16(kk, pl_, 7);
  @fmuls(p, buf, 0.041458580642938614);
  c = 0;
  while (c < 4) : (c += 1) {
    if (c > 0) { @fmuls(p, p, buf); }
    @fadds(p, p, ex_c[c]);
  }
  @add16(ph, ph, kk);
  @fmovs(buf, p);
}
// dst = gelu_tanh(src) = max(x, x e) / (1 + e), e = exp(-|y|), y = 1.5958 x (1 + 0.044715 x^2) (dst != src)
fn vgelu0(dst: mem1d_dsd, src: mem1d_dsd, n: u16) void {
  const e = @set_dsd_length(va_d, n);
  const d = @set_dsd_length(vb_d, n);
  const r = @set_dsd_length(vc_d, n);
  @fmuls(e, src, src);
  @fmuls(e, e, 0.044715);
  @fadds(e, e, 1.0);
  @fmuls(e, e, src);
  @fmuls(e, e, 1.5957691216057308);   // y
  @fnegs(dst, e);
  @fmaxs(e, e, dst);                  // |y|
  @fnegs(e, e);
  vexp(e, n);
  @fadds(d, e, 1.0);
  @fmuls(r, d, 0.323112507040746);
  @fadds(r, r, -1.4540415401729079);
  @fmuls(r, r, d);
  @fadds(r, r, 2.1207294161729284);
  var k: u16 = 0;
  while (k < 2) : (k += 1) {
    @fmuls(dst, d, r);
    @fsubs(dst, 2.0, dst);
    @fmuls(r, r, dst);
  }
  @fmuls(dst, src, e);
  @fmaxs(dst, dst, src);
  @fmuls(dst, dst, r);
}

// dst = gelu_tanh(src) = max(x, x e) / (1 + e), e = exp(-|y|), y = 1.5958 x (1 + 0.044715 x^2) (dst != src).
// The trimmed form (GELUT 1, bit-identical to vexp-based GELUT 0: -|y| by setting the sign bit, one clamp for a
// value <= 0, exp's result used in place of a copy)
param GELUT: u16 = 2;   // 2: vgeluc's cheaper form (below)
var vd: [TN]f32 align(16) = @zeros([TN]f32);
const vd_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> vd[i] });
var vah = vk_d;
fn vinit2() void { vah = @increment_dsd_offset(@set_dsd_stride(@set_dsd_base_addr(vk_d, @ptrcast([*]u16, &va)), 2), 1, u16); }
// vgelu on the MLP's Ic (dst u, src t): the same ops, comptime f32 views, the u16 views built once (vinit3), the
// constant loops unrolled
const gE = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> va[i] });
const gP = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> vb[i] });
const gR = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> vcr[i] });
const gD = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> vd[i] });
const gK = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> vk[i] });
const gS = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> t[i] });
const gO = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> u[i] });
var gPL = vk_d;
var gPH = vk_d;
var gAH = vk_d;
var gH = vk_d;
var gA = vk_d;
fn vinit3() void {
  gPL = @set_dsd_length(vpl, Ic);
  gPH = @increment_dsd_offset(gPL, 1, u16);
  gAH = @set_dsd_length(vah, Ic);
  gH = @set_dsd_length(@set_dsd_base_addr(vk_d, @ptrcast([*]@fp16(), &vk)), Ic);   // (GELUT 2: f16, after the exp)
  gA = @set_dsd_length(@set_dsd_base_addr(vk_d, @ptrcast([*]@fp16(), &va)), Ic);
}
// GELUT 2: the same function with fewer f32 multiplies (an f32 multiply costs a cycle a word an operand; f16 and
// adds are cheap): y = x (c + c a x^2); t = -|y| log2 e, k = round(t), f = t - k (exact), 2^f a degree-4 minimax
// (relative error 2.6e-6, as the exp's above); d = 1 + e; 1 / d from an f16 quartic in d - 1.5 (relative error
// 3e-4 with the f16 rounding) and one f32 Newton step; out = max(x e, x) / d. Relative error against the exact
// gelu_tanh 4.5e-6 (GELUT 1: 5.0e-6); 18-20% fewer cycles at Ic 24-48.
const e2c = [5]f32 { 0.9999992847442627, 0.6931217908859253, 0.240247443318367, 0.05591786280274391, 0.009570096619427204 };
const rqc = [5]f16 { 0.66650390625, -0.4423828125, 0.294921875, -0.2283935546875, 0.1522216796875 };
fn vgeluc2() void {
  @fmuls(gE, gS, gS);
  @fmuls(gE, gE, 0.07135481627159043);
  @fadds(gE, gE, 1.5957691216057308);
  @fmuls(gE, gE, gS);                   // y
  @or16(gAH, gAH, 0x8000);              // -|y|
  @fmuls(gR, gE, 1.4426950408889634);   // t
  @fmaxs(gR, gR, -126.0);
  @fadds(gP, gR, ex_a[0]);              // k in the low mantissa bits
  @sll16(gK, gPL, 7);
  @fadds(gP, gP, ex_a[1]);              // k
  @fsubs(gR, gR, gP);                   // f
  @fmuls(gP, gR, e2c[4]);
  @fadds(gP, gP, e2c[3]);
  @fmuls(gP, gP, gR);
  @fadds(gP, gP, e2c[2]);
  @fmuls(gP, gP, gR);
  @fadds(gP, gP, e2c[1]);
  @fmuls(gP, gP, gR);
  @fadds(gP, gP, e2c[0]);
  @add16(gPH, gPH, gK);                 // p = e = exp(-|y|)
  @fadds(gD, gP, 1.0);                  // d
  @fadds(gR, gP, -0.5);                 // d - 1.5
  @fs2h(gH, gR);
  @fmulh(gA, gH, rqc[4]);
  @faddh(gA, gA, rqc[3]);
  @fmulh(gA, gA, gH);
  @faddh(gA, gA, rqc[2]);
  @fmulh(gA, gA, gH);
  @faddh(gA, gA, rqc[1]);
  @fmulh(gA, gA, gH);
  @faddh(gA, gA, rqc[0]);
  @fh2s(gR, gA);
  @fmuls(gO, gD, gR);
  @fsubs(gO, 2.0, gO);
  @fmuls(gR, gR, gO);                   // 1 / d
  @fmuls(gO, gS, gP);
  @fmaxs(gO, gO, gS);
  @fmuls(gO, gO, gR);
}
fn vgeluc() void {
  @fmuls(gE, gS, gS);
  @fmuls(gE, gE, 0.044715);
  @fadds(gE, gE, 1.0);
  @fmuls(gE, gE, gS);
  @fmuls(gE, gE, 1.5957691216057308);   // y
  @or16(gAH, gAH, 0x8000);              // -|y|
  @fmaxs(gE, gE, -87.0);
  @fmuls(gP, gE, 1.4426950408889634);
  @fadds(gP, gP, ex_a[0]);
  @fadds(gP, gP, ex_a[1]);
  @fmacs(gE, gE, gP, -0.6931471805599453);
  @fadds(gP, gP, ex_a[2]);
  @sll16(gK, gPL, 7);
  @fmuls(gP, gE, 0.041458580642938614);
  @fadds(gP, gP, ex_c[0]);
  @fmuls(gP, gP, gE);
  @fadds(gP, gP, ex_c[1]);
  @fmuls(gP, gP, gE);
  @fadds(gP, gP, ex_c[2]);
  @fmuls(gP, gP, gE);
  @fadds(gP, gP, ex_c[3]);
  @add16(gPH, gPH, gK);                 // p = exp(-|y|)
  @fadds(gD, gP, 1.0);
  @fmuls(gR, gD, 0.323112507040746);
  @fadds(gR, gR, -1.4540415401729079);
  @fmuls(gR, gR, gD);
  @fadds(gR, gR, 2.1207294161729284);
  @fmuls(gO, gD, gR);
  @fsubs(gO, 2.0, gO);
  @fmuls(gR, gR, gO);
  @fmuls(gO, gD, gR);
  @fsubs(gO, 2.0, gO);
  @fmuls(gR, gR, gO);
  @fmuls(gO, gS, gP);
  @fmaxs(gO, gO, gS);
  @fmuls(gO, gO, gR);
}
fn vgelu(dst: mem1d_dsd, src: mem1d_dsd, n: u16) void {
  if (GELUT == 0) { vgelu0(dst, src, n); return; }
  const e = @set_dsd_length(va_d, n);       // y, then -|y| (exp's argument)
  const p = @set_dsd_length(vb_d, n);       // exp's p, then exp(-|y|)
  const r = @set_dsd_length(vc_d, n);
  const d = @set_dsd_length(vd_d, n);
  const kk = @set_dsd_length(vk_d, n);
  const pl_ = @set_dsd_length(vpl, n);
  const ph = @increment_dsd_offset(pl_, 1, u16);
  @fmuls(e, src, src);
  @fmuls(e, e, 0.044715);
  @fadds(e, e, 1.0);
  @fmuls(e, e, src);
  @fmuls(e, e, 1.5957691216057308);   // y
  @or16(@set_dsd_length(vah, n), @set_dsd_length(vah, n), 0x8000);   // -|y|
  @fmaxs(e, e, -87.0);
  @fmuls(p, e, 1.4426950408889634);
  var c: u16 = 0;
  while (c < 3) : (c += 1) {
    @fadds(p, p, ex_a[c]);
    if (c == 1) { @fmacs(e, e, p, -0.6931471805599453); }
  }
  @sll16(kk, pl_, 7);
  @fmuls(p, e, 0.041458580642938614);
  c = 0;
  while (c < 4) : (c += 1) {
    if (c > 0) { @fmuls(p, p, e); }
    @fadds(p, p, ex_c[c]);
  }
  @add16(ph, ph, kk);                       // p = exp(-|y|)
  @fadds(d, p, 1.0);
  @fmuls(r, d, 0.323112507040746);
  @fadds(r, r, -1.4540415401729079);
  @fmuls(r, r, d);
  @fadds(r, r, 2.1207294161729284);
  var k: u16 = 0;
  while (k < 2) : (k += 1) {
    @fmuls(dst, d, r);
    @fsubs(dst, 2.0, dst);
    @fmuls(r, r, dst);
  }
  @fmuls(dst, src, p);
  @fmaxs(dst, dst, src);
  @fmuls(dst, dst, r);
}
// ---------------------------------------------------------------- RoPE
fn rope_tables(kd: u16, p: u32) void {
  if (rope_at[kd] == p) { return; }
  rope_at[kd] = p;
  var j: u16 = 0;
  while (j < 2) : (j += 1) {
    var c: f32 = 1.0;
    var s: f32 = 0.0;
    var lv: u16 = 0;
    while (lv < 4) : (lv += 1) {
      const d = @as(u16, (p >> @as(u16, 3 * (3 - lv))) & 7);
      const o = kd * 128 + ((lv * 8 + d) * 2) * 2 + j;
      const c2 = rot[o];
      const s2 = rot[o + 2];
      const cn = c * c2 - s * s2;
      s = s * c2 + c * s2;
      c = cn;
    }
    rc[kd * 2 + j] = c;
    rs[kd * 2 + j] = s;
  }
}
fn rope(kd: u16, o: u16, np: u16) void {
  var j: u16 = 0;
  while (j < np) : (j += 1) {
    const a = t[o + 2 * j];
    const b = t[o + 2 * j + 1];
    t[o + 2 * j] = a * rc[kd * 2 + j] - b * rs[kd * 2 + j];
    t[o + 2 * j + 1] = b * rc[kd * 2 + j] + a * rs[kd * 2 + j];
  }
}

// ---------------------------------------------------------------- layers
var ilh = @zeros([Qh]f32);
// (comptime per layer kind: the vector views are comptime DSDs, the loops' bounds constants; the same arithmetic in
// the same order as the runtime form)
fn tc(comptime o: u16, comptime n: u16) mem1d_dsd { return @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{n} -> t[@as(i16, o) + i] }); }
fn uc(comptime o: u16, comptime n: u16) mem1d_dsd { return @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{n} -> u[@as(i16, o) + i] }); }
fn combinec(comptime n: u16) f32 {
  const s = rsqrt(t[2 * n] * IHID + EPS);
  const ss = t[2 * n + 1] + 2.0 * s * t[2 * n + 2] + s * s * t[2 * n + 3];
  const rr = rsqrt(ss * IHID + EPS);
  @fmacs(tc(0, n), tc(0, n), tc(n, n), s);
  @fmuls(tc(0, n), tc(0, n), rr);
  return s;
}
fn ropec(comptime kd: u16, o: u16, comptime np: u16) void {
  var j: u16 = 0;
  while (j < np) : (j += 1) {
    const a = t[o + 2 * j];
    const b = t[o + 2 * j + 1];
    t[o + 2 * j] = a * rc[kd * 2 + j] - b * rs[kd * 2 + j];
    t[o + 2 * j + 1] = b * rc[kd * 2 + j] + a * rs[kd * 2 + j];
  }
}
var posf: f32 = 0.0;    // the step's position as f32 (and + 1), converted once a step
var posf1: f32 = 0.0;
fn att(l: u16) void { if (isg(l)) { attk(l, true); } else { attk(l, false); } }
fn attk(l: u16, comptime g: bool) void {
  const dc: u16 = if (g) DcG else DcS;
  const QD: u16 = Qh * dc;
  const NQ: u16 = QD + (if (SH == 1) 0 else 2 * dc);
  const kd: u16 = if (g) 1 else 0;
  const np: u16 = dc / 2;
  const AB: u16 = QD + 2 * dc + Qh + 4;
  reduce(2 * NQ + 4);
  stamp(1 + 6 * cl + 0);
  const s = combinec(NQ);
  const qkb = l * QKS;
  var h: u16 = 0;
  while (h < Qh) : (h += 1) {
    var ss: f32 = 0.0;
    var d: u16 = 0;
    while (d < dc) : (d += 1) { const v = t[h * dc + d]; ss += v * v; }
    u[QD + 2 * dc + 1 + h] = ss;
  }
  const qw = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QKS} -> qkw[i] });
  @fmuls(tc(0, QD), tc(0, QD), @set_dsd_length(@increment_dsd_offset(qw, @as(i16, qkb), f32), QD));
  rope_tables(kd, tab[0]);
  h = 0;
  while (h < Qh) : (h += 1) { ropec(kd, h * dc, np); }
  @fmovs(uc(0, QD), tc(0, QD));
  if (SH == 0) {
    var ks: f32 = 0.0;
    var vs: f32 = 0.0;
    var d: u16 = 0;
    while (d < dc) : (d += 1) { const a = t[QD + d]; const b = t[QD + dc + d]; ks += a * a; vs += b * b; }
    u[QD + 2 * dc + 1 + Qh] = ks;
    u[QD + 2 * dc + 2 + Qh] = vs;
    @fmuls(tc(QD, dc), tc(QD, dc), @set_dsd_length(@increment_dsd_offset(qw, @as(i16, qkb + QD), f32), dc));
    ropec(kd, QD, np);
    @fmovs(uc(QD, 2 * dc), tc(QD, 2 * dc));
  } else {
    @fmovs(uc(QD, 2 * dc), 0.0);
    u[QD + 2 * dc + 1 + Qh] = 0.0;
    u[QD + 2 * dc + 2 + Qh] = 0.0;
  }
  u[QD + 2 * dc] = posf;
  u[QD + 2 * dc + 3 + Qh] = s;
  @fmovs(fout(q_mc, AB), uc(0, AB));
  stamp(1 + 6 * cl + 1);
  if ((cfl & 2) != 0 and (l == LS or l == LG)) {
    // KVS: [k | v | |k|^2 | |v|^2] (sliding first, then global + the sequence word)
    // (the multicast has read u: a send returns once its words are in the output queue)
    const ksv = u[QD + 2 * dc + 1 + Qh];
    const vsv = u[QD + 2 * dc + 2 + Qh];
    u[QD + 2 * dc] = ksv;
    u[QD + 2 * dc + 1] = vsv;
    u[QD + 2 * dc + 2] = posf1;
    @fmovs(fout(q_kv, 2 * dc + 2 + (if (l == LG) @as(u16, 1) else 0)), uv(QD, 2 * dc + 2 + (if (l == LG) @as(u16, 1) else 0)));
  }
  var pass: u16 = 0;
  while (pass < 8) : (pass += 1) {
    reduce(Qh * (dc + 1));
    var bad: f32 = 0.0;
    h = 0;
    while (h < Qh) : (h += 1) {
      const lsum = t[h * (dc + 1) + dc];
      if (lsum < 0.00390625 or lsum >= 32768.0) { bad = 1.0; }
      ilh[h] = recip(lsum);
      @fmuls(uv(h * dc, dc), tv(h * (dc + 1), dc), ilh[h]);
    }
    h = 0;
    while (h < Qh) : (h += 1) {
      const lh = t[h * (dc + 1) + dc];
      u[QD + 1 + h] = if (bad == 0.0) 0.0 else ln1(lh);
    }
    u[QD] = bad;
    @fmovs(fout(q_mc, QD + 1 + Qh), uc(0, QD + 1 + Qh));
    stamp(1 + 6 * cl + 3);
    if (bad == 0.0) {   // (ATTL 2) the logs off the path
      h = 0;
      while (h < Qh) : (h += 1) { u[h] = ln1(t[h * (dc + 1) + dc]); }
      @fmovs(fout(q_mc, Qh), uc(0, Qh));
      pass = 8;
    }
  }
}
fn mlp() void {
  reduce(4 * Ic + 4);
  stamp(1 + 6 * cl + 4);
  const s1 = combinec(2 * Ic);
  if (GELUT == 0) { vgelu0(uv(0, Ic), tv(0, Ic), Ic); } else if (GELUT == 2) { vgeluc2(); } else { vgeluc(); }
  @fmuls(uc(0, Ic), uc(0, Ic), tc(Ic, Ic));
  u[Ic] = s1;
  @fmovs(fout(q_mc, Ic + 1), uc(0, Ic + 1));
}
var chk = @zeros([1]f32);
fn pl_wait(pos: u32) void {
  const want = @as(f32, pos + 1);
  const cd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> chk[i] });
  const sd = @increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> pl[i] }), @as(i16, plv), f32);
  @fmovs(cd, sd);
  while (chk[0] != want) { @fmovs(cd, sd); }
}
fn pl_post() void {
  pl[plv] = -1.0;
  @fmovs(@set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{64} -> pl[i] }), plv + 1), fin(q_pl, plv + 1), .{ .async = true, .ut_id = ut_p });
}
fn ple(l: u16) void {
  reduce(6);
  const s2 = rsqrt(t[2] * IHID + EPS);
  const g = t[0] + s2 * t[1];
  u[0] = gelu1(g) * pl[K * pui + l];
  u[1] = s2;
  mcast(2);
}

var n_steps: u32 = 0;
var pos0: u32 = 0;
var cl: u16 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var s: u32 = 0;
  while (s < n_steps) : (s += 1) {
    tab[0] = pos0 + s;
    stamp(0);
    posf = @as(f32, tab[0]);
    posf1 = @as(f32, tab[0] + 1);
    if (LS != 0xff) { rope_tables(0, tab[0]); }   // (off the path: the first reduction is thousands of cycles out)
    if (LG != 0xff) { rope_tables(1, tab[0]); }
    if ((cfl & 1) != 0 and (DIAG & 32) == 0) { pl_wait(tab[0]); }   // (DIAG 32: no PLE words; DIAG 64: no KVS)
    if (PLOG == 1 and (cfl & 1) != 0 and s < 64) { plog[2 * @as(u16, s)] = pl[K * pui]; plog[2 * @as(u16, s) + 1] = pl[plv]; }
    if ((DIAG & 1) != 0) {
      if ((cfl & 1) != 0 and s < 64) { plog[2 * @as(u16, s)] = pl[K * pui]; plog[2 * @as(u16, s) + 1] = pl[plv]; }
      if ((cfl & 2) != 0 and (DIAG & 64) == 0) {
        var i: u16 = 0;
        while (i < 16) : (i += 1) { u[i] = @as(f32, tab[0]) * 0.5 + @as(f32, i); }
        u[16] = @as(f32, tab[0] + 1);
        @fmovs(fout(q_kv, 6), uv(0, 6));
        @fmovs(fout(q_kv, 11), uv(6, 11));
      }
    } else {
      var l: u16 = 0;
      while (l < (if ((DIAG & 2) != 0) 1 else K)) : (l += 1) {
        cl = l;
        att(l);
        mlp();
        ple(l);
        stamp(1 + 6 * l + 5);
      }
      if ((cfl & 4) != 0) {
        reduce(4);
        u[0] = rsqrt(t[0] * IHID + EPS);
        mcast(1);
      }
    }
    if ((cfl & 1) != 0 and (DIAG & 32) == 0) { pl_post(); }   // (the next pass's, this launch's or the next one's)
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  pos0 = start_pos;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_n, .{ .color = @get_color(13) });
  @initialize_queue(q_s, .{ .color = @get_color(14) });
  @initialize_queue(q_lb, .{ .color = @get_color(17) });
  @initialize_queue(q_si, .{ .color = @get_color(18) });
  @initialize_queue(q_pl, .{ .color = @get_color(19) });
  @initialize_queue(q_s2, .{ .color = @get_color(20) });
  @initialize_queue(q_lo, .{ .color = C_PARK });
  @initialize_queue(q_mc, .{ .color = C_PARK });
  @initialize_queue(q_so, .{ .color = C_PARK });
  @initialize_queue(q_kv, .{ .color = C_PARK });
  @export_symbol(qkw_ptr, "qkw");
  @export_symbol(rot_ptr, "rot");
  @export_symbol(tab_ptr, "tab");
  @export_symbol(pl_ptr, "pl");
  @export_symbol(plog_ptr, "plog");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(init);
  @export_symbol(compute);
}
//@@ dummies
