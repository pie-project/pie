// wafer/ctl_cy_qwen.csl: the wafer program column control PE for Qwen3.5 (CY_c). Design and build:
// src/spatial/README.md.
//
// Role. One a unit column, on the unit's middle row: the root of the column reductions of the
// column's weight PEs (weight_qwen.csl) and all of the layer's column-local element-wise work:
// - GDN: rms scale; conv1d (CONV taps, the window a ring) and SiLU on the column's q / k channels,
//   multicast [k | q | reset]; then (off the path) v / z / beta and the decay
//   -exp(A) softplus(a + dt); from the state reduction delta = (v - S^T k / |k|) beta and
//   o = (S^T q + delta (k.q) / |k|) / |q| (q pre-scaled by 1/sqrt(HK)); the gated RMSNorm (sums
//   over the v head's columns by a segment all-reduce on the control row) times silu(z);
//   multicast [o | delta / |k| | decay].
// - attention: rms scale; the q/k norms' weights (their rms rides in the weight PEs' score
//   segment all-reduce); partial RoPE from 4-level tables; multicast [q | k | v | position | the
//   raw sums of squares]; from the values reduction o / l, the redo flag (a sum outside the f16
//   probabilities' window) and the log-sum-exp steps; o times sigmoid(gate); multicast [o | redo |
//   steps] (ATTL 2: the steps follow in a second multicast, off the path).
// - MLP: rms scale, SiLU(g) u (SILU16 1: in f16, streamed into the multicast), multicast act.
//
// Interface. Exports cw (conv weights [layer][CONV][channel]), gpar ([A, dt] a GDN layer), gnw
// (the gated norm's weights), qkw (q / k norm weights), rot (RoPE tables [RLV levels][2^RBITS][cos | sin]
// [NROT]: positions < 2^(RBITS RLV)), tab (host: [position, ...]), rcfg, tdbg, init, compute(steps, start_pos).
// rcfg: [0] routes n, [1..1+2n) (colour, low route byte); from RQ: [0..4) iq2..iq5,
// [4..7) oq2..oq4, [7] the segment role, [8] iq6, [9] iq7, [10] the spare colour.
// Queues: iq2 / iq3 the column reduction's two halves, oq2 their merge on the loop-back colour,
// iq4 its return; oq3 the column multicast; iq5 / oq4 the control row's segment all-reduce (the
// o-norm sums), iq6 its multicast (non-roots), iq7 a two-half root's second half.
// Hardware rules: as weight_qwen.csl (own queue a flow, no transient duplicate colours, >= 768 B
// stack room).
//
// Params. Shape: K, KM, NQA, NQG, Qh, Dc, DK, DV, Ic, HR (hidden), CONV, NROT, HK, HV. Levers
// (default = the shipped 9B build): CONVQK 1, ATTV 1, GDEC 1, ROPEP 1, SILU16 1, SILUQ 1, ATTL 2
// (0: the steps ride with o), SLW 0. Model: GATE (1 Qwen3.5's gated attention; 0 Qwen3). Diagnostics (default off): TSTAMP, DIAG (as weight_qwen.csl).
param memcpy_params;
param DIAG: u16 = 0;   // 1 (diagnostics): no layers (handoffs, head and I/O only)
param K: u16;
param KM: u16;
param NQA: u16;        // attention reduction words before ssq: Qh Dc q | Qh Dc gate | Dc k | Dc v
param NQG: u16;        // GDN: DK q | DK k | DV v | DV z | b | a
param Qh: u16;
param Dc: u16;
param DK: u16;         // GDN q / k dims a column
param DV: u16;         // GDN v dims a column
param Ic: u16;
param HR: u16;         // hidden size (RMSNorm)
param CONV: u16;       // conv kernel (4)
param NROT: u16;       // rotated pairs a column (partial RoPE)
param HK: u16 = 128;   // GDN head k dim (q scale 1/sqrt(HK))
param HV: u16 = 128;   // GDN head v dim (the gated norm's mean)
param CONVQK: u16 = 1; // 1: q / k's conv and SiLU before the multicast, v / z / beta after it, the window a ring
param ATTV: u16 = 1;   // 1: attention's o / l times the gate as vector ops
param GDEC: u16 = 1;   // 1: the decay scales the state reduction's sums here (see gdn_post)
param ROPEP: u16 = 1;  // 1: the next position's RoPE tables after the multicast (one attention layer a unit)
param SILU16: u16 = 1; // 1: the MLP's SiLU in f16 (silu16)
param SILUQ: u16 = 1;  // 1: the lean f32 SiLU for GDN's q / k and v | z (same results as vsilu)
param ATTL: u16 = 2;   // 2: the log-sum-exp steps in a second multicast after o (off the path); 0: with o
param TSTAMP: u16 = 0; // 1 (diagnostics): phase stamps into tdbg (on the critical path)
param FIFOW: u16 = 32; // the reduction's FIFO depth (words)
param GATE: u16 = 1;   // 1: attention's q_proj carries the output gate (Qwen3.5); 0: none (Qwen3: NQA = Qh Dc q | Dc k | Dc v)
param RLV: u16 = 4;    // RoPE table levels: a position is RLV digits of RBITS bits (4 x 3: 4,096 positions; 5: 32,768)
param RBITS: u16 = 3;
param SLW: u16 = 0;    // 1: silu16 without the f16 subnormal flush (the tail to 2^-24; serve8b_region's SLW)

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const NTD: u16 = 1 + 6 * K;
const timestamp = @import_module("<time>");
var tdbg = @zeros([NTD]u32);   // TSC stamps of the last pass, by phase (host-read, diagnostics)
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { if (TSTAMP == 0) { return; } timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }

fn mx(a: u16, b: u16) u16 { return if (a > b) a else b; }
fn nla() u16 { var n: u16 = 0; var l: u16 = 0; while (l < K) : (l += 1) { if (((KM >> l) & 1) == 1) { n += 1; } } return n; }
const NLA: u16 = nla();
const NLG: u16 = K - NLA;
const NCH: u16 = 2 * DK + DV;              // conv channels a column
const TN: u16 = mx(mx(mx(NQA + 1, NQG + 1), mx(2 * Ic + 1, 2 * DV + 3)), Qh * Dc + 2 * Dc + 2 + Qh);
const KO: u16 = (1 + GATE) * Qh * Dc;      // attention: k's offset in the reduction (after q and the gate)
const EPS: f32 = 1.0e-6;
const HID: f32 = @as(f32, HR);

var t = @zeros([TN]f32);                   // a reduction's sum
var u = @zeros([TN]f32);                   // the multicast's words
const t_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> t[i] });
const u_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> u[i] });
fn tv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(t_d, @as(i16, o), f32), n); }
fn uv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(u_d, @as(i16, o), f32), n); }

// GDN per layer: conv window [CONV - 1][NCH], conv weights [CONV][NCH], [A, dt] for b/a,
// the gated norm's weights (DV), z kept between the two reductions.
var cwin = @zeros([if (NLG > 0) NLG * (CONV - 1) * NCH else 1]f32);
var cw = @zeros([if (NLG > 0) NLG * CONV * NCH else 1]f32);
var gpar = @zeros([if (NLG > 0) NLG * 2 else 1]f32);
var gnw = @zeros([if (NLG > 0) NLG * DV else 1]f32);
var vz = @zeros([2 * mx(DV, 1)]f32);     // v | z (one SiLU pass over both)
const vz_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * mx(DV, 1)} -> vz[i] });
var gsc = @zeros([4]f32);                  // beta, decay, then the norms' scalars
// attention per layer: q / k norm weights (Qh Dc, Dc), RoPE tables [RLV][RB][NROT] cos | sin,
// the gate kept between the reductions, the LSE reference a head.
var qkw = @zeros([if (NLA > 0) NLA * (Qh * Dc + Dc) else 1]f32);
const RB: u16 = 1 << RBITS;
var rot = @zeros([if (NLA > 0) RLV * RB * 2 * NROT else 1]f32);
var gate = @zeros([if (NLA > 0 and GATE == 1) Qh * Dc else 1]f32);
var rc = @zeros([mx(NROT, 1)]f32);
var rs = @zeros([mx(NROT, 1)]f32);
var tab = @zeros([4]u32);                  // the host: [position, slot word, 0, 0] a pass
var cw_ptr: [*]f32 = &cw;
var gpar_ptr: [*]f32 = &gpar;
var gnw_ptr: [*]f32 = &gnw;
var qkw_ptr: [*]f32 = &qkw;
var rot_ptr: [*]f32 = &rot;
var tab_ptr: [*]u32 = &tab;

// ---------------------------------------------------------------- fabric
// (queues: see the header)
const q_n = @get_input_queue(2);
const q_s = @get_input_queue(3);
const q_lb = @get_input_queue(4);
const q_si = @get_input_queue(5);
const q_sm = @get_input_queue(6);    // the segment's multicast (non-roots)
const q_s2 = @get_input_queue(7);    // a two-half segment root's second half
const q_lo = @get_output_queue(2);
const q_mc = @get_output_queue(3);
const q_so = @get_output_queue(4);
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
var fifo_buf = @zeros([FIFOW]f32);
const fifo = @allocate_fifo(fifo_buf);
fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}
const NR: u16 = 12;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 11]u32);
var rcfg_ptr: [*]u32 = &rcfg;
var role_s: u16 = 0;     // the segment all-reduce: 0 start, 1 add-forward, 4 root (others multicast)
fn iqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.input_queue_config.get_input_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.input_queue_config.in_queue_addr_range);
  @set_config(addr, (v & 0xffe0) | @as(u16, c), tile_config.input_queue_config.in_queue_addr_range);
}
fn oqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.output_queue_config.get_output_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.output_queue_config.out_queue_addr_range);
  @set_config(addr, (v & 0xfe0f) | (@as(u16, c) << 4), tile_config.output_queue_config.out_queue_addr_range);
}
// Input-queue colours from the host without a transient duplicate (the fabric refuses two input
// queues on one colour, even for a moment): a queue takes its colour only when no other queue still
// holds it; a cycle goes through the host's spare colour (rcfg's tmp word).
var qcur = [6]u16 { 13, 14, 17, 18, 19, 20 };
fn iq_any(q: u16, c: u16) void {
  if (q == 0) { iqc(2, c); }
  else if (q == 1) { iqc(3, c); }
  else if (q == 2) { iqc(4, c); }
  else if (q == 3) { iqc(5, c); }
  else if (q == 4) { iqc(6, c); }
  else if (q == 5) { iqc(7, c); }
}
fn bind_iqs(fin: *[6]u16, tmp: u16) void {
  var done = @zeros([6]u16);
  var left: u16 = 6;
  var guard: u16 = 0;
  while (left > 0 and guard < 32) : (guard += 1) {
    var prog = false;
    var i: u16 = 0;
    while (i < 6) : (i += 1) {
      if (done[i] != 0) { continue; }
      var clash = false;
      var j: u16 = 0;
      while (j < 6) : (j += 1) { if (j != i and done[j] == 0 and qcur[j] == fin.*[i]) { clash = true; } }
      if (!clash) { iq_any(i, fin.*[i]); qcur[i] = fin.*[i]; done[i] = 1; left -= 1; prog = true; }
    }
    if (!prog) {
      i = 0;
      while (i < 6 and done[i] != 0) : (i += 1) {}
      iq_any(i, tmp); qcur[i] = tmp;
    }
  }
}

fn init() void {
  const cc0 = color_config.get_color_config_addr(@get_color(0));
  var k: u16 = 0;
  while (k < @as(u16, rcfg[0])) : (k += 1) {
    const addr = cc0 + @as(u16, rcfg[1 + 2 * k]);
    const r = @get_config(addr, tgt.color_addr_range) & 0xff00;
    @set_config(addr, r | @as(u16, rcfg[2 + 2 * k]), tgt.color_addr_range);
  }
  var fq = [6]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]), @as(u16, rcfg[RQ + 3]), @as(u16, rcfg[RQ + 8]), @as(u16, rcfg[RQ + 9]) };
  bind_iqs(&fq, @as(u16, rcfg[RQ + 10]));
  oqc(2, rcfg[RQ + 4]); oqc(3, rcfg[RQ + 5]); oqc(4, rcfg[RQ + 6]);
  role_s = @as(u16, rcfg[RQ + 7]);
  timestamp.enable_tsc();
  vinit();
  vinit2();
  var g: u16 = 0;
  while (CONVQK == 1 and g < NLG) : (g += 1) { gpar[2 * g] = -exp1(gpar[2 * g]); }
  sys_mod.unblock_cmd_stream();
}

// The column reduction's n words into t (both halves at once, back over the loop-back).
fn reduce(n: u16) void {
  @fmovs(fifo, fin(q_s, n), .{ .async = true, .ut_id = ut_a });
  @fadds(fout(q_lo, n), fin(q_n, n), fifo, .{ .async = true, .ut_id = ut_b });
  @fmovs(tv(0, n), fin(q_lb, n));
}
fn mcast(n: u16) void { @fmovs(fout(q_mc, n), uv(0, n)); }
// A small all-reduce over the control row's segment (n <= 2 words, gsc[2..]): roles 0 chain
// start, 1 add-forward (q_si in), 4 root of two halves (q_si, q_s2), 6 root of one half (q_si),
// 5 alone; the root multicasts on q_so, the others take it on q_sm.
fn seg_ar(n: u16) void {
  const d = @set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{4} -> gsc[i] }), 2, f32), n);
  if (role_s == 5) { return; }
  if (role_s == 4 or role_s == 6) {
    @fadds(d, d, fin(q_si, n));
    if (role_s == 4) { @fadds(d, d, fin(q_s2, n)); }
    @fmovs(fout(q_so, n), d);
    return;
  }
  if (role_s == 0) { @fmovs(fout(q_so, n), d); } else { @fadds(fout(q_so, n), fin(q_si, n), d); }
  @fmovs(d, fin(q_sm, n));
}

// ---------------------------------------------------------------- scalar math
fn rsqrt(v: f32) f32 {
  var y = @bitcast(f32, @as(u32, 0x5f3759df) - (@bitcast(u32, v) >> 1));
  y = y * (1.5 - 0.5 * v * y * y);
  y = y * (1.5 - 0.5 * v * y * y);
  y = y * (1.5 - 0.5 * v * y * y);
  return y;
}
fn exp1(x0: f32) f32 {
  var x: f32 = if (x0 < -87.0) -87.0 else if (x0 > 88.0) 88.0 else x0;
  var k: f32 = x * 1.4426950408889634 + 12582912.0;
  k = k - 12582912.0;
  const r = x - k * 0.6931471805599453;
  var p: f32 = 0.0013888889;
  p = p * r + 0.008333334;
  p = p * r + 0.041666668;
  p = p * r + 0.16666667;
  p = p * r + 0.5;
  p = p * r + 1.0;
  p = p * r + 1.0;
  const ki = @as(i16, k) + 127;
  const s = @bitcast(f32, @as(u32, @as(u16, ki)) << 23);
  return p * s;
}
fn recip(v: f32) f32 { const a = if (v < 0.0) -v else v; const r = rsqrt(a); return if (v < 0.0) -(r * r) else r * r; }   // (not rsqrt(v v): v v overflows past 1.8e19, e.g. 1 + e^87 in a sigmoid)
fn sigm(x: f32) f32 { return recip(1.0 + exp1(-x)); }
fn silu(x: f32) f32 { return x * sigm(x); }
fn ln1(x: f32) f32 {
  // ln(x), x > 0: exponent bits plus 2 atanh((m - 1) / (m + 1)) to the 7th power
  const b = @bitcast(u32, x);
  const e = @as(f32, @as(i16, @as(u16, (b >> 23) & 0xff)) - 127);
  const m = @bitcast(f32, (b & 0x007fffff) | 0x3f800000);
  const z = (m - 1.0) * recip(m + 1.0);
  const z2 = z * z;
  const p = z * (2.0 + z2 * (0.6666667 + z2 * (0.4 + z2 * 0.2857143)));
  return e * 0.6931471805599453 + p;
}
fn softplus(x: f32) f32 { return if (x > 20.0) x else ln1(1.0 + exp1(x)); }

// ---------------------------------------------------------------- vector element-wise (f32 DSD ops)
var va: [TN]f32 align(16) = @zeros([TN]f32);
var vb: [TN]f32 align(16) = @zeros([TN]f32);
var vcr: [TN]f32 align(16) = @zeros([TN]f32);
var vk = @zeros([TN]u16);
const va_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> va[i] });
const vb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> vb[i] });
const vc_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> vcr[i] });
const vk_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TN} -> vk[i] });
var vpl = vk_d;
fn vinit() void { vpl = @set_dsd_stride(@set_dsd_base_addr(vk_d, @ptrcast([*]u16, &vb)), 2); }
const ex_a = [3]f32 { 12582912.0, -12582912.0, 12582912.0 };
const ex_c = [4]f32 { 0.16790908575057983, 0.5000435709953308, 0.9999634027481079, 0.9999992847442627 };
// buf = exp(buf), buf in [-87, 88] (exp_fast's form; p in vb, k's bits in vk)
fn vexp(buf: mem1d_dsd, n: u16) void {
  const p = @set_dsd_length(vb_d, n);
  const kk = @set_dsd_length(vk_d, n);
  const pl = @set_dsd_length(vpl, n);
  const ph = @increment_dsd_offset(pl, 1, u16);
  @fmaxs(buf, buf, -87.0);
  @fnegs(buf, buf);
  @fmaxs(buf, buf, -88.0);
  @fnegs(buf, buf);
  @fmuls(p, buf, 1.4426950408889634);
  var c: u16 = 0;
  while (c < 3) : (c += 1) {
    @fadds(p, p, ex_a[c]);
    if (c == 1) { @fmacs(buf, buf, p, -0.6931471805599453); }
  }
  @sll16(kk, pl, 7);
  @fmuls(p, buf, 0.041458580642938614);
  c = 0;
  while (c < 4) : (c += 1) {
    if (c > 0) { @fmuls(p, p, buf); }
    @fadds(p, p, ex_c[c]);
  }
  @add16(ph, ph, kk);
  @fmovs(buf, p);
}
// dst = silu(src) = max(x, x e) / (1 + e), e = exp(-|x|) (dst != src)
fn vsilu(dst: mem1d_dsd, src: mem1d_dsd, n: u16) void {
  const e = @set_dsd_length(va_d, n);
  const d = @set_dsd_length(vb_d, n);
  const r = @set_dsd_length(vc_d, n);
  @fnegs(dst, src);
  @fmaxs(e, src, dst);
  @fnegs(e, e);
  vexp(e, n);
  @fadds(d, e, 1.0);
  @fmuls(r, d, 0.323112507040746);
  @fadds(r, r, -1.4540415401729079);
  @fmuls(r, r, d);
  @fadds(r, r, 2.1207294161729284);
  var k: u16 = 0;
  while (k < 2) : (k += 1) {
    @fmuls(dst, d, r);
    @fsubs(dst, 2.0, dst);
    @fmuls(r, r, dst);
  }
  @fmuls(dst, src, e);
  @fmaxs(dst, dst, src);
  @fmuls(dst, dst, r);
}

// dst = silu(src), the lean form (SILUQ 1): e = exp(-|x|) (the sign bit set by one or16 on the high
// halves, a lower clamp only), 1 / (1 + e) by the quadratic and two Newton steps: vsilu's arithmetic
// (bit-identical results; one step, ~1e-4, flipped a near tie on the 9B golden), fewer copies
var vah = vk_d;
fn vinit2() void { vah = @increment_dsd_offset(@set_dsd_stride(@set_dsd_base_addr(vk_d, @ptrcast([*]u16, &va)), 2), 1, u16); }
fn vsiluq(dst: mem1d_dsd, src: mem1d_dsd, n: u16) void {
  const x = @set_dsd_length(va_d, n);       // -|x|, then d = 1 + e
  const p = @set_dsd_length(vb_d, n);       // exp's p, then e
  const r = @set_dsd_length(vc_d, n);
  const kk = @set_dsd_length(vk_d, n);
  const pl = @set_dsd_length(vpl, n);
  const ph = @increment_dsd_offset(pl, 1, u16);
  @fmovs(x, src);
  @or16(@set_dsd_length(vah, n), @set_dsd_length(vah, n), 0x8000);   // -|x|
  @fmaxs(x, x, -87.0);
  @fmuls(p, x, 1.4426950408889634);
  var c: u16 = 0;
  while (c < 3) : (c += 1) {
    @fadds(p, p, ex_a[c]);
    if (c == 1) { @fmacs(x, x, p, -0.6931471805599453); }
  }
  @sll16(kk, pl, 7);
  @fmuls(p, x, 0.041458580642938614);
  c = 0;
  while (c < 4) : (c += 1) {
    if (c > 0) { @fmuls(p, p, x); }
    @fadds(p, p, ex_c[c]);
  }
  @add16(ph, ph, kk);                       // p = e
  @fadds(x, p, 1.0);                        // d
  @fmuls(r, x, 0.323112507040746);
  @fadds(r, r, -1.4540415401729079);
  @fmuls(r, r, x);
  @fadds(r, r, 2.1207294161729284);         // 1 / d to 1%
  var k: u16 = 0;
  while (k < 2) : (k += 1) {                // Newton: two steps (vsilu's)
    @fmuls(dst, x, r);
    @fsubs(dst, 2.0, dst);
    @fmuls(r, r, dst);
  }
  @fmuls(dst, src, p);
  @fmaxs(dst, dst, src);
  @fmuls(dst, dst, r);
}
fn vsil(dst: mem1d_dsd, src: mem1d_dsd, n: u16) void { if (SILUQ == 1) { vsiluq(dst, src, n); } else { vsilu(dst, src, n); } }

// ---------------------------------------------------------------- layers
// conv1d (CONV taps) over channels [o, o + n): u[o..) = the window's taps and t's new value; the
// window is a ring (row wp the oldest, wp advancing once a pass): the new raw value replaces the oldest
var wp: u16 = 0;
fn conv(g: u16, o: u16, n: u16) void {
  const wb = g * (CONV - 1) * NCH;
  const cwb = g * CONV * NCH;
  const cwd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cw[i] });
  const cwn = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cwin[i] });
  const acc = @set_dsd_length(va_d, n);
  const cv = uv(o, n);
  @fmuls(cv, tv(o, n), @set_dsd_length(@increment_dsd_offset(cwd, @as(i16, cwb + (CONV - 1) * NCH + o), f32), n));
  var j: u16 = 0;
  while (j < CONV - 1) : (j += 1) {
    var r = wp + j;
    if (r >= CONV - 1) { r -= CONV - 1; }
    @fmuls(acc, @set_dsd_length(@increment_dsd_offset(cwn, @as(i16, wb + r * NCH + o), f32), n),
           @set_dsd_length(@increment_dsd_offset(cwd, @as(i16, cwb + j * NCH + o), f32), n));
    @fadds(cv, cv, acc);
  }
  @fmovs(@set_dsd_length(@increment_dsd_offset(cwn, @as(i16, wb + wp * NCH + o), f32), n), tv(o, n));
}
fn gdn_pre0(g: u16) f32 {
  const N = NQG + 1;
  reduce(N);
  stamp(1 + 6 * cl + 0);
  const rr = rsqrt(t[NQG] / HID + EPS);
  @fmuls(tv(0, NQG), tv(0, NQG), rr);
  // conv1d over the window and the new value (vector ops over the column's channels), SiLU
  const wb = g * (CONV - 1) * NCH;
  const cwb = g * CONV * NCH;
  const cwd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cw[i] });
  const cwn = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cwin[i] });
  const acc = @set_dsd_length(va_d, NCH);   // (vsilu's e: the product lands in u first)
  const cv = uv(0, NCH);
  @fmuls(cv, tv(0, NCH), @increment_dsd_offset(cwd, @as(i16, cwb + (CONV - 1) * NCH), f32));
  var j: u16 = 0;
  while (j < CONV - 1) : (j += 1) {
    @fmuls(acc, @increment_dsd_offset(cwn, @as(i16, wb + j * NCH), f32), @increment_dsd_offset(cwd, @as(i16, cwb + j * NCH), f32));
    @fadds(cv, cv, acc);
  }
  j = 0;
  while (j + 1 < CONV - 1) : (j += 1) {
    @fmovs(@increment_dsd_offset(cwn, @as(i16, wb + j * NCH), f32), @increment_dsd_offset(cwn, @as(i16, wb + (j + 1) * NCH), f32));
  }
  @fmovs(@increment_dsd_offset(cwn, @as(i16, wb + (CONV - 2) * NCH), f32), tv(0, NCH));
  vsilu(tv(0, NCH), cv, NCH);
  // gates
  const bt = sigm(t[2 * DK + 2 * DV]);
  const dec = exp1(-exp1(gpar[2 * g]) * softplus(t[2 * DK + 2 * DV + 1] + gpar[2 * g + 1]));
  gdec = dec;
  @fmovs(uv(0, DK), tv(DK, DK));          // k
  @fmovs(uv(DK, DK), tv(0, DK));          // q
  u[2 * DK] = dec;
  u[2 * DK + 1] = if (tab[0] == 0) 1.0 else 0.0;
  @fmovs(@set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[i] }), DV), tv(2 * DK, DV));
  @fmovs(@set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[@as(i16, DV) + i] }), DV), tv(2 * DK + DV, DV));
  mcast(2 * DK + 2);
  stamp(1 + 6 * cl + 1);
  const zd = @set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[@as(i16, DV) + i] }), DV);
  vsilu(uv(0, DV), zd, DV);                // silu(z) while the weight PEs work
  @fmovs(zd, uv(0, DV));
  return bt;
}
fn gdn(g: u16) void {
  const bt = if (CONVQK == 1) gdn_pre1(g) else gdn_pre0(g);
  gdn_post(g, bt);
}
fn gdn_pre1(g: u16) f32 {
  const N = NQG + 1;
  reduce(N);
  stamp(1 + 6 * cl + 0);
  const rr = rsqrt(t[NQG] / HID + EPS);
  // on the path to the multicast: q / k's rms scale, conv and SiLU, the decay (v, z, beta after it)
  @fmuls(tv(0, 2 * DK), tv(0, 2 * DK), rr);
  conv(g, 0, 2 * DK);
  vsil(tv(0, 2 * DK), uv(0, 2 * DK), 2 * DK);
  if (GDEC == 0) { gdec = exp1(gpar[2 * g] * softplus(t[2 * DK + 2 * DV + 1] * rr + gpar[2 * g + 1])); }   // gpar[2 g] = -exp(A) (init)
  @fmovs(uv(0, DK), tv(DK, DK));          // k
  @fmovs(uv(DK, DK), tv(0, DK));          // q
  u[2 * DK] = if (GDEC == 0) gdec else 0.0;
  u[2 * DK + 1] = if (tab[0] == 0) 1.0 else 0.0;   // position 0: the weight PEs zero this layer's state
  mcast(2 * DK + 2);
  stamp(1 + 6 * cl + 1);
  if (GDEC == 1) { gdec = exp1(gpar[2 * g] * softplus(t[2 * DK + 2 * DV + 1] * rr + gpar[2 * g + 1])); }   // (off the path: see gdn_post)
  @fmuls(tv(2 * DK, NQG - 2 * DK), tv(2 * DK, NQG - 2 * DK), rr);
  conv(g, 2 * DK, DV);
  // conv(v) | z side by side in u, one SiLU pass into v | z
  @fmovs(uv(2 * DK + DV, DV), tv(2 * DK + DV, DV));
  vsil(vz_d, uv(2 * DK, 2 * DV), 2 * DV);
  const bt = sigm(t[2 * DK + 2 * DV]);
  return bt;
}
// GDEC 1: the weight PEs send S^T k / S^T q of the undecayed state; the decay scales the sums here and
// rides at the end of the second multicast for the state update (S = dec S + k delta / |k|)
var gdec: f32 = 1.0;
fn gdn_post(g: u16, bt: f32) void {
  const zd = @set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[@as(i16, DV) + i] }), DV);
  // the state reduction: S^T k | S^T q | k^2 | q^2 | k.q
  reduce(2 * DV + 3);
  stamp(1 + 6 * cl + 2);
  if (GDEC == 1) { @fmuls(tv(0, 2 * DV), tv(0, 2 * DV), gdec); }
  const ik = rsqrt(t[2 * DV] + EPS);
  const iq0 = rsqrt(t[2 * DV + 1] + EPS);
  const kq = t[2 * DV + 2] * ik * iq0;
  const iq = iq0 * rsqrt(@as(f32, HK));
  const vsd = @set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[i] }), DV);
  const dl = uv(DV, DV);
  const o = uv(0, DV);
  @fmuls(dl, tv(0, DV), ik);
  @fsubs(dl, vsd, dl);
  @fmuls(dl, dl, bt);                      // delta
  @fmuls(o, tv(DV, DV), iq);
  @fmacs(o, o, dl, kq * rsqrt(@as(f32, HK)));
  @fmuls(dl, dl, ik);                      // delta / |k| (the state update's)
  var ss: f32 = 0.0;
  var i: u16 = 0;
  while (i < DV) : (i += 1) { const v = u[i]; ss += v * v; }
  gsc[2] = ss;
  seg_ar(1);
  const on = rsqrt(gsc[2] / @as(f32, HV) + EPS);
  @fmuls(o, o, on);
  @fmuls(o, o, @set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> gnw[i] }), @as(i16, g * DV), f32), DV));
  @fmuls(o, o, zd);
  u[2 * DV] = gdec;
  mcast(2 * DV + GDEC);
  stamp(1 + 6 * cl + 3);
}

var rope_at: u32 = 0xffffffff;   // the position rc / rs hold
fn rope_tables() void { rope_tables_at(tab[0]); }
fn rope_tables_at(p: u32) void {
  // cos / sin of position p for each rotated pair: products of RLV table levels (its RBITS-bit digits)
  if (rope_at == p) { return; }
  rope_at = p;
  var j: u16 = 0;
  while (j < NROT) : (j += 1) {
    var c: f32 = 1.0;
    var s: f32 = 0.0;
    var lv: u16 = 0;
    while (lv < RLV) : (lv += 1) {
      const d = @as(u16, (p >> @as(u16, RBITS * (RLV - 1 - lv))) & @as(u32, RB - 1));
      const o = ((lv * RB + d) * 2) * NROT + j;
      const c2 = rot[o];
      const s2 = rot[o + NROT];
      const cn = c * c2 - s * s2;
      s = s * c2 + c * s2;
      c = cn;
    }
    rc[j] = c;
    rs[j] = s;
  }
}
fn rope(o: u16) void {
  // pairs (o + 2 j, o + 2 j + 1) of t: the host places each rotated pair's two halves adjacent
  var j: u16 = 0;
  while (j < NROT) : (j += 1) {
    const a = t[o + 2 * j];
    const b = t[o + 2 * j + 1];
    t[o + 2 * j] = a * rc[j] - b * rs[j];
    t[o + 2 * j + 1] = b * rc[j] + a * rs[j];
  }
}
var ilh = @zeros([mx(Qh, 1)]f32);
fn att(a: u16) void {
  const N = NQA + 1;
  const QD: u16 = Qh * Dc;
  reduce(N);
  stamp(1 + 6 * cl + 0);
  const rr = rsqrt(t[NQA] / HID + EPS);
  @fmuls(tv(0, NQA), tv(0, NQA), rr);
  const qkb = a * (QD + Dc);
  // the raw q / k sums of squares a head (the weight PEs' segment all-reduce completes them)
  var h: u16 = 0;
  while (h < Qh) : (h += 1) {
    var ss: f32 = 0.0;
    var d: u16 = 0;
    while (d < Dc) : (d += 1) { const v = t[h * Dc + d]; ss += v * v; }
    u[QD + 2 * Dc + 1 + h] = ss;
  }
  var ks: f32 = 0.0;
  var d: u16 = 0;
  while (d < Dc) : (d += 1) { const v = t[KO + d]; ks += v * v; }
  u[QD + 2 * Dc + 1 + Qh] = ks;
  const qw = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QD} -> qkw[i] });
  @fmuls(tv(0, QD), tv(0, QD), @set_dsd_length(@increment_dsd_offset(qw, @as(i16, qkb), f32), QD));
  @fmuls(tv(KO, Dc), tv(KO, Dc), @set_dsd_length(@increment_dsd_offset(qw, @as(i16, qkb + QD), f32), Dc));
  rope_tables();
  h = 0;
  while (h < Qh) : (h += 1) { rope(h * Dc); }
  rope(KO);
  if (GATE == 1) { @fmovs(@set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QD} -> gate[i] }), QD), tv(QD, QD)); }
  @fmovs(uv(0, QD), tv(0, QD));
  @fmovs(uv(QD, 2 * Dc), tv(KO, 2 * Dc));
  u[QD + 2 * Dc] = @as(f32, tab[0]);
  mcast(QD + 2 * Dc + 2 + Qh);
  stamp(1 + 6 * cl + 1);
  if (ROPEP == 1 and NLA == 1) { rope_tables_at(tab[0] + 1); }   // (one attention layer a unit: the next pass's tables)
  var gi: u16 = 0;   // the output gate's sigmoid while the weight PEs run the scores
  while (GATE == 1 and gi < QD) : (gi += 1) { gate[gi] = sigm(gate[gi]); }
  var pass: u16 = 0;
  while (pass < 8) : (pass += 1) {
    reduce(Qh * (Dc + 1));
    var bad: f32 = 0.0;
    h = 0;
    while (h < Qh) : (h += 1) {
      const l = t[h * (Dc + 1) + Dc];
      if (l < 0.00390625 or l >= 32768.0) { bad = 1.0; }   // the f16 probabilities' window
      ilh[h] = recip(l);
      if (ATTV == 0) {
        var d: u16 = 0;
        while (d < Dc) : (d += 1) { u[h * Dc + d] = t[h * (Dc + 1) + d] * ilh[h] * (if (GATE == 1) gate[h * Dc + d] else 1.0); }
      }
    }
    if (ATTV == 1) {
      // o / l, then the gate: two vector ops a head (a mem4d form tripped cslc: "operand does not dominate")
      const gd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> gate[i] });
      var hh: u16 = 0;
      while (hh < Qh) : (hh += 1) {
        @fmuls(uv(hh * Dc, Dc), tv(hh * (Dc + 1), Dc), ilh[hh]);
        if (GATE == 1) { @fmuls(uv(hh * Dc, Dc), uv(hh * Dc, Dc), @increment_dsd_offset(gd, @as(i16, hh * Dc), f32)); }
      }
    }
    h = 0;
    while (h < Qh) : (h += 1) {
      const lh = t[h * (Dc + 1) + Dc];
      u[QD + 1 + h] = if (ATTL == 2 and bad == 0.0) 0.0 else ln1(lh);
    }
    u[QD] = bad;
    mcast(QD + 1 + Qh);
    stamp(1 + 6 * cl + 3);
    if (ATTL == 2 and bad == 0.0) {   // the logs off the path (CY waits for the gate / up reduction next)
      h = 0;
      while (h < Qh) : (h += 1) { u[h] = ln1(t[h * (Dc + 1) + Dc]); }
      mcast(Qh);
    }
    if (bad == 0.0) { pass = 8; }
  }
}

// The MLP's SiLU in f16 (silu16, the f32-scaled form: s g log2e and s u ln2 in f32, rounded once;
// tools/emu/silu16.py emulates it bit for bit, tools/emu/tf_q35.py's _s16 mode)
var hg = @zeros([2 * Ic]@fp16());   // G | U
var ht = @zeros([Ic]@fp16());
var hm = @zeros([Ic]@fp16());
var hp = @zeros([Ic]@fp16());
var hq = @zeros([Ic]@fp16());
var hww = @zeros([Ic]@fp16());
var hu16 = @zeros([Ic]u16);
const h_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * Ic} -> hg[i] });
const HG = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> hg[i] });
const HU = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> hg[@as(i16, Ic) + i] });
const HT = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> ht[i] });
const HM = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> hm[i] });
const HP = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> hp[i] });
const HQ = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> hq[i] });
const HW = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> hww[i] });
const HB = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Ic} -> hu16[i] });
fn hb(d: [*]@fp16()) mem1d_dsd { return @set_dsd_base_addr(HB, @ptrcast([*]u16, d)); }
fn silu16(rr: f32) void {
  @fmuls(tv(0, Ic), tv(0, Ic), rr * 1.4426950408889634);
  @fmuls(tv(Ic, Ic), tv(Ic, Ic), rr * 0.6931471805599453);
  @fs2h(h_d, tv(0, 2 * Ic));
  @or16(hb(&ht), hb(&hg), 0x8000);            // t = -|a'|
  @fmaxh(HT, HT, @as(@fp16(), if (SLW == 1) -24.0 else -15.0));
  @faddh(HM, HT, @as(@fp16(), 1536.0));       // m = t + 1536: round(t) in its low bits
  @faddh(HP, HM, @as(@fp16(), -1536.0));      // n
  @fsubh(HQ, HT, HP);                         // r = t - n in [-0.5, 0.5]
  @fmulh(HP, HQ, @as(@fp16(), 0.05516966520599117));
  @faddh(HP, HP, @as(@fp16(), 0.24260644929856207));
  @fmulh(HP, HP, HQ);
  @faddh(HP, HP, @as(@fp16(), 0.6932608957863087));
  @fmulh(HP, HP, HQ);
  @faddh(HP, HP, @as(@fp16(), 0.9999283788785166));   // 2^r
  @add16(hb(&hm), hb(&hm), if (SLW == 1) 0x9a18 else 0x9a0f);   // n + 15 (1536's bits 0x6600); SLW: n + 24
  @sll16(hb(&hm), hb(&hm), 10);               // 2^n (SLW: 2^(n + 9), normal for n >= -23)
  @fmulh(HP, HP, HM);                         // e = exp(-|a|) (SLW: e' = e 2^9)
  if (SLW == 1) {
    @fmulh(HW, HP, @as(@fp16(), 0.001953125));
    @faddh(HW, HW, @as(@fp16(), 1.0));
  } else {
    @faddh(HW, HP, @as(@fp16(), 1.0));        // d = 1 + e in (1, 2]
  }
  @fmulh(HQ, HW, @as(@fp16(), 0.323112507040746));
  @faddh(HQ, HQ, @as(@fp16(), -1.4540415401729079));
  @fmulh(HQ, HQ, HW);
  @faddh(HQ, HQ, @as(@fp16(), 2.1207294161729284));   // 1/d to 1%
  @fmulh(HW, HW, HQ);
  @fsubh(HW, @as(@fp16(), 2.0), HW);
  @fmulh(HQ, HQ, HW);                         // 1/d to 1e-4
  @fmulh(HP, HP, HG);                         // a' e
  if (SLW == 1) { @fmulh(HP, HP, @as(@fp16(), 0.001953125)); }   // (e' a') 2^-9
  @fmaxh(HP, HP, HG);                         // a' (a >= 0) or a' e (a < 0)
  @fmulh(HP, HP, HU);
  @fmulh(HP, HP, HQ);
}
fn mlp() void {
  reduce(2 * Ic + 1);
  stamp(1 + 6 * cl + 4);
  const rr = rsqrt(t[2 * Ic] / HID + EPS);
  if (SILU16 == 1) {
    silu16(rr);
    @fh2s(fout(q_mc, Ic), HP);
    return;
  }
  @fmuls(tv(0, 2 * Ic), tv(0, 2 * Ic), rr);
  vsilu(uv(0, Ic), tv(0, Ic), Ic);
  @fmuls(uv(0, Ic), uv(0, Ic), tv(Ic, Ic));
  mcast(Ic);
}

var n_steps: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var s: u32 = 0;
  while (s < n_steps) : (s += 1) {
    tab[0] = pos0 + s;   // the pass's position (launch argument)
    if (tab[0] == 0) {   // a new sequence: the conv windows restart (the weight PEs reset their GDN state on u[2 DK + 1])
      @fmovs(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{if (NLG > 0) NLG * (CONV - 1) * NCH else 1} -> cwin[i] }), 0.0);
      wp = 0;
    }
    stamp(0);
    var l: u16 = 0;
    var la: u16 = 0;
    var lg: u16 = 0;
    while ((DIAG & 1) == 0 and l < (if ((DIAG & 2) != 0) 1 else K)) : (l += 1) {
      cl = l;
      if ((DIAG & 16) != 0) { continue; }
      if ((DIAG & 8) != 0) { reduce(if (((KM >> l) & 1) == 1) NQA + 1 else NQG + 1); continue; }
      if (((KM >> l) & 1) == 1) { if (NLA > 0) { att(la); } la += 1; }
      else { if (NLG > 0) { gdn(lg); } lg += 1; }
      if ((DIAG & 4) == 0) { mlp(); }
      stamp(1 + 6 * l + 5);
    }
    if (CONVQK == 1) { wp = if (wp + 1 >= CONV - 1) 0 else wp + 1; }
  }
  sys_mod.unblock_cmd_stream();
}
var pos0: u32 = 0;
var cl: u16 = 0;
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  pos0 = start_pos;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_n, .{ .color = @get_color(13) });   // parked (distinct a queue)
  @initialize_queue(q_s, .{ .color = @get_color(14) });   // parked (distinct a queue)
  @initialize_queue(q_lb, .{ .color = @get_color(17) });   // parked (distinct a queue)
  @initialize_queue(q_si, .{ .color = @get_color(18) });   // parked (distinct a queue)
  @initialize_queue(q_sm, .{ .color = @get_color(19) });   // parked (distinct a queue)
  @initialize_queue(q_s2, .{ .color = @get_color(20) });   // parked (distinct a queue)
  @initialize_queue(q_lo, .{ .color = C_PARK });
  @initialize_queue(q_mc, .{ .color = C_PARK });
  @initialize_queue(q_so, .{ .color = C_PARK });
  @export_symbol(cw_ptr, "cw");
  @export_symbol(gpar_ptr, "gpar");
  @export_symbol(gnw_ptr, "gnw");
  @export_symbol(qkw_ptr, "qkw");
  @export_symbol(rot_ptr, "rot");
  @export_symbol(tab_ptr, "tab");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(init);
  @export_symbol(compute);
}
//@@ dummies
