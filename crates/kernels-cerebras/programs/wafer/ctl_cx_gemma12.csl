// wafer/ctl_cx_gemma12.csl: the wafer program row control PE for Gemma 4 12B (ctl_cx_gemma.csl without the PLE phase;
// README.md, Gemma 4 12B). The residual is x plus a pending term p whose scalar s (a sandwich norm's
// 1 / rms) is not known here yet. A layer's two phases each send the row's weight PEs [a = g x | b = g p | 4 partial
// sums] (Hc + Hc + 4 f32 words; sums: the pending |r|^2 for s, |x|^2, x.p, |p|^2, so CY gets rms(x + s p)) and take
// back [the reduction (Hc) | s] (the PE in column 0 adds s):
//   attention:  g = input_layernorm;     back: o, s (the previous MLP's):  x += s p, p = g_pa o
//   MLP:        g = pre_feedforward;     back: d, s1:                     x += s1 p, p = g_pff d, then x, p *= lambda
// The handoff carries [x | p | |d_r|^2] (2 Hc + 1). The flush unit (the last) sends [|d_r|^2, 0, 0, 0] after its
// last layer, takes s back and sends x alone to the head.
// Head groups (rcfg [RQ+10..14)): x leaves for the head a group of consecutive rows at a time. A group's members
// (not its first row, the root) send their Hc words toward the root on the chain (oq5), each forwarding the words
// of the members beyond it (iq7, NFX words); the root sends its own and then the forwarded words east (HX). The
// wafer loop's embedding comes back the same way in unit 0: the root takes the group's words on HE, keeps its Hc
// and forwards NFE words down the chain; a member keeps its Hc of the chain's words and forwards the rest.
param memcpy_params;
param DIAG: u16 = 0;
param K: u16;
param Hc: u16;
param HOSTX: u16 = 0;
param XKEEP: u16 = 0;
param FIFOW: u16 = 32;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const fab = @import_module("ops/fabric.csl", .{ .NQ = 6 });
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const timestamp = @import_module("<time>");
var tdbg = @zeros([K + 2]u32);
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }

const HW: u16 = 2 * Hc + 1;
var x = @zeros([HW]f32);              // x | p | |h|^2 (the handoff's words)
var x_ptr: [*]f32 = &x;
var xdbg = @zeros([if (XKEEP == 1) K * Hc else 1]f32);
var xdbg_ptr: [*]f32 = &xdbg;
var xred = @zeros([if (XKEEP == 1) 3 * K * Hc else 1]f32);
var xred_ptr: [*]f32 = &xred;
const GL: u16 = 4 * Hc + 1;            // a layer's gammas: input, post-attention, pre-FFN, post-FFN; lambda
var gam = @zeros([K * GL + 1]f32);     // (+ the embedding scale, unit 0)
var gam_ptr: [*]f32 = &gam;
var t = @zeros([Hc + 1]f32);
var ab = @zeros([Hc]f32);
var sc = @zeros([4]f32);
const x_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> x[i] });
const p_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> x[@as(i16, Hc) + i] });
const xw_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{HW} -> x[i] });
const t_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> t[i] });
const t1_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc + 1} -> t[i] });
const ab_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> ab[i] });
const sc_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{4} -> sc[i] });
const g_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gam[i] });

const q_w = @get_input_queue(2);
const q_e = @get_input_queue(3);
const q_lb = @get_input_queue(4);
const q_hi = @get_input_queue(5);
const q_em = @get_input_queue(6);
const q_ci = @get_input_queue(7);      // the head-group chain in
const q_lo = @get_output_queue(2);
const q_mc = @get_output_queue(3);
const q_ho = @get_output_queue(4);
const q_co = @get_output_queue(5);     // the head-group chain out
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
var fifo_buf = @zeros([FIFOW]f32);
const fifo = @allocate_fifo(fifo_buf);
const NR: u16 = 12;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 14]u32);   // ctl_cx's; [RQ+7] flags: bit 0 first unit, 1 no handoff out, 2 the wafer loop's
var rcfg_ptr: [*]u32 = &rcfg;      // embedding in (iq6), 3 the flush unit, 4 x leaves alone, 5 a head-group root,
// 6 a member (x by the chain), 7 the embedding by the chain (a member); [RQ+10] iq7 (chain in), [RQ+11] oq5 (chain out),
// [RQ+12] NFX, [RQ+13] NFE
fn init() void {
  fab.routes(&rcfg);
  var fq = [6]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]), @as(u16, rcfg[RQ + 3]), @as(u16, rcfg[RQ + 9]), @as(u16, rcfg[RQ + 10]) };
  fab.bind_iqs(&fq, @as(u16, rcfg[RQ + 8]));
  fab.oqc(2, rcfg[RQ + 4]); fab.oqc(3, rcfg[RQ + 5]); fab.oqc(4, rcfg[RQ + 6]); fab.oqc(5, rcfg[RQ + 11]);
  timestamp.enable_tsc();
  sys_mod.unblock_cmd_stream();
}

fn reduce(n: u16) void {
  @fmovs(fifo, fab.fin(q_e, n), .{ .async = true, .ut_id = ut_a });
  @fadds(fab.fout(q_lo, n), fab.fin(q_w, n), fifo, .{ .async = true, .ut_id = ut_b });
  @fmovs(@set_dsd_length(t1_d, n), fab.fin(q_lb, n));
}
fn dot(a: [*]f32, b: [*]f32) f32 {
  var s: f32 = 0.0;
  var i: u16 = 0;
  while (i < Hc) : (i += 1) { s += a[i] * b[i]; }
  return s;
}
// a phase's row multicast: g x, g p (g at gam[go], or ones when go is 0xffff), then the sums (r2 first)
fn send(go: u16, fromt: bool, full: bool) void {
  if (go == 0xffff) {
    @fmovs(fab.fout(q_mc, Hc), x_d);
    @fmovs(fab.fout(q_mc, Hc), p_d);
  } else {
    const g = @increment_dsd_offset(g_d, @as(i16, go), f32);
    @fmuls(ab_d, x_d, g);
    @fmovs(fab.fout(q_mc, Hc), ab_d);
    @fmuls(ab_d, p_d, g);
    @fmovs(fab.fout(q_mc, Hc), ab_d);
  }
  const tp = @ptrcast([*]f32, &t[0]);
  sc[0] = if (fromt) dot(tp, tp) else x[2 * Hc];
  if (full) {
    const xp = @ptrcast([*]f32, &x[0]);
    const pp = @ptrcast([*]f32, &x[Hc]);
    sc[1] = dot(xp, xp);
    sc[2] = dot(xp, pp);
    sc[3] = dot(pp, pp);
  } else {
    sc[1] = 0.0; sc[2] = 0.0; sc[3] = 0.0;
  }
  @fmovs(fab.fout(q_mc, 4), sc_d);
}
// the reduction back (t): x += s p, then p = g r
fn take(go: u16, i: u16) void {
  reduce(Hc + 1);
  if (XKEEP == 1) { @fmovs(@set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |j|{3 * K * Hc} -> xred[j] }), @as(i16, i * Hc), f32), Hc), t_d); }
  @fmacs(x_d, x_d, p_d, t[Hc]);
  @fmuls(p_d, t_d, @increment_dsd_offset(g_d, @as(i16, go), f32));
}

var n_steps: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var s: u32 = 0;
  while (s < n_steps) : (s += 1) {
    const fl = rcfg[RQ + 7];
    if (HOSTX == 0 and (fl & 1) == 0) { @fmovs(xw_d, fab.fin(q_hi, HW)); }
    else {
      if (s > 0 and (fl & 4) != 0) {     // the wafer loop's next token (else the host's x)
        const nfe = @as(u16, rcfg[RQ + 13]);
        if ((fl & 128) != 0) {
          @fmovs(x_d, fab.fin(q_ci, Hc));
          if (nfe > 0) { @fmovs(fab.fout(q_co, nfe), fab.fin(q_ci, nfe)); }
        } else {
          @fmovs(x_d, fab.fin(q_em, Hc));
          if (nfe > 0) { @fmovs(fab.fout(q_co, nfe), fab.fin(q_em, nfe)); }
        }
      }
      @fmuls(x_d, x_d, gam[K * GL]);                                 // the embedding scale
      @fmovs(p_d, 0.0);
      x[2 * Hc] = 0.0;
    }
    stamp(0);
    var l: u16 = 0;
    while ((DIAG & 1) == 0 and l < (if ((DIAG & 2) != 0) 1 else K)) : (l += 1) {
      const gb = l * GL;
      send(gb, l > 0, true);
      take(gb + Hc, 3 * l);
      // (diagnostics) x is now the previous layer's output (its post-PLE scalar resolved): xdbg[l]
      if (XKEEP == 1) { @fmovs(@set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{K * Hc} -> xdbg[i] }), @as(i16, l * Hc), f32), Hc), x_d); }
      send(gb + 2 * Hc, true, true);
      take(gb + 3 * Hc, 3 * l + 1);
      const lam = gam[gb + 4 * Hc];
      @fmuls(x_d, x_d, lam);
      @fmuls(p_d, p_d, lam);
      stamp(l + 1);
    }
    if ((DIAG & 1) == 0) { const tq = @ptrcast([*]f32, &t[0]); x[2 * Hc] = dot(tq, tq); }   // the last MLP's |d|^2
    if ((DIAG & 1) == 0 and (fl & 8) != 0) {
      sc[0] = x[2 * Hc]; sc[1] = 0.0; sc[2] = 0.0; sc[3] = 0.0;
      @fmovs(fab.fout(q_mc, 4), sc_d);
      reduce(1);
      @fmacs(x_d, x_d, p_d, t[0]);
      @fmovs(p_d, 0.0);
      x[2 * Hc] = 0.0;
      if (HOSTX == 0) { xout(fl); }
    } else if (HOSTX == 0 and (fl & 8) != 0) {
      xout(fl);                     // (DIAG 1: the flush unit's x as is)
    } else if (HOSTX == 0 and (fl & 2) == 0) {
      @fmovs(fab.fout(q_ho, HW), xw_d);
    }
    stamp(K + 1);
  }
  sys_mod.unblock_cmd_stream();
}
// x to the head (the flush unit): a member sends its Hc and forwards NFX words on the chain, a root sends its Hc and
// the forwarded words east
fn xout(fl: u32) void {
  const nfx = @as(u16, rcfg[RQ + 12]);
  if ((fl & 64) != 0) {
    @fmovs(fab.fout(q_co, Hc), x_d);
    if (nfx > 0) { @fmovs(fab.fout(q_co, nfx), fab.fin(q_ci, nfx)); }
  } else if ((fl & 2) == 0) {
    @fmovs(fab.fout(q_ho, Hc), x_d);
    if (nfx > 0) { @fmovs(fab.fout(q_ho, nfx), fab.fin(q_ci, nfx)); }
  }
}
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_w, .{ .color = @get_color(13) });
  @initialize_queue(q_e, .{ .color = @get_color(14) });
  @initialize_queue(q_lb, .{ .color = @get_color(17) });
  @initialize_queue(q_hi, .{ .color = @get_color(18) });
  @initialize_queue(q_em, .{ .color = @get_color(19) });
  @initialize_queue(q_ci, .{ .color = @get_color(20) });
  @initialize_queue(q_co, .{ .color = C_PARK });
  @initialize_queue(q_lo, .{ .color = C_PARK });
  @initialize_queue(q_mc, .{ .color = C_PARK });
  @initialize_queue(q_ho, .{ .color = C_PARK });
  @export_symbol(x_ptr, "x");
  @export_symbol(xdbg_ptr, "xdbg");
  @export_symbol(xred_ptr, "xred");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(gam_ptr, "gam");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(init);
  @export_symbol(compute);
}
//@@ dummies
