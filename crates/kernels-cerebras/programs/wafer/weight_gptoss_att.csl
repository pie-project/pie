// wafer/weight_gptoss_att.csl: the wafer program attention weight PE for gpt-oss. Design: README.md
// and the gpt-oss section there (attention columns | CX | MoE columns).
//
// Role. A gpt-oss unit is [AX attention columns | CX | MX MoE columns] by PY weight rows (+ the CY row).
// Attention PE (r, c) holds, for each of the unit's K layers, its row's x chunk (Hc dims) by its column's
// q | k | v outputs (Qh Dc | Dc | Dc) and the o_proj tile (QO = Qh Dc inputs by Hc), and runs a layer as:
//   x_r' (Hc), 2^S_r, ssq_r           <- CX_r's row multicast (x g 2^-S_r: f16 safe; the partial is scaled back)
//   q|k|v partial x 2^S_r (+ ssq_r)   -> column reduction into CY_c (ctl_cy_gptoss_att.csl)
//   [q | k | v | position]            <- CY_c (q biased, YaRN RoPE, 1/sqrt(64); k biased, RoPE; v biased)
//   the row's KV entries: full layers NE entries (position p on row p % PY as entry p / PY), sliding layers one
//   ring entry (live while pos - its position < WIN); scores against the carried log-sum-exp reference, the
//   scores' segment all-reduce over the kv head's columns, f16 probabilities, values with a ones column
//   values | sums                     -> column reduction into CY_c (which adds the sinks)
//   o (QO), redo, LSE steps          <- CY_c
//   o_proj partial (Hc)               -> row reduction into CX_r (the west half)
//   x2' (Hc), 2^S, ssq                <- CX_r (the MoE half's input passes here too: read and dropped)
// KV matvecs accumulate in f32; the projections in f16 (x f16, W f16 = the bf16 weights, exact).
//
// Interface. Exports w (u16: per layer [qkv Hc x NQA][o QO x Hc], f16 bits), rcfg, tdbg, init,
// compute(steps, start_pos). Queues and the hardware rules: as weight_dense.csl (own queue a flow; a route
// rebound for a send is restored only after its output queue drains; no park on the PE's own send colour;
// >= 768 B stack room).
// rcfg: [0] routes n, [1..1+2n); from RQ: [0..6) iq2..iq7, [6] oq5, [7] oq3,
// [8] row role, [9] column role, [10] the segment role, [11] -, [12..17) the segment colours, [17] the
// weight row, [18..21) the pass-start relay, [21..24) the pass-end relay, [24] the spare colour, [25] flags (bit 0: the pass-start relay carries the
// token loop's embedding: skipped at a launch's step 0).
//
// Params. Shape: K, KM (bit l: full attention), Hc, NQA, QO, Qh, Dc, NE, PYW, WIN. Diagnostics: TSTAMP,
// DIAG (1 no layers, 2 one layer, 4 no MoE phase). FIFOW: the FIFO depth.
param memcpy_params;
param DIAG: u16 = 0;
param K: u16;
param KM: u16;
param Hc: u16;
param NQA: u16;
param QO: u16;
param Qh: u16;
param Dc: u16;
param NE: u16;
param PYW: u16;
param WIN: u16 = 128;
param PFTZ: u16 = 0;   // 1: f16 subnormal probabilities and o values flushed to 0 before their matvecs
param TSTAMP: u16 = 0;
param FIFOW: u16 = 32;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const fab = @import_module("ops/fabric.csl", .{ .NQ = 6 });
const math = @import_module("ops/math.csl");
const matvec = @import_module("ops/mv.csl");
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const NTD: u16 = 1 + 6 * K;   // [0], then a layer's four phase ends; then a layer's o_proj sent, LSE steps in
const timestamp = @import_module("<time>");
var tdbg = @zeros([if (TSTAMP == 1) NTD else 1]u32);
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { if (TSTAMP == 0) { return; } timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }
fn mx(a: u16, b: u16) u16 { return if (a > b) a else b; }

fn nla() u16 { var n: u16 = 0; var l: u16 = 0; while (l < K) : (l += 1) { if (((KM >> l) & 1) == 1) { n += 1; } } return n; }
const NLA: u16 = nla();
const NLS: u16 = K - NLA;
const LW: u16 = Hc * NQA + QO * Hc;
var w = @zeros([K * LW + 1]u16);
var w_ptr: [*]u16 = &w;

const NS: u16 = Qh * NE;
const XN: u16 = mx(mx(Hc, QO), NS);
const YN: u16 = mx(mx(NQA + 1, Hc), mx(NS, Qh * (Dc + 1)));
var xh = @zeros([XN]@fp16());
var y: [YN]f32 align(16) = @zeros([YN]f32);
var y16 = @zeros([YN]@fp16());
const xh_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XN} -> xh[i] });
const y_d0 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{YN} -> y[i] });
const y16_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{YN} -> y16[i] });
var a_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{YN} -> w[i] });
fn yv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(y_d0, @as(i16, o), f32), n); }
var xw = @zeros([2]f32);
const xw_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2} -> xw[i] });

// ---------------------------------------------------------------- fabric
const q_xa = @get_input_queue(2);
const q_xb = @get_input_queue(3);
const q_ya = @get_input_queue(4);
const q_yb = @get_input_queue(5);
const q_xm = @get_input_queue(6);
const q_ym = @get_input_queue(7);
const q_xo = @get_output_queue(5);
const q_yo = @get_output_queue(3);
const q_ao = @get_output_queue(4);
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
const ut_xa = @get_ut_id(2);
const ut_xb = @get_ut_id(3);
const rx = @import_module("ops/red.csl", .{ .fab = fab, .IN1 = q_xa, .IN2 = q_xb, .OUT = q_xo, .UT1 = ut_xa, .UT2 = ut_xb, .FIFOW = FIFOW });
const ry = @import_module("ops/red.csl", .{ .fab = fab, .IN1 = q_ya, .IN2 = q_yb, .OUT = q_yo, .UT1 = ut_a, .UT2 = ut_b, .FIFOW = FIFOW });

const NR: u16 = 16;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 26]u32);
var rcfg_ptr: [*]u32 = &rcfg;
var role_s: u16 = 0;
var myrow: u16 = 0;
fn init() void {
  fab.routes(&rcfg);
  var fq = [6]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]), @as(u16, rcfg[RQ + 3]), @as(u16, rcfg[RQ + 4]), @as(u16, rcfg[RQ + 5]) };
  fab.bind_iqs(&fq, @as(u16, rcfg[RQ + 24]));
  fab.oqc(5, rcfg[RQ + 6]);
  fab.oqc(3, rcfg[RQ + 7]);
  rx.role = @as(u16, rcfg[RQ + 8]);
  ry.role = @as(u16, rcfg[RQ + 9]);
  role_s = @as(u16, rcfg[RQ + 10]);
  myrow = @as(u16, rcfg[RQ + 17]);
  timestamp.enable_tsc();
  sys_mod.unblock_cmd_stream();
}

fn send_x(n: u16) void { rx.send(yv(0, n), n); }
fn send_y(n: u16) void { ry.send(yv(0, n), n); }

// ---------------------------------------------------------------- matvecs
// y[0..N) = A x: f16 operands, f16 accumulation, A at w[off] (R rows of N), x = xh[0..R)
fn mv(off: u16, R: u16, N: u16) void {
  const a = @set_dsd_length(@set_dsd_base_addr(a_d, @ptrcast([*]u16, &w[off])), N);
  const yh = @set_dsd_length(y16_d, N);
  matvec.tile16(yh, a, @set_dsd_length(xh_d, R));
  @fh2s(yv(0, N), yh);
}
// y[yo..yo+N) = A x with f32 accumulation (the KV matvecs), A at p (R rows of N), x = xh[xo..xo+R)

// y[yo..yo+N) = A x with f32 accumulation, A at p (R rows of N), x the DSD xv (R f16 words)
fn mvx(p: [*]u16, R: u16, N: u16, xv: mem1d_dsd, yo: u16) void {
  const a = @set_dsd_length(@set_dsd_base_addr(a_d, p), N);
  matvec.tile32(yv(yo, N), a, xv);
}

// ---------------------------------------------------------------- attention
fn qmode(m: u16) void {
  while ((tile_config.output_queue_status.get_raw() & 0x1000) == 0) {}   // oq4 empty
  if (m == 0) {
    fab.iqc(6, rcfg[RQ + 4]); fab.iqc(7, rcfg[RQ + 5]);
  } else {
    fab.iqc(7, rcfg[RQ + 13]); fab.oqc(4, rcfg[RQ + 15]);
    fab.iqc(6, if (role_s == 4) rcfg[RQ + 14] else rcfg[RQ + 16]);
  }
}
const KCW: u16 = Dc * NE;          // full layers' keys, entry-major [e][d]
const VCW: u16 = NE * (Dc + 1);    // values, entry-major [e][d | 1]
var kc = @zeros([NLA * KCW + NLS * Dc + 1]u16);
var vc = @zeros([NLA * VCW + NLS * (Dc + 1) + 1]u16);
var spos = @zeros([if (NLS > 0) NLS else 1]u16);   // sliding: 1 + the position its entry holds (0: none)
var mref = @zeros([K * Qh]f32);
var vf = @zeros([Dc + 1]f32);        // one entry's value row widened (the values' scaled adds)
const vf_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc + 1} -> vf[i] });
var qt = @zeros([Dc * Qh]@fp16());
var fz = @zeros([if (PFTZ == 1) XN else 1]u16);
const fz_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{if (PFTZ == 1) XN else 1} -> fz[i] });
// xh[0..n) with an exponent field of 0 (zero or subnormal) set to +0: m = the exponent field + 0x7c00 (bit 15 set
// iff normal), smeared over all 16 bits, then and-ed in
fn ftz(n: u16) void {
  if (PFTZ == 0) { return; }
  const x = @set_dsd_length(@set_dsd_base_addr(fz_d, @ptrcast([*]u16, &xh)), n);
  const m = @set_dsd_length(fz_d, n);
  @and16(m, x, @as(u16, 0x7c00));
  @add16(m, m, @as(u16, 0x7c00));
  @and16(m, m, @as(u16, 0x8000));
  const t = @set_dsd_length(@set_dsd_base_addr(fz_d, @ptrcast([*]u16, &y16)), n);
  var sh: u16 = 1;
  while (sh < 16) : (sh *= 2) {
    @slr16(t, m, sh);
    @or16(m, m, t);
  }
  @and16(x, x, m);
}   // q transposed [d][h] (the scores' matrix: one matvec a live entry)
const qt_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc * Qh} -> qt[i] });
const kc_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> kc[i] });
const QD: u16 = Qh * Dc;
const AB: u16 = QD + 2 * Dc + 1;
var ab = @zeros([AB]f32);
var sx = @zeros([NS + 1 + Qh]f32);
const sx_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NS} -> sx[i] });
const ab_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{AB} -> ab[i] });
// buf = exp(buf) in place (exp_fast's form; p in y, k's bits in y16)
fn exp_v(buf: mem1d_dsd, n: u16) void {
  const p = yv(0, n);
  const kk = @set_dsd_length(@set_dsd_base_addr(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NS} -> w[i] }), @ptrcast([*]u16, &y16)), n);
  const pl = @set_dsd_length(@set_dsd_stride(@set_dsd_base_addr(kk, @ptrcast([*]u16, &y)), 2), n);
  math.vexp(buf, p, kk, pl, 88.0, true);
}
// the scores' segment all-reduce over the kv head's columns (root: a weight PE in the middle)
fn seg_ar(n: u16) void {
  const d = @set_dsd_length(sx_d, n);
  qmode(2);
  if (role_s == 4) {
    @fadds(d, d, fab.fin(q_ym, n));
    @fadds(d, d, fab.fin(q_xm, n));
    @fmovs(fab.fout(q_ao, n), d);
  } else if (role_s == 6) {
    @fadds(d, d, fab.fin(q_ym, n));
    @fmovs(fab.fout(q_ao, n), d);
  } else {
    const A = .{ .async = true, .ut_id = ut_b };
    if (role_s == 0) { @fmovs(fab.fout(q_ao, n), d, A); }
    else { @fadds(fab.fout(q_ao, n), fab.fin(q_ym, n), d, A); }
    @fmovs(d, fab.fin(q_xm, n));
  }
  qmode(0);
}
var lpa: u16 = 0;   // 1 + the layer whose log-sum-exp steps follow o (ATTL 2: read after the o_proj send)
fn att_mix(l: u16, full: bool, a: u16, s: u16) void {
  @fmovs(ab_d, fab.fin(q_ym, AB));
  const pos = @as(u16, ab[QD + 2 * Dc]);
  const mine = (pos % PYW) == myrow;
  var kb: u16 = 0;
  var vb: u16 = 0;
  var e0: u16 = 0;
  var nel: u16 = 0;
  if (pos == 0) {   // a new sequence: no live entries, the log-sum-exp reference restarts
    var hh: u16 = 0;
    while (hh < Qh) : (hh += 1) { mref[l * Qh + hh] = 0.0; }
    if (!full) { spos[s] = 0; }
  }
  if (full) {
    kb = a * KCW; vb = a * VCW; e0 = pos / PYW;
    nel = if (e0 + 1 < NE) e0 + 1 else NE;
    if (pos == 0) { @mov16(@set_dsd_length(@set_dsd_base_addr(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{VCW} -> vc[i] }), @ptrcast([*]u16, &vc[1 + vb])), VCW), @as(u16, 0)); }
  } else {
    kb = NLA * KCW + s * Dc; vb = NLA * VCW + s * (Dc + 1);
    if (mine) { spos[s] = pos + 1; }
    nel = if (spos[s] != 0 and pos + 1 - spos[s] < WIN) 1 else 0;
  }
  if (mine) {
    const ee = if (full) e0 else 0;
    var d: u16 = 0;
    while (d < Dc) : (d += 1) {
      kc[1 + kb + ee * Dc + d] = @bitcast(u16, @as(@fp16(), ab[QD + d]));
      vc[1 + vb + ee * (Dc + 1) + d] = @bitcast(u16, @as(@fp16(), ab[QD + Dc + d]));
    }
    vc[1 + vb + ee * (Dc + 1) + Dc] = 0x3c00;   // 1.0: the values matvec's last output is the softmax sum
  }
  const nsl: u16 = Qh * nel;
  var apass: u16 = 0;
  while (apass < 8) : (apass += 1) {
    var h: u16 = 0;
    if (nel > 0) {
      // qt[d][h] = q[h][d] (f16), then the live entries' scores [e][h]: x = the entry's key, A = qt
      while (h < Qh) : (h += 1) {
        @fs2h(@set_dsd_stride(@set_dsd_length(@increment_dsd_offset(qt_d, @as(i16, h), @fp16()), Dc), Qh),
              @set_dsd_length(@increment_dsd_offset(ab_d, @as(i16, h * Dc), f32), Dc));
      }
      var e: u16 = 0;
      while (e < nel) : (e += 1) {
        const xk = @set_dsd_base_addr(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc} -> xh[i] }), @ptrcast([*]@fp16(), &kc[1 + kb + e * Dc]));
        mvx(@ptrcast([*]u16, &qt), Dc, Qh, xk, e * Qh);
      }
      @fmovs(@set_dsd_length(sx_d, nsl), yv(0, nsl));
      if (role_s != 5) { seg_ar(nsl); }
      const mr = @set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{K * Qh} -> mref[i] }), @as(i16, l * Qh), f32), Qh);
      e = 0;
      while (e < nel) : (e += 1) {
        const se = @set_dsd_length(@increment_dsd_offset(sx_d, @as(i16, e * Qh), f32), Qh);
        @fsubs(se, se, mr);
      }
      const sp = @set_dsd_length(sx_d, nsl);
      exp_v(sp, nsl);
      @fnegs(sp, sp);               // probabilities clamped at the f16 max (-max(-p, -65504))
      @fmaxs(sp, sp, -65504.0);
      @fnegs(sp, sp);
      @fs2h(@set_dsd_length(xh_d, nsl), sp);
      ftz(nsl);
      h = 0;
      if (nel <= 4) {
        // few live entries: a head's values as nel scaled adds of the entry's (f32-widened, exact) value row,
        // in entry order: the matvec's products and sums, without its per-call cost
        @fmovs(yv(0, Qh * (Dc + 1)), 0.0);
        var e2: u16 = 0;
        while (e2 < nel) : (e2 += 1) {
          @fh2s(vf_d, @set_dsd_base_addr(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Dc + 1} -> xh[i] }), @ptrcast([*]@fp16(), &vc[1 + vb + e2 * (Dc + 1)])));
          h = 0;
          while (h < Qh) : (h += 1) {
            const pv = @as(f32, xh[e2 * Qh + h]);
            @fmacs(yv(h * (Dc + 1), Dc + 1), yv(h * (Dc + 1), Dc + 1), vf_d, pv);
          }
        }
      } else {
        while (h < Qh) : (h += 1) {
          const xp = @set_dsd_stride(@set_dsd_length(@increment_dsd_offset(xh_d, @as(i16, h), @fp16()), nel), Qh);
          mvx(@ptrcast([*]u16, &vc[1 + vb]), nel, Dc + 1, xp, h * (Dc + 1));
        }
      }
    } else {
      @fmovs(yv(0, Qh * (Dc + 1)), 0.0);
    }
    send_y(Qh * (Dc + 1));
    // o (the o_proj's x), then the redo word and (redo passes) the heads' log-sum-exp steps
    @fs2h(@set_dsd_length(xh_d, QO), fab.fin(q_ym, QO));
    ftz(QO);
    @fmovs(@set_dsd_length(sx_d, 1), fab.fin(q_ym, 1));
    if (sx[0] == 0.0) {
      lpa = l + 1;
      apass = 8;
    } else {
      @fmovs(@set_dsd_length(sx_d, Qh), fab.fin(q_ym, Qh));
      h = 0;
      while (h < Qh) : (h += 1) { mref[l * Qh + h] += sx[h]; }
    }
  }
}
fn lse_late() void {
  if (lpa == 0) { return; }
  const l = lpa - 1;
  @fmovs(@set_dsd_length(sx_d, Qh), fab.fin(q_ym, Qh));
  var h: u16 = 0;
  while (h < Qh) : (h += 1) { mref[l * Qh + h] += sx[h]; }
  lpa = 0;
}

// ---------------------------------------------------------------- a pass
fn recv_x() void {
  @fs2h(@set_dsd_length(xh_d, Hc), fab.fin(q_xm, Hc));
  @fmovs(xw_d, fab.fin(q_xm, 2));      // 2^S_r, the row's sum of squares
}
fn layer(l: u16, a: u16, s: u16) void {
  const full = ((KM >> l) & 1) == 1;
  const b = l * LW;
  recv_x();
  stamp(1 + 4 * l);
  mv(b, Hc, NQA);
  @fmuls(yv(0, NQA), yv(0, NQA), xw[0]);
  y[NQA] = xw[1];
  send_y(NQA + 1);
  stamp(2 + 4 * l);
  att_mix(l, full, a, s);
  stamp(3 + 4 * l);
  mv(b + Hc * NQA, QO, Hc);
  send_x(Hc);
  stamp(1 + 4 * K + 2 * l);
  lse_late();
  stamp(2 + 4 * K + 2 * l);
  if ((DIAG & 4) == 0) {   // the MoE half's x2 passes this row's multicast: drop it
    @fmovs(@set_dsd_length(sx_d, Hc + 2), fab.fin(q_xm, Hc + 2));
  }
  stamp(4 + 4 * l);
}

fn relay(o: u16) void {
  const n = @as(u16, rcfg[RQ + o]);
  if (n == 0) { return; }
  while ((tile_config.output_queue_status.get_raw() & 0x1000) == 0) {}
  fab.iqc(6, rcfg[RQ + o + 1]);
  fab.oqc(4, rcfg[RQ + o + 2]);
  @fmovs(fab.fout(q_ao, n), fab.fin(q_xm, n));
  qmode(0);
}

var n_steps: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var i: u32 = 0;
  while (i < n_steps) : (i += 1) {
    if (i > 0 or (rcfg[RQ + 25] & 1) == 0) { relay(18); }   // (bit 0: the pass-start relay is the token loop's embedding: none before step 1)
    stamp(0);
    var l: u16 = 0;
    var a: u16 = 0;
    var s: u16 = 0;
    while ((DIAG & 1) == 0 and l < (if ((DIAG & 2) != 0) 1 else K)) : (l += 1) {
      layer(l, a, s);
      if (((KM >> l) & 1) == 1) { a += 1; } else { s += 1; }
    }
    relay(21);
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_xa, .{ .color = @get_color(13) });
  @initialize_queue(q_xb, .{ .color = @get_color(14) });
  @initialize_queue(q_ya, .{ .color = @get_color(17) });
  @initialize_queue(q_yb, .{ .color = @get_color(18) });
  @initialize_queue(q_xm, .{ .color = @get_color(19) });
  @initialize_queue(q_ym, .{ .color = @get_color(20) });
  @initialize_queue(q_xo, .{ .color = C_PARK });
  @initialize_queue(q_yo, .{ .color = C_PARK });
  @initialize_queue(q_ao, .{ .color = C_PARK });
  @export_symbol(w_ptr, "w");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(init);
  @export_symbol(compute);
}
