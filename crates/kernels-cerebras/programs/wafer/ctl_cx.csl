// wafer/ctl_cx.csl: the wafer program row control PE (CX_r). Design and build: README.md.
//
// Role. One a unit row, on the unit's middle column: the row's x chunk (Hc f32), the residuals,
// the RMSNorm gammas, the root of the row reductions (the o_proj / out_proj and down partials of
// the row's weight PEs: both halves merged word by word through a FIFO and taken back over a
// loop-back colour), and the unit handoff of x (in from the unit before, out to the next).
// A layer: x g1 multicast (then x's sum of squares: CY applies the rms scale after the column
// reduction); o reduction in -> x += o; x g2 multicast (+ sum of squares); down reduction in ->
// x += d. The pass ends with x sent on. In the wafer token loop, unit 0's CX rows take the next
// token's embedding chunk (iq6) instead of the host's x after the first step.
//
// Interface. Exports x (f32 [Hc]), gam (f16 [layer][g1 | g2][Hc], the host's 1 + w), xdbg / xred
// (XKEEP 1: x after each layer, each reduction's sum), rcfg, tdbg (always on: the pass start, each
// layer's end, after x out), init, compute(steps, start_pos).
// rcfg: [0] routes n, [1..1+2n); from RQ: [0..4) iq2..iq5, [4..7) oq2..oq4,
// [7] flags (bit 0 the first unit: x from the host; bit 1 no handoff out; bit 2 the embedding
// return of the token loop), [8] the spare colour, [9] iq6.
// Queues: iq2 / iq3 the west / east halves' level-2 streams, oq2 their merge on the loop-back
// colour, iq4 its return; oq3 the row multicast; iq5 / oq4 the handoff in / out; iq6 the token
// loop's embedding chunk.
//
// Params. Shape: K, Hc. Levers (default = the shipped 9B build): SSQL 1, XG16 0 (1: x g in f16,
// TRM 512's form; it flips a near tie on the 9B golden). Diagnostics (default off): XKEEP, DIAG,
// HOSTX (simulator tests: x is the host's, no handoff). FIFOW: the FIFO depth.
param memcpy_params;
param DIAG: u16 = 0;   // 1 (diagnostics): no layers (handoffs, head and I/O only)
param K: u16;          // layers on the unit
param Hc: u16;         // x dims a row
param HOSTX: u16 = 0;  // 1 (simulator tests): x is the host's (memcpy), no handoff
param XG16: u16 = 0;   // 1: f16(x) f16(g) in f16 (TRM 512); 0: x g in f32
param SSQL: u16 = 1;   // 1: x g goes first, the sum of squares (only CY needs it, after the column reduction) last
param XKEEP: u16 = 0;  // 1 (diagnostics): copies of each reduction's sum (xred) and of x after each layer (xdbg)
param FIFOW: u16 = 32; // the reductions' FIFO depth (words)

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const fab = @import_module("ops/fabric.csl", .{ .NQ = 5 });
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const timestamp = @import_module("<time>");
// TSC stamps of the last pass (host-read): the pass start (x in), each layer's end, after x out
var tdbg = @zeros([K + 2]u32);
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }

var x = @zeros([Hc]f32);
var x_ptr: [*]f32 = &x;
var xdbg = @zeros([K * Hc]f32);   // x after each layer of the last pass (diagnostics, host-read)
var xdbg_ptr: [*]f32 = &xdbg;
var xred = @zeros([2 * K * Hc]f32);   // each row reduction's sum of the last pass (diagnostics)
var xred_ptr: [*]f32 = &xred;
fn keep_red(i: u16) void { if (XKEEP == 0) { return; } @fmovs(@set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |j|{2 * K * Hc} -> xred[j] }), @as(i16, i * Hc), f32), Hc), t_d); }
var gam = @zeros([2 * K * Hc]@fp16());   // [layer][g1 | g2], the host's f16 gammas (1 + w)
var gam_ptr: [*]@fp16() = &gam;
var t = @zeros([Hc + 1]f32);             // the merged partial; then the multicast's words
var th = @zeros([Hc]@fp16());
const x_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> x[i] });
const t_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> t[i] });
const t1_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc + 1} -> t[i] });
const th_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> th[i] });
var g_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> gam[i] });

// (queues: see the header)
const q_w = @get_input_queue(2);
const q_e = @get_input_queue(3);
const q_lb = @get_input_queue(4);
const q_hi = @get_input_queue(5);
const q_em = @get_input_queue(6);   // the wafer loop: the next token's embedding chunk (unit 0, flags bit 2)
const q_lo = @get_output_queue(2);
const q_mc = @get_output_queue(3);
const q_ho = @get_output_queue(4);
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
var fifo_buf = @zeros([FIFOW]f32);
const fifo = @allocate_fifo(fifo_buf);

// rcfg: see the header (runtime words, so every unit shares the image)
const NR: u16 = 12;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 10]u32);
var rcfg_ptr: [*]u32 = &rcfg;

fn init() void {
  fab.routes(&rcfg);
  var fq = [5]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]), @as(u16, rcfg[RQ + 3]), @as(u16, rcfg[RQ + 9]) };
  fab.bind_iqs(&fq, @as(u16, rcfg[RQ + 8]));
  fab.oqc(2, rcfg[RQ + 4]); fab.oqc(3, rcfg[RQ + 5]); fab.oqc(4, rcfg[RQ + 6]);
  timestamp.enable_tsc();
  sys_mod.unblock_cmd_stream();
}

// The row reduction's sum into t (both halves at once; the merge comes back over the loop-back).
fn reduce() void {
  @fmovs(fifo, fab.fin(q_e, Hc), .{ .async = true, .ut_id = ut_a });
  @fadds(fab.fout(q_lo, Hc), fab.fin(q_w, Hc), fifo, .{ .async = true, .ut_id = ut_b });
  @fmovs(t_d, fab.fin(q_lb, Hc));
}
// x g (f16) and the sum of squares of x, multicast along the row (Hc + 1 f32 words).
fn norm_send(gi: u16) void {
  var ss: f32 = 0.0;
  var i: u16 = 0;
  if (SSQL == 0) { while (i < Hc) : (i += 1) { const v = x[i]; ss += v * v; } }
  const g = @increment_dsd_offset(g_d, @as(i16, gi * Hc), @fp16());
  if (XG16 == 1) {
    @fs2h(th_d, x_d);
    @fmulh(th_d, th_d, g);
    @fh2s(t_d, th_d);
  } else {
    @fh2s(t_d, g);
    @fmuls(t_d, t_d, x_d);
  }
  if (SSQL == 1) {
    @fmovs(fab.fout(q_mc, Hc), t_d);
    while (i < Hc) : (i += 1) { const v = x[i]; ss += v * v; }
    t[Hc] = ss;
    @fmovs(fab.fout(q_mc, 1), @increment_dsd_offset(@set_dsd_length(t1_d, 1), @as(i16, Hc), f32));
    return;
  }
  t[Hc] = ss;
  @fmovs(fab.fout(q_mc, Hc + 1), t1_d);
}

var n_steps: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var s: u32 = 0;
  while (s < n_steps) : (s += 1) {
    if (HOSTX == 0 and (rcfg[RQ + 7] & 1) == 0) { @fmovs(x_d, fab.fin(q_hi, Hc)); }
    else if (s > 0 and (rcfg[RQ + 7] & 4) != 0) { @fmovs(x_d, fab.fin(q_em, Hc)); }   // the wafer loop's next token
    stamp(0);
    var l: u16 = 0;
    while ((DIAG & 1) == 0 and l < (if ((DIAG & 2) != 0) 1 else K)) : (l += 1) {
      norm_send(2 * l);
      if ((DIAG & 8) == 0) {
      reduce();
      keep_red(2 * l);
      @fadds(x_d, x_d, t_d);
      }
      if ((DIAG & 4) == 0) {
      norm_send(2 * l + 1);
      reduce();
      keep_red(2 * l + 1);
      @fadds(x_d, x_d, t_d);
      }
      if (XKEEP == 1) { @fmovs(@set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{K * Hc} -> xdbg[i] }), @as(i16, l * Hc), f32), Hc), x_d); }
      stamp(l + 1);
    }
    if (HOSTX == 0 and (rcfg[RQ + 7] & 2) == 0) { @fmovs(fab.fout(q_ho, Hc), x_d); }
    stamp(K + 1);
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_w, .{ .color = @get_color(13) });   // parked (distinct a queue)
  @initialize_queue(q_e, .{ .color = @get_color(14) });   // parked (distinct a queue)
  @initialize_queue(q_lb, .{ .color = @get_color(17) });   // parked (distinct a queue)
  @initialize_queue(q_hi, .{ .color = @get_color(18) });   // parked (distinct a queue)
  @initialize_queue(q_em, .{ .color = @get_color(19) });   // parked (distinct a queue)
  @initialize_queue(q_lo, .{ .color = C_PARK });
  @initialize_queue(q_mc, .{ .color = C_PARK });
  @initialize_queue(q_ho, .{ .color = C_PARK });
  @export_symbol(x_ptr, "x");
  @export_symbol(xdbg_ptr, "xdbg");
  @export_symbol(xred_ptr, "xred");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(gam_ptr, "gam");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(init);
  @export_symbol(compute);
}
//@@ dummies
