// wafer/weight_gptoss_moe.csl: the wafer program MoE weight PE for gpt-oss (the unit's east half). Design:
// src/spatial/README.md (gpt-oss).
//
// Role. MoE PE (r, c) holds, for each of the unit's K layers, a slice of all NEX experts (its row's x chunk,
// Hc dims, by its column's Ic intermediate dims) and router output (c mod NEX) over its x chunk, and runs:
//   (the attention half's x passes this row's multicast: read and dropped)
//   x2_r' (Hc), 2^S_r, ssq_r        <- CX_r
//   router partial (f32: f32 x, f32 weights) x 2^S_r, ssq_r -> column reduction into CY_c (ctl_cy_gptoss_moe)
//   [e_0..e_3 | w_0..w_3]           <- CY_c (the token's experts and route weights)
//   gate|up of each expert (f16 x, the E5M2 tile decoded, f16 accumulation) x 2^S_r -> column reduction
//   act' (TK x Ic: act x w_k x 2^Pd_k, f16)  <- CY_c
//   down (the TK decoded tiles, one matvec of TK Ic rows: the experts summed in the f16 accumulator) |
//   [e | w] (column RW only: CX's down biases) -> row reduction into CX_r (the east half)
// Experts are FP8 E5M2 (the high byte of the f16), the exact MXFP4 values times 2^-P (one power of two a
// layer / expert / matrix; CY applies it). A u16 holds two: gate|up rows i < Hc/2 in the high bytes, rows
// Hc/2.. in the low (one 2 Ic row each, gate then up); down rows i < Ic/2 high, the rest low (Hc each).
// A decode is two 16-bit ops a tile (and 0xff00, shift left 8).
//
// Interface. Exports wx (u16: per layer, per expert [gate|up Hc/2 x 2Ic][down Ic/2 x Hc]), wr (f32: per
// layer the router tile Hc), rcfg, tdbg, init, compute(steps, start_pos). rcfg as weight_gptoss_att.csl,
// [11] = 1 on the column that carries [e | w] to CX. Queues and hardware rules: as weight_qwen.csl.
//
// Params. Shape: K, Hc, Ic, NEX (32), TK (4). Diagnostics: TSTAMP, DIAG. FIFOW.
param memcpy_params;
param DIAG: u16 = 0;
param K: u16;
param Hc: u16;
param Ic: u16;
param NEX: u16 = 32;
param TK: u16 = 4;
param TSTAMP: u16 = 0;
param FIFOW: u16 = 32;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const NTD: u16 = 1 + 4 * K;
const timestamp = @import_module("<time>");
var tdbg = @zeros([if (TSTAMP == 1) NTD else 1]u32);
var tdbg_ptr: [*]u32 = &tdbg;
var tsc = @zeros([3]u16);
fn stamp(i: u16) void { if (TSTAMP == 0) { return; } timestamp.get_timestamp(&tsc); tdbg[i] = @as(u32, tsc[0]) | (@as(u32, tsc[1]) << 16); }
fn mx(a: u16, b: u16) u16 { return if (a > b) a else b; }

const XG: u16 = (Hc / 2) * 2 * Ic;   // u16 words of an expert's gate|up
const XD: u16 = (Ic / 2) * Hc;       // ... of its down
const XE: u16 = XG + XD;
var wx = @zeros([K * NEX * XE]u16);
var wx_ptr: [*]u16 = &wx;
var wr = @zeros([K * Hc]f32);
var wr_ptr: [*]f32 = &wr;

const XN: u16 = mx(Hc, TK * Ic);
const YN: u16 = mx(2 * TK * Ic, Hc + 2 * TK);
var xh = @zeros([XN]@fp16());
var xf = @zeros([Hc + 2]f32);       // x' in f32 (the router), 2^S_r, ssq_r
var y: [YN]f32 align(16) = @zeros([YN]f32);
var y16 = @zeros([mx(2 * Ic, Hc)]@fp16());
const DN: u16 = mx(Hc * 2 * Ic, TK * Ic * Hc);
var dec: [DN]@fp16() align(16) = @zeros([DN]@fp16());
const xh_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XN} -> xh[i] });
const xf_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc + 2} -> xf[i] });
const y_d0 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{YN} -> y[i] });
const y16_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{mx(2 * Ic, Hc)} -> y16[i] });
const dec_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DN} -> dec[i] });
const wx_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XG} -> wx[i] });
fn yv(o: u16, n: u16) mem1d_dsd { return @set_dsd_length(@increment_dsd_offset(y_d0, @as(i16, o), f32), n); }
var rt = @zeros([2 * TK]f32);
const rt_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * TK} -> rt[i] });

// ---------------------------------------------------------------- fabric (as weight_gptoss_att.csl)
const q_xa = @get_input_queue(2);
const q_xb = @get_input_queue(3);
const q_ya = @get_input_queue(4);
const q_yb = @get_input_queue(5);
const q_xm = @get_input_queue(6);
const q_ym = @get_input_queue(7);
const q_xo = @get_output_queue(5);
const q_yo = @get_output_queue(3);
const q_ao = @get_output_queue(4);
const C_PARK: color = @get_color(16);
const ut_a = @get_ut_id(4);
const ut_b = @get_ut_id(5);
const ut_xa = @get_ut_id(2);
const ut_xb = @get_ut_id(3);
var fifo_buf = @zeros([FIFOW]f32);
const fifo = @allocate_fifo(fifo_buf);
var fifo_xbuf = @zeros([FIFOW]f32);
const fifo_x = @allocate_fifo(fifo_xbuf);
fn fout(comptime q: output_queue, n: u16) fabout_dsd {
  return @set_dsd_length(@get_dsd(fabout_dsd, .{ .extent = 1, .output_queue = q }), n);
}
fn fin(comptime q: input_queue, n: u16) fabin_dsd {
  return @set_dsd_length(@get_dsd(fabin_dsd, .{ .extent = 1, .input_queue = q }), n);
}
const NR: u16 = 16;
const RQ: u16 = 1 + 2 * NR;
var rcfg = @zeros([RQ + 26]u32);
var rcfg_ptr: [*]u32 = &rcfg;
var role_x: u16 = 0;
var role_y: u16 = 0;
var rwc: u16 = 0;
fn iqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.input_queue_config.get_input_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.input_queue_config.in_queue_addr_range);
  @set_config(addr, (v & 0xffe0) | @as(u16, c), tile_config.input_queue_config.in_queue_addr_range);
}
fn oqc(comptime qid: u16, c: u32) void {
  const addr = tile_config.output_queue_config.get_output_queue_config_addr(qid);
  const v: u16 = @get_config(addr, tile_config.output_queue_config.out_queue_addr_range);
  @set_config(addr, (v & 0xfe0f) | (@as(u16, c) << 4), tile_config.output_queue_config.out_queue_addr_range);
}
var qcur = [6]u16 { 13, 14, 17, 18, 19, 20 };
fn iq_any(q: u16, c: u16) void {
  if (q == 0) { iqc(2, c); }
  else if (q == 1) { iqc(3, c); }
  else if (q == 2) { iqc(4, c); }
  else if (q == 3) { iqc(5, c); }
  else if (q == 4) { iqc(6, c); }
  else if (q == 5) { iqc(7, c); }
}
fn bind_iqs(fq: *[6]u16, tmp: u16) void {
  var done = @zeros([6]u16);
  var left: u16 = 6;
  var guard: u16 = 0;
  while (left > 0 and guard < 32) : (guard += 1) {
    var prog = false;
    var i: u16 = 0;
    while (i < 6) : (i += 1) {
      if (done[i] != 0) { continue; }
      var clash = false;
      var j: u16 = 0;
      while (j < 6) : (j += 1) { if (j != i and done[j] == 0 and qcur[j] == fq.*[i]) { clash = true; } }
      if (!clash) { iq_any(i, fq.*[i]); qcur[i] = fq.*[i]; done[i] = 1; left -= 1; prog = true; }
    }
    if (!prog) {
      i = 0;
      while (i < 6 and done[i] != 0) : (i += 1) {}
      iq_any(i, tmp); qcur[i] = tmp;
    }
  }
}
fn init() void {
  const cc0 = color_config.get_color_config_addr(@get_color(0));
  var k: u16 = 0;
  while (k < @as(u16, rcfg[0])) : (k += 1) {
    const addr = cc0 + @as(u16, rcfg[1 + 2 * k]);
    const r = @get_config(addr, tgt.color_addr_range) & 0xff00;
    @set_config(addr, r | @as(u16, rcfg[2 + 2 * k]), tgt.color_addr_range);
  }
  var fq = [6]u16 { @as(u16, rcfg[RQ]), @as(u16, rcfg[RQ + 1]), @as(u16, rcfg[RQ + 2]), @as(u16, rcfg[RQ + 3]), @as(u16, rcfg[RQ + 4]), @as(u16, rcfg[RQ + 5]) };
  bind_iqs(&fq, @as(u16, rcfg[RQ + 24]));
  oqc(5, rcfg[RQ + 6]);
  oqc(3, rcfg[RQ + 7]);
  role_x = @as(u16, rcfg[RQ + 8]);
  role_y = @as(u16, rcfg[RQ + 9]);
  rwc = @as(u16, rcfg[RQ + 11]);
  timestamp.enable_tsc();
  sys_mod.unblock_cmd_stream();
}
fn send_x(n: u16) void {
  const d = yv(0, n);
  const A = .{ .async = true, .ut_id = ut_xb };
  if (role_x == 0) { @fmovs(fout(q_xo, n), d, A); }
  else if (role_x == 2) {
    @fadds(fifo_x, fin(q_xa, n), d, .{ .async = true, .ut_id = ut_xa });
    @fadds(fout(q_xo, n), fin(q_xb, n), fifo_x, A);
  } else { @fadds(fout(q_xo, n), fin(q_xa, n), d, A); }
}
fn send_y(n: u16) void {
  const d = yv(0, n);
  const A = .{ .async = true, .ut_id = ut_b };
  if (role_y == 0) { @fmovs(fout(q_yo, n), d, A); }
  else if (role_y == 2) {
    @fadds(fifo, fin(q_ya, n), d, .{ .async = true, .ut_id = ut_a });
    @fadds(fout(q_yo, n), fin(q_yb, n), fifo, A);
  } else { @fadds(fout(q_yo, n), fin(q_ya, n), d, A); }
}

// ---------------------------------------------------------------- matvecs
const mv_dest = @get_dsr(dsr_dest, 1);
const mv_src0 = @get_dsr(dsr_src0, 1);
const mv_src1 = @get_dsr(dsr_src1, 1);
fn mvh_step(xv: @fp16()) void { @fmach(mv_dest, mv_src0, mv_src1, xv); }
// y16[0..N) = dec (R rows of N) x xh[xo..xo+R), f16 accumulation
fn mvd(R: u16, N: u16, xo: u16) void {
  const yh = @set_dsd_length(y16_d, N);
  @fmovh(yh, @as(@fp16(), 0.0));
  @load_to_dsr(mv_dest, yh, .{ .save_address = false });
  @load_to_dsr(mv_src0, yh, .{ .save_address = false });
  @load_to_dsr(mv_src1, @set_dsd_length(dec_d, N), .{ .save_address = true });
  @map(mvh_step, @set_dsd_length(@increment_dsd_offset(xh_d, @as(i16, xo), @fp16()), R));
}
// decode n u16 words at wx[o] into dec[d0..d0 + 2n): high bytes, then low bytes
fn dec2(o: u16, n: u16, d0: u16) void {
  const src = @set_dsd_length(@set_dsd_base_addr(wx_d, @ptrcast([*]u16, &wx[o])), n);
  const lo = @set_dsd_length(@increment_dsd_offset(dec_d, @as(i16, d0), @fp16()), n);
  @and16(lo, src, @as(u16, 0xff00));
  @sll16(@increment_dsd_offset(lo, @as(i16, n), @fp16()), src, 8);
}
// router: y[0] = x'_f32 . wr (f32), then the gate|up of the TK experts
var racc = @zeros([1]f32);
fn rstep(xv: f32, wv: f32) void { racc[0] += xv * wv; }
fn moe(l: u16) void {
  const xb = l * NEX * XE;
  var k: u16 = 0;
  while (k < TK) : (k += 1) {
    const e = @as(u16, rt[k]);
    dec2(xb + e * XE, XG, 0);
    mvd(Hc, 2 * Ic, 0);
    @fh2s(yv(k * 2 * Ic, 2 * Ic), @set_dsd_length(y16_d, 2 * Ic));
  }
  @fmuls(yv(0, 2 * TK * Ic), yv(0, 2 * TK * Ic), xf[Hc]);
  send_y(2 * TK * Ic);
  stamp(3 + 4 * l);
  @fs2h(@set_dsd_length(xh_d, TK * Ic), fin(q_ym, TK * Ic));
  k = 0;
  while (k < TK) : (k += 1) {
    const e = @as(u16, rt[k]);
    dec2(xb + e * XE + XG, XD, k * Ic * Hc);
  }
  mvd(TK * Ic, Hc, 0);
  @fh2s(yv(0, Hc), @set_dsd_length(y16_d, Hc));
  if (rwc == 1) { @fmovs(yv(Hc, 2 * TK), rt_d); } else { @fmovs(yv(Hc, 2 * TK), 0.0); }
  send_x(Hc + 2 * TK);
}

fn layer(l: u16) void {
  // the attention half's x: not this half's
  @fmovs(@set_dsd_length(xf_d, Hc + 2), fin(q_xm, Hc + 2));
  stamp(1 + 4 * l);
  if ((DIAG & 4) != 0) { return; }
  @fmovs(xf_d, fin(q_xm, Hc + 2));
  @fs2h(@set_dsd_length(xh_d, Hc), @set_dsd_length(xf_d, Hc));
  racc[0] = 0.0;
  @map(rstep, @set_dsd_length(xf_d, Hc), @set_dsd_length(@set_dsd_base_addr(xf_d, @ptrcast([*]f32, &wr[l * Hc])), Hc));
  y[0] = racc[0] * xf[Hc];
  y[1] = xf[Hc + 1];
  send_y(2);
  @fmovs(rt_d, fin(q_ym, 2 * TK));
  stamp(2 + 4 * l);
  moe(l);
  stamp(4 + 4 * l);
}

fn qmode0() void { iqc(6, rcfg[RQ + 4]); iqc(7, rcfg[RQ + 5]); }
fn relay(o: u16) void {
  const n = @as(u16, rcfg[RQ + o]);
  if (n == 0) { return; }
  while ((tile_config.output_queue_status.get_raw() & 0x1000) == 0) {}
  iqc(6, rcfg[RQ + o + 1]);
  oqc(4, rcfg[RQ + o + 2]);
  @fmovs(fout(q_ao, n), fin(q_xm, n));
  while ((tile_config.output_queue_status.get_raw() & 0x1000) == 0) {}
  qmode0();
}

var n_steps: u32 = 0;
const pass_id: local_task_id = @get_local_task_id(8);
task pass_task() void {
  var i: u32 = 0;
  while (i < n_steps) : (i += 1) {
    if (i > 0 or (rcfg[RQ + 25] & 1) == 0) { relay(18); }   // (bit 0: the pass-start relay is the token loop's embedding: none before step 1)
    stamp(0);
    var l: u16 = 0;
    while ((DIAG & 1) == 0 and l < (if ((DIAG & 2) != 0) 1 else K)) : (l += 1) { layer(l); }
    relay(21);
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void {
  n_steps = steps;
  @activate(pass_id);
}

comptime {
  @bind_local_task(pass_task, pass_id);
  @initialize_queue(q_xa, .{ .color = @get_color(13) });
  @initialize_queue(q_xb, .{ .color = @get_color(14) });
  @initialize_queue(q_ya, .{ .color = @get_color(17) });
  @initialize_queue(q_yb, .{ .color = @get_color(18) });
  @initialize_queue(q_xm, .{ .color = @get_color(19) });
  @initialize_queue(q_ym, .{ .color = @get_color(20) });
  @initialize_queue(q_xo, .{ .color = C_PARK });
  @initialize_queue(q_yo, .{ .color = C_PARK });
  @initialize_queue(q_ao, .{ .color = C_PARK });
  @export_symbol(wx_ptr, "wx");
  @export_symbol(wr_ptr, "wr");
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(tdbg_ptr, "tdbg");
  @export_symbol(init);
  @export_symbol(compute);
}
//@@ dummies
