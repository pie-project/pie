// wafer/ops/cy_gdn.csl: a column control PE's Gated DeltaNet phases (README.md; the weight PEs' side:
// ops/gdn.csl). rms scale; conv1d (CONV taps, the window a ring) and SiLU on the column's q / k
// channels, multicast [k | q | decay | reset]; then (off the path) v / z / beta and the decay
// -exp(A) softplus(a + dt); from the state reduction delta = (v - S^T k / |k|) beta and
// o = (S^T q + delta (k.q) / |k|) / |q| (q pre-scaled by 1/sqrt(HK)); the gated RMSNorm (sums over
// the v head's columns by the control row's segment all-reduce) times silu(z); multicast
// [o | delta / |k| | decay].
//
// Interface: cw (conv weights [layer][CONV][channel]), gpar ([A, dt] a layer), gnw (the gated norm's
// weights [layer][DV]).
//
// Params: pe (ops/cpe.csl), act (ops/act.csl), math (ops/math.csl), NL (GDN layers on the unit),
// NQG (the reduction's words before ssq: DK q | DK k | DV v | DV z | b | a), DK / DV (q / k, v dims a
// column), CONV (the conv kernel), HK / HV (the head's k / v dims: q's scale, the gated norm's mean),
// CONVQK (1: q / k's conv and SiLU before the multicast, v / z / beta after it, the window a ring),
// GDEC (1: the decay scales the state reduction's sums here).
param pe: imported_module;
param act: imported_module;
param math: imported_module;
param NL: u16;
param NQG: u16;
param DK: u16;
param DV: u16;
param CONV: u16;
param HK: u16 = 128;
param HV: u16 = 128;
param CONVQK: u16 = 1;
param GDEC: u16 = 1;

fn mx(a: u16, b: u16) u16 { return if (a > b) a else b; }
const NCH: u16 = 2 * DK + DV;              // conv channels a column
const L2EPS: f32 = 1.0e-6;                 // q / k's l2 norms
const NW: u16 = if (NL > 0) NL * (CONV - 1) * NCH else 1;
var cwin = @zeros([NW]f32);
var cw = @zeros([if (NL > 0) NL * CONV * NCH else 1]f32);
var gpar = @zeros([if (NL > 0) NL * 2 else 1]f32);
var gnw = @zeros([if (NL > 0) NL * DV else 1]f32);
var vz = @zeros([2 * mx(DV, 1)]f32);       // v | z (one SiLU pass over both)
const vz_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * mx(DV, 1)} -> vz[i] });
var gsc = @zeros([4]f32);                  // the norms' scalars ([2..]: the segment all-reduce's)
var gdec: f32 = 1.0;
var wp: u16 = 0;                           // the conv window's oldest row

fn init() void {
  var g: u16 = 0;
  while (CONVQK == 1 and g < NL) : (g += 1) { gpar[2 * g] = -math.exp1(gpar[2 * g]); }
}
// A pass's start: a new sequence restarts the conv windows (the weight PEs reset their state on u[2 DK + 1]).
fn pass_start() void {
  if (pe.tab[0] == 0) {
    @fmovs(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NW} -> cwin[i] }), 0.0);
    wp = 0;
  }
}
fn pass_end() void {
  if (CONVQK == 1) { wp = if (wp + 1 >= CONV - 1) 0 else wp + 1; }
}

// conv1d (CONV taps) over channels [o, o + n): u[o..) = the window's taps and t's new value; the
// window is a ring (row wp the oldest, wp advancing once a pass): the new raw value replaces the oldest
fn conv(g: u16, o: u16, n: u16) void {
  const wb = g * (CONV - 1) * NCH;
  const cwb = g * CONV * NCH;
  const cwd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cw[i] });
  const cwn = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cwin[i] });
  const acc = @set_dsd_length(act.va_d, n);
  const cv = pe.uv(o, n);
  @fmuls(cv, pe.tv(o, n), @set_dsd_length(@increment_dsd_offset(cwd, @as(i16, cwb + (CONV - 1) * NCH + o), f32), n));
  var j: u16 = 0;
  while (j < CONV - 1) : (j += 1) {
    var r = wp + j;
    if (r >= CONV - 1) { r -= CONV - 1; }
    @fmuls(acc, @set_dsd_length(@increment_dsd_offset(cwn, @as(i16, wb + r * NCH + o), f32), n),
           @set_dsd_length(@increment_dsd_offset(cwd, @as(i16, cwb + j * NCH + o), f32), n));
    @fadds(cv, cv, acc);
  }
  @fmovs(@set_dsd_length(@increment_dsd_offset(cwn, @as(i16, wb + wp * NCH + o), f32), n), pe.tv(o, n));
}
fn pre0(g: u16) f32 {
  const N = NQG + 1;
  pe.reduce(N);
  pe.stamp(1 + 6 * pe.cl + 0);
  const rr = math.rsqrt(pe.t[NQG] / pe.HID + pe.EPS);
  @fmuls(pe.tv(0, NQG), pe.tv(0, NQG), rr);
  // conv1d over the window and the new value (vector ops over the column's channels), SiLU
  const wb = g * (CONV - 1) * NCH;
  const cwb = g * CONV * NCH;
  const cwd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cw[i] });
  const cwn = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> cwin[i] });
  const acc = @set_dsd_length(act.va_d, NCH);   // (vsilu's e: the product lands in u first)
  const cv = pe.uv(0, NCH);
  @fmuls(cv, pe.tv(0, NCH), @increment_dsd_offset(cwd, @as(i16, cwb + (CONV - 1) * NCH), f32));
  var j: u16 = 0;
  while (j < CONV - 1) : (j += 1) {
    @fmuls(acc, @increment_dsd_offset(cwn, @as(i16, wb + j * NCH), f32), @increment_dsd_offset(cwd, @as(i16, cwb + j * NCH), f32));
    @fadds(cv, cv, acc);
  }
  j = 0;
  while (j + 1 < CONV - 1) : (j += 1) {
    @fmovs(@increment_dsd_offset(cwn, @as(i16, wb + j * NCH), f32), @increment_dsd_offset(cwn, @as(i16, wb + (j + 1) * NCH), f32));
  }
  @fmovs(@increment_dsd_offset(cwn, @as(i16, wb + (CONV - 2) * NCH), f32), pe.tv(0, NCH));
  act.vsilu(pe.tv(0, NCH), cv, NCH);
  // gates
  const bt = math.sigm(pe.t[2 * DK + 2 * DV]);
  const dec = math.exp1(-math.exp1(gpar[2 * g]) * math.softplus(pe.t[2 * DK + 2 * DV + 1] + gpar[2 * g + 1]));
  gdec = dec;
  @fmovs(pe.uv(0, DK), pe.tv(DK, DK));          // k
  @fmovs(pe.uv(DK, DK), pe.tv(0, DK));          // q
  pe.u[2 * DK] = dec;
  pe.u[2 * DK + 1] = if (pe.tab[0] == 0) 1.0 else 0.0;
  @fmovs(@set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[i] }), DV), pe.tv(2 * DK, DV));
  @fmovs(@set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[@as(i16, DV) + i] }), DV), pe.tv(2 * DK + DV, DV));
  pe.mcast(2 * DK + 2);
  pe.stamp(1 + 6 * pe.cl + 1);
  const zd = @set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[@as(i16, DV) + i] }), DV);
  act.vsilu(pe.uv(0, DV), zd, DV);                // silu(z) while the weight PEs work
  @fmovs(zd, pe.uv(0, DV));
  return bt;
}
fn pre1(g: u16) f32 {
  const N = NQG + 1;
  pe.reduce(N);
  pe.stamp(1 + 6 * pe.cl + 0);
  const rr = math.rsqrt(pe.t[NQG] / pe.HID + pe.EPS);
  // on the path to the multicast: q / k's rms scale, conv and SiLU, the decay (v, z, beta after it)
  @fmuls(pe.tv(0, 2 * DK), pe.tv(0, 2 * DK), rr);
  conv(g, 0, 2 * DK);
  act.vsil(pe.tv(0, 2 * DK), pe.uv(0, 2 * DK), 2 * DK);
  if (GDEC == 0) { gdec = math.exp1(gpar[2 * g] * math.softplus(pe.t[2 * DK + 2 * DV + 1] * rr + gpar[2 * g + 1])); }   // gpar[2 g] = -exp(A) (init)
  @fmovs(pe.uv(0, DK), pe.tv(DK, DK));          // k
  @fmovs(pe.uv(DK, DK), pe.tv(0, DK));          // q
  pe.u[2 * DK] = if (GDEC == 0) gdec else 0.0;
  pe.u[2 * DK + 1] = if (pe.tab[0] == 0) 1.0 else 0.0;   // position 0: the weight PEs zero this layer's state
  pe.mcast(2 * DK + 2);
  pe.stamp(1 + 6 * pe.cl + 1);
  if (GDEC == 1) { gdec = math.exp1(gpar[2 * g] * math.softplus(pe.t[2 * DK + 2 * DV + 1] * rr + gpar[2 * g + 1])); }   // (off the path: see post)
  @fmuls(pe.tv(2 * DK, NQG - 2 * DK), pe.tv(2 * DK, NQG - 2 * DK), rr);
  conv(g, 2 * DK, DV);
  // conv(v) | z side by side in u, one SiLU pass into v | z
  @fmovs(pe.uv(2 * DK + DV, DV), pe.tv(2 * DK + DV, DV));
  act.vsil(vz_d, pe.uv(2 * DK, 2 * DV), 2 * DV);
  const bt = math.sigm(pe.t[2 * DK + 2 * DV]);
  return bt;
}
// GDEC 1: the weight PEs send S^T k / S^T q of the undecayed state; the decay scales the sums here and
// rides at the end of the second multicast for the state update (S = dec S + k delta / |k|)
fn post(g: u16, bt: f32) void {
  const zd = @set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[@as(i16, DV) + i] }), DV);
  // the state reduction: S^T k | S^T q | k^2 | q^2 | k.q
  pe.reduce(2 * DV + 3);
  pe.stamp(1 + 6 * pe.cl + 2);
  if (GDEC == 1) { @fmuls(pe.tv(0, 2 * DV), pe.tv(0, 2 * DV), gdec); }
  const ik = math.rsqrt(pe.t[2 * DV] + L2EPS);
  const iq0 = math.rsqrt(pe.t[2 * DV + 1] + L2EPS);
  const kq = pe.t[2 * DV + 2] * ik * iq0;
  const iq = iq0 * math.rsqrt(@as(f32, HK));
  const vsd = @set_dsd_length(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> vz[i] }), DV);
  const dl = pe.uv(DV, DV);
  const o = pe.uv(0, DV);
  @fmuls(dl, pe.tv(0, DV), ik);
  @fsubs(dl, vsd, dl);
  @fmuls(dl, dl, bt);                      // delta
  @fmuls(o, pe.tv(DV, DV), iq);
  @fmacs(o, o, dl, kq * math.rsqrt(@as(f32, HK)));
  @fmuls(dl, dl, ik);                      // delta / |k| (the state update's)
  var ss: f32 = 0.0;
  var i: u16 = 0;
  while (i < DV) : (i += 1) { const v = pe.u[i]; ss += v * v; }
  gsc[2] = ss;
  pe.seg_ar(@set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{4} -> gsc[i] }), 2, f32), 1), 1);
  const on = math.rsqrt(gsc[2] / @as(f32, HV) + pe.EPS);
  @fmuls(o, o, on);
  @fmuls(o, o, @set_dsd_length(@increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV} -> gnw[i] }), @as(i16, g * DV), f32), DV));
  @fmuls(o, o, zd);
  pe.u[2 * DV] = gdec;
  pe.mcast(2 * DV + GDEC);
  pe.stamp(1 + 6 * pe.cl + 3);
}
// GDN layer g (of the unit's GDN layers)
fn layer(g: u16) void {
  const bt = if (CONVQK == 1) pre1(g) else pre0(g);
  post(g, bt);
}
