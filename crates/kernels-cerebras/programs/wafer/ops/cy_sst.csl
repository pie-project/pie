// wafer/ops/cy_sst.csl: P8 (GENERIC.md §3.1, G1), a state column's root: a head's gated delta
// rule a step (the PEs' side: ops/sst.csl). The head root's row [q | k | v | b | a] (the head's
// raw q / k channels DK each, its v channels DV, its beta and decay logits) in:
//   the short causal conv of each channel over its last CONV rows (the history the root keeps,
//   cleared at a sequence's first step) and its SiLU; q and k l2-normed, q times 1/sqrt(DK);
//   beta = sigmoid(b), decay = exp(-exp(A) softplus(a + dt));
//   [decay k | decay q | k] down the column; their partials over the state before the step up
//   its chain; delta = beta (v - decay Sᵀk); o = decay Sᵀq + (k . q) delta (the state after the
//   step read at q); [delta | decay a key] down the column for its update (ops/sst.csl's one
//   form, the decay a head here); o out.
//
// Interface: cw ([3 DK? channels][CONV] the conv's taps, the oldest row's first, then A, dt), the
// host's; the conv's history the root's own.
//
// SLOTS: a conv history a lane slot (row t of a step steps slot rowp[3 t + 1], cleared first at
// its position 0).
//
// Params: fab (ops/fabric.csl), math (ops/math.csl), YO (the column multicast's output queue),
// IN (the chain's input queue), DK, DV, CONV, SLOTS, ROWS.
param fab: imported_module;
param math: imported_module;
param YO: output_queue;
param IN: input_queue;
param DK: u16;
param DV: u16;
param CONV: u16 = 4;
param SLOTS: u16 = 1;
param ROWS: u16 = 1;

const NCH: u16 = 2 * DK + DV;
const L2EPS: f32 = 1.0e-6;
var cw = @zeros([NCH * CONV + 2]f32);
const HW: u16 = (CONV - 1) * NCH;
var hist = @zeros([SLOTS * HW]f32);
var rowp = @zeros([3 * ROWS]u32);
var hb: u16 = 0;
var y = @zeros([NCH]f32);
var sk: [2 * DV]f32 align(16) = @zeros([2 * DV]f32);
var dd: [DV + DK]f32 align(16) = @zeros([DV + DK]f32);
var kt: [2 * DK]f32 align(16) = @zeros([2 * DK]f32);
const y_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NCH} -> y[i] });
const sk_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * DV} -> sk[i] });
const dd_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{DV + DK} -> dd[i] });
const kt_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2 * DK} -> kt[i] });

// A sequence's first step: the conv's history cleared.
fn init() void { clear(0); }

fn clear(s: u16) void {
  var e: u16 = 0;
  while (e < HW) : (e += 1) { hist[s * HW + e] = 0.0; }
}

// Row t of a step: its slot's history (cleared at its position 0), the step.
fn row(t: u16, x: [*]f32, o: [*]f32) void {
  const s = @as(u16, rowp[3 * t + 1]);
  if (rowp[3 * t + 2] == 0) { clear(s); }
  hb = s * HW;
  step(x, o);
  hb = 0;
}

// One step: x [q | k | v | b | a] (NCH + 2 f32) in, o (DV f32) out.
fn step(x: [*]f32, o: [*]f32) void {
  // the conv over the history (oldest first) and this row, its SiLU; the history shifted
  var c: u16 = 0;
  while (c < NCH) : (c += 1) {
    var acc: f32 = cw[c * CONV + CONV - 1] * x[c];
    var j: u16 = 0;
    while (j < CONV - 1) : (j += 1) { acc += cw[c * CONV + j] * hist[hb + j * NCH + c]; }
    j = 0;
    while (j + 1 < CONV - 1) : (j += 1) { hist[hb + j * NCH + c] = hist[hb + (j + 1) * NCH + c]; }
    hist[hb + (CONV - 2) * NCH + c] = x[c];
    y[c] = math.silu(acc);
  }
  // q, k l2-normed; q scaled
  var qq: f32 = 0.0;
  var kk: f32 = 0.0;
  var i: u16 = 0;
  while (i < DK) : (i += 1) { qq += y[i] * y[i]; kk += y[DK + i] * y[DK + i]; }
  const rq = math.rsqrt(qq + L2EPS) * math.rsqrt(@as(f32, DK));
  const rk = math.rsqrt(kk + L2EPS);
  i = 0;
  var kq: f32 = 0.0;
  while (i < DK) : (i += 1) { y[i] *= rq; y[DK + i] *= rk; kq += y[i] * y[DK + i]; }
  const beta = math.sigm(x[NCH]);
  const decay = math.exp1(-math.exp1(cw[NCH * CONV]) * math.softplus(x[NCH + 1] + cw[NCH * CONV + 1]));
  // [decay k | decay q | k] down, [Σ decay k_i S_i | Σ decay q_i S_i] up
  const kk_d = @increment_dsd_offset(@set_dsd_length(y_d, DK), @as(i16, DK), f32);
  @fmuls(@set_dsd_length(kt_d, DK), kk_d, decay);
  @fmuls(@increment_dsd_offset(@set_dsd_length(kt_d, DK), @as(i16, DK), f32), @set_dsd_length(y_d, DK), decay);
  @fmovs(fab.fout(YO, 2 * DK), kt_d);
  @fmovs(fab.fout(YO, DK), kk_d);
  @fmovs(sk_d, fab.fin(IN, 2 * DV));
  i = 0;
  while (i < DV) : (i += 1) {
    const d = beta * (y[2 * DK + i] - sk[i]);
    dd[i] = d;
    o[i] = sk[DV + i] + kq * d;
  }
  i = 0;
  while (i < DK) : (i += 1) { dd[DV + i] = decay; }
  @fmovs(fab.fout(YO, DV + DK), dd_d);
}
