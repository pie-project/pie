// wafer/ops/cy_moe.csl: a column control PE's routed-experts phases (README.md, gpt-oss; the weight
// PEs' side: ops/moe.csl), a MoE half's column. A layer:
//   router reduction [partial | ssq] -> logit c mod NEX = partial x rsqrt(ssq / HR + eps) + bias, f32 end to
//   end; a NEX-column segment all-reduce on the control row gathers the NEX logits (each segment holds every
//   router output once, summed over the same rows in the same order: every CY gets the same logits); the
//   top TK (one pass; ties to the lower expert, as a stable sort), softmax over the TK selected logits ->
//   multicast [e_0..3 | w_0..3]
//   gate|up reduction (TK x [gate Ic | up Ic]) -> x 2^Pg[e] rsqrt, + biases, gate <= limit, up in
//   [-limit, limit], act = (up + 1) gate sigmoid(alpha gate), x w_k 2^Pd[e] -> multicast act' (TK Ic)
//
// Interface: rb (f32 [layer] the router bias of this column's output), gb (f32 [layer][NEX][2 Ic] gate |
// up biases), ps (f32 [layer][NEX][2]: 2^Pg, 2^Pd); this column's router output is the core's word (a
// runtime role).
//
// Params: pe (ops/cpe.csl), fab, math (ops/math.csl), ON (false: another mixer kind's unit), K, Ic,
// NEX, TK, SWL (limit 7), SWA (alpha 1.702), GLUV (1: glu = max(g, g e) / (1 + e), e = exp(-SWA |g|),
// the reciprocal by a quadratic and two Newton steps (ops/act.csl vsiluq's arithmetic) as vector ops;
// 0: e = exp(-SWA g), a scalar recip a word).
param pe: imported_module;
param fab: imported_module;
param math: imported_module;
param ON: bool = true;
param K: u16;
param Ic: u16;
param NEX: u16 = 32;
param TK: u16 = 4;
param SWL: f32 = 7.0;
param SWA: f32 = 1.702;
param GLUV: u16 = 0;

fn fmax(a: f32, b: f32) f32 { return if (b > a) b else a; }
const G2: u16 = 2 * Ic;
const TN: u16 = TK * G2;
const XN: u16 = if (ON) NEX else 8;
const AN: u16 = if (ON) TK * Ic else 1;
var g = @zeros([XN]f32);
var h = @zeros([XN]f32);
var t1 = @zeros([XN / 2]f32);
var t2 = @zeros([XN / 4]f32);
var t3 = @zeros([XN / 8]f32);
const g_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XN} -> g[i] });
const h_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{XN} -> h[i] });
// d[0..n) = max(s[2 j], s[2 j + 1])
fn pmax(d: [*]f32, s: [*]f32, n: u16) void {
  const sd = @set_dsd_stride(@set_dsd_length(@set_dsd_base_addr(h_d, s), n), 2);
  @fmaxs(@set_dsd_length(@set_dsd_base_addr(h_d, d), n), sd, @increment_dsd_offset(sd, 1, f32));
}
var rb = @zeros([if (ON) K else 1]f32);
var gb = @zeros([if (ON) K * NEX * G2 else 1]f32);
const gb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{if (ON) G2 else 1} -> gb[i] });
var ps = @zeros([if (ON) K * NEX * 2 else 1]f32);
var sel = @zeros([TK]u16);
var wsel = @zeros([TK]f32);
var vb: [AN]f32 align(16) = @zeros([AN]f32);
var vk = @zeros([AN]u16);
const vb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{AN} -> vb[i] });
const vk_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{AN} -> vk[i] });
var sg: [AN]f32 align(16) = @zeros([AN]f32);
var rg: [AN]f32 align(16) = @zeros([AN]f32);
const rg_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{AN} -> rg[i] });
const sg_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{AN} -> sg[i] });
var vpl = vk_d;
var eh_d = vk_d;
fn init() void {
  vpl = @set_dsd_stride(@set_dsd_base_addr(vk_d, @ptrcast([*]u16, &vb)), 2);
  eh_d = @increment_dsd_offset(@set_dsd_stride(@set_dsd_base_addr(vk_d, @ptrcast([*]u16, &pe.t)), 2), 1, u16);   // t's high halves
}
// buf = exp(buf) (n words; exp_fast's form; p in vb, k's bits in vk)
fn vexp(buf: mem1d_dsd, n: u16) void {
  const p = @set_dsd_length(vb_d, n);
  const kk = @set_dsd_length(vk_d, n);
  const pl = @set_dsd_length(vpl, n);
  math.vexp(buf, p, kk, pl, 88.0, true);
}

fn layer(l: u16) void {
  pe.reduce(2);
  pe.stamp(1 + 3 * l);
  const rr = math.rsqrt(pe.t[1] / pe.HID + pe.EPS);
  @fmovs(g_d, 0.0);
  g[pe.word] = pe.t[0] * rr + rb[l];
  pe.seg_ar(g_d, NEX);
  pe.stamp(1 + 3 * K + l);
  // top TK: the pairwise-maximum tree once (blocks of 2, 4, 8, then over the NEX / 8 blocks); a round takes the
  // maximum, its first block and in it the leftmost leaf holding it (down the tree: the left child when it holds
  // the maximum; ties: the lower expert first, as a stable descending sort), that leaf out (-3.4e38) and its
  // path's maxima redone (the same decisions as a full rebuild a round: every comparison is exact)
  @fmovs(h_d, g_d);
  pmax(&t1, &h, NEX / 2);
  pmax(&t2, &t1, NEX / 4);
  pmax(&t3, &t2, NEX / 8);
  var k: u16 = 0;
  while (k < TK) : (k += 1) {
    var m: f32 = t3[0];
    var b: u16 = 1;
    while (b < NEX / 8) : (b += 1) { if (t3[b] > m) { m = t3[b]; } }
    b = 0;
    while (t3[b] != m) : (b += 1) {}
    var j2: u16 = 2 * b;
    if (t2[j2] != m) { j2 += 1; }
    var j1: u16 = 2 * j2;
    if (t1[j1] != m) { j1 += 1; }
    var i: u16 = 2 * j1;
    if (h[i] != m) { i += 1; }
    sel[k] = i;
    h[i] = -3.4e38;
    t1[j1] = fmax(h[2 * j1], h[2 * j1 + 1]);
    t2[j2] = fmax(t1[2 * j2], t1[2 * j2 + 1]);
    t3[b] = fmax(t2[2 * b], t2[2 * b + 1]);
  }
  const m0 = g[sel[0]];
  var sum: f32 = 0.0;
  k = 0;
  while (k < TK) : (k += 1) { wsel[k] = math.exp1(g[sel[k]] - m0); sum += wsel[k]; }
  const is = math.recip(sum);
  k = 0;
  while (k < TK) : (k += 1) {
    wsel[k] = wsel[k] * is;
    pe.u[k] = @as(f32, sel[k]);
    pe.u[TK + k] = wsel[k];
  }
  @fmovs(fab.fout(pe.q_mc, 2 * TK), pe.uv(0, 2 * TK));
  pe.stamp(2 + 3 * l);
  // gate|up: t = [k][gate Ic | up Ic]
  pe.reduce(TN);
  k = 0;
  while (k < TK) : (k += 1) {
    const e2 = sel[k];
    const pb = (l * NEX + e2) * 2;
    @fmuls(pe.tv(k * G2, G2), pe.tv(k * G2, G2), ps[pb] * rr);
    @fadds(pe.tv(k * G2, G2), pe.tv(k * G2, G2), @set_dsd_base_addr(gb_d, @ptrcast([*]f32, &gb[(l * NEX + e2) * G2])));
    @fmovs(@set_dsd_length(@increment_dsd_offset(sg_d, @as(i16, k * Ic), f32), Ic), pe.tv(k * G2, Ic));
    @fmovs(pe.uv(k * Ic, Ic), pe.tv(k * G2 + Ic, Ic));
  }
  const NG = TK * Ic;
  const G = @set_dsd_length(sg_d, NG);
  const U = pe.uv(0, NG);
  // gate <= SWL: -max(-g, -SWL); up in [-SWL, SWL]
  @fnegs(G, G); @fmaxs(G, G, -SWL); @fnegs(G, G);
  @fmaxs(U, U, -SWL); @fnegs(U, U); @fmaxs(U, U, -SWL); @fnegs(U, U);
  const E = pe.tv(0, NG);
  if (GLUV == 1) {
    // e = exp(-SWA |g|) (the sign bit set on the high halves), d = 1 + e in (1, 2], r = 1 / d
    @fmuls(E, G, SWA);
    @or16(@set_dsd_length(eh_d, NG), @set_dsd_length(eh_d, NG), 0x8000);
    vexp(E, NG);
    const D = pe.tv(NG, NG);
    const RR = @set_dsd_length(rg_d, NG);
    const TT = @set_dsd_length(vb_d, NG);
    @fadds(D, E, 1.0);
    @fmuls(RR, D, 0.323112507040746);
    @fadds(RR, RR, -1.4540415401729079);
    @fmuls(RR, RR, D);
    @fadds(RR, RR, 2.1207294161729284);
    var kn: u16 = 0;
    while (kn < 2) : (kn += 1) {
      @fmuls(TT, D, RR);
      @fsubs(TT, 2.0, TT);
      @fmuls(RR, RR, TT);
    }
    @fmuls(TT, G, E);
    @fmaxs(G, G, TT);           // g (g >= 0) or g e (g < 0)
    @fmuls(G, G, RR);           // glu = g sigmoid(SWA g)
  } else {
    // sigmoid(SWA g) = 1 / (1 + exp(-SWA g)): the exp in t's first words, the reciprocal per word
    @fmuls(E, G, -SWA);
    vexp(E, NG);
    var i: u16 = 0;
    while (i < NG) : (i += 1) { pe.t[i] = math.recip(1.0 + pe.t[i]); }
    @fmuls(G, G, E);            // glu = g sigmoid(SWA g)
  }
  @fadds(U, U, 1.0);
  @fmuls(U, U, G);              // act = (up + 1) glu
  k = 0;
  while (k < TK) : (k += 1) {
    const pb = (l * NEX + sel[k]) * 2;
    @fmuls(pe.uv(k * Ic, Ic), pe.uv(k * Ic, Ic), wsel[k] * ps[pb + 1]);
  }
  @fmovs(fab.fout(pe.q_mc, NG), U);
  pe.stamp(3 + 3 * l);
}
