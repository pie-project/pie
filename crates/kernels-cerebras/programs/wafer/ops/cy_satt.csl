// wafer/ops/cy_satt.csl: P7 v0 (GENERIC.md §3.1), a column root's side of attention over a
// step's own rows (the attention PEs' side: ops/satt.csl). Store phase: each row's [k | v] (a kv
// head, 2 Dc f32) multicast up the column. Attend phase, a query a call: q (Qh heads of Dc)
// multicast; from the column chain [o | l] a head; o / l; [redo, ln l a head] multicast (the PEs'
// reference steps), and q again while any l is outside [LO, HI): the 16-bit probabilities'
// window (f16: [2^-8, 2^15), as ops/cy_att.csl's). The root alone ends a query (the PEs pass
// until its word says done), so the two sides cannot disagree on a query's passes.
//
// The passes a query takes, its largest score s off the reference m by D = s - m: a pass's sum l
// is of the 16-bit probabilities, each at most exp(D) and at least 2^-133 or none, so with n
// entries attended exp(D) <= l <= n exp(D) where nothing clamps. Out of the window it steps
// m += ln l: from above (D > ln HI) by at least min(D, ln PMAX) (69 a bf16 build, 11 an IEEE
// one) and at most the sum's log, so never past the scores' log-sum-exp; from below (l = 0, D
// under ~-88) by ln1(0) = -88, past it by at most ln n (n below 2^15: the next sum in the window
// or one step back). A query so ends within |D| / ln PMAX + 2 passes, exactly converged. PASSES
// (1024: |D| up to ~70,000 bf16, ~11,000 IEEE) is a hang guard, not a bound the numerics lean
// on: a query that reaches it is never returned unconverged: its output is NaN and `passes`' top
// bit set (a stamp's third word). (That a NaN reaches the host is not assured: later regions'
// exp clamps turn it finite. GENERIC.md G5.1: the host's every-step report is next.)
//
// SINK (attention sinks, gpt-oss's): each head's sink logit `sk` joins its softmax's sum, o =
// sum(p v) / (l + exp(sk - mref)), the root keeping the PEs' reference `mr` (their mref: ln l a
// pass, from 0 at init()).
//
// Params: fab (ops/fabric.csl), math (ops/math.csl), YO (the column multicast's output queue),
// IN (the chain's input queue), Qh, Dc, LO / HI (the window), SINK.
param fab: imported_module;
param math: imported_module;
param YO: output_queue;
param IN: input_queue;
param Qh: u16;
param Dc: u16;
param LO: f32 = 0.00390625;
param HI: f32 = 32768.0;
param SINK: bool = false;

const QD: u16 = Qh * Dc;
const TW: u16 = Qh * (Dc + 1);
var t: [TW]f32 align(16) = @zeros([TW]f32);
var u = @zeros([1 + Qh]f32);
const t_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{TW} -> t[i] });
const u_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1 + Qh} -> u[i] });
var passes: u32 = 0;   // every query's passes, summed (a redo is one more; a root zeroes it a launch)
var qh: [QD]f32 align(16) = @zeros([QD]f32);
const NS: u16 = if (SINK) Qh else 1;
var sk = @zeros([NS]f32);
var mr = @zeros([NS]f32);

// The reference the PEs start from (their init()).
fn init() void {
  var h: u16 = 0;
  while (h < NS) : (h += 1) { mr[h] = 0.0; }
}
const qh_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QD} -> qh[i] });

// A query whose q the column holds (ops/satt.csl's QH): q up the chain, then query().
fn query_q(o: mem1d_dsd) void {
  @fmovs(qh_d, fab.fin(IN, QD));
  query(qh_d, o);
}

// Row's [k | v] (kv, 2 Dc f32) to the column.
fn store(kv: mem1d_dsd) void { @fmovs(fab.fout(YO, 2 * Dc), kv); }

// One query: q (QD f32) in, o (QD f32) out.
const PASSES: u16 = 1024;
fn query(q: mem1d_dsd, o: mem1d_dsd) void {
  var pass: u16 = 0;
  while (pass < PASSES) : (pass += 1) {
    passes += 1;
    @fmovs(fab.fout(YO, QD), q);
    @fmovs(t_d, fab.fin(IN, TW));
    var bad: f32 = 0.0;
    var h: u16 = 0;
    while (h < Qh) : (h += 1) {
      const l = t[h * (Dc + 1) + Dc];
      if (l < LO or l >= HI) { bad = 1.0; }
      var lt = l;
      if (SINK) { lt = l + math.exp1(sk[h] - mr[h]); }
      @fmuls(@set_dsd_length(@increment_dsd_offset(o, @as(i16, h * Dc), f32), Dc),
             @set_dsd_length(@increment_dsd_offset(t_d, @as(i16, h * (Dc + 1)), f32), Dc), math.recip(lt));
      u[1 + h] = math.ln1(l);
      if (SINK) { mr[h] += u[1 + h]; }
    }
    // (the hang guard: refused, not returned)
    if (pass + 1 == PASSES and bad != 0.0) {
      @fmovs(@set_dsd_length(o, QD), @bitcast(f32, @as(u32, 0x7fc00000)));
      passes |= 0x80000000;
      bad = 0.0;
    }
    u[0] = bad;
    @fmovs(fab.fout(YO, 1 + Qh), u_d);
    if (bad == 0.0) { pass = PASSES; }
  }
}
