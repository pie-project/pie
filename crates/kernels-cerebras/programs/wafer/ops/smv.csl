// wafer/ops/smv.csl: P1-stream (GENERIC.md §3.1), a weight PE's matvec over a row stream. The
// tile stays; the step's rows flow through it: each row's chunk (Hc f32 wavelets from the row
// multicast) lands in one of two 16-bit x buffers, the tile matvec (ops/mv.csl's tile32: 16-bit
// operands, f32 accumulation) gives the PE's Nc partials of that row, and they go into the column
// chain (ops/red.csl's send, async) from one of two y buffers, so a row's send runs while the next
// row multiplies. A send is issued on the chain's microthread only once the one before it has
// left: the buffer a send reads is free again two rows on. The 16-bit type is the build's
// (`--fp16-format`): IEEE f16, or bf16 (the stream regime's activations, GENERIC.md §5).
//
// Interface: w (the tile, Hc rows of Nc 16-bit words, row k the weights of x element k; w[0]
// unused: memcpy's 16-bit writes start at an odd half), `rows(n)`.
//
// Params: fab (ops/fabric.csl), red (an ops/red.csl instance: the column chain the partials go
// into), XQ (the rows' input queue), Hc (a row's elements the tile multiplies), Nc (its outputs).
param fab: imported_module;
param red: imported_module;
param XQ: input_queue;
param Hc: u16;
param Nc: u16;

const matvec = @import_module("ops/mv.csl");

var w = @zeros([Hc * Nc + 1]u16);
var xh = @zeros([2 * Hc]@fp16());
var y: [2 * Nc]f32 align(16) = @zeros([2 * Nc]f32);
const xh_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Hc} -> xh[i] });
const y_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Nc} -> y[i] });
const a_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{Nc} -> w[1 + i] });

// n rows through the tile: each row's x chunk in, its partials into the chain.
fn rows(n: u16) void {
  var t: u16 = 0;
  while (t < n) : (t += 1) {
    const b: u16 = t & 1;
    const xv = @increment_dsd_offset(xh_d, @as(i16, b * Hc), @fp16());
    const yv = @increment_dsd_offset(y_d, @as(i16, b * Nc), f32);
    @fs2h(xv, fab.fin(XQ, Hc));
    matvec.tile32(yv, a_d, xv);
    red.send(yv, Nc);
  }
}
