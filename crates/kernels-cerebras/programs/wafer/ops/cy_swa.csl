// wafer/ops/cy_swa.csl: a column control PE's attention phases over full and sliding-window layers with
// sinks (README.md, gpt-oss; the weight PEs' side: ops/swa.csl), an attention half's column. A layer:
//   q|k|v reduction (NQA words + ssq) -> rms scale, + biases; RoPE (YaRN: the host's tables carry the
//   attention scaling in level 0) on q's Qh heads and k, q x QSC -> multicast [q | k | v | position]
//   values reduction (Qh (Dc + 1): o | l a head) -> l_h += exp(sink_h - mref_h) (CY keeps its own copy
//   of the log-sum-exp reference the weight PEs used), o / l, the redo flag (some l outside the f16
//   probabilities' window) -> multicast [o | redo] (+ the steps ln l_h in a second multicast, read by
//   the weight PEs after their o_proj send) and mref += ln l_h.
// Rotated pairs: the host places dims (d, d + 32) of each head side by side, NROT pairs a column.
//
// Interface: qb (f32 [layer][NQA] biases; QKN 1: the q / k norms' weights [layer][Qh Dc | Dc]), snk (f32
// [layer][Qh]), rot (f32 RoPE tables [NLV][8] [cos | sin][NROT]); the stamps' tdbg[1 + 3 K + l] (always on):
// each layer's redo passes over the launch.
//
// Variants (comptime, from the layer program): QB (1: the q / k / v biases added), SNK (1: the sinks in each
// head's sum), QKN (1: q / k RMS-normed per head: their weights here, the raw sums of squares a head ride the
// multicast after the position and the weight PEs' scores all-reduce completes them, as ops/cy_att.csl's).
//
// Params: pe (ops/cpe.csl), math (ops/math.csl), ON (false: another mixer kind's unit), K, NQA, Qh,
// Dc, NROT, NLV (RoPE table levels: positions < 8^NLV), QSC (1 / sqrt(head dim)), CYV (a pass's
// 1 / (l + exp(sink - mref)): 0 scalar a head; 1 as Qh-word vector ops (exp_fast's form; the
// reciprocal by exponent split, the quadratic and two Newton steps); 2 the vector exp, the scalar
// recip; 3 the scalar exp, the vector reciprocal).
param pe: imported_module;
param math: imported_module;
param ON: bool = true;
param K: u16;
param NQA: u16;
param Qh: u16;
param Dc: u16;
param NROT: u16;
param NLV: u16 = 5;
param QSC: f32 = 0.125;
param CYV: u16 = 0;
param QB: u16 = 1;
param SNK: u16 = 1;
param QKN: u16 = 0;
param SKW: u16 = 0;

const QD: u16 = Qh * Dc;
const NV: u16 = Qh * (Dc + 1);
const QN: u16 = if (ON) Qh else 1;
const QAN: u16 = if (ON) NQA else 1;
var qb = @zeros([if (ON) K * NQA else 1]f32);
const qb_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QAN} -> qb[i] });
var snk = @zeros([if (ON) K * Qh else 1]f32);
var mref = @zeros([if (ON) K * Qh else 1]f32);
var rot = @zeros([if (ON) NLV * 8 * 2 * NROT else 1]f32);
const RN: u16 = if (ON) NROT else 1;
var rc = @zeros([RN]f32);
var rs = @zeros([RN]f32);
const rp = @import_module("ops/rope.csl", .{ .rot = &rot, .rc = &rc, .rs = &rs, .NROT = NROT, .LV = NLV, .BITS = 3 });
const NRB: u16 = if (ON) (Qh + 1) * NROT else 1;   // rotated pairs a pass (q's heads, then k)
var rcv = @zeros([NRB]f32);
var rsv = @zeros([NRB]f32);
var ra = @zeros([NRB]f32);
var rb2 = @zeros([NRB]f32);
var rc3 = @zeros([NRB]f32);
const rcv_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> rcv[i] });
const rsv_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> rsv[i] });
const ra_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> ra[i] });
const rb2_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> rb2[i] });
const rc3_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{NRB} -> rc3[i] });
var ilh = @zeros([QN]f32);
var lh = @zeros([QN]f32);
var ve: [QN]f32 align(16) = @zeros([QN]f32);
var lw = @zeros([QN]f32);   // (SKW 1) the window's sum a head: l + exp(sink - mref)
var vs: [QN]f32 align(16) = @zeros([QN]f32);
var vp: [QN]f32 align(16) = @zeros([QN]f32);
var vk = @zeros([QN]u16);
const ilh_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QN} -> ilh[i] });
const lh_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QN} -> lh[i] });
const ve_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QN} -> ve[i] });
const lw_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QN} -> lw[i] });
const vs_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QN} -> vs[i] });
const vp_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QN} -> vp[i] });
const vk_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QN} -> vk[i] });
const snk_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QN} -> snk[i] });
const mref_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{QN} -> mref[i] });
const lst_d = pe.ts(Dc, QN, Dc + 1);   // the heads' sums l
// a buffer's high halves (u16, stride 2, offset 1)
fn hi(a: [*]f32) mem1d_dsd { return @increment_dsd_offset(@set_dsd_stride(@set_dsd_base_addr(vk_d, @ptrcast([*]u16, a)), 2), 1, u16); }

// ve = exp(ve) (Qh words; p in vp, k's bits in vk)
fn vexpq() void {
  const pl = @set_dsd_stride(@set_dsd_base_addr(vk_d, @ptrcast([*]u16, &vp)), 2);
  math.vexp(ve_d, vp_d, vk_d, pl, 88.0, true);
}
// ilh = 1 / ve (ve > 0, normal): ve = m 2^e, m in [1, 2) (vp), 2^(1 - e) (vs: the exponent field 255 - E, by an xor
// with 0x7f80), r = 1 / m by the quadratic and two Newton steps (ops/cy_moe.csl GLUV's), x 2^(1 - e) x 0.5
fn vrecipq() void {
  @fmovs(vp_d, ve_d);
  @and16(hi(&vp), hi(&vp), @as(u16, 0x807f));
  @or16(hi(&vp), hi(&vp), @as(u16, 0x3f80));
  @fmovs(vs_d, 0.0);
  @and16(hi(&vs), hi(&ve), @as(u16, 0x7f80));
  @xor16(hi(&vs), hi(&vs), @as(u16, 0x7f80));
  @fmuls(ilh_d, vp_d, 0.323112507040746);
  @fadds(ilh_d, ilh_d, -1.4540415401729079);
  @fmuls(ilh_d, ilh_d, vp_d);
  @fadds(ilh_d, ilh_d, 2.1207294161729284);
  var kn: u16 = 0;
  while (kn < 2) : (kn += 1) {
    @fmuls(ve_d, vp_d, ilh_d);
    @fsubs(ve_d, 2.0, ve_d);
    @fmuls(ilh_d, ilh_d, ve_d);
  }
  @fmuls(ilh_d, ilh_d, vs_d);
  @fmuls(ilh_d, ilh_d, 0.5);
}

var rope_at: u32 = 0xffffffff;
fn rope_tables_at(p: u32) void {
  if (rope_at == p) { return; }
  rope_at = p;
  rp.tables(p, 0, 0, NROT);
  var b: u16 = 0;
  while (b <= Qh) : (b += 1) {
    @fmovs(@set_dsd_length(@increment_dsd_offset(rcv_d, @as(i16, b * NROT), f32), NROT), @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{RN} -> rc[i] }));
    @fmovs(@set_dsd_length(@increment_dsd_offset(rsv_d, @as(i16, b * NROT), f32), NROT), @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{RN} -> rs[i] }));
  }
}
// every rotated pair (a, b) = (t[2 i], t[2 i + 1]) of q's heads and k (t[0 .. QD + Dc), adjacent blocks):
// a' = a c - b s, b' = b c + a s (the scalar rope()'s operations, word for word)
fn rope_v() void {
  const A = @set_dsd_stride(@set_dsd_length(pe.t_d, NRB), 2);
  const B = @increment_dsd_offset(A, 1, f32);
  @fmuls(ra_d, A, rcv_d);
  @fmuls(rb2_d, B, rsv_d);
  @fsubs(ra_d, ra_d, rb2_d);          // a c - b s
  @fmuls(rb2_d, B, rcv_d);
  @fmuls(rc3_d, A, rsv_d);
  @fadds(rb2_d, rb2_d, rc3_d);        // b c + a s
  @fmovs(A, ra_d);
  @fmovs(B, rb2_d);
}

// A launch's start: the redo counts restart.
fn launch() void {
  var l: u16 = 0;
  while (l < K) : (l += 1) { pe.tdbg[1 + 3 * K + l] = 0; }
}
fn layer(l: u16, pos: u32) void {
  pe.reduce(NQA + 1);
  pe.stamp(1 + 3 * l);
  const rr = math.rsqrt(pe.t[NQA] / pe.HID + pe.EPS);
  @fmuls(pe.tv(0, NQA), pe.tv(0, NQA), rr);
  if (QB == 1) { @fadds(pe.tv(0, NQA), pe.tv(0, NQA), @set_dsd_base_addr(qb_d, @ptrcast([*]f32, &qb[l * NQA]))); }
  if (QKN == 1) {
    // the raw q / k sums of squares a head (the weight PEs' segment all-reduce completes them), then the
    // norms' weights (qb holds them: [Qh Dc | Dc] a layer)
    var hq: u16 = 0;
    while (hq < Qh) : (hq += 1) {
      var ss: f32 = 0.0;
      var d: u16 = 0;
      while (d < Dc) : (d += 1) { const v = pe.t[hq * Dc + d]; ss += v * v; }
      pe.u[QD + 2 * Dc + 1 + hq] = ss;
    }
    var ks: f32 = 0.0;
    var d: u16 = 0;
    while (d < Dc) : (d += 1) { const v = pe.t[QD + d]; ks += v * v; }
    pe.u[QD + 2 * Dc + 1 + Qh] = ks;
    @fmuls(pe.tv(0, QD + Dc), pe.tv(0, QD + Dc), @set_dsd_length(@set_dsd_base_addr(qb_d, @ptrcast([*]f32, &qb[l * NQA])), QD + Dc));
  }
  rope_tables_at(pos);
  rope_v();
  var h: u16 = 0;
  @fmuls(pe.uv(0, QD), pe.tv(0, QD), QSC);
  @fmovs(pe.uv(QD, 2 * Dc), pe.tv(QD, 2 * Dc));
  pe.u[QD + 2 * Dc] = @as(f32, pos);
  pe.mcast(QD + 2 * Dc + 1 + (if (QKN == 1) Qh + 1 else 0));
  pe.stamp(2 + 3 * l);
  if (l == K - 1) { rope_tables_at(pos + 1); }   // (ROPEP) the next pass's tables, off the path
  if (pos == 0) {
    h = 0;
    while (h < Qh) : (h += 1) { mref[l * Qh + h] = 0.0; }
  }
  var pass: u16 = 0;
  while (pass < 8) : (pass += 1) {
    pe.reduce(NV);
    var bad: f32 = 0.0;
    if (CYV != 0) {
      @fmovs(lh_d, lst_d);
      if (SNK == 1) {
        @fsubs(ve_d, @increment_dsd_offset(snk_d, @as(i16, l * Qh), f32), @increment_dsd_offset(mref_d, @as(i16, l * Qh), f32));
        if (CYV == 3) { h = 0; while (h < Qh) : (h += 1) { ve[h] = math.exp1(ve[h]); } } else { vexpq(); }
        @fadds(ve_d, lh_d, ve_d);
        if (SKW == 1) { @fmovs(lw_d, ve_d); }
      } else {
        @fmovs(ve_d, lh_d);
      }
      if (CYV == 2) { h = 0; while (h < Qh) : (h += 1) { ilh[h] = math.recip(ve[h]); } } else { vrecipq(); }
      h = 0;
      while (h < Qh) : (h += 1) {
        const lv = if (SKW == 1 and SNK == 1) lw[h] else lh[h];
        if (lv < 0.00390625 or lh[h] >= 32768.0) { bad = 1.0; }   // the f16 probabilities' window
        @fmuls(pe.uv(h * Dc, Dc), pe.tv(h * (Dc + 1), Dc), ilh[h]);
      }
    } else {
      h = 0;
      while (h < Qh) : (h += 1) {
        const lv = pe.t[h * (Dc + 1) + Dc];
        lh[h] = lv;
        const sk = snk[l * Qh + h] - mref[l * Qh + h];
        const lt = if (SNK == 1) lv + math.exp1(sk) else lv;
        lw[h] = lt;
        const lb = if (SKW == 1) lt else lv;
        if (lb < 0.00390625 or lv >= 32768.0) { bad = 1.0; }   // the f16 probabilities' window
        ilh[h] = math.recip(lt);
        @fmuls(pe.uv(h * Dc, Dc), pe.tv(h * (Dc + 1), Dc), ilh[h]);
      }
    }
    pe.u[QD] = bad;
    pe.mcast(QD + 1);
    h = 0;
    while (h < Qh) : (h += 1) {
      const lr = if (SKW == 1 and SNK == 1) lw[h] else lh[h];
      const st = math.ln1(if (lr > 1.0e-30) lr else 1.0e-30);
      pe.u[h] = st;
      mref[l * Qh + h] += st;
    }
    pe.mcast(Qh);
    if (bad == 0.0) { pass = 8; } else { pe.tdbg[1 + 3 * K + l] += 1; }
  }
  pe.stamp(3 + 3 * l);
}
