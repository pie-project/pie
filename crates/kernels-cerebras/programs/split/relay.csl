// split/relay.csl: a PE of the gap slot (spatial/split/README.md: an odd unit count on an even number of
// unit columns leaves one slot out of the snake). It holds no tiles and runs nothing; init sets the routes the
// host's rcfg names, compute returns.
param memcpy_params;
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const tgt = tile_config.target;
const NR: u16 = 4;
var rcfg = @zeros([1 + 2 * NR]u32);
var rcfg_ptr: [*]u32 = &rcfg;
fn init() void {
  const cc0 = color_config.get_color_config_addr(@get_color(0));
  var k: u16 = 0;
  while (k < @as(u16, rcfg[0])) : (k += 1) {
    const addr = cc0 + @as(u16, rcfg[1 + 2 * k]);
    const r = @get_config(addr, tgt.color_addr_range) & 0xff00;
    @set_config(addr, r | @as(u16, rcfg[2 + 2 * k]), tgt.color_addr_range);
  }
  sys_mod.unblock_cmd_stream();
}
fn compute(steps: u32, start_pos: u32) void { sys_mod.unblock_cmd_stream(); }
comptime {
  @export_symbol(rcfg_ptr, "rcfg");
  @export_symbol(init);
  @export_symbol(compute);
}
