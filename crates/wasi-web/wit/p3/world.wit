// The WASI 0.3 surface the pie inferlet world declares (see
// crates/inferlet/wit/world.wit); the deps are the same vendored copies so the
// runtime's bindgen `with:` mappings resolve to identical types.
package wasi-web:p3;

world imports {
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:filesystem/types@0.3.0;
  import wasi:filesystem/preopens@0.3.0;
  import wasi:http/client@0.3.0;
}
