package plex:policy@1.0.0;

/// Where programs and their state live, across the cluster: pie's gateway,
/// beside the state directory. Mostly space.
world cluster {
    import reads;
    import writes;
    import cluster-writes;
    import state-writes;
    export policy;
}

/// When a worker's passes run, and where its state sits within it: pie's
/// runtime, one per worker. Mostly time.
world worker {
    import reads;
    import writes;
    import worker-writes;
    export policy;
}
