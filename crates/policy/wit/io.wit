package plex:policy@1.0.0;

/// Reads. Every read within one `react` call sees one snapshot.
interface reads {
    use types.{id, subject, subject-kind, value};

    /// The subjects of `kind` the host knows.
    candidates: func(kind: subject-kind) -> list<id>;

    /// A value the host measured or authenticated. Trusted.
    attr: func(of: subject, name: string) -> option<value>;

    /// A value supplied from outside the host: by the client, or by the
    /// cluster policy under the reserved prefix `cluster/`. Untrusted unless
    /// the policy decides otherwise.
    prop: func(of: subject, name: string) -> option<value>;

    /// Whether this plane's host has a capability.
    capability: func(name: string) -> bool;
}

/// Writes both planes take. Writes take effect when `react` returns; a call
/// that traps or overruns its deadline has all of its writes discarded, and a
/// fresh instance, without the program's state, takes the next call. A write
/// the host does not take, it logs.
interface writes {
    use types.{id};

    /// Delivers a `timer` edge at or after `at-ms`. A later call replaces
    /// an earlier one.
    set-alarm: func(at-ms: u64);

    /// Rejects a pending process or stops a running one. The client sees it.
    terminate: func(process: id, reason: string);
}

/// The worker plane's tables and verbs.
interface worker-writes {
    use types.{id, key, retain, offload, subject, value};

    /// Admission, run order, preemption victim and resume all follow the
    /// key. A process below `floor` is not started, and is paused if running.
    install-schedule: func(entries: list<tuple<id, key>>, floor: option<key>);

    /// KV is evicted in ascending key; a position no entry covers is 0.
    install-retention: func(entries: list<retain>);

    /// Drops a retained working-set's KV now.
    discard: func(working-set: id);

    /// Where passes run: `default` for every process no entry names.
    install-offload: func(entries: list<tuple<id, offload>>, default: option<offload>);

    /// A value for the cluster plane to read, as attr `published/<name>` of
    /// `of`: this worker, or a process on it. Level-triggered; `none`
    /// withdraws it. The one way a worker policy speaks to the cluster.
    publish: func(of: subject, name: string, val: option<value>);
}

/// The cluster plane's process tables.
interface cluster-writes {
    use types.{id, key, placement, scale};

    /// The gateway's queue: released in key order, held below `floor`.
    install-schedule: func(entries: list<tuple<id, key>>, floor: option<key>);

    install-placement: func(entries: list<placement>);

    /// The cluster's size, per shape.
    install-scale: func(entries: list<scale>);
}

/// The cluster plane's state tables and verb. Their subjects are groups,
/// workers' tiers and links.
interface state-writes {
    use types.{id, key, replicate, accept, transfer-class};

    /// Copies wanted besides the ones the workers keep.
    install-replication: func(entries: list<replicate>);

    /// Cluster-wide: a group keeps at least one copy in the order of its
    /// key, demoted toward `pool` rather than dropped when the last worker
    /// holding it lets it go. A group no entry names takes key 0.
    install-retention: func(entries: list<tuple<id, key>>);

    /// Bandwidth shares among transfer classes, on every link.
    install-transfer-shares: func(entries: list<tuple<transfer-class, u32>>);

    /// Cross-class use. Granted to operator policies only (`state.accept`).
    install-acceptance: func(entries: list<accept>);

    /// Drops every copy of a group now.
    discard: func(group: id);
}

/// The one hook.
interface policy {
    use types.{edge};

    /// Edges since the last call, batched, each delivered at most once.
    react: func(edges: list<edge>, now-ms: u64);
}
