// `cuda/std/limits` for NVRTC, which ships no device headers (see README.md).
// `cuda::std::numeric_limits<float>::infinity()`, the one limit the device
// text asks CCCL for.

#pragma once

namespace cuda::std {

template <class T>
struct numeric_limits;

template <>
struct numeric_limits<float> {
    static __device__ __forceinline__ float infinity() { return __int_as_float(0x7f800000u); }
};

}  // namespace cuda::std
