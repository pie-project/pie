# The weights of Llama 3.1 / 3.3: per layer an RMS norm, q, k and v packed
# into one projection and the output projection, an RMS norm and a SwiGLU MLP;
# the token embedding, a final norm and the head. The projections are stored
# at the deployment's one dtype; the norms, the embedding and the head stay
# bf16 under a release's FP8 or NVFP4 (modelopt leaves the head bf16), or take
# the projections' u4 where the deployment quantizes a bf16 release. Each
# layer also has the LoRA banks the host registers.

load("//lib/adapters/model.poem", "banks")

def dims(hidden, layers, q_heads, inter):
    return struct(
        hidden = hidden,
        layers = layers,
        q_heads = q_heads,
        kv_heads = 8,
        inter = inter,
        head_dim = 128,
        vocab = 128256,
        theta = 500000.0,
        # rope_scaling: rope_type "llama3".
        rope_factor = 8.0,
        rope_low_freq_factor = 1.0,
        rope_high_freq_factor = 4.0,
        rope_original_max_position = 8192,
        norm_eps = 1e-5,
    )

DIMS = {
    "llama31-8b": dims(hidden = 4096, layers = 32, q_heads = 32, inter = 14336),
    "llama33-70b": dims(hidden = 8192, layers = 80, q_heads = 64, inter = 28672),
    "llama33-70b-mini-l4": dims(hidden = 8192, layers = 4, q_heads = 64, inter = 28672),
}

# A release whose projections a deployment keeps as released, its tables bf16.
RELEASED = [dtype.e4m3tile128a8, dtype.nvfp4]

def layout(id, deploy):
    if deploy.drafter != None or deploy.parts:
        fail("{} ships no drafter and no parts".format(id))
    proj = roles(deploy, "proj", exact = True).proj
    table = dtype.bf16 if proj in RELEASED else proj
    dense = compute(table)
    d = DIMS[id]
    hidden, hd = d.hidden, d.head_dim
    q_width, kv_width = d.q_heads * hd, d.kv_heads * hd

    def layer(l):
        lora_a, lora_b = banks("layer.{}".format(l), hidden, dense)
        return struct(
            attn_norm = weight([hidden]),
            qkv = weight([q_width + 2 * kv_width, hidden], proj).packed([q_width, kv_width, kv_width], heads = [d.q_heads, d.kv_heads, d.kv_heads]),
            o = weight([hidden, q_width], proj).rows(),
            mlp_norm = weight([hidden]),
            gate_up = weight([2 * d.inter, hidden], proj).packed([d.inter, d.inter]),
            down = weight([hidden, d.inter], proj).rows(),
            kv = "kv.{}".format(l),
            lora_a = lora_a,
            lora_b = lora_b,
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        q_heads = d.q_heads,
        kv_heads = d.kv_heads,
        head_dim = hd,
        q_width = q_width,
        kv_width = kv_width,
        inter = d.inter,
        theta = d.theta,
        rope = struct(
            factor = d.rope_factor,
            low_freq_factor = d.rope_low_freq_factor,
            high_freq_factor = d.rope_high_freq_factor,
            original_max_position = d.rope_original_max_position,
        ),
        eps = d.norm_eps,
        sm_scale = f32(1.0 / f32(sqrt(hd))),
        kv = deploy.kv,
        embed = weight([d.vocab, hidden], table),
        head = weight([d.vocab, hidden], table).columns(),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight([hidden]),
    )
