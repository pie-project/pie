# How a Llama 3.1 / 3.3 checkpoint is read: transformers' safetensors under
# `model.`, as released (bf16) or as modelopt exports it (FP8 e4m3 codes
# under one scale a projection, read as 128-square block factors; NVFP4),
# checked against its config.

load("//pie/codec.poem", "weight")

def configured(m):
    return [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("num_hidden_layers", len(m.layers)),
        config("intermediate_size", m.inter),
        config("rms_norm_eps", m.eps),
        config("rope_theta", m.theta),
        config("rope_scaling.factor", m.rope.factor),
        config("rope_scaling.low_freq_factor", m.rope.low_freq_factor),
        config("rope_scaling.high_freq_factor", m.rope.high_freq_factor),
        config("rope_scaling.original_max_position_embeddings", m.rope.original_max_position),
    ]

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("model.embed_tokens.weight") and has("model.layers.0.self_attn.q_proj.weight") and not has("model.layers.0.self_attn.q_norm.weight"),
        read = lambda reads: read(m, reads),
        states = configured(m),
    )]

def read(m, reads):
    reads.read(m.embed, "model.embed_tokens.weight")
    reads.read(m.final_norm, "model.norm.weight")
    reads.read(m.head, "lm_head.weight")
    for l, w in enumerate(m.layers):
        n = lambda s: "model.layers.{}.{}".format(l, s)
        reads.read(w.attn_norm, n("input_layernorm.weight"))
        weight(
            reads,
            w.qkv,
            [n("self_attn.q_proj.weight"), n("self_attn.k_proj.weight"), n("self_attn.v_proj.weight")],
        )
        weight(reads, w.o, [n("self_attn.o_proj.weight")])
        reads.read(w.mlp_norm, n("post_attention_layernorm.weight"))
        weight(reads, w.gate_up, [n("mlp.gate_proj.weight"), n("mlp.up_proj.weight")])
        weight(reads, w.down, [n("mlp.down_proj.weight")])
