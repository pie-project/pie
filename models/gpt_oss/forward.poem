# The forward of gpt-oss: biased attention with sinks over YaRN rope, every
# other layer windowed, then experts with clamped SwiGLU; and with a DFlash
# drafter, the block it drafts.

load("//lib/dflash/forward.poem", "arm", "block_rows", "plant_readout", "tap", dflash_caches = "caches")

WINDOWED = 0
FULL = 1

def caches(m, c):
    kv = c.kv_space(m.kv)
    plane = m.kv_heads * m.head_dim
    for w in m.layers:
        c.kv(kv, w.attn.kv, [plane, plane], m.head_dim, heads = True)
    if m.dflash != None:
        dflash_caches(m.dflash, c, kv)

def forward(m, inputs):
    dr = m.dflash
    trunk_inputs = inputs.on(~block_rows(dr)) if dr != None else inputs
    positions = trunk_inputs.positions()
    d = m.head_dim
    y = ops.gather.embed(inputs.tokens(), m.embed, m.vocab)
    h_block = None
    if dr != None:
        h_block = y.on(block_rows(dr))
        y = y.on(~block_rows(dr))
    routes = inputs.adapter_routes()

    def block(l, w, carried):
        y, tapped = carried
        at = w.attn
        pages = inputs.kv(at.kv)
        write_page = inputs.write_page(at.kv)
        write_offset = inputs.write_offset(at.kv)

        x = ops.elemwise.rmsnorm(y, w.attn_norm, w.attn_norm_eps)
        q, k, v = ops.gather.split_qkv(
            ops.elemwise.add_bias(at.qkv_bias, ops.linear.matmul(x, at.qkv)),
            m.q_heads * d,
            m.kv_heads * d,
        )
        seam.at(seam.ATTN_QV, [q, v])

        rope = m.rope
        q, k = ops.elemwise.rope(
            q,
            positions,
            d,
            rope.theta,
            rotary.yarn(
                yarn(
                    factor = rope.factor,
                    beta_fast = rope.beta_fast,
                    beta_slow = rope.beta_slow,
                    original_max_position = rope.original_max_position,
                ),
                attention_factor = rope.attention_factor,
            ),
            k = k,
        )
        ops.attn.kv_append(k, v, pages, write_page, write_offset)
        seam.at(seam.ATTN_Q, [q])

        r = at.reading
        win = m.window if r == WINDOWED else None
        # Each lane by its kind, the sinks folded in; a full layer's scores
        # go out at their seam.
        a = ops.attn.attend(q, trunk_inputs, at.kv, m.q_heads, m.kv_heads, d, m.sm_scale, window = win,
                            sinks = at.sinks, mask = True, scores = True, scores_seam = r == FULL)
        seam.at(seam.ATTN_OUT, [a])

        o = ops.elemwise.add_bias(at.o_bias, ops.linear.matmul(a, at.o_proj))
        adapted = fact.has(fact.Adapter)
        o = ops.linear.lora_correct(x.on(adapted), w.lora_a, w.lora_b, routes, o.on(adapted))
        y = ops.elemwise.residual_add(o, y)

        e = w.mlp
        x = ops.elemwise.rmsnorm(y, w.mlp_norm, w.mlp_norm_eps)
        experts, weights = ops.linear.moe_route(
            ops.elemwise.add_bias(e.router_bias, ops.linear.matmul(x, e.router)),
            e.experts,
            e.top_k,
            routing.softmax(),
        )
        packed = ops.linear.moe_matmul_select_bias(x, e.gate_up, e.gate_up_bias, experts, e.top_k)
        act = ops.linear.glu(packed, gating.swiglu_alpha(e.swiglu_alpha), e.inter, limit = e.swiglu_limit)
        routed = ops.linear.moe_matmul_select_quant(act, e.down, experts, e.top_k)
        f = ops.linear.moe_weighted_sum(routed, weights)
        f = ops.linear.moe_bias_sum(f, e.down_bias, experts, weights)
        y = ops.elemwise.residual_add(f, y)
        if dr != None:
            tapped = tap(dr, l, y, tapped)
        return (y, tapped)

    y, tapped = inputs.fold_layers(m.layers, (y, None), block)

    x = ops.elemwise.rmsnorm(y, m.final_norm, m.final_norm_eps)
    hb = None
    if dr != None:
        hb = arm(dr, inputs, tapped, h_block, inputs.mask(), block_rows(dr))
        x = merge([hb, x])
    x = ops.gather.gather_rows(x, inputs.readout_rows())
    logits = ops.linear.lm_head(x, m.head)
    if dr != None:
        plant_readout(dr, logits, inputs, x, block_rows(dr))
    return logits
