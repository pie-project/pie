def dims(**d):
    base = dict(theta = 10000000.0, conv_kernel = 4, norm_eps = 1e-6, tower = None, draft = None,
                dflash_head = None, rotate_kv = False)
    base.update(d)
    return base

def dense(inter):
    return struct(routed = False, inter = inter)

def moe(experts, top_k, inter, shared_inter):
    return struct(routed = True, experts = experts, top_k = top_k, inter = inter, shared_inter = shared_inter)

def a3b(**over):
    d = dims(hidden = 2048, layers = 40, attn_every = 4, q_heads = 16, kv_heads = 2, head_dim = 256,
             rotary_dim = 64, k_heads = 16, v_heads = 32, k_dim = 128, v_dim = 128,
             mlp = moe(256, 8, 512, 512), vocab = 248320, tied = False)
    d.update(over)
    return d

def d27b(**over):
    d = dims(hidden = 5120, layers = 64, attn_every = 4, q_heads = 24, kv_heads = 4, head_dim = 256,
             rotary_dim = 64, k_heads = 16, v_heads = 48, k_dim = 128, v_dim = 128,
             mlp = dense(17408), vocab = 248320, tied = False)
    d.update(over)
    return d

def d0_8b(**over):
    d = dims(hidden = 1024, layers = 24, attn_every = 4, q_heads = 8, kv_heads = 2, head_dim = 256,
             rotary_dim = 64, k_heads = 16, v_heads = 16, k_dim = 128, v_dim = 128,
             mlp = dense(3584), vocab = 248320, tied = True)
    d.update(over)
    return d

def a17b(**over):
    """Qwen3.5-397B-A17B's geometry, as Ornith-1.5-397B ships it."""
    d = dims(hidden = 4096, layers = 60, attn_every = 4, q_heads = 32, kv_heads = 2, head_dim = 256,
             rotary_dim = 64, k_heads = 16, v_heads = 64, k_dim = 128, v_dim = 128,
             mlp = moe(512, 10, 1024, 1024), vocab = 248320, tied = False)
    d.update(over)
    return d

def a10b(**over):
    """Qwen3.5-122B-A10B."""
    d = dims(hidden = 3072, layers = 48, attn_every = 4, q_heads = 32, kv_heads = 2, head_dim = 256,
             rotary_dim = 64, k_heads = 16, v_heads = 64, k_dim = 128, v_dim = 128,
             mlp = moe(256, 8, 1024, 1024), vocab = 248320, tied = False)
    d.update(over)
    return d

def next80b(**over):
    """Qwen3-Next-80B-A3B: Qwen3.5-35B-A3B's mixer geometry, deeper, twice
    the experts, ten a token, and Qwen 3's vocabulary."""
    d = a3b(layers = 48, mlp = moe(512, 10, 512, 512), vocab = 151936)
    d.update(over)
    return d

def a95b(**over):
    """Qwen3.8 Max (2.4T-A95B), text only."""
    d = dims(hidden = 8192, layers = 92, attn_every = 4, q_heads = 64, kv_heads = 4, head_dim = 256,
             rotary_dim = 64, k_heads = 16, v_heads = 128, k_dim = 128, v_dim = 128,
             mlp = moe(512, 10, 2048, 2048), vocab = 248320, tied = False)
    d.update(over)
    return d

def micro_text(head_dim, rotate_kv):
    return dims(hidden = 128, layers = 2, attn_every = 1, q_heads = 4, kv_heads = 2, head_dim = head_dim,
                rotary_dim = 16, k_heads = 4, v_heads = 4, k_dim = head_dim, v_dim = head_dim,
                mlp = dense(256), vocab = 256, tied = True, rotate_kv = rotate_kv)

