# Qwen 3.5 / 3.6 / 3.8, Qwen3.8 Max, Ornith-1.5 and Qwen3-Next: GDN layers
# with gated attention every few, dense or routed MLPs, a vision tower, and
# their drafters. Qwen3.5-397B-A17B's configuration is Ornith-1.5's, so an
# import reads either as Qwen3.5 unless told `--deployment ornith15-397b-...`. Ternary-Bonsai 27B and the test geometries are unlisted models of
# it that tests trace and import by id.

load("//pie/codec.poem", "bank", "kept", read_fused = "fused", read_weight = "weight")
load("//lib/adapters.poem", "banks", "corrected")
load("//lib/dflash.poem", "bind_aux", "arm", "block_rows", "plant_readout", "tap", "markov", "selector", dflash_caches = "caches", dflash_declare = "declare", dflash_head = "head")
load("//lib/media.poem", "smart_resize")
load("//lib/qwen.poem", "SMALL", "LARGE", "PATCH", "MERGE", "tower", "read_tower", "run_tower", "scatter", "positions", "rope", "routed", "draft_attn", "norm_of")
load("//lib/reads.poem", "squeezed")
load("//lib/rope.poem", "yarn")
load("//lib/spoken.poem", "QWEN_STOP", "QWEN_VISION", "QWEN_AUDIO")

# Qwen 3.5, 3.6 and 3.8 templates end a thinking request's prompt inside an open `<think>`.
THINKING_CUE = "<think>\n"
CHATML = template("chatml", thinking = True, tools = True, xml_tools = True, generation_suffix = THINKING_CUE, stop = QWEN_STOP)
CHATML_INTERLEAVED = template("chatml", thinking = True, preserve_thinking = True, tools = True, generation_suffix = THINKING_CUE, stop = QWEN_STOP)
# Qwen3.8's template opens a thinking request's system turn with its reasoning-effort instruction.
CHATML_QWEN38 = template("chatml", thinking = True, preserve_thinking = True, reasoning_effort = True, tools = True, xml_tools = True, generation_suffix = THINKING_CUE, stop = QWEN_STOP)
# Qwen3-Next's Instruct and Thinking releases share one configuration; its
# Instruct template's cue opens no thinking block.
CHATML_NEXT = template("chatml", thinking = True, tools = True, stop = QWEN_STOP)
TOKENIZER = tokenizer(markers = [QWEN_STOP], parts = {"vision": [QWEN_VISION]})
TOKENIZER_38 = tokenizer(markers = [QWEN_STOP], pinned = QWEN_AUDIO, parts = {"vision": [QWEN_VISION]})

def qwen(id, layers, vocab = 248320, template = CHATML, tokenizer = TOKENIZER, **kwargs):
    return model(id, template = template, tokenizer = tokenizer, arch = "qwen3_5", layers = layers, vocab = vocab, **kwargs)

def fixture(id, **kwargs):
    return model(id, mini = True, template = CHATML, tokenizer = TOKENIZER, **kwargs)

