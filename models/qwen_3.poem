                       v_dim = 128, mlp = dense(6144), vocab = 248320, tied = True),
    "qwen35-d3b": dims(hidden = 2048, layers = 24, attn_every = 4, q_heads = 16, kv_heads = 2,
                       head_dim = 256, rotary_dim = 64, k_heads = 16, v_heads = 32, k_dim = 128,
                       v_dim = 128, mlp = dense(8192), vocab = 151936, tied = True),
    "qwen35-d4b": dims(hidden = 2560, layers = 32, attn_every = 4, q_heads = 16, kv_heads = 4,
                       head_dim = 256, rotary_dim = 64, k_heads = 16, v_heads = 32, k_dim = 128,
                       v_dim = 128, mlp = dense(9216), vocab = 248320, tied = True),
    "qwen35-a3b": a3b(),
    "qwen35-tiny": dims(hidden = 256, layers = 4, attn_every = 4, q_heads = 4, kv_heads = 2,
                        head_dim = 64, rotary_dim = 32, k_heads = 4, v_heads = 8, k_dim = 128,
                        v_dim = 128, mlp = dense(512), vocab = 248320, tied = True),
    # Every weight, pool and activation of a fire fits one Cerebras PE.
    "qwen35-pico": dims(hidden = 16, layers = 2, attn_every = 2, q_heads = 1, kv_heads = 1,
                        head_dim = 8, rotary_dim = 4, theta = 10000.0, k_heads = 1, v_heads = 1,
                        k_dim = 8, v_dim = 8, mlp = dense(32), vocab = 32, tied = True),
    "qwen36-35b-a3b-mini": a3b(layers = 5, mlp = moe(16, 8, 512, 512)),
    "qwen36-35b-a3b-mini64": a3b(layers = 5, mlp = moe(64, 8, 512, 512)),
    "ornith15-397b-mini": a17b(layers = 5, mlp = moe(16, 10, 1024, 1024)),
    "qwen35-122b-a10b": a10b(),
    "qwen35-122b-a10b-mini": a10b(layers = 8, mlp = moe(16, 8, 1024, 1024)),
    "qwen3-next-80b-a3b": next80b(),
    "qwen3-next-80b-a3b-mini": next80b(layers = 8, mlp = moe(16, 10, 512, 512)),
    "qwen38-max": a95b(),
    "qwen38-max-mini": a95b(layers = 5, mlp = moe(16, 10, 2048, 2048)),
    "qwen3-a3b-micro": dims(hidden = 512, layers = 4, attn_every = 1, q_heads = 8, kv_heads = 2,
                            head_dim = 64, rotary_dim = 64, k_heads = 8, v_heads = 8, k_dim = 64,
                            v_dim = 64, mlp = moe(32, 4, 128, 128), vocab = 2048, tied = True),
    "qwen3-a3b-uncached-bank": dims(hidden = 2048, layers = 1, attn_every = 1, q_heads = 8,
                                    kv_heads = 2, head_dim = 64, rotary_dim = 64, k_heads = 8,
                                    v_heads = 8, k_dim = 64, v_dim = 64,
                                    mlp = moe(32, 4, 512, 512), vocab = 2048, tied = True),
    "qwen3-micro-text": micro_text(64, False),
    "qwen3-micro-text-rotated": micro_text(64, True),
    "qwen3-micro-text-hd128": micro_text(128, False),
    "qwen3-micro-text-hd128-rotated": micro_text(128, True),
    "qwen3-micro-text-hd256": micro_text(256, False),
    "qwen3-micro-text-hd256-rotated": micro_text(256, True),
    "qwen36-27b-bonsai": d27b(),
}

def d9b(**over):
    d = dims(hidden = 4096, layers = 32, attn_every = 4, q_heads = 16, kv_heads = 4, head_dim = 256,
             rotary_dim = 64, k_heads = 16, v_heads = 32, k_dim = 128, v_dim = 128,
             mlp = dense(12288), vocab = 248320, tied = False)
    d.update(over)
    return d

def drafting(id, draft):
    return {"draft": draft, "dflash_head": HEADS["{}-{}".format(id, draft)]}

# The models that draft or carry a tower, by id and drafter: the dims they
# build, the tower a vision deployment adds, and what they override.
DRAFTED = {
    ("qwen36-27b", None): (d27b, LARGE, {}),
    ("qwen38-27b", None): (d27b, LARGE, {}),
    ("qwen36-27b", "mtp"): (d27b, LARGE, {"draft": "mtp"}),
    ("qwen38-27b", "mtp"): (d27b, LARGE, {"draft": "mtp"}),
    ("qwen36-27b", "dflash"): (d27b, None, drafting("qwen36-27b", "dflash")),
    ("qwen38-27b", "dflash2"): (d27b, None, drafting("qwen38-27b", "dflash2")),
    ("qwen38-27b", "dspark"): (d27b, None, drafting("qwen38-27b", "dspark")),
    ("ornith15-397b", None): (a17b, LARGE, {}),
    ("qwen35-397b-a17b", None): (a17b, LARGE, {}),
    ("qwen35-d9b", None): (d9b, None, {}),
    ("qwen35-d9b", "dflash"): (d9b, None, drafting("qwen35-d9b", "dflash")),
    ("qwen36-35b-a3b", None): (a3b, None, {}),
    ("qwen36-35b-a3b", "mtp"): (a3b, None, {"draft": "mtp"}),
    ("qwen36-35b-a3b", "dflash"): (a3b, None, drafting("qwen36-35b-a3b", "dflash")),
    ("qwen36-35b-a3b", "dflash2"): (a3b, None, drafting("qwen36-35b-a3b", "dflash2")),
}

def drafted(id, deploy):
    """The dims `id` builds for `deploy`'s parts and drafter; a model
    `DRAFTED` names none of drafts with nothing and has no tower."""
    vision = "vision" in deploy.parts
    if id == "qwen35-d0.8b":
        return d0_8b(tower = SMALL if vision else None, draft = deploy.drafter)
    build, tower, over = DRAFTED.get((id, deploy.drafter), (None, None, {}))
    if vision and tower == None or build == None and deploy.drafter != None:
        fail("{} does not ship {}".format(id, deploy))
    if build == None:
        return dict(FIXED[id])
    return build(tower = tower if vision else None, **over)

def dense_mlp(w, hidden, inter, prefix, t = UNTURNED):
    n = lambda s: "{}.{}".format(prefix, s)
    return struct(
        routed = False,
        gate = t.hidden(weight([inter, hidden], w)),
        up = t.hidden(weight([inter, hidden], w)),
        down = t.ffn_down(weight([hidden, inter], w)),
        inter = inter,
    )

def modelopt_mix(weights):
    """modelopt's mixed export (nvidia/Qwen3.6-*-NVFP4) as vLLM serves it:
    experts, shared expert, dense MLP and head NVFP4 against bf16 rows
    (`W4A16_NVFP4`), or the experts against NVFP4 rows; attention and GDN
    projections e4m3 under one scale, read as 128-square blocks against e4m3
    rows; the rest bf16. `None` for any other list."""
    if len(weights) != 3 or weights[0] != dtype.bf16 or weights[2] != dtype.e4m3tile128a8:
        return None
    if weights[1] not in [dtype.nvfp4, dtype.nvfp4a4]:
        return None
    return struct(experts = weights[1], mlp = dtype.nvfp4, proj = weights[2])

def layout(id, deploy):
    mix = modelopt_mix(deploy.weights)
    if len(deploy.weights) != 1 and mix == None:
        fail("{} stores its weights at one dtype, or as modelopt's mix [bf16, nvfp4, e4m3tile128a8], not {}".format(id, deploy.weights))
    w = deploy.weights[0]
    d = struct(**drafted(id, deploy))
    if mix != None and d.draft != None:
        fail("{}: modelopt's export ships no draft head".format(id))
    bonsai = id == "qwen36-27b-bonsai"
    dense = compute(w)
    # The release's FP8 (Qwen3.6-35B-A3B-FP8) as vLLM serves it: projections
    # and experts as stored, 128-square blocks against e4m3 activations; its
    # table, head, router, gates and GDN beta/alpha, unquantized, at bf16.
    fp8 = w in [dtype.e4m3tile128, dtype.e4m3tile128a8]
    table = dtype.bf16 if fp8 else w
    gate = dtype.u8g64 if w == dtype.u4g64 else table
    proj = w
    experts = w
    mlp_at = proj
    head_at = proj if table == w else table
    if mix != None:
        proj = mix.proj
        experts = mix.experts
        mlp_at = mix.mlp
        head_at = mix.mlp
    hidden = d.hidden
    attn_at = lambda l: l % d.attn_every == d.attn_every - 1
    # Ternary-Bonsai stores its projections, table and head rotated against
    # turned inputs, each input's turn by its width's sign diagonal.
    signs = None
    if bonsai:
        sign = lambda width: weight([1, width])
        signs = struct(
            hidden = sign(BONSAI_WIDTHS.hidden),
            ssm = sign(BONSAI_WIDTHS.ssm),
            ffn_down = sign(BONSAI_WIDTHS.ffn_down),
        )
    t = turns(signs) if bonsai else UNTURNED

    def layer(l):
        n = lambda s: "layer.{}.{}".format(l, s)
        norm = lambda s, dim: weight([dim])
        lora_a, lora_b = banks(hidden)
        attn = None
        delta = None
        if attn_at(l):
            attn = gated_attn(d, proj, "kv.{}".format(l), t)
        else:
            # Ternary-Bonsai stores the GDN beta/alpha projections in bf16,
            # not ternary: they are served as stored.
            # The FP8 release keeps them unquantized, as does its router.
            ba = dense if bonsai or fp8 or mix != None else proj
            delta = gdn(d, proj, ba, dense, "conv.{}".format(l), "delta.{}".format(l), t)
        if d.mlp.routed:
            mlp = routed(n, hidden, d.mlp, experts, mlp_at, gate)
        else:
            mlp = dense_mlp(mlp_at, hidden, d.mlp.inter, "layer.{}".format(l), t)
        return struct(
            attn = attn,
            gdn = delta,
            mixer_norm = norm("mixer_norm", hidden),
            mixer_norm_eps = d.norm_eps,
            mlp_norm = norm("mlp_norm", hidden),
            mlp_norm_eps = d.norm_eps,
            mlp = mlp,
            lora_a = lora_a,
            lora_b = lora_b,
        )

    visual = tower(d.tower, hidden, dense) if d.tower != None else None

    blocks = ["dflash", "dflash2", "dspark"]
    mtp = None
    if d.draft != None and d.draft not in blocks:
        inter = d.mlp.inter
        p = "mtp" if d.draft == "mtp" else "aux"
        mtp = struct(
            prefix = p,
            pre_fc = struct(
                embedding = weight([hidden]),
                hidden = weight([hidden]),
                eps = d.norm_eps,
            ) if d.draft == "mtp" else None,
            fc_embed = weight([hidden, hidden], w),
            fc_hidden = weight([hidden, hidden], w),
            mixer_norm = weight([hidden]),
            mixer_norm_eps = d.norm_eps,
            attn = gated_attn(d, w, "kv.mtp"),
            mlp_norm = weight([hidden]),
            mlp_norm_eps = d.norm_eps,
            mlp = dense_mlp(w, hidden, inter, p),
            norm = weight([hidden]) if d.draft == "mtp" else None,
            norm_eps = d.norm_eps,
        )
    dflash = None
    if d.draft in blocks:
        dflash = dflash_declare(d.dflash_head, "aux", hidden, d.vocab, d.norm_eps, w, dense, blocks_w = proj)

    # Ternary-Bonsai's token embedding is gathered whole, which no ternary
    # kernel does: it is served decoded.
    embed = t.hidden(weight([d.vocab, hidden], dense if bonsai else table))
    head = None
    if not d.tied:
        head = t.hidden(weight([d.vocab, hidden], head_at))
    return struct(
        hidden = hidden,
        vocab = d.vocab,
        q_heads = d.q_heads,
        kv_heads = d.kv_heads,
        head_dim = d.head_dim,
        rotate_kv = d.rotate_kv,
        kv = deploy.kv,
        # The native 262144 tokens a deployment's YaRN stretches (the cards:
        # factor 4 toward a million).
        rope = yarn(deploy, 262144),
        embed = embed,
        head = head,
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight([hidden]),
        final_norm_eps = d.norm_eps,
        tower = visual,
        mtp = mtp,
        dflash = dflash,
        bonsai = signs,
    )

# How a Qwen 3.5 / 3.6 / 3.8 checkpoint is laid out: transformers', mlx_lm's
# (its norms stored less one) and GGUF's spellings. Ternary-Bonsai's GGUF
# also states its rotation's sign diagonals in its metadata, which its
# contract carries as constants.

# The Bonsai GGUF's rotation metadata.

LAYOUTS = [
    struct(
        name = "transformers",
        trunk = "model.language_model.",
        head = "lm_head.weight",
        tower = "model.visual.",
        mlx = False,
        config = "text_config.",
    ),
    struct(
        name = "transformers_text",
        trunk = "model.",
        head = "lm_head.weight",
        tower = None,
        mlx = False,
        config = "",
    ),
    struct(
        name = "mlx_lm",
        trunk = "language_model.model.",
        head = "language_model.lm_head.weight",
        tower = "vision_tower.",
        mlx = True,
        config = "text_config.",
    ),
]

# Qwen3-Next's release: transformers' names under `model.`, each GDN's q, k,
# v and z (and its beta and alpha) one projection interleaved a key head at a
# time, and each expert apart.
NEXT_QKVZ = "model.layers.0.linear_attn.in_proj_qkvz.weight"

def safetensors_format(layout, read, states = []):
    """`layout`'s format, recognized by its embedding: `read(reads, layout)`."""
    return format(
        layout.name,
        recognizes = lambda checkpoint: has(layout.trunk + "embed_tokens.weight") and not has(NEXT_QKVZ),
        read = lambda reads: read(reads, layout),
        states = states,
    )

def read_attn(reads, a, n, norm):
    read_weight(reads, a.qg_proj, n("self_attn.q_proj.weight"), quantized = "read")
    read_weight(reads, a.k_proj, n("self_attn.k_proj.weight"), quantized = "read")
    read_weight(reads, a.v_proj, n("self_attn.v_proj.weight"), quantized = "read")
    read_weight(reads, a.o_proj, n("self_attn.o_proj.weight"), quantized = "read")
    reads.read_expr(a.q_norm, norm(n("self_attn.q_norm.weight")))
    reads.read_expr(a.k_norm, norm(n("self_attn.k_norm.weight")))

def read_gdn(reads, g, n):
    read_weight(reads, g.in_qkv, n("linear_attn.in_proj_qkv.weight"), quantized = "read")
    read_weight(reads, g.in_z, n("linear_attn.in_proj_z.weight"), quantized = "read")
    reads.read(g.in_b, n("linear_attn.in_proj_b.weight"))
    reads.read(g.in_a, n("linear_attn.in_proj_a.weight"))
    reads.read_expr(g.conv, squeezed(n("linear_attn.conv1d.weight")))
    reads.read(g.dt_bias, n("linear_attn.dt_bias"))
    reads.read(g.a_log, n("linear_attn.A_log"))
    reads.read(g.norm, n("linear_attn.norm.weight"))
    read_weight(reads, g.out_proj, n("linear_attn.out_proj.weight"), quantized = "read")

def read_routed(reads, f, n, layout):
    reads.read(f.router, n("mlp.gate.weight"))
    if layout.mlx:
        reads.read(f.gate, n("mlp.switch_mlp.gate_proj.weight"))
        reads.read(f.up, n("mlp.switch_mlp.up_proj.weight"))
        reads.read(f.down, n("mlp.switch_mlp.down_proj.weight"))
    elif kept(f.gate):
        # A quantized release stores each expert apart.
        e = lambda i, s: n("mlp.experts.{}.{}.weight".format(i, s))
        bank(reads, f.gate, [[e(i, "gate_proj")] for i in range(f.experts)])
        bank(reads, f.up, [[e(i, "up_proj")] for i in range(f.experts)])
        bank(reads, f.down, [[e(i, "down_proj")] for i in range(f.experts)])
    else:
        # The release stores each expert's gate rows, then its up rows.
        read_fused(reads, [f.gate, f.up], n("mlp.experts.gate_up_proj"), axis = 1)
        reads.read(f.down, n("mlp.experts.down_proj"))
    read_weight(reads, f.shared.gate, n("mlp.shared_expert.gate_proj.weight"), quantized = "read")
    read_weight(reads, f.shared.up, n("mlp.shared_expert.up_proj.weight"), quantized = "read")
    read_weight(reads, f.shared_down, n("mlp.shared_expert.down_proj.weight"), quantized = "read")
    reads.read(f.shared_gate, n("mlp.shared_expert_gate.weight"))

BLOCK_SIZE_KEY = "prism.hadamard.block_size"
SIGN_MODE_KEY = "prism.hadamard.sign_mode"
SIGN_WIDTHS_KEY = "prism.hadamard.sign_widths"
SIGN_VALUES_KEY = "prism.hadamard.sign_values"
GDN_V_GROUPED_KEY = "prism.hadamard.gdn_v_grouped"

def formats(m):
    if m.bonsai != None:
        return [format(
            "gguf",
            recognizes = lambda checkpoint: attribute_value(SIGN_VALUES_KEY) != None,
            read = lambda reads: gguf(m, reads),
        )]
    arch = text_attribute("general.architecture") or ""
    return [
        safetensors_format(
            layout,
            lambda reads, layout: safetensors(m, reads, layout),
            configured(m, layout.config),
        )
        for layout in LAYOUTS
    ] + [
        format(
            "qwen3_next",
            recognizes = lambda checkpoint: has(NEXT_QKVZ),
            read = lambda reads: qwen3_next(m, reads),
            states = configured_next(m),
        ),
        format(
            "gguf",
            recognizes = lambda checkpoint: text_attribute("general.architecture") != None,
            read = lambda reads: gguf(m, reads),
            states = attributed(m, arch),
        ),
    ]

def theta(m):
    for w in m.layers:
        if w.attn != None:
            return w.attn.theta
    return None

def configured(m, at):
    """The shape a transformers configuration states of this model, its text
    model's keys under `at`."""
    states = [
        config(at + "hidden_size", m.hidden),
        config(at + "vocab_size", m.vocab),
        config(at + "num_attention_heads", m.q_heads),
        config(at + "num_key_value_heads", m.kv_heads),
        config(at + "head_dim", m.head_dim),
        config(at + "num_hidden_layers", len(m.layers), or_deeper = True),
        config(at + "rms_norm_eps", m.final_norm_eps),
    ]
    if theta(m) != None:
        states.append(config(at + "rope_parameters.rope_theta", theta(m)))
    return states

def configured_next(m):
    """The shape Qwen3-Next's configuration states, its theta at the top."""
    states = [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("head_dim", m.head_dim),
        config("num_hidden_layers", len(m.layers), or_deeper = True),
        config("rms_norm_eps", m.final_norm_eps),
    ]
    if theta(m) != None:
        states.append(config("rope_theta", theta(m)))
    return states

def next_gdn(reads, g, n):
    """A Qwen3-Next GDN: `in_proj_qkvz` holds, a key head at a time, that
    head's q, its k, and its group's v and z heads; `in_proj_ba` its group's
    betas then alphas. Each is gathered into the block order the scan reads
    (every q, every k, every v, every z; every beta, every alpha)."""
    k_w, v_g = g.k_dim, (g.v_heads // g.k_heads) * g.v_dim
    stride = 2 * k_w + 2 * v_g
    pick = lambda at, width: [h * stride + at + i for h in range(g.k_heads) for i in range(width)]
    qkvz = n("linear_attn.in_proj_qkvz.weight")
    read_weight(reads, g.in_qkv, qkvz, rows = pick(0, k_w) + pick(k_w, k_w) + pick(2 * k_w, v_g), quantized = "read")
    read_weight(reads, g.in_z, qkvz, rows = pick(2 * k_w + v_g, v_g), quantized = "read")
    per = g.v_heads // g.k_heads
    ba_pick = lambda at: [h * 2 * per + at + i for h in range(g.k_heads) for i in range(per)]
    ba = src(n("linear_attn.in_proj_ba.weight"))
    reads.read_expr(g.in_b, ba.gather(0, ba_pick(0)))
    reads.read_expr(g.in_a, ba.gather(0, ba_pick(per)))
    reads.read_expr(g.conv, squeezed(n("linear_attn.conv1d.weight")))
    reads.read(g.dt_bias, n("linear_attn.dt_bias"))
    reads.read(g.a_log, n("linear_attn.A_log"))
    reads.read(g.norm, n("linear_attn.norm.weight"))
    read_weight(reads, g.out_proj, n("linear_attn.out_proj.weight"), quantized = "read")

def qwen3_next(m, reads):
    if m.tower != None or m.mtp != None:
        fail("Qwen3-Next ships no vision tower, and its draft head is not read here")
    norm = lambda name: src(name)
    reads.read(m.embed, "model.embed_tokens.weight")
    reads.read(m.final_norm, "model.norm.weight")
    reads.read(m.head, "lm_head.weight")
    for l, w in enumerate(m.layers):
        n = lambda s: "model.layers.{}.{}".format(l, s)
        reads.read(w.mixer_norm, n("input_layernorm.weight"))
        reads.read(w.mlp_norm, n("post_attention_layernorm.weight"))
        if w.attn != None:
            read_attn(reads, w.attn, n, norm)
        else:
            next_gdn(reads, w.gdn, n)
        f = w.mlp
        reads.read(f.router, n("mlp.gate.weight"))
        e = lambda i, s: n("mlp.experts.{}.{}.weight".format(i, s))
        for held, leg in [(f.gate, "gate_proj"), (f.up, "up_proj"), (f.down, "down_proj")]:
            bank(reads, held, [[e(i, leg)] for i in range(f.experts)])
        read_weight(reads, f.shared.gate, n("mlp.shared_expert.gate_proj.weight"), quantized = "read")
        read_weight(reads, f.shared.up, n("mlp.shared_expert.up_proj.weight"), quantized = "read")
        read_weight(reads, f.shared_down, n("mlp.shared_expert.down_proj.weight"), quantized = "read")
        reads.read(f.shared_gate, n("mlp.shared_expert_gate.weight"))

def attributed(m, arch):
    """The shape a GGUF's metadata states of this model, under `arch`."""
    states = [
        attribute(arch + ".embedding_length", m.hidden),
        attribute(arch + ".block_count", len(m.layers), or_deeper = True),
        attribute(arch + ".attention.head_count", m.q_heads),
        attribute(arch + ".attention.head_count_kv", m.kv_heads),
    ]
    if theta(m) != None:
        states.append(attribute(arch + ".rope.freq_base", theta(m)))
    return states

def spelled(names):
    """The first of `names` the checkpoint holds, or `None`."""
    for name in names:
        if has(name):
            return name
    return None

def held(names):
    """The first of `names` the checkpoint holds, which it must."""
    name = spelled(names)
    if name == None:
        # The checkpoint's refusal names every spelling.
        shape("` or `".join(names))
    return name

def safetensors(m, reads, layout):
    norm = norm_of(layout)
    reads.read(m.embed, layout.trunk + "embed_tokens.weight")
    reads.read_expr(m.final_norm, norm(layout.trunk + "norm.weight"))
    if m.head != None:
        reads.read(m.head, layout.head)

    for l, w in enumerate(m.layers):
        n = lambda s: "{}layers.{}.{}".format(layout.trunk, l, s)
        reads.read_expr(w.mixer_norm, norm(n("input_layernorm.weight")))
        reads.read_expr(w.mlp_norm, norm(n("post_attention_layernorm.weight")))
        if w.attn != None:
            read_attn(reads, w.attn, n, norm)
        else:
            read_gdn(reads, w.gdn, n)
        if w.mlp.routed:
            read_routed(reads, w.mlp, n, layout)
        else:
            reads.read(w.mlp.gate, n("mlp.gate_proj.weight"))
            reads.read(w.mlp.up, n("mlp.up_proj.weight"))
            reads.read(w.mlp.down, n("mlp.down_proj.weight"))

    if m.tower != None:
        if layout.tower == None:
            fail("a {} checkpoint holds no vision tower; import this deployment without it".format(layout.name))
        read_tower(reads, m.tower, layout.tower, layout.mlx)

    if m.mtp != None:
        mtp = m.mtp
        p = "aux" if has("aux.fc.weight") or has("aux.fc_embed.weight") else mtp.prefix
        n = lambda s: "{}.layers.0.{}".format(p, s)
        if mtp.pre_fc != None:
            reads.read(mtp.pre_fc.embedding, p + ".pre_fc_norm_embedding.weight")
            reads.read(mtp.pre_fc.hidden, p + ".pre_fc_norm_hidden.weight")
        if has(p + ".fc_embed.weight"):
            reads.read(mtp.fc_embed, p + ".fc_embed.weight")
            reads.read(mtp.fc_hidden, p + ".fc_hidden.weight")
        else:
            half = mtp.fc_embed.shape[1]
            reads.read_expr(mtp.fc_embed, src(p + ".fc.weight").slice(1, 0, half))
            reads.read_expr(mtp.fc_hidden, src(p + ".fc.weight").slice(1, half, half))
        a = mtp.attn
        reads.read(mtp.mixer_norm, n("input_layernorm.weight"))
        reads.read(a.qg_proj, n("self_attn.q_proj.weight"))
        reads.read(a.k_proj, n("self_attn.k_proj.weight"))
        reads.read(a.v_proj, n("self_attn.v_proj.weight"))
        reads.read(a.o_proj, n("self_attn.o_proj.weight"))
        reads.read(a.q_norm, n("self_attn.q_norm.weight"))
        reads.read(a.k_norm, n("self_attn.k_norm.weight"))
        reads.read(mtp.mlp_norm, n("post_attention_layernorm.weight"))
        reads.read(mtp.mlp.gate, n("mlp.gate_proj.weight"))
        reads.read(mtp.mlp.up, n("mlp.up_proj.weight"))
        reads.read(mtp.mlp.down, n("mlp.down_proj.weight"))
        if mtp.norm != None:
            reads.read(mtp.norm, p + ".norm.weight")

    if m.dflash != None:
        bind_aux(m.dflash, reads, norm)

def v_head_reorder_rows(prefix, heads, width, k_heads, rep):
    """The rows that reorder a GDN tensor's v-heads from a GGUF's tiled
    ("v-grouped") layout into the block layout the scan pairs by: a v-head at
    block position `p` lives at tiled index `(p % rep) * k_heads + p // rep`;
    `prefix` leading rows (the fused q and k) pass through."""
    idx = list(range(prefix))
    for p in range(heads):
        base = prefix + ((p % rep) * k_heads + p // rep) * width
        idx.extend(range(base, base + width))
    return idx

def gguf(m, reads):
    if m.tower != None:
        fail("this deployment declares a vision tower and no GGUF spelling of one is settled; import it from the safetensors checkpoint")
    if m.mtp != None:
        fail("this deployment declares an MTP draft head and no GGUF spelling of one is settled; import it from the safetensors checkpoint")
    minus_one = lambda e: e.bias(-1.0)
    # llama.cpp's qwen35 converters store the GDN v-heads tiled, for ggml's
    # broadcast; the reads reorder every v-head-indexed tensor to the block
    # order the scan pairs by. A Hadamard-folded out_proj (Ternary-Bonsai's,
    # `gdn_v_grouped`) keeps its columns in block order.
    out_grouped = attribute_value(GDN_V_GROUPED_KEY) == True
    tiled = out_grouped or text_attribute("general.architecture") in ["qwen35", "qwen35moe"]

    reads.read(m.embed, "token_embd.weight")
    reads.read_over(m.final_norm, "output_norm.weight", minus_one)
    if m.head != None:
        reads.read(m.head, held(["output.weight", "token_embd.weight"]))

    for l, w in enumerate(m.layers):
        n = lambda s: "blk.{}.{}".format(l, s)
        reads.read_over(w.mixer_norm, n("attn_norm.weight"), minus_one)
        reads.read_over(w.mlp_norm, held([n("ffn_norm.weight"), n("post_attention_norm.weight")]), minus_one)
        if w.attn != None:
            a = w.attn
            reads.read(a.qg_proj, n("attn_q.weight"))
            reads.read(a.k_proj, n("attn_k.weight"))
            reads.read(a.v_proj, n("attn_v.weight"))
            reads.read(a.o_proj, n("attn_output.weight"))
            reads.read_over(a.q_norm, n("attn_q_norm.weight"), minus_one)
            reads.read_over(a.k_norm, n("attn_k_norm.weight"), minus_one)
        else:
            g = w.gdn
            k_w = 2 * g.k_heads * g.k_dim
            heads = g.v_heads
            width = g.v_dim
            rep = heads // g.k_heads
            untile = tiled and rep > 1   # one v-head per k-head is the same either way
            sigma = lambda prefix, width: v_head_reorder_rows(prefix, heads, width, g.k_heads, rep)

            # `ssm_in` is qkv's rows, then z's.
            fused = spelled([n("ssm_in.weight")])
            z_base = k_w + heads * width
            if fused != None and untile:
                rows = sigma(k_w, width) + [z_base + i for i in sigma(0, width)]
                read_fused(reads, [g.in_qkv, g.in_z], fused, rows = rows)
            elif fused != None:
                read_fused(reads, [g.in_qkv, g.in_z], fused)
            elif untile:
                reads.read_expr(g.in_qkv, src(n("attn_qkv.weight")).gather(0, sigma(k_w, width)))
                reads.read_expr(g.in_z, src(n("attn_gate.weight")).gather(0, sigma(0, width)))
            else:
                reads.read(g.in_qkv, n("attn_qkv.weight"))
                reads.read(g.in_z, n("attn_gate.weight"))

            # `ssm_beta_alpha` is the betas' rows, then the alphas'.
            fused = spelled([n("ssm_beta_alpha.weight")])
            idx = sigma(0, 1)
            if fused != None and untile:
                read_fused(reads, [g.in_b, g.in_a], fused, rows = idx + [len(idx) + i for i in idx])
            elif fused != None:
                read_fused(reads, [g.in_b, g.in_a], fused)
            else:
                for leg, name in [(g.in_b, n("ssm_beta.weight")), (g.in_a, n("ssm_alpha.weight"))]:
                    if untile:
                        reads.read_expr(leg, src(name).gather(0, idx))
                    else:
                        reads.read(leg, name)
            if untile:
                reads.read_expr(g.conv, src(n("ssm_conv1d.weight")).gather(0, sigma(k_w, width)))
                reads.read_expr(g.dt_bias, src(n("ssm_dt.bias")).gather(0, sigma(0, 1)))
            else:
                reads.read(g.conv, n("ssm_conv1d.weight"))
                reads.read(g.dt_bias, n("ssm_dt.bias"))
            logarithm = spelled([n("ssm_a_log")])
            if logarithm != None and untile:
                reads.read_expr(g.a_log, src(logarithm).gather(0, sigma(0, 1)))
            elif logarithm != None:
                reads.read(g.a_log, logarithm)
            elif has(n("ssm_a")):
                a = src(n("ssm_a"))
                if untile:
                    a = a.gather(0, sigma(0, 1))
                reads.read_expr(g.a_log, a.unary("neg_ln"))
            else:
                held([n("ssm_a_log")])
            reads.read(g.norm, n("ssm_norm.weight"))
            if untile and not out_grouped:
                reads.read_expr(g.out_proj, src(n("ssm_out.weight")).gather(1, sigma(0, width)))
            else:
                reads.read(g.out_proj, n("ssm_out.weight"))

        f = w.mlp
        if not f.routed:
            reads.read(f.gate, n("ffn_gate.weight"))
            reads.read(f.up, n("ffn_up.weight"))
            reads.read(f.down, n("ffn_down.weight"))
        else:
            reads.read(f.router, n("ffn_gate_inp.weight"))
            reads.read(f.gate, n("ffn_gate_exps.weight"))
            reads.read(f.up, n("ffn_up_exps.weight"))
            reads.read(f.down, n("ffn_down_exps.weight"))
            reads.read(f.shared.gate, n("ffn_gate_shexp.weight"))
            reads.read(f.shared.up, n("ffn_up_shexp.weight"))
            reads.read(f.shared_down, n("ffn_down_shexp.weight"))
            reads.read(f.shared_gate, n("ffn_gate_inp_shexp.weight"))

    if m.bonsai != None:
        signs = decode_signs()
        for sign in [m.bonsai.hidden, m.bonsai.ssm, m.bonsai.ffn_down]:
            width = sign.shape[1]
            if width not in signs:
                fail("the Bonsai GGUF states no sign diagonal {} wide".format(width))
            reads.read_expr(sign, constant(sign.name, signs[width], sign.shape, sign.dtype))

def decode_signs():
    """The sign diagonals a Ternary-Bonsai GGUF's metadata states, keyed by
    width: `sign_values` cut into runs of `sign_widths`, each a whole number
    of 1024-wide Hadamard blocks, every value exactly +1 or -1."""
    mode = attribute_value(SIGN_MODE_KEY)
    if mode == "identity":
        return {}
    if mode not in [None, "explicit"]:
        fail("{} `{}` is not identity|explicit".format(SIGN_MODE_KEY, mode))
    block = attribute_value(BLOCK_SIZE_KEY)
    if block != 1024:
        fail("{} is {}, and the Bonsai rotation is 1024 wide".format(BLOCK_SIZE_KEY, block))
    widths = attribute_value(SIGN_WIDTHS_KEY)
    values = attribute_value(SIGN_VALUES_KEY)
    if type(widths) != "list" or type(values) != "list":
        fail("the Bonsai GGUF states no {} and {}".format(SIGN_WIDTHS_KEY, SIGN_VALUES_KEY))
    out = {}
    at = 0
    for width in widths:
        if width <= 0 or width % block != 0 or at + width > len(values):
            fail("prism.hadamard: invalid sign width {}".format(width))
        run = values[at:at + width]
        for k, v in enumerate(run):
            if v != 1 and v != -1:
                fail("prism.hadamard: sign {} of width {} is {}, not +/-1".format(k, width, v))
        out[width] = [float(v) for v in run]
        at += width
    if at != len(values):
        fail("prism.hadamard.sign_values length mismatch: widths consume {} of {}".format(at, len(values)))
    return out

# The forward of Qwen 3.5 / 3.6 / 3.8: gated-delta mixers walking their
# recurrence, gated attention every few layers, a dense or routed MLP; a
# vision tower's rows scattered into the embedding; the drafters'
# proposals. Ternary-Bonsai's weights are stored rotated, so its forward turns
# each rotated projection's input by the same Hadamard and signs; the KV-
# rotated geometries turn their attention's q, k and v by a Hadamard.

def run_moe(x, f):
    """The routed MLP: `f.top_k` of `f.experts`, plus the gated shared expert."""
    experts, weights = ops.linear.moe_route(
        ops.linear.matmul(x, f.router),
        f.experts,
        f.top_k,
        routing.softmax(),
    )

    gate = ops.linear.moe_matmul_select(x, f.gate, experts, f.top_k)
    hidden = ops.linear.glu(gate, gating.swiglu(), up = ops.linear.moe_matmul_select(x, f.up, experts, f.top_k))
    routed = ops.linear.moe_weighted_sum(ops.linear.moe_matmul_select(hidden, f.down, experts, f.top_k), weights)
    gate, up = ops.linear.matmul(x, f.shared.gate), ops.linear.matmul(x, f.shared.up)
    shared = ops.linear.matmul(ops.linear.glu(gate, gating.swiglu(), up = up), f.shared_down)
    return ops.linear.moe_sigmoid_gate_add(routed, shared, ops.linear.matmul(x, f.shared_gate))

def caches(m, c):
    kv = c.kv_space(m.kv)
    plane = m.kv_heads * m.head_dim
    for w in m.layers:
        if w.attn != None:
            c.kv(kv, w.attn.kv, [plane, plane], m.head_dim, heads = True)
        else:
            g = w.gdn
            c.state(g.conv_state, [g.conv_kernel, g.qkv_width], dtype.bf16, split = 1)
            c.state(g.delta_state, [g.v_heads, g.k_dim, g.v_dim], dtype.bf16, split = 0)
    if m.mtp != None:
        c.kv(kv, m.mtp.attn.kv, [plane, plane], m.head_dim, heads = True)
    if m.dflash != None:
        dflash_caches(m.dflash, c, kv)

def forward(m, inputs):
    dr = m.dflash
    if dr != None:
        switch("block_draft", ["off", "on"])
    trunk_inputs = inputs.on(~block_rows(dr)) if dr != None else inputs

    towered = run_tower(inputs, m.tower) if m.tower != None else None

    ids = inputs.tokens()
    y = ops.gather.embed(ids, m.embed, m.vocab)

    if towered != None:
        y = scatter(y, towered, inputs)

    h_block = None
    if dr != None:
        h_block = y.on(block_rows(dr))
        y = y.on(~block_rows(dr))

    routes = inputs.adapter_routes()

    def block(l, w, carried):
        y, fused = carried
        x = ops.elemwise.rmsnorm_plus_one(y, w.mixer_norm, w.mixer_norm_eps)
        if w.attn != None:
            o = attn_mixer(x, inputs, m, trunk_inputs, w.attn)
        else:
            o = gdn_mixer(x, inputs, w.gdn)
        o = corrected(x, o, w, routes)
        y = ops.elemwise.residual_add(o, y)

        x = ops.elemwise.rmsnorm_plus_one(y, w.mlp_norm, w.mlp_norm_eps)
        y = ops.elemwise.residual_add(mlp(x, w.mlp), y)
        if dr != None:
            fused = tap(dr, l, y, fused)
        return (y, fused)

    y, fused = inputs.fold_layers(m.layers, (y, None), block)

    x = ops.elemwise.rmsnorm_plus_one(y, m.final_norm, m.final_norm_eps)
    head = m.embed if m.head == None else m.head
    hb = None
    if dr != None:
        hb = arm(dr, inputs, fused, h_block, block_rows(dr))
        x = merge([hb, x])
    x = ops.gather.gather_rows(x, inputs.readout_rows())
    logits = ops.linear.lm_head(x, head)
    if dr != None:
        plant_readout(dr, logits, inputs, x, block_rows(dr))
    if m.mtp != None:
        draft(m, inputs, x, logits, head)
    output("logits", logits)

def mlp(x, f):
    if not f.routed:
        gate, up = ops.linear.matmul(x, f.gate), ops.linear.matmul(x, f.up)
        h = ops.linear.glu(gate, gating.swiglu(), up = up)
        return ops.linear.matmul(h, f.down)
    return run_moe(x, f)

def draft(m, inputs, x, logits, head):
    mtp = m.mtp
    plan = ops.attn.plan_prefill(inputs.on(fact.drafts()), m.q_heads, m.kv_heads, m.head_dim, None)
    hidden = x.on(fact.drafts())
    chosen = ops.sampling.argmax([logits.on(fact.drafts())])
    e = ops.gather.embed(chosen, m.embed, m.vocab)
    if mtp.pre_fc != None:
        pre = mtp.pre_fc
        e = ops.elemwise.rmsnorm_plus_one(e, pre.embedding, pre.eps)
        hidden = ops.elemwise.rmsnorm_plus_one(hidden, pre.hidden, pre.eps)
    dy = ops.elemwise.residual_add(ops.linear.matmul(e, mtp.fc_embed), ops.linear.matmul(hidden, mtp.fc_hidden))

    nx = ops.elemwise.rmsnorm_plus_one(dy, mtp.mixer_norm, mtp.mixer_norm_eps)
    a = mtp.attn
    o = draft_attn(nx, inputs, plan, a, m.head_dim, m.kv_heads, lambda q, k: rotate(q, k, inputs, m, a))
    dy = ops.elemwise.residual_add(o, dy)

    nx = ops.elemwise.rmsnorm_plus_one(dy, mtp.mlp_norm, mtp.mlp_norm_eps)
    gate, up = ops.linear.matmul(nx, mtp.mlp.gate), ops.linear.matmul(nx, mtp.mlp.up)
    f = ops.linear.matmul(ops.linear.glu(gate, gating.swiglu(), up = up), mtp.mlp.down)
    dy = ops.elemwise.residual_add(f, dy)

    read = ops.elemwise.rmsnorm_plus_one(dy, mtp.norm, mtp.norm_eps) if mtp.norm != None else dy
    proposal = ops.linear.lm_head(read, head)
    output("mtp.logits", proposal)
    output("mtp.drafts", ops.sampling.argmax([proposal]))

def rotate(q, k, inputs, m, a):
    vision = m.tower != None
    return rope(q, k, positions(inputs, vision), vision, a.rotary_dim, m.head_dim, a.theta, rope_scaling(m.rope))

def attn_mixer(x, inputs, m, lanes, a):
    pages = inputs.kv(a.kv)
    write_page = inputs.write_page(a.kv)
    write_offset = inputs.write_offset(a.kv)
    d = m.head_dim
    q, gate = ops.gather.split_q_gate(ops.linear.matmul(x, a.qg_proj), d)
    k = ops.linear.matmul(x, a.k_proj)
    v = ops.linear.matmul(x, a.v_proj)
    q = ops.elemwise.rmsnorm_per_head_plus_one(q, a.q_norm, d, a.q_norm_eps)
    k = ops.elemwise.rmsnorm_per_head_plus_one(k, a.k_norm, d, a.k_norm_eps)
    q, k = rotate(q, k, inputs, m, a)
    # KV rotation: K and V are cached turned by a Hadamard, Q turned to keep
    # the scores, and the output turned back once more.
    if m.rotate_kv:
        q = ops.elemwise.hadamard_plain(q, d)
        k = ops.elemwise.hadamard_plain(k, d)
        v = ops.elemwise.hadamard_plain(v, d)
    ops.attn.kv_append(k, v, pages, write_page, write_offset)

    # Each lane by its kind; a lane capturing scores reads them out too.
    o = ops.attn.attend(q, lanes, a.kv, m.q_heads, m.kv_heads, d, a.sm_scale, mask = True, scores = True)
    if m.rotate_kv:
        o = ops.elemwise.hadamard_plain(o, d)
    return ops.linear.matmul(ops.elemwise.gate_sigmoid_mul(o, gate), a.o_proj)

def gdn_mixer(x, inputs, g):
    conv_state = inputs.state(g.conv_state)
    delta_state = inputs.state(g.delta_state)
    qkv = ops.linear.matmul(x, g.in_qkv)
    z = ops.linear.matmul(x, g.in_z)
    # The gates read each v head's beta and alpha side by side.
    ba = ops.gather.concat_cols([ops.linear.matmul(x, g.in_b), ops.linear.matmul(x, g.in_a)])

    def step(qkv):
        qkv = ops.ssm.causal_conv1d(qkv, g.conv, conv_state, g.conv_kernel)
        gates = ops.ssm.gdn_gates(ba.on(fact.single_token()), g.dt_bias, g.a_log)
        z1 = z.on(fact.single_token())
        core = ops.ssm.gated_delta(qkv, z1, gates, delta_state, g.k_heads, g.v_heads, g.k_dim, g.v_dim)
        return ops.elemwise.rmsnorm_gated(core, z1, g.norm, g.v_dim, g.norm_eps, "silu")

    def chunked(qkv):
        qkv = ops.ssm.causal_conv1d_chunked(qkv, g.conv, conv_state, g.conv_kernel)
        gates = ops.ssm.gdn_gates(ba.on(~fact.single_token()), g.dt_bias, g.a_log)
        zc = z.on(~fact.single_token())
        core = ops.ssm.gated_delta_chunked(qkv, zc, gates, delta_state, g.k_heads, g.v_heads, g.k_dim, g.v_dim)
        # The gated norm inside the arm: a backend may land the walk's
        # output narrower for it.
        return ops.elemwise.rmsnorm_gated(core, zc, g.norm, g.v_dim, g.norm_eps, "silu")

    o = branch(qkv, [(fact.single_token(), step)], otherwise = chunked)
    return ops.linear.matmul(o, g.out_proj)
