# The weights of Qwen 3.5 / 3.6 / 3.8: gated-delta (GDN) mixers with a gated
# attention every few layers, dense or routed MLPs, a vision tower, an MTP or
# EAGLE draft head or a DFlash-family block drafter; Ternary-Bonsai's
# rotation signs; and the small geometries the engines' tests serve.

# The Bonsai online-Hadamard rotation: a sign diagonal per rotated input width.

BONSAI_BLOCK = 1024

def turns(signs):
    """Each input's turn by its sign diagonal: the weights reading it are
    stored against it."""
    by = lambda s: lambda w: w.turned(s, block = BONSAI_BLOCK)
    return struct(hidden = by(signs.hidden), ssm = by(signs.ssm), ffn_down = by(signs.ffn_down))

UNTURNED = struct(hidden = lambda w: w, ssm = lambda w: w, ffn_down = lambda w: w)

def gated_attn(d, w, kv, t = UNTURNED):
    """Gated attention over `d`'s heads, its projections at `w` (stored
    against `t`'s turns), caching in `kv`."""
    hd = d.head_dim
    return struct(
        rotary_dim = d.rotary_dim,
        theta = d.theta,
        sm_scale = f32(1.0 / f32(sqrt(hd))),
        qg_proj = t.hidden(weight([2 * d.q_heads * hd, d.hidden], w)),
        k_proj = t.hidden(weight([d.kv_heads * hd, d.hidden], w)),
        v_proj = t.hidden(weight([d.kv_heads * hd, d.hidden], w)),
        o_proj = t.ssm(weight([d.hidden, d.q_heads * hd], w)),
        q_norm = weight([hd]),
        q_norm_eps = d.norm_eps,
        k_norm = weight([hd]),
        k_norm_eps = d.norm_eps,
        kv = kv,
    )

def gdn(d, proj, ba, dense, conv_state, delta_state, t):
    """A GDN mixer: its projections at `proj` (stored against `t`'s turns),
    beta/alpha's at `ba`, its convolution and gate parameters at `dense`."""
    k_w = d.k_heads * d.k_dim
    v_w = d.v_heads * d.v_dim
    qkv = 2 * k_w + v_w
    return struct(
        k_heads = d.k_heads,
        v_heads = d.v_heads,
        k_dim = d.k_dim,
        v_dim = d.v_dim,
        qkv_width = qkv,
        conv_kernel = d.conv_kernel,
        in_qkv = t.hidden(weight([qkv, d.hidden], proj)),
        in_z = t.hidden(weight([v_w, d.hidden], proj)),
        in_b = weight([d.v_heads, d.hidden], ba),
        in_a = weight([d.v_heads, d.hidden], ba),
        conv = weight([qkv, d.conv_kernel]),
        dt_bias = weight([d.v_heads]),
        a_log = weight([d.v_heads], dtype.f32),
        norm = weight([d.v_dim], dtype.f32),
        norm_eps = d.norm_eps,
        out_proj = t.ssm(weight([d.hidden, v_w], proj)),
        conv_state = conv_state,
        delta_state = delta_state,
    )

def media(id, deploy):
    """How a still is spoken: framed by the processor's resize, cut into
    `PATCH` patches in `MERGE` blocks, its tokens placed by mrope."""
    if "vision" not in deploy.parts:
        return None
    return struct(image = struct(
        patch = PATCH, block = MERGE, mrope = True,
        prefix = "<|vision_start|>", placeholder = "<|image_pad|>", suffix = "<|vision_end|>",
        frame = lambda h, w, budget: smart_resize(h, w, PATCH * MERGE, 65536, 16777216),
    ))

BONSAI_WIDTHS = struct(hidden = 5120, ssm = 6144, ffn_down = 17408)

def sign_name(width):
    """The fork's on-device name of a width's sign diagonal."""
    return "prism.hadamard.signs.{}".format(width)

