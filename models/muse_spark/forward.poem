# The forward of Muse Spark Open: gated sliding-window attention (every
# fourth layer full and unrotated), sublayer outputs normed and joined to the
# stream through a residual gate, and a mixture of experts at a pooled width.

WINDOWED = 0
FULL = 1

def caches(m, c):
    kv = c.kv_space(m.kv)
    plane = m.kv_heads * m.head_dim
    for w in m.layers:
        c.kv(kv, w.kv, [plane, plane], m.head_dim, heads = True)

def moe(m, w, x):
    """The routed experts at the pooled width: routed on the row, the row
    pooled down and normed, each route's output normed under its scale, the
    routes weighed and summed, and the sum unpooled."""
    logits = ops.linear.matmul(x, w.router)
    routes, weights = ops.linear.moe_route(
        logits,
        m.experts,
        m.top_k,
        routing.sigmoid(renormalize = True, scaling = 1.0),
        bias = w.router_bias,
    )
    h = ops.elemwise.rmsnorm_plus_one(ops.linear.matmul(x, w.pool), w.pool_norm, m.norm_eps)

    def select(act, bank):
        if bank.dtype in [dtype.bf16, dtype.f16, dtype.f32]:
            return ops.linear.moe_matmul_select(act, bank, routes, m.top_k)
        return ops.linear.moe_matmul_select_quant(act, bank, routes, m.top_k)

    act = ops.linear.glu(select(h, w.gate_up), gating.swiglu(), m.inter)
    out = ops.elemwise.norm_gate(select(act, w.down), w.expert_scale, None, None, m.post_norm_eps, 1.0)
    return ops.linear.matmul(ops.linear.moe_weighted_sum(out, weights), w.unpool)

def forward(m, inputs):
    d = m.head_dim
    windows = [m.window, None]
    positions = inputs.positions()

    y = ops.elemwise.rmsnorm_no_scale(
        ops.gather.embed(inputs.tokens(), m.embed, m.vocab),
        m.hidden,
        m.norm_eps,
    )
    routes = inputs.adapter_routes()

    # Each residual gate lands the norm the next sublayer reads beside the
    # stream: the attention's, the experts', the next layer's or the head's.
    def block(l, w, carried):
        y, normed = carried
        reading = FULL if w.full else WINDOWED
        win = windows[reading]
        pages = inputs.kv(w.kv)

        qkv, gate = ops.gather.split_rows(ops.linear.matmul(normed, w.qkvg), (m.q_heads + 2 * m.kv_heads) * d)
        q, k, v = ops.gather.split_qkv(qkv, m.q_heads * d, m.kv_heads * d)
        q = ops.elemwise.rmsnorm_no_scale(q, d, m.norm_eps)
        k = ops.elemwise.rmsnorm_no_scale(k, d, m.norm_eps)
        if not w.full:
            q, k = ops.elemwise.rope(q, positions, d, m.theta, rotary.full(), k = k)
        ops.attn.kv_append(k, v, pages, inputs.write_page(w.kv), inputs.write_offset(w.kv))
        seam.at(seam.ATTN_Q, [q])

        # Each lane by its kind; a full layer's scores go out at their seam.
        a = ops.attn.attend(q, inputs, w.kv, m.q_heads, m.kv_heads, d, m.sm_scale, window = win,
                            mask = True, scores = True, scores_seam = w.full)
        seam.at(seam.ATTN_OUT, [a])

        # Each head normed, then gated, in one pass.
        a = ops.elemwise.rmsnorm_gated(a, gate, None, d, m.norm_eps, "sigmoid")
        o = ops.linear.matmul(a, w.o_proj)
        adapted = fact.has(fact.Adapter)
        o = ops.linear.lora_correct(normed.on(adapted), w.lora_a, w.lora_b, routes, o.on(adapted))
        y, x = ops.elemwise.norm_gate(o, None, y, w.attn_gate, m.post_norm_eps, m.gate_temperature, (w.pre_ffw_norm, m.norm_eps))

        f = moe(m, w, x)
        last = l + 1 == len(m.layers)
        after = (m.final_norm, m.final_norm_eps) if last else (m.layers[l + 1].attn_norm, m.norm_eps)
        return ops.elemwise.norm_gate(f, w.post_ffw_scale, y, w.ffw_gate, m.post_norm_eps, m.gate_temperature, after, not last)

    first = ops.elemwise.rmsnorm_plus_one(y, m.layers[0].attn_norm, m.norm_eps)
    _, x = inputs.fold_layers(m.layers, (y, first), block)
    x = ops.gather.gather_rows(x, inputs.readout_rows())
    return ops.attn.logit_softcap(ops.linear.lm_head(x, m.lm_head), m.softcap)
