# Muse Spark Open: Muse Glimmer's gated attention (sliding windows, a full
# NoPE layer every fourth) with a normed head output, residual gates on both
# sublayers, and a mixture of experts run at a pooled width: the row pooled
# down and normed, its routed experts each normed on the way out, and the
# weighted sum unpooled.

load("//lib/adapters/model.poem", "banks")

def dims(layers = 62, experts = 256):
    return struct(
        hidden = 8192,
        layers = layers,
        q_heads = 128,
        kv_heads = 16,
        head_dim = 64,
        vocab = 202048,
        window = 2048,
        theta = 500000.0,
        qk_scale = 5.4730064863875,
        softcap = 20.0,
        output_multiplier = 0.17677669529663687,
        norm_eps = 1e-5,
        post_norm_eps = 1e-8,
        gate_temperature = 0.3,
        pooled = 4096,
        inter = 4096,
        experts = experts,
        top_k = 8,
        # The release's first and last layers keep their experts bf16 (the
        # NVFP4 export's `exclude_modules`); a miniature's first.
        dense_experts = [0, 61],
    )

DIMS = {
    "muse-spark-open": dims(),
    "muse-spark-open-mini-l8": dims(layers = 8, experts = 16),
}

def full(l):
    """The full-attention (and NoPE) layers: every fourth, from the second."""
    return l % 4 == 1

def layout(id, deploy):
    if deploy.weights not in [[dtype.bf16, dtype.nvfp4], [dtype.bf16, dtype.nvfp4a4], [dtype.bf16]]:
        fail("{} stores its weights bf16 with NVFP4 experts, not {}".format(id, deploy.weights))
    d = DIMS[id]
    w = dtype.bf16
    dense = compute(w)
    routed = deploy.weights[1] if len(deploy.weights) > 1 else w
    hidden = d.hidden
    hd = d.head_dim
    q_w = d.q_heads * hd
    kv_w = d.kv_heads * hd
    pooled = d.pooled
    iw = d.inter

    def layer(l):
        n = lambda s: "layer.{}.{}".format(l, s)
        norm = lambda s, dim: weight(n(s), [dim], dense)
        lora_a, lora_b = banks("layer.{}".format(l), hidden, dense)
        bank = w if l in d.dense_experts else routed
        return struct(
            full = full(l),
            qkv = weight(n("qkv"), [q_w + 2 * kv_w, hidden], w).packed([q_w, kv_w, kv_w], heads = [d.q_heads, d.kv_heads, d.kv_heads]),
            gate = weight(n("gate"), [q_w, hidden], w).columns(),
            o_proj = weight(n("o_proj"), [hidden, q_w], w).rows(),
            kv = "kv.{}".format(l),
            attn_norm = norm("attn_norm", hidden),
            attn_gate = weight(n("attn_gate"), [hidden], dtype.f32),
            pre_ffw_norm = norm("pre_ffw_norm", hidden),
            # `1 + w` as stored bf16: the scale a post norm's input takes.
            post_ffw_scale = norm("post_ffw_scale", hidden),
            ffw_gate = weight(n("ffw_gate"), [hidden], dtype.f32),
            router = weight(n("router"), [d.experts, hidden], dense),
            router_bias = weight(n("router_bias"), [d.experts], dtype.f32),
            pool = weight(n("pool"), [pooled, hidden], w),
            pool_norm = norm("pool_norm", pooled),
            gate_up = weight(n("experts_gate_up"), [d.experts, 2 * iw, pooled], bank).bank([iw, iw]),
            down = weight(n("experts_down"), [d.experts, pooled, iw], bank).rows(),
            expert_scale = norm("expert_scale", pooled),
            unpool = weight(n("unpool"), [hidden, pooled], w),
            lora_a = lora_a,
            lora_b = lora_b,
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        q_heads = d.q_heads,
        kv_heads = d.kv_heads,
        head_dim = hd,
        window = d.window,
        theta = d.theta,
        sm_scale = f32(f32(d.qk_scale) / f32(sqrt(hd))),
        norm_eps = d.norm_eps,
        post_norm_eps = d.post_norm_eps,
        gate_temperature = d.gate_temperature,
        kv = deploy.kv,
        softcap = d.softcap,
        output_multiplier = d.output_multiplier,
        experts = d.experts,
        top_k = d.top_k,
        inter = iw,
        embed = weight("embed", [d.vocab, hidden], w),
        lm_head = weight("lm_head", [d.vocab, hidden], w),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight("final_norm", [hidden], dense),
        final_norm_eps = d.norm_eps,
    )
