# How a Muse Spark Open checkpoint is laid out: transformers' names, the text
# model under `model.language_model.`, each layer's experts one stacked bank
# a leg (bf16, or modelopt's NVFP4 under its scales); or AMD's Quark MXFP4
# release, one plane an expert and leg (bf16, or MXFP4 codes beside their
# e8m0 `weight_scale`).

load("//lib/modelopt/formats.poem", "nvfp4_stacked_bank")

TRUNK = "model.language_model."

def formats(m):
    return [format("huggingface", read = lambda reads: huggingface(m, reads))]

def huggingface(m, reads):
    at = lambda leaf: TRUNK + leaf
    reads.read(m.embed, at("embed_tokens.weight"))
    # The head's input multiplier folded into the final norm's weight.
    reads.read_over(m.final_norm, at("norm.weight"), lambda x: x.scale(m.output_multiplier))
    reads.read(m.lm_head, "lm_head.weight")
    for l, w in enumerate(m.layers):
        n = lambda leaf: "{}layers.{}.{}".format(TRUNK, l, leaf)
        reads.read(w.attn_norm, n("input_layernorm.weight"))
        reads.read_concat(w.qkvg, [
            n("self_attn.q_proj.weight"),
            n("self_attn.k_proj.weight"),
            n("self_attn.v_proj.weight"),
            n("self_attn.gate_proj.weight"),
        ])
        reads.read(w.o_proj, n("self_attn.o_proj.weight"))
        reads.read(w.attn_gate, n("post_attention_residual_gate.gate"))
        reads.read(w.pre_ffw_norm, n("pre_feedforward_layernorm.weight"))
        # A post norm's scale is stored as its offset from one.
        reads.read_over(w.post_ffw_scale, n("post_feedforward_layernorm.weight"), lambda x: x.bias(1.0))
        reads.read(w.ffw_gate, n("post_feedforward_residual_gate.gate"))
        # The router's output multiplier folded into its weight, as vLLM does.
        reads.read_over(w.router, n("mlp.gate.weight"), lambda x: x.scale(m.output_multiplier))
        reads.read(w.router_bias, n("mlp.gate.e_score_correction_bias"))
        reads.read(w.pool, n("mlp.pre_expert_proj.weight"))
        reads.read(w.pool_norm, n("mlp.pre_expert_norm.weight"))
        reads.read_over(w.expert_scale, n("mlp.experts.post_expert_norm.weight"), lambda x: x.bias(1.0))
        reads.read(w.unpool, n("mlp.post_expert_proj.weight"))
        if not has(n("mlp.experts.gate_up_proj")):
            leg = lambda e, which: n("mlp.experts.{}.{}_proj.weight".format(e, which))
            quark_bank(reads, w.gate_up, [[leg(e, "gate"), leg(e, "up")] for e in range(m.experts)])
            quark_bank(reads, w.down, [[leg(e, "down")] for e in range(m.experts)])
            continue
        for bank, leg in [(w.gate_up, "gate_up_proj"), (w.down, "down_proj")]:
            stem = n("mlp.experts." + leg)
            if bank.dtype == dtype.bf16:
                reads.read(bank, stem)
            else:
                nvfp4_stacked_bank(reads, bank, stem, legs = 2 if leg == "gate_up_proj" else 1)

def quark_bank(reads, w, experts):
    """A bank `[experts, rows, cols]` from one plane an expert and leg: bf16
    rows stacked, or MXFP4 codes with their exponents."""
    rows, cols = w.shape[1], w.shape[2]
    if w.dtype != dtype.mxfp4:
        reads.read_expr(w, concat(0, [src(p) for legs in experts for p in legs]).transmute(list(w.shape), encoding(dtype.bf16)))
        return
    codes = []
    scales = []
    per = rows // len(experts[0])
    for legs in experts:
        for part in legs:
            scale = part + "_scale"
            if not has(scale):
                fail("`{}`: `{}` holds MXFP4 codes and the checkpoint holds no `{}`".format(w.name, part, scale))
            codes.append(src(part).transmute([1, per, cols], encoding(dtype.mxfp4)))
            scales.append(src(scale).transmute([1, per, cols // 32], encoding(dtype.e8m0)))
    counted = scales_shape(w)
    codes = concat(0, codes)
    scales = concat(0, scales)
    # Two legs an expert stack to `[2E, inter, cols]`, the bank byte for byte.
    if len(experts[0]) > 1:
        codes = codes.transmute(list(w.shape), encoding(dtype.mxfp4))
        scales = scales.transmute(counted, encoding(dtype.e8m0))
    reads.extend([
        tensor(w.name, codes, encoding(dtype.mxfp4)),
        tensor(scales_name(w.name), scales, encoding(dtype.e8m0), shape = counted, scaling = w),
    ])
