# Inkling and Inkling-Small, each with its miniature of seven layers and
# eight experts, which reads a prefix of the whole model's checkpoint.

load("//lib/adapters.poem", "banks", "corrected")
load("//lib/reads.poem", "flattened")

INKLING = template("inkling")
TOKENIZER = tokenizer(markers = [
    ["<|content_model_end_sampling|>", "<|endoftext|>"],
    ["<|message_user|>", "<|message_model|>", "<|message_system|>", "<|message_tool|>", "<|content_text|>", "<|content_thinking|>", "<|end_message|>"],
])

MODELS = [
    model("inkling", template = INKLING, tokenizer = TOKENIZER, arch = "inkling", layers = 66, vocab = 200058),
    model("inkling-mini-l7-e8", mini = True, template = INKLING, tokenizer = TOKENIZER, arch = "inkling", layers = 7, vocab = 200058),
    model("inkling-small", template = INKLING, tokenizer = TOKENIZER, arch = "inkling", layers = 42, vocab = 200058),
    model("inkling-small-mini-l7-e8", mini = True, template = INKLING, tokenizer = TOKENIZER, arch = "inkling", layers = 7, vocab = 200058),
]

DEPLOYMENTS = [
    deployment("inkling", weights = dtype.bf16, kv = dtype.bf16),
    deployment("inkling-mini-l7-e8", weights = dtype.bf16, kv = dtype.bf16),
    deployment("inkling-small", weights = dtype.bf16, kv = dtype.bf16),
    deployment("inkling-small-mini-l7-e8", weights = dtype.bf16, kv = dtype.bf16),
    # Keys and values e4m3 under a unit scale (vLLM's `fp8` KV).
    deployment("inkling", weights = dtype.bf16, kv = dtype.e4m3),
    deployment("inkling-small", weights = dtype.bf16, kv = dtype.e4m3),
    deployment("inkling-small-mini-l7-e8", weights = dtype.bf16, kv = dtype.e4m3),
]

# The weights of Inkling: attention with a relative bias over a local window,
# every sixth layer over a longer reach; short convolutions on its keys,
# values and both residual branches; two dense layers, then routed experts
# with sink experts always taken.

def dims(layers = 66, experts = 256, **over):
    d = dict(
        hidden = 6144,
        layers = layers,
        vocab = 201024,
        head_rows = 200058,
        heads = 64,
        head_dim = 128,
        local_kv_heads = 16,
        global_kv_heads = 8,
        d_rel = 16,
        window = 512,
        global_extent = 1024,
        conv_width = 4,
        global_every = 6,
        dense_layers = 2,
        dense_inter = 24576,
        experts = experts,
        top_k = min(6, experts),
        sink = 2,
        moe_inter = 3072,
        route_scale = 8.0,
        mup = 24.0,
        norm_eps = 1e-6,
        log_floor = 128000,
        log_alpha = 0.1,
    )
    d.update(over)
    return struct(**d)

def small(layers = 42, experts = 256):
    """Inkling-Small: the same layer pattern, narrower and shallower."""
    return dims(
        layers,
        experts,
        hidden = 4096,
        heads = 32,
        local_kv_heads = 8,
        dense_inter = 16384,
        moe_inter = 2048,
        mup = 16.0,
    )

DIMS = {
    "inkling": dims(),
    "inkling-mini-l7-e8": dims(layers = 7, experts = 8),
    "inkling-small": small(),
    "inkling-small-mini-l7-e8": small(layers = 7, experts = 8),
}

# An Inkling checkpoint this package lists no model of (a fine-tune of
# Inkling or Inkling-Small, a release at another width, depth or expert
# count): the same forward at the widths, heads, window and reach, relative
# bias, convolution width, expert bank and head multiplier its config.json's
# `text_config` states, its longer-reaching layers where `local_layer_ids`
# leaves them; refused where the config states what the forward does not run.
# The MTP heads it may ship are not read.

def adopt(id, config, special):
    if config.get("model_type") != "inkling_mm_model":
        fail("the config's model_type is {}; this family is inkling_mm_model".format(config.get("model_type")))
    if config.get("quantization_config") != None:
        fail("it is released quantized ({}); this family reads a bf16 release".format(config["quantization_config"].get("quant_method")))
    t = config["text_config"]
    if t.get("q_bias", False) or t.get("o_bias", False):
        fail("its attention projections carry biases, which this family's do not")
    for key in ["use_embed_norm", "use_sconv", "shared_expert_sink", "use_gate_bias", "norm_after_topk", "use_global_scale"]:
        if not t.get(key, False):
            fail("its text_config turns off {}, which this family's forward always runs".format(key))
    if t.get("hidden_act", "silu") != "silu":
        fail("its MLPs gate by {}; this family's SwiGLU gates by silu".format(t["hidden_act"]))
    if t.get("gate_activation", "sigmoid") != "sigmoid":
        fail("its router scores by {}; this family's by sigmoid".format(t["gate_activation"]))
    if t.get("final_logit_softcapping") != None:
        fail("it caps its logits ({}); this family does not".format(t["final_logit_softcapping"]))
    heads, head_dim = t["num_attention_heads"], t["head_dim"]
    if t.get("swa_num_attention_heads", heads) != heads or t.get("swa_head_dim", head_dim) != head_dim:
        fail("its sliding layers' query heads ({} of {}) are not its others' ({} of {})".format(t.get("swa_num_attention_heads"), t.get("swa_head_dim"), heads, head_dim))
    layers = t["num_hidden_layers"]
    local = t["local_layer_ids"]
    longer = [l for l in range(layers) if l not in local]
    if not longer:
        fail("none of its layers reaches past the window; this family's every few do")
    every = longer[0] + 1
    if longer != [l for l in range(layers) if (l + 1) % every == 0]:
        fail("its longer-reaching layers ({}) are not every {}th".format(longer, every))
    kinds = t.get("layer_types")
    if kinds != None and kinds != [("hybrid_sliding" if l in local else "hybrid") for l in range(layers)]:
        fail("its layer_types ({}) do not say what its local_layer_ids do".format(kinds))
    dense = t["dense_mlp_idx"]
    mlps = t.get("mlp_layer_types")
    if mlps != None and mlps != ["dense"] * dense + ["sparse"] * (layers - dense):
        fail("its MLPs ({}) are not its first {} dense, then routed".format(mlps, dense))
    # transformers' own config names the routed width `moe_intermediate_size`
    # and the dense one `intermediate_size`; the release's names the routed
    # one `intermediate_size` and the dense one `dense_intermediate_size`.
    if "moe_intermediate_size" in t:
        moe_inter, dense_inter = t["moe_intermediate_size"], t["intermediate_size"]
    else:
        moe_inter, dense_inter = t["intermediate_size"], t["dense_intermediate_size"]
    experts = t["n_routed_experts"]
    d = dims(
        layers,
        experts,
        hidden = t["hidden_size"],
        vocab = t["vocab_size"],
        head_rows = t.get("unpadded_vocab_size", t["vocab_size"]),
        heads = heads,
        head_dim = head_dim,
        local_kv_heads = t["swa_num_key_value_heads"],
        global_kv_heads = t["num_key_value_heads"],
        d_rel = t["d_rel"],
        window = t["sliding_window_size"],
        global_extent = t["rel_extent"],
        conv_width = t["sconv_kernel_size"] if "sconv_kernel_size" in t else t["conv_kernel_size"],
        global_every = every,
        dense_layers = dense,
        dense_inter = dense_inter,
        top_k = t["num_experts_per_tok"],
        sink = t["n_shared_experts"],
        moe_inter = moe_inter,
        route_scale = float(t["route_scale"]),
        mup = float(t["logits_mup_width_multiplier"]),
        norm_eps = float(t.get("rms_norm_eps", 1e-6)),
        log_floor = t["log_scaling_n_floor"],
        log_alpha = float(t["log_scaling_alpha"]),
    )
    return struct(
        MODELS = [model(id, template = INKLING, tokenizer = TOKENIZER, arch = "inkling", layers = layers, vocab = d.head_rows)],
        DIMS = {id: d},
        DEPLOYMENTS = [
            deployment(id, weights = dtype.bf16, kv = dtype.bf16),
            deployment(id, weights = dtype.bf16, kv = dtype.e4m3),
        ],
    )

LOCAL = 0
GLOBAL = 1

def layout(id, deploy):
    d = DIMS[id]
    w = roles(deploy, "w", exact = True).w
    hidden = d.hidden
    hd = d.head_dim
    q_w = d.heads * hd
    r_w = d.heads * d.d_rel
    kw = d.conv_width

    def layer(l):
        vec = lambda s, length: weight([length])
        lora_a, lora_b = banks(hidden)
        if (l + 1) % d.global_every == 0:
            reading, kv_heads, extent = GLOBAL, d.global_kv_heads, d.global_extent
        else:
            reading, kv_heads, extent = LOCAL, d.local_kv_heads, d.window
        kv_w = kv_heads * hd
        conv = lambda s, channels: weight([channels, kw])
        if l < d.dense_layers:
            iw = d.dense_inter
            mlp = struct(
                routed = False,
                gate = weight([iw, hidden], w),
                up = weight([iw, hidden], w),
                inter = iw,
                down = weight([hidden, iw], w),
                scale = vec("mlp_scale", 1),
            )
        else:
            bank = d.experts + d.sink
            mi = d.moe_inter
            mlp = struct(
                routed = True,
                router = weight([bank, hidden], w),
                bias = weight([d.experts], dtype.f32),
                scale = weight([1], dtype.f32),
                gate = weight([bank, mi, hidden], w),
                up = weight([bank, mi, hidden], w),
                down = weight([bank, hidden, mi], w),
                experts = d.experts,
                top_k = d.top_k,
                sink = d.sink,
                inter = mi,
                scaling = d.route_scale,
            )
        return struct(
            reading = reading,
            kv_heads = kv_heads,
            extent = extent,
            attn_norm = vec("attn_norm", hidden),
            q_proj = weight([q_w, hidden], w),
            k_proj = weight([kv_w, hidden], w),
            v_proj = weight([kv_w, hidden], w),
            r_proj = weight([r_w, hidden], w),
            o_proj = weight([hidden, q_w], w),
            q_norm = vec("q_norm", hd),
            k_norm = vec("k_norm", hd),
            rel_proj = weight([d.d_rel, extent]),
            k_conv = conv("k_conv", kv_w),
            v_conv = conv("v_conv", kv_w),
            attn_conv = weight([hidden, kw]),
            mlp_conv = weight([hidden, kw]),
            kv = "kv.{}".format(l),
            k_state = "conv.{}.k".format(l),
            v_state = "conv.{}.v".format(l),
            attn_state = "conv.{}.attn".format(l),
            mlp_state = "conv.{}.mlp".format(l),
            mlp_norm = vec("mlp_norm", hidden),
            mlp = mlp,
            lora_a = lora_a,
            lora_b = lora_b,
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        head_rows = d.head_rows,
        heads = d.heads,
        head_dim = hd,
        d_rel = d.d_rel,
        window = d.window,
        conv_width = kw,
        sm_scale = f32(1.0 / f32(hd)),
        norm_eps = d.norm_eps,
        head_scale = f32(1.0 / f32(d.mup)),
        log_scaling = (d.log_floor, d.log_alpha),
        kv = deploy.kv,
        embed = weight([d.vocab, hidden], w),
        embed_norm = weight([hidden]),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight([hidden]),
        unembed = weight([d.head_rows, hidden], w),
    )

# How an Inkling checkpoint is laid out: the language model under
# `model.llm.`, its MLPs' gate and up projections interleaved row by row.

TRUNK = "model.llm."

def formats(m):
    return [format(
        "huggingface",
        recognizes = lambda checkpoint: has(TRUNK + "layers.0.attn.rel_logits_proj.proj"),
        read = lambda reads: huggingface(m, reads),
    )]

def huggingface(m, reads):
    at = lambda leaf: TRUNK + leaf
    reads.read(m.embed, at("embed.weight"))
    reads.read(m.embed_norm, at("embed_norm.weight"))
    reads.read(m.final_norm, at("norm.weight"))
    reads.read_expr(m.unembed, src(at("unembed.weight")).slice(0, 0, m.head_rows))
    for l, w in enumerate(m.layers):
        n = lambda leaf: "{}layers.{}.{}".format(TRUNK, l, leaf)
        reads.read(w.attn_norm, n("attn_norm.weight"))
        reads.read(w.mlp_norm, n("mlp_norm.weight"))
        reads.read(w.q_proj, n("attn.wq_du.weight"))
        reads.read(w.k_proj, n("attn.wk_dv.weight"))
        reads.read(w.v_proj, n("attn.wv_dv.weight"))
        reads.read(w.r_proj, n("attn.wr_du.weight"))
        reads.read(w.o_proj, n("attn.wo_ud.weight"))
        reads.read(w.q_norm, n("attn.q_norm.weight"))
        reads.read(w.k_norm, n("attn.k_norm.weight"))
        reads.read(w.rel_proj, n("attn.rel_logits_proj.proj"))
        for weight, leaf in [
            (w.k_conv, "attn.k_sconv.weight"),
            (w.v_conv, "attn.v_sconv.weight"),
            (w.attn_conv, "attn_sconv.weight"),
            (w.mlp_conv, "mlp_sconv.weight"),
        ]:
            reads.read_expr(weight, flattened(n(leaf), weight.shape))
        f = w.mlp
        if not f.routed:
            w13 = src(n("mlp.w13_dn.weight"))
            reads.read_expr(f.gate, w13.stride(0, 0, f.inter, 2))
            reads.read_expr(f.up, w13.stride(0, 1, f.inter, 2))
            reads.read(f.down, n("mlp.w2_md.weight"))
            reads.read(f.scale, n("mlp.global_scale"))
            continue
        reads.read(f.router, n("mlp.gate.weight"))
        reads.read(f.bias, n("mlp.gate.bias"))
        reads.read(f.scale, n("mlp.gate.global_scale"))
        w13 = [src(n("mlp.experts.w13_weight")), src(n("mlp.shared_experts.shared_w13_weight"))]
        reads.read_expr(f.gate, concat(0, [x.stride(1, 0, f.inter, 2) for x in w13]))
        reads.read_expr(f.up, concat(0, [x.stride(1, 1, f.inter, 2) for x in w13]))
        reads.read_expr(f.down, concat(0, [
            src(n("mlp.experts.w2_weight")),
            src(n("mlp.shared_experts.shared_w2_weight")),
        ]))

# The forward of Inkling: relative-biased attention, short convolutions
# around it and the MLP, a dense or sink-routed MLP.

def caches(m, c):
    kv = c.kv_space(m.kv)
    taps = m.conv_width
    for w in m.layers:
        plane = w.kv_heads * m.head_dim
        c.kv(kv, w.kv, [plane, plane], m.head_dim, heads = True)
        c.state(w.k_state, [taps, plane], dtype.bf16, split = 1)
        c.state(w.v_state, [taps, plane], dtype.bf16, split = 1)
        c.state(w.attn_state, [taps, m.hidden], dtype.bf16)
        c.state(w.mlp_state, [taps, m.hidden], dtype.bf16)

def kv_heads_of(m, reading):
    for w in m.layers:
        if w.reading == reading:
            return w.kv_heads
    return 0

def forward(m, inputs):
    d = m.head_dim
    one = fact.single_token()
    input_d, input_p = inputs.on(one), inputs.on(~one)
    geometry = [(kv_heads_of(m, LOCAL), m.window), (kv_heads_of(m, GLOBAL), None)]
    plan_d = [
        ops.attn.plan_decode(input_d, m.heads, kv_heads, d, win) if kv_heads > 0 else None
        for kv_heads, win in geometry
    ]
    plan_p = [
        ops.attn.plan_prefill(input_p, m.heads, kv_heads, d, win) if kv_heads > 0 else None
        for kv_heads, win in geometry
    ]

    y = ops.elemwise.rmsnorm(ops.gather.embed(inputs.tokens(), m.embed, m.vocab), m.embed_norm, m.norm_eps)
    routes = inputs.adapter_routes()

    def block(l, w, y):
        reading = w.reading
        win = geometry[reading][1]
        x = ops.elemwise.rmsnorm(y, w.attn_norm, m.norm_eps)
        pages = inputs.kv(w.kv)

        q = ops.linear.matmul(x, w.q_proj)
        k = conv(ops.linear.matmul(x, w.k_proj), w.k_conv, w.k_state, inputs, m)
        v = conv(ops.linear.matmul(x, w.v_proj), w.v_conv, w.v_state, inputs, m)
        r = ops.linear.matmul(x, w.r_proj)
        q = ops.elemwise.rmsnorm_per_head(q, w.q_norm, d, m.norm_eps)
        k = ops.elemwise.rmsnorm_per_head(k, w.k_norm, d, m.norm_eps)
        ops.attn.kv_append(k, v, pages, inputs.write_page(w.kv), inputs.write_offset(w.kv))

        bias = ops.linear.rel_bias(r, w.rel_proj, m.heads, m.d_rel, w.extent)
        log_scaling = m.log_scaling if reading == GLOBAL else None
        a = merge([
            ops.attn.decode(
                q.on(one),
                plan_d[reading],
                pages,
                win,
                d,
                m.sm_scale,
                bias = bias.on(one),
                extent = w.extent,
                log_scaling = log_scaling,
            ),
            ops.attn.prefill(
                q.on(~one),
                plan_p[reading],
                pages,
                win,
                d,
                w.kv_heads,
                m.sm_scale,
                bias = bias.on(~one),
                extent = w.extent,
                log_scaling = log_scaling,
            ),
        ])
        o = ops.linear.matmul(a, w.o_proj)
        o = corrected(x, o, w, routes)
        o = conv(o, w.attn_conv, w.attn_state, inputs, m)
        y = ops.elemwise.residual_add(o, y)

        x = ops.elemwise.rmsnorm(y, w.mlp_norm, m.norm_eps)
        f = conv(mlp(x, w.mlp), w.mlp_conv, w.mlp_state, inputs, m)
        return ops.elemwise.residual_add(f, y)

    y = inputs.fold_layers(m.layers, y, block)
    x = ops.elemwise.rmsnorm(y, m.final_norm, m.norm_eps) * m.head_scale
    x = ops.gather.gather_rows(x, inputs.readout_rows())
    output("logits", ops.linear.lm_head(x, m.unembed))

def mlp(x, f):
    if not f.routed:
        gate, up = ops.linear.matmul(x, f.gate), ops.linear.matmul(x, f.up)
        act = ops.linear.glu(gate, gating.swiglu(), up = up)
        return ops.elemwise.scale(f.scale, ops.linear.matmul(act, f.down))
    fan = f.top_k + f.sink
    routes, weights = ops.linear.moe_route(
        ops.linear.matmul(x, f.router),
        f.experts,
        f.top_k,
        routing.sigmoid_sink(f.sink, scaling = f.scaling),
        bias = f.bias,
        scale = f.scale,
    )
    gate = ops.linear.moe_matmul_select(x, f.gate, routes, fan)
    hidden = ops.linear.glu(gate, gating.swiglu(), up = ops.linear.moe_matmul_select(x, f.up, routes, fan))
    return ops.linear.moe_weighted_sum(ops.linear.moe_matmul_select(hidden, f.down, routes, fan), weights)

def conv(v, weight, state, inputs, m):
    slab = inputs.state(state)
    one = fact.single_token()
    return merge([
        ops.ssm.short_conv(v.on(one), weight, slab, m.conv_width),
        ops.ssm.short_conv_chunked(v.on(~one), weight, slab, m.conv_width),
    ])
