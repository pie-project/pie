# The Qwen3 text encoder the image and video models condition on: its
# layout, its read, its caches and its forward.

QWEN3_4B = struct(
    hidden = 2560,
    vocab = 151936,
    q_heads = 32,
    kv_heads = 8,
    head_dim = 128,
    inter = 9728,
    theta = 1000000.0,
    eps = 1e-6,
)

def encoder(c, layers, banks):
    """The encoder of config `c` through its first `layers` layers."""
    hidden, hd, inter = c.hidden, c.head_dim, c.inter

    def layer(l):
        return struct(
            attn_norm = weight([hidden]),
            q = weight([c.q_heads * hd, hidden], banks),
            k = weight([c.kv_heads * hd, hidden], banks),
            v = weight([c.kv_heads * hd, hidden], banks),
            o = weight([hidden, c.q_heads * hd], banks),
            q_norm = weight([hd]),
            k_norm = weight([hd]),
            mlp_norm = weight([hidden]),
            gate = weight([inter, hidden], banks),
            up = weight([inter, hidden], banks),
            down = weight([hidden, inter], banks),
            kv = "te.kv.{}".format(l),
        )

    return struct(
        hidden = hidden,
        vocab = c.vocab,
        q_heads = c.q_heads,
        kv_heads = c.kv_heads,
        head_dim = hd,
        inter = inter,
        theta = c.theta,
        eps = c.eps,
        sm_scale = f32(1.0 / f32(sqrt(hd))),
        embed = weight([c.vocab, hidden], banks),
        layers = [layer(l) for l in range(layers)],
    )

def te_read(reads, te, prefix):
    reads.read(te.embed, prefix + "embed_tokens.weight")
    for l, w in enumerate(te.layers):
        n = lambda s: "{}layers.{}.{}".format(prefix, l, s)
        reads.read(w.attn_norm, n("input_layernorm.weight"))
        reads.read(w.q, n("self_attn.q_proj.weight"))
        reads.read(w.k, n("self_attn.k_proj.weight"))
        reads.read(w.v, n("self_attn.v_proj.weight"))
        reads.read(w.o, n("self_attn.o_proj.weight"))
        reads.read(w.q_norm, n("self_attn.q_norm.weight"))
        reads.read(w.k_norm, n("self_attn.k_norm.weight"))
        reads.read(w.mlp_norm, n("post_attention_layernorm.weight"))
        reads.read(w.gate, n("mlp.gate_proj.weight"))
        reads.read(w.up, n("mlp.up_proj.weight"))
        reads.read(w.down, n("mlp.down_proj.weight"))

def qwen3_caches(te, c, kv):
    space = c.kv_space(kv)
    plane = te.kv_heads * te.head_dim
    for layer in te.layers:
        c.kv(space, layer.kv, [plane, plane], te.head_dim, heads = True)

def qwen3_encode(arm, te, tap = None):
    """The encoder over `arm`'s tokens. `tap(l, y)` sees each layer's output
    rows and reads the encoder out; without one, the last layer's rows are
    its readout."""
    plan = ops.attn.plan_prefill(arm, te.q_heads, te.kv_heads, te.head_dim, None)
    ids = arm.tokens()
    positions = arm.positions()
    y = ops.gather.embed(ids, te.embed, te.vocab)
    last = len(te.layers) - 1

    def layer(l, w, y):
        pages = arm.kv(w.kv)
        x = ops.elemwise.rmsnorm(y, w.attn_norm, te.eps)
        q = ops.linear.matmul(x, w.q)
        k = ops.linear.matmul(x, w.k)
        v = ops.linear.matmul(x, w.v)
        q = ops.elemwise.rmsnorm_per_head(q, w.q_norm, te.head_dim, te.eps)
        k = ops.elemwise.rmsnorm_per_head(k, w.k_norm, te.head_dim, te.eps)
        q, k = ops.elemwise.rope(q, positions, te.head_dim, te.theta, rotary.full(), k = k)
        ops.attn.kv_append(k, v, pages, arm.write_page(w.kv), arm.write_offset(w.kv))
        o = ops.attn.prefill(q, plan, pages, None, te.head_dim, te.kv_heads, te.sm_scale)
        y = ops.elemwise.residual_add(ops.linear.matmul(o, w.o), y)

        x = ops.elemwise.rmsnorm(y, w.mlp_norm, te.eps)
        gate, up = ops.linear.matmul(x, w.gate), ops.linear.matmul(x, w.up)
        f = ops.linear.matmul(ops.linear.glu(gate, gating.swiglu(), up = up), w.down)
        y = ops.elemwise.residual_add(f, y)
        if tap != None:
            tap(l, y)
        elif l == last:
            output("hidden", y)
        return y

    arm.fold_layers(te.layers, y, layer)
