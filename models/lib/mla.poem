# Latent attention: its weights' checkpoint names, its absorbed attend, and
# the boundaries of a key pool compressed beside it.

def named(a, at):
    """`a`'s weights, each beside the name `at` gives its transformers leaf,
    in the order a checkpoint lists them."""
    out = [
        (a.q_a_proj, at("self_attn.q_a_proj.weight")),
        (a.q_a_norm, at("self_attn.q_a_layernorm.weight")),
        (a.q_b_proj, at("self_attn.q_b_proj.weight")),
        (a.kv_a_proj, at("self_attn.kv_a_proj_with_mqa.weight")),
        (a.kv_a_norm, at("self_attn.kv_a_layernorm.weight")),
        (a.kv_b_proj, at("self_attn.kv_b_proj.weight")),
    ]
    if a.gate != None:
        out.append((a.gate, at("self_attn.g_proj.weight")))
    out.append((a.o_proj, at("self_attn.o_proj.weight")))
    return out

def attend(x, inputs, q_nope, q_pe, a, selection = None, prefill_only = False):
    """The split queries `q_nope`/`q_pe` of the rows `x` scored against the
    latent kv (or the `selection` of it), through `a`'s output projection;
    with `prefill_only` every lane through the prefill arm, as the draft
    head's rows are."""
    q = ops.attn.mla_absorb_q(q_nope, a.kv_b_proj, a.heads, a.kv_lora_rank, a.qk_nope_head_dim, a.v_head_dim)
    scored = ops.attn.attend_mla(q, q_pe, inputs, a.kv, a.heads, a.kv_lora_rank, a.sm_scale,
                                 selection = selection, prefill_only = prefill_only)

    o = ops.attn.mla_absorb_out(scored, a.kv_b_proj, a.heads, a.kv_lora_rank, a.qk_nope_head_dim, a.v_head_dim)
    if a.gate != None:
        o = ops.elemwise.gate_sigmoid_mul(o, ops.linear.matmul(x, a.gate))
    return ops.linear.matmul(o, a.o_proj)

def boundaries(positions, row_valid, ratio, split = True):
    """Where the rows close entries of a key pool that compresses `ratio`
    rows into one: each boundary's position, request and rope position.
    With `split` the decode and prefill arms find theirs apart."""
    if not split:
        return ops.attn.pool_boundary(positions, row_valid, ratio, decode = False)
    one = fact.single_token()
    dpos, dreq, drope = ops.attn.pool_boundary(positions.on(one), row_valid, ratio, decode = True)
    ppos, preq, prope = ops.attn.pool_boundary(positions.on(~one), row_valid, ratio, decode = False)
    return merge([dpos, ppos]), merge([dreq, preq]), merge([drope, prope])
