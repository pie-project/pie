# The adapter banks a layer's LoRA correction reads: `slots` adapters of
# `rank`, registered by the host rather than read from a checkpoint.

ADAPTERS = struct(slots = 8, rank = 16)

def banks(hidden):
    """The `lora_a` and `lora_b` banks over a `hidden`-wide residual."""
    return (
        weight([ADAPTERS.slots, ADAPTERS.rank, hidden]).registered(),
        weight([ADAPTERS.slots, hidden, ADAPTERS.rank]).registered(),
    )

def corrected(x, o, w, routes):
    """`o` with each adapted row's LoRA correction over `x` through `w`'s
    banks, the adapter each row reads named by `routes`."""
    adapted = fact.has(fact.Adapter)
    return ops.linear.lora_correct(x.on(adapted), w.lora_a, w.lora_b, routes, o.on(adapted))

PEFT = struct(slots = 4, rank = 16)

def peft_banks(hidden, q_width, kv_width, inter):
    widths = {
        "q": (hidden, q_width),
        "k": (hidden, kv_width),
        "v": (hidden, kv_width),
        "o": (q_width, hidden),
        "gate": (hidden, inter),
        "up": (hidden, inter),
        "down": (inter, hidden),
    }
    return struct(**{
        site: struct(
            lora_a = weight([PEFT.slots, PEFT.rank, fan_in]).registered(),
            lora_b = weight([PEFT.slots, fan_out, PEFT.rank]).registered(),
        )
        for site, (fan_in, fan_out) in widths.items()
    })

def peft(w, routes):
    adapted = fact.has(fact.Adapter)

    def correct(site, x, y):
        return corrected(x, y, getattr(w.lora, site), routes)

    def split(x, arm):
        within = lambda site, x, y: correct(site, x, y).on(adapted)
        return branch(x, [(adapted, lambda x: arm(x, within))], otherwise = lambda x: arm(x, None))

    return struct(correct = correct, split = split)
