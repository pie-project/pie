# The adapter banks a layer's LoRA correction reads: `slots` adapters of
# `rank`, registered by the host rather than read from a checkpoint.

ADAPTERS = struct(slots = 8, rank = 16)

def banks(hidden):
    """The `lora_a` and `lora_b` banks over a `hidden`-wide residual."""
    return (
        weight([ADAPTERS.slots, ADAPTERS.rank, hidden]).registered(),
        weight([ADAPTERS.slots, hidden, ADAPTERS.rank]).registered(),
    )
