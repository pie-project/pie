# MiniMax H3 FL2VA: a joint video-and-audio diffusion transformer with the
# Qwen3-VL text encoder it reads captions through; and its miniature, which
# carries no text encoder.

load("//lib/spoken.poem", "QWEN_STOP")

CHATML = template("chatml", thinking = True, tools = True, stop = QWEN_STOP)
TOKENIZER = tokenizer(markers = [QWEN_STOP])

MODELS = [
    model("minimax-h3-fl2va", template = CHATML, tokenizer = TOKENIZER, arch = "minimax_h3", layers = 50, vocab = 151936),
    model("minimax-h3-mini", mini = True, template = CHATML, tokenizer = TOKENIZER, arch = "minimax_h3", layers = 3, vocab = 0),
]

DEPLOYMENTS = [
    deployment("minimax-h3-fl2va", weights = dtype.bf16, kv = dtype.bf16),
    deployment("minimax-h3-mini", weights = dtype.bf16, kv = dtype.bf16),
]
