# How a GLM-4.5 / 4.6 / 4.7 checkpoint is read: transformers' safetensors
# under `model.`, each expert apart, as released (bf16), as Z.ai releases it
# in FP8 (compressed-tensors: e4m3 codes and a scale a row; biases, norms,
# router and score bias unquantized) or as modelopt exports it in NVFP4
# (attention bf16; every MLP's legs codes, e4m3 scales a 16, a tensor and an
# input scale); recognized by its biased q and its router's score bias, and
# checked against its config. The draft layer stored after the last is not
# read.

load("//pie/codec.poem", "bank", "weight")

def configured(m):
    return [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("head_dim", m.head_dim),
        config("num_hidden_layers", len(m.layers)),
        config("n_routed_experts", m.experts),
        config("partial_rotary_factor", 0.5),
        config("rms_norm_eps", m.eps),
        config("rope_theta", m.theta),
        config("max_position_embeddings", m.max_position),
    ]

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("model.layers.0.self_attn.q_proj.bias") and has("model.layers.{}.mlp.gate.e_score_correction_bias".format(len(m.layers) - 1)),
        read = lambda reads: read(m, reads),
        states = configured(m),
    )]

def read(m, reads):
    reads.read(m.embed, "model.embed_tokens.weight")
    reads.read(m.final_norm, "model.norm.weight")
    reads.read(m.head, "lm_head.weight")
    for l, w in enumerate(m.layers):
        n = lambda s: "model.layers.{}.{}".format(l, s)
        a = lambda s: n("self_attn.{}".format(s))
        reads.read(w.attn_norm, n("input_layernorm.weight"))
        weight(
            reads,
            w.qkv,
            [a("q_proj.weight"), a("k_proj.weight"), a("v_proj.weight")],
            quantized = "widen",
        )
        reads.read_concat(w.qkv_bias, [a("q_proj.bias"), a("k_proj.bias"), a("v_proj.bias")])
        weight(reads, w.o, [a("o_proj.weight")], quantized = "widen")
        if w.q_norm != None:
            reads.read(w.q_norm, a("q_norm.weight"))
            reads.read(w.k_norm, a("k_norm.weight"))
        reads.read(w.mlp_norm, n("post_attention_layernorm.weight"))
        f = w.mlp
        if not f.routed:
            weight(
                reads,
                f.gate_up,
                [n("mlp.gate_proj.weight"), n("mlp.up_proj.weight")],
                quantized = "widen",
            )
            weight(reads, f.down, [n("mlp.down_proj.weight")], quantized = "widen")
            continue
        reads.read(f.router, n("mlp.gate.weight"))
        reads.read(f.bias, n("mlp.gate.e_score_correction_bias"))
        weight(
            reads,
            f.shared.gate_up,
            [n("mlp.shared_experts.gate_proj.weight"), n("mlp.shared_experts.up_proj.weight")],
            quantized = "widen",
        )
        weight(reads, f.shared.down, [n("mlp.shared_experts.down_proj.weight")], quantized = "widen")
        e = lambda i, leg: n("mlp.experts.{}.{}.weight".format(i, leg))
        gate_up = [[e(i, "gate_proj"), e(i, "up_proj")] for i in range(f.experts)]
        down = [[e(i, "down_proj")] for i in range(f.experts)]
        bank(reads, f.gate_up, gate_up)
        bank(reads, f.down, down)
