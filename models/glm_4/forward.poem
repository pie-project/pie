# The forward of GLM-4.5 / 4.6 / 4.7: pre-norm layers of grouped-query
# attention, q, k and v biased, q and k RMS-normed per head where the model
# has the norms, and the first half of each head rotated (neox halves); then
# a SwiGLU MLP on the first layers, and on the rest the shared expert plus
# the routed experts a biased sigmoid picks, their weights renormalized and
# scaled. A row with an adapter adds its LoRA correction to the attention's
# output.

def caches(m, c):
    kv = c.kv_space(m.kv)
    for w in m.layers:
        c.kv(kv, w.kv, [m.kv_width, m.kv_width], m.head_dim, heads = True)

def forward(m, inputs):
    ([input_m, input_s, input_d], input_p) = inputs.partition([fact.has(fact.Mask), fact.scores(), fact.single_token()])
    plans = struct(
        m = ops.attn.plan_prefill(input_m, m.q_heads, m.kv_heads, m.head_dim, None),
        d = ops.attn.plan_decode(input_d, m.q_heads, m.kv_heads, m.head_dim, None),
        p = ops.attn.plan_prefill(input_p, m.q_heads, m.kv_heads, m.head_dim, None),
        s = ops.attn.plan_prefill(input_s, m.q_heads, m.kv_heads, m.head_dim, None),
    )
    mask = inputs.mask()
    positions = inputs.positions()
    y = ops.gather.embed(inputs.tokens(), m.embed, m.vocab)
    routes = inputs.adapter_routes()

    def block(l, w, y):
        x = ops.elemwise.rmsnorm(y, w.attn_norm, m.eps)
        o = attention(x, inputs, m, plans, mask, positions, w)
        adapted = fact.has(fact.Adapter)
        o = ops.linear.lora_correct(x.on(adapted), w.lora_a, w.lora_b, routes, o.on(adapted))
        y = ops.elemwise.residual_add(o, y)
        x = ops.elemwise.rmsnorm(y, w.mlp_norm, m.eps)
        return ops.elemwise.residual_add(mlp(x, w.mlp), y)

    y = inputs.fold_layers(m.layers, y, block)
    x = ops.elemwise.rmsnorm(y, m.final_norm, m.eps)
    x = ops.gather.gather_rows(x, inputs.readout_rows())
    return ops.linear.lm_head(x, m.head)

def mlp(x, f):
    if not f.routed:
        return ops.linear.matmul(ops.linear.mlp_swiglu(ops.linear.matmul(x, f.gate_up), f.inter), f.down)
    routes, weights = ops.linear.moe_topk_sigmoid_biased(
        ops.linear.matmul(x, f.router),
        f.bias,
        f.experts,
        f.top_k,
        True,
        f.scaling,
    )

    def select(act, bank):
        if bank.dtype in [dtype.bf16, dtype.f16, dtype.f32]:
            return ops.linear.moe_matmul_select(act, bank, routes, f.top_k)
        return ops.linear.moe_matmul_select_quant(act, bank, routes, f.top_k)

    act = ops.linear.mlp_swiglu(ops.linear.matmul(x, f.shared.gate_up), f.shared.inter)
    shared = ops.linear.matmul(act, f.shared.down)
    act = ops.linear.mlp_swiglu(select(x, f.gate_up), f.inter)
    routed = ops.linear.moe_weighted_sum(select(act, f.down), weights)
    return ops.elemwise.residual_add(shared, routed)

def attention(x, inputs, m, plans, mask, positions, w):
    pages = inputs.kv(w.kv)
    d = m.head_dim
    q, k, v = ops.gather.split_qkv(
        ops.elemwise.add_bias(w.qkv_bias, ops.linear.matmul(x, w.qkv)),
        m.q_width,
        m.kv_width,
    )
    seam.at(seam.ATTN_QV, [q, v])
    if w.q_norm != None:
        q = ops.elemwise.rmsnorm_per_head(q, w.q_norm, d, m.eps)
        k = ops.elemwise.rmsnorm_per_head(k, w.k_norm, d, m.eps)
    q, k = ops.elemwise.rope_partial(q, k, positions, m.rotary_dim, d, m.theta)
    ops.attn.kv_append(k, v, pages, inputs.write_page(w.kv), inputs.write_offset(w.kv))
    seam.at(seam.ATTN_Q, [q])

    def scored(q):
        o, lse = ops.attn.prefill_lse(q, plans.s, pages, None, d, m.kv_heads, m.sm_scale)
        seam.at(seam.SCORES, [lse])
        return o

    o = switch(q, [
        (fact.has(fact.Mask), lambda q: ops.attn.masked(q, plans.m, mask, pages, None, d, m.kv_heads, True, m.sm_scale)),
        (fact.scores(), scored),
        (fact.single_token(), lambda q: ops.attn.decode(q, plans.d, pages, None, d, m.sm_scale)),
    ], otherwise = lambda q: ops.attn.prefill(q, plans.p, pages, None, d, m.kv_heads, m.sm_scale))
    seam.at(seam.ATTN_OUT, [o])
    return ops.linear.matmul(o, w.o)
