# GLM-5: a mixture of experts behind multi-head latent attention, its keys
# chosen per query by a lightning indexer; GLM-5.3, whose indexers rank on
# one layer in four and lend the layers between their selection, with its
# multi-token draft head or without, its seven-layer, eight-expert
# miniature, and those seven layers with every expert, for a per-layer
# reading against other engines.

STOP = ["<|im_end|>", "<|endoftext|>", "<|user|>", "<|assistant|>"]
CHATML = template("chatml", thinking = True, tools = True, stop = STOP)
TOKENIZER = tokenizer(markers = [STOP])

GLM = template("glm")
GLM_TOKENIZER = tokenizer(markers = [["<|user|>", "<|observation|>", "<|endoftext|>"]])

MODELS = [
    model("glm5-a12b", template = CHATML, tokenizer = TOKENIZER, arch = "glm_moe_dsa", layers = 46, vocab = 151552),
    model("glm53", template = GLM, tokenizer = GLM_TOKENIZER, drafters = ["mtp"], arch = "glm_moe_dsa", layers = 78, vocab = 154880),
    model("glm53-mini", mini = True, template = GLM, tokenizer = GLM_TOKENIZER, arch = "glm_moe_dsa", layers = 7, vocab = 154880),
    model("glm53-l7", mini = True, template = GLM, tokenizer = GLM_TOKENIZER, arch = "glm_moe_dsa", layers = 7, vocab = 154880),
]

BF = dtype.bf16
U4 = dtype.u4g64
A8 = dtype.mxfp4a8
F8 = dtype.e4m3tile128a8
NV = dtype.nvfp4
NV4 = dtype.nvfp4a4

DEPLOYMENTS = [
    deployment("glm5-a12b", weights = BF, kv = BF),
    deployment("glm53", weights = [BF, U4], kv = BF),
    deployment("glm53", weights = [BF, U4, U4], kv = BF, drafter = "mtp"),
    deployment("glm53-mini", weights = BF, kv = BF),
    deployment("glm53-mini", weights = [BF, U4], kv = BF),
    deployment("glm53-l7", weights = [BF, U4], kv = BF),
    deployment("glm53-l7", weights = BF, kv = BF),
    deployment("glm53-l7", weights = [BF, A8], kv = BF),
    deployment("glm53-mini", weights = [BF, A8], kv = BF),
    # The release's own FP8 experts (128x128 blocks under f32 factors), as
    # vLLM serves them: the like-for-like row.
    deployment("glm53-l7", weights = [BF, F8], kv = BF),
    deployment("glm53-mini", weights = [BF, F8], kv = BF),
    # Every FP8 tensor of the release as released: the projections too.
    deployment("glm53-l7", weights = [F8, F8], kv = BF),
    deployment("glm53-mini", weights = [F8, F8], kv = BF),
    # nvidia's modelopt NVFP4 export, as vLLM's recipe serves it: the routed
    # experts NVFP4 against NVFP4 activations (the tcgen05 grouped GEMMs) or
    # against bf16 ones, the attention and shared experts bf16, the dense
    # layers' MLP widened from its per-tensor FP8.
    deployment("glm53", weights = [BF, NV4], kv = BF),
    deployment("glm53-mini", weights = [BF, NV4], kv = BF),
    # ... with the dense layers' MLP kept the export's FP8 (its one scale a
    # projection as every 128-square block's factor), as vLLM serves it.
    deployment("glm53", weights = [BF, NV4, F8], kv = BF),
    deployment("glm53-mini", weights = [BF, NV4, F8], kv = BF),
    deployment("glm53-mini", weights = [BF, NV], kv = BF),
]
