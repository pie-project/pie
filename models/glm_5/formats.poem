# How a GLM-5 checkpoint is laid out: transformers' names, each expert's
# projections a tensor of their own; GLM-5.3's draft head the layer after
# the last. GLM-5.3 stores its projections FP8 in 128-square blocks beside
# `*_scale_inv`; modelopt's export keeps attention and shared experts bf16,
# the dense MLP per-tensor e4m3, and the routed experts NVFP4.

load("//lib/modelopt/formats.poem", "fp8_tensor_leg", "nvfp4_bank")

load("//lib/blockfp8/formats.poem", "fp8_bank", "fp8_proj", "fp8_read", "modelopt_fp8", "released_fp8")

BF = raw(dtype.bf16)

def proj_read(reads, w, name):
    """`w` from `name`: as the release stores it where `w` keeps its FP8."""
    if fp8_proj(w):
        fp8_read(reads, w, [name])
    elif modelopt_fp8(name):
        land(reads, w, fp8_tensor_leg(reads, name))
    else:
        reads.read(w, name)

def named(a, at):
    """`a`'s weights, each beside the name `at` gives its transformers leaf,
    in the order a checkpoint lists them."""
    out = [
        (a.q_a_proj, at("self_attn.q_a_proj.weight")),
        (a.q_a_norm, at("self_attn.q_a_layernorm.weight")),
        (a.q_b_proj, at("self_attn.q_b_proj.weight")),
        (a.kv_a_proj, at("self_attn.kv_a_proj_with_mqa.weight")),
        (a.kv_a_norm, at("self_attn.kv_a_layernorm.weight")),
        (a.kv_b_proj, at("self_attn.kv_b_proj.weight")),
    ]
    if a.gate != None:
        out.append((a.gate, at("self_attn.g_proj.weight")))
    out.append((a.o_proj, at("self_attn.o_proj.weight")))
    ix = a.indexer
    if ix != None:
        out.extend([
            (ix.q_proj, at("self_attn.indexer.wq_b.weight")),
            (ix.k_proj, at("self_attn.indexer.wk.weight")),
            (ix.weights_proj, at("self_attn.indexer.weights_proj.weight")),
            (ix.k_norm, at("self_attn.indexer.k_norm.weight")),
            (ix.k_norm_bias, at("self_attn.indexer.k_norm.bias")),
        ])
    return out

def formats(m):
    return [format("huggingface", read = lambda reads: huggingface(m, reads))]

def huggingface(m, reads):
    reads.read(m.embed, "model.embed_tokens.weight")
    reads.read(m.final_norm, "model.norm.weight")
    reads.read(m.head, "lm_head.weight")
    for l, layer in enumerate(m.layers):
        at = lambda tail: "model.layers.{}.{}".format(l, tail)
        reads.read(layer.attn_norm, at("input_layernorm.weight"))
        reads.read(layer.mlp_norm, at("post_attention_layernorm.weight"))
        for w, name in named(layer.attn, at):
            proj_read(reads, w, name)
        f = layer.mlp
        if f.routed:
            moe(reads, at, f)
        else:
            joined(reads, f.gate_up, [at("mlp.gate_proj.weight"), at("mlp.up_proj.weight")])
            proj_read(reads, f.down, at("mlp.down_proj.weight"))

    mtp = m.mtp
    if mtp == None:
        return
    at = lambda tail: "model.layers.{}.{}".format(len(m.layers), tail)
    reads.read(mtp.enorm, at("enorm.weight"))
    reads.read(mtp.hnorm, at("hnorm.weight"))
    eh = leg(reads, at("eh_proj.weight"))
    land(reads, mtp.e_proj, eh.slice(1, 0, m.hidden))
    land(reads, mtp.h_proj, eh.slice(1, m.hidden, m.hidden))
    reads.read(mtp.attn_norm, at("input_layernorm.weight"))
    reads.read(mtp.mlp_norm, at("post_attention_layernorm.weight"))
    for w, name in named(mtp.attn, at):
        reads.read(w, name)
    moe(reads, at, mtp.mlp)
    reads.read(mtp.norm, at("shared_head.norm.weight"))

def moe(reads, at, f):
    reads.read(f.router, at("mlp.gate.weight"))
    if f.bias != None:
        reads.read(f.bias, at("mlp.gate.e_score_correction_bias"))
    hidden = f.down.shape[1]
    if f.gate_up.dtype in [dtype.nvfp4, dtype.nvfp4a4]:
        stem = lambda e, leaf: at("mlp.experts.{}.{}".format(e, leaf))
        nvfp4_bank(reads, f.gate_up, [[stem(e, "gate_proj"), stem(e, "up_proj")] for e in range(f.experts)])
        nvfp4_bank(reads, f.down, [[stem(e, "down_proj")] for e in range(f.experts)])
        shared(reads, at, f)
        return
    if released_fp8(f.gate_up):
        name = lambda e, leaf: at("mlp.experts.{}.{}.weight".format(e, leaf))
        fp8_bank(reads, f.gate_up, [[name(e, "gate_proj"), name(e, "up_proj")] for e in range(f.experts)])
        fp8_bank(reads, f.down, [[name(e, "down_proj")] for e in range(f.experts)])
        shared(reads, at, f)
        return
    expert = lambda e, leaf: leg(reads, at("mlp.experts.{}.{}.weight".format(e, leaf)))
    land(reads, f.gate_up, concat(0, [
        concat(0, [expert(e, "gate_proj"), expert(e, "up_proj")]).transmute([1, 2 * f.inter, hidden], BF)
        for e in range(f.experts)
    ]))
    land(reads, f.down, concat(0, [
        expert(e, "down_proj").transmute([1, hidden, f.inter], BF)
        for e in range(f.experts)
    ]))
    shared(reads, at, f)

def shared(reads, at, f):
    joined(reads, f.shared.gate_up, [
        at("mlp.shared_experts.gate_proj.weight"),
        at("mlp.shared_experts.up_proj.weight"),
    ])
    proj_read(reads, f.shared.down, at("mlp.shared_experts.down_proj.weight"))

def leg(reads, name):
    """The tensor `name` as bf16: as stored, or, stored FP8, dequantized by
    its block factors."""
    if stored(name) == BF:
        return src(name)
    if modelopt_fp8(name):
        return fp8_tensor_leg(reads, name)
    reads.push(tensor(name + ".bf16", src(name).cast(BF), BF, internal = True))
    return out(name + ".bf16")

def land(reads, w, value):
    """`w` from the bf16 `value`, encoded to its own dtype."""
    if w.dtype == dtype.bf16:
        reads.push(tensor(w.name, value, BF))
    else:
        reads.push(tensor(w.name, value.cast(grouped(w)), grouped(w)))

def joined(reads, w, names):
    """`w` from the tensors `names`, joined along its first axis."""
    if fp8_proj(w):
        fp8_read(reads, w, names)
        return
    if all([stored(name) == BF for name in names]):
        reads.read_concat(w, names)
    else:
        land(reads, w, concat(0, [leg(reads, name) for name in names]))
