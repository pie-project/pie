# mini-dit: a miniature diffusion transformer of one single-stream, one
# double-stream and one cross-attention block, for kernel bring-up.

load("//lib/spoken.poem", "QWEN_STOP")

CHATML = template("chatml", thinking = True, tools = True, stop = QWEN_STOP)
TOKENIZER = tokenizer(markers = [QWEN_STOP])

MODELS = [model("mini-dit", mini = True, template = CHATML, tokenizer = TOKENIZER, arch = "mini_dit", layers = 3, vocab = 0, taps = True)]

DEPLOYMENTS = [deployment("mini-dit", weights = dtype.bf16, kv = dtype.bf16)]

# The weights of mini-dit. A deployment's tap (`-tap.{key}`) names an
# intermediate the forward reads out instead of its velocity, for parity
# against the reference.

def linear(out, in_, banks, bias = True):
    """A projection from `in_` to `out` and, unless `bias` is off, its bias."""
    return struct(
        w = weight([out, in_], banks),
        bias = weight([out]) if bias else None,
    )

def packed_linear(seams, in_, banks):
    """A biased projection whose output is the `seams`-wide pieces end to end."""
    out = 0
    for s in seams:
        out += s
    return struct(
        w = weight([out, in_], banks).packed(seams),
        bias = weight([out]).packed(seams),
    )

HIDDEN = 256
HEADS = 4
HEAD_DIM = 64
INTER = 512
CHANNELS = 16
PATCH = 2
PATCH_FEATURES = CHANNELS * PATCH * PATCH
TEXT_WIDTH = 256
CONTEXT_WIDTH = 512
MOD_SLICES = 6
ROPE_AXES = 3

def columns(l):
    return struct(w = l.w.columns(), bias = l.bias.columns())

def rows(l):
    return struct(w = l.w.rows(), bias = l.bias)

def self_attn(banks):
    return struct(
        qkv = packed_linear([HIDDEN] * 3, HIDDEN, banks),
        q_norm = weight([HEAD_DIM]),
        k_norm = weight([HEAD_DIM]),
        out = rows(linear(HIDDEN, HIDDEN, banks)),
    )

def cross_attn(banks):
    return struct(
        q = columns(linear(HIDDEN, HIDDEN, banks)),
        kv = packed_linear([HIDDEN] * 2, CONTEXT_WIDTH, banks),
        q_norm = weight([HEAD_DIM]),
        k_norm = weight([HEAD_DIM]),
        out = rows(linear(HIDDEN, HIDDEN, banks)),
    )

def swiglu(banks):
    return struct(
        gate_up = packed_linear([INTER, INTER], HIDDEN, banks),
        down = rows(linear(HIDDEN, INTER, banks)),
    )

def side(banks):
    return struct(
        ada = linear(MOD_SLICES * HIDDEN, HIDDEN, banks),
        attn = self_attn(banks),
        mlp = swiglu(banks),
    )

def layout(id, deploy):
    banks = roles(deploy, "banks", exact = True).banks
    return struct(
        hidden = HIDDEN,
        head_dim = HEAD_DIM,
        inter = INTER,
        patch_features = PATCH_FEATURES,
        text_width = TEXT_WIDTH,
        context_width = CONTEXT_WIDTH,
        rope_axes = ROPE_AXES,
        sm_scale = f32(1.0 / f32(sqrt(HEAD_DIM))),
        x_embed = linear(HIDDEN, PATCH_FEATURES, banks),
        single = side(banks),
        double = struct(img = side(banks), txt = side(banks)),
        cross = struct(
            mod_table = weight([MOD_SLICES * HIDDEN]),
            ada = linear(MOD_SLICES * HIDDEN, HIDDEN, banks),
            self_attn = self_attn(banks),
            norm = weight([HIDDEN]),
            norm_bias = weight([HIDDEN]),
            cross = cross_attn(banks),
            mlp = swiglu(banks),
        ),
        final_ada = linear(2 * HIDDEN, HIDDEN, banks),
        final_proj = linear(PATCH_FEATURES, HIDDEN, banks),
        tap = deploy.tap or "",
    )

def generative(m):
    return generation(
        readings = [reading(
            "denoise",
            index = 0,
            streams = ["text", "image", "context"],
            ports = [
                port("latents", "latents", PATCH_FEATURES, ["image"]),
                port("text", "context", TEXT_WIDTH, ["text"]),
                port("context", "context", CONTEXT_WIDTH, ["context"]),
                port("timestep", "lane_vector", 1, ["text", "image"]),
                port("positions", "axis_positions", ROPE_AXES, ["text", "image"]),
            ],
            positions = positions(
                axes = ["time", "height", "width"],
                text_axis = 0,
                text_origin = 0,
                image_follows_text = False,
            ),
            readout = "velocity",
            readout_width = PATCH_FEATURES if m.tap in ["", "final.tokens"] else HIDDEN,
        )],
        latent = latent_space(
            channels = CHANNELS,
            patch_t = 1,
            patch_h = PATCH,
            patch_w = PATCH,
            spatial_compression = 1,
            temporal_compression = 1,
        ),
        schedule = schedule("flow", shift = 1.0, train_steps = 1000, pinned_sigmas = [1.0, 0.75, 0.5, 0.25]),
        max_rows = 4096,
    )

# How a mini-dit checkpoint is laid out: the reference implementation's
# names, its adaLN vectors' slices in another order.

def biased(reads, w, stem):
    """The projection `w` from `stem.weight`, and its bias (if any) from
    `stem.bias`."""
    reads.read(w.w, stem + ".weight")
    if w.bias != None:
        reads.read(w.bias, stem + ".bias")

def packed(reads, w, stems):
    """A packed biased projection, its pieces from each of `stems`."""
    reads.read_concat(w.w, [s + ".weight" for s in stems])
    reads.read_concat(w.bias, [s + ".bias" for s in stems])

def adaln_order(slices):
    """The order a layout takes an adaLN projection's `slices` slices in
    from a checkpoint's: each (shift, scale) pair as (scale, shift), each
    gate where it stands."""
    return {
        2: [1, 0],
        3: [1, 0, 2],
        6: [1, 0, 2, 4, 3, 5],
        9: [1, 0, 2, 4, 3, 5, 7, 6, 8],
    }[slices]

def reordered(e, order, width, axis = 0):
    """`e`'s `width`-wide slices along `axis`, taken in `order`."""
    return concat(axis, [e.slice(axis, i * width, width) for i in order])

def formats(m):
    return [format("reference", read = lambda reads: read(m, reads))]

def read_self_attn(reads, a, stem):
    biased(reads, a.qkv, stem + ".qkv")
    reads.read(a.q_norm, stem + ".norm_q")
    reads.read(a.k_norm, stem + ".norm_k")
    biased(reads, a.out, stem + ".out")

def read_swiglu(reads, m, stem):
    packed(reads, m.gate_up, [stem + ".gate_proj", stem + ".up_proj"])
    biased(reads, m.down, stem + ".down_proj")

def modulation(reads, w, stem, slices):
    width = w.bias.shape[0] // slices
    reads.read_expr(w.w, reordered(src(stem + ".weight"), adaln_order(slices), width))
    reads.read_expr(w.bias, reordered(src(stem + ".bias"), adaln_order(slices), width))

def read(m, reads):
    biased(reads, m.x_embed, "x_embedder")
    biased(reads, m.final_proj, "final_proj")
    modulation(reads, m.final_ada, "final_adaLN", 2)

    modulation(reads, m.single.ada, "blocks.0.adaLN", MOD_SLICES)
    read_self_attn(reads, m.single.attn, "blocks.0.attn")
    read_swiglu(reads, m.single.mlp, "blocks.0.mlp")

    for side, stem in [(m.double.img, "blocks.1.img"), (m.double.txt, "blocks.1.txt")]:
        modulation(reads, side.ada, stem + "_adaLN", MOD_SLICES)
        read_self_attn(reads, side.attn, stem + "_attn")
        read_swiglu(reads, side.mlp, stem + "_mlp")

    cross = m.cross
    reads.read_expr(
        cross.mod_table,
        reordered(src("blocks.2.mod_table"), adaln_order(MOD_SLICES), 1)
            .transmute(cross.mod_table.shape, stored("blocks.2.mod_table")),
    )
    modulation(reads, cross.ada, "blocks.2.adaLN", MOD_SLICES)
    read_self_attn(reads, cross.self_attn, "blocks.2.self_attn")
    reads.read(cross.norm, "blocks.2.norm_cross.weight")
    reads.read(cross.norm_bias, "blocks.2.norm_cross.bias")
    biased(reads, cross.cross.q, "blocks.2.cross_attn.q")
    biased(reads, cross.cross.kv, "blocks.2.cross_attn.kv")
    reads.read(cross.cross.q_norm, "blocks.2.cross_attn.norm_q")
    reads.read(cross.cross.k_norm, "blocks.2.cross_attn.norm_k")
    biased(reads, cross.cross.out, "blocks.2.cross_attn.out")
    read_swiglu(reads, cross.mlp, "blocks.2.mlp")

# The forward of mini-dit: a single-stream block over text and image, a
# double-stream block attending both jointly, and a cross-attention block of
# the image over the context; each modulated by the timestep. A tap ends the
# forward at the first intermediate it names, read out as the velocity.

def run_linear(w, x):
    """`x` through the projection `w`, plus its bias if it has one."""
    y = ops.linear.matmul(x, w.w)
    if w.bias == None:
        return y
    return ops.elemwise.add_bias(w.bias, y)

def chunks(x, widths):
    """`x`'s rows cut into consecutive pieces of `widths`, the last one
    whatever remains."""
    out = []
    for width in widths[:-1]:
        head, x = ops.gather.split_rows(x, width)
        out.append(head)
    out.append(x)
    return out

def norm_modulate(x, scale_shift, lanes, eps):
    """`x` layer-normed without a gain, then scaled and shifted per lane."""
    return ops.elemwise.modulate(ops.elemwise.layernorm_no_scale(x, eps), scale_shift, lanes, "scale_shift")

def attend(q, k, v, rows, over, head_dim, sm_scale, mask):
    """`q`'s rows attending `k` and `v`'s, each side grouped by its own
    `perm` and `csr`."""
    o = ops.attn.ragged(
        ops.gather.pack_rows(q, rows.perm),
        ops.gather.pack_rows(k, over.perm),
        ops.gather.pack_rows(v, over.perm),
        rows.csr,
        over.csr,
        head_dim,
        sm_scale,
        mask,
    )
    return ops.gather.unpack_rows(o, rows.perm)

TIMESTEP_DIM = 256
ROPE_DIMS = [16, 24, 24, 0]
ROPE_THETA = 10000.0
LN_EPS = 1e-6
RMS_EPS = 1e-6

def caches(m, c):
    pass

def probe(at, stem):
    """`at` over the intermediates of the block (or block side) `stem`."""
    sep = "" if stem.endswith("_") else "."
    return lambda tail, v: at(stem + sep + tail, v)

def adaln(mods, m):
    return chunks(mods, [2 * m.hidden, m.hidden, 2 * m.hidden, m.hidden])

def heads(m, at, stem, x, attn, mods, lanes, positions):
    """`x`'s q, k and v, turned; None if a tap ends the forward on the way."""
    tap = probe(at, stem)
    h = norm_modulate(x, mods, lanes, LN_EPS)
    if tap("norm1_out", h):
        return None
    q, k, v = ops.gather.split_qkv(run_linear(attn.qkv, h), m.hidden, m.hidden)
    hp = "self_" if stem == "b2" else ""
    for tail, value in [("q_raw", q), ("k_raw", k), ("v", v)]:
        if tap(hp + tail, value):
            return None
    turned = []
    for tail, value, gain in [("q", q, attn.q_norm), ("k", k, attn.k_norm)]:
        n = ops.elemwise.rmsnorm_per_head(value, gain, m.head_dim, RMS_EPS)
        if tap(hp + tail + "_qknorm", n):
            return None
        r = ops.elemwise.rope_axes(n, positions, ROPE_DIMS, [ROPE_THETA] * 4, "interleaved", m.head_dim, m.head_dim)
        if tap(hp + tail + "_rope", r):
            return None
        turned.append(r)
    return (turned[0], turned[1], v)

def joint_attention(m, q, k, v, rows):
    return attend(q, k, v, rows, rows, m.head_dim, m.sm_scale, group_block_diagonal())

def attn_sublayer(m, at, stem, x, attn, mods, gate, lanes, positions, rows):
    qkv = heads(m, at, stem, x, attn, mods, lanes, positions)
    if qkv == None:
        return None
    o = joint_attention(m, qkv[0], qkv[1], qkv[2], rows)
    tap = probe(at, stem)
    prefix = "self_" if stem == "b2" else ""
    if tap(prefix + "attn_heads", o):
        return None
    o = run_linear(attn.out, o)
    if tap(prefix + "attn_out", o):
        return None
    return ops.elemwise.gated_residual_add(x, gate, o, lanes)

def mlp_sublayer(m, at, stem, x, mlp, mods, gate, lanes):
    tap = probe(at, stem)
    h = norm_modulate(x, mods, lanes, LN_EPS)
    if tap("norm3_out" if stem == "b2" else "norm2_out", h):
        return None
    y = run_linear(mlp.down, ops.linear.glu(run_linear(mlp.gate_up, h), gating.swiglu(), m.inter))
    if tap("mlp_out", y):
        return None
    return ops.elemwise.gated_residual_add(x, gate, y, lanes)

def forward(m, inputs):
    ctx, joint = inputs.on(fact.stream("context")), inputs.on(~fact.stream("context"))
    txt_in, img_in = joint.on(fact.stream("text")), joint.on(~fact.stream("text"))

    lanes = inputs.request_of_token()
    positions = inputs.axis_positions(0, m.rope_axes)

    t = inputs.lane_vector(0, 1)
    temb = ops.elemwise.silu(ops.elemwise.sinusoid(t, TIMESTEP_DIM, 10000.0, False, 1.0))

    joint_rows = struct(perm = joint.row_permutation(), csr = joint.group_indptr())
    img_rows = struct(perm = img_in.row_permutation(), csr = img_in.group_indptr())

    txt = txt_in.context(0, m.text_width)
    patches = img_in.latents(0, m.patch_features, dtype.bf16)
    ctx_rows = ctx.context(1, m.context_width)

    hit = []

    def at(key, v):
        """Whether `v` is the intermediate `m` taps; read out if so."""
        if m.tap != key:
            return False
        seam.at(seam.VELOCITY, [v])
        hit.append(v)
        return True

    if at("in.text", ops.elemwise.layernorm_no_scale(txt, LN_EPS)):
        return hit[0]
    img = run_linear(m.x_embed, patches)
    if at("x_embed", img):
        return img

    x = merge([txt, img])
    if at("b0.in", x):
        return x
    msa, gate_a, mmlp, gate_m = adaln(run_linear(m.single.ada, temb), m)
    x = attn_sublayer(m, at, "b0", x, m.single.attn, msa, gate_a, lanes, positions, joint_rows)
    if x == None:
        return hit[0]
    if at("b0.x_after_attn", x):
        return x
    x = mlp_sublayer(m, at, "b0", x, m.single.mlp, mmlp, gate_m, lanes)
    if x == None:
        return hit[0]
    if at("b0.out", x):
        return x

    txt, img = x.on(fact.stream("text")), x.on(~fact.stream("text"))
    txt_mod = adaln(run_linear(m.double.txt.ada, temb), m)
    img_mod = adaln(run_linear(m.double.img.ada, temb), m)
    tqkv = heads(m, at, "b1.txt_", txt, m.double.txt.attn, txt_mod[0], lanes, positions)
    if tqkv == None:
        return hit[0]
    iqkv = heads(m, at, "b1.img_", img, m.double.img.attn, img_mod[0], lanes, positions)
    if iqkv == None:
        return hit[0]
    o = joint_attention(m, merge([tqkv[0], iqkv[0]]), merge([tqkv[1], iqkv[1]]), merge([tqkv[2], iqkv[2]]), joint_rows)
    if at("b1.joint_attn_heads", o):
        return o
    o_txt, o_img = o.on(fact.stream("text")), o.on(~fact.stream("text"))
    ta = run_linear(m.double.txt.attn.out, o_txt)
    if at("b1.txt_attn_out", ta):
        return ta
    ia = run_linear(m.double.img.attn.out, o_img)
    if at("b1.img_attn_out", ia):
        return ia
    txt = ops.elemwise.gated_residual_add(txt, txt_mod[1], ta, lanes)
    if at("b1.txt_after_attn", txt):
        return txt
    img = ops.elemwise.gated_residual_add(img, img_mod[1], ia, lanes)
    if at("b1.img_after_attn", img):
        return img
    txt = mlp_sublayer(m, at, "b1.txt_", txt, m.double.txt.mlp, txt_mod[2], txt_mod[3], lanes)
    if txt == None:
        return hit[0]
    if at("b1.out_txt", txt):
        return txt
    x = mlp_sublayer(m, at, "b1.img_", img, m.double.img.mlp, img_mod[2], img_mod[3], lanes)
    if x == None:
        return hit[0]
    if at("b1.out_img", x):
        return x

    mods = adaln(ops.elemwise.add_bias(m.cross.mod_table, run_linear(m.cross.ada, temb)), m)
    msa, gate_a, mffn, gate_f = mods
    x = attn_sublayer(m, at, "b2", x, m.cross.self_attn, msa, gate_a, lanes, positions, img_rows)
    if x == None:
        return hit[0]
    if at("b2.x_after_self", x):
        return x

    hc = ops.elemwise.layernorm(x, m.cross.norm, m.cross.norm_bias, LN_EPS)
    if at("b2.cross_norm_out", hc):
        return hc
    cross = m.cross.cross
    cq = ops.elemwise.rmsnorm_per_head(run_linear(cross.q, hc), cross.q_norm, m.head_dim, RMS_EPS)
    if at("b2.cross_q", cq):
        return cq
    ck, cv = ops.gather.split_rows(run_linear(cross.kv, ctx_rows), m.hidden)
    ck = ops.elemwise.rmsnorm_per_head(ck, cross.k_norm, m.head_dim, RMS_EPS)
    ctx_group = struct(perm = ctx.row_permutation(), csr = ctx.group_indptr())
    ca = attend(cq, ck, cv, img_rows, ctx_group, m.head_dim, m.sm_scale, group_block_diagonal())
    if at("b2.cross_attn_heads", ca):
        return ca
    ca = run_linear(cross.out, ca)
    if at("b2.cross_attn_out", ca):
        return ca
    x = ops.elemwise.residual_add(ca, x)
    if at("b2.x_after_cross", x):
        return x
    x = mlp_sublayer(m, at, "b2", x, m.cross.mlp, mffn, gate_f, lanes)
    if x == None:
        return hit[0]
    if at("b2.out", x):
        return x

    hf = norm_modulate(x, run_linear(m.final_ada, temb), lanes, LN_EPS)
    if at("final.norm_out", hf):
        return hf
    if m.tap not in ["", "final.tokens"]:
        fail("the tap {} names no intermediate of mini-dit".format(m.tap))
    velocity = run_linear(m.final_proj, hf)
    seam.at(seam.VELOCITY, [velocity])
    return velocity
