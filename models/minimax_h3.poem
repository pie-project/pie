# MiniMax H3 FL2VA: a joint video-and-audio diffusion transformer with the
# Qwen3-VL text encoder it reads captions through; and its miniature, which
# carries no text encoder.

load("//lib/spoken.poem", "QWEN_STOP")
load("//lib/dit.poem", "adaln_order", "attend", "biased", "chunks", "linear", "reordered", "run_linear")
load("//lib/qwen3_encoder.poem", "encoder", "qwen3_caches", "qwen3_encode", "te_read")

CHATML = template("chatml", thinking = True, tools = True, stop = QWEN_STOP)
TOKENIZER = tokenizer(markers = [QWEN_STOP])

MODELS = [
    model("minimax-h3-fl2va", template = CHATML, tokenizer = TOKENIZER, arch = "minimax_h3", layers = 50, vocab = 151936),
    model("minimax-h3-mini", mini = True, template = CHATML, tokenizer = TOKENIZER, arch = "minimax_h3", layers = 3, vocab = 0),
]

DEPLOYMENTS = [
    deployment("minimax-h3-fl2va", weights = dtype.bf16, kv = dtype.bf16),
    deployment("minimax-h3-mini", weights = dtype.bf16, kv = dtype.bf16),
]

# The weights of MiniMax H3: the denoiser's patch projections, timestep
# embedder, caption refiner, blocks (each with an adaLN projection per
# modality) and output heads; and the text encoder the full model carries.

LATENT_CHANNELS = 24
AUDIO_CHANNELS = 32
PATCH_T = 1
PATCH_H = 2
PATCH_W = 2
VIDEO_FEATURES = LATENT_CHANNELS * PATCH_T * PATCH_H * PATCH_W
SPATIAL_COMPRESSION = 16
TEMPORAL_COMPRESSION = 4
ROPE_AXES = 3
ADALN_SLICES = 6
MODALITIES = 3
FINAL_SLICES = 2
TIMESTEP_SLOTS = 4
TRAIN_STEPS = 1
VIDEO_SHIFT = 12.0
AUDIO_SHIFT = 3.0
STEPS = 50

TE = struct(
    hidden = 5120,
    vocab = 151936,
    q_heads = 64,
    kv_heads = 8,
    head_dim = 128,
    inter = 25600,
    theta = 5000000.0,
    eps = 1e-6,
)
TE_LAYERS = 50

DIMS = {
    "minimax-h3-fl2va": struct(
        dim = 5376,
        heads = 56,
        head_dim = 128,
        inter = 14336,
        blocks = 50,
        refiners = 2,
        text_dim = TE.hidden,
        t_freq = 256,
        t_hidden = 5376,
        t_dim = 2688,
        rope_freqs = 16,
    ),
    "minimax-h3-mini": struct(
        dim = 128,
        heads = 2,
        head_dim = 64,
        inter = 256,
        blocks = 2,
        refiners = 1,
        text_dim = 64,
        t_freq = 32,
        t_hidden = 128,
        t_dim = 64,
        rope_freqs = 8,
    ),
}

def attn(d, banks):
    inner = d.heads * d.head_dim
    return struct(
        qkv = weight([3 * inner, d.dim], banks),
        q_norm = weight([d.head_dim]),
        k_norm = weight([d.head_dim]),
        out = weight([d.dim, inner], banks),
    )

def mlp(prefix, d, banks):
    return struct(
        fc1 = weight([2 * d.inter, d.dim], banks),
        fc2 = weight([d.dim, d.inter], banks),
    )

def block(prefix, d, banks, modulated):
    """A refiner block, or (`modulated`) a denoiser block with an adaLN
    projection per modality."""
    return struct(
        norm1 = weight([d.dim]),
        norm2 = weight([d.dim]),
        attn = attn(d, banks),
        mlp = mlp(prefix + ".mlp", d, banks),
        adaln = [
            linear(ADALN_SLICES * d.dim, d.t_dim, banks)
            for m in range(MODALITIES)
        ] if modulated else None,
    )

def layout(id, deploy):
    banks = roles(deploy, "banks", exact = True).banks
    d = DIMS[id]
    rotary = 6 * d.rope_freqs
    if rotary % 2 != 0 or rotary > d.head_dim:
        fail("the three rotary axes cover {} of a {}-wide head".format(rotary, d.head_dim))
    dim = d.dim
    return struct(
        kv = dtype.bf16,
        dims = d,
        sm_scale = f32(1.0 / f32(sqrt(d.head_dim))),
        rope_dims = [2 * d.rope_freqs, 2 * d.rope_freqs, 2 * d.rope_freqs, 0],
        rotary_dim = rotary,
        rope_axes = ROPE_AXES,
        timestep_slots = TIMESTEP_SLOTS,
        video_features = VIDEO_FEATURES,
        audio_channels = AUDIO_CHANNELS,
        dit = struct(
            video_patch = linear(dim, VIDEO_FEATURES, banks),
            audio_patch = linear(dim, AUDIO_CHANNELS, banks),
            condition = linear(dim, d.text_dim, banks),
            t_in = linear(d.t_hidden, d.t_freq, banks),
            t_out = linear(d.t_dim, d.t_hidden, banks),
            refine = [block("dit.refine.{}".format(i), d, banks, False) for i in range(d.refiners)],
            refine_norm = weight([dim]),
            blocks = [block("dit.block.{}".format(i), d, banks, True) for i in range(d.blocks)],
            final_norm = weight([dim]),
            final_adaln = linear(FINAL_SLICES * dim, d.t_dim, banks),
            video_out = linear(VIDEO_FEATURES, dim, banks),
            audio_out = linear(AUDIO_CHANNELS, dim, banks),
        ),
        te = encoder(TE, TE_LAYERS, banks) if id == "minimax-h3-fl2va" else None,
        rope = struct(
            four = weight([1], dtype.f32, values = [4.0]),
            five = weight([1], dtype.f32, values = [5.0]),
            minus_four = weight([1], dtype.f32, values = [-4.0]),
            minus_span = weight([1], dtype.f32, values = [-5.0 / 3.0]),
            centre = weight([1], dtype.f32, values = [GRID_CENTRE]),
        ),
    )

def shifted_sigmas(shift, steps):
    n = max(steps, 2)
    out = []
    for i in range(n - 1):
        base = 1.0 - float(i) / float(n - 1)
        out.append(shift * base / (1.0 + (shift - 1.0) * base))
    return out

def generative(m):
    return generation(
        latent = latent_space(
            channels = LATENT_CHANNELS,
            spatial_compression = SPATIAL_COMPRESSION,
            temporal_compression = TEMPORAL_COMPRESSION,
            first_frames = 1,
        ),
        schedule = schedule(
            "flow",
            shift = VIDEO_SHIFT,
            train_steps = TRAIN_STEPS,
            pinned_sigmas = shifted_sigmas(VIDEO_SHIFT, STEPS),
            stream_shifts = [("latents", VIDEO_SHIFT), ("audio", AUDIO_SHIFT), ("reference", 1.0)],
        ),
    )

# How a MiniMax H3 checkpoint is laid out: a pipeline's components under
# `dit.` and `te.`, or (for the miniature, which carries no text encoder) a
# bare transformer state_dict. The fused qkv interleaves q, k and v head by
# head, and the adaLN projections' slices come in another order.

PIPELINE = "a MiniMax H3 partition (`dit.`/`te.` prefixes)"
BARE = "a bare transformer state_dict"

def formats(m):
    out = [format(
        PIPELINE,
        recognizes = lambda checkpoint: has_prefix("dit."),
        read = lambda reads: read(m, reads, "dit."),
    )]
    if m.te == None:
        out.append(format(
            BARE,
            recognizes = lambda checkpoint: not has_prefix("dit."),
            read = lambda reads: read(m, reads, ""),
        ))
    return out

def modulation(reads, w, stem, order, width):
    rows = lambda e: reordered(e, order, width)
    reads.read_over(w.w, stem + ".weight", rows)
    reads.read_over(w.bias, stem + ".bias", rows)

def attention(reads, m, a, stem):
    d = m.dims
    name = stem + ".qkv_proj.weight"
    raw_dtype = stored(name).raw
    if raw_dtype == None:
        fail("`{}`: `{}` is stored {}; a fused qkv bank is a raw plane".format(a.qkv.name, name, stored(name)))
    heads = d.heads
    group = d.head_dim * d.dim
    want = a.qkv.shape

    def interleaved(e):
        grouped = e.transmute([3 * heads, group], raw(raw_dtype))
        return concat(0, [grouped.stride(0, which, heads, 3) for which in range(3)]).transmute(want, raw(raw_dtype))

    reads.read_over(a.qkv, name, interleaved)
    reads.read(a.q_norm, stem + ".q_norm.weight")
    reads.read(a.k_norm, stem + ".k_norm.weight")
    reads.read(a.out, stem + ".out_proj.weight")

def read_block(reads, m, b, stem):
    reads.read(b.norm1, stem + ".norm1.weight")
    reads.read(b.norm2, stem + ".norm2.weight")
    attention(reads, m, b.attn, stem + ".attn")
    reads.read(b.mlp.fc1, stem + ".mlp.fc1.weight")
    reads.read(b.mlp.fc2, stem + ".mlp.fc2.weight")

def read(m, reads, prefix):
    d = m.dims
    dit = m.dit
    at = lambda tail: prefix + tail

    biased(reads, dit.video_patch, at("video_patch_proj"))
    biased(reads, dit.audio_patch, at("audio_patch_proj"))
    biased(reads, dit.condition, at("condition_proj"))
    biased(reads, dit.t_in, at("time_embedder.proj_in"))
    biased(reads, dit.t_out, at("time_embedder.proj_out"))

    for i, b in enumerate(dit.refine):
        read_block(reads, m, b, at("token_refiner.blocks.{}".format(i)))
    reads.read(dit.refine_norm, at("token_refiner.final_norm.weight"))

    for i, b in enumerate(dit.blocks):
        stem = at("blocks.{}".format(i))
        read_block(reads, m, b, stem)
        for k, w in enumerate(b.adaln):
            base = k * ADALN_SLICES
            order = [base + s for s in adaln_order(ADALN_SLICES)]
            modulation(reads, w, stem + ".adaln_proj.linear", order, d.dim)

    reads.read(dit.final_norm, at("final_layer.norm.weight"))
    modulation(reads, dit.final_adaln, at("final_layer.adaln_proj.linear"), adaln_order(2), d.dim)
    biased(reads, dit.video_out, at("final_layer.video_out"))
    biased(reads, dit.audio_out, at("final_layer.audio_out"))

    if m.te != None:
        te_read(reads, m.te, "te.model.language_model.")

# The forward of MiniMax H3: the text encoder's `text` reading and the
# `denoise` reading, which refines the caption, then attends it with the
# video, audio and reference rows jointly, each stream modulated by its own
# timestep through its modality's adaLN.

NORM_EPS = 1e-5
T_MAX_PERIOD = 10000.0
ROPE_THETA = 10000.0

# The modality whose adaLN modulates a stream, and its timestep's slot.
MODALITY = {"latents": 0, "reference": 0, "audio": 2, "context": 1}
SLOT = {"latents": 0, "context": 0, "reference": 1, "audio": 2}

def caches(m, c):
    if m.te != None:
        qwen3_caches(m.te, c, m.kv)

def forward(m, inputs):
    switch("reading", (["text"] if m.te != None else []) + ["denoise"])
    switch("stream", ["context", "latents", "audio", "reference"])
    switch("positions", ["computed", "given"])
    reading = lambda name: inputs.on(switch_is("reading", name))
    if m.te != None:
        qwen3_encode(reading("text"), m.te)
    denoise(reading("denoise"), m)

def run_attention(x, a, m, g, positions):
    """Self-attention over `g`'s rows; with `positions`, its q and k turned."""
    hd = m.dims.head_dim
    inner = m.dims.heads * hd

    def norm(x, gain):
        x = ops.elemwise.rmsnorm_per_head(x, gain, hd, NORM_EPS)
        if positions == None:
            return x
        return ops.elemwise.rope_axes(x, positions, m.rope_dims, [ROPE_THETA] * 4, "neox", m.rotary_dim, hd)

    q, k, v = ops.gather.split_qkv(ops.linear.matmul(x, a.qkv), inner, inner)
    q = norm(q, a.q_norm)
    k = norm(k, a.k_norm)
    o = attend(q, k, v, g, g, hd, m.sm_scale, g.mask)
    return ops.linear.matmul(o, a.out)

def run_mlp(x, f, d):
    return ops.linear.matmul(ops.linear.glu(ops.linear.matmul(x, f.fc1), gating.swiglu(), d.inter), f.fc2)

def refine(arm, m):
    d = m.dims
    x = run_linear(m.dit.condition, arm.input("context", dtype.bf16, "row", d.text_dim))
    geom = struct(perm = arm.row_permutation(), csr = arm.lane_indptr(), mask = unmasked())

    def block(l, b, x):
        h = ops.elemwise.rmsnorm(x, b.norm1, NORM_EPS)
        x = ops.elemwise.residual_add(run_attention(h, b.attn, m, geom, None), x)
        h = ops.elemwise.rmsnorm(x, b.norm2, NORM_EPS)
        return ops.elemwise.residual_add(run_mlp(h, b.mlp, d), x)

    return ops.elemwise.rmsnorm(arm.fold_layers(m.dit.refine, x, block), m.dit.refine_norm, NORM_EPS)

def column(v, slot, total):
    tail = v if slot == 0 else ops.gather.split_rows(v, slot)[1]
    if slot + 1 == total:
        return tail
    return ops.gather.split_rows(tail, 1)[0]

PATCH = [PATCH_T, PATCH_H, PATCH_W]

def patched(rows, name, grid, tgrid):
    return ops.conv.patchify(rows.input(name, dtype.bf16, "voxel", LATENT_CHANNELS), grid, PATCH, tgrid)

# The reference's rope positions: one timeline in audio ticks (1/40 s) after
# the text rows `L`, spatial grids aspect-normalised onto [0, 32) about 16.
# text `(j, 0, 0)`; video frame `k` at `L + 17k/3 − 4 + (k + 4) mod 5`;
# audio row `j` at tick `j mod n` of channel `j div n`, in the first or last
# video column; keyframe `f` at `f · (5/3 · Σ_all − 5/3)` past the first frame.
GRID_CENTRE = 16.0
FRAME_TICKS = 17.0 / 3.0

# In-place ops must be the last read of their operand; `fresh` copies first.
fresh = ops.elemwise.copy

def frames_time(k, m):
    """`5/3 · Σ_{f<k} FRAMES[f mod 5]`, the ticks `k` latent frames cover."""
    c = m.rope
    five = ops.elemwise.add_bias(c.five, ops.elemwise.mul_scalar(0.0, fresh(k)))
    tail = ops.elemwise.mod(ops.elemwise.add_bias(c.four, fresh(k)), five)
    return ops.elemwise.add(ops.elemwise.mul_scalar(FRAME_TICKS, fresh(k)), ops.elemwise.add_bias(c.minus_four, tail))

def grid_axis(cell, n, area, m):
    """A cell on an aspect-normalised axis of `n` cells: `16 + 16 · (2·cell −
    n) / √area`."""
    span = ops.elemwise.add(ops.elemwise.mul_scalar(2.0, fresh(cell)), ops.elemwise.mul_scalar(-1.0, fresh(n)))
    return ops.elemwise.add_bias(m.rope.centre, ops.elemwise.mul_scalar(GRID_CENTRE, ops.elemwise.div(span, area)))

def turn_positions(arm, m, streams):
    text, video, audio, reference = streams
    lanes = arm.request_of_token()
    groups = arm.group_of_lane()
    cells, size = ops.gather.split_rows(ops.conv.cells(arm.token_grid(PATCH), arm.positions(), 0), ROPE_AXES)
    k, i, j = [column(cells, a, ROPE_AXES) for a in range(ROPE_AXES)]
    _, nh, nw = [column(size, a, ROPE_AXES) for a in range(ROPE_AXES)]
    _, video_size = ops.gather.split_rows(ops.conv.cells(video.token_grid(PATCH), video.positions(), 0), ROPE_AXES)
    peer = ops.gather.group_first(
        ops.gather.pack_rows(video_size, video.row_permutation()),
        video.group_indptr(),
        groups,
        lanes,
    )
    v_frames, v_nh, v_nw = [column(peer, a, ROPE_AXES) for a in range(ROPE_AXES)]
    text_rows = ops.gather.group_rows(text.group_indptr(), groups, lanes)
    root = lambda a, b: ops.elemwise.sqrt(ops.elemwise.mul(a, b))

    area = root(nh, nw)
    h = grid_axis(i, nh, area, m)
    w = grid_axis(j, nw, area, m)
    video_rows = ops.gather.concat_cols([ops.elemwise.add(text_rows, frames_time(k, m)), h, w])

    last = ops.elemwise.add_bias(m.rope.minus_span, frames_time(v_frames, m))
    reference_rows = ops.gather.concat_cols([ops.elemwise.add(text_rows, ops.elemwise.mul(k, last)), h, w])

    ticks = ops.elemwise.mul_scalar(0.5, ops.gather.group_rows(audio.group_indptr(), groups, lanes))
    tick = ops.elemwise.mod(k, ticks)
    channel = ops.elemwise.div(ops.elemwise.add(k, ops.elemwise.mul_scalar(-1.0, fresh(tick))), ticks)
    edge = ops.elemwise.add(ops.elemwise.mul(channel, v_nw), ops.elemwise.mul_scalar(-1.0, fresh(channel)))
    a_w = grid_axis(edge, v_nw, root(v_nh, v_nw), m)
    zero = ops.elemwise.mul_scalar(0.0, fresh(k))
    audio_rows = ops.gather.concat_cols([ops.elemwise.add(text_rows, tick), zero, a_w])

    # Split as the denoise splits its streams, so the rows merge back whole.
    t, v, a = [switch_is("stream", name) for name in ["context", "latents", "audio"]]
    computed = merge([
        cells.on(t),
        video_rows.on(~t).on(v),
        audio_rows.on(~t).on(~v).on(a),
        reference_rows.on(~t).on(~v).on(~a),
    ])
    given = switch_is("positions", "given")
    return merge([arm.on(given).input("positions", dtype.f32, "row", m.rope_axes), computed.on(~given)])

def denoise(arm, m):
    d = m.dims
    dit = m.dit
    text, rest = arm.on(switch_is("stream", "context")), arm.on(~switch_is("stream", "context"))
    video, rest = rest.on(switch_is("stream", "latents")), rest.on(~switch_is("stream", "latents"))
    audio, reference = rest.on(switch_is("stream", "audio")), rest.on(~switch_is("stream", "audio"))

    lanes = arm.request_of_token()
    positions = turn_positions(arm, m, (text, video, audio, reference))
    joint = struct(perm = arm.row_permutation(), csr = arm.group_indptr(), mask = group_block_diagonal())

    def side(rows, stream):
        t = column(rows.input("timestep", dtype.f32, "lane", m.timestep_slots), SLOT[stream], m.timestep_slots)
        e = ops.elemwise.sinusoid(t, d.t_freq, T_MAX_PERIOD, True, 1.0)
        e = run_linear(dit.t_out, ops.elemwise.silu(run_linear(dit.t_in, e)))
        return struct(stream = stream, stemb = ops.elemwise.silu(e))

    sides = [
        side(text, "context"),
        side(video, "latents"),
        side(audio, "audio"),
        side(reference, "reference"),
    ]

    text_rows = refine(text, m)
    video_grid, video_tgrid = video.grid(), video.token_grid(PATCH)
    video_rows = run_linear(dit.video_patch, patched(video, "latents", video_grid, video_tgrid))
    audio_rows = run_linear(dit.audio_patch, audio.input("audio", dtype.bf16, "row", m.audio_channels))
    reference_rows = run_linear(dit.video_patch, patched(reference, "reference", reference.grid(), reference.token_grid(PATCH)))
    x = merge([text_rows, video_rows, audio_rows, reference_rows])

    def block(l, b, x):
        mods = merge([run_linear(b.adaln[MODALITY[s.stream]], s.stemb) for s in sides])
        attn_ss, attn_gate, mlp_ss, mlp_gate = chunks(mods, [2 * d.dim, d.dim, 2 * d.dim, d.dim])
        h = ops.elemwise.modulate(ops.elemwise.rmsnorm(x, b.norm1, NORM_EPS), attn_ss, lanes, "scale_shift")
        x = ops.elemwise.gated_residual_add(x, attn_gate, run_attention(h, b.attn, m, joint, positions), lanes)
        h = ops.elemwise.modulate(ops.elemwise.rmsnorm(x, b.norm2, NORM_EPS), mlp_ss, lanes, "scale_shift")
        return ops.elemwise.gated_residual_add(x, mlp_gate, run_mlp(h, b.mlp, d), lanes)

    x = arm.fold_layers(dit.blocks, x, block)

    final_mod = merge([run_linear(dit.final_adaln, s.stemb) for s in sides])
    h = ops.elemwise.modulate(ops.elemwise.rmsnorm(x, dit.final_norm, NORM_EPS), final_mod, lanes, "scale_shift")
    rest = h.on(~switch_is("stream", "context"))
    h_video, rest = rest.on(switch_is("stream", "latents")), rest.on(~switch_is("stream", "latents"))
    h_audio = rest.on(switch_is("stream", "audio"))
    audio_velocity = run_linear(dit.audio_out, h_audio)
    output("audio.velocity", audio_velocity)
    # The video head last: the forward ends on the voxel axis.
    video_tokens = run_linear(dit.video_out, h_video)
    velocity = ops.conv.unpatchify(video_tokens, video_tgrid, PATCH, video_grid)
    output("velocity", velocity)
    return velocity
