# GLM-5: a mixture of experts behind multi-head latent attention, its keys
# chosen per query by a lightning indexer; GLM-5.3 (indexers on one layer in
# four, the rest reusing their selection), with or without its draft head,
# and its seven-layer miniature.

load("//pie/codec.poem", "bank", "dequantized", "kept", "land", read_weight = "weight")
load("//lib/adapters.poem", "banks")

STOP = ["<|im_end|>", "<|endoftext|>", "<|user|>", "<|assistant|>"]
CHATML = template("chatml", thinking = True, tools = True, stop = STOP)
TOKENIZER = tokenizer(markers = [STOP])

GLM = template("glm")
GLM_TOKENIZER = tokenizer(markers = [["<|user|>", "<|observation|>", "<|endoftext|>"]])

MODELS = [
    model("glm5-a12b", template = CHATML, tokenizer = TOKENIZER, arch = "glm_moe_dsa", layers = 46, vocab = 151552),
    model("glm53", template = GLM, tokenizer = GLM_TOKENIZER, drafters = ["mtp"], arch = "glm_moe_dsa", layers = 78, vocab = 154880),
    model("glm53-mini", mini = True, template = GLM, tokenizer = GLM_TOKENIZER, arch = "glm_moe_dsa", layers = 7, vocab = 154880),
]

BF = dtype.bf16
U4 = dtype.u4g64
F8 = dtype.e4m3tile128a8
NV4 = dtype.nvfp4a4
NV4W = dtype.nvfp4

DEPLOYMENTS = [
    deployment("glm5-a12b", weights = BF, kv = BF),
    deployment("glm53", weights = [BF, U4], kv = BF),
    deployment("glm53", weights = [BF, U4, U4], kv = BF, drafter = "mtp"),
    deployment("glm53", weights = F8, kv = BF),
    deployment("glm53-mini", weights = BF, kv = BF),
    deployment("glm53-mini", weights = [BF, U4], kv = BF),
    # The release's own FP8 experts (128x128 blocks under f32 factors), as
    # vLLM serves them: the like-for-like row.
    deployment("glm53-mini", weights = [BF, F8], kv = BF),
    # Every FP8 tensor of the release as released: the projections too.
    deployment("glm53-mini", weights = [F8, F8], kv = BF),
    deployment("glm53-mini", weights = F8, kv = BF),
    # modelopt's NVFP4 export as vLLM serves it: routed experts NVFP4 against
    # NVFP4 or bf16 activations, attention and shared experts bf16, the dense
    # MLP widened from its per-tensor FP8.
    deployment("glm53", weights = [BF, NV4], kv = BF),
    deployment("glm53-mini", weights = [BF, NV4], kv = BF),
    # ... with the dense layers' MLP kept the export's FP8 (its one scale a
    # projection as every 128-square block's factor), as vLLM serves it.
    deployment("glm53", weights = [BF, NV4, F8], kv = BF),
    deployment("glm53-mini", weights = [BF, NV4, F8], kv = BF),
    # The export's NVFP4 experts against bf16 activations, where no GEMM
    # quantizes them (Hopper), as vLLM's Marlin serves them there.
    deployment("glm53", weights = [BF, NV4W], kv = BF),
    deployment("glm53-mini", weights = [BF, NV4W], kv = BF),
    # ... with the dense MLP the export's FP8, on mma.sync (Hopper).
    deployment("glm53", weights = [BF, NV4W, F8], kv = BF),
    deployment("glm53-mini", weights = [BF, NV4W, F8], kv = BF),
    # The latent rows as vLLM's standard fp8 rows (B200's sparse pass reads
    # them, at any rank's share of the heads), as nvidia's export states.
    deployment("glm53", weights = [BF, NV4, F8], kv = dtype.e4m3),
    deployment("glm53-mini", weights = [BF, NV4, F8], kv = dtype.e4m3),
    deployment("glm53", weights = F8, kv = dtype.e4m3),
]

# The weights of GLM-5: three dense layers, then routed experts with a shared
# one; each layer's attention latent (MLA) with an indexer of its own, or,
# on GLM-5.3, the selection of the last layer that ranked; and GLM-5.3's
# optional MTP draft head.

def attention(n, d, hidden, weights, norms, eps, kv, theta = None, interleaved = False, gated = False, latent = None, **extra):
    """The latent attention named by `n`, its projections in `weights` and
    its norms in `norms`, caching under `kv`. Its rope part is rotated at
    `theta` (its pairs adjacent under `interleaved`), or left as it is with
    none; `gated` adds a sigmoid gate on its output. `latent` is the dtype
    of `kv_b_proj`, which the absorbs read as it is (`weights` by default).
    `extra` rides along (an indexer, say)."""
    qk_head_dim = d.qk_nope_head_dim + d.qk_rope_head_dim
    v_width = d.heads * d.v_head_dim
    return struct(
        heads = d.heads,
        kv_lora_rank = d.kv_lora_rank,
        qk_nope_head_dim = d.qk_nope_head_dim,
        qk_rope_head_dim = d.qk_rope_head_dim,
        v_head_dim = d.v_head_dim,
        theta = theta,
        interleaved = interleaved,
        sm_scale = f32(1.0 / f32(sqrt(qk_head_dim))),
        q_a_proj = weight([d.q_lora_rank, hidden], weights),
        q_a_norm = weight([d.q_lora_rank]),
        q_a_norm_eps = eps,
        q_b_proj = weight([d.heads * qk_head_dim, d.q_lora_rank], weights),
        kv_a_proj = weight([d.kv_lora_rank + d.qk_rope_head_dim, hidden], weights),
        kv_a_norm = weight([d.kv_lora_rank]),
        kv_a_norm_eps = eps,
        kv_b_proj = weight([d.heads * (d.qk_nope_head_dim + d.v_head_dim), d.kv_lora_rank],
            latent if latent != None else weights,
        ),
        gate = weight([v_width, hidden], weights) if gated else None,
        o_proj = weight([hidden, v_width], weights),
        kv = kv,
        **extra
    )

def glm5():
    return struct(
        hidden = 4096,
        layers = 46,
        dense_layers = 3,
        heads = 96,
        q_lora_rank = 1536,
        kv_lora_rank = 512,
        qk_nope_head_dim = 128,
        qk_rope_head_dim = 64,
        v_head_dim = 128,
        theta = 10000.0,
        interleaved = False,
        index_heads = 64,
        index_head_dim = 128,
        index_top_k = 2048,
        # Every layer ranks; its head weights read the query latent.
        index_freq = 1,
        index_offset = 0,
        index_weights_from = "q_a",
        index_norm_eps = 1e-5,
        dense_inter = 10944,
        experts = 128,
        top_k = 8,
        moe_inter = 1408,
        shared_inter = 1408,
        router_bias = False,
        norm_weights = True,
        scaling = 2.5,
        vocab = 151552,
        norm_eps = 1e-5,
    )

def glm53(layers = 78, experts = 256):
    return struct(
        hidden = 6144,
        layers = layers,
        dense_layers = 3,
        heads = 64,
        q_lora_rank = 2048,
        kv_lora_rank = 512,
        qk_nope_head_dim = 192,
        qk_rope_head_dim = 64,
        v_head_dim = 256,
        theta = 8000000.0,
        interleaved = True,
        index_heads = 32,
        index_head_dim = 128,
        index_top_k = 2048,
        # Layers 0, 1, 2 rank, then every fourth from 6; the layers between
        # read the selection of the last that ranked.
        index_freq = 4,
        index_offset = 3,
        index_weights_from = "hidden",
        index_norm_eps = 1e-6,
        dense_inter = 12288,
        experts = experts,
        top_k = min(8, experts),
        moe_inter = 2048,
        shared_inter = 2048,
        router_bias = True,
        norm_weights = True,
        scaling = 2.5,
        vocab = 154880,
        norm_eps = 1e-5,
    )

DIMS = {
    "glm5-a12b": glm5(),
    "glm53": glm53(),
    # The first seven layers at full width with the first eight routed
    # experts: three dense layers that rank, three that share, one that ranks.
    "glm53-mini": glm53(layers = 7, experts = 8),
}

def ranks(d, l):
    """Whether layer `l` runs an indexer of its own."""
    return max(l - d.index_offset + 1, 0) % d.index_freq == 0

def layout(id, deploy):
    d = DIMS[id]
    if deploy.layers or deploy.experts:
        d = glm53(layers = deploy.layers or d.layers, experts = deploy.experts or d.experts)
    mtp = deploy.drafter == "mtp"
    ws = deploy.weights
    if mtp and len(ws) == 3:
        w, experts, draft = ws
    elif not mtp and len(ws) == 2:
        w, experts = ws
        draft = None
    elif not mtp and len(ws) == 1:
        w, experts, draft = ws[0], ws[0], None
    elif not mtp and len(ws) == 3:
        # The dense layers' MLP at a dtype of its own (modelopt's FP8 one).
        w, experts, dense_mlp = ws
        draft = None
    else:
        fail("{} stores its weights at one dtype, or its weights and experts at a dtype each (and its dense layers' MLP at a third), and its draft experts at a third with the draft head; not {}".format(id, ws))
    if not (not mtp and len(ws) == 3):
        dense_mlp = None
    # The release's FP8 as released: projections at 128x128-block FP8 against
    # e4m3 activations; norms, tables, router, indexer and the latent's
    # up-projection (the absorbs read it as bf16) at bf16, as vLLM reads them.
    proj = w
    if w == dtype.e4m3tile128a8:
        w = dtype.bf16
    dense = compute(w)
    hidden = d.hidden
    index_width = d.index_heads * d.index_head_dim
    index_in = d.q_lora_rank if d.index_weights_from == "q_a" else hidden

    def indexer(n, keys):
        return struct(
            heads = d.index_heads,
            head_dim = d.index_head_dim,
            top_k = d.index_top_k,
            rope_dim = d.qk_rope_head_dim,
            theta = d.theta,
            weights_from = d.index_weights_from,
            q_proj = weight([index_width, d.q_lora_rank], proj),
            k_proj = weight([d.index_head_dim, hidden], proj),
            weights_proj = weight([d.index_heads, index_in], w),
            k_norm = weight([d.index_head_dim], w),
            k_norm_eps = d.index_norm_eps,
            k_norm_bias = weight([d.index_head_dim], w),
            keys = keys,
        )

    def mla_at(prefix, kv, keys):
        n = lambda s: "{}.{}".format(prefix, s)
        return attention(
            n,
            d,
            hidden,
            weights = proj,
            norms = w,
            latent = w,
            eps = d.norm_eps,
            kv = kv,
            theta = d.theta,
            interleaved = d.interleaved,
            indexer = indexer(n, keys) if keys != None else None,
        )

    def routed_at(banks_dtype):
        iw = d.moe_inter
        sw = d.shared_inter
        return struct(
            routed = True,
            router = weight([d.experts, hidden], w),
            bias = weight([d.experts], dtype.f32) if d.router_bias else None,
            gate = weight([d.experts, iw, hidden], banks_dtype),
            up = weight([d.experts, iw, hidden], banks_dtype),
            down = weight([d.experts, hidden, iw], banks_dtype),
            shared = struct(
                gate = weight([sw, hidden], proj),
                up = weight([sw, hidden], proj),
                down = weight([hidden, sw], proj),
                inter = sw,
            ),
            experts = d.experts,
            top_k = d.top_k,
            inter = iw,
            norm_weights = d.norm_weights,
            scaling = d.scaling,
        )

    def layer(l):
        norm = lambda s, width: weight([width], w)
        lora_a, lora_b = banks(hidden)
        keys = "index.{}".format(l) if ranks(d, l) else None
        attn = mla_at("layer.{}".format(l), "kv.{}".format(l), keys)
        if l < d.dense_layers:
            iw = d.dense_inter
            mlp = struct(
                routed = False,
                gate = weight([iw, hidden], dense_mlp or proj),
                up = weight([iw, hidden], dense_mlp or proj),
                down = weight([hidden, iw], dense_mlp or proj),
                inter = iw,
            )
        else:
            mlp = routed_at(experts)
        return struct(
            attn = attn,
            attn_norm = norm("attn_norm", hidden),
            attn_norm_eps = d.norm_eps,
            mlp_norm = norm("mlp_norm", hidden),
            mlp_norm_eps = d.norm_eps,
            mlp = mlp,
            lora_a = lora_a,
            lora_b = lora_b,
        )

    head = None
    if draft != None:
        head = struct(
            enorm = weight([hidden], w),
            hnorm = weight([hidden], w),
            e_proj = weight([hidden, hidden], w),
            h_proj = weight([hidden, hidden], w),
            attn_norm = weight([hidden], w),
            attn = mla_at("mtp", "kv.mtp", "index.mtp"),
            mlp_norm = weight([hidden], w),
            mlp = routed_at(draft),
            norm = weight([hidden], w),
            norm_eps = d.norm_eps,
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        heads = d.heads,
        kv_lora_rank = d.kv_lora_rank,
        kv = deploy.kv,
        embed = weight([d.vocab, hidden], w),
        head = weight([d.vocab, hidden], w),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight([hidden], w),
        final_norm_eps = d.norm_eps,
        mtp = head,
    )

# How a GLM-5 checkpoint is laid out: transformers' names, each expert's
# projections a tensor of their own; GLM-5.3's draft head the layer after
# the last. GLM-5.3 stores its projections FP8 in 128-square blocks beside
# `*_scale_inv`; modelopt's export keeps attention and shared experts bf16,
# the dense MLP per-tensor e4m3, and the routed experts NVFP4.

BF16 = raw(dtype.bf16)

def named(a, at):
    """`a`'s weights, each beside the name `at` gives its transformers leaf,
    in the order a checkpoint lists them."""
    out = [
        (a.q_a_proj, at("self_attn.q_a_proj.weight")),
        (a.q_a_norm, at("self_attn.q_a_layernorm.weight")),
        (a.q_b_proj, at("self_attn.q_b_proj.weight")),
        (a.kv_a_proj, at("self_attn.kv_a_proj_with_mqa.weight")),
        (a.kv_a_norm, at("self_attn.kv_a_layernorm.weight")),
        (a.kv_b_proj, at("self_attn.kv_b_proj.weight")),
    ]
    if a.gate != None:
        out.append((a.gate, at("self_attn.g_proj.weight")))
    out.append((a.o_proj, at("self_attn.o_proj.weight")))
    ix = a.indexer
    if ix != None:
        out.extend([
            (ix.q_proj, at("self_attn.indexer.wq_b.weight")),
            (ix.k_proj, at("self_attn.indexer.wk.weight")),
            (ix.weights_proj, at("self_attn.indexer.weights_proj.weight")),
            (ix.k_norm, at("self_attn.indexer.k_norm.weight")),
            (ix.k_norm_bias, at("self_attn.indexer.k_norm.bias")),
        ])
    return out

def formats(m):
    return [format("huggingface", read = lambda reads: huggingface(m, reads))]

def huggingface(m, reads):
    reads.read(m.embed, "model.embed_tokens.weight")
    reads.read(m.final_norm, "model.norm.weight")
    reads.read(m.head, "lm_head.weight")
    for l, layer in enumerate(m.layers):
        at = lambda tail: "model.layers.{}.{}".format(l, tail)
        reads.read(layer.attn_norm, at("input_layernorm.weight"))
        reads.read(layer.mlp_norm, at("post_attention_layernorm.weight"))
        for w, name in named(layer.attn, at):
            read_weight(reads, w, name, quantized = "widen")
        f = layer.mlp
        if f.routed:
            moe(reads, at, f)
        else:
            read_weight(reads, f.gate, at("mlp.gate_proj.weight"), quantized = "widen")
            read_weight(reads, f.up, at("mlp.up_proj.weight"), quantized = "widen")
            read_weight(reads, f.down, at("mlp.down_proj.weight"), quantized = "widen")

    mtp = m.mtp
    if mtp == None:
        return
    at = lambda tail: "model.layers.{}.{}".format(len(m.layers), tail)
    reads.read(mtp.enorm, at("enorm.weight"))
    reads.read(mtp.hnorm, at("hnorm.weight"))
    eh = dequantized(reads, at("eh_proj.weight"))
    land(reads, mtp.e_proj, eh.slice(1, 0, m.hidden))
    land(reads, mtp.h_proj, eh.slice(1, m.hidden, m.hidden))
    reads.read(mtp.attn_norm, at("input_layernorm.weight"))
    reads.read(mtp.mlp_norm, at("post_attention_layernorm.weight"))
    for w, name in named(mtp.attn, at):
        reads.read(w, name)
    moe(reads, at, mtp.mlp)
    reads.read(mtp.norm, at("shared_head.norm.weight"))

def moe(reads, at, f):
    reads.read(f.router, at("mlp.gate.weight"))
    if f.bias != None:
        reads.read(f.bias, at("mlp.gate.e_score_correction_bias"))
    for w, leaf in [(f.gate, "gate_proj"), (f.up, "up_proj"), (f.down, "down_proj")]:
        names = [at("mlp.experts.{}.{}.weight".format(e, leaf)) for e in range(f.experts)]
        if kept(w):
            bank(reads, w, [[name] for name in names])
        else:
            land(reads, w, concat(0, [dequantized(reads, name).transmute([1] + w.shape[1:], BF16) for name in names]))
    read_weight(reads, f.shared.gate, at("mlp.shared_experts.gate_proj.weight"), quantized = "widen")
    read_weight(reads, f.shared.up, at("mlp.shared_experts.up_proj.weight"), quantized = "widen")
    read_weight(reads, f.shared.down, at("mlp.shared_experts.down_proj.weight"), quantized = "widen")

# The forward of GLM-5: latent attention over the keys the indexer picks
# (or, on a layer with none, the keys the last indexer picked), then a dense
# or routed SwiGLU MLP; and the MTP head drafting from the trunk's last
# hidden rows.

# An e4m3 kv deployment keeps the latent rows as vLLM's standard fp8 rows: the
# 512 latent and 64 rotated dims e4m3 under one scale of 1, 576 bytes a
# position in a u8 plane. The index keys stay at bf16.
FP8_ROW = 576

def fp8_rows(m):
    return m.kv == dtype.e4m3

def cache(c, space, a, fp8 = False):
    """`a`'s latent rows in the kv `space`."""
    if fp8:
        if a.kv_lora_rank != 512 or a.qk_rope_head_dim != 64:
            fail("fp8 latent rows hold 512 latent and 64 rotated dims, and this attention's are {} and {}".format(a.kv_lora_rank, a.qk_rope_head_dim))
        c.kv(space, a.kv, [FP8_ROW], a.qk_rope_head_dim, rows = "fp8")
        return
    c.kv(space, a.kv, [a.kv_lora_rank, a.qk_rope_head_dim], a.qk_rope_head_dim)

def run_attention(x, inputs, a, positions = None, select = None, prefill_only = False):
    """Latent attention of the rows `x`, and the selection it read through.
    `select(q_a)`, if given, picks the keys each query reads; `positions`
    default to the rows' own."""
    pages = inputs.kv(a.kv)
    if positions == None:
        positions = inputs.positions()
    write_page = inputs.write_page(a.kv)
    write_offset = inputs.write_offset(a.kv)

    q_a = ops.linear.matmul(x, a.q_a_proj)
    q_a = ops.elemwise.rmsnorm(q_a, a.q_a_norm, a.q_a_norm_eps)
    q_b = ops.linear.matmul(q_a, a.q_b_proj)
    kv_a = ops.linear.matmul(x, a.kv_a_proj)

    selection = select(q_a) if select != None else None

    if a.theta != None and a.interleaved:
        kv_c, k_pe = ops.attn.mla_latents(kv_a, a.kv_a_norm, a.kv_a_norm_eps, a.kv_lora_rank)
        k_pe = ops.elemwise.rope(
            k_pe,
            positions,
            a.qk_rope_head_dim,
            a.theta,
            rotary.last(a.qk_rope_head_dim, interleaved = True),
        )
    elif a.theta != None:
        kv_c, k_pe = ops.attn.mla_latents_rope(
            kv_a,
            positions,
            a.kv_a_norm,
            a.kv_a_norm_eps,
            a.kv_lora_rank,
            a.qk_rope_head_dim,
            a.theta,
        )
    else:
        kv_c, k_pe = ops.attn.mla_latents(kv_a, a.kv_a_norm, a.kv_a_norm_eps, a.kv_lora_rank)
    ops.attn.mla_kv_append(kv_c, k_pe, pages, write_page, write_offset)

    q_nope, q_pe = ops.attn.mla_split_q_b(q_b, a.heads, a.qk_nope_head_dim, a.qk_rope_head_dim)
    if a.theta != None and a.interleaved:
        q_pe = ops.elemwise.rope(
            q_pe,
            positions,
            a.qk_rope_head_dim,
            a.theta,
            rotary.last(a.qk_rope_head_dim, interleaved = True),
        )
    elif a.theta != None:
        q_pe = ops.elemwise.rope(
            q_pe,
            positions,
            a.qk_rope_head_dim,
            a.theta,
            rotary.partial(a.qk_rope_head_dim),
        )
    return attend(x, inputs, q_nope, q_pe, a, selection, prefill_only), selection

def attend(x, inputs, q_nope, q_pe, a, selection = None, prefill_only = False):
    """The split queries `q_nope`/`q_pe` of the rows `x` scored against the
    latent kv (or the `selection` of it), through `a`'s output projection;
    with `prefill_only` every lane through the prefill arm, as the draft
    head's rows are."""
    q = ops.attn.mla_absorb_q(q_nope, a.kv_b_proj, a.heads, a.kv_lora_rank, a.qk_nope_head_dim, a.v_head_dim)
    scored = ops.attn.attend_mla(q, q_pe, inputs, a.kv, a.heads, a.kv_lora_rank, a.sm_scale,
                                 selection = selection, prefill_only = prefill_only)

    o = ops.attn.mla_absorb_out(scored, a.kv_b_proj, a.heads, a.kv_lora_rank, a.qk_nope_head_dim, a.v_head_dim)
    if a.gate != None:
        o = ops.elemwise.gate_sigmoid_mul(o, ops.linear.matmul(x, a.gate))
    return ops.linear.matmul(o, a.o_proj)

def caches(m, c):
    fp8 = fp8_rows(m)
    kv = c.kv_space(dtype.u8 if fp8 else m.kv)
    index = c.kv_space(dtype.bf16 if fp8 else m.kv)
    attns = [w.attn for w in m.layers]
    if m.mtp != None:
        attns.append(m.mtp.attn)
    for a in attns:
        cache(c, kv, a, fp8)
        if a.indexer != None:
            c.kv(index, a.indexer.keys, [a.indexer.head_dim], a.indexer.head_dim)

def forward(m, inputs):
    positions = inputs.positions()
    y = ops.gather.embed(inputs.tokens(), m.embed, m.vocab)
    routes = inputs.adapter_routes()

    def block(l, w, carried):
        y, selection = carried
        x = ops.elemwise.rmsnorm(y, w.attn_norm, w.attn_norm_eps)
        a = w.attn
        if a.indexer != None:
            keys = index_keys(x, inputs, positions, a.indexer)
            select = lambda q_a: index_select(x, q_a, keys, positions, a.indexer)
        elif selection == None:
            fail("layer {} reads the selection of an indexer no layer before it runs".format(l))
        else:
            ranked = selection
            select = lambda q_a: ranked
        o, selection = run_attention(x, inputs, a, positions = positions, select = select)
        adapted = fact.has(fact.Adapter)
        o = ops.linear.lora_correct(x.on(adapted), w.lora_a, w.lora_b, routes, o.on(adapted))
        y = ops.elemwise.residual_add(o, y)

        x = ops.elemwise.rmsnorm(y, w.mlp_norm, w.mlp_norm_eps)
        return ops.elemwise.residual_add(mlp(x, w.mlp), y), selection

    y, _ = inputs.fold_layers(m.layers, (y, None), block)
    y = ops.gather.gather_rows(y, inputs.readout_rows())
    x = ops.elemwise.rmsnorm(y, m.final_norm, m.final_norm_eps)
    logits = ops.linear.lm_head(x, m.head)
    if m.mtp != None:
        draft(m, inputs, y, positions, logits)
    output("logits", logits)

def draft(m, inputs, y, positions, logits):
    """The MTP head's drafted token, from the trunk's last hidden rows `y`
    and the token its logits pick."""
    mtp = m.mtp
    drafted = inputs.on(fact.drafts())
    hidden = y.on(fact.drafts())
    positions = positions.on(fact.drafts())
    token = ops.sampling.argmax([logits.on(fact.drafts())])

    e = ops.gather.embed(token, m.embed, m.vocab)
    e = ops.elemwise.rmsnorm(e, mtp.enorm, mtp.norm_eps)
    h = ops.elemwise.rmsnorm(hidden, mtp.hnorm, mtp.norm_eps)
    fused = ops.elemwise.residual_add(
        ops.linear.matmul(e, mtp.e_proj),
        ops.linear.matmul(h, mtp.h_proj),
    )
    x = ops.elemwise.rmsnorm(fused, mtp.attn_norm, mtp.norm_eps)
    keys = index_keys(x, drafted, positions, mtp.attn.indexer)
    select = lambda q_a: index_select(x, q_a, keys, positions, mtp.attn.indexer)
    o, _ = run_attention(x, drafted, mtp.attn, positions = positions, select = select, prefill_only = True)
    r = ops.elemwise.residual_add(o, fused)
    x = ops.elemwise.rmsnorm(r, mtp.mlp_norm, mtp.norm_eps)
    r = ops.elemwise.residual_add(mlp(x, mtp.mlp), r)
    proposal = ops.linear.lm_head(ops.elemwise.rmsnorm(r, mtp.norm, mtp.norm_eps), m.head)
    output("mtp.logits", proposal)
    output("mtp.drafts", ops.sampling.argmax([proposal]))

def mlp(x, f):
    if not f.routed:
        gate, up = ops.linear.matmul(x, f.gate), ops.linear.matmul(x, f.up)
        return ops.linear.matmul(ops.linear.glu(gate, gating.swiglu(), up = up), f.down)
    logits = ops.linear.matmul(x, f.router)
    if f.bias != None:
        routes, weights = ops.linear.moe_route(
            logits,
            f.experts,
            f.top_k,
            routing.sigmoid(renormalize = f.norm_weights, scaling = f.scaling),
            bias = f.bias,
        )
    else:
        routes, weights = ops.linear.moe_route(
            logits,
            f.experts,
            f.top_k,
            routing.sigmoid(renormalize = f.norm_weights, scaling = f.scaling),
        )

    gate, up = ops.linear.matmul(x, f.shared.gate), ops.linear.matmul(x, f.shared.up)
    act = ops.linear.glu(gate, gating.swiglu(), up = up)
    shared = ops.linear.matmul(act, f.shared.down)
    gate = ops.linear.moe_matmul_select(x, f.gate, routes, f.top_k)
    act = ops.linear.glu(gate, gating.swiglu(), up = ops.linear.moe_matmul_select(x, f.up, routes, f.top_k))
    routed = ops.linear.moe_weighted_sum(ops.linear.moe_matmul_select(act, f.down, routes, f.top_k), weights)
    return ops.elemwise.residual_add(shared, routed)

def index_keys(x, inputs, positions, ix):
    """The indexer's keys of the rows `x` landed in its cache, ahead of the
    query path so they run beside it."""
    keys = inputs.kv(ix.keys)
    write_page = inputs.write_page(ix.keys)
    write_offset = inputs.write_offset(ix.keys)
    k = ops.attn.index_layernorm_rope(
        ops.linear.matmul(x, ix.k_proj),
        positions,
        ix.k_norm,
        ix.k_norm_eps,
        ix.k_norm_bias,
        ix.rope_dim,
        ix.theta,
    )
    ops.attn.index_kv_append(k, keys, write_page, write_offset)
    return keys

def index_select(x, q_a, keys, positions, ix):
    q = ops.attn.index_rope(
        ops.linear.matmul(q_a, ix.q_proj),
        positions,
        ix.heads,
        ix.head_dim,
        ix.rope_dim,
        ix.theta,
    )
    weights = ops.linear.matmul(q_a if ix.weights_from == "q_a" else x, ix.weights_proj)
    return ops.attn.index_topk(q, weights, keys, ix.heads, ix.head_dim, ix.top_k, 1)
