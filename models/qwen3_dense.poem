# Qwen 3, dense and text-only (Qwen/Qwen3-0.6B ... -32B): full attention in
# every layer, its q and k RMS-normed per head and rotated in full, and a
# SwiGLU MLP; as released, as Qwen releases it in FP8 (128-square blocks
# against e4m3 activations) and as modelopt exports it in NVFP4 (against bf16
# activations). Qwen 3.5 and later, with gated-delta layers, are `qwen_3`;
# Qwen 3's mixtures of experts are `qwen3_moe`.
# A u4g64 row also reads an AWQ or GPTQ int4 export (Qwen/Qwen3-8B-AWQ), its
# codes moved as they are.

load("//pie/codec.poem", "mapped")
load("//lib/adapters.poem", "banks", "corrected")
load("//lib/blocks.poem", "attention", "swiglu")
load("//lib/rope.poem", "yarn")
load("//lib/spoken.poem", "QWEN_STOP")

CHATML = template("chatml", thinking = True, tools = True, stop = QWEN_STOP)
TOKENIZER = tokenizer(markers = [QWEN_STOP])

def qwen3(id, layers, **kwargs):
    return model(id, template = CHATML, tokenizer = TOKENIZER, arch = "qwen3", layers = layers, vocab = 151936, **kwargs)

MODELS = [
    qwen3("qwen3-0.6b", layers = 28),
    qwen3("qwen3-8b", layers = 36, drafters = ["mtp"]),
    qwen3("qwen3-14b", layers = 40),
    qwen3("qwen3-32b", layers = 64),
]

F8 = dtype.e4m3tile128a8

DEPLOYMENTS = [
    deployment("qwen3-0.6b", weights = dtype.bf16, kv = dtype.bf16),
    deployment("qwen3-8b", weights = dtype.bf16, kv = dtype.bf16, drafter = "mtp"),
    deployment("qwen3-8b", weights = dtype.bf16, kv = dtype.bf16),
    deployment("qwen3-8b", weights = dtype.u4g64, kv = dtype.bf16),
    deployment("qwen3-14b", weights = dtype.bf16, kv = dtype.bf16),
    # Keys and values e4m3 under a unit scale (vLLM's `fp8` KV).
    deployment("qwen3-0.6b", weights = dtype.bf16, kv = dtype.e4m3),
    deployment("qwen3-14b", weights = dtype.bf16, kv = dtype.e4m3),
    # compressed-tensors per-channel FP8 (RedHatAI/Qwen3-*-FP8-dynamic): a
    # factor a row against e4m3 activations in 1x128 blocks (finer than the
    # release's per-token), keys and values e4m3 as vLLM serves it on B200.
    deployment("qwen3-0.6b", weights = dtype.e4m3g128a8, kv = dtype.e4m3),
    deployment("qwen3-0.6b", weights = dtype.e4m3g128a8, kv = dtype.bf16),
    deployment("qwen3-14b", weights = dtype.e4m3g128a8, kv = dtype.e4m3),
    deployment("qwen3-14b", weights = dtype.e4m3g128a8, kv = dtype.bf16),
    deployment("qwen3-8b", weights = F8, kv = dtype.bf16),
    deployment("qwen3-8b", weights = F8, kv = dtype.e4m3),
    deployment("qwen3-8b", weights = dtype.nvfp4, kv = dtype.e4m3),
    deployment("qwen3-14b", weights = F8, kv = dtype.e4m3),
    deployment("qwen3-32b", weights = dtype.bf16, kv = dtype.bf16),
    deployment("qwen3-32b", weights = F8, kv = dtype.e4m3),
    deployment("qwen3-32b", weights = dtype.nvfp4, kv = dtype.e4m3),
    deployment("qwen3-32b", weights = dtype.u4g64, kv = dtype.bf16),
    deployment("qwen3-8b", weights = dtype.e4m3g128a8, kv = dtype.e4m3),
    deployment("qwen3-32b", weights = dtype.e4m3g128a8, kv = dtype.e4m3),
    deployment("qwen3-14b", weights = dtype.u4g64, kv = dtype.bf16),
]

# The weights of Qwen 3 (dense): per layer an RMS norm, q, k, v and o
# projections with per-head q and k norms, an RMS norm and a SwiGLU MLP; the
# token embedding, which the 0.6B also reads out through (tied), a final norm.
# Each layer also has the LoRA banks the host registers. A deployment's dtype
# is its projections'; the embedding and head stay at its compute dtype, as
# an AWQ or GPTQ export keeps them.

def dims(hidden, layers, q_heads, kv_heads, inter, tied):
    return struct(
        hidden = hidden,
        layers = layers,
        q_heads = q_heads,
        kv_heads = kv_heads,
        inter = inter,
        tied = tied,
        head_dim = 128,
        vocab = 151936,
        theta = 1000000.0,
        norm_eps = 1e-6,
    )

DIMS = {
    "qwen3-0.6b": dims(hidden = 1024, layers = 28, q_heads = 16, kv_heads = 8, inter = 3072, tied = True),
    "qwen3-8b": dims(hidden = 4096, layers = 36, q_heads = 32, kv_heads = 8, inter = 12288, tied = False),
    "qwen3-14b": dims(hidden = 5120, layers = 40, q_heads = 40, kv_heads = 8, inter = 17408, tied = False),
    "qwen3-32b": dims(hidden = 5120, layers = 64, q_heads = 64, kv_heads = 8, inter = 25600, tied = False),
}

# A release whose projections a deployment keeps as released (Qwen's block
# FP8, compressed-tensors' per-channel FP8 as RedHatAI's *-FP8-dynamic store
# it, modelopt's NVFP4), its tables and norms bf16.
RELEASED = [dtype.e4m3tile128a8, dtype.e4m3g128, dtype.e4m3g128a8, dtype.nvfp4]

def layout(id, deploy):
    if deploy.parts or (deploy.drafter != None and (id != "qwen3-8b" or deploy.drafter != "mtp")):
        fail("{} ships no drafter and no parts".format(id))
    proj = roles(deploy, "proj", exact = True).proj
    w = dtype.bf16 if proj in RELEASED else proj
    d = DIMS[id]
    dense = compute(w)
    hidden, hd = d.hidden, d.head_dim

    def layer(l):
        lora_a, lora_b = banks(hidden)
        return struct(
            attn_norm = weight([hidden]),
            q = weight([d.q_heads * hd, hidden], proj),
            k = weight([d.kv_heads * hd, hidden], proj),
            v = weight([d.kv_heads * hd, hidden], proj),
            o = weight([hidden, d.q_heads * hd], proj),
            q_norm = weight([hd]),
            k_norm = weight([hd]),
            mlp_norm = weight([hidden]),
            gate = weight([d.inter, hidden], proj),
            up = weight([d.inter, hidden], proj),
            down = weight([hidden, d.inter], proj),
            kv = "kv.{}".format(l),
            lora_a = lora_a,
            lora_b = lora_b,
        )

    mtp = None
    if deploy.drafter == "mtp":
        mtp = struct(
            depth = 4,
            taps = [1, 17, 32],
            embed = weight([d.vocab, hidden]),
            fc = [weight([hidden, hidden], w) for _ in range(3)],
            input_norm = weight([hidden]),
            hidden_norm = weight([hidden]),
            q_embed = weight([d.q_heads * hd, hidden], w),
            q_hidden = weight([d.q_heads * hd, hidden], w),
            k_embed = weight([d.kv_heads * hd, hidden], w),
            k_hidden = weight([d.kv_heads * hd, hidden], w),
            v_embed = weight([d.kv_heads * hd, hidden], w),
            v_hidden = weight([d.kv_heads * hd, hidden], w),
            o = weight([hidden, d.q_heads * hd], w),
            mlp_norm = weight([hidden]),
            gate = weight([d.inter, hidden], w),
            up = weight([d.inter, hidden], w),
            down = weight([hidden, d.inter], w),
            norm = weight([hidden]),
            head = weight([d.vocab, hidden]),
            kv = "kv.mtp",
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        q_heads = d.q_heads,
        kv_heads = d.kv_heads,
        head_dim = hd,
        inter = d.inter,
        theta = d.theta,
        eps = d.norm_eps,
        # Qwen3's native context, which YaRN stretches (its card: factor 4
        # over 32768 tokens).
        rope = yarn(deploy, 32768),
        sm_scale = f32(1.0 / f32(sqrt(hd))),
        kv = deploy.kv,
        embed = weight([d.vocab, hidden]),
        head = None if d.tied else weight([d.vocab, hidden]),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight([hidden]),
        mtp = mtp,
    )

# How a Qwen 3 (dense) checkpoint is read: transformers' safetensors, under
# `model.`, as released (bf16), as Qwen releases it in FP8 (e4m3 codes beside
# 128-square block factors), as compressed-tensors stores it in FP8 (a scale
# a row: RedHatAI's *-FP8-dynamic) or as modelopt exports it in NVFP4;
# recognized by its per-head q norm and checked against its config.

def configured(m):
    return [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("head_dim", m.head_dim),
        config("num_hidden_layers", len(m.layers)),
        config("intermediate_size", m.inter),
        config("rms_norm_eps", m.eps),
        config("rope_theta", m.theta),
    ]

def read_checkpoint(reads, m):
    mapped(reads, m, TRANSFORMERS)
    if m.mtp != None:
        mtp = m.mtp
        reads.read(mtp.embed, "mtp.embed.weight")
        for i in range(3):
            reads.read(mtp.fc[i], "mtp.fc.{}.weight".format(i))
        reads.read(mtp.input_norm, "mtp.input_norm.weight")
        reads.read(mtp.hidden_norm, "mtp.hidden_norm.weight")
        reads.read(mtp.q_embed, "mtp.q_embed.weight")
        reads.read(mtp.q_hidden, "mtp.q_hidden.weight")
        reads.read(mtp.k_embed, "mtp.k_embed.weight")
        reads.read(mtp.k_hidden, "mtp.k_hidden.weight")
        reads.read(mtp.v_embed, "mtp.v_embed.weight")
        reads.read(mtp.v_hidden, "mtp.v_hidden.weight")
        reads.read(mtp.o, "mtp.o.weight")
        reads.read(mtp.mlp_norm, "mtp.mlp_norm.weight")
        reads.read(mtp.gate, "mtp.gate.weight")
        reads.read(mtp.up, "mtp.up.weight")
        reads.read(mtp.down, "mtp.down.weight")
        reads.read(mtp.norm, "mtp.norm.weight")
        reads.read(mtp.head, "mtp.head.weight")

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("model.embed_tokens.weight") and has("model.layers.0.self_attn.q_norm.weight") and not has("model.layers.0.mlp.experts.0.down_proj.weight"),
        read = lambda reads: read_checkpoint(reads, m),
        states = configured(m),
    )]

TRANSFORMERS = [
    ("model.embed_tokens.weight", "embed"),
    ("model.norm.weight", "final_norm"),
    ("lm_head.weight", "head"),
    ("model.layers.{l}.input_layernorm.weight", "layers.{l}.attn_norm"),
    ("model.layers.{l}.self_attn.q_proj.weight", "layers.{l}.q"),
    ("model.layers.{l}.self_attn.k_proj.weight", "layers.{l}.k"),
    ("model.layers.{l}.self_attn.v_proj.weight", "layers.{l}.v"),
    ("model.layers.{l}.self_attn.o_proj.weight", "layers.{l}.o"),
    ("model.layers.{l}.self_attn.q_norm.weight", "layers.{l}.q_norm"),
    ("model.layers.{l}.self_attn.k_norm.weight", "layers.{l}.k_norm"),
    ("model.layers.{l}.post_attention_layernorm.weight", "layers.{l}.mlp_norm"),
    ("model.layers.{l}.mlp.gate_proj.weight", "layers.{l}.gate"),
    ("model.layers.{l}.mlp.up_proj.weight", "layers.{l}.up"),
    ("model.layers.{l}.mlp.down_proj.weight", "layers.{l}.down"),
]

# The forward of Qwen 3 (dense): pre-norm layers of full attention, its q and
# k RMS-normed per head and rotated in full (neox halves), and a SwiGLU MLP.
# A row with an adapter adds its LoRA correction to the attention's output.
# A deployment stretched by YaRN turns its rotation at the scaled frequencies.

def caches(m, c):
    kv = c.kv_space(m.kv)
    plane = m.kv_heads * m.head_dim
    for w in m.layers:
        c.kv(kv, w.kv, [plane, plane], m.head_dim, heads = True)
    if m.mtp != None:
        c.kv(kv, m.mtp.kv, [plane, plane], m.head_dim, heads = True)

def tap(mtp, layer, y, fused):
    if mtp == None or layer not in mtp.taps:
        return fused
    part = ops.linear.matmul(y.on(fact.drafts()), mtp.fc[mtp.taps.index(layer)])
    if fused == None:
        return part
    return ops.elemwise.residual_add(part, fused)

def forward(m, inputs):
    positions = inputs.positions()
    y = ops.gather.embed(inputs.tokens(), m.embed, m.vocab)
    routes = inputs.adapter_routes()
    scaling = rope_scaling(m.rope)

    def block(l, w, carried):
        y, fused = carried
        x = ops.elemwise.rmsnorm(y, w.attn_norm, m.eps)
        o = attention(x, inputs, m, w, positions, scaling = scaling, qk_norm = "head")
        y = ops.elemwise.residual_add(corrected(x, o, w, routes), y)
        x = ops.elemwise.rmsnorm(y, w.mlp_norm, m.eps)
        y = ops.elemwise.residual_add(swiglu(x, w), y)
        return (y, tap(m.mtp, l, y, fused))

    y, fused = inputs.fold_layers(m.layers, (y, None), block)
    x = ops.elemwise.rmsnorm(y, m.final_norm, m.eps)
    x = ops.gather.gather_rows(x, inputs.readout_rows())
    logits = ops.linear.lm_head(x, m.embed if m.head == None else m.head)
    if m.mtp != None:
        draft(m, inputs, fused, logits, scaling)
    output("logits", logits)

def draft(m, inputs, fused, logits, scaling):
    mtp = m.mtp
    input_mtp = inputs.on(fact.drafts())
    plan_mtp = ops.attn.plan_prefill(input_mtp, m.q_heads, m.kv_heads, m.head_dim, None)
    dpos = inputs.positions().on(fact.drafts())
    dlogits = logits.on(fact.drafts())
    pages = inputs.kv(mtp.kv)
    write_page = inputs.write_page(mtp.kv)
    write_offset = inputs.write_offset(mtp.kv)

    token = ops.sampling.argmax([dlogits])
    e = ops.gather.embed(token, mtp.embed, m.vocab)
    e = ops.elemwise.rmsnorm(e, mtp.input_norm, m.eps)
    h = ops.elemwise.rmsnorm(fused, mtp.hidden_norm, m.eps)
    q = ops.elemwise.residual_add(ops.linear.matmul(e, mtp.q_embed), ops.linear.matmul(h, mtp.q_hidden))
    k = ops.elemwise.residual_add(ops.linear.matmul(e, mtp.k_embed), ops.linear.matmul(h, mtp.k_hidden))
    v = ops.elemwise.residual_add(ops.linear.matmul(e, mtp.v_embed), ops.linear.matmul(h, mtp.v_hidden))
    q, k = ops.elemwise.rope(q, dpos, m.head_dim, m.theta, rotary.full(), k = k, scaling = scaling)
    ops.attn.kv_append(k, v, pages, write_page, write_offset)
    o = ops.attn.prefill(q, plan_mtp, pages, None, m.head_dim, m.kv_heads, m.sm_scale)
    r1 = ops.elemwise.residual_add(ops.linear.matmul(o, mtp.o), fused)
    mlp_in = ops.elemwise.rmsnorm(r1, mtp.mlp_norm, m.eps)
    r2 = ops.elemwise.residual_add(swiglu(mlp_in, mtp), r1)
    normed = ops.elemwise.rmsnorm(r2, mtp.norm, m.eps)
    proposal = ops.linear.lm_head(ops.gather.gather_rows(normed, input_mtp.readout_rows()), mtp.head)
    output("mtp.logits", proposal)
    output("mtp.drafts", ops.sampling.argmax([proposal] * mtp.depth))
