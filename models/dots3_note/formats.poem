# How a Dots3 NOTE checkpoint is laid out: transformers' names, each
# expert's projections a tensor of their own. The q and kv latents' rescale
# (`apply_mla_qkv_lora_rescale`) is folded into their norms.

def formats(m):
    return [format("huggingface", read = lambda reads: huggingface(m, reads))]

def attention(reads, a, at):
    reads.read(a.q_a_proj, at("self_attn.q_a_proj.weight"))
    reads.read_expr(a.q_a_norm, src(at("self_attn.q_a_layernorm.weight")).scale(a.q_a_scale))
    reads.read(a.q_b_proj, at("self_attn.q_b_proj.weight"))
    reads.read(a.kv_a_proj, at("self_attn.kv_a_proj_with_mqa.weight"))
    reads.read_expr(a.kv_a_norm, src(at("self_attn.kv_a_layernorm.weight")).scale(a.kv_a_scale))
    reads.read(a.k_pe_norm, at("self_attn.k_rope_only_layernorm.weight"))
    reads.read(a.kv_b_proj, at("self_attn.kv_b_proj.weight"))
    reads.read(a.gate, at("self_attn.g_proj.weight"))
    reads.read(a.o_proj, at("self_attn.o_proj.weight"))
    ix = a.indexer
    if ix == None:
        return
    reads.read(ix.q_proj, at("self_attn.indexer.wq_b.weight"))
    reads.read(ix.k_proj, at("self_attn.indexer.wk.weight"))
    reads.read(ix.weights_proj, at("self_attn.indexer.weights_proj.weight"))
    reads.read(ix.k_norm, at("self_attn.indexer.k_norm.weight"))
    reads.read(ix.k_norm_bias, at("self_attn.indexer.k_norm.bias"))

def huggingface(m, reads):
    reads.read(m.embed, "model.embed_tokens.weight")
    reads.read(m.final_norm, "model.norm.weight")
    reads.read(m.head, "lm_head.weight")
    for l, layer in enumerate(m.layers):
        at = lambda tail: "model.layers.{}.{}".format(l, tail)
        reads.read(layer.attn_norm, at("input_layernorm.weight"))
        reads.read(layer.mlp_norm, at("post_attention_layernorm.weight"))
        attention(reads, layer.attn, at)
        f = layer.mlp
        if not f.routed:
            reads.read_concat(f.gate_up, [at("mlp.gate_proj.weight"), at("mlp.up_proj.weight")])
            reads.read(f.down, at("mlp.down_proj.weight"))
            continue
        reads.read(f.router, at("mlp.gate.weight"))
        reads.read(f.bias, at("mlp.gate.e_score_correction_bias"))
        leaf = lambda e, proj: at("mlp.experts.{}.{}.weight".format(e, proj))
        held = stored(leaf(0, "gate_proj"))
        reads.read_expr(f.gate_up, concat(0, [
            concat(0, [src(leaf(e, "gate_proj")), src(leaf(e, "up_proj"))]).transmute([1, -1, m.hidden], held)
            for e in range(f.experts)
        ]))
        reads.read_expr(f.down, concat(0, [
            src(leaf(e, "down_proj")).transmute([1, m.hidden, -1], held)
            for e in range(f.experts)
        ]))
        reads.read_concat(f.shared.gate_up, [
            at("mlp.shared_experts.gate_proj.weight"),
            at("mlp.shared_experts.up_proj.weight"),
        ])
        reads.read(f.shared.down, at("mlp.shared_experts.down_proj.weight"))
