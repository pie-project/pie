# How a MiniMax-M2 checkpoint is read: transformers' safetensors under
# `model.`, each expert apart (`w1` gate, `w3` up, `w2` down), as released
# (FP8 e4m3 codes beside 128-square block factors, norms, router and score
# bias unquantized) or as modelopt exports it (attention bf16, experts NVFP4);
# recognized by its routed `block_sparse_moe` and checked against its config.
# The draft modules are not read.

load("//pie/codec.poem", "kept", "mapped")

def configured(m):
    return [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("head_dim", m.head_dim),
        config("num_hidden_layers", len(m.layers)),
        config("num_local_experts", m.experts),
        config("rotary_dim", m.rotary_dim),
        config("rms_norm_eps", m.eps),
        config("rope_theta", m.theta),
        config("max_position_embeddings", m.max_position),
    ]

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("model.layers.0.block_sparse_moe.e_score_correction_bias"),
        read = lambda reads: read(m, reads),
        states = configured(m),
    )]

TRANSFORMERS = [
    ("model.embed_tokens.weight", "embed"),
    ("model.norm.weight", "final_norm"),
    ("lm_head.weight", "head"),
    ("model.layers.{l}.input_layernorm.weight", "layers.{l}.attn_norm"),
    ([
        "model.layers.{l}.self_attn.q_proj.weight",
        "model.layers.{l}.self_attn.k_proj.weight",
        "model.layers.{l}.self_attn.v_proj.weight",
    ], "layers.{l}.qkv"),
    ("model.layers.{l}.self_attn.o_proj.weight", "layers.{l}.o"),
    ("model.layers.{l}.self_attn.q_norm.weight", "layers.{l}.q_norm"),
    ("model.layers.{l}.self_attn.k_norm.weight", "layers.{l}.k_norm"),
    ("model.layers.{l}.post_attention_layernorm.weight", "layers.{l}.mlp_norm"),
    ("model.layers.{l}.block_sparse_moe.gate.weight", "layers.{l}.router"),
    ("model.layers.{l}.block_sparse_moe.e_score_correction_bias", "layers.{l}.bias"),
    ([
        "model.layers.{l}.block_sparse_moe.experts.{e}.w1.weight",
        "model.layers.{l}.block_sparse_moe.experts.{e}.w3.weight",
    ], "layers.{l}.gate_up"),
    ("model.layers.{l}.block_sparse_moe.experts.{e}.w2.weight", "layers.{l}.down"),
]

def read(m, reads):
    for w in m.layers:
        if not kept(w.gate_up):
            fail("`{}`: MiniMax-M2 is released FP8 and exported NVFP4; this deployment reads its experts as {}".format(w.gate_up.name, w.gate_up.dtype))
    mapped(reads, m, TRANSFORMERS)
