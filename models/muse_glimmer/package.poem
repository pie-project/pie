# Muse Glimmer 30B, and its eight-layer miniature, which reads the first
# eight layers of the whole model's checkpoint; Muse Spark Open's four-layer,
# sixteen-expert miniatures of its bf16 release and of AMD's Quark MXFP4 one.

ATEM = template("atem")
TOKENIZER = tokenizer(markers = [["<|eot|>", "<|end_of_text|>"], ["<|begin_of_text|>", "<|start|>", "<|message|>", "<|eom|>"]])

MODELS = [
    model("muse-glimmer-30b", template = ATEM, tokenizer = TOKENIZER, arch = "muse_glimmer", layers = 52, vocab = 202048),
    model("muse-spark-mini-l4-e16", mini = True, template = ATEM, tokenizer = TOKENIZER, arch = "muse_glimmer", layers = 4, vocab = 202048),
    model("muse-spark-mxfp4-mini-l4-e16", mini = True, template = ATEM, tokenizer = TOKENIZER, arch = "muse_glimmer", layers = 4, vocab = 202048),
    model("muse-glimmer-30b-mini-l8", mini = True, template = ATEM, tokenizer = TOKENIZER, arch = "muse_glimmer", layers = 8, vocab = 202048),
]

DEPLOYMENTS = [
    deployment("muse-glimmer-30b", weights = dtype.bf16, kv = dtype.bf16),
    deployment("muse-glimmer-30b", weights = dtype.u4g64, kv = dtype.bf16),
    deployment("muse-glimmer-30b-mini-l8", weights = dtype.bf16, kv = dtype.bf16),
    deployment("muse-spark-mini-l4-e16", weights = dtype.bf16, kv = dtype.bf16),
    # AMD's Quark MXFP4 release: its experts MXFP4, served at W4.
    deployment("muse-spark-mxfp4-mini-l4-e16", weights = [dtype.bf16, dtype.mxfp4], kv = dtype.bf16),
]
