# Llama 3.1 and 3.3 (meta-llama/Llama-3.1-8B-Instruct, Llama-3.3-70B-Instruct):
# full grouped-query attention in every layer over llama3-scaled rope, and a
# SwiGLU MLP; as released (bf16), as NVIDIA's modelopt exports them (FP8 a
# tensor, run as 128-square blocks against e4m3 activations; NVFP4), and the
# 70B's four-layer miniature, which reads the first four layers of the whole
# model's checkpoint at its full width.

load("//pie/codec.poem", "mapped")
load("//lib/adapters.poem", "banks", "corrected")
load("//lib/blocks.poem", "attention", "swiglu")

LLAMA = template("llama")

TOKENIZER = tokenizer(markers = [["<|eot_id|>", "<|eom_id|>", "<|end_of_text|>"], ["<|begin_of_text|>", "<|start_header_id|>", "<|end_header_id|>"]])

def llama(id, layers, mini = False, **kwargs):
    return model(id, mini = mini, template = LLAMA, tokenizer = TOKENIZER, arch = "llama", layers = layers, vocab = 128256, **kwargs)

MODELS = [
    llama("llama31-8b", layers = 32, drafters = ["mtp"]),
    llama("llama33-70b", layers = 80),
    llama("llama33-70b-mini-l4", layers = 4, mini = True),
]

BF = dtype.bf16
U4 = dtype.u4g64
F8 = dtype.e4m3tile128a8
NV4W = dtype.nvfp4
E4M3 = dtype.e4m3

DEPLOYMENTS = [
    deployment("llama31-8b", weights = BF, kv = BF, drafter = "mtp"),
    deployment("llama31-8b", weights = BF, kv = BF),
    deployment("llama31-8b", weights = BF, kv = E4M3),
    # modelopt's FP8 export (`nvidia/Llama-3.1-8B-Instruct-FP8`), its one
    # scale a projection as every 128-square block's factor, against e4m3
    # activations, with the e4m3 cache vLLM serves it with.
    deployment("llama31-8b", weights = F8, kv = E4M3),
    deployment("llama31-8b", weights = F8, kv = BF),
    # modelopt's NVFP4 export against bf16 activations.
    deployment("llama31-8b", weights = NV4W, kv = E4M3),
    deployment("llama31-8b", weights = U4, kv = BF),
    deployment("llama33-70b", weights = BF, kv = BF),
    deployment("llama33-70b", weights = F8, kv = E4M3),
    deployment("llama33-70b", weights = NV4W, kv = E4M3),
    deployment("llama33-70b", weights = U4, kv = BF),
    deployment("llama33-70b-mini-l4", weights = BF, kv = BF),
    deployment("llama33-70b-mini-l4", weights = F8, kv = E4M3),
]

# The weights of Llama 3.1 / 3.3: per layer an RMS norm, the q, k, v and
# output projections, an RMS norm and a SwiGLU MLP; the token embedding, a
# final norm and the head. The projections are stored at the deployment's one
# dtype; the norms, the embedding and the head stay bf16 under a release's FP8
# or NVFP4 (modelopt leaves the head bf16), or take the projections' u4 where
# the deployment quantizes a bf16 release. Each layer also has the LoRA banks
# the host registers.

def dims(hidden, layers, q_heads, inter):
    return struct(
        hidden = hidden,
        layers = layers,
        q_heads = q_heads,
        kv_heads = 8,
        inter = inter,
        head_dim = 128,
        vocab = 128256,
        theta = 500000.0,
        # rope_scaling: rope_type "llama3".
        rope_factor = 8.0,
        rope_low_freq_factor = 1.0,
        rope_high_freq_factor = 4.0,
        rope_original_max_position = 8192,
        norm_eps = 1e-5,
    )

DIMS = {
    "llama31-8b": dims(hidden = 4096, layers = 32, q_heads = 32, inter = 14336),
    "llama33-70b": dims(hidden = 8192, layers = 80, q_heads = 64, inter = 28672),
    "llama33-70b-mini-l4": dims(hidden = 8192, layers = 4, q_heads = 64, inter = 28672),
}

# A release whose projections a deployment keeps as released, its tables bf16.
RELEASED = [dtype.e4m3tile128a8, dtype.nvfp4]

def layout(id, deploy):
    if deploy.parts or (deploy.drafter != None and (id != "llama31-8b" or deploy.drafter != "mtp")):
        fail("{} ships no drafter and no parts".format(id))
    proj = roles(deploy, "proj", exact = True).proj
    table = dtype.bf16 if proj in RELEASED else proj
    d = DIMS[id]
    hidden, hd = d.hidden, d.head_dim
    q_width, kv_width = d.q_heads * hd, d.kv_heads * hd

    def layer(l):
        lora_a, lora_b = banks(hidden)
        return struct(
            attn_norm = weight([hidden]),
            q = weight([q_width, hidden], proj),
            k = weight([kv_width, hidden], proj),
            v = weight([kv_width, hidden], proj),
            o = weight([hidden, q_width], proj),
            mlp_norm = weight([hidden]),
            gate = weight([d.inter, hidden], proj),
            up = weight([d.inter, hidden], proj),
            down = weight([hidden, d.inter], proj),
            kv = "kv.{}".format(l),
            lora_a = lora_a,
            lora_b = lora_b,
        )

    mtp = None
    if deploy.drafter == "mtp":
        mtp = struct(
            depth = 4,
            taps = [1, 15, 28],
            embed = weight([d.vocab, hidden], table),
            fc = [weight([hidden, hidden], table) for _ in range(3)],
            input_norm = weight([hidden]),
            hidden_norm = weight([hidden]),
            q_embed = weight([q_width, hidden], table),
            q_hidden = weight([q_width, hidden], table),
            k_embed = weight([kv_width, hidden], table),
            k_hidden = weight([kv_width, hidden], table),
            v_embed = weight([kv_width, hidden], table),
            v_hidden = weight([kv_width, hidden], table),
            o = weight([hidden, q_width], table),
            mlp_norm = weight([hidden]),
            gate = weight([d.inter, hidden], table),
            up = weight([d.inter, hidden], table),
            down = weight([hidden, d.inter], table),
            norm = weight([hidden]),
            head = weight([d.vocab, hidden], table),
            kv = "kv.mtp",
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        q_heads = d.q_heads,
        kv_heads = d.kv_heads,
        head_dim = hd,
        q_width = q_width,
        kv_width = kv_width,
        inter = d.inter,
        theta = d.theta,
        rope = struct(
            factor = d.rope_factor,
            low_freq_factor = d.rope_low_freq_factor,
            high_freq_factor = d.rope_high_freq_factor,
            original_max_position = d.rope_original_max_position,
        ),
        eps = d.norm_eps,
        sm_scale = f32(1.0 / f32(sqrt(hd))),
        kv = deploy.kv,
        embed = weight([d.vocab, hidden], table),
        head = weight([d.vocab, hidden], table),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight([hidden]),
        mtp = mtp,
    )

# How a Llama 3.1 / 3.3 checkpoint is read: transformers' safetensors under
# `model.`, as released (bf16) or as modelopt exports it (FP8 e4m3 codes
# under one scale a projection, read as 128-square block factors; NVFP4),
# checked against its config.

def configured(m):
    return [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("num_hidden_layers", len(m.layers)),
        config("intermediate_size", m.inter),
        config("rms_norm_eps", m.eps),
        config("rope_theta", m.theta),
        config("rope_scaling.factor", m.rope.factor),
        config("rope_scaling.low_freq_factor", m.rope.low_freq_factor),
        config("rope_scaling.high_freq_factor", m.rope.high_freq_factor),
        config("rope_scaling.original_max_position_embeddings", m.rope.original_max_position),
    ]

def read_checkpoint(reads, m):
    mapped(reads, m, TRANSFORMERS)
    if m.mtp != None:
        mtp = m.mtp
        reads.read(mtp.embed, "mtp.embed.weight")
        for i in range(3):
            reads.read(mtp.fc[i], "mtp.fc.{}.weight".format(i))
        reads.read(mtp.input_norm, "mtp.input_norm.weight")
        reads.read(mtp.hidden_norm, "mtp.hidden_norm.weight")
        reads.read(mtp.q_embed, "mtp.q_embed.weight")
        reads.read(mtp.q_hidden, "mtp.q_hidden.weight")
        reads.read(mtp.k_embed, "mtp.k_embed.weight")
        reads.read(mtp.k_hidden, "mtp.k_hidden.weight")
        reads.read(mtp.v_embed, "mtp.v_embed.weight")
        reads.read(mtp.v_hidden, "mtp.v_hidden.weight")
        reads.read(mtp.o, "mtp.o.weight")
        reads.read(mtp.mlp_norm, "mtp.mlp_norm.weight")
        reads.read(mtp.gate, "mtp.gate.weight")
        reads.read(mtp.up, "mtp.up.weight")
        reads.read(mtp.down, "mtp.down.weight")
        reads.read(mtp.norm, "mtp.norm.weight")
        reads.read(mtp.head, "mtp.head.weight")

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("model.embed_tokens.weight") and has("model.layers.0.self_attn.q_proj.weight") and not has("model.layers.0.self_attn.q_norm.weight"),
        read = lambda reads: read_checkpoint(reads, m),
        states = configured(m),
    )]

TRANSFORMERS = [
    ("model.embed_tokens.weight", "embed"),
    ("model.norm.weight", "final_norm"),
    ("lm_head.weight", "head"),
    ("model.layers.{l}.input_layernorm.weight", "layers.{l}.attn_norm"),
    ("model.layers.{l}.self_attn.q_proj.weight", "layers.{l}.q"),
    ("model.layers.{l}.self_attn.k_proj.weight", "layers.{l}.k"),
    ("model.layers.{l}.self_attn.v_proj.weight", "layers.{l}.v"),
    ("model.layers.{l}.self_attn.o_proj.weight", "layers.{l}.o"),
    ("model.layers.{l}.post_attention_layernorm.weight", "layers.{l}.mlp_norm"),
    ("model.layers.{l}.mlp.gate_proj.weight", "layers.{l}.gate"),
    ("model.layers.{l}.mlp.up_proj.weight", "layers.{l}.up"),
    ("model.layers.{l}.mlp.down_proj.weight", "layers.{l}.down"),
]

# The forward of Llama 3.1 / 3.3: pre-norm layers of full grouped-query
# attention, q and k rotated in full (neox halves) at llama3-scaled
# frequencies, and a SwiGLU MLP. A row with an adapter adds its LoRA
# correction to the attention's output.

def caches(m, c):
    kv = c.kv_space(m.kv)
    for w in m.layers:
        c.kv(kv, w.kv, [m.kv_width, m.kv_width], m.head_dim, heads = True)
    if m.mtp != None:
        c.kv(kv, m.mtp.kv, [m.kv_width, m.kv_width], m.head_dim, heads = True)

def tap(mtp, layer, y, fused):
    if mtp == None or layer not in mtp.taps:
        return fused
    part = ops.linear.matmul(y.on(fact.drafts()), mtp.fc[mtp.taps.index(layer)])
    if fused == None:
        return part
    return ops.elemwise.residual_add(part, fused)

def forward(m, inputs):
    positions = inputs.positions()
    scaling = rope_scaling({
        "rope_type": "llama3",
        "factor": m.rope.factor,
        "low_freq_factor": m.rope.low_freq_factor,
        "high_freq_factor": m.rope.high_freq_factor,
        "original_max_position_embeddings": m.rope.original_max_position,
    })
    y = ops.gather.embed(inputs.tokens(), m.embed, m.vocab)
    routes = inputs.adapter_routes()

    def block(l, w, carried):
        y, fused = carried
        x = ops.elemwise.rmsnorm(y, w.attn_norm, m.eps)
        o = attention(x, inputs, m, w, positions, scaling = scaling)
        y = ops.elemwise.residual_add(corrected(x, o, w, routes), y)
        x = ops.elemwise.rmsnorm(y, w.mlp_norm, m.eps)
        y = ops.elemwise.residual_add(swiglu(x, w), y)
        return (y, tap(m.mtp, l, y, fused))

    y, fused = inputs.fold_layers(m.layers, (y, None), block)
    x = ops.elemwise.rmsnorm(y, m.final_norm, m.eps)
    x = ops.gather.gather_rows(x, inputs.readout_rows())
    logits = ops.linear.lm_head(x, m.head)
    if m.mtp != None:
        draft(m, inputs, fused, logits, scaling)
    output("logits", logits)

def draft(m, inputs, fused, logits, scaling):
    mtp = m.mtp
    input_mtp = inputs.on(fact.drafts())
    plan_mtp = ops.attn.plan_prefill(input_mtp, m.q_heads, m.kv_heads, m.head_dim, None)
    dpos = inputs.positions().on(fact.drafts())
    dlogits = logits.on(fact.drafts())
    pages = inputs.kv(mtp.kv)
    write_page = inputs.write_page(mtp.kv)
    write_offset = inputs.write_offset(mtp.kv)

    token = ops.sampling.argmax([dlogits])
    e = ops.gather.embed(token, mtp.embed, m.vocab)
    e = ops.elemwise.rmsnorm(e, mtp.input_norm, m.eps)
    h = ops.elemwise.rmsnorm(fused, mtp.hidden_norm, m.eps)
    q = ops.elemwise.residual_add(ops.linear.matmul(e, mtp.q_embed), ops.linear.matmul(h, mtp.q_hidden))
    k = ops.elemwise.residual_add(ops.linear.matmul(e, mtp.k_embed), ops.linear.matmul(h, mtp.k_hidden))
    v = ops.elemwise.residual_add(ops.linear.matmul(e, mtp.v_embed), ops.linear.matmul(h, mtp.v_hidden))
    q, k = ops.elemwise.rope(q, dpos, m.head_dim, 10000.0, rotary.full(), k = k)
    ops.attn.kv_append(k, v, pages, write_page, write_offset)
    o = ops.attn.prefill(q, plan_mtp, pages, None, m.head_dim, m.kv_heads, m.sm_scale)
    r1 = ops.elemwise.residual_add(ops.linear.matmul(o, mtp.o), fused)
    mlp_in = ops.elemwise.rmsnorm(r1, mtp.mlp_norm, m.eps)
    r2 = ops.elemwise.residual_add(swiglu(mlp_in, mtp), r1)
    normed = ops.elemwise.rmsnorm(r2, mtp.norm, m.eps)
    proposal = ops.linear.lm_head(ops.gather.gather_rows(normed, input_mtp.readout_rows()), mtp.head)
    output("mtp.logits", proposal)
    output("mtp.drafts", ops.sampling.argmax([proposal] * mtp.depth))
