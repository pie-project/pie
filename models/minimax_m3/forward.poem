# The forward of MiniMax-M3: pre-norm layers of GQA attention and a clamped
# SwiGLU-OAI MLP. A sparse layer's indexer ranks the 128-key blocks a row sees
# by their best key, for each kv head on its own, and that head's queries read
# its sixteen blocks, the row's own among them; a dense layer's read every key.

def caches(m, c):
    kv = c.kv_space(m.kv)
    plane = m.kv_heads * m.head_dim
    for w in m.layers:
        c.kv(kv, w.attn.kv, [plane, plane], m.head_dim, heads = True)
        if w.indexer != None:
            # One raw indexer key a token.
            index = c.kv_space(m.kv)
            c.kv(index, w.indexer.keys, [w.indexer.head_dim], w.indexer.head_dim)

def classes():
    return [fact.has(fact.Mask), fact.scores(), fact.single_token()]

def plans(inputs, m):
    ([input_m, input_s, input_d], input_p) = inputs.partition(classes())
    return struct(
        m = ops.attn.plan_prefill(input_m, m.q_heads, m.kv_heads, m.head_dim, None),
        s = ops.attn.plan_prefill(input_s, m.q_heads, m.kv_heads, m.head_dim, None),
        d = ops.attn.plan_decode(input_d, m.q_heads, m.kv_heads, m.head_dim, None),
        p = ops.attn.plan_prefill(input_p, m.q_heads, m.kv_heads, m.head_dim, None),
    )

def forward(m, inputs):
    plan = plans(inputs, m)
    mask = inputs.mask()
    y = ops.layout.embed(inputs.tokens(), m.embed, m.vocab)

    def block(l, w, y):
        x = ops.elemwise.rmsnorm_plus_one(y, w.attn_norm, m.norm_eps)
        o = attn_mixer(x, inputs, m, plan, mask, w.attn, w.indexer)
        y = ops.elemwise.residual_add(o, y)
        x = ops.elemwise.rmsnorm_plus_one(y, w.mlp_norm, m.norm_eps)
        f = moe(x, w.mlp) if w.mlp != None else swiglu_oai(x, w.dense)
        return ops.elemwise.residual_add(f, y)

    y = inputs.fold_layers(m.layers, y, block)
    x = ops.elemwise.rmsnorm_plus_one(y, m.final_norm, m.norm_eps)
    x = ops.layout.gather_rows(x, inputs.readout_rows())
    return ops.linear.lm_head(x, m.head)

def swiglu_oai(x, f):
    act = ops.linear.mlp_swiglu_clamp_alpha(ops.linear.matmul(x, f.gate_up), f.inter, f.limit, f.alpha)
    return ops.linear.matmul(act, f.down)

def moe(x, f):
    """The routed experts, scaled, beside the shared expert."""
    experts, weights = ops.linear.moe_topk_sigmoid_biased(
        ops.linear.matmul(x, f.router),
        f.bias,
        f.experts,
        f.top_k,
        True,
        f.routed_scaling,
    )

    def select(act, bank):
        if bank.dtype in [dtype.bf16, dtype.f16, dtype.f32]:
            return ops.linear.moe_matmul_select(act, bank, experts, f.top_k)
        return ops.linear.moe_matmul_select_quant(act, bank, experts, f.top_k)

    act = ops.linear.mlp_swiglu_clamp_alpha(select(x, f.gate_up), f.inter, f.limit, f.alpha)
    routed = ops.linear.moe_weighted_sum(select(act, f.down), weights)
    return ops.elemwise.residual_add(swiglu_oai(x, f.shared), routed)

def select_blocks(x, inputs, a, ix):
    """Each row's blocks, `ix.top_k` for each kv head."""
    keys = inputs.kv(ix.keys)
    positions = inputs.positions()
    q = ops.linear.matmul(x, ix.q_proj)
    k = ops.linear.matmul(x, ix.k_proj)
    q = ops.elemwise.rmsnorm_per_head_plus_one(q, ix.q_norm, ix.head_dim, ix.norm_eps)
    k = ops.elemwise.rmsnorm_per_head_plus_one(k, ix.k_norm, ix.head_dim, ix.norm_eps)
    q, k = ops.elemwise.rope_partial(q, k, positions, a.rotary_dim, ix.head_dim, a.theta)
    ops.attn.index_kv_append(k, keys, inputs.write_page(ix.keys), inputs.write_offset(ix.keys))
    return ops.attn.index_topk(q, None, keys, ix.heads, ix.head_dim, ix.top_k, ix.block, score = "block_max")

def attn_mixer(x, inputs, m, plan, mask, a, ix):
    pages = inputs.kv(a.kv)
    d = m.head_dim
    q = ops.linear.matmul(x, a.q_proj)
    k = ops.linear.matmul(x, a.k_proj)
    v = ops.linear.matmul(x, a.v_proj)
    seam.at(seam.ATTN_QV, [q, v])
    q = ops.elemwise.rmsnorm_per_head_plus_one(q, a.q_norm, d, a.norm_eps)
    k = ops.elemwise.rmsnorm_per_head_plus_one(k, a.k_norm, d, a.norm_eps)
    q, k = ops.elemwise.rope_partial(q, k, inputs.positions(), a.rotary_dim, d, a.theta)
    ops.attn.kv_append(k, v, pages, inputs.write_page(a.kv), inputs.write_offset(a.kv))
    seam.at(seam.ATTN_Q, [q])

    ([mq, sq, dq], pq) = q.partition(classes())
    so, lse = ops.attn.prefill_lse(sq, plan.s, pages, None, d, m.kv_heads, a.sm_scale)
    seam.at(seam.SCORES, [lse])
    if ix == None:
        od = ops.attn.decode(dq, plan.d, pages, None, d, a.sm_scale)
        op = ops.attn.prefill(pq, plan.p, pages, None, d, m.kv_heads, a.sm_scale)
    else:
        ([_, _, d_sel], p_sel) = select_blocks(x, inputs, a, ix).partition(classes())
        od = ops.attn.decode_selected(dq, plan.d, d_sel, pages, None, d, a.sm_scale, ix.block, per_head = True)
        op = ops.attn.prefill_selected(pq, plan.p, p_sel, pages, None, d, m.kv_heads, a.sm_scale, ix.block, per_head = True)
    o = merge([
        ops.attn.masked(mq, plan.m, mask, pages, None, d, m.kv_heads, True, a.sm_scale),
        so,
        od,
        op,
    ])
    seam.at(seam.ATTN_OUT, [o])
    return ops.linear.matmul(o, a.o_proj)
