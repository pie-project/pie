# How a Qwen 3 MoE checkpoint is read: transformers' safetensors under
# `model.`, each expert apart, as released (bf16), as Qwen releases it in FP8
# (e4m3 codes beside 128-square block factors), or as modelopt exports it in
# NVFP4 (codes, e4m3 scales a 16, a tensor scale and an input scale a leg);
# recognized by its per-head q norm and its first expert, and checked against
# its config.

load("//pie/codec.poem", "mapped")

def configured(m):
    return [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("head_dim", m.head_dim),
        config("num_hidden_layers", len(m.layers)),
        config("moe_intermediate_size", m.inter),
        config("num_experts", m.experts),
        config("num_experts_per_tok", m.top_k),
        config("rms_norm_eps", m.eps),
        config("rope_theta", m.theta),
    ]

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("model.layers.0.self_attn.q_norm.weight") and has("model.layers.0.mlp.experts.0.down_proj.weight"),
        read = lambda reads: mapped(reads, m, TRANSFORMERS),
        states = configured(m),
    )]

TRANSFORMERS = [
    ("model.embed_tokens.weight", "embed"),
    ("model.norm.weight", "final_norm"),
    ("lm_head.weight", "head"),
    ("model.layers.{l}.input_layernorm.weight", "layers.{l}.attn_norm"),
    ([
        "model.layers.{l}.self_attn.q_proj.weight",
        "model.layers.{l}.self_attn.k_proj.weight",
        "model.layers.{l}.self_attn.v_proj.weight",
    ], "layers.{l}.qkv"),
    ("model.layers.{l}.self_attn.o_proj.weight", "layers.{l}.o"),
    ("model.layers.{l}.self_attn.q_norm.weight", "layers.{l}.q_norm"),
    ("model.layers.{l}.self_attn.k_norm.weight", "layers.{l}.k_norm"),
    ("model.layers.{l}.post_attention_layernorm.weight", "layers.{l}.mlp_norm"),
    ("model.layers.{l}.mlp.gate.weight", "layers.{l}.router"),
    (["model.layers.{l}.mlp.experts.{e}.gate_proj.weight", "model.layers.{l}.mlp.experts.{e}.up_proj.weight"], "layers.{l}.gate_up"),
    ("model.layers.{l}.mlp.experts.{e}.down_proj.weight", "layers.{l}.down"),
]
