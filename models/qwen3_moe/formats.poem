# How a Qwen 3 MoE checkpoint is read: transformers' safetensors under
# `model.`, each expert apart, as released (bf16), as Qwen releases it in FP8
# (e4m3 codes beside 128-square block factors), or as modelopt exports it in
# NVFP4 (codes, e4m3 scales a 16, a tensor scale and an input scale a leg);
# recognized by its per-head q norm and its first expert, and checked against
# its config.

load("//pie/codec.poem", "bank", "weight")

def configured(m):
    return [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("head_dim", m.head_dim),
        config("num_hidden_layers", len(m.layers)),
        config("moe_intermediate_size", m.inter),
        config("num_experts", m.experts),
        config("num_experts_per_tok", m.top_k),
        config("rms_norm_eps", m.eps),
        config("rope_theta", m.theta),
    ]

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("model.layers.0.self_attn.q_norm.weight") and has("model.layers.0.mlp.experts.0.down_proj.weight"),
        read = lambda reads: read(m, reads),
        states = configured(m),
    )]

def read(m, reads):
    reads.read(m.embed, "model.embed_tokens.weight")
    reads.read(m.final_norm, "model.norm.weight")
    reads.read(m.head, "lm_head.weight")
    for l, w in enumerate(m.layers):
        n = lambda s: "model.layers.{}.{}".format(l, s)
        reads.read(w.attn_norm, n("input_layernorm.weight"))
        weight(
            reads,
            w.qkv,
            [n("self_attn.q_proj.weight"), n("self_attn.k_proj.weight"), n("self_attn.v_proj.weight")],
        )
        weight(reads, w.o, [n("self_attn.o_proj.weight")])
        reads.read(w.q_norm, n("self_attn.q_norm.weight"))
        reads.read(w.k_norm, n("self_attn.k_norm.weight"))
        reads.read(w.mlp_norm, n("post_attention_layernorm.weight"))
        reads.read(w.router, n("mlp.gate.weight"))
        leg = lambda e, name: n("mlp.experts.{}.{}.weight".format(e, name))
        bank(reads, w.gate_up, [[leg(e, "gate_proj"), leg(e, "up_proj")] for e in range(m.experts)])
        bank(reads, w.down, [[leg(e, "down_proj")] for e in range(m.experts)])
