# The weights of Hy4-preview: gated latent attention with a sink per head
# over the keys a lightning indexer picks (own or the last ranking's), a dense
# first layer then routed experts, four hyper-connected residual streams, and
# an optional MTP draft head.

load("//lib/adapters/model.poem", "banks")

def hyper(streams, norm_eps, gate_eps, alpha):
    """The streams' shape and the constants their gates are computed with."""
    return struct(streams = streams, norm_eps = norm_eps, gate_eps = gate_eps, alpha = alpha)

def mix(n, name, streams, hidden):
    """A sublayer's mix `name` over `streams` streams `hidden` wide: the pre
    and post logits a projection of the normed streams scores, scaled and
    biased; no combine."""
    width = 2 * streams
    return struct(
        scale = weight(n(name + "_scale"), [2], dtype.f32),
        base = weight(n(name + "_base"), [width], dtype.f32),
        dynamic = weight(n(name + "_fn"), [width, streams * hidden], dtype.f32),
    )

def head(prefix, streams, hidden):
    """The trunk's collapse of its streams into one row."""
    return struct(
        scale = weight(prefix + "_scale", [1], dtype.f32),
        base = weight(prefix + "_base", [streams], dtype.f32),
        dynamic = weight(prefix + "_fn", [streams, streams * hidden], dtype.f32),
    )

def attention(n, d, hidden, weights, norms, eps, kv, sink, indexer):
    """The gated latent attention named by `n`, its projections in `weights`
    and its norms in `norms`, caching under `kv`, its sink logits at `sink`;
    `indexer` ranks its keys, or with none it reads the last ranking."""
    qk_head_dim = d.qk_nope_head_dim + d.qk_rope_head_dim
    v_width = d.heads * d.v_head_dim
    return struct(
        heads = d.heads,
        kv_lora_rank = d.kv_lora_rank,
        qk_nope_head_dim = d.qk_nope_head_dim,
        qk_rope_head_dim = d.qk_rope_head_dim,
        v_head_dim = d.v_head_dim,
        theta = d.theta,
        sm_scale = f32(1.0 / f32(sqrt(qk_head_dim))),
        q_a_proj = weight(n("q_a_proj"), [d.q_lora_rank, hidden], weights),
        q_a_norm = weight(n("q_a_norm"), [d.q_lora_rank], norms),
        q_a_norm_eps = eps,
        q_b_proj = weight(n("q_b_proj"), [d.heads * qk_head_dim, d.q_lora_rank], weights).columns(),
        kv_a_proj = weight(n("kv_a_proj"), [d.kv_lora_rank + d.qk_rope_head_dim, hidden], weights),
        kv_a_norm = weight(n("kv_a_norm"), [d.kv_lora_rank], norms),
        kv_a_norm_eps = eps,
        kv_b_proj = weight(
            n("kv_b_proj"),
            [d.heads * (d.qk_nope_head_dim + d.v_head_dim), d.kv_lora_rank],
            weights,
        ).columns(),
        gate = weight(n("o_gate"), [v_width, hidden], weights).columns(),
        sink = weight(n("sink"), [d.heads], dtype.f32).columns(),
        o_proj = weight(n("o_proj"), [hidden, v_width], weights).rows(),
        kv = kv,
        indexer = indexer,
    )

def preview(layers = 78, experts = 256, index_top_k = 2048):
    return struct(
        hidden = 6144,
        layers = layers,
        dense_layers = 1,
        mla = struct(
            heads = 64,
            q_lora_rank = 2048,
            kv_lora_rank = 512,
            qk_nope_head_dim = 192,
            qk_rope_head_dim = 64,
            v_head_dim = 256,
            theta = 10000000.0,
        ),
        index_heads = 32,
        index_head_dim = 128,
        index_top_k = index_top_k,
        index_norm_eps = 1e-6,
        streams = 4,
        gate_eps = 1e-6,
        alpha = 2.0,
        dense_inter = 18432,
        moe = struct(
            experts = experts,
            top_k = min(8, experts),
            inter = 2048,
            shared_inter = 2048,
            renorm = True,
            scaling = 2.827,
        ),
        swiglu_limit = 10.0,
        vocab = 120832,
        norm_eps = 1e-5,
    )

DIMS = {
    "hy4-preview": preview(),
    # The first six layers with the first sixteen routed experts: the dense
    # layer, the ranking layers 0, 1 and 5 and the reading layers 2-4; its
    # indexer keeps sixteen keys, so the ranking is read at probe lengths.
    "hy4-mini": preview(layers = 6, experts = 16, index_top_k = 16),
}

def ranks(l):
    """Whether layer `l` ranks its own keys ("full") or reads the last
    ranking ("shared"): the first, then every fourth from the second."""
    return l == 0 or (l - 1) % 4 == 0

def layout(id, deploy):
    if deploy.drafter == "mtp":
        if len(deploy.weights) != 3:
            fail("{} with its draft head stores its weights, experts and draft experts at a dtype each, not {}".format(id, deploy.weights))
        weights, experts, draft = deploy.weights
    elif len(deploy.weights) == 1:
        weights, experts = deploy.weights[0], deploy.weights[0]
        draft = None
    else:
        if len(deploy.weights) != 2:
            fail("{} stores its weights and its experts at one dtype or a dtype each, not {}".format(id, deploy.weights))
        weights, experts = deploy.weights
        draft = None
    d = DIMS[id]
    dense = compute(weights)
    hidden = d.hidden
    streams = d.streams
    a = d.mla
    index_width = d.index_heads * d.index_head_dim

    def mla_at(prefix, kv, keys, sink):
        n = lambda s: "{}.{}".format(prefix, s)
        indexer = None
        if keys != None:
            indexer = struct(
                heads = d.index_heads,
                head_dim = d.index_head_dim,
                top_k = d.index_top_k,
                rope_dim = a.qk_rope_head_dim,
                theta = a.theta,
                wq_b = weight(n("index_q_proj"), [index_width, a.q_lora_rank], weights),
                wk = weight(n("index_k_proj"), [d.index_head_dim, hidden], weights),
                weights_proj = weight(n("index_weights"), [d.index_heads, hidden], weights),
                k_norm = weight(n("index_k_norm"), [d.index_head_dim], dense),
                k_norm_bias = weight(n("index_k_norm_bias"), [d.index_head_dim], dense),
                k_norm_eps = d.index_norm_eps,
                keys = keys,
            )
        return attention(n, a, hidden, weights, dense, d.norm_eps, kv, sink, indexer)

    def routed_at(prefix, banks_dtype):
        n = lambda s: "{}.{}".format(prefix, s)
        m = d.moe
        iw = m.inter
        sw = m.shared_inter
        return struct(
            routed = True,
            router = weight(n("router"), [m.experts, hidden], dense),
            bias = weight(n("router_bias"), [m.experts], dtype.f32),
            gate_up = weight(n("experts_gate_up"), [m.experts, 2 * iw, hidden], banks_dtype).bank([iw, iw]),
            down = weight(n("experts_down"), [m.experts, hidden, iw], banks_dtype).rows(),
            shared = struct(
                gate_up = weight(n("shared_gate_up"), [2 * sw, hidden], weights).packed([sw, sw]),
                down = weight(n("shared_down"), [hidden, sw], weights).rows(),
                inter = sw,
            ),
            experts = m.experts,
            top_k = m.top_k,
            inter = iw,
            limit = d.swiglu_limit,
            renorm = m.renorm,
            scaling = m.scaling,
        )

    def layer(l):
        n = lambda s: "layer.{}.{}".format(l, s)
        norm = lambda s: weight(n(s), [hidden], dense)
        lora_a, lora_b = banks("layer.{}".format(l), hidden, dense)
        keys = "index.{}".format(l) if ranks(l) else None
        if l < d.dense_layers:
            iw = d.dense_inter
            mlp = struct(
                routed = False,
                gate_up = weight(n("gate_up"), [2 * iw, hidden], weights).packed([iw, iw]),
                down = weight(n("down"), [hidden, iw], weights).rows(),
                inter = iw,
            )
        else:
            mlp = routed_at("layer.{}".format(l), experts)
        return struct(
            attn_mix = mix(n, "attn_hc", streams, hidden),
            attn_norm = norm("attn_norm"),
            attn_norm_eps = d.norm_eps,
            attn = mla_at("layer.{}".format(l), "kv.{}".format(l), keys, n("sink")),
            mlp_mix = mix(n, "ffn_hc", streams, hidden),
            mlp_norm = norm("mlp_norm"),
            mlp_norm_eps = d.norm_eps,
            mlp = mlp,
            lora_a = lora_a,
            lora_b = lora_b,
        )

    mtp = None
    if draft != None:
        mtp = struct(
            enorm = weight("mtp.enorm", [hidden], dense),
            hnorm = weight("mtp.hnorm", [hidden], dense),
            e_proj = weight("mtp.e_proj", [hidden, hidden], dense),
            h_proj = weight("mtp.h_proj", [hidden, hidden], dense),
            attn_norm = weight("mtp.attn_norm", [hidden], dense),
            attn = mla_at("mtp", "kv.mtp", "index.mtp", "mtp.sink"),
            mlp_norm = weight("mtp.mlp_norm", [hidden], dense),
            mlp = routed_at("mtp", draft),
            norm = weight("mtp.norm", [hidden], dense),
            norm_eps = d.norm_eps,
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        heads = a.heads,
        kv_lora_rank = a.kv_lora_rank,
        kv = deploy.kv,
        hyper = hyper(streams, d.norm_eps, d.gate_eps, d.alpha),
        embed = weight("embed", [d.vocab, hidden], weights),
        head = weight("lm_head", [d.vocab, hidden], weights),
        hc_head = head("hc_head", streams, hidden),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight("final_norm", [hidden], dense),
        final_norm_eps = d.norm_eps,
        mtp = mtp,
    )
