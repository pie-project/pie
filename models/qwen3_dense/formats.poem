# How a Qwen 3 (dense) checkpoint is read: transformers' safetensors, under
# `model.`, as released (bf16), as Qwen releases it in FP8 (e4m3 codes beside
# 128-square block factors), as compressed-tensors stores it in FP8 (a scale
# a row: RedHatAI's *-FP8-dynamic) or as modelopt exports it in NVFP4;
# recognized by its per-head q norm and checked against its config.

load("//lib/blockfp8/formats.poem", "fp8_proj", "fp8_read")
load("//lib/compressed/formats.poem", "channel_fp8", "channel_fp8_read", "channel_kept")

def configured(m):
    return [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("head_dim", m.head_dim),
        config("num_hidden_layers", len(m.layers)),
        config("intermediate_size", m.inter),
        config("rms_norm_eps", m.eps),
        config("rope_theta", m.theta),
    ]

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("model.embed_tokens.weight") and has("model.layers.0.self_attn.q_norm.weight") and not has("model.layers.0.mlp.experts.0.down_proj.weight"),
        read = lambda reads: read(m, reads),
        states = configured(m),
    )]

def unscaled(w, name):
    """Refuses to read `name`'s e4m3 codes as `w`'s dtype: without their
    scales the codes are not the weight."""
    if stored(name) == raw(dtype.e4m3):
        fail("`{}`: `{}` is stored FP8 and this deployment reads it as {}; import the deployment that keeps the release's FP8".format(w.name, name, w.dtype))

def proj(reads, w, names):
    """`w` from its legs `names`: the release's block or per-channel FP8
    kept, or read as stored (bf16, or modelopt's NVFP4)."""
    if fp8_proj(w):
        if channel_fp8(names[0]):
            fail("`{}` is stored per-channel FP8, and this deployment reads it as 128-square blocks; import the deployment that keeps it e4m3g128a8".format(names[0]))
        fp8_read(reads, w, names)
        return
    if channel_kept(w):
        channel_fp8_read(reads, w, names)
        return
    for name in names:
        if channel_fp8(name):
            fail("`{}` is stored per-channel FP8, and this deployment reads it as {}; import the deployment that keeps it e4m3g128a8".format(name, w.dtype))
        unscaled(w, name)
    if len(names) == 1:
        reads.read(w, names[0])
    else:
        reads.read_concat(w, names)

def read(m, reads):
    reads.read(m.embed, "model.embed_tokens.weight")
    reads.read(m.final_norm, "model.norm.weight")
    if m.head != None:
        reads.read(m.head, "lm_head.weight")
    for l, w in enumerate(m.layers):
        n = lambda s: "model.layers.{}.{}".format(l, s)
        reads.read(w.attn_norm, n("input_layernorm.weight"))
        proj(reads, w.q, [n("self_attn.q_proj.weight")])
        proj(reads, w.k, [n("self_attn.k_proj.weight")])
        proj(reads, w.v, [n("self_attn.v_proj.weight")])
        proj(reads, w.o, [n("self_attn.o_proj.weight")])
        reads.read(w.q_norm, n("self_attn.q_norm.weight"))
        reads.read(w.k_norm, n("self_attn.k_norm.weight"))
        reads.read(w.mlp_norm, n("post_attention_layernorm.weight"))
        proj(reads, w.gate_up, [n("mlp.gate_proj.weight"), n("mlp.up_proj.weight")])
        proj(reads, w.down, [n("mlp.down_proj.weight")])
