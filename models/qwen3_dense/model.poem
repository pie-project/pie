# The weights of Qwen 3 (dense): per layer an RMS norm, q, k, v and o
# projections with per-head q and k norms, an RMS norm and a SwiGLU MLP; the
# token embedding, which the 0.6B also reads out through (tied), a final norm.
# Each layer also has the LoRA banks the host registers.

load("//lib/adapters/model.poem", "banks")
load("//lib/rope.poem", "yarn")

def dims(hidden, layers, q_heads, kv_heads, inter, tied):
    return struct(
        hidden = hidden,
        layers = layers,
        q_heads = q_heads,
        kv_heads = kv_heads,
        inter = inter,
        tied = tied,
        head_dim = 128,
        vocab = 151936,
        theta = 1000000.0,
        norm_eps = 1e-6,
    )

DIMS = {
    "qwen3-0.6b": dims(hidden = 1024, layers = 28, q_heads = 16, kv_heads = 8, inter = 3072, tied = True),
    "qwen3-14b": dims(hidden = 5120, layers = 40, q_heads = 40, kv_heads = 8, inter = 17408, tied = False),
}

def layout(id, deploy):
    if len(deploy.weights) != 1:
        fail("{} stores its weights at one dtype, not {}".format(id, deploy.weights))
    if deploy.drafter != None or deploy.parts:
        fail("{} ships no drafter and no parts".format(id))
    w = deploy.weights[0]
    d = DIMS[id]
    dense = compute(w)
    hidden, hd = d.hidden, d.head_dim

    def layer(l):
        n = lambda s: "layer.{}.{}".format(l, s)
        lora_a, lora_b = banks("layer.{}".format(l), hidden, dense)
        return struct(
            attn_norm = weight(n("attn_norm"), [hidden], dense),
            q = weight(n("q"), [d.q_heads * hd, hidden], w).columns(),
            k = weight(n("k"), [d.kv_heads * hd, hidden], w).columns(heads = d.kv_heads),
            v = weight(n("v"), [d.kv_heads * hd, hidden], w).columns(heads = d.kv_heads),
            o = weight(n("o"), [hidden, d.q_heads * hd], w).rows(),
            q_norm = weight(n("q_norm"), [hd], dense),
            k_norm = weight(n("k_norm"), [hd], dense),
            mlp_norm = weight(n("mlp_norm"), [hidden], dense),
            gate_up = weight(n("gate_up"), [2 * d.inter, hidden], w).packed([d.inter, d.inter]),
            down = weight(n("down"), [hidden, d.inter], w).rows(),
            kv = "kv.{}".format(l),
            lora_a = lora_a,
            lora_b = lora_b,
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        q_heads = d.q_heads,
        kv_heads = d.kv_heads,
        head_dim = hd,
        inter = d.inter,
        theta = d.theta,
        eps = d.norm_eps,
        # Qwen3's native context, which YaRN stretches (its card: factor 4
        # over 32768 tokens).
        rope = yarn(deploy, 32768),
        sm_scale = f32(1.0 / f32(sqrt(hd))),
        kv = deploy.kv,
        embed = weight("embed", [d.vocab, hidden], w),
        head = None if d.tied else weight("lm_head", [d.vocab, hidden], w).columns(),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight("final_norm", [hidden], dense),
    )
