# GLM-5.3-Flash, with its vision tower and multi-token draft head or
# without, and its eight-layer, 32-expert miniature.

GLM = template("glm")
TOKENIZER = tokenizer(
    markers = [["<|user|>", "<|observation|>", "<|endoftext|>"]],
    parts = {"vision": [["<|begin_of_image|>", "<|image|>", "<|end_of_image|>"]]},
)

MODELS = [
    model(
        "glm53-flash",
        template = GLM,
        tokenizer = TOKENIZER,
        parts = ["vision"],
        drafters = ["mtp"],
        arch = "glm5_next", layers = 45, vocab = 154880,
    ),
    model("glm53-flash-mini", mini = True, template = GLM, tokenizer = TOKENIZER, arch = "glm5_next", layers = 8, vocab = 154880),
]

F8 = dtype.e4m3tile128a8

DEPLOYMENTS = [
    deployment("glm53-flash", weights = [dtype.u8g64, dtype.u2g64, dtype.u4g64], kv = dtype.bf16, drafter = "mtp"),
    deployment("glm53-flash-mini", weights = [dtype.u4g64, dtype.u4g64], kv = dtype.bf16),
    deployment("glm53-flash-mini", weights = [dtype.bf16, dtype.bf16], kv = dtype.bf16),
    deployment("glm53-flash-mini", weights = [dtype.bf16, dtype.mxfp4a8], kv = dtype.bf16),
    # The release as vLLM serves it: its FP8 projections and experts as
    # stored (128-square blocks, activations e4m3 in 1x128), the rest bf16;
    # the latent keys bf16, or fp8 rows as on Blackwell.
    deployment("glm53-flash", weights = [F8, F8], kv = dtype.bf16),
    deployment("glm53-flash-mini", weights = [F8, F8], kv = dtype.bf16),
    deployment("glm53-flash", weights = [F8, F8], kv = dtype.e4m3),
    deployment("glm53-flash-mini", weights = [F8, F8], kv = dtype.e4m3),
    deployment("glm53-flash", weights = [dtype.u8g64, dtype.u2g64], kv = dtype.bf16),
    deployment(
        "glm53-flash",
        weights = [dtype.u8g64, dtype.u2g64, dtype.u4g64],
        kv = dtype.bf16,
        parts = ["vision"],
        drafter = "mtp",
    ),
    deployment("glm53-flash", weights = [dtype.u8g64, dtype.u2g64], kv = dtype.bf16, parts = ["vision"]),
    deployment(
        "glm53-flash",
        weights = [dtype.u4g64, dtype.u2g64, dtype.u4g64],
        kv = dtype.bf16,
        parts = ["vision"],
        drafter = "mtp",
    ),
]
