# The weights of GLM-5.3-Flash: KDA linear attention with a DSA layer (latent
# attention over the keys a pooling indexer picks) every fourth, three dense
# layers and then routed experts, the residual stream carried as four
# hyper-connected streams; an optional vision tower and MTP draft head.

load("//lib/media.poem", "smart_resize")

load("//lib/adapters/model.poem", "banks")

def hyper(streams, norm_eps, gate_eps, alpha, sinkhorn, single_pass = False):
    """The streams' shape and the constants their gates are computed with;
    under `single_pass` each sublayer's input mix is the one the previous
    sublayer predicted."""
    return struct(
        streams = streams,
        norm_eps = norm_eps,
        gate_eps = gate_eps,
        alpha = alpha,
        sinkhorn = sinkhorn,
        single_pass = single_pass,
    )

def mix(n, name, streams, hidden, dynamic = True):
    """A sublayer's mix `name` over `streams` streams `hidden` wide: a
    static `base` and `scale`, and with `dynamic` a projection of the
    normed streams added to it."""
    width = 2 * streams + streams * streams
    return struct(
        scale = weight([3], dtype.f32),
        base = weight([width], dtype.f32),
        dynamic = weight([width, streams * hidden], dtype.f32) if dynamic else None,
    )

def kda(n, l, k, hidden, weights, conv, eps, gate_floor, gate_rank = None, **extra):
    """The KDA mixer of layer `l` named by `n`, its projections in `weights`
    and its convolution bank in `conv`. Its output gate is one projection,
    or a pair through `gate_rank`. `extra` rides along."""
    width = k.heads * k.head_dim
    if gate_rank == None:
        gate = [weight([width, hidden], weights).columns()]
    else:
        gate = [
            weight([gate_rank, hidden], weights),
            weight([width, gate_rank], weights).columns(),
        ]
    return struct(
        heads = k.heads,
        head_dim = k.head_dim,
        conv_kernel = k.conv_kernel,
        norm_eps = eps,
        gate_floor = gate_floor,
        qkv = weight([3 * width, hidden], weights).packed([width] * 3),
        conv = weight([3 * width, k.conv_kernel], conv).packed([width] * 3),
        f_a = weight([k.f_rank, hidden], weights),
        f_b = weight([width, k.f_rank], weights).columns(),
        gate = gate,
        b = weight([k.heads, hidden], weights).columns(),
        dt_bias = weight([k.heads, k.head_dim], dtype.f32).columns(),
        a_log = weight([k.heads], dtype.f32).columns(),
        o_norm = weight([k.head_dim], dtype.f32),
        o_norm_eps = eps,
        o_proj = weight([hidden, width], weights).rows(),
        conv_state = "conv.{}".format(l),
        delta_state = "delta.{}".format(l),
        **extra
    )

def attention(n, d, hidden, weights, norms, eps, kv, theta = None, gated = False, side = None, **extra):
    """The latent attention named by `n`, its projections in `weights` (its
    `kv_b` and gate in `side`, where given) and its norms in `norms`, caching
    under `kv`. Its rope part is rotated at `theta`, or left as it is with
    none; `gated` adds a sigmoid gate on its output. `extra` rides along (an
    indexer, say)."""
    side = side if side != None else weights
    qk_head_dim = d.qk_nope_head_dim + d.qk_rope_head_dim
    v_width = d.heads * d.v_head_dim
    return struct(
        heads = d.heads,
        kv_lora_rank = d.kv_lora_rank,
        qk_nope_head_dim = d.qk_nope_head_dim,
        qk_rope_head_dim = d.qk_rope_head_dim,
        v_head_dim = d.v_head_dim,
        theta = theta,
        sm_scale = f32(1.0 / f32(sqrt(qk_head_dim))),
        q_a_proj = weight([d.q_lora_rank, hidden], weights),
        q_a_norm = weight([d.q_lora_rank]),
        q_a_norm_eps = eps,
        q_b_proj = weight([d.heads * qk_head_dim, d.q_lora_rank], weights).columns(),
        kv_a_proj = weight([d.kv_lora_rank + d.qk_rope_head_dim, hidden], weights),
        kv_a_norm = weight([d.kv_lora_rank]),
        kv_a_norm_eps = eps,
        kv_b_proj = weight([d.heads * (d.qk_nope_head_dim + d.v_head_dim), d.kv_lora_rank],
            side,
        ).columns(),
        gate = weight([v_width, hidden], side).columns() if gated else None,
        o_proj = weight([hidden, v_width], weights).rows(),
        kv = kv,
        **extra
    )

def flash(layers = 45, experts = 288):
    return struct(
        hidden = 4096,
        layers = layers,
        dense_layers = 3,
        full_attn_every = 4,
        mla = struct(
            heads = 64,
            q_lora_rank = 1536,
            kv_lora_rank = 512,
            qk_nope_head_dim = 256,
            qk_rope_head_dim = 0,
            v_head_dim = 256,
        ),
        kda = struct(heads = 64, head_dim = 128, f_rank = 128, conv_kernel = 4),
        index_heads = 32,
        index_head_dim = 128,
        index_top_k = 2048,
        index_kpool = 4,
        streams = 4,
        gate_eps = 1e-6,
        alpha = 2.0,
        sinkhorn = 20,
        dense_inter = 12288,
        moe = struct(
            experts = experts,
            top_k = min(8, experts),
            inter = 2048,
            shared_inter = 2048,
            renorm = True,
            scaling = 2.5,
        ),
        swiglu_limit = 10.0,
        theta = 10000.0,
        vocab = 154880,
        norm_eps = 1e-5,
    )

DIMS = {
    "glm53-flash": flash(),
    # The first eight layers at full width with the first 32 routed experts:
    # three dense KDA, DSA + MoE, three KDA + MoE, DSA.
    "glm53-flash-mini": flash(layers = 8, experts = 32),
}

def layout(id, deploy):
    vision = "vision" in deploy.parts
    if deploy.drafter == "mtp":
        if len(deploy.weights) != 3:
            fail("{} with its draft head stores its weights, experts and draft experts at a dtype each, not {}".format(id, deploy.weights))
        weights, experts, draft = deploy.weights
    elif len(deploy.weights) == 1:
        weights = deploy.weights[0]
        experts = weights
        draft = None
    else:
        if len(deploy.weights) != 2:
            fail("{} stores its weights and its experts at a dtype each, not {}".format(id, deploy.weights))
        weights, experts = deploy.weights
        draft = None
    d = DIMS[id]
    dense = compute(weights)
    # The release's FP8 keeps its KDA, kv_b and indexer projections, table
    # and head bf16; mlx stores them at its own width.
    fp8 = weights in [dtype.e4m3tile128, dtype.e4m3tile128a8]
    side = dtype.bf16 if fp8 else weights
    table = dtype.bf16 if weights == dtype.bf16 or fp8 else dtype.u4g64
    hidden = d.hidden
    streams = d.streams
    a = d.mla
    k = d.kda
    index_width = d.index_heads * d.index_head_dim

    def mla_at(prefix, kv, keys):
        n = lambda s: "{}.{}".format(prefix, s)
        return attention(
            n,
            a,
            hidden,
            weights = weights,
            side = side,
            norms = dense,
            eps = d.norm_eps,
            kv = kv,
            indexer = struct(
                heads = d.index_heads,
                head_dim = d.index_head_dim,
                top_k = d.index_top_k,
                kpool = d.index_kpool,
                rope_dim = a.qk_rope_head_dim,
                theta = d.theta,
                wq_b = weight([index_width, a.q_lora_rank], side),
                wk = weight([d.index_head_dim, hidden], side),
                weights_proj = weight([d.index_heads, hidden], side),
                k_norm = weight([d.index_head_dim]),
                k_norm_bias = weight([d.index_head_dim]),
                k_norm_eps = d.norm_eps,
                kpool_ape = weight([d.index_kpool, d.index_head_dim], dtype.f32),
                kpool_gate = weight([d.index_head_dim, hidden]),
                keys = keys,
            ),
        )

    def routed_at(prefix, banks_dtype):
        n = lambda s: "{}.{}".format(prefix, s)
        m = d.moe
        iw = m.inter
        sw = m.shared_inter
        return struct(
            routed = True,
            router = weight([m.experts, hidden]),
            bias = weight([m.experts], dtype.f32),
            gate_up = weight([m.experts, 2 * iw, hidden], banks_dtype).bank([iw, iw]),
            down = weight([m.experts, hidden, iw], banks_dtype).rows(),
            shared = struct(
                gate_up = weight([2 * sw, hidden], weights).packed([sw, sw]),
                down = weight([hidden, sw], weights).rows(),
                inter = sw,
            ),
            experts = m.experts,
            top_k = m.top_k,
            inter = iw,
            limit = d.swiglu_limit,
            renorm = m.renorm,
            scaling = m.scaling,
        )

    def layer(l):
        n = lambda s: "layer.{}.{}".format(l, s)
        norm = lambda s, width: weight([width])
        lora_a, lora_b = banks("layer.{}".format(l), hidden, dense)
        if (l + 1) % d.full_attn_every == 0:
            mixer = mla_at("layer.{}".format(l), "kv.{}".format(l), "index.{}".format(l))
            mixer_kind = "mla"
        else:
            mixer_kind = "kda"
            mixer = kda(
                n,
                l,
                k,
                hidden,
                weights = side,
                conv = dense,
                eps = d.norm_eps,
                gate_floor = -5.0,
                gate_rank = k.f_rank,
            )
        if l < d.dense_layers:
            iw = d.dense_inter
            mlp = struct(
                routed = False,
                gate_up = weight([2 * iw, hidden], weights).packed([iw, iw]),
                down = weight([hidden, iw], weights).rows(),
                inter = iw,
                limit = d.swiglu_limit,
            )
        else:
            mlp = routed_at("layer.{}".format(l), experts)
        return struct(
            attn_mix = mix(n, "attn_hc", streams, hidden),
            mixer_norm = norm("mixer_norm", hidden),
            mixer_norm_eps = d.norm_eps,
            mixer_kind = mixer_kind,
            mixer = mixer,
            mlp_mix = mix(n, "ffn_hc", streams, hidden),
            mlp_norm = norm("mlp_norm", hidden),
            mlp_norm_eps = d.norm_eps,
            mlp = mlp,
            lora_a = lora_a,
            lora_b = lora_b,
        )

    mtp = None
    if draft != None:
        mtp = struct(
            enorm = weight([hidden]),
            hnorm = weight([hidden]),
            e_proj = weight([hidden, hidden], dtype.bf16),
            h_proj = weight([hidden, hidden], dtype.bf16),
            mixer_norm = weight([hidden]),
            mixer_norm_eps = d.norm_eps,
            attn = mla_at("mtp", "kv.mtp", "index.mtp"),
            mlp_norm = weight([hidden]),
            mlp_norm_eps = d.norm_eps,
            mlp = routed_at("mtp", draft),
            norm = weight([hidden]),
            norm_eps = d.norm_eps,
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        act = dense,
        heads = a.heads,
        kv_lora_rank = a.kv_lora_rank,
        kv = deploy.kv,
        hyper = hyper(streams, d.norm_eps, d.gate_eps, d.alpha, d.sinkhorn),
        # mlx stores its table and head at four bits; the release, unquantized.
        embed = weight([d.vocab, hidden], table),
        head = weight([d.vocab, hidden], table),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight([hidden]),
        final_norm_eps = d.norm_eps,
        mtp = mtp,
        tower = tower(d) if vision else None,
    )

PATCH, TEMPORAL, MERGE = 14, 2, 2

def media(id, deploy):
    if "vision" not in deploy.parts:
        return None
    per_token = PATCH * PATCH * MERGE * MERGE
    return struct(image = struct(
        patch = PATCH, block = MERGE, mrope = False,
        prefix = "<|begin_of_image|>", placeholder = "<|image|>", suffix = "<|end_of_image|>",
    ))

def tower(d):
    hidden, heads, depth, inter, merger_inter = 1024, 16, 24, 4096, 10240
    patch, temporal, merge = PATCH, TEMPORAL, MERGE
    out = d.hidden
    head_dim = hidden // heads
    bf = dtype.bf16

    def block(l):
        return struct(
            norm1 = weight([hidden], bf),
            qkv = weight([3 * hidden, hidden], bf).packed([hidden] * 3),
            qkv_bias = weight([3 * hidden], bf).packed([hidden] * 3),
            q_norm = weight([head_dim], bf),
            k_norm = weight([head_dim], bf),
            proj = weight([hidden, hidden], bf),
            proj_bias = weight([hidden], bf),
            norm2 = weight([hidden], bf),
            gate_up = weight([2 * inter, hidden], bf).packed([inter, inter]),
            gate_up_bias = weight([2 * inter], bf).packed([inter, inter]),
            down = weight([hidden, inter], bf),
            down_bias = weight([hidden], bf),
        )

    return struct(
        hidden = hidden,
        heads = heads,
        head_dim = head_dim,
        merge = merge,
        patch = patch,
        temporal = temporal,
        patch_width = 3 * temporal * patch * patch,
        inter = inter,
        merger_inter = merger_inter,
        limit = d.swiglu_limit,
        theta = 10000.0,
        norm_eps = d.norm_eps,
        sm_scale = f32(1.0 / f32(sqrt(head_dim))),
        patch_embed = weight([hidden, 3 * temporal * patch * patch], bf),
        patch_embed_bias = weight([hidden], bf),
        blocks = [block(l) for l in range(depth)],
        post_norm = weight([hidden], bf),
        downsample = weight([out, merge * merge * hidden], bf),
        downsample_bias = weight([out], bf),
        merger = struct(
            proj = weight([out, out], bf),
            norm = weight([out], bf),
            norm_bias = weight([out], bf),
            gate_up = weight([2 * merger_inter, out], bf).packed([merger_inter, merger_inter]),
            down = weight([out, merger_inter], bf),
        ),
    )
