# MiniMax-M2.5 and M2.7 (MiniMaxAI/MiniMax-M2.5, -M2.7): full grouped-query
# attention, its q and k RMS-normed across all their heads, a quarter of each
# head rotated; every layer routed experts picked by a biased sigmoid, no
# shared expert. As released (FP8, 128-square blocks), as NVIDIA's modelopt
# exports them in NVFP4 (attention bf16), and a miniature that reads the
# first layers and experts of the whole model's checkpoint at full width.
# The two releases differ in the identity their template states and the
# context their configuration does.

load("//pie/codec.poem", "kept", "mapped")
load("//lib/blocks.poem", "attention")

def spoken(name):
    return template("minimax2", identity = "You are a helpful assistant. Your name is {} and is built by MiniMax.".format(name))

TOKENIZER = tokenizer(markers = [["[e~["], ["]~!b[", "]~b]", "<think>", "</think>", "<minimax:tool_call>", "</minimax:tool_call>"]])

def minimax(id, layers, name, mini = False):
    return model(id, mini = mini, template = spoken(name), tokenizer = TOKENIZER, arch = "minimax_m2", layers = layers, vocab = 200064)

MODELS = [
    minimax("minimax-m25", layers = 62, name = "MiniMax-M2.5"),
    minimax("minimax-m25-mini", layers = 4, name = "MiniMax-M2.5", mini = True),
    minimax("minimax-m27", layers = 62, name = "MiniMax-M2.7"),
]

BF = dtype.bf16
F8 = dtype.e4m3tile128a8
NV4 = dtype.nvfp4a4
NV4W = dtype.nvfp4

def rows(id):
    """A model's rows: the release's FP8 as released (projections and
    experts against e4m3 activations), and modelopt's NVFP4 (attention bf16,
    the experts against NVFP4 activations, or bf16 ones)."""
    return [
        deployment(id, weights = F8, kv = dtype.e4m3),
        deployment(id, weights = F8, kv = BF),
        deployment(id, weights = [BF, NV4], kv = dtype.e4m3),
        deployment(id, weights = [BF, NV4], kv = BF),
        deployment(id, weights = [BF, NV4W], kv = BF),
    ]

DEPLOYMENTS = rows("minimax-m25") + rows("minimax-m27") + rows("minimax-m25-mini")

# The weights of MiniMax-M2: per layer an RMS norm, the q, k and v
# projections, q's and k's norms across all their heads, the output
# projection, an RMS norm, the router, its score bias and the routed experts'
# gate, up and down banks; the token embedding, a final norm and the head.
# The deployment's first dtype stores the attention's projections, its second
# (or the first) the expert banks; the norms, router, embedding and head stay
# bf16.

def dims(layers, experts, max_position):
    return struct(
        hidden = 3072,
        layers = layers,
        q_heads = 48,
        kv_heads = 8,
        head_dim = 128,
        rotary_dim = 64,
        experts = experts,
        top_k = 8,
        inter = 1536,
        vocab = 200064,
        theta = 5000000.0,
        norm_eps = 1e-6,
        max_position = max_position,
    )

DIMS = {
    "minimax-m25": dims(layers = 62, experts = 256, max_position = 196608),
    "minimax-m25-mini": dims(layers = 4, experts = 16, max_position = 196608),
    "minimax-m27": dims(layers = 62, experts = 256, max_position = 204800),
}

IDENTITIES = {
    "minimax-m2": "You are MiniMax-M2, a helpful AI assistant built by MiniMax. Knowledge cutoff: 2025-06.",
}
NAMES = {
    "minimax-m25": "MiniMax-M2.5",
    "minimax-m27": "MiniMax-M2.7",
    "minimax-m2.1": "MiniMax-M2.1",
    "minimax-m2.5": "MiniMax-M2.5",
    "minimax-m2.7": "MiniMax-M2.7",
}

def adopt(id, config, special):
    if config.get("model_type", "minimax_m2") != "minimax_m2":
        fail("the config's model_type is {}; this family is minimax_m2".format(config.get("model_type")))
    if config.get("hidden_act", "silu") != "silu":
        fail("its experts gate by {}; this family's gate by silu".format(config["hidden_act"]))
    if [t for t in config.get("attn_type_list", []) if t != 1]:
        fail("some of its layers attend linearly (attn_type_list); this family attends in full in every layer")
    if config.get("sliding_window") != None:
        fail("it attends through a sliding window; this family attends in full")
    if config.get("rope_scaling") != None:
        fail("its config scales its rope ({}); this family turns it unscaled".format(config["rope_scaling"]))
    if not config.get("use_qk_norm", True) or config.get("qk_norm_type", "per_layer") != "per_layer":
        fail("it norms q and k {}; this family norms them across all their heads".format(config.get("qk_norm_type", "not at all")))
    if config.get("scoring_func", "sigmoid") != "sigmoid" or not config.get("use_routing_bias", True):
        fail("it routes by {} {} a score bias; this family routes by a biased sigmoid".format(config.get("scoring_func"), "with" if config.get("use_routing_bias", True) else "without"))
    if config.get("shared_intermediate_size", 0) != 0:
        fail("it carries a shared expert, which this family does not")
    if float(config.get("routed_scaling_factor", 1.0)) != 1.0:
        fail("it scales its routed experts by {}; this family by one".format(config["routed_scaling_factor"]))
    if config.get("tie_word_embeddings", False):
        fail("it reads out through its embedding; this family reads a head of its own")
    for key in ["attention_bias", "mlp_bias"]:
        if config.get(key, False):
            fail("its projections carry biases ({}), which this family's do not".format(key))
    hidden = config["hidden_size"]
    q_heads = config["num_attention_heads"]
    head_dim = config.get("head_dim", hidden // q_heads)
    experts = config["num_local_experts"]
    d = struct(
        hidden = hidden,
        layers = config["num_hidden_layers"],
        q_heads = q_heads,
        kv_heads = config.get("num_key_value_heads", q_heads),
        head_dim = head_dim,
        rotary_dim = config.get("rotary_dim", head_dim),
        experts = experts,
        top_k = config["num_experts_per_tok"],
        inter = config["intermediate_size"],
        vocab = config["vocab_size"],
        theta = float(config["rope_theta"]),
        norm_eps = float(config.get("rms_norm_eps", 1e-6)),
        max_position = config["max_position_embeddings"],
    )
    eos = special.get("eos_token", "[e~[")
    if eos != "[e~[":
        fail("its tokenizer ends a turn at {}; this family's template ends it at [e~[".format(eos))
    if id in IDENTITIES:
        spoken_as = template("minimax2", identity = IDENTITIES[id])
    elif id in NAMES:
        spoken_as = spoken(NAMES[id])
    else:
        spoken_as = template("minimax2", identity = "You are a helpful assistant.")
    return struct(
        MODELS = [model(id, template = spoken_as, tokenizer = TOKENIZER, arch = "minimax_m2", layers = d.layers, vocab = d.vocab)],
        DIMS = {id: d},
        DEPLOYMENTS = rows(id),
    )

def layout(id, deploy):
    r = roles(deploy, "proj", "experts")
    proj, experts = r.proj, r.experts
    if deploy.drafter != None or deploy.parts:
        fail("{} ships no drafter and no parts".format(id))
    d = DIMS[id]
    hidden, hd = d.hidden, d.head_dim
    q_width, kv_width = d.q_heads * hd, d.kv_heads * hd

    def layer(l):
        return struct(
            attn_norm = weight([hidden]),
            q = weight([q_width, hidden], proj),
            k = weight([kv_width, hidden], proj),
            v = weight([kv_width, hidden], proj),
            o = weight([hidden, q_width], proj),
            q_norm = weight([q_width]),
            k_norm = weight([kv_width]),
            mlp_norm = weight([hidden]),
            router = weight([d.experts, hidden]),
            bias = weight([d.experts], dtype.f32),
            gate = weight([d.experts, d.inter, hidden], experts),
            up = weight([d.experts, d.inter, hidden], experts),
            down = weight([d.experts, hidden, d.inter], experts),
            kv = "kv.{}".format(l),
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        q_heads = d.q_heads,
        kv_heads = d.kv_heads,
        head_dim = hd,
        rotary_dim = d.rotary_dim,
        q_width = q_width,
        kv_width = kv_width,
        experts = d.experts,
        top_k = d.top_k,
        inter = d.inter,
        theta = d.theta,
        max_position = d.max_position,
        eps = d.norm_eps,
        sm_scale = f32(1.0 / f32(sqrt(hd))),
        kv = deploy.kv,
        embed = weight([d.vocab, hidden]),
        head = weight([d.vocab, hidden]),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight([hidden]),
    )

# How a MiniMax-M2 checkpoint is read: transformers' safetensors under
# `model.`, each expert apart (`w1` gate, `w3` up, `w2` down), as released
# (FP8 e4m3 codes beside 128-square block factors, norms, router and score
# bias unquantized) or as modelopt exports it (attention bf16, experts NVFP4);
# recognized by its routed `block_sparse_moe` and checked against its config.
# The draft modules are not read.

def configured(m):
    return [
        config("hidden_size", m.hidden),
        config("vocab_size", m.vocab),
        config("num_attention_heads", m.q_heads),
        config("num_key_value_heads", m.kv_heads),
        config("head_dim", m.head_dim),
        config("num_hidden_layers", len(m.layers)),
        config("num_local_experts", m.experts),
        config("rotary_dim", m.rotary_dim),
        config("rms_norm_eps", m.eps),
        config("rope_theta", m.theta),
        config("max_position_embeddings", m.max_position),
    ]

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("model.layers.0.block_sparse_moe.e_score_correction_bias"),
        read = lambda reads: read(m, reads),
        states = configured(m),
    )]

TRANSFORMERS = [
    ("model.embed_tokens.weight", "embed"),
    ("model.norm.weight", "final_norm"),
    ("lm_head.weight", "head"),
    ("model.layers.{l}.input_layernorm.weight", "layers.{l}.attn_norm"),
    ("model.layers.{l}.self_attn.q_proj.weight", "layers.{l}.q"),
    ("model.layers.{l}.self_attn.k_proj.weight", "layers.{l}.k"),
    ("model.layers.{l}.self_attn.v_proj.weight", "layers.{l}.v"),
    ("model.layers.{l}.self_attn.o_proj.weight", "layers.{l}.o"),
    ("model.layers.{l}.self_attn.q_norm.weight", "layers.{l}.q_norm"),
    ("model.layers.{l}.self_attn.k_norm.weight", "layers.{l}.k_norm"),
    ("model.layers.{l}.post_attention_layernorm.weight", "layers.{l}.mlp_norm"),
    ("model.layers.{l}.block_sparse_moe.gate.weight", "layers.{l}.router"),
    ("model.layers.{l}.block_sparse_moe.e_score_correction_bias", "layers.{l}.bias"),
    ("model.layers.{l}.block_sparse_moe.experts.{e}.w1.weight", "layers.{l}.gate"),
    ("model.layers.{l}.block_sparse_moe.experts.{e}.w3.weight", "layers.{l}.up"),
    ("model.layers.{l}.block_sparse_moe.experts.{e}.w2.weight", "layers.{l}.down"),
]

def read(m, reads):
    for w in m.layers:
        if not kept(w.gate):
            fail("`{}`: MiniMax-M2 is released FP8 and exported NVFP4; this deployment reads its experts as {}".format(w.gate.name, w.gate.dtype))
    mapped(reads, m, TRANSFORMERS)

# The forward of MiniMax-M2: pre-norm layers of grouped-query attention, q
# and k RMS-normed across all their heads, the first quarter of each head
# rotated (neox halves); then the routed experts a biased sigmoid picks,
# their weights renormalized over the pick.

def caches(m, c):
    kv = c.kv_space(m.kv)
    for w in m.layers:
        c.kv(kv, w.kv, [m.kv_width, m.kv_width], m.head_dim, heads = True)

def forward(m, inputs):
    positions = inputs.positions()
    y = ops.gather.embed(inputs.tokens(), m.embed, m.vocab)

    def block(l, w, y):
        x = ops.elemwise.rmsnorm(y, w.attn_norm, m.eps)
        o = attention(x, inputs, m, w, positions, rotary_dim = m.rotary_dim, qk_norm = "width")
        y = ops.elemwise.residual_add(o, y)
        x = ops.elemwise.rmsnorm(y, w.mlp_norm, m.eps)
        return ops.elemwise.residual_add(moe(x, m, w), y)

    y = inputs.fold_layers(m.layers, y, block)
    x = ops.elemwise.rmsnorm(y, m.final_norm, m.eps)
    x = ops.gather.gather_rows(x, inputs.readout_rows())
    output("logits", ops.linear.lm_head(x, m.head))

def moe(x, m, w):
    routes, weights = ops.linear.moe_route(
        ops.linear.matmul(x, w.router),
        m.experts,
        m.top_k,
        routing.sigmoid(renormalize = True, scaling = 1.0),
        bias = w.bias,
    )

    gate = ops.linear.moe_matmul_select(x, w.gate, routes, m.top_k)
    act = ops.linear.glu(gate, gating.swiglu(), up = ops.linear.moe_matmul_select(x, w.up, routes, m.top_k))
    return ops.linear.moe_weighted_sum(ops.linear.moe_matmul_select(act, w.down, routes, m.top_k), weights)
