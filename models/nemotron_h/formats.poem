# How a Nemotron-3 checkpoint is laid out: transformers' names under
# `backbone.`. Super as modelopt's mixed-precision export stores it: routed
# experts NVFP4 an expert a tensor, the projections it quantized e4m3 under
# one scale, one shared expert's down projection NVFP4 (widened here), the
# rest bf16. Ultra's release: every plane bf16, an expert a tensor.

load("//pie/codec.poem", "weight", released = "bank")

BF = raw(dtype.bf16)

def formats(m):
    return [format(
        "transformers",
        recognizes = lambda checkpoint: has("backbone.embeddings.weight"),
        read = lambda reads: read(m, reads),
        states = [
            config("hidden_size", m.hidden),
            config("num_hidden_layers", len(m.layers)),
            config("n_routed_experts", m.experts),
            config("mamba_num_heads", m.mamba_heads),
        ],
    )]

def bank(reads, w, stems):
    """A routed bank: NVFP4 legs as the export stores them, or bf16 planes
    stacked on the leading axis."""
    if w.dtype != dtype.bf16:
        released(reads, w, [[s + ".weight"] for s in stems])
        return
    dims = list(w.shape)
    # A bank cut across ranks reads its rank's share; a whole one, every row.
    if w.cut_axis != None:
        dims[w.cut_axis] = -1
    reads.read_expr(w, concat(0, [src(s + ".weight") for s in stems]).transmute(dims, BF))

def read(m, reads):
    reads.read(m.embed, "backbone.embeddings.weight")
    reads.read(m.final_norm, "backbone.norm_f.weight")
    reads.read(m.head, "lm_head.weight")
    for l, w in enumerate(m.layers):
        at = lambda s: "backbone.layers.{}.{}".format(l, s)
        mixer = lambda s: at("mixer." + s)
        reads.read(w.norm, at("norm.weight"))
        if w.mamba != None:
            k = w.mamba
            weight(reads, k.in_proj, mixer("in_proj.weight"), quantized = "widen")
            reads.push(tensor(k.conv.name, src(mixer("conv1d.weight")).transmute([m.conv_dim, m.conv_kernel], BF), BF))
            reads.read(k.conv_bias, mixer("conv1d.bias"))
            reads.read(k.a_log, mixer("A_log"))
            reads.read(k.dt_bias, mixer("dt_bias"))
            reads.read(k.d, mixer("D"))
            reads.read(k.norm, mixer("norm.weight"))
            weight(reads, k.out_proj, mixer("out_proj.weight"), quantized = "widen")
        elif w.attn != None:
            a = w.attn
            reads.read(a.q, mixer("q_proj.weight"))
            reads.read(a.k, mixer("k_proj.weight"))
            reads.read(a.v, mixer("v_proj.weight"))
            weight(reads, a.o, mixer("o_proj.weight"), quantized = "widen")
        else:
            f = w.moe
            reads.read(f.router, mixer("gate.weight"))
            reads.read(f.bias, mixer("gate.e_score_correction_bias"))
            if f.down_latent != None:
                weight(reads, f.down_latent, mixer("fc1_latent_proj.weight"), quantized = "widen")
                weight(reads, f.up_latent, mixer("fc2_latent_proj.weight"), quantized = "widen")
            expert = lambda e, leaf: mixer("experts.{}.{}".format(e, leaf))
            bank(reads, f.up, [expert(e, "up_proj") for e in range(m.experts)])
            bank(reads, f.down, [expert(e, "down_proj") for e in range(m.experts)])
            weight(reads, f.shared_up, mixer("shared_experts.up_proj.weight"), quantized = "widen")
            weight(reads, f.shared_down, mixer("shared_experts.down_proj.weight"), quantized = "widen")
