# The weights of Nemotron-3 Super, Ultra and Nano: per layer an RMS norm and
# one mixer, a Mamba-2 (`M`), a NoPE GQA attention (`*`) or an MoE (`E`) of
# relu2 experts beside a relu2 shared expert (Super's and Ultra's reading the
# residual squeezed to a latent width, Nano's reading it whole); the token
# embedding, a final norm and the head.

# Super's `hybrid_override_pattern`; Ultra's `layers_block_type`, one letter a layer.
SUPER = "MEMEMEM*EMEMEMEM*EMEMEMEM*EMEMEMEMEM*EMEMEMEMEM*EMEMEMEMEM*EMEMEMEMEM*EMEMEMEM*EMEMEMEME"
ULTRA = "MEMEMEM*EMEMEM*EMEMEMEM*EMEMEMEM*EMEMEM*EMEMEMEM*EMEMEMEM*EMEMEM*EMEMEMEM*EMEMEMEM*EMEMEM*EMEMEMEM*EMEMEMEME"

NANO_PATTERN = "MEMEM*EMEMEM*EMEMEM*EMEMEM*EMEMEM*EMEMEMEM*EMEMEMEME"

def nano(layers, experts, pattern = NANO_PATTERN):
    return struct(
        pattern = pattern,
        layers = layers,
        hidden = 2688,
        vocab = 131072,
        heads = 32,
        kv_heads = 2,
        head_dim = 128,
        mamba_heads = 64,
        mamba_head_dim = 64,
        groups = 8,
        state_dim = 128,
        conv_kernel = 4,
        experts = experts,
        top_k = 6,
        latent = None,
        moe_inter = 1856,
        shared_inter = 3712,
        scaling = 2.5,
        eps = 1e-5,
    )

def dims(layers, pattern = SUPER, wide = 1):
    """Super's widths, or Ultra's (`wide = 2`): twice the residual, heads,
    Mamba heads, latent and expert widths, the same experts and fan-out."""
    return struct(
        layers = layers,
        pattern = pattern,
        hidden = 4096 * wide,
        vocab = 131072,
        heads = 32 * wide,
        kv_heads = 2,
        head_dim = 128,
        mamba_heads = 128 * wide,
        mamba_head_dim = 64,
        groups = 8,
        state_dim = 128,
        conv_kernel = 4,
        experts = 512,
        top_k = 22,
        latent = 1024 * wide,
        moe_inter = 2688 if wide == 1 else 5120,
        shared_inter = 5376 if wide == 1 else 10240,
        scaling = 5.0,
        eps = 1e-5,
    )

DIMS = {
    "nemotron3-super": dims(88),
    "nemotron3-super-mini": dims(9),
    "nemotron3-ultra": dims(108, ULTRA, 2),
    "nemotron3-nano": nano(52, 128),
    # Its first six layers: every mixer kind, the attention last.
    "nemotron3-nano-mini": nano(6, 16),
}

# The release's own precision a projection, as modelopt chose it layer by
# layer: the layers each projection is kept bf16 at where most are FP8, or
# FP8 at where most are bf16; and the one shared expert stored NVFP4, read
# here as bf16.
BF16_AT = {
    "in_proj": [22, 24, 33, 35, 38, 42, 44, 46, 64, 75, 77, 80],
    "out_proj": [6, 15, 20, 22, 24, 27, 29, 31, 33, 35, 46],
    "shared_up": [41],
    "shared_down": [1, 8, 76],
}
FP8_AT = {
    "fc1_latent": [1, 3, 5],
    "fc2_latent": [3],
    "o_proj": [69, 78],
}

def layout(id, deploy):
    if DIMS[id].latent == None:
        return nano_layout(id, deploy)
    d = DIMS[id]
    if deploy.drafter != None or deploy.parts:
        fail("{} has no draft head or parts here; not {}".format(id, deploy))
    plain = deploy.weights == [dtype.bf16]
    if d.pattern == ULTRA and not plain:
        fail("{} ships as released: every weight bf16; not {}".format(id, deploy))
    if d.pattern == SUPER and deploy.weights != [dtype.bf16, dtype.nvfp4a4, dtype.e4m3tile128a8]:
        fail("{} ships as released: bf16, NVFP4 experts against NVFP4 activations and its FP8 projections; not {}".format(id, deploy))
    w, experts, f8 = (dtype.bf16, dtype.bf16, dtype.bf16) if plain else deploy.weights
    norms = compute(w)
    hidden = d.hidden
    inner = d.mamba_heads * d.mamba_head_dim
    conv_dim = inner + 2 * d.groups * d.state_dim

    def proj(name, kind, l, shape):
        kept = plain or (l in BF16_AT[kind] if kind in BF16_AT else l not in FP8_AT[kind])
        return weight(name, shape, w if kept else f8)

    def mamba(l):
        n = lambda s: "layer.{}.{}".format(l, s)
        return struct(
            in_proj = proj(n("in_proj"), "in_proj", l, [inner + conv_dim + d.mamba_heads, hidden]),
            conv = weight(n("conv"), [conv_dim, d.conv_kernel], w),
            conv_bias = weight(n("conv_bias"), [conv_dim], w),
            a_log = weight(n("a_log"), [d.mamba_heads], dtype.f32),
            dt_bias = weight(n("dt_bias"), [d.mamba_heads], dtype.f32),
            d = weight(n("d"), [d.mamba_heads], dtype.f32),
            norm = weight(n("ssm_norm"), [inner], norms),
            out_proj = proj(n("out_proj"), "out_proj", l, [hidden, inner]),
            conv_state = "conv.{}".format(l),
            ssm_state = "ssm.{}".format(l),
        )

    def attention(l):
        n = lambda s: "layer.{}.{}".format(l, s)
        hd = d.head_dim
        return struct(
            q = weight(n("q"), [d.heads * hd, hidden], w),
            k = weight(n("k"), [d.kv_heads * hd, hidden], w),
            v = weight(n("v"), [d.kv_heads * hd, hidden], w),
            o = proj(n("o"), "o_proj", l, [hidden, d.heads * hd]),
            kv = "kv.{}".format(l),
        )

    def moe(l):
        n = lambda s: "layer.{}.{}".format(l, s)
        return struct(
            router = weight(n("router"), [d.experts, hidden], w),
            bias = weight(n("router_bias"), [d.experts], dtype.f32),
            down_latent = proj(n("fc1_latent"), "fc1_latent", l, [d.latent, hidden]),
            up_latent = proj(n("fc2_latent"), "fc2_latent", l, [hidden, d.latent]),
            up = weight(n("experts_up"), [d.experts, d.moe_inter, d.latent], experts),
            down = weight(n("experts_down"), [d.experts, d.latent, d.moe_inter], experts),
            shared_up = proj(n("shared_up"), "shared_up", l, [d.shared_inter, hidden]),
            shared_down = proj(n("shared_down"), "shared_down", l, [hidden, d.shared_inter]),
        )

    def layer(l):
        kind = d.pattern[l]
        return struct(
            kind = kind,
            norm = weight("layer.{}.norm".format(l), [hidden], norms),
            mamba = mamba(l) if kind == "M" else None,
            attn = attention(l) if kind == "*" else None,
            moe = moe(l) if kind == "E" else None,
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        heads = d.heads,
        kv_heads = d.kv_heads,
        head_dim = d.head_dim,
        sm_scale = f32(1.0 / f32(sqrt(d.head_dim))),
        mamba_heads = d.mamba_heads,
        mamba_head_dim = d.mamba_head_dim,
        groups = d.groups,
        state_dim = d.state_dim,
        conv_kernel = d.conv_kernel,
        inner = inner,
        conv_dim = conv_dim,
        experts = d.experts,
        top_k = d.top_k,
        scaling = d.scaling,
        eps = d.eps,
        kv = deploy.kv,
        embed = weight("embed", [d.vocab, hidden], w),
        head = weight("lm_head", [d.vocab, hidden], w),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight("final_norm", [hidden], norms),
    )

def nano_layout(id, deploy):
    """Nemotron-3 Nano: experts on the residual itself. Its modelopt exports
    (NVFP4) keep every attention and the Mamba-2 ahead of it bf16; the
    deployment's first dtype stores the other projections and the shared
    expert, its second (or the first) the routed experts."""
    ws = deploy.weights
    if deploy.drafter != None or deploy.parts or len(ws) not in [1, 2]:
        fail("{} stores its weights at one dtype, or its projections and experts at a dtype each; not {}".format(id, deploy))
    proj = ws[0]
    experts = ws[-1]
    d = DIMS[id]
    norms = compute(dtype.bf16)
    hidden = d.hidden
    inner = d.mamba_heads * d.mamba_head_dim
    conv_dim = inner + 2 * d.groups * d.state_dim
    pattern = d.pattern
    kept = lambda l: pattern[l] == "*" or (l + 1 < len(pattern) and pattern[l + 1] == "*")
    at = lambda l: dtype.bf16 if kept(l) else proj

    def layer(l):
        n = lambda s: "layer.{}.{}".format(l, s)
        kind = pattern[l]
        mamba = None
        attn = None
        moe = None
        if kind == "M":
            mamba = struct(
                in_proj = weight(n("in_proj"), [inner + conv_dim + d.mamba_heads, hidden], at(l)),
                conv = weight(n("conv"), [conv_dim, d.conv_kernel], norms),
                conv_bias = weight(n("conv_bias"), [conv_dim], norms),
                a_log = weight(n("a_log"), [d.mamba_heads], dtype.f32),
                dt_bias = weight(n("dt_bias"), [d.mamba_heads], dtype.f32),
                d = weight(n("d"), [d.mamba_heads], dtype.f32),
                norm = weight(n("ssm_norm"), [inner], norms),
                out_proj = weight(n("out_proj"), [hidden, inner], at(l)),
                conv_state = "conv.{}".format(l),
                ssm_state = "ssm.{}".format(l),
            )
        elif kind == "*":
            hd = d.head_dim
            attn = struct(
                q = weight(n("q"), [d.heads * hd, hidden], dtype.bf16),
                k = weight(n("k"), [d.kv_heads * hd, hidden], dtype.bf16),
                v = weight(n("v"), [d.kv_heads * hd, hidden], dtype.bf16),
                o = weight(n("o"), [hidden, d.heads * hd], dtype.bf16),
                kv = "kv.{}".format(l),
            )
        else:
            moe = struct(
                router = weight(n("router"), [d.experts, hidden], norms),
                bias = weight(n("router_bias"), [d.experts], dtype.f32),
                down_latent = None,
                up_latent = None,
                up = weight(n("experts_up"), [d.experts, d.moe_inter, hidden], experts),
                down = weight(n("experts_down"), [d.experts, hidden, d.moe_inter], experts),
                shared_up = weight(n("shared_up"), [d.shared_inter, hidden], proj),
                shared_down = weight(n("shared_down"), [hidden, d.shared_inter], proj),
            )
        return struct(
            kind = kind,
            norm = weight(n("norm"), [hidden], norms),
            mamba = mamba,
            attn = attn,
            moe = moe,
        )

    return struct(
        hidden = hidden,
        vocab = d.vocab,
        heads = d.heads,
        kv_heads = d.kv_heads,
        head_dim = d.head_dim,
        sm_scale = f32(1.0 / f32(sqrt(d.head_dim))),
        mamba_heads = d.mamba_heads,
        mamba_head_dim = d.mamba_head_dim,
        groups = d.groups,
        state_dim = d.state_dim,
        conv_kernel = d.conv_kernel,
        inner = inner,
        conv_dim = conv_dim,
        experts = d.experts,
        top_k = d.top_k,
        scaling = d.scaling,
        eps = d.eps,
        kv = deploy.kv,
        embed = weight("embed", [d.vocab, hidden], norms),
        head = weight("lm_head", [d.vocab, hidden], norms),
        layers = [layer(l) for l in range(d.layers)],
        final_norm = weight("final_norm", [hidden], norms),
    )
