 #include <algorithm>
 #include <array>
+#include <atomic>
 #include <cstddef>
 #include <cstdint>
 #include <cstdio>
@@ -2330,6 +2331,547 @@ inline GroupedLaunchResult run_generated_stage(
         }
         ++result.body_op_launches;
     }
+    // ===================================================================
+    // [stage6-spike] EXPERIMENTAL THROWAWAY PROBE — default off.
+    // Go/no-go spike for stage6-plan.md increment 1: can a PTIR fused-stage
+    // region launch, with its host-built metadata frozen and its buffers at
+    // stable addresses, be captured into a CUDA graph and replayed with
+    // byte-identical effects to eager execution?
+    //
+    // Enabled with PIE_STAGE6_SPIKE=1. Fires ONCE per process, on the first
+    // ON_ATTN stage whose executed regions are all generated
+    // (NVRTC-compiled, cuLaunchKernel-launched) kernels. It runs strictly
+    // AFTER the fire's own launches (a dedicated extra invocation of the
+    // same logical fire), snapshots every byte the region kernels can
+    // write, and restores that state before returning, so the live fire's
+    // results are unperturbed. Not production code; delete with the spike.
+    // ===================================================================
+    if (std::getenv("PIE_STAGE6_SPIKE") != nullptr &&
+        stage.stage == PTIR_STAGE_ON_ATTN) {
+        static std::atomic<bool> s6_claimed{false};
+        bool s6_all_generated = true;
+        std::vector<const FusedRegionExecutable*> s6_regions;
+        for (std::size_t region_index = 0;
+             region_index < stage.fused.regions.size();
+             ++region_index) {
+            const auto& planned = stage.fused.regions[region_index];
+            if (planned.library) {
+                s6_all_generated = false;
+                break;
+            }
+            if (planned.nodes.size() == 1 &&
+                absorbed_scale_nodes[planned.nodes[0]] != 0) {
+                continue;
+            }
+            s6_regions.push_back(executable.regions[region_index].get());
+        }
+        if (!s6_all_generated || s6_regions.empty()) {
+            static std::atomic<int> s6_skips{0};
+            if (s6_skips.fetch_add(1) < 4) {
+                std::fprintf(
+                    stderr,
+                    "[stage6-spike] skip: ON_ATTN stage is not all-generated "
+                    "(regions=%zu all_generated=%d launched=%zu)\n",
+                    stage.fused.regions.size(),
+                    s6_all_generated ? 1 : 0,
+                    s6_regions.size());
+            }
+        } else if (!s6_claimed.exchange(true)) {
+            [&]() {
+                auto fail = [](const char* api, cudaError_t status) {
+                    std::fprintf(
+                        stderr,
+                        "[stage6-spike] ABORT: %s failed: %s (%d)\n",
+                        api, cudaGetErrorString(status),
+                        static_cast<int>(status));
+                };
+                // The fire's own launches must be complete before the probe
+                // reads or rewrites anything they touched.
+                cudaError_t status = cudaStreamSynchronize(stream);
+                if (status != cudaSuccess) {
+                    fail("cudaStreamSynchronize(fire)", status);
+                    return;
+                }
+                // --- The write set of the region kernels ---------------
+                // scratch (value slots + per-lane temporary), the
+                // pending_cell of every CHAN_PUT channel per lane, the
+                // pending_flags array inside device metadata, and (on the
+                // kernel's failure path only) the lane commit words.
+                struct S6Cell {
+                    std::uint8_t* pointer;
+                    std::size_t bytes;
+                };
+                std::vector<S6Cell> s6_cells;
+                for (std::size_t node = 0; node < stage.ops.size(); ++node) {
+                    const auto& op = stage.ops[node].op;
+                    if (op.tag != PTIR_OP_CHAN_PUT) continue;
+                    const auto local = static_cast<std::uint32_t>(op.chan);
+                    for (std::uint32_t lane = 0; lane < lane_count; ++lane) {
+                        const auto& channel = host_channels[
+                            static_cast<std::size_t>(lane) * channel_count +
+                            local];
+                        auto* pointer = reinterpret_cast<std::uint8_t*>(
+                            channel.pending_cell);
+                        const std::size_t bytes =
+                            grouped_channel_bytes(lanes[lane], local);
+                        if (pointer == nullptr || bytes == 0) continue;
+                        bool seen = false;
+                        for (const auto& cell : s6_cells) {
+                            seen = seen || cell.pointer == pointer;
+                        }
+                        if (!seen) s6_cells.push_back({pointer, bytes});
+                    }
+                }
+                std::vector<std::uint32_t*> s6_commits;
+                for (std::uint32_t lane = 0; lane < lane_count; ++lane) {
+                    auto* pointer = reinterpret_cast<std::uint32_t*>(
+                        host_lanes[lane].commit_slot);
+                    if (pointer == nullptr) continue;
+                    bool seen = false;
+                    for (auto* known : s6_commits) {
+                        seen = seen || known == pointer;
+                    }
+                    if (!seen) s6_commits.push_back(pointer);
+                }
+                std::fprintf(
+                    stderr,
+                    "[stage6-spike] armed: ON_ATTN lanes=%u regions=%zu "
+                    "metadata=%zuB scratch=%zuB put_cells=%zu commits=%zu\n",
+                    lane_count, s6_regions.size(), metadata_bytes,
+                    total_scratch_bytes, s6_cells.size(), s6_commits.size());
+                // --- Snapshot the fire's post-run state (for restore) --
+                std::vector<std::uint8_t> fire_scratch(total_scratch_bytes);
+                std::vector<std::uint8_t> fire_metadata(metadata_bytes);
+                std::vector<std::vector<std::uint8_t>> fire_cells;
+                std::vector<std::uint32_t> fire_commits(s6_commits.size());
+                status = cudaMemcpy(
+                    fire_scratch.data(), device_scratch,
+                    total_scratch_bytes, cudaMemcpyDeviceToHost);
+                if (status == cudaSuccess) {
+                    status = cudaMemcpy(
+                        fire_metadata.data(), device_metadata,
+                        metadata_bytes, cudaMemcpyDeviceToHost);
+                }
+                for (const auto& cell : s6_cells) {
+                    if (status != cudaSuccess) break;
+                    fire_cells.emplace_back(cell.bytes);
+                    status = cudaMemcpy(
+                        fire_cells.back().data(), cell.pointer,
+                        cell.bytes, cudaMemcpyDeviceToHost);
+                }
+                for (std::size_t index = 0;
+                     index < s6_commits.size() && status == cudaSuccess;
+                     ++index) {
+                    status = cudaMemcpy(
+                        &fire_commits[index], s6_commits[index],
+                        sizeof(std::uint32_t), cudaMemcpyDeviceToHost);
+                }
+                if (status != cudaSuccess) {
+                    fail("cudaMemcpy(snapshot)", status);
+                    return;
+                }
+                // --- Probe machinery ----------------------------------
+                // The exact argument block the eager loop just used, frozen.
+                CUdeviceptr p_header =
+                    reinterpret_cast<CUdeviceptr>(device_header);
+                CUdeviceptr p_lanes =
+                    reinterpret_cast<CUdeviceptr>(device_lanes);
+                CUdeviceptr p_channels =
+                    reinterpret_cast<CUdeviceptr>(device_channels);
+                CUdeviceptr p_descriptors =
+                    reinterpret_cast<CUdeviceptr>(device_descriptors);
+                CUdeviceptr p_params =
+                    reinterpret_cast<CUdeviceptr>(device_params);
+                CUdeviceptr p_offsets =
+                    reinterpret_cast<CUdeviceptr>(device_offsets);
+                CUdeviceptr p_scratch =
+                    reinterpret_cast<CUdeviceptr>(device_scratch);
+                CUdeviceptr p_pending =
+                    reinterpret_cast<CUdeviceptr>(device_pending);
+                CUdeviceptr p_intrinsic_bases =
+                    reinterpret_cast<CUdeviceptr>(device_intrinsic_bases);
+                CUdeviceptr p_intrinsic_modes =
+                    reinterpret_cast<CUdeviceptr>(device_intrinsic_modes);
+                CUdeviceptr p_intrinsic_widths =
+                    reinterpret_cast<CUdeviceptr>(device_intrinsic_widths);
+                CUdeviceptr p_intrinsic_strides =
+                    reinterpret_cast<CUdeviceptr>(device_intrinsic_strides);
+                CUdeviceptr p_intrinsic_offsets =
+                    reinterpret_cast<CUdeviceptr>(device_intrinsic_offsets);
+                std::uint32_t p_value_count = mutable_value_count;
+                std::uint32_t p_scratch_stride = mutable_scratch_stride;
+                std::uint32_t p_temporary_offset = mutable_temporary_offset;
+                void* s6_arguments[] = {
+                    &p_header,
+                    &p_lanes,
+                    &p_channels,
+                    &p_descriptors,
+                    &p_params,
+                    &p_offsets,
+                    &p_scratch,
+                    &p_value_count,
+                    &p_scratch_stride,
+                    &p_temporary_offset,
+                    &p_pending,
+                    &p_intrinsic_bases,
+                    &p_intrinsic_modes,
+                    &p_intrinsic_widths,
+                    &p_intrinsic_strides,
+                    &p_intrinsic_offsets,
+                };
+                auto relaunch = [&](cudaStream_t target,
+                                    CUresult* launch_status,
+                                    int* failed_index) {
+                    for (std::size_t index = 0;
+                         index < s6_regions.size();
+                         ++index) {
+                        const CUresult result_code = cuLaunchKernel(
+                            s6_regions[index]->function,
+                            lane_count, 1, 1,
+                            static_cast<unsigned>(
+                                s6_regions[index]->block_threads), 1, 1,
+                            0,
+                            target,
+                            s6_arguments,
+                            nullptr);
+                        if (result_code != CUDA_SUCCESS) {
+                            *launch_status = result_code;
+                            *failed_index = static_cast<int>(index);
+                            return false;
+                        }
+                    }
+                    return true;
+                };
+                // Reset device state to the exact bytes the fire uploaded
+                // (the pinned image is still intact for this invocation),
+                // sentinel every output byte so a run that writes nothing
+                // is visible, then sync. Never used inside capture.
+                auto reset_inputs = [&](cudaStream_t target) {
+                    cudaError_t reset_status = cudaMemcpyAsync(
+                        device_metadata, host_metadata, metadata_bytes,
+                        cudaMemcpyHostToDevice, target);
+                    if (reset_status == cudaSuccess) {
+                        reset_status = cudaMemsetAsync(
+                            device_scratch, 0xAB, total_scratch_bytes,
+                            target);
+                    }
+                    for (const auto& cell : s6_cells) {
+                        if (reset_status != cudaSuccess) break;
+                        reset_status = cudaMemsetAsync(
+                            cell.pointer, 0xAB, cell.bytes, target);
+                    }
+                    if (reset_status == cudaSuccess) {
+                        reset_status = cudaStreamSynchronize(target);
+                    }
+                    return reset_status;
+                };
+                struct S6Run {
+                    std::vector<std::uint8_t> scratch;
+                    std::vector<std::vector<std::uint8_t>> cells;
+                };
+                auto collect = [&](S6Run& run) {
+                    run.scratch.resize(total_scratch_bytes);
+                    cudaError_t collect_status = cudaMemcpy(
+                        run.scratch.data(), device_scratch,
+                        total_scratch_bytes, cudaMemcpyDeviceToHost);
+                    run.cells.clear();
+                    for (const auto& cell : s6_cells) {
+                        if (collect_status != cudaSuccess) break;
+                        run.cells.emplace_back(cell.bytes);
+                        collect_status = cudaMemcpy(
+                            run.cells.back().data(), cell.pointer,
+                            cell.bytes, cudaMemcpyDeviceToHost);
+                    }
+                    return collect_status;
+                };
+                auto diff_bytes = [](const std::vector<std::uint8_t>& a,
+                                     const std::vector<std::uint8_t>& b) {
+                    std::size_t mismatches = 0;
+                    const std::size_t bytes = std::min(a.size(), b.size());
+                    for (std::size_t index = 0; index < bytes; ++index) {
+                        if (a[index] != b[index]) ++mismatches;
+                    }
+                    return mismatches +
+                        (a.size() > bytes ? a.size() - bytes : 0) +
+                        (b.size() > bytes ? b.size() - bytes : 0);
+                };
+                // Value-slot area only: per lane, [0, temporary_offset) of
+                // its stride — excludes the per-lane temporary workspace,
+                // whose bytes are scratch, not stage outputs.
+                auto diff_values = [&](const std::vector<std::uint8_t>& a,
+                                       const std::vector<std::uint8_t>& b) {
+                    std::size_t mismatches = 0;
+                    for (std::uint32_t lane = 0; lane < lane_count; ++lane) {
+                        const std::size_t base =
+                            static_cast<std::size_t>(lane) *
+                            mutable_scratch_stride;
+                        for (std::size_t index = 0;
+                             index < mutable_temporary_offset;
+                             ++index) {
+                            if (a[base + index] != b[base + index]) {
+                                ++mismatches;
+                            }
+                        }
+                    }
+                    return mismatches;
+                };
+                auto diff_cells = [&](const S6Run& a, const S6Run& b,
+                                      std::size_t* total) {
+                    std::size_t mismatches = 0;
+                    *total = 0;
+                    for (std::size_t index = 0;
+                         index < a.cells.size() && index < b.cells.size();
+                         ++index) {
+                        *total += a.cells[index].size();
+                        mismatches +=
+                            diff_bytes(a.cells[index], b.cells[index]);
+                    }
+                    return mismatches;
+                };
+                // Restore before ANY exit past this point.
+                auto restore = [&]() {
+                    cudaError_t restore_status = cudaMemcpy(
+                        device_metadata, fire_metadata.data(),
+                        metadata_bytes, cudaMemcpyHostToDevice);
+                    if (restore_status == cudaSuccess) {
+                        restore_status = cudaMemcpy(
+                            device_scratch, fire_scratch.data(),
+                            total_scratch_bytes, cudaMemcpyHostToDevice);
+                    }
+                    for (std::size_t index = 0;
+                         index < s6_cells.size() &&
+                             restore_status == cudaSuccess;
+                         ++index) {
+                        restore_status = cudaMemcpy(
+                            s6_cells[index].pointer,
+                            fire_cells[index].data(),
+                            s6_cells[index].bytes,
+                            cudaMemcpyHostToDevice);
+                    }
+                    for (std::size_t index = 0;
+                         index < s6_commits.size() &&
+                             restore_status == cudaSuccess;
+                         ++index) {
+                        restore_status = cudaMemcpy(
+                            s6_commits[index], &fire_commits[index],
+                            sizeof(std::uint32_t), cudaMemcpyHostToDevice);
+                    }
+                    if (restore_status != cudaSuccess) {
+                        std::fprintf(
+                            stderr,
+                            "[stage6-spike] WARNING: state restore failed: "
+                            "%s\n",
+                            cudaGetErrorString(restore_status));
+                    } else {
+                        std::fprintf(
+                            stderr,
+                            "[stage6-spike] fire state restored; probe "
+                            "complete\n");
+                    }
+                };
+                // --- 1. Eager baseline: re-issue JUST the region
+                //        launches with the frozen arguments -------------
+                status = reset_inputs(stream);
+                if (status != cudaSuccess) {
+                    fail("reset(eager)", status);
+                    restore();
+                    return;
+                }
+                CUresult launch_status = CUDA_SUCCESS;
+                int failed_index = -1;
+                if (!relaunch(stream, &launch_status, &failed_index)) {
+                    const char* message = nullptr;
+                    cuGetErrorString(launch_status, &message);
+                    std::fprintf(
+                        stderr,
+                        "[stage6-spike] ABORT: eager cuLaunchKernel "
+                        "region=%d failed: %s\n",
+                        failed_index,
+                        message == nullptr ? "unknown" : message);
+                    restore();
+                    return;
+                }
+                status = cudaStreamSynchronize(stream);
+                if (status != cudaSuccess) {
+                    fail("cudaStreamSynchronize(eager)", status);
+                    restore();
+                    return;
+                }
+                S6Run eager;
+                status = collect(eager);
+                if (status != cudaSuccess) {
+                    fail("collect(eager)", status);
+                    restore();
+                    return;
+                }
+                {
+                    // Determinism of the eager re-issue against the live
+                    // fire's own results (same frozen inputs).
+                    const std::size_t scratch_mismatch =
+                        diff_bytes(eager.scratch, fire_scratch);
+                    const std::size_t value_mismatch =
+                        diff_values(eager.scratch, fire_scratch);
+                    S6Run fire_view;
+                    fire_view.scratch = fire_scratch;
+                    fire_view.cells = fire_cells;
+                    std::size_t cell_total = 0;
+                    const std::size_t cell_mismatch =
+                        diff_cells(eager, fire_view, &cell_total);
+                    std::fprintf(
+                        stderr,
+                        "[stage6-spike] eager-reissue vs live fire: "
+                        "scratch %zu/%zu value-slots %zu cells %zu/%zu "
+                        "mismatched bytes\n",
+                        scratch_mismatch, eager.scratch.size(),
+                        value_mismatch, cell_mismatch, cell_total);
+                }
+                // --- 2. Capture the same launches into a graph --------
+                cudaStream_t probe = nullptr;
+                status = cudaStreamCreateWithFlags(
+                    &probe, cudaStreamNonBlocking);
+                if (status != cudaSuccess) {
+                    fail("cudaStreamCreateWithFlags", status);
+                    restore();
+                    return;
+                }
+                cudaGraph_t graph = nullptr;
+                cudaGraphExec_t graph_exec = nullptr;
+                auto teardown = [&]() {
+                    if (graph_exec != nullptr) {
+                        cudaGraphExecDestroy(graph_exec);
+                    }
+                    if (graph != nullptr) cudaGraphDestroy(graph);
+                    cudaStreamDestroy(probe);
+                };
+                status = cudaStreamBeginCapture(
+                    probe, cudaStreamCaptureModeRelaxed);
+                if (status != cudaSuccess) {
+                    std::fprintf(
+                        stderr,
+                        "[stage6-spike] VERDICT: NO-GO at "
+                        "cudaStreamBeginCapture: %s (%d)\n",
+                        cudaGetErrorString(status),
+                        static_cast<int>(status));
+                    teardown();
+                    restore();
+                    return;
+                }
+                const bool captured_all =
+                    relaunch(probe, &launch_status, &failed_index);
+                status = cudaStreamEndCapture(probe, &graph);
+                if (!captured_all) {
+                    const char* message = nullptr;
+                    cuGetErrorString(launch_status, &message);
+                    std::fprintf(
+                        stderr,
+                        "[stage6-spike] VERDICT: NO-GO at cuLaunchKernel "
+                        "under capture, region=%d: %s (%d)\n",
+                        failed_index,
+                        message == nullptr ? "unknown" : message,
+                        static_cast<int>(launch_status));
+                    teardown();
+                    restore();
+                    return;
+                }
+                if (status != cudaSuccess || graph == nullptr) {
+                    std::fprintf(
+                        stderr,
+                        "[stage6-spike] VERDICT: NO-GO at "
+                        "cudaStreamEndCapture: %s (%d)\n",
+                        cudaGetErrorString(status),
+                        static_cast<int>(status));
+                    teardown();
+                    restore();
+                    return;
+                }
+                std::size_t node_count = 0;
+                cudaGraphGetNodes(graph, nullptr, &node_count);
+                std::fprintf(
+                    stderr,
+                    "[stage6-spike] capture OK: %zu region launches -> "
+                    "%zu graph nodes (mode=relaxed, probe stream)\n",
+                    s6_regions.size(), node_count);
+                status = cudaGraphInstantiate(&graph_exec, graph, 0);
+                if (status != cudaSuccess) {
+                    std::fprintf(
+                        stderr,
+                        "[stage6-spike] VERDICT: NO-GO at "
+                        "cudaGraphInstantiate: %s (%d)\n",
+                        cudaGetErrorString(status),
+                        static_cast<int>(status));
+                    teardown();
+                    restore();
+                    return;
+                }
+                std::fprintf(stderr, "[stage6-spike] instantiate OK\n");
+                // --- 3. Replay twice, diff against the eager baseline --
+                bool replay_ok = true;
+                for (int replay = 1; replay <= 2 && replay_ok; ++replay) {
+                    status = reset_inputs(probe);
+                    if (status == cudaSuccess) {
+                        status = cudaGraphLaunch(graph_exec, probe);
+                    }
+                    if (status == cudaSuccess) {
+                        status = cudaStreamSynchronize(probe);
+                    }
+                    if (status != cudaSuccess) {
+                        std::fprintf(
+                            stderr,
+                            "[stage6-spike] VERDICT: NO-GO at replay %d: "
+                            "%s (%d)\n",
+                            replay, cudaGetErrorString(status),
+                            static_cast<int>(status));
+                        replay_ok = false;
+                        break;
+                    }
+                    S6Run replayed;
+                    status = collect(replayed);
+                    if (status != cudaSuccess) {
+                        fail("collect(replay)", status);
+                        replay_ok = false;
+                        break;
+                    }
+                    const std::size_t scratch_mismatch =
+                        diff_bytes(replayed.scratch, eager.scratch);
+                    const std::size_t value_mismatch =
+                        diff_values(replayed.scratch, eager.scratch);
+                    std::size_t cell_total = 0;
+                    const std::size_t cell_mismatch =
+                        diff_cells(replayed, eager, &cell_total);
+                    std::size_t sentinel_cells = 0;
+                    for (const auto& cell : replayed.cells) {
+                        bool all_sentinel = !cell.empty();
+                        for (const std::uint8_t byte : cell) {
+                            all_sentinel = all_sentinel && byte == 0xAB;
+                        }
+                        if (all_sentinel) ++sentinel_cells;
+                    }
+                    std::fprintf(
+                        stderr,
+                        "[stage6-spike] replay %d vs eager baseline: "
+                        "scratch %zu/%zu value-slots %zu cells %zu/%zu "
+                        "mismatched bytes; unwritten(sentinel) cells "
+                        "%zu/%zu\n",
+                        replay, scratch_mismatch, replayed.scratch.size(),
+                        value_mismatch, cell_mismatch, cell_total,
+                        sentinel_cells, replayed.cells.size());
+                    replay_ok = replay_ok &&
+                        value_mismatch == 0 && cell_mismatch == 0 &&
+                        sentinel_cells == 0;
+                }
+                std::fprintf(
+                    stderr,
+                    "[stage6-spike] VERDICT: %s\n",
+                    replay_ok
+                        ? "GO — capture, instantiate, and 2x replay of the "
+                          "frozen region launches are byte-identical to "
+                          "eager"
+                        : "NO-GO — see mismatches above");
+                teardown();
+                restore();
+            }();
+        }
+    }
     if (device_workspace.has_value()) {
         device_workspace->record();
     }
