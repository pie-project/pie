    ops::gemm_act_x_w(cublas.handle(),
        ws.attn_out.data(),
        make_weight_view(require(w.layers[30].o_proj, "layer.30.o_proj"), w.layers[30].o_proj_quant),
        ws.y.data(), N, H, Hq, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[30].mlp_norm, "layer.30.mlp_norm")->data(),
        ws.norm_y.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_y.data(),
        ops::WeightView(*require(w.layers[30].gate_up_proj_fused, "layer.30.gate_up")),
        ws.gate_up_fused.data(), N, 2 * I, H);
    kernels::launch_chunked_swiglu_bf16(
        ws.gate_up_fused.data(), ws.gate.data(), N, I, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.gate.data(),
        make_weight_view(require(w.layers[30].down_proj, "layer.30.down"), w.layers[30].down_proj_quant),
        ws.y.data(), N, H, I, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[31].attn_norm, "layer.31.attn_norm")->data(),
        ws.norm_x.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        ops::WeightView(*require(w.layers[31].qkv_proj_fused, "layer.31.qkv")),
        ws.qkv_fused.data(), N, Hq + 2 * Hk, H);
    kernels::launch_split_qkv_bf16(
        ws.qkv_fused.data(),
        ws.q.data(), ws.k.data(), ws.v.data(),
        N, Hq, Hk, stream);
    if (lora != nullptr && lora->usable()) {
        if (lora_staged == nullptr && !lora_state) {
            throw std::runtime_error(
                "generated forward: lora correction stated but no "
                "usable lora table (guard/pred drift)");
        }
        (lora_staged != nullptr ? *lora_staged : *lora_state)
            .apply(
            cublas.handle(), 31, ws.norm_x.data(),
            H, Hq, Hk,
            ws.q.data(), ws.v.data(), ws.gate.data());
    } else {
    }
    kernels::launch_rope_bf16(
        ws.q.data(), ws.k.data(), positions,
        N, num_q_heads, num_kv_heads, d,
        cfg.rope_theta, stream);
    if (has_write_desc) {
        {
            auto kv_view = cache.layer_view(31);
            kernels::launch_write_kv_explicit_bf16(
                kv_view,
                bf16_row(ws.k.data(), 0, Hk),
                bf16_row(ws.v.data(), 0, Hk),
                w_page_d + 0, w_off_d + 0,
                N, stream,
                row_valid_d != nullptr ? row_valid_d + 0 : nullptr);
        }
    } else {
        {
            auto kv_view = cache.layer_view(31);
            kernels::launch_write_kv_to_pages(
                kv_view, ws.k.data(), ws.v.data(),
                qo_indptr, kv_page_indices, kv_page_indptr,
                kv_last_page_lens,
                N, R, stream, row_valid_d, /*first_token=*/0);
        }
    }
    if (custom_mask_d != nullptr) {
        if (hooks != nullptr) {
            attn_page_indices = kv_page_indices;
            attn_page_indptr = kv_page_indptr;
            attn_last_page_lens = kv_last_page_lens;
            page_mask.begin_layer(stream);
            prefill_score_capture.emplace(hooks, 31u,
                static_cast<std::uint32_t>(num_q_heads),
                plan_state.prefill_score_window,
                /*capturable=*/true, stream);
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttnProj, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                31u, stream, /*query_is_f32=*/false,
                {.mask_sink = page_mask.sink()});
        }
        if (plan_state.spatial_mask_split >= 0 &&
            unmasked_prefix_rows != 0xffffffffu) {
            const int split = plan_state.spatial_mask_split;
            const int split_rows =
                plan_state.spatial_mask_row_split >= 0
                    ? plan_state.spatial_mask_row_split
                    : split;
            if (split !=
                static_cast<int>(unmasked_prefix_rows)) {
                throw std::runtime_error(
                    "spatial mask: planned/prepared split drift");
            }
            if (mask_suffix_qo_indptr_d == nullptr) {
                throw std::runtime_error(
                    "spatial mask: suffix qo identity missing");
            }
            if (split > 0) {
                {
                    auto kv_view = cache.layer_view(31);
                    kernels::launch_dequant_kv_cache_layer_to_bf16_active(
                        kv_view, kv_page_indices, kv_page_indptr_h[split], stream);
                }
                if (!plan_state.prefill_plan) {
                    throw std::runtime_error(
                        "generated forward: prepare built no prefill plan");
                }
                {
                    auto kv_view = cache.layer_view(31);
                    ops::dispatch_attention_flashinfer_prefill_bf16(
                        *plan_state.prefill_plan,
                        ws.q.data(), kv_view.k_bf16_pages, kv_view.v_bf16_pages,
                        ws.attn_out.data(),
                        qo_indptr, kv_page_indices, kv_page_indptr,
                        kv_last_page_lens,
                        attn_ws, stream, /*logits_soft_cap=*/0.f,
                        /*sm_scale_override=*/-1.f);
                    if (plan_state.mixed_mid_decode_plan &&
                        plan_state.mixed_mid_start >= 0) {
                        const int mid_P = plan_state.mixed_mid_start;
                        const int mid_row =
                            static_cast<int>(qo_indptr_h[mid_P]);
                        const int mid_wl =
                            (!fwd_cfg.per_layer_window_left.empty() &&
                             31 < static_cast<int>(fwd_cfg.per_layer_window_left.size()))
                                ? fwd_cfg.per_layer_window_left[31]
                                : fwd_cfg.sliding_window;
                        ops::dispatch_attention_flashinfer_decode(
                            *plan_state.mixed_mid_decode_plan,
                            bf16_row(ws.q.data(), mid_row, Hq), kv_view,
                            bf16_row(ws.attn_out.data(), mid_row, Hq),
                            kv_page_indices,
                            kv_page_indptr + mid_P,
                            kv_last_page_lens + mid_P,
                            attn_ws, stream, mid_wl,
                            /*logits_soft_cap=*/0.f, /*sm_scale_override=*/-1.f);
                    }
                }
            }
            if (!plan_state.mask_decode_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no custom-mask plan");
            }
            {
                auto kv_view = cache.layer_view(31);
                ops::dispatch_attention_flashinfer_prefill_custom(
                    *plan_state.mask_decode_plan,
                    bf16_row(ws.q.data(), split_rows, Hq), kv_view,
                    bf16_row(ws.attn_out.data(), split_rows, Hq),
                    mask_suffix_qo_indptr_d,
                    kv_page_indices,
                    kv_page_indptr + split,
                    kv_last_page_lens + split,
                    custom_mask_d, custom_mask_indptr_d + split,
                    spatial_suffix_attn_ws(), stream);
            }
        } else {
            if (!plan_state.prefill_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no custom-mask plan");
            }
            {
                auto kv_view = cache.layer_view(31);
                ops::dispatch_attention_flashinfer_prefill_custom(
                    *plan_state.prefill_plan,
                    ws.q.data(), kv_view, ws.attn_out.data(),
                    qo_indptr, kv_page_indices, kv_page_indptr,
                    kv_last_page_lens, custom_mask_d, custom_mask_indptr_d,
                    attn_ws, stream);
            }
        }
        if (hooks != nullptr) {
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttn, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                31u, stream, /*query_is_f32=*/false,
                {.scores = prefill_score_capture
                     ? prefill_score_capture->scores()
                     : nullptr});
        }
    } else {
        if (hooks != nullptr) {
            attn_page_indices = kv_page_indices;
            attn_page_indptr = kv_page_indptr;
            attn_last_page_lens = kv_last_page_lens;
            page_mask.begin_layer(stream);
            prefill_score_capture.emplace(hooks, 31u,
                static_cast<std::uint32_t>(num_q_heads),
                plan_state.prefill_score_window,
                /*capturable=*/true, stream);
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttnProj, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                31u, stream, /*query_is_f32=*/false,
                {.mask_sink = page_mask.sink()});
        }
        {
            auto kv_view = cache.layer_view(31);
            kernels::launch_dequant_kv_cache_layer_to_bf16_active(
                kv_view, kv_page_indices, kv_page_indptr_h[R], stream);
        }
        if (hooks != nullptr && hooks->wants_attn_score) {
            if (!plan_state.prefill_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no prefill plan");
            }
            if (!prefill_score_capture ||
                !prefill_score_capture->active()) {
                throw std::runtime_error(
                    "generated forward: capture prefill stated but no "
                    "active score capture (guard/pred drift)");
            }
            if (page_mask.written_for(31u)) {
                throw std::runtime_error(
                    "attn_page_mask was written but this layer does "
                    "not take the paged decode path");
            }
            {
                auto kv_view = cache.layer_view(31);
                ops::dispatch_attention_flashinfer_prefill_capture_bf16(
                    *plan_state.prefill_plan,
                    ws.q.data(), kv_view.k_bf16_pages, kv_view.v_bf16_pages,
                    ws.attn_out.data(),
                    qo_indptr, kv_page_indices, kv_page_indptr,
                    kv_last_page_lens, attn_ws, stream,
                    prefill_score_capture->raw(),
                    prefill_score_capture->folded(),
                    prefill_score_capture->indptr_d(),
                    prefill_score_capture->window(),
                    /*logits_soft_cap=*/0.f, /*sm_scale_override=*/-1.f);
                prefill_score_capture->publish();
            }
        } else {
            if (!plan_state.prefill_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no prefill plan");
            }
            {
                auto kv_view = cache.layer_view(31);
                ops::dispatch_attention_flashinfer_prefill_bf16(
                    *plan_state.prefill_plan,
                    ws.q.data(), kv_view.k_bf16_pages, kv_view.v_bf16_pages,
                    ws.attn_out.data(),
                    qo_indptr, kv_page_indices, kv_page_indptr,
                    kv_last_page_lens,
                    attn_ws, stream, /*logits_soft_cap=*/0.f,
                    /*sm_scale_override=*/-1.f);
            }
        }
        if (hooks != nullptr) {
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttn, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                31u, stream, /*query_is_f32=*/false,
                {.scores = prefill_score_capture
                     ? prefill_score_capture->scores()
                     : nullptr});
        }
    }
    ops::gemm_act_x_w(cublas.handle(),
        ws.attn_out.data(),
        make_weight_view(require(w.layers[31].o_proj, "layer.31.o_proj"), w.layers[31].o_proj_quant),
        ws.y.data(), N, H, Hq, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[31].mlp_norm, "layer.31.mlp_norm")->data(),
        ws.norm_y.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_y.data(),
        ops::WeightView(*require(w.layers[31].gate_up_proj_fused, "layer.31.gate_up")),
        ws.gate_up_fused.data(), N, 2 * I, H);
    kernels::launch_chunked_swiglu_bf16(
        ws.gate_up_fused.data(), ws.gate.data(), N, I, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.gate.data(),
        make_weight_view(require(w.layers[31].down_proj, "layer.31.down"), w.layers[31].down_proj_quant),
        ws.y.data(), N, H, I, 1.f);
    // final_norm: deferred into the LmHead epilogue below.
    if (fwd_cfg.emit_logits) {
        // The hand-written epilogue, the interpreter's arm verbatim
        // (compact logits are a per-fire runtime input).
        const bool compact_logits =
            logit_row_indices_d != nullptr && num_logit_rows > 0 &&
            num_logit_rows < N;
        const void* lm_head_input = nullptr;
        int lm_head_rows = N;
        if (compact_logits) {
            kernels::launch_gather_bf16_rows(
                static_cast<const std::uint16_t*>(ws.y.data()),
                logit_row_indices_d,
                static_cast<std::uint16_t*>(ws.norm_x.data()),
                num_logit_rows, H, stream);
            kernels::launch_rmsnorm_bf16(
                ws.norm_x.data(), w.final_norm->data(),
                ws.norm_y.data(), num_logit_rows, H, eps, stream);
            lm_head_input = ws.norm_y.data();
            lm_head_rows = num_logit_rows;
        } else {
            kernels::launch_rmsnorm_bf16(
                ws.y.data(), w.final_norm->data(), ws.norm_y.data(),
                N, H, eps, stream);
            lm_head_input = ws.norm_y.data();
        }
        ops::gemm_act_x_w(cublas.handle(),
            lm_head_input, ops::WeightView(*require(w.lm_head, "lm_head")),
            ws.logits.data(), lm_head_rows, V, H);
    }
}

inline void generated_llama_like_decode_mistral_7b_v03_supergraph_build(
const Qwen3Weights& w,
const HfConfig& cfg,
const LlamaLikeForwardCfg& fwd_cfg,
const LlamaLikePlanState& plan_state,
Workspace& ws,
KvCache& cache,
AttentionWorkspace& attn_ws,
ops::CublasHandle& cublas,
const std::int32_t* token_ids,
const std::int32_t* positions,
const std::uint32_t* qo_indptr,
const std::uint32_t* kv_page_indices,
const std::uint32_t* kv_page_indptr,
const std::uint32_t* kv_last_page_lens,
const std::uint32_t* qo_indptr_h,
const std::uint32_t* kv_page_indptr_h,
int total_tokens,
int num_requests,
const std::int32_t* logit_row_indices_d,
int num_logit_rows,
const std::uint32_t* w_page_d,
const std::uint32_t* w_off_d,
const std::uint8_t* row_valid_d,
bool has_write_desc,
const std::uint8_t* custom_mask_d,
const std::int32_t* custom_mask_indptr_d,
const StageHooks* hooks,
const LoraTable* lora,
const std::uint32_t* peel_window_d,
std::uint32_t unmasked_prefix_rows,
const std::uint32_t* mask_suffix_qo_indptr_d,
std::uint32_t declared_max_layers,
std::uint32_t declared_full_depth_rows,
    batch::SupergraphBuilder& sg)
{
    // Locals mirror the interpreter's preamble (unpadded shape:
    // the staging aliases are the plain buffers).
    const int N = total_tokens;
    const int R = num_requests;
    // STRUCTURAL S-4: the depth axis, stated by the trace
    // (ForwardPlan::depth_window) — per-layer scopes below
    // shadow N/R on tail layers; uniform truncation skips
    // them and the unchanged epilogue is the logit-lens head.
    const int depth_k =
        declared_max_layers != 0xffffffffu &&
        declared_max_layers <
            static_cast<std::uint32_t>(cfg.num_hidden_layers)
            ? static_cast<int>(declared_max_layers)
            : cfg.num_hidden_layers;
    const bool depth_union =
        depth_k < cfg.num_hidden_layers &&
        declared_full_depth_rows != 0xffffffffu;
    const int depth_split = depth_union
        ? static_cast<int>(declared_full_depth_rows)
        : N;
    if (depth_union &&
        (depth_split <= 0 || depth_split >= R ||
         !plan_state.depth_prefix_decode_plan)) {
        throw std::runtime_error(
            "depth union (generated): planned split without "
            "a usable prefix plan (gate drift)");
    }
    // ④ Act 1 (banded depth): >= 2 distinct-k bands from the
    // prepare's stamp; per-layer scopes below resolve the
    // band containing their static layer. Banded fires
    // derive max_layers FULL, so the union logic stays idle.
    const int band_count =
        static_cast<int>(plan_state.depth_band_count);
    const bool depth_banded = band_count >= 2;
    if (depth_banded) {
        for (int j = 0; j < band_count; ++j) {
            if (plan_state.depth_band_rows[j] > 0 &&
                !plan_state.depth_band_plans[j]) {
                throw std::runtime_error(
                    "depth bands (generated): stamped band "
                    "without a usable prefix plan");
            }
        }
    }
    const int H = cfg.hidden_size;
    const int Hq = cfg.num_attention_heads * cfg.head_dim;
    const int Hk = cfg.num_key_value_heads * cfg.head_dim;
    const int I = cfg.intermediate_size;
    const int V = cfg.vocab_size;
    const int d = cfg.head_dim;
    const int num_q_heads = cfg.num_attention_heads;
    const int num_kv_heads = cfg.num_key_value_heads;
    const float eps = cfg.rms_norm_eps;
    cudaStream_t stream = sg.stream();
    cublas.set_stream(stream);
    if (std::getenv("PIE_DECLARED_FORWARD_TRACE")) {
        std::fprintf(stderr,
                     "[declared-forward-generated] N=%d R=%d decode=1\n",
                     N, R);
    }

    FirePageMask page_mask(hooks, stream);
    const std::uint32_t* attn_page_indices = kv_page_indices;
    const std::uint32_t* attn_page_indptr = kv_page_indptr;
    const std::uint32_t* attn_last_page_lens = kv_last_page_lens;
    std::optional<LayerScoreCapture> score_capture;

    const LoraFireStateHandle* lora_staged =
        (lora != nullptr && lora->usable() &&
         plan_state.lora_staged_table == lora)
            ? plan_state.lora_staged.get() : nullptr;
    std::optional<LoraFireStateHandle> lora_state;
    if (lora != nullptr && lora->usable() &&
        lora_staged == nullptr) {
        lora_state.emplace(*lora, cfg, N, H, Hq, Hk, I,
                           /*tp=*/1, stream, ws,
                           ws.norm_x.data(),
                           ws.q.data(), ws.v.data(),
                           ws.gate.data());
    }

    const int fast_rows = hooks == nullptr
        ? R
        : (static_cast<int>(hooks->hook_free_prefix_rows) < R
               ? static_cast<int>(hooks->hook_free_prefix_rows)
               : R);

    {
        auto __sg_mask = sg.open_cond(4, true);
        sg.begin_body(__sg_mask.if_body);
        stream = sg.stream();
        cublas.set_stream(stream);
        {
    kernels::launch_embed_bf16(
        token_ids, require(w.embed, "embed")->data(), ws.y.data(),
        N, H, V, stream);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[0].attn_norm, "layer.0.attn_norm")->data(),
        ws.norm_x.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        ops::WeightView(*require(w.layers[0].qkv_proj_fused, "layer.0.qkv")),
        ws.qkv_fused.data(), N, Hq + 2 * Hk, H);
    kernels::launch_split_qkv_bf16(
        ws.qkv_fused.data(),
        ws.q.data(), ws.k.data(), ws.v.data(),
        N, Hq, Hk, stream);
    kernels::launch_rope_bf16(
        ws.q.data(), ws.k.data(), positions,
        N, num_q_heads, num_kv_heads, d,
        cfg.rope_theta, stream);
    {
        auto kv_view = cache.layer_view(0);
        kernels::launch_write_kv_explicit_bf16(
            kv_view,
            bf16_row(ws.k.data(), 0, Hk),
            bf16_row(ws.v.data(), 0, Hk),
            w_page_d + 0, w_off_d + 0,
            N, stream,
            row_valid_d != nullptr ? row_valid_d + 0 : nullptr);
    }
    if (hooks != nullptr) {
        attn_page_indices = kv_page_indices;
        attn_page_indptr = kv_page_indptr;
        attn_last_page_lens = kv_last_page_lens;
        page_mask.begin_layer(stream);
        score_capture.emplace(hooks, 0u,
            static_cast<std::uint32_t>(num_q_heads),
            /*capturable=*/true, stream);
        invoke_stage_hook(
            hooks, StageHookPoint::OnAttnProj, ws.q.data(),
            static_cast<std::uint32_t>(N),
            static_cast<std::uint32_t>(Hq),
            0u, stream, /*query_is_f32=*/false,
            {.mask_sink = page_mask.sink()});
    }
    if (!plan_state.mask_decode_plan) {
        throw std::runtime_error(
            "generated forward: prepare built no custom-mask plan");
    }
    {
        auto kv_view = cache.layer_view(0);
        ops::dispatch_attention_flashinfer_prefill_custom(
            *plan_state.mask_decode_plan,
            ws.q.data(), kv_view, ws.attn_out.data(),
            qo_indptr, kv_page_indices, kv_page_indptr,
            kv_last_page_lens, custom_mask_d, custom_mask_indptr_d,
            attn_ws, stream);
    }
    if (hooks != nullptr) {
        invoke_stage_hook(
            hooks, StageHookPoint::OnAttn, ws.q.data(),
            static_cast<std::uint32_t>(N),
            static_cast<std::uint32_t>(Hq),
            0u, stream, /*query_is_f32=*/false,
            {.scores = score_capture ? score_capture->scores()
                                     : nullptr});
    }
    ops::gemm_act_x_w(cublas.handle(),
        ws.attn_out.data(),
        make_weight_view(require(w.layers[0].o_proj, "layer.0.o_proj"), w.layers[0].o_proj_quant),
        ws.y.data(), N, H, Hq, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[0].mlp_norm, "layer.0.mlp_norm")->data(),
        ws.norm_y.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_y.data(),
        ops::WeightView(*require(w.layers[0].gate_up_proj_fused, "layer.0.gate_up")),
        ws.gate_up_fused.data(), N, 2 * I, H);
    kernels::launch_chunked_swiglu_bf16(
        ws.gate_up_fused.data(), ws.gate.data(), N, I, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.gate.data(),
        make_weight_view(require(w.layers[0].down_proj, "layer.0.down"), w.layers[0].down_proj_quant),
        ws.y.data(), N, H, I, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[1].attn_norm, "layer.1.attn_norm")->data(),
        ws.norm_x.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        ops::WeightView(*require(w.layers[1].qkv_proj_fused, "layer.1.qkv")),
        ws.qkv_fused.data(), N, Hq + 2 * Hk, H);
    kernels::launch_split_qkv_bf16(
        ws.qkv_fused.data(),
        ws.q.data(), ws.k.data(), ws.v.data(),
        N, Hq, Hk, stream);
    kernels::launch_rope_bf16(
