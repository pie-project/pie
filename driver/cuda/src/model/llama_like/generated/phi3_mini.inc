        ws.norm_y.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_y.data(),
        ops::WeightView(*require(w.layers[1].gate_up_proj_fused, "layer.1.gate_up")),
