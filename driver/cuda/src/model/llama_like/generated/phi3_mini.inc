            attn_out_buf, ws.attn_out.data(),
            N, num_q_heads, d, dk, stream);
        }
        if (hooks != nullptr) {
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttn, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                30u, stream, /*query_is_f32=*/false,
                {.scores = score_capture ? score_capture->scores()
                                         : nullptr});
        }
    } else {
        if (hooks != nullptr) {
            attn_page_indices = kv_page_indices;
            attn_page_indptr = kv_page_indptr;
            attn_last_page_lens = kv_last_page_lens;
            page_mask.begin_layer(stream);
            score_capture.emplace(hooks, 30u,
                static_cast<std::uint32_t>(num_q_heads),
                /*capturable=*/true, stream);
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttnProj, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                30u, stream, /*query_is_f32=*/false,
                {.mask_sink = page_mask.sink()});
        }
        if (hooks != nullptr && hooks->wants_attn_score) {
            if (!plan_state.decode_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no decode plan");
            }
            if (!score_capture || !score_capture->active()) {
                throw std::runtime_error(
                    "generated forward: capture decode stated but no "
                    "active score capture (guard/pred drift)");
            }
            if (page_mask.written_for(30u)) {
                if (!plan_state.decode_plan) {
                    throw std::runtime_error(
                        "attn_page_mask was written but this layer does "
                        "not take the paged decode path");
                }
                if (!ops::decode_plan_is_page_count_independent(
                        *plan_state.decode_plan)) {
                    throw std::runtime_error(
                        "attn_page_mask requires a page-count-independent "
                        "decode plan; this fire planned split-KV");
                }
                page_mask.compact(
                    kv_page_indices, kv_page_indptr, kv_last_page_lens,
                    static_cast<std::uint32_t>(num_requests), stream);
                attn_page_indices = page_mask.page_indices();
                attn_page_indptr = page_mask.page_indptr();
                attn_last_page_lens = page_mask.last_page_lens();
            }
            {
                auto kv_view = cache.layer_view(30);
                ops::dispatch_attention_flashinfer_decode_capture(
                    *plan_state.decode_plan,
                    attn_q, kv_view, attn_out_buf,
                    attn_page_indices, attn_page_indptr,
                    attn_last_page_lens,
                    attn_ws, stream,
                    score_capture->raw(), score_capture->indptr_d(),
                    /*window_left=*/-1,
                    /*logits_soft_cap=*/0.f, sm_scale_override);
                score_capture->publish(
                    attn_page_indptr, attn_last_page_lens,
                    cache.page_size());
            kernels::launch_strip_head_dim_bf16(
                attn_out_buf, ws.attn_out.data(),
                N, num_q_heads, d, dk, stream);
            }
        } else {
            if (page_mask.written_for(30u)) {
                if (!plan_state.decode_plan) {
                    throw std::runtime_error(
                        "attn_page_mask was written but this layer does "
                        "not take the paged decode path");
                }
                if (!ops::decode_plan_is_page_count_independent(
                        *plan_state.decode_plan)) {
                    throw std::runtime_error(
                        "attn_page_mask requires a page-count-independent "
                        "decode plan; this fire planned split-KV");
                }
                page_mask.compact(
                    kv_page_indices, kv_page_indptr, kv_last_page_lens,
                    static_cast<std::uint32_t>(num_requests), stream);
                attn_page_indices = page_mask.page_indices();
                attn_page_indptr = page_mask.page_indptr();
                attn_last_page_lens = page_mask.last_page_lens();
            }
            if (!plan_state.decode_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no decode plan");
            }
            {
                auto kv_view = cache.layer_view(30);
                const int layer_window_left =
                    (!fwd_cfg.per_layer_window_left.empty() &&
                     30 < static_cast<int>(fwd_cfg.per_layer_window_left.size()))
                        ? fwd_cfg.per_layer_window_left[30]
                        : fwd_cfg.sliding_window;
                ops::dispatch_attention_flashinfer_decode(
                    *plan_state.decode_plan,
                    attn_q, kv_view, attn_out_buf,
                    attn_page_indices, attn_page_indptr,
                    attn_last_page_lens,
                    attn_ws, stream, layer_window_left,
                    /*logits_soft_cap=*/0.f, sm_scale_override);
            kernels::launch_strip_head_dim_bf16(
                attn_out_buf, ws.attn_out.data(),
                N, num_q_heads, d, dk, stream);
            }
        }
        if (hooks != nullptr) {
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttn, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                30u, stream, /*query_is_f32=*/false,
                {.scores = score_capture ? score_capture->scores()
                                         : nullptr});
        }
    }
    ops::gemm_act_x_w(cublas.handle(),
        ws.attn_out.data(),
        make_weight_view(require(w.layers[30].o_proj, "layer.30.o_proj"), w.layers[30].o_proj_quant),
        ws.y.data(), N, H, Hq, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[30].mlp_norm, "layer.30.mlp_norm")->data(),
        ws.norm_y.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_y.data(),
        ops::WeightView(*require(w.layers[30].gate_up_proj_fused, "layer.30.gate_up")),
        ws.gate_up_fused.data(), N, 2 * I, H);
    kernels::launch_chunked_swiglu_bf16(
        ws.gate_up_fused.data(), ws.gate.data(), N, I, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.gate.data(),
        make_weight_view(require(w.layers[30].down_proj, "layer.30.down"), w.layers[30].down_proj_quant),
        ws.y.data(), N, H, I, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[31].attn_norm, "layer.31.attn_norm")->data(),
        ws.norm_x.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        make_weight_view(require(w.layers[31].q_proj, "layer.31.q_proj"), w.layers[31].q_proj_quant),
        ws.q.data(), N, Hq, H);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        make_weight_view(require(w.layers[31].k_proj, "layer.31.k_proj"), w.layers[31].k_proj_quant),
        ws.k.data(), N, Hk, H);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        make_weight_view(require(w.layers[31].v_proj, "layer.31.v_proj"), w.layers[31].v_proj_quant),
        ws.v.data(), N, Hk, H);
    if (lora != nullptr && lora->usable()) {
        if (lora_staged == nullptr && !lora_state) {
            throw std::runtime_error(
                "generated forward: lora correction stated but no "
                "usable lora table (guard/pred drift)");
        }
        (lora_staged != nullptr ? *lora_staged : *lora_state)
            .apply(
            cublas.handle(), 31, ws.norm_x.data(),
            H, Hq, Hk,
            ws.q.data(), ws.v.data(), ws.gate.data());
    } else {
    }
    kernels::launch_rope_bf16(
        ws.q.data(), ws.k.data(), positions,
        N, num_q_heads, num_kv_heads, d,
        cfg.rope_theta, stream);
    if (has_write_desc) {
        kernels::launch_pad_head_dim_bf16(
            ws.q.data(), attn_q, N, num_q_heads, d, dk, stream);
        kernels::launch_pad_head_dim_bf16(
            ws.k.data(), attn_k, N, num_kv_heads, d, dk, stream);
        kernels::launch_pad_head_dim_bf16(
            ws.v.data(), attn_v, N, num_kv_heads, d, dk, stream);
        {
            auto kv_view = cache.layer_view(31);
            kernels::launch_write_kv_explicit_bf16(
                kv_view,
                bf16_row(attn_k, 0, Hk),
                bf16_row(attn_v, 0, Hk),
                w_page_d + 0, w_off_d + 0,
                N, stream,
                row_valid_d != nullptr ? row_valid_d + 0 : nullptr);
        }
    } else {
        kernels::launch_pad_head_dim_bf16(
            ws.q.data(), attn_q, N, num_q_heads, d, dk, stream);
        kernels::launch_pad_head_dim_bf16(
            ws.k.data(), attn_k, N, num_kv_heads, d, dk, stream);
        kernels::launch_pad_head_dim_bf16(
            ws.v.data(), attn_v, N, num_kv_heads, d, dk, stream);
        {
            auto kv_view = cache.layer_view(31);
            kernels::launch_write_kv_to_pages(
                kv_view, attn_k, attn_v,
                qo_indptr, kv_page_indices, kv_page_indptr,
                kv_last_page_lens,
                N, R, stream, row_valid_d, /*first_token=*/0);
        }
    }
    if (custom_mask_d != nullptr) {
        if (hooks != nullptr) {
            attn_page_indices = kv_page_indices;
            attn_page_indptr = kv_page_indptr;
            attn_last_page_lens = kv_last_page_lens;
            page_mask.begin_layer(stream);
            score_capture.emplace(hooks, 31u,
                static_cast<std::uint32_t>(num_q_heads),
                /*capturable=*/true, stream);
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttnProj, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                31u, stream, /*query_is_f32=*/false,
                {.mask_sink = page_mask.sink()});
        }
        if (!plan_state.mask_decode_plan) {
            throw std::runtime_error(
                "generated forward: prepare built no custom-mask plan");
        }
        {
            auto kv_view = cache.layer_view(31);
            ops::dispatch_attention_flashinfer_prefill_custom(
                *plan_state.mask_decode_plan,
                attn_q, kv_view, attn_out_buf,
                qo_indptr, kv_page_indices, kv_page_indptr,
                kv_last_page_lens, custom_mask_d, custom_mask_indptr_d,
                attn_ws, stream);
        kernels::launch_strip_head_dim_bf16(
            attn_out_buf, ws.attn_out.data(),
            N, num_q_heads, d, dk, stream);
        }
        if (hooks != nullptr) {
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttn, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                31u, stream, /*query_is_f32=*/false,
                {.scores = score_capture ? score_capture->scores()
                                         : nullptr});
        }
    } else {
        if (hooks != nullptr) {
            attn_page_indices = kv_page_indices;
            attn_page_indptr = kv_page_indptr;
            attn_last_page_lens = kv_last_page_lens;
            page_mask.begin_layer(stream);
            score_capture.emplace(hooks, 31u,
                static_cast<std::uint32_t>(num_q_heads),
                /*capturable=*/true, stream);
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttnProj, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                31u, stream, /*query_is_f32=*/false,
                {.mask_sink = page_mask.sink()});
        }
        if (hooks != nullptr && hooks->wants_attn_score) {
            if (!plan_state.decode_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no decode plan");
            }
            if (!score_capture || !score_capture->active()) {
                throw std::runtime_error(
                    "generated forward: capture decode stated but no "
                    "active score capture (guard/pred drift)");
            }
            if (page_mask.written_for(31u)) {
                if (!plan_state.decode_plan) {
                    throw std::runtime_error(
                        "attn_page_mask was written but this layer does "
                        "not take the paged decode path");
                }
                if (!ops::decode_plan_is_page_count_independent(
                        *plan_state.decode_plan)) {
                    throw std::runtime_error(
                        "attn_page_mask requires a page-count-independent "
                        "decode plan; this fire planned split-KV");
                }
                page_mask.compact(
                    kv_page_indices, kv_page_indptr, kv_last_page_lens,
                    static_cast<std::uint32_t>(num_requests), stream);
                attn_page_indices = page_mask.page_indices();
                attn_page_indptr = page_mask.page_indptr();
                attn_last_page_lens = page_mask.last_page_lens();
            }
            {
                auto kv_view = cache.layer_view(31);
                ops::dispatch_attention_flashinfer_decode_capture(
                    *plan_state.decode_plan,
                    attn_q, kv_view, attn_out_buf,
                    attn_page_indices, attn_page_indptr,
                    attn_last_page_lens,
                    attn_ws, stream,
                    score_capture->raw(), score_capture->indptr_d(),
                    /*window_left=*/-1,
                    /*logits_soft_cap=*/0.f, sm_scale_override);
                score_capture->publish(
                    attn_page_indptr, attn_last_page_lens,
                    cache.page_size());
            kernels::launch_strip_head_dim_bf16(
                attn_out_buf, ws.attn_out.data(),
                N, num_q_heads, d, dk, stream);
            }
        } else {
            if (page_mask.written_for(31u)) {
                if (!plan_state.decode_plan) {
                    throw std::runtime_error(
                        "attn_page_mask was written but this layer does "
                        "not take the paged decode path");
                }
                if (!ops::decode_plan_is_page_count_independent(
                        *plan_state.decode_plan)) {
                    throw std::runtime_error(
                        "attn_page_mask requires a page-count-independent "
                        "decode plan; this fire planned split-KV");
                }
                page_mask.compact(
                    kv_page_indices, kv_page_indptr, kv_last_page_lens,
                    static_cast<std::uint32_t>(num_requests), stream);
                attn_page_indices = page_mask.page_indices();
                attn_page_indptr = page_mask.page_indptr();
                attn_last_page_lens = page_mask.last_page_lens();
            }
            if (!plan_state.decode_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no decode plan");
            }
            {
                auto kv_view = cache.layer_view(31);
                const int layer_window_left =
                    (!fwd_cfg.per_layer_window_left.empty() &&
                     31 < static_cast<int>(fwd_cfg.per_layer_window_left.size()))
                        ? fwd_cfg.per_layer_window_left[31]
                        : fwd_cfg.sliding_window;
                ops::dispatch_attention_flashinfer_decode(
                    *plan_state.decode_plan,
                    attn_q, kv_view, attn_out_buf,
                    attn_page_indices, attn_page_indptr,
                    attn_last_page_lens,
                    attn_ws, stream, layer_window_left,
                    /*logits_soft_cap=*/0.f, sm_scale_override);
            kernels::launch_strip_head_dim_bf16(
                attn_out_buf, ws.attn_out.data(),
                N, num_q_heads, d, dk, stream);
            }
        }
        if (hooks != nullptr) {
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttn, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                31u, stream, /*query_is_f32=*/false,
                {.scores = score_capture ? score_capture->scores()
                                         : nullptr});
        }
    }
    ops::gemm_act_x_w(cublas.handle(),
        ws.attn_out.data(),
        make_weight_view(require(w.layers[31].o_proj, "layer.31.o_proj"), w.layers[31].o_proj_quant),
        ws.y.data(), N, H, Hq, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[31].mlp_norm, "layer.31.mlp_norm")->data(),
        ws.norm_y.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_y.data(),
        ops::WeightView(*require(w.layers[31].gate_up_proj_fused, "layer.31.gate_up")),
        ws.gate_up_fused.data(), N, 2 * I, H);
    kernels::launch_chunked_swiglu_bf16(
        ws.gate_up_fused.data(), ws.gate.data(), N, I, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.gate.data(),
        make_weight_view(require(w.layers[31].down_proj, "layer.31.down"), w.layers[31].down_proj_quant),
        ws.y.data(), N, H, I, 1.f);
    // final_norm: deferred into the LmHead epilogue below.
    if (fwd_cfg.emit_logits) {
        // The hand-written epilogue, the interpreter's arm verbatim
        // (compact logits are a per-fire runtime input).
        const bool compact_logits =
            logit_row_indices_d != nullptr && num_logit_rows > 0 &&
            num_logit_rows < N;
        const void* lm_head_input = nullptr;
        int lm_head_rows = N;
        if (compact_logits) {
            kernels::launch_gather_bf16_rows(
                static_cast<const std::uint16_t*>(ws.y.data()),
                logit_row_indices_d,
                static_cast<std::uint16_t*>(ws.norm_x.data()),
                num_logit_rows, H, stream);
            kernels::launch_rmsnorm_bf16(
                ws.norm_x.data(), w.final_norm->data(),
                ws.norm_y.data(), num_logit_rows, H, eps, stream);
            lm_head_input = ws.norm_y.data();
            lm_head_rows = num_logit_rows;
        } else {
            kernels::launch_rmsnorm_bf16(
                ws.y.data(), w.final_norm->data(), ws.norm_y.data(),
                N, H, eps, stream);
            lm_head_input = ws.norm_y.data();
        }
        ops::gemm_act_x_w(cublas.handle(),
            lm_head_input, ops::WeightView(*require(w.lm_head, "lm_head")),
            ws.logits.data(), lm_head_rows, V, H);
    }
}

inline void generated_llama_like_prefill_phi3_mini(
const Qwen3Weights& w,
const HfConfig& cfg,
const LlamaLikeForwardCfg& fwd_cfg,
const LlamaLikePlanState& plan_state,
Workspace& ws,
KvCache& cache,
AttentionWorkspace& attn_ws,
ops::CublasHandle& cublas,
const std::int32_t* token_ids,
const std::int32_t* positions,
const std::uint32_t* qo_indptr,
const std::uint32_t* kv_page_indices,
const std::uint32_t* kv_page_indptr,
const std::uint32_t* kv_last_page_lens,
const std::uint32_t* qo_indptr_h,
const std::uint32_t* kv_page_indptr_h,
int total_tokens,
int num_requests,
const std::int32_t* logit_row_indices_d,
int num_logit_rows,
const std::uint32_t* w_page_d,
const std::uint32_t* w_off_d,
const std::uint8_t* row_valid_d,
bool has_write_desc,
const std::uint8_t* custom_mask_d,
const std::int32_t* custom_mask_indptr_d,
const StageHooks* hooks,
const LoraTable* lora,
const std::uint32_t* peel_window_d,
std::uint32_t unmasked_prefix_rows,
const std::uint32_t* mask_suffix_qo_indptr_d,
std::uint32_t declared_max_layers,
std::uint32_t declared_full_depth_rows)
{
    // Locals mirror the interpreter's preamble — PADDED shape
    // (Phi-3's 96 -> 128): the attention consumes zero-padded
    // dk staging copies, the softmax keeps the real-dim scale,
    // and the o_proj reads the stripped logical-width output.
    const int N = total_tokens;
    const int R = num_requests;
    const int H = cfg.hidden_size;
    const int Hq = cfg.num_attention_heads * cfg.head_dim;
    const int Hk = cfg.num_key_value_heads * cfg.head_dim;
    const int I = cfg.intermediate_size;
    const int V = cfg.vocab_size;
    const int d = cfg.head_dim;
    const int num_q_heads = cfg.num_attention_heads;
    const int num_kv_heads = cfg.num_key_value_heads;
    const float eps = cfg.rms_norm_eps;
    cudaStream_t stream = cublas.stream();
    const int dk = cfg.head_dim_kernel;
    const float sm_scale_override =
        1.0f / std::sqrt(static_cast<float>(d));
    void* const attn_q = ws.q_padded.data();
    void* const attn_k = ws.k_padded.data();
    void* const attn_v = ws.v_padded.data();
    void* const attn_out_buf = ws.attn_out_padded.data();
    if (std::getenv("PIE_DECLARED_FORWARD_TRACE")) {
        std::fprintf(stderr,
                     "[declared-forward-generated] N=%d R=%d decode=0\n",
                     N, R);
    }

    FirePageMask page_mask(hooks, stream);
    const std::uint32_t* attn_page_indices = kv_page_indices;
    const std::uint32_t* attn_page_indptr = kv_page_indptr;
    const std::uint32_t* attn_last_page_lens = kv_last_page_lens;
    std::optional<LayerPrefillScoreCapture> prefill_score_capture;

    const LoraFireStateHandle* lora_staged =
        (lora != nullptr && lora->usable() &&
         plan_state.lora_staged_table == lora)
            ? plan_state.lora_staged.get() : nullptr;
    std::optional<LoraFireStateHandle> lora_state;
    if (lora != nullptr && lora->usable() &&
        lora_staged == nullptr) {
        lora_state.emplace(*lora, cfg, N, H, Hq, Hk, I,
                           /*tp=*/1, stream, ws,
                           ws.norm_x.data(),
                           ws.q.data(), ws.v.data(),
                           ws.gate.data());
    }

    kernels::launch_embed_bf16(
        token_ids, require(w.embed, "embed")->data(), ws.y.data(),
        N, H, V, stream);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[0].attn_norm, "layer.0.attn_norm")->data(),
        ws.norm_x.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        make_weight_view(require(w.layers[0].q_proj, "layer.0.q_proj"), w.layers[0].q_proj_quant),
        ws.q.data(), N, Hq, H);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        make_weight_view(require(w.layers[0].k_proj, "layer.0.k_proj"), w.layers[0].k_proj_quant),
        ws.k.data(), N, Hk, H);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        make_weight_view(require(w.layers[0].v_proj, "layer.0.v_proj"), w.layers[0].v_proj_quant),
        ws.v.data(), N, Hk, H);
    if (lora != nullptr && lora->usable()) {
        if (lora_staged == nullptr && !lora_state) {
            throw std::runtime_error(
                "generated forward: lora correction stated but no "
                "usable lora table (guard/pred drift)");
        }
        (lora_staged != nullptr ? *lora_staged : *lora_state)
            .apply(
            cublas.handle(), 0, ws.norm_x.data(),
            H, Hq, Hk,
            ws.q.data(), ws.v.data(), ws.gate.data());
    } else {
