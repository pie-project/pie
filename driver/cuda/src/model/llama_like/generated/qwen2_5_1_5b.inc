                    attn_ws, stream, /*logits_soft_cap=*/0.f,
                    /*sm_scale_override=*/-1.f);
            }
        }
        if (hooks != nullptr) {
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttn, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                26u, stream, /*query_is_f32=*/false,
                {.scores = prefill_score_capture
                     ? prefill_score_capture->scores()
                     : nullptr});
        }
    }
    ops::gemm_act_x_w(cublas.handle(),
        ws.attn_out.data(),
        make_weight_view(require(w.layers[26].o_proj, "layer.26.o_proj"), w.layers[26].o_proj_quant),
        ws.y.data(), N, H, Hq, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[26].mlp_norm, "layer.26.mlp_norm")->data(),
        ws.norm_y.data(), N, H, eps, stream);
    const bool gate_up_fused_26 =
        w.layers[26].gate_up_proj_fused != nullptr && !ws.gate_up_fused.empty();
    if (gate_up_fused_26) {
        ops::gemm_act_x_w(cublas.handle(),
            ws.norm_y.data(),
            ops::WeightView(*w.layers[26].gate_up_proj_fused),
            ws.gate_up_fused.data(), N, 2 * I, H);
    } else {
        ops::gemm_act_x_w(cublas.handle(),
            ws.norm_y.data(),
            make_weight_view(require(w.layers[26].gate_proj, "layer.26.gate_up"), w.layers[26].gate_proj_quant),
            ws.gate.data(), N, I, H);
        ops::gemm_act_x_w(cublas.handle(),
            ws.norm_y.data(),
            make_weight_view(require(w.layers[26].up_proj, "layer.26.gate_up"), w.layers[26].up_proj_quant),
            ws.up.data(), N, I, H);
    }
    if (gate_up_fused_26) {
        kernels::launch_chunked_swiglu_bf16(
            ws.gate_up_fused.data(), ws.gate.data(), N, I, stream);
    } else {
        kernels::launch_swiglu_bf16(
            ws.gate.data(), ws.up.data(), ws.gate.data(),
            N * I, stream);
    }
    ops::gemm_act_x_w(cublas.handle(),
        ws.gate.data(),
        make_weight_view(require(w.layers[26].down_proj, "layer.26.down"), w.layers[26].down_proj_quant),
        ws.y.data(), N, H, I, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[27].attn_norm, "layer.27.attn_norm")->data(),
        ws.norm_x.data(), N, H, eps, stream);
    ops::gemm_act_x_w(cublas.handle(),
        ws.norm_x.data(),
        ops::WeightView(*require(w.layers[27].qkv_proj_fused, "layer.27.qkv")),
        ws.qkv_fused.data(), N, Hq + 2 * Hk, H);
    kernels::launch_split_qkv_bf16(
        ws.qkv_fused.data(),
        ws.q.data(), ws.k.data(), ws.v.data(),
        N, Hq, Hk, stream);
    if (lora != nullptr && lora->usable()) {
        if (lora_staged == nullptr && !lora_state) {
            throw std::runtime_error(
                "generated forward: lora correction stated but no "
                "usable lora table (guard/pred drift)");
        }
        (lora_staged != nullptr ? *lora_staged : *lora_state)
            .apply(
            cublas.handle(), 27, ws.norm_x.data(),
            H, Hq, Hk,
            ws.q.data(), ws.v.data(), ws.gate.data());
    } else {
    }
    kernels::launch_add_bias_bf16(
        ws.q.data(), require(w.layers[27].q_bias, "layer.27.q_bias")->data(),
        N, Hq, stream);
    kernels::launch_add_bias_bf16(
        ws.k.data(), require(w.layers[27].k_bias, "layer.27.k_bias")->data(),
        N, Hk, stream);
    kernels::launch_add_bias_bf16(
        ws.v.data(), require(w.layers[27].v_bias, "layer.27.v_bias")->data(),
        N, Hk, stream);
    kernels::launch_rope_bf16(
        ws.q.data(), ws.k.data(), positions,
        N, num_q_heads, num_kv_heads, d,
        cfg.rope_theta, stream);
    if (has_write_desc) {
        {
            auto kv_view = cache.layer_view(27);
            kernels::launch_write_kv_explicit_bf16(
                kv_view,
                bf16_row(ws.k.data(), 0, Hk),
                bf16_row(ws.v.data(), 0, Hk),
                w_page_d + 0, w_off_d + 0,
                N, stream,
                row_valid_d != nullptr ? row_valid_d + 0 : nullptr);
        }
    } else {
        {
            auto kv_view = cache.layer_view(27);
            kernels::launch_write_kv_to_pages(
                kv_view, ws.k.data(), ws.v.data(),
                qo_indptr, kv_page_indices, kv_page_indptr,
                kv_last_page_lens,
                N, R, stream, row_valid_d, /*first_token=*/0);
        }
    }
    if (custom_mask_d != nullptr) {
        if (hooks != nullptr) {
            attn_page_indices = kv_page_indices;
            attn_page_indptr = kv_page_indptr;
            attn_last_page_lens = kv_last_page_lens;
            page_mask.begin_layer(stream);
            prefill_score_capture.emplace(hooks, 27u,
                static_cast<std::uint32_t>(num_q_heads),
                plan_state.prefill_score_window,
                /*capturable=*/true, stream);
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttnProj, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                27u, stream, /*query_is_f32=*/false,
                {.mask_sink = page_mask.sink()});
        }
        if (plan_state.spatial_mask_split >= 0 &&
            unmasked_prefix_rows != 0xffffffffu) {
            const int split = plan_state.spatial_mask_split;
            const int split_rows =
                plan_state.spatial_mask_row_split >= 0
                    ? plan_state.spatial_mask_row_split
                    : split;
            if (split !=
                static_cast<int>(unmasked_prefix_rows)) {
                throw std::runtime_error(
                    "spatial mask: planned/prepared split drift");
            }
            if (mask_suffix_qo_indptr_d == nullptr) {
                throw std::runtime_error(
                    "spatial mask: suffix qo identity missing");
            }
            if (split > 0) {
                {
                    auto kv_view = cache.layer_view(27);
                    kernels::launch_dequant_kv_cache_layer_to_bf16_active(
                        kv_view, kv_page_indices, kv_page_indptr_h[split], stream);
                }
                if (!plan_state.prefill_plan) {
                    throw std::runtime_error(
                        "generated forward: prepare built no prefill plan");
                }
                {
                    auto kv_view = cache.layer_view(27);
                    ops::dispatch_attention_flashinfer_prefill_bf16(
                        *plan_state.prefill_plan,
                        ws.q.data(), kv_view.k_bf16_pages, kv_view.v_bf16_pages,
                        ws.attn_out.data(),
                        qo_indptr, kv_page_indices, kv_page_indptr,
                        kv_last_page_lens,
                        attn_ws, stream, /*logits_soft_cap=*/0.f,
                        /*sm_scale_override=*/-1.f);
                }
            }
            if (!plan_state.mask_decode_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no custom-mask plan");
            }
            {
                auto kv_view = cache.layer_view(27);
                ops::dispatch_attention_flashinfer_prefill_custom(
                    *plan_state.mask_decode_plan,
                    bf16_row(ws.q.data(), split_rows, Hq), kv_view,
                    bf16_row(ws.attn_out.data(), split_rows, Hq),
                    mask_suffix_qo_indptr_d,
                    kv_page_indices,
                    kv_page_indptr + split,
                    kv_last_page_lens + split,
                    custom_mask_d, custom_mask_indptr_d + split,
                    spatial_suffix_attn_ws(), stream);
            }
        } else {
            if (!plan_state.prefill_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no custom-mask plan");
            }
            {
                auto kv_view = cache.layer_view(27);
                ops::dispatch_attention_flashinfer_prefill_custom(
                    *plan_state.prefill_plan,
                    ws.q.data(), kv_view, ws.attn_out.data(),
                    qo_indptr, kv_page_indices, kv_page_indptr,
                    kv_last_page_lens, custom_mask_d, custom_mask_indptr_d,
                    attn_ws, stream);
            }
        }
        if (hooks != nullptr) {
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttn, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                27u, stream, /*query_is_f32=*/false,
                {.scores = prefill_score_capture
                     ? prefill_score_capture->scores()
                     : nullptr});
        }
    } else {
        if (hooks != nullptr) {
            attn_page_indices = kv_page_indices;
            attn_page_indptr = kv_page_indptr;
            attn_last_page_lens = kv_last_page_lens;
            page_mask.begin_layer(stream);
            prefill_score_capture.emplace(hooks, 27u,
                static_cast<std::uint32_t>(num_q_heads),
                plan_state.prefill_score_window,
                /*capturable=*/true, stream);
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttnProj, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                27u, stream, /*query_is_f32=*/false,
                {.mask_sink = page_mask.sink()});
        }
        {
            auto kv_view = cache.layer_view(27);
            kernels::launch_dequant_kv_cache_layer_to_bf16_active(
                kv_view, kv_page_indices, kv_page_indptr_h[R], stream);
        }
        if (hooks != nullptr && hooks->wants_attn_score) {
            if (!plan_state.prefill_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no prefill plan");
            }
            if (!prefill_score_capture ||
                !prefill_score_capture->active()) {
                throw std::runtime_error(
                    "generated forward: capture prefill stated but no "
                    "active score capture (guard/pred drift)");
            }
            if (page_mask.written_for(27u)) {
                throw std::runtime_error(
                    "attn_page_mask was written but this layer does "
                    "not take the paged decode path");
            }
            {
                auto kv_view = cache.layer_view(27);
                ops::dispatch_attention_flashinfer_prefill_capture_bf16(
                    *plan_state.prefill_plan,
                    ws.q.data(), kv_view.k_bf16_pages, kv_view.v_bf16_pages,
                    ws.attn_out.data(),
                    qo_indptr, kv_page_indices, kv_page_indptr,
                    kv_last_page_lens, attn_ws, stream,
                    prefill_score_capture->raw(),
                    prefill_score_capture->folded(),
                    prefill_score_capture->indptr_d(),
                    prefill_score_capture->window(),
                    /*logits_soft_cap=*/0.f, /*sm_scale_override=*/-1.f);
                prefill_score_capture->publish();
            }
        } else {
            if (!plan_state.prefill_plan) {
                throw std::runtime_error(
                    "generated forward: prepare built no prefill plan");
            }
            {
                auto kv_view = cache.layer_view(27);
                ops::dispatch_attention_flashinfer_prefill_bf16(
                    *plan_state.prefill_plan,
                    ws.q.data(), kv_view.k_bf16_pages, kv_view.v_bf16_pages,
                    ws.attn_out.data(),
                    qo_indptr, kv_page_indices, kv_page_indptr,
                    kv_last_page_lens,
                    attn_ws, stream, /*logits_soft_cap=*/0.f,
                    /*sm_scale_override=*/-1.f);
            }
        }
        if (hooks != nullptr) {
            invoke_stage_hook(
                hooks, StageHookPoint::OnAttn, ws.q.data(),
                static_cast<std::uint32_t>(N),
                static_cast<std::uint32_t>(Hq),
                27u, stream, /*query_is_f32=*/false,
                {.scores = prefill_score_capture
                     ? prefill_score_capture->scores()
                     : nullptr});
        }
    }
    ops::gemm_act_x_w(cublas.handle(),
        ws.attn_out.data(),
        make_weight_view(require(w.layers[27].o_proj, "layer.27.o_proj"), w.layers[27].o_proj_quant),
        ws.y.data(), N, H, Hq, 1.f);
    kernels::launch_rmsnorm_bf16(
        ws.y.data(), require(w.layers[27].mlp_norm, "layer.27.mlp_norm")->data(),
        ws.norm_y.data(), N, H, eps, stream);
    const bool gate_up_fused_27 =
        w.layers[27].gate_up_proj_fused != nullptr && !ws.gate_up_fused.empty();
    if (gate_up_fused_27) {
        ops::gemm_act_x_w(cublas.handle(),
            ws.norm_y.data(),
            ops::WeightView(*w.layers[27].gate_up_proj_fused),
            ws.gate_up_fused.data(), N, 2 * I, H);
    } else {
        ops::gemm_act_x_w(cublas.handle(),
            ws.norm_y.data(),
            make_weight_view(require(w.layers[27].gate_proj, "layer.27.gate_up"), w.layers[27].gate_proj_quant),
            ws.gate.data(), N, I, H);
        ops::gemm_act_x_w(cublas.handle(),
            ws.norm_y.data(),
            make_weight_view(require(w.layers[27].up_proj, "layer.27.gate_up"), w.layers[27].up_proj_quant),
            ws.up.data(), N, I, H);
    }
    if (gate_up_fused_27) {
        kernels::launch_chunked_swiglu_bf16(
            ws.gate_up_fused.data(), ws.gate.data(), N, I, stream);
    } else {
        kernels::launch_swiglu_bf16(
            ws.gate.data(), ws.up.data(), ws.gate.data(),
            N * I, stream);
    }
    ops::gemm_act_x_w(cublas.handle(),
        ws.gate.data(),
        make_weight_view(require(w.layers[27].down_proj, "layer.27.down"), w.layers[27].down_proj_quant),
        ws.y.data(), N, H, I, 1.f);
    // final_norm: deferred into the LmHead epilogue below.
    if (fwd_cfg.emit_logits) {
        // The hand-written epilogue, the interpreter's arm verbatim
        // (compact logits are a per-fire runtime input).
        const bool compact_logits =
            logit_row_indices_d != nullptr && num_logit_rows > 0 &&
            num_logit_rows < N;
        const void* lm_head_input = nullptr;
        int lm_head_rows = N;
        if (compact_logits) {
            kernels::launch_gather_bf16_rows(
                static_cast<const std::uint16_t*>(ws.y.data()),
                logit_row_indices_d,
                static_cast<std::uint16_t*>(ws.norm_x.data()),
                num_logit_rows, H, stream);
            kernels::launch_rmsnorm_bf16(
                ws.norm_x.data(), w.final_norm->data(),
                ws.norm_y.data(), num_logit_rows, H, eps, stream);
            lm_head_input = ws.norm_y.data();
            lm_head_rows = num_logit_rows;
        } else {
            kernels::launch_rmsnorm_bf16(
                ws.y.data(), w.final_norm->data(), ws.norm_y.data(),
                N, H, eps, stream);
            lm_head_input = ws.norm_y.data();
        }
        ops::gemm_act_x_w(cublas.handle(),
            lm_head_input, ops::WeightView(*require(w.embed, "embed")),
            ws.logits.data(), lm_head_rows, V, H);
    }
}

inline void generated_llama_like_decode_qwen2_5_1_5b_supergraph_build(
const Qwen3Weights& w,
const HfConfig& cfg,
const LlamaLikeForwardCfg& fwd_cfg,
const LlamaLikePlanState& plan_state,
Workspace& ws,
KvCache& cache,
AttentionWorkspace& attn_ws,
ops::CublasHandle& cublas,
const std::int32_t* token_ids,
const std::int32_t* positions,
const std::uint32_t* qo_indptr,
const std::uint32_t* kv_page_indices,
const std::uint32_t* kv_page_indptr,
const std::uint32_t* kv_last_page_lens,
const std::uint32_t* qo_indptr_h,
const std::uint32_t* kv_page_indptr_h,
int total_tokens,
int num_requests,
const std::int32_t* logit_row_indices_d,
int num_logit_rows,
const std::uint32_t* w_page_d,
const std::uint32_t* w_off_d,
const std::uint8_t* row_valid_d,
